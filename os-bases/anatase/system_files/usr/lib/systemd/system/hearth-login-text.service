# Signing in on Hearth OS with no KDE (1.18; the owner, Nov 23: "completely remove KDE"): greetd's own text sign-in,
# with automatic sign-in into Hearth's session as before (hearth-login-screen run-text writes /run/hearth/greetd-text.toml
# at every start from the automatic sign-in nimbus-autologin keeps). It's the display manager on this image, and the
# login screen Hearth's own falls back to (hearth-login-screen fallback). It needs nothing but greetd, and it restarts
# itself if it ever ends, so there's always a way to sign in.
[Unit]
Description=Hearth: signing in (greetd)
After=hearth-login-select.service nimbus-autologin.service systemd-user-sessions.service systemd-logind.service plymouth-quit-wait.service
ConditionPathExists=!/run/hearth/login-greetd
Conflicts=getty@tty7.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/plymouth quit --retain-splash
ExecStart=/usr/libexec/nimbus/hearth-login-screen run-text
Restart=always
RestartSec=2
IgnoreSIGPIPE=no
SendSIGHUP=yes
KeyringMode=shared
TimeoutStopSec=30s

[Install]
Alias=display-manager.service
