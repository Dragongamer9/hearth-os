# Enabled by hearth-server-rules only while one of your quiet times or rules is on (every minute; two minutes after
# the PC starts, never in the way of starting it).
[Unit]
Description=Hearth server: quiet hours and rules, every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
