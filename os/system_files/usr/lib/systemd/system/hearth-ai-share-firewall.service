# "Share this device's AI" (docs/AI-SHARE.md): loads Hearth's rule that keeps port 8189 to this device and Tailscale
# (the nftables table inet hearth_ai_share, from /etc/hearth/ai-share.nft). Started only by its timer. 1.17: sharing is on
# by default, so the timer is on in the image and writes the rule when it was never turned off on this PC
# (/etc/hearth/ai-share.off); turning sharing off in Settings takes the rule and the timer away. Never part of starting
# the PC, the session or Game Mode.
[Unit]
Description=Hearth: the AI sharing address only through Tailscale (firewall rule)

[Service]
Type=oneshot
ExecStart=/usr/libexec/nimbus/hearth-ai-share-helper firewall-default
TimeoutStartSec=30
