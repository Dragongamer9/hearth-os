# Settings › Home server › Backups & sync: starts the receiver for your other Hearth devices' backups a minute after the
# PC starts. Disabled in the image and while "Backups from your other Hearth devices" is off.
[Unit]
Description=Hearth home server: backups from your other Hearth devices, a minute after start

[Timer]
OnBootSec=1min

[Install]
WantedBy=timers.target
