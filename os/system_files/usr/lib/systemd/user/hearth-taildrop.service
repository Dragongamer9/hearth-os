# Settings › Home server › Tailscale › Receive files (Taildrop): files your devices send to this PC land in
# Downloads/Taildrop (a name that's taken gets a new one; nothing is overwritten). Off until you turn it on there
# (hearth-home-server enables it for your account). Not part of the session starting: a failure here never holds
# anything up.
[Unit]
Description=Hearth home server: receive files sent with Taildrop
ConditionPathExists=/usr/bin/tailscale

[Service]
ExecStartPre=/usr/bin/mkdir -p %h/Downloads/Taildrop
ExecStart=/usr/bin/tailscale file get --loop --conflict=rename %h/Downloads/Taildrop
Restart=on-failure
RestartSec=30
Nice=10

[Install]
WantedBy=default.target
