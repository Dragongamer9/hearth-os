# Settings › Home server: starts Colibri a minute after you sign in. Off in the image and while Colibri is off
# (Settings enables it for your account together with the service).
[Unit]
Description=Hearth home server: AI engine (Colibri), a minute after sign-in

[Timer]
OnStartupSec=1min

[Install]
WantedBy=timers.target
