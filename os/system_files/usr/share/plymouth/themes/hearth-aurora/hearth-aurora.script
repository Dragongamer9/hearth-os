# Hearth boot splash preset "hearth-aurora" (Settings › Boot & startup): northern lights (two soft curtains of teal
# and blue light) drifting slowly across a night-blue sky above the Hearth mark, with a teal halo breathing behind it.
# Pairs with the Aurora startup animation. Chosen with plymouth.splash=hearth-aurora on the kernel command line
# (hearth-bls-grub adds it). Asks for the disk password on encrypted installs, like the default. Uses only what the
# first three presets use (Image, Scale, Sprite, SetPosition, SetOpacity, Math.Sin), nothing new for Plymouth.

Window.SetBackgroundTopColor(0.047, 0.086, 0.133);
Window.SetBackgroundBottomColor(0.031, 0.047, 0.067);

W = Window.GetWidth();
H = Window.GetHeight();
X0 = Window.GetX();
Y0 = Window.GetY();
short = Math.Min(W, H);

size = Math.Int(short * 0.24);
logo.image = Image("logo.png").Scale(size, size);
logo.sprite = Sprite(logo.image);
logo.x = X0 + Math.Int(W / 2 - size / 2);
logo.y = Y0 + Math.Int(H / 2 - size / 2 - short * 0.07);
logo.sprite.SetPosition(logo.x, logo.y, 10);
logo.sprite.SetOpacity(0);

word.src = Image("wordmark.png");
word.w = Math.Int(size * 0.9);
word.h = Math.Int(word.src.GetHeight() * word.w / word.src.GetWidth());
word.sprite = Sprite(word.src.Scale(word.w, word.h));
word.y = logo.y + size + Math.Int(short * 0.045);
word.sprite.SetPosition(X0 + Math.Int(W / 2 - word.w / 2), word.y, 10);
word.sprite.SetOpacity(0);

msg.sprite = Sprite();
msg.y = Y0 + H - Math.Int(short * 0.08);
dots_y = word.y + word.h + Math.Int(short * 0.07);

frame = 0;
status = "normal";

fun clamp01(v) {
  if (v < 0) return 0;
  if (v > 1) return 1;
  return v;
}

hsize = Math.Int(size * 2.1);
halo.sprite = Sprite(Image("halo.png").Scale(hsize, hsize));
halo.sprite.SetPosition(logo.x + Math.Int(size / 2 - hsize / 2), logo.y + Math.Int(size / 2 - hsize / 2), 5);
halo.sprite.SetOpacity(0);

# The two curtains: wider than the screen, in its upper part, drifting side to side in opposite directions.
rw = Math.Int(W * 1.25);
rh = Math.Int(short * 0.38);
ra.sprite = Sprite(Image("ribbon-a.png").Scale(rw, rh));
rb.sprite = Sprite(Image("ribbon-b.png").Scale(rw, rh));
ra.y = Y0 + Math.Int(H * 0.02);
rb.y = Y0 + Math.Int(H * 0.08);
rx0 = X0 - Math.Int((rw - W) / 2);
ra.sprite.SetPosition(rx0, ra.y, 3);
rb.sprite.SetPosition(rx0, rb.y, 4);
ra.sprite.SetOpacity(0);
rb.sprite.SetOpacity(0);

fun refresh_callback() {
  global.frame++;
  t = global.frame;
  fade = clamp01(t / 40);
  logo.sprite.SetOpacity(fade);
  word.sprite.SetOpacity(fade * 0.95);
  halo.sprite.SetOpacity(fade * (0.20 + 0.10 * Math.Sin(t * 0.035)));
  # A slow drift (one way and back in about 10 s at 50 fps), the curtains brightening and dimming out of step. The
  # curtains are big, so they move on every other frame only (25 a second: light work for Plymouth on a 4K screen).
  if (t - Math.Int(t / 2) * 2 == 0) {
    ra.sprite.SetPosition(rx0 + Math.Int(Math.Sin(t * 0.0125) * W * 0.06), ra.y, 3);
    rb.sprite.SetPosition(rx0 - Math.Int(Math.Sin(t * 0.0105 + 1.3) * W * 0.05), rb.y, 4);
    ra.sprite.SetOpacity(fade * (0.55 + 0.30 * Math.Sin(t * 0.031)));
    rb.sprite.SetOpacity(fade * (0.45 + 0.30 * Math.Sin(t * 0.024 + 2.1)));
  }
}
Plymouth.SetRefreshFunction(refresh_callback);

# --- disk password
entry.image = Image("entry.png");
bullet.image = Image("bullet.png");
entry.w = Math.Int(Math.Min(W * 0.8, short * 0.62));
entry.h = Math.Int(entry.w * entry.image.GetHeight() / entry.image.GetWidth());
entry.sprite = Sprite(entry.image.Scale(entry.w, entry.h));
entry.x = X0 + Math.Int(W / 2 - entry.w / 2);
entry.y = dots_y - Math.Int(entry.h / 2);
entry.sprite.SetPosition(entry.x, entry.y, 20);
entry.sprite.SetOpacity(0);
prompt.sprite = Sprite();
bsize = Math.Int(entry.h * 0.3);
bullet.small = bullet.image.Scale(bsize, bsize);
nbullets = 0;

fun hide_bullets() {
  for (i = 0; i < global.nbullets; i++) global.bullets[i].SetOpacity(0);
}

fun display_password_callback(text, count) {
  global.status = "password";
  entry.sprite.SetOpacity(1);
  label = text;
  if (label == "") label = "Password";
  img = Image.Text(label, 0.863, 0.898, 0.929, 1, "Sans 16");
  prompt.sprite.SetImage(img);
  prompt.sprite.SetPosition(X0 + Math.Int(W / 2 - img.GetWidth() / 2), entry.y - img.GetHeight() - Math.Int(short * 0.02), 20);
  prompt.sprite.SetOpacity(1);
  hide_bullets();
  maxb = Math.Int((entry.w - entry.h) / (bsize * 1.6));
  shown = Math.Min(count, maxb);
  start = X0 + Math.Int(W / 2 - (shown * bsize * 1.6) / 2);
  for (i = 0; i < shown; i++) {
    if (i >= global.nbullets) {
      global.bullets[i] = Sprite(bullet.small);
      global.nbullets = i + 1;
    }
    global.bullets[i].SetPosition(start + Math.Int(i * bsize * 1.6 + bsize * 0.3), entry.y + Math.Int(entry.h / 2 - bsize / 2), 21);
    global.bullets[i].SetOpacity(1);
  }
}
Plymouth.SetDisplayPasswordFunction(display_password_callback);

fun display_normal_callback() {
  global.status = "normal";
  entry.sprite.SetOpacity(0);
  prompt.sprite.SetOpacity(0);
  hide_bullets();
}
Plymouth.SetDisplayNormalFunction(display_normal_callback);

fun message_callback(text) {
  img = Image.Text(text, 0.863, 0.898, 0.929, 0.7, "Sans 12");
  msg.sprite.SetImage(img);
  msg.sprite.SetPosition(X0 + Math.Int(W / 2 - img.GetWidth() / 2), msg.y, 10);
}
Plymouth.SetMessageFunction(message_callback);
