# Hearth GNOME's default apps: GNOME's own apps for the kinds it has (files, terminal, text), one app of each kind.
# Read only in Hearth GNOME (XDG_CURRENT_DESKTOP=GNOME, this folder first in XDG_DATA_DIRS); your own choices
# (~/.config/mimeapps.list) still come first. docs/GNOME.md.
[Default Applications]
inode/directory=org.gnome.Nautilus.desktop
x-scheme-handler/terminal=org.gnome.Console.desktop
text/plain=org.gnome.TextEditor.desktop
text/x-log=org.gnome.TextEditor.desktop
text/markdown=org.gnome.TextEditor.desktop
text/x-markdown=org.gnome.TextEditor.desktop
text/x-python=org.gnome.TextEditor.desktop
text/x-python3=org.gnome.TextEditor.desktop
application/x-shellscript=org.gnome.TextEditor.desktop
text/x-shellscript=org.gnome.TextEditor.desktop
application/json=org.gnome.TextEditor.desktop
application/x-yaml=org.gnome.TextEditor.desktop
text/x-yaml=org.gnome.TextEditor.desktop
application/yaml=org.gnome.TextEditor.desktop
application/toml=org.gnome.TextEditor.desktop
text/x-toml=org.gnome.TextEditor.desktop
text/x-ini=org.gnome.TextEditor.desktop
text/x-csrc=org.gnome.TextEditor.desktop
text/x-chdr=org.gnome.TextEditor.desktop
text/x-c++src=org.gnome.TextEditor.desktop
text/x-c++hdr=org.gnome.TextEditor.desktop
text/x-csharp=org.gnome.TextEditor.desktop
text/x-rust=org.gnome.TextEditor.desktop
text/rust=org.gnome.TextEditor.desktop
text/javascript=org.gnome.TextEditor.desktop
application/javascript=org.gnome.TextEditor.desktop
text/x-typescript=org.gnome.TextEditor.desktop
application/typescript=org.gnome.TextEditor.desktop
text/css=org.gnome.TextEditor.desktop
text/xml=org.gnome.TextEditor.desktop
application/xml=org.gnome.TextEditor.desktop
text/x-desktop=org.gnome.TextEditor.desktop
application/x-desktop=org.gnome.TextEditor.desktop
text/x-makefile=org.gnome.TextEditor.desktop
text/x-cmake=org.gnome.TextEditor.desktop
text/x-diff=org.gnome.TextEditor.desktop
text/x-patch=org.gnome.TextEditor.desktop
text/x-java=org.gnome.TextEditor.desktop
text/x-go=org.gnome.TextEditor.desktop
text/x-lua=org.gnome.TextEditor.desktop
text/x-sql=org.gnome.TextEditor.desktop
application/sql=org.gnome.TextEditor.desktop
text/csv=org.gnome.TextEditor.desktop
text/tab-separated-values=org.gnome.TextEditor.desktop
text/x-readme=org.gnome.TextEditor.desktop
text/x-changelog=org.gnome.TextEditor.desktop
application/x-zerosize=org.gnome.TextEditor.desktop
text/x-systemd-unit=org.gnome.TextEditor.desktop
application/x-ruby=org.gnome.TextEditor.desktop
text/x-perl=org.gnome.TextEditor.desktop
application/x-perl=org.gnome.TextEditor.desktop
application/x-powershell=org.gnome.TextEditor.desktop
text/x-dockerfile=org.gnome.TextEditor.desktop
