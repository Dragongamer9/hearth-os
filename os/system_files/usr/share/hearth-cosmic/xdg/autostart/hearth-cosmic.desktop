[Desktop Entry]
Type=Application
Name=Hearth COSMIC companion
Comment=Hearth's launcher, Quick Access, Hearth menu, on-screen keyboard and controller in Hearth COSMIC (docs/COSMIC.md). nimbus-session starts it; this entry only matters where COSMIC reads this folder, and hearth-companion runs it once
Exec=sh -c 'c="${NIMBUS_SHARE:-/usr/share/nimbus}/desktop/shell/hearth-companion"; [ "$HEARTH_DESKTOP" = cosmic ] && [ -f "$c" ] && exec sh "$c" cosmic autostart; exit 0'
OnlyShowIn=COSMIC;
NoDisplay=true
