[Desktop Entry]
Name=Hearth Player
GenericName=Media Player
Comment=Play videos, music, podcasts and internet radio, and trim and tag them
Exec=hearth-player %U
TryExec=hearth-player
Icon=hearth-player
Type=Application
Categories=AudioVideo;Audio;Video;Player;TV;
MimeType=video/mp4;video/x-m4v;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;video/avi;video/x-ms-wmv;video/x-flv;video/mpeg;video/mp2t;video/3gpp;video/3gpp2;video/ogg;video/x-ogm+ogg;video/vnd.avi;video/dv;video/x-mpeg2;audio/mpeg;audio/mp3;audio/x-mp3;audio/flac;audio/x-flac;audio/ogg;audio/x-vorbis+ogg;audio/vorbis;audio/opus;audio/x-opus+ogg;audio/mp4;audio/x-m4a;audio/m4a;audio/aac;audio/x-aac;audio/wav;audio/x-wav;audio/vnd.wave;audio/x-ms-wma;audio/x-aiff;audio/aiff;audio/x-ape;audio/x-wavpack;audio/x-matroska;audio/webm;audio/x-mpegurl;audio/mpegurl;application/vnd.apple.mpegurl;audio/x-scpls;application/x-ogg;
Keywords=video;movie;film;music;song;audio;player;podcast;radio;playlist;subtitles;trim;cut;mp4;mkv;mp3;flac;
StartupNotify=true
StartupWMClass=hearth-player
Actions=music;podcasts;

[Desktop Action music]
Name=Music
Exec=hearth-player --music

[Desktop Action podcasts]
Name=Podcasts and Radio
Exec=hearth-player --podcasts
