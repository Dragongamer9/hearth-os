[Desktop Entry]
Type=Application
Name=Hearth Passwords
GenericName=Password manager
Comment=Your vault, kept on your own server: sign-ins, 2-step codes, the password maker (built on Vaultwarden and KeePassXC)
Exec=/usr/bin/hearth-passwords-app
TryExec=/usr/bin/hearth-passwords-app
Icon=hearth-passwords
Categories=Utility;Security;
Keywords=password;vault;bitwarden;vaultwarden;keepass;2fa;totp;otp;security;
StartupWMClass=hearth-passwords
