// Hearth: Settings › Accounts › Sign-in options › Hearth's own login screen (1.14, a test) turns it on or off
// (hearth-login-screen on|off: one settings file, used at the next start) without a password prompt, like Hearth
// Settings' other system options (49-hearth-admin.rules): only that helper, only "on" or "off", only from a local
// active session, only for administrators (wheel). Its start-up steps (select, watch, fallback) aren't allowed here.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/nimbus/hearth-login-screen" &&
        /^\S+\s+(on|off)$/.test(action.lookup("command_line") || "") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
