// Hearth: Task Manager › Memory › Swap & settings and Settings › System › Memory change memory and swap
// (hearth-memory), the processor and battery settings in Task Manager › Performance (hearth-hwset), the
// full-drive warning's emergency space (hearth-diskguard release), Server mode's game download cache and ad blocker
// (hearth-server-dns) and its quiet hours and rules (hearth-server-rules), and Settings › Your desktop's downloads of
// KDE Plasma and GNOME (hearth-desktops-helper), without a
// password prompt, like Hearth Settings' other system options (49-hearth-admin.rules):
// only that helper, only from a local active session, only for administrators (wheel).
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        (action.lookup("program") == "/usr/libexec/nimbus/hearth-memory" ||
         action.lookup("program") == "/usr/libexec/nimbus/hearth-hwset" ||
         action.lookup("program") == "/usr/libexec/nimbus/hearth-diskguard" ||
         action.lookup("program") == "/usr/libexec/nimbus/hearth-server-dns" ||
         action.lookup("program") == "/usr/libexec/nimbus/hearth-server-rules" ||
         action.lookup("program") == "/usr/libexec/nimbus/hearth-desktops-helper") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
