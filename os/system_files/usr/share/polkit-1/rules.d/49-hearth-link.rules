// Hearth: Nearby Share and Hearth Connect open the firewall for themselves while they're listening (only to the
// local network; see /usr/libexec/nimbus/hearth-link-firewall), without a password prompt a handheld couldn't answer.
// Only that helper, only from a local active session, only for administrators (wheel).
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/nimbus/hearth-link-firewall" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
