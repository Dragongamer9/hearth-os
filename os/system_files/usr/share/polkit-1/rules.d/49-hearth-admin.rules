// Hearth: the person signed in at the device can use Hearth Settings' system options (sign-in, device name,
// password, system update) without a password prompt, which a handheld couldn't answer.
// Only the hearth-admin helper, only from a local active session, only for administrators (wheel).
// The password change still checks the current password itself.
// Installing a .deb file (hearth-admin install-deb, Ubuntu and Peppermint editions) always asks for an
// administrator's password: it runs a package's own scripts as root.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/nimbus/hearth-admin") {
        var cmd = action.lookup("command_line") || "";
        if (/^\S+\s+install-deb(\s|$)/.test(cmd)) {
            return polkit.Result.AUTH_ADMIN;
        }
        if (subject.local && subject.active && subject.isInGroup("wheel")) {
            return polkit.Result.YES;
        }
    }
});
