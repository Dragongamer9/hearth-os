// Hearth: the person signed in at the device can use Hearth Settings' system options (sign-in, device name,
// password, system update) without a password prompt, which a handheld couldn't answer.
// Only the hearth-admin helper, only from a local active session, only for administrators (wheel).
// The password change still checks the current password itself.
// One exception: write-file (Hearth Text's Edit as administrator saving a system file) always asks for an
// administrator's password, so nothing running as you can change system files without it.
// The same for .deb files installed on the system (deb-install/deb-remove), and for Make a bootable USB (Hearth Disks) writing to an internal drive (usb-* --allow-internal, only after
// "Show all drives" and typing ERASE): USB drives and SD cards don't ask, internal drives always do.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/nimbus/hearth-admin" &&
        /^\S+\s+write-file(\s|$)/.test(action.lookup("command_line") || "")) {
        return polkit.Result.AUTH_ADMIN;
    }
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/nimbus/hearth-admin" &&
        /^\S+\s+usb-\S+(\s.*)?\s--allow-internal(\s|$)/.test(action.lookup("command_line") || "")) {
        return polkit.Result.AUTH_ADMIN;
    }
    // Installing or removing a .deb on the system itself (Peppermint unlocked) runs the package's own scripts as
    // root: always an administrator's password, like sudo apt.
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/nimbus/hearth-admin" &&
        /^\S+\s+deb-(install|remove)(\s|$)/.test(action.lookup("command_line") || "")) {
        return polkit.Result.AUTH_ADMIN;
    }
});

polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/nimbus/hearth-admin" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
