// Hearth: Decky Loader is built into Hearth OS (hearth-decky@.service, docs/STEAM-GAME-MODE.md). nimbus-session starts
// it when Steam Game Mode starts and stops it afterwards, with no password prompt (Steam Game Mode has no way to answer
// one). Only your own instance (hearth-decky@<your account>.service), only start/stop/restart, only from the active
// session at the device, and only for administrators (wheel): Decky runs as root and loads plugins from ~/homebrew,
// so a standard account doesn't get it without a password.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "hearth-decky@" + subject.user + ".service" &&
        ["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0 &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
