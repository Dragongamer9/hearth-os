// Hearth Storage (Settings › Hearth Storage): Windows sharing for the shared folders and waking the PC from the network
// need root for a moment (see /usr/libexec/nimbus/hearth-storage-helper), without a password prompt a controller couldn't
// answer. Settings › Home server's root helper (/usr/libexec/nimbus/hearth-home-server-helper, which builds on it) the
// same way, and "Share this device's AI"'s firewall helper (hearth-ai-share-helper). Only those helpers, only from a local active session, only for administrators (wheel).
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        (action.lookup("program") == "/usr/libexec/nimbus/hearth-storage-helper" ||
         action.lookup("program") == "/usr/libexec/nimbus/hearth-home-server-helper" ||
         action.lookup("program") == "/usr/libexec/nimbus/hearth-ai-share-helper") &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
