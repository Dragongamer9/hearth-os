// Hearth Storage (Settings › Hearth Storage): Windows sharing for the shared folders and waking the PC from the network
// need root for a moment (see /usr/libexec/nimbus/hearth-storage-helper), without a password prompt a controller couldn't
// answer. Only that helper, only from a local active session, only for administrators (wheel).
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.policykit.exec" &&
        action.lookup("program") == "/usr/libexec/nimbus/hearth-storage-helper" &&
        subject.local && subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
