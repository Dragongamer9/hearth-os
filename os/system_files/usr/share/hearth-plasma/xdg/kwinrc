[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
ButtonsOnLeft=
ButtonsOnRight=IAX

[WindowSwitcher]
LayoutName=thumbnail_grid

[Plugins]
blurEnabled=true
contrastEnabled=true
# The controller (hearth-pad --plasma): KWin says which window is in front (/usr/share/kwin/scripts/hearthpad).
hearthpadEnabled=true

[Windows]
Placement=Centered

[ElectricBorders]
TopLeft=None

[Effect-overview]
BorderActivate=9

[ModifierOnlyShortcuts]
Meta=org.kde.plasmashell,/PlasmaShell,org.kde.PlasmaShell,activateLauncherMenu
