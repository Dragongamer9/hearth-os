#!/bin/sh
# Opens Hearth Settings: Desktop Mode's own settings app (part of the Quickshell desktop), optionally at a
# page (any id in hosts/linux/desktop/shell/settings-pages.js: home, wifi, bluetooth, display, appearance, power,
# keyboard, gaming, hs-overview, updates...; old ids still work; page:part opens at a part, e.g. keyboard:osk). Anywhere
# the Hearth desktop isn't running, opens the Hearth app's settings instead.
SHELL_DIR="${NIMBUS_SHARE:-/usr/share/nimbus}/desktop/shell"
if command -v quickshell >/dev/null 2>&1; then
  if [ -n "$1" ]; then quickshell ipc -p "$SHELL_DIR" call settings page "$1" >/dev/null 2>&1 && exit 0
  else quickshell ipc -p "$SHELL_DIR" call settings open >/dev/null 2>&1 && exit 0; fi
fi
exec /usr/bin/nimbus --windowed --settings
