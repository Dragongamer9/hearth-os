#!/usr/bin/python3
"""hearth-wallpaper: set Hearth Desktop Mode's wallpaper (the file manager's "Set as Hearth wallpaper").

  hearth-wallpaper PICTURE        use this picture
  hearth-wallpaper fireside|lava|aurora   one of the moving ones
The desktop picks the change up straight away (Hearth Settings › Appearance shows the same choice).
"""
import json
import os
import sys

path = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'), 'nimbus', 'desktop.json')
if len(sys.argv) != 2:
    print(__doc__.strip())
    sys.exit(2)
arg = sys.argv[1]
if arg.startswith('file://'):
    from urllib.parse import unquote
    arg = unquote(arg[7:])
if arg in ('fireside', 'lava', 'aurora'):
    value = '' if arg == 'fireside' else 'anim:' + arg
elif os.path.isfile(arg):
    value = os.path.abspath(arg)
else:
    print('error: no such picture: ' + arg)
    sys.exit(1)
# Only "wallpaper" changes, merged into the latest file under the lock Settings uses (hearth_settings_io): a damaged
# desktop.json comes back from desktop.json.bak instead of being replaced by this one setting.
for share in (os.environ.get('NIMBUS_SHARE'), '/usr/share/nimbus', '/usr/local/share/nimbus'):
    if share and os.path.isfile(os.path.join(share, 'desktop', 'shell', 'hearth_settings_io.py')):
        sys.path.insert(0, os.path.join(share, 'desktop', 'shell'))
        break
try:
    import hearth_settings_io
except ImportError:
    hearth_settings_io = None
if hearth_settings_io:
    hearth_settings_io.merge_json(path, {'wallpaper': value})
    sys.exit(0)
try:
    with open(path, encoding='utf-8') as f:
        conf = json.load(f)
except FileNotFoundError:
    conf = {}
except (OSError, ValueError):
    print("error: Hearth's desktop settings file can't be read; change the wallpaper in Settings › Appearance")
    sys.exit(1)
conf['wallpaper'] = value
os.makedirs(os.path.dirname(path), exist_ok=True)
# Written as UTF-8, not \u escapes: Settings › Appearance reads the chosen picture's path from this file as
# text, and "Café.jpg" written as "Caf\u00e9.jpg" wasn't found there (the picture went missing from the list).
with open(path + '.tmp', 'w', encoding='utf-8') as f:
    json.dump(conf, f, indent=2, ensure_ascii=False)
    f.write('\n')
os.replace(path + '.tmp', path)
