def plan_grow(st, src, gb, tables, root):
    """The exact steps for `grow`, from status data. Raises Fail (nothing changed) when it can't be done safely."""
    if not isinstance(gb, int) or isinstance(gb, bool) or not 1 <= gb <= MAX_GB:
        raise Fail('choose how many GB (1 or more)')
    give = gb * GIB
    if src == 'free':
        regions = [r for r in st['free'] if not r['blockers']]
        if not regions:
            raise Fail('there is no free space on Hearth\'s drive to use' if not st['free'] else st['free'][0]['blockers'][0]['text'])
        # Right after Hearth's own partition first (grows in place), otherwise the biggest.
        regions.sort(key=lambda r: (not r['afterHearth'], -r['bytes']))
        r = regions[0]
        if give > r['canGive']:
            raise Fail(f"there's only {r['canGive'] // GIB} GB of free space")
        table = tables[r['disk']]
        sector = int(table.get('sectorsize') or 512)
        align = max(1, MIB // sector)
        sectors = min(r['sectors'], give // sector // align * align)
        if r['afterHearth']:
            part = next(p for p in table['partitions'] if os.path.realpath(p['node']) == r['after'])
            num = int(re.search(r'(\d+)$', part['node']).group(1))
            return {'from': 'free', 'name': 'free space', 'method': 'grow-in-place', 'disk': r['disk'], 'sector': sector, 'give': sectors * sector,
                    'steps': [
                        {'step': 'grow-part', 'what': "making Hearth's partition bigger", 'changes': True, 'dev': r['after'], 'num': num,
                         'start': int(part['start']), 'oldSectors': int(part['size']), 'newSectors': int(part['size']) + sectors},
                        {'step': 'grow-fs', 'what': "growing Hearth's file system", 'changes': True, 'dev': r['after'],
                         'devid': root['devids'].get(r['after'], 1), 'mount': root.get('rw') or root['mount']},
                        {'step': 'verify', 'what': 'checking', 'changes': False}]}
        return {'from': 'free', 'name': 'free space', 'method': 'device-add', 'disk': r['disk'], 'sector': sector, 'give': sectors * sector,
                'steps': [
                    {'step': 'new-part', 'what': 'making a new partition for Hearth', 'changes': True, 'disk': r['disk'], 'start': r['start'], 'sectors': sectors},
                    {'step': 'device-add', 'what': "adding it to Hearth's file system", 'changes': True, 'mount': root.get('rw') or root['mount']},
                    {'step': 'verify', 'what': 'checking', 'changes': False}]}
    if not re.fullmatch(r'/dev/[A-Za-z0-9/_-]+', src or ''):
        raise Fail('choose which system gives the space')
    real = os.path.realpath(src)
    part = next((p for p in st['parts'] if p['dev'] == real), None)
    if part and part['kind'] not in ('windows', 'linux'):
        raise Fail(f"{part['what']} is never changed")
    s = next((x for x in st['systems'] if x['dev'] == real), None)
    if not s:
        raise Fail("that isn't a system on Hearth's drive that can give space")
    if s['blockers']:
        raise Fail(s['blockers'][0]['text'])
    if s['estimate'] or s['min'] is None:
        raise Fail(f"Hearth couldn't read exactly how full {s['name']} is")
    if give > s['canGive']:
        raise Fail(f"{s['name']} can give at most {s['canGive'] // GIB} GB")
    table = tables[s['disk']]
    sector = int(table.get('sectorsize') or 512)
    tp = next(p for p in table['partitions'] if os.path.realpath(p['node']) == real)
    geo = shrink_geometry({'start': int(tp['start']), 'size': int(tp['size'])}, s['size'], give, s['keep'], sector)
    num = int(re.search(r'(\d+)$', real).group(1))
    steps = [
        {'step': 'release', 'what': f"letting go of {poss(s['name'])} drive", 'changes': False, 'dev': real},
        {'step': 'check', 'what': f"checking {poss(s['name'])} drive", 'changes': False, 'dev': real, 'fs': s['fs'], 'newFs': geo['newFs'], 'name': s['name']},
        {'step': 'shrink-fs', 'what': f"making {poss(s['name'])} file system smaller", 'changes': True, 'dev': real, 'fs': s['fs'],
         'oldFs': s['size'], 'newFs': geo['newFs']},
        {'step': 'shrink-part', 'what': f"making {poss(s['name'])} partition smaller", 'changes': True, 'dev': real, 'disk': s['disk'], 'num': num,
         'start': int(tp['start']), 'oldSectors': int(tp['size']), 'newSectors': geo['partSectors']},
        {'step': 'new-part', 'what': 'making a new partition for Hearth', 'changes': True, 'disk': s['disk'],
         'start': geo['newStart'], 'sectors': geo['newSectors']},
        {'step': 'device-add', 'what': "adding it to Hearth's file system", 'changes': True, 'mount': root.get('rw') or root['mount']},
        {'step': 'verify', 'what': 'checking', 'changes': False},
    ]
    return {'from': real, 'name': s['name'], 'fs': s['fs'], 'method': 'device-add', 'disk': s['disk'], 'sector': sector,
            'give': geo['newSectors'] * sector, 'steps': steps}


