class Journal:
    """Every step, written down before and after it runs (atomically), so an interrupted run can be understood."""

    def __init__(self, plan, path=None):
        self.path = path or JOURNAL
        if os.path.exists(self.path):   # the previous run's record, kept one more time
            os.replace(self.path, self.path[:-5] + '.prev.json')
        self.data = {'version': 1, 'started': int(time.time()), 'state': 'running', 'from': plan['from'], 'name': plan.get('name'),
                     'method': plan['method'], 'give': plan['give'], 'steps': []}
        self.save()

    def save(self):
        os.makedirs(os.path.dirname(self.path), exist_ok=True)
        tmp = self.path + '.tmp'
        with open(tmp, 'w') as f:
            json.dump(self.data, f, indent=1)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, self.path)

    def start(self, step):
        rec = {k: v for k, v in step.items()}
        rec.update(state='started', at=int(time.time()))
        self.data['steps'].append(rec)
        self.save()
        return rec

    def done(self, rec, **extra):
        rec.update(state='done', done=int(time.time()), **extra)
        self.save()

    def finish(self, state, **extra):
        self.data.update(state=state, ended=int(time.time()), **extra)
        self.save()


def settle(disk, num=None, add=False):
    if num is None:
        RUN(['partx', '-u', disk])
    else:
        RUN(['partx', '-a' if add else '-u', '--nr', str(num), disk])
    RUN(['udevadm', 'settle', '-t', '10'])


def node_for_start(disk, start):
    for p in part_table(disk).get('partitions', []):
        if int(p['start']) == int(start):
            return os.path.realpath(p['node']), int(re.search(r'(\d+)$', p['node']).group(1))
    return None, None


def wait_node(dev, seconds=10):
    for _ in range(seconds * 4):
        if os.path.exists(dev):
            return True
        time.sleep(0.25)
    return os.path.exists(dev)


def ntfs_resize(dev, size, on_pct=None):
    code, out, err = RUN(['ntfsresize', '--force', '--no-action', '--size', str(size), dev])
    if code != 0:
        raise Fail("ntfsresize's test run refused: " + ((err or out).strip().splitlines() or ['?'])[-1])

    def line(l):
        m = re.search(r'([\d.]+) percent completed', l)
        if m and on_pct:
            on_pct(float(m.group(1)))
    code, tail = STREAM(['ntfsresize', '--force', '--size', str(size), dev], 'y\n', line)   # answers "Proceed? y"
    if code != 0:
        raise Fail('ntfsresize: ' + (tail[-1] if tail else 'failed'))


def do_check(step):
    dev, fs = step['dev'], step['fs']
    if fs == 'ntfs':
        code, out, err = RUN(['ntfsresize', '--info', '--force', '--no-progress-bar', dev])
        n = parse_ntfsresize_info(out + err)
        if n.get('problem'):
            raise Fail(text(n['problem'], name=step.get('name') or 'Windows'))
        code, out, err = RUN(['ntfsfix', '-n', dev])
        if code != 0 or re.search(r'hibernat|unclean|refus', out + err, re.I):
            raise Fail(text('fast-startup' if re.search(r'hibernat|unclean', out + err, re.I) else 'needs-check', name=step.get('name') or 'Windows'))
        code, out, err = RUN(['ntfsresize', '--force', '--no-action', '--size', str(step['newFs']), dev])
        if code != 0:
            raise Fail("ntfsresize's test run refused: " + ((err or out).strip().splitlines() or ['?'])[-1])
    elif fs == 'ext4':
        code, out, err = RUN(['e2fsck', '-f', '-n', dev])
        if code != 0:
            raise Fail(text('linux-check', step.get('name') or 'the other system') + ' (e2fsck found problems)')
        code, out, err = RUN(['e2fsck', '-f', '-p', dev])   # nothing to fix (checked above); marks it checked for resize2fs
        if code not in (0, 1):
            raise Fail('e2fsck: ' + ((err or out).strip().splitlines() or ['failed'])[-1])
    elif fs == 'btrfs':
        code, out, err = RUN(['btrfs', 'check', '--readonly', dev])
        if code != 0:
            raise Fail(text('linux-check', step.get('name') or 'the other system') + ' (btrfs check found problems)')
    else:
        raise Fail(f"{fs} can't be made smaller")


def shrink_fs(step, on_pct):
    dev, fs, new = step['dev'], step['fs'], step['newFs']
    if fs == 'ntfs':
        ntfs_resize(dev, new, on_pct)
    elif fs == 'ext4':
        sh(['resize2fs', dev, f'{new // 1024}K'], what='resize2fs')
    elif fs == 'btrfs':
        def go(mnt):
            _, show, _ = RUN(['btrfs', 'filesystem', 'show', mnt])
            devs, _ = parse_btrfs_show(show)
            sh(['btrfs', 'filesystem', 'resize', f'{devs[0][0] if devs else 1}:{new}', mnt], what='btrfs resize')
        with_mount(dev, fs, go, rw=True)


def grow_fs_back(step):
    dev, fs, old = step['dev'], step['fs'], step['oldFs']
    if fs == 'ntfs':
        ntfs_resize(dev, old)
    elif fs == 'ext4':
        sh(['resize2fs', dev, f'{old // 1024}K'], what='resize2fs')
    elif fs == 'btrfs':
        with_mount(dev, fs, lambda mnt: sh(['btrfs', 'filesystem', 'resize', 'max', mnt], what='btrfs resize'), rw=True)


def set_part_size(disk, num, start, sectors):
    sh(['sfdisk', '--no-reread', '--no-tell-kernel', '--force', '-N', str(num), disk], input=f'start={start}, size={sectors}\n', what='sfdisk')
    settle(disk, num)


def delete_part(disk, num):
    sh(['sfdisk', '--no-reread', '--no-tell-kernel', '--force', '--delete', disk, str(num)], what='sfdisk')
    RUN(['partx', '-d', '--nr', str(num), disk])


def check_table_unchanged(disk, step):
    """Before changing a partition: it's still exactly where the plan says (nothing else changed it meanwhile)."""
    for p in part_table(disk).get('partitions', []):
        if int(re.search(r'(\d+)$', p['node']).group(1)) == step['num']:
            if int(p['start']) != step['start'] or int(p['size']) != step['oldSectors']:
                raise Fail('the partition table changed since Hearth looked at it')
            return
    raise Fail('the partition is gone')


def region_free(disk, start, sectors):
    for p in part_table(disk).get('partitions', []):
        s, n = int(p['start']), int(p['size'])
        if s < start + sectors and start < s + n:
            raise Fail('that space is not free any more')


def execute(plan, journal, emit=progress):
    """Runs the plan's steps; on failure undoes the finished ones in reverse order. Returns the result."""
    done = []     # (step, record) of finished steps that changed something
    ctx = {}
    total = len(plan['steps'])
    try:
        for i, step in enumerate(plan['steps']):
            base = 100 * i / total
            emit(base, cap(step['what']))
            rec = journal.start(step)
            kind = step['step']
            if kind == 'release':
                info = flatten(lsblk()).get(step['dev'], {})
                busy = busy_mounts(info)
                if busy:
                    raise Fail('the drive is open in another app (' + ', '.join(busy) + ')')
                for m in mounted_where(info):
                    sh(['umount', m], what='umount')
                if mounted_where(flatten(lsblk()).get(step['dev'], {})):
                    raise Fail("the drive couldn't be let go")
            elif kind == 'check':
                do_check(step)
            elif kind == 'shrink-fs':
                shrink_fs(step, lambda pct: emit(base + (100 / total) * pct / 100, cap(step['what']) + ' (this can take a while)'))
            elif kind in ('shrink-part', 'grow-part'):
                check_table_unchanged(step.get('disk') or plan['disk'], step)
                set_part_size(step.get('disk') or plan['disk'], step['num'], step['start'], step['newSectors'])
            elif kind == 'grow-fs':
                sh(['btrfs', 'filesystem', 'resize', f"{step['devid']}:max", step['mount']], what='btrfs resize')
            elif kind == 'new-part':
                region_free(step['disk'], step['start'], step['sectors'])
                sh(['sfdisk', '--no-reread', '--no-tell-kernel', '--force', '--append', step['disk']],
                   input=f'start={step["start"]}, size={step["sectors"]}, type={LINUX_TYPE}, name="{NEW_NAME}"\n', what='sfdisk')
                node, num = node_for_start(step['disk'], step['start'])
                if not node:
                    raise Fail("the new partition didn't appear")
                rec['node'], rec['num'] = node, num
                ctx['new'] = (node, num, step['disk'])
                done.append((step, rec))
                journal.done(rec, node=node, num=num)
                settle(step['disk'], num, add=True)
                if not wait_node(node):
                    raise Fail("the new partition didn't show up")
                continue
            elif kind == 'device-add':
                node = ctx['new'][0]
                RUN(['wipefs', '-a', node])   # old file system signatures in that space (the end of Windows' drive)
                sh(['btrfs', 'device', 'add', '-f', node, step['mount']], what='btrfs device add')
                rec['node'] = node
            elif kind == 'verify':
                # Everything is in place by now: what's found here is reported, not undone.
                _, show, _ = RUN(['btrfs', 'filesystem', 'show', plan.get('mount') or '/sysroot'])
                if plan['method'] == 'device-add' and ctx.get('new') and ctx['new'][0] not in [os.path.realpath(p) for _, p in parse_btrfs_show(show)[0]]:
                    ctx.setdefault('warnings', []).append("btrfs doesn't list the new partition yet; restart Hearth and check Settings › Import › Make Hearth bigger")
            if step['changes']:
                done.append((step, rec))
            journal.done(rec)
    except Exception as e:   # noqa: anything at all: undo what can be undone
        msg = str(e) if isinstance(e, Fail) else f'{type(e).__name__}: {e}'
        emit(100, 'Putting things back')
        undone, stuck = rollback(done, plan, journal)
        if stuck:
            journal.finish('stuck', error=msg, undo=stuck)
            raise Fail(f"{msg}. Hearth couldn't put everything back ({stuck}). Don't change partitions now; "
                       f"send the logs (Settings › System). The record of what happened is in {JOURNAL}.")
        journal.finish('rolled-back', error=msg, undone=undone)
        if any(s['changes'] for s, _ in done):
            raise Fail(f'{msg}. Everything was put back as it was')
        raise Fail(f'{msg}. Nothing was changed')
    journal.finish('done')
    emit(100, 'Done')
    return {'ok': True, 'from': plan['from'], 'method': plan['method'], 'gave': plan['give'],
            'newPart': ctx.get('new', (None,))[0], 'journal': journal.path, 'warnings': ctx.get('warnings', [])}


def rollback(done, plan, journal):
    """Undoes finished steps, newest first. Stops at the first undo that fails (the earlier ones depend on it).
    Returns (undone step names, what got stuck or '')."""
    undone = []
    for step, rec in reversed(done):
        kind = step['step']
        try:
            if kind == 'device-add':
                return undone, 'the new partition is already part of Hearth'   # never undone automatically
            if kind == 'new-part':
                delete_part(step['disk'], rec['num'])
            elif kind in ('shrink-part', 'grow-part'):
                set_part_size(step.get('disk') or plan['disk'], step['num'], step['start'], step['oldSectors'])
            elif kind == 'shrink-fs':
                grow_fs_back(step)
            elif kind == 'grow-fs':
                return undone, "Hearth's file system was already grown"
            rec['state'] = 'undone'
            journal.save()
            undone.append(kind)
        except Exception as e:   # noqa
            rec['state'] = 'undo-failed'
            rec['undoError'] = str(e)
            journal.save()
            return undone, f'undoing "{step["what"]}" failed: {e}'
    return undone, ''


# ---------------------------------------------------------------------- commands

def status():
    print(json.dumps(status_data()))


def parse_grow_args(args):
    src, gb, dry = None, None, False
    i = 0
    while i < len(args):
        a = args[i]
        if a == '--from' and i + 1 < len(args):
            src = args[i + 1]
            i += 2
        elif a == '--gb' and i + 1 < len(args) and re.fullmatch(r'\d{1,6}', args[i + 1]):
            gb = int(args[i + 1])
            i += 2
        elif a == '--dry-run':
            dry = True
            i += 1
        else:
            raise Fail('usage: hearth-space grow --from DEV|free --gb N [--dry-run]')
    if not src or (src != 'free' and not re.fullmatch(r'/dev/[A-Za-z0-9/_-]+', src)):
        raise Fail('choose which system gives the space (--from /dev/... or --from free)')
    if gb is None or not 1 <= gb <= MAX_GB:
        raise Fail('choose how many GB (--gb N)')
    return src, gb, dry


def grow(args):
    src, gb, dry = parse_grow_args(args)
    if os.geteuid() != 0:
        raise Fail('needs root (run through hearth-admin)')
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    lock = open(LOCK, 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise Fail('Hearth is already resizing')
    progress(0, 'Looking at the drive')
    root = root_info()
    st = status_data(root=root)
    tables = {d: part_table(d) for d in st['hearth']['disks']}
    if src != 'free':
        # The importer may have it open read-only: let go, then read exact numbers before planning.
        info = flatten(lsblk()).get(os.path.realpath(src), {})
        if mounted_where(info) and not busy_mounts(info) and not dry:
            for m in mounted_where(info):
                RUN(['umount', m])
            st = status_data(root=root, tables=tables)
    plan = plan_grow(st, src, gb, tables, root)
    plan['mount'] = root['mount']
    if dry:
        print(json.dumps({'dryRun': True, 'plan': plan}))
        return
    # From here on nothing stops it half-way: closing the app or a stray signal doesn't cut a resize off.
    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(sig, signal.SIG_IGN)
    journal = Journal(plan)
    log(f"giving {plan['give'] // GIB} GB from {plan['name']} ({plan['method']})")
    result = execute(plan, journal)
    try:
        s = os.statvfs(root['mount'])
        result['hearth'] = {'size': s.f_blocks * s.f_frsize, 'free': s.f_bavail * s.f_frsize}
    except OSError:
        pass
    print(json.dumps(result))


def clear_journal():
    if os.geteuid() != 0:
        raise Fail('needs root (run through hearth-admin)')
    j = read_journal()
    if j and j.get('state') in ('running', 'stuck'):
        os.replace(JOURNAL, JOURNAL.replace('.json', '.%d.json' % int(time.time())))
    print(json.dumps({'ok': True}))


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    try:
        if cmd == 'status' and len(argv) == 2:
            status()
        elif cmd == 'grow':
            grow(argv[2:])
        elif cmd == 'clear-journal' and len(argv) == 2:
            clear_journal()
        else:
            raise Fail('usage: hearth-space status | grow --from DEV|free --gb N [--dry-run] | clear-journal')
    except Fail as e:
        print('error: ' + str(e), flush=True)
        return 1
    except (OSError, ValueError, KeyError) as e:
        print('error: ' + f'{type(e).__name__}: {e}', flush=True)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
