#!/usr/bin/python3
"""hearth-boot-first: at every start, keeps Hearth OS first in the PC's boot order (UEFI), so the PC starts
Hearth and not another system on the same PC. Another system's updates (Windows Update especially) like to put
themselves first; Hearth's boot menu still lists them, so nothing is lost. The firmware is only written to when
something needs changing. Turn it off with: sudo touch /etc/hearth/keep-boot-order
"""
import os
import re
import shutil
import subprocess
import sys

OPT_OUT = '/etc/hearth/keep-boot-order'


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ''


def boot_entries(text):
    entries = {m.group(1).upper(): m.group(0) for m in re.finditer(r'^Boot([0-9A-Fa-f]{4})\*?\s.*$', text, re.M)}
    m = re.search(r'^BootOrder:\s*([0-9A-Fa-f,]*)', text, re.M)
    return entries, [x.upper() for x in (m.group(1).split(',') if m else []) if x]


def efi_loader(esp_root):
    """\\EFI\\<distro>\\shimx64.efi (or grub) for whichever folder Hearth's boot loader is in."""
    efi = os.path.join(esp_root, 'EFI')
    names = os.listdir(efi) if os.path.isdir(efi) else []
    for d in ('fedora', 'debian', 'ubuntu', 'anatase', 'cachyos', 'arch'):
        real = next((n for n in names if n.lower() == d), None)
        for f in ('shimx64.efi', 'grubx64.efi'):
            if real and os.path.isfile(os.path.join(efi, real, f)):
                return f'\\EFI\\{real}\\{f}'
    return '\\EFI\\fedora\\grubx64.efi'


def same_loader(line, loader):
    """Does this boot entry start `loader` (\\EFI\\fedora\\shimx64.efi)? efibootmgr shows the path with either slash."""
    want = loader.replace('\\', '/').lower()
    return bool(loader) and want in line.replace('\\', '/').lower()


def plan(text, partuuid, loader=''):
    """(entry to put first or None, new order or None when it's already first). Hearth's entry is the one on its
    EFI partition; failing that, an entry called "Hearth OS" that starts its boot loader: some firmware rewrites
    the entries it keeps (without the partition's id), and a new entry was then made at every start."""
    entries, order = boot_entries(text)
    mine = next((n for n, line in entries.items() if partuuid and partuuid in line.lower()), None)
    if not mine:
        mine = next((n for n, line in entries.items() if 'Hearth OS' in line and same_loader(line, loader)), None)
    if not mine:
        return None, None
    if order and order[0] == mine:
        return mine, None
    return mine, [mine] + [x for x in order if x != mine]


def main():
    if os.path.exists(OPT_OUT) or not os.path.isdir('/sys/firmware/efi'):
        return 0
    if not shutil.which('efibootmgr'):
        print('efibootmgr is missing: the boot order is left as it is')
        return 0
    esp = run('findmnt', '-no', 'SOURCE', '/boot/efi').strip()
    if not esp:
        return 0
    partuuid = run('blkid', '-s', 'PARTUUID', '-o', 'value', esp).strip().lower()
    text = run('efibootmgr', '-v')
    if not text.strip():
        return 0          # efibootmgr couldn't read the firmware's entries: change nothing
    loader = efi_loader('/boot/efi')
    mine, order = plan(text, partuuid, loader)
    num = re.search(r'(\d+)$', esp)
    if not mine and partuuid and num:
        # No entry for Hearth's EFI partition at all: make one.
        disk = '/dev/' + run('lsblk', '-no', 'PKNAME', esp).strip()
        run('efibootmgr', '-q', '-c', '-d', disk, '-p', num.group(1), '-L', 'Hearth OS', '-l', loader)
        mine, order = plan(run('efibootmgr', '-v'), partuuid, loader)
    if mine and order:
        run('efibootmgr', '-q', '-o', ','.join(order))
        print(f'Hearth OS ({mine}) is first in the boot order again')
    return 0


if __name__ == '__main__':
    sys.exit(main())
