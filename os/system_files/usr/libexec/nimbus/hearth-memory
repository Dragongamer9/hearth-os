# ------------------------------------------------------------------ the memory guard
LEVELS = {  # when memory really runs out: available below avail% of RAM, swap almost full, and stalls for `hold` seconds
    'gentle': {'avail': 0.02, 'swapfree': 0.05, 'psi': 20.0, 'hold': 5},
    'strong': {'avail': 0.05, 'swapfree': 0.15, 'psi': 10.0, 'hold': 3},
}


def proc_list(root=None):
    root = root or PROC
    out = []
    for d in os.listdir(root):
        if not d.isdigit():
            continue
        st = read(os.path.join(root, d, 'status'))
        if not st:
            continue
        f = {}
        for line in st.splitlines():
            k, _, v = line.partition(':')
            f[k] = v.strip()
        try:
            uid = int(f.get('Uid', '0').split()[0])
            ppid = int(f.get('PPid', '0'))
        except ValueError:
            continue
        kb = lambda k: int((f.get(k) or '0 kB').split()[0]) * 1024
        out.append({'pid': int(d), 'ppid': ppid, 'uid': uid, 'comm': f.get('Name', ''), 'rss': kb('VmRSS'), 'swap': kb('VmSwap'),
                    'cgroup': read(os.path.join(root, d, 'cgroup')).strip().split('::')[-1]})
    return out


def is_game(p, root=None):
    env = read(os.path.join(root or PROC, str(p['pid']), 'environ'))
    return 'SteamAppId=' in env or 'STEAM_COMPAT_APP_ID=' in env or 'SteamGameId=' in env


def protected_pids(procs, never, extra, root=None):
    """Pids on the Never close list, and their children (an app's helpers and renderers)."""
    names = set(extra or [])
    for k in never or []:
        names.update(NEVER_COMMS.get(k, []))
    by_pid = {p['pid']: p for p in procs}
    keep = set()
    for p in procs:
        if p['uid'] < 1000 or p['comm'] in names or ('game' in (never or []) and is_game(p, root)):
            keep.add(p['pid'])
        elif 'aicc' in (never or []) and 'hearth-ai-command-center' in read(os.path.join(root or PROC, str(p['pid']), 'cmdline')):
            keep.add(p['pid'])
    changed = True
    while changed:
        changed = False
        for p in procs:
            if p['pid'] not in keep and p['ppid'] in keep and by_pid.get(p['ppid'], {}).get('uid', 0) >= 1000:
                keep.add(p['pid'])
                changed = True
    return keep


def app_key(p):
    """One app = its systemd scope (app-…scope) when it has one, else the process."""
    m = re.search(r'/(app-[^/]+\.(?:scope|service))', p['cgroup'] or '')
    return m.group(1) if m else 'pid-%d' % p['pid']


def pick_victim(procs, keep):
    groups = {}
    for p in procs:
        if p['uid'] < 1000 or p['pid'] in keep:
            continue
        g = groups.setdefault(app_key(p), {'pids': [], 'bytes': 0, 'names': {}, 'protected': False})
        g['pids'].append(p['pid'])
        g['bytes'] += p['rss'] + p['swap']
        g['names'][p['comm']] = g['names'].get(p['comm'], 0) + p['rss'] + p['swap']
    # an app scope with a protected process in it is kept whole
    for p in procs:
        if p['pid'] in keep and app_key(p) in groups:
            groups[app_key(p)]['protected'] = True
    cands = [(g['bytes'], k, g) for k, g in groups.items() if not g['protected'] and g['bytes'] > 64 * 1024 * 1024]
    if not cands:
        return None
    cands.sort(key=lambda x: -x[0])
    b, k, g = cands[0]
    name = max(g['names'].items(), key=lambda x: x[1])[0]
    return {'key': k, 'pids': g['pids'], 'bytes': b, 'name': name}


def out_of_memory(mi, p, level):
    L = LEVELS.get(level)
    if not L:
        return False
    total = mi.get('MemTotal', 1)
    swap_total = mi.get('SwapTotal', 0)
    swap_free_ok = swap_total == 0 or mi.get('SwapFree', 0) < swap_total * L['swapfree']
    return mi.get('MemAvailable', 0) < total * L['avail'] and swap_free_ok and p.get('full', 0) >= L['psi']


def tell(text):
    """A notification in the signed-in person's session (each local session)."""
    code, out, _ = run(['loginctl', 'list-sessions', '--no-legend'], 10)
    for line in out.splitlines():
        f = line.split()
        if len(f) >= 3 and f[1].isdigit() and int(f[1]) >= 1000:
            uid, user = int(f[1]), f[2]
            env = ['env', 'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%d/bus' % uid, 'XDG_RUNTIME_DIR=/run/user/%d' % uid]
            run(['runuser', '-u', user, '--'] + env + ['notify-send', '-a', 'Hearth', '-i', 'dialog-warning',
                                                       'Memory ran out', text], 10)


def guard():
    """The loop: every second; settings read again every 30 s (yours change in Settings)."""
    os.makedirs(STATE, exist_ok=True)
    try:
        with open(os.path.join(PROC, 'self', 'oom_score_adj'), 'w') as f:
            f.write('-1000')
    except OSError:
        pass
    cfg, cfg_at, since, protect_at = None, 0, None, 0
    while True:
        now = time.time()
        if cfg is None or now - cfg_at > 30:
            try:
                cfg = merged(load_settings(), meminfo().get('MemTotal', 0))['guard']
            except Fail:
                cfg = recommended(meminfo().get('MemTotal', 0))['guard']
            cfg_at = now
        level = cfg.get('level', 'gentle')
        if level == 'off':
            time.sleep(5)
            continue
        if now - protect_at > 10:          # the kernel's own last resort spares the Never close list too
            procs = proc_list()
            for pid in protected_pids(procs, cfg.get('never'), cfg.get('extra')):
                try:
                    with open(os.path.join(PROC, str(pid), 'oom_score_adj'), 'w') as f:
                        f.write('-900')
                except OSError:
                    pass
            protect_at = now
        mi, p = meminfo(), pressure()
        if out_of_memory(mi, p, level):
            since = since or now
            if now - since >= LEVELS[level]['hold']:
                procs = proc_list()
                v = pick_victim(procs, protected_pids(procs, cfg.get('never'), cfg.get('extra')))
                if v:
                    for pid in v['pids']:
                        try:
                            os.kill(pid, signal.SIGTERM)
                        except OSError:
                            pass
                    time.sleep(5)
                    for pid in v['pids']:
                        try:
                            os.kill(pid, signal.SIGKILL)
                        except OSError:
                            pass
                    rec = {'at': int(now), 'name': v['name'], 'mb': v['bytes'] // (1024 * 1024)}
                    with open(os.path.join(STATE, 'guard.log'), 'a') as f:
                        f.write(json.dumps(rec) + '\n')
                    tell('%s was closed: it was using %.1f GB and memory was full. You can open it again.' % (v['name'], v['bytes'] / GIB))
                since = None
                time.sleep(10)
                continue
        else:
            since = None
        time.sleep(1)


# ------------------------------------------------------------------ main
def out(obj):
    print(json.dumps(obj))


def main(argv):
    a = argv[1:]
    try:
        if a == ['status']:
            out(status())
        elif a == ['apply']:
            mem = meminfo().get('MemTotal', 0)
            try:
                migrate_once(mem)
            except (OSError, ValueError) as e:
                print('hearth-memory: migration skipped (%s)' % e, file=sys.stderr)
            out(apply(None, mem))
        elif a and a[0] == 'set' and len(a) <= 3:
            rest = a[1:]
            try_only = '--try' in rest
            rest = [x for x in rest if x != '--try']
            if len(rest) > 1:
                raise Fail('set takes one JSON')
            # The JSON as an argument (pkexec passes no environment), else HEARTH_INPUT or stdin.
            changes = json.loads(rest[0] if rest else (os.environ.get('HEARTH_INPUT') or sys.stdin.read() or '{}'))
            if not isinstance(changes, dict):
                raise Fail('nothing to set')
            out(set_settings(changes, try_only=try_only))
        elif a == ['recommended']:
            out(back_to_recommended())
        elif len(a) == 2 and a[0] == 'swapfile':
            out(swapfile_size(a[1]))
        elif len(a) == 3 and a[0] == 'never' and a[2] in ('on', 'off'):
            if not re.match(r'^[\w.+-]{1,64}$', a[1]):
                raise Fail('not a program name: ' + a[1])
            mem = meminfo().get('MemTotal', 0)
            extra = list(merged(load_settings(), mem)['guard'].get('extra') or [])
            if a[2] == 'on' and a[1] not in extra:
                extra.append(a[1])
            if a[2] == 'off':
                extra = [x for x in extra if x != a[1]]
            r = set_settings({'guard': {'extra': extra}})
            r['never'] = extra
            out(r)
        elif a == ['adopt']:
            out(adopt())
        elif a == ['guard']:
            guard()
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except Fail as e:
        print('error: %s' % e)
        return 1
    except (ValueError, TypeError) as e:
        print('error: %s' % e)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
