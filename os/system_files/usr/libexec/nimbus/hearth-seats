def unit_state(unit):
    rc, out, _ = RUNNER.run(['systemctl', 'is-active', unit], timeout=10)
    return out.strip() or 'unknown'


def status():
    c = load_config()
    if not c:
        return {'configured': False, 'enabled': False, 'mode': None, 'seats': [], 'host': None}
    seats = []
    for s in c.get('seats', []):
        kind = seat_kind(c, s)
        e = {'seat': s['seat'], 'user': s['user'], 'mode': kind, 'output': s.get('output'), 'gpu': s.get('gpu'),
             'pads': s.get('pads', [])}
        if kind == 'split':
            e['region'] = s.get('region')
        if kind == 'stream' and isinstance(s.get('stream'), dict):
            e['stream'] = {k: s['stream'].get(k) for k in ('size', 'fps', 'port', 'name')}
        if s['seat'] == 1:
            e['state'] = 'active'
        else:
            svc = unit_state('hearth-seat@%s.service' % s['user'])
            if svc == 'active':
                e['state'] = 'running'
            elif svc in ('activating', 'reloading'):
                e['state'] = 'starting'
            elif svc == 'failed':
                e['state'] = 'failed'
            elif kind in HOST_KINDS and c.get('enabled') and unit_state('hearth-seat@%s.path' % s['user']) == 'active':
                e['state'] = 'waiting'   # for player 1's Game Mode to open its screen
            else:
                e['state'] = 'stopped'
        seats.append(e)
    host = None
    if hosted(c):
        host = {'running': os.path.exists(os.path.join(SEAT_RUN, 'host.pid')) and pid_alive(read(os.path.join(SEAT_RUN, 'host.pid'))),
                'paused': host_paused()}
    return {'configured': True, 'enabled': bool(c.get('enabled')), 'mode': c.get('mode'), 'seats': seats, 'host': host,
            'split': c.get('split'), 'audio': audio_prefs() if config_has(c, 'split') else None}


def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except (ValueError, ProcessLookupError):
        return False
    except PermissionError:
        return True


# ---------------------------------------------------------------------------------------------- extra player's session
def seat_env_file(user):
    return '/etc/hearth/seats/%s.env' % user


def parse_env(text):
    env = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        k, v = line.split('=', 1)
        if re.fullmatch(r'[A-Z_][A-Z0-9_]*', k):
            try:
                v = shlex.split(v)[0] if v else ''
            except ValueError:
                pass
            env[k] = v
    return env


def session_gamescope_args(env):
    mode = env.get('HEARTH_SEAT_MODE')
    args = []
    if mode == 'gpu':
        if env.get('HEARTH_SEAT_VK_DEVICE'):
            args += ['--prefer-vk-device', env['HEARTH_SEAT_VK_DEVICE']]
        if env.get('HEARTH_SEAT_OUTPUT'):
            args += ['--prefer-output', env['HEARTH_SEAT_OUTPUT']]
    elif mode in ('nested', 'split'):
        # The window's size: the whole screen (nested) or this player's part of it (split); games render at it too.
        m = re.fullmatch(r'(\d{2,5})x(\d{2,5})', env.get('HEARTH_SEAT_SIZE', ''))
        if m:
            args += ['-W', m.group(1), '-H', m.group(2), '-w', m.group(1), '-h', m.group(2)]
    elif mode == 'stream':
        args = stream_gamescope_args(env)
    return args


def stream_settings(env):
    """(size "WxH", fps) of a streamed player's virtual screen: presets only, else 1080p60."""
    size = env.get('HEARTH_SEAT_STREAM_SIZE')
    fps = env.get('HEARTH_SEAT_STREAM_FPS', '')
    return (size if size in STREAM_SIZES else '1920x1080',
            int(fps) if fps.isdigit() and int(fps) in STREAM_FPS else 60)


def stream_gamescope_args(env):
    """gamescope for a streamed player: nested in the virtual screen (headless labwc), at the picture size and
    frame rate the player chose; games render at that size."""
    size, fps = stream_settings(env)
    w, h = size.split('x')
    args = ['-W', w, '-H', h, '-w', w, '-h', h, '-r', str(fps)]
    if re.fullmatch(r'[0-9a-f]{4}:[0-9a-f]{4}', env.get('HEARTH_SEAT_VK_DEVICE', '')):
        args += ['--prefer-vk-device', env['HEARTH_SEAT_VK_DEVICE']]
    return args


def stream_labwc_env(env):
    """A streamed player's virtual screen: labwc with wlroots' headless backend (one output, no real screen or
    input devices), rendering on the chosen card. Sunshine captures that output (wlr-screencopy): gamescope's
    own headless backend has no output Sunshine can capture (no KMS, no screencopy; Sunshine doesn't read
    gamescope's PipeWire stream directly)."""
    out = dict(env)
    out.update(WLR_BACKENDS='headless', WLR_HEADLESS_OUTPUTS='1', WLR_LIBINPUT_NO_DEVICES='1')
    render = env.get('HEARTH_SEAT_RENDER', '')
    if re.fullmatch(r'/dev/dri/renderD[0-9]{3}', render):
        out['WLR_RENDER_DRM_DEVICE'] = render
    for k in ('WAYLAND_DISPLAY', 'DISPLAY', 'LIBSEAT_BACKEND'):
        out.pop(k, None)
    return out


def stream_rc_xml():
    return ('<?xml version="1.0"?>\n<!-- Hearth multi-seat: a streamed player\'s virtual screen (written by hearth-seats). -->\n'
            '<labwc_config>\n  <core><decoration>client</decoration><gap>0</gap></core>\n'
            '  <keyboard><default /></keyboard>\n  <mouse><default /></mouse>\n'
            '  <windowRules>\n    <windowRule identifier="*" serverDecoration="no" skipTaskbar="yes" />\n  </windowRules>\n'
            '</labwc_config>\n')


def write_labwc_dir(d, rc_xml, autostart_cmd):
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, 'rc.xml'), 'w') as f:
        f.write(rc_xml)
    with open(os.path.join(d, 'autostart'), 'w') as f:
        f.write('#!/bin/sh\n# Hearth multi-seat (written by hearth-seats)\nexec %s\n' % ' '.join(shlex.quote(a) for a in autostart_cmd))
    open(os.path.join(d, 'environment'), 'w').close()
    with open(os.path.join(d, 'menu.xml'), 'w') as f:
        f.write('<?xml version="1.0"?><openbox_menu></openbox_menu>\n')


def session(wait=60):
    """An extra player's Game Mode. Runs as hearth-pN from hearth-seat@hearth-pN.service, in its own logind
    session (no seat). Sets up the screen, sound and Game Mode options, then hands over to nimbus-session."""
    me = main_user()['name']
    m = PLAYER_RE.fullmatch(me)
    if not m:
        raise Fail('the session is only for the extra players\' accounts')
    env = dict(os.environ)
    env.update(parse_env(read(seat_env_file(me))))
    mode = env.get('HEARTH_SEAT_MODE')
    env['HEARTH_SEAT'] = m.group(1)
    env['NIMBUS_START_MODE'] = 'game'
    env.setdefault('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid())
    if not env.get('DBUS_SESSION_BUS_ADDRESS') and os.path.exists(os.path.join(env['XDG_RUNTIME_DIR'], 'bus')):
        env['DBUS_SESSION_BUS_ADDRESS'] = 'unix:path=' + os.path.join(env['XDG_RUNTIME_DIR'], 'bus')
    # The packaged Sunshine (Remote play is player 1's) never starts for an extra player: it would try
    # Remote play's ports and capture. Streamed players get their own instance (hearth-seat-sunshine.service).
    RUNNER.run(['systemctl', '--user', 'mask', '--runtime'] + list(SUNSHINE_DEFAULT_UNITS), timeout=10)
    if mode == 'gpu':
        # Our own graphics card, opened directly (it isn't part of any logind seat, so there's no seat to ask).
        env['LIBSEAT_BACKEND'] = 'noop'
        env.pop('WAYLAND_DISPLAY', None)
        env.pop('DISPLAY', None)
    elif mode in ('nested', 'split'):
        sock = os.path.join(SEAT_RUN, me, 'wayland-0')
        deadline = time.monotonic() + wait
        while not os.path.exists(sock):
            if time.monotonic() > deadline:
                raise Fail('player 1\'s Game Mode didn\'t open this player\'s screen')
            time.sleep(1)
        env['WAYLAND_DISPLAY'] = sock
        env.pop('DISPLAY', None)
        env['HEARTH_SEAT_HOSTED'] = '1'  # a window of player 1's host: Hearth reads this player's controllers itself
        env.update(parse_env(read(os.path.join(SEAT_RUN, me, 'audio.env'))))
    elif mode == 'stream':
        # The virtual screen first; inside it, stream-run starts Sunshine and this player's Game Mode.
        d = os.path.join(env['XDG_RUNTIME_DIR'], 'hearth-seat-stream')
        write_labwc_dir(d, stream_rc_xml(), ['python3', os.path.realpath(__file__), 'stream-run'])
        os.execvpe('labwc', ['labwc', '-C', d], stream_labwc_env(env))
    else:
        raise Fail('this player isn\'t set up (no %s)' % seat_env_file(me))
    # nimbus-session passes these to gamescope (the player's own session.conf could add more).
    env['NIMBUS_GAMESCOPE_ARGS'] = ' '.join(shlex.quote(a) for a in session_gamescope_args(env))
    os.execve('/usr/bin/nimbus-session', ['nimbus-session'], env)


# ---------------------------------------------------------------------------------------------- streamed players
def headless_output():
    """The name of the virtual screen's output (HEADLESS-1), from wlr-randr."""
    rc, out, _ = RUNNER.run(['wlr-randr'], timeout=10)
    for line in out.splitlines() if rc == 0 else []:
        if line and not line[0].isspace():
            name = line.split()[0]
            if re.fullmatch(r'[A-Za-z0-9_-]{1,32}', name):
                return name
    return 'HEADLESS-1'


def stream_run():
    """Inside a streamed player's virtual screen (headless labwc): size it, start their Sunshine, run their Game
    Mode; when Game Mode ends, stop Sunshine and close the virtual screen (the session then ends)."""
    me = main_user()['name']
    m = PLAYER_RE.fullmatch(me)
    if not m:
        raise Fail('only for a streamed player\'s account')
    env = dict(os.environ)
    env.update(parse_env(read(seat_env_file(me))))
    if env.get('HEARTH_SEAT_MODE') != 'stream':
        raise Fail('this player isn\'t streamed')
    size, fps = stream_settings(env)
    run = env.get('XDG_RUNTIME_DIR') or '/run/user/%d' % os.getuid()
    code = 1
    try:
        RUNNER.run(['wlr-randr', '--output', headless_output(), '--custom-mode', '%s@%dHz' % (size, fps)], timeout=15)
        disp = env.get('WAYLAND_DISPLAY', '')
        path = disp if disp.startswith('/') else os.path.join(run, disp)
        d = os.path.join(run, 'hearth-seat-stream')
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, 'stream.env'), 'w') as f:
            f.write('WAYLAND_DISPLAY=%s\n' % shlex.quote(path))
        RUNNER.run(['systemctl', '--user', 'restart', SUNSHINE_UNIT], timeout=30)
        env['HEARTH_SEAT'] = m.group(1)
        env['NIMBUS_START_MODE'] = 'game'
        env['NIMBUS_GAMESCOPE_ARGS'] = ' '.join(shlex.quote(a) for a in stream_gamescope_args(env))
        env.pop('LABWC_PID', None)      # nimbus-mode must see Game Mode, not the virtual screen
        env.pop('DISPLAY', None)
        code = subprocess.call(['/usr/bin/nimbus-session'], env=env)
    finally:
        RUNNER.run(['systemctl', '--user', 'stop', SUNSHINE_UNIT], timeout=30)
        RUNNER.run(['labwc', '--exit'], timeout=10)
    return code


def sunshine_conf(env, home_dir):
    """This player's own Sunshine: its own port family, name in Moonlight, pairings and certificate, capturing
    their virtual screen only, controllers only (keyboard and mouse would have nowhere to go: the virtual screen
    has no input devices), web page reachable from this PC only."""
    size, fps = stream_settings(env)
    port = env.get('HEARTH_SEAT_STREAM_PORT', '')
    name = env.get('HEARTH_SEAT_STREAM_NAME', '')
    if not port.isdigit() or int(port) not in [stream_port(n) for n in (2, 3, 4)]:
        raise Fail('this player\'s stream has no port (set it up again)')
    if not re.fullmatch(r'[A-Za-z0-9-]{1,24} Player [2-4]', name):
        name = 'Hearth Player %s' % env.get('HEARTH_SEAT', '2')
    d = home_dir
    lines = ['# Hearth multi-seat: this player\'s streaming (written by hearth-seats each time it starts; changes are overwritten)',
             'sunshine_name = %s' % name,
             'port = %s' % port,
             'capture = wlr',
             'output_name = 0',
             'origin_web_ui_allowed = pc',
             'upnp = disabled',
             'keyboard = disabled',
             'mouse = disabled',
             'gamepad = auto',
             'file_state = %s' % os.path.join(d, 'sunshine_state.json'),
             'credentials_file = %s' % os.path.join(d, 'credentials.json'),
             'pkey = %s' % os.path.join(d, 'credentials', 'cakey.pem'),
             'cert = %s' % os.path.join(d, 'credentials', 'cacert.pem'),
             'file_apps = %s' % os.path.join(d, 'apps.json'),
             'log_path = %s' % os.path.join(d, 'sunshine.log')]
    render = env.get('HEARTH_SEAT_RENDER', '')
    if re.fullmatch(r'/dev/dri/renderD[0-9]{3}', render):
        lines.append('adapter_name = %s' % render)
    return '\n'.join(lines) + '\n'


def sunshine_apps():
    """Moonlight shows one thing to start: Hearth (the stream is the player's whole Game Mode)."""
    return json.dumps({'env': {}, 'apps': [{'name': 'Hearth', 'image-path': 'desktop.png'}]}, indent=1) + '\n'


def stream_creds(user):
    """Sunshine's web login for player N's stream (hearth-admin made it; player 1 and that player can read it)."""
    try:
        with open('/etc/hearth/seats/%s.stream.json' % user) as f:
            c = json.load(f)
        if isinstance(c.get('user'), str) and isinstance(c.get('pass'), str):
            return c['user'], c['pass']
    except (OSError, ValueError, AttributeError):
        pass
    return None


def sunshine_main():
    """hearth-seat-sunshine.service (a user service of a streamed player): writes this player's Sunshine settings,
    sets its login, and runs it on the virtual screen."""
    me = main_user()['name']
    if not PLAYER_RE.fullmatch(me):
        raise Fail('only for a streamed player\'s account')
    env = dict(os.environ)
    env.update(parse_env(read(seat_env_file(me))))
    if env.get('HEARTH_SEAT_MODE') != 'stream':
        raise Fail('this player isn\'t streamed')
    exe = next((os.path.join(d, 'sunshine') for d in env.get('PATH', '/usr/bin:/bin').split(':')
                if d and os.access(os.path.join(d, 'sunshine'), os.X_OK)), None)
    if not exe:
        raise Fail('Sunshine isn\'t installed')
    run = env.get('XDG_RUNTIME_DIR') or '/run/user/%d' % os.getuid()
    env.update(parse_env(read(os.path.join(run, 'hearth-seat-stream', 'stream.env'))))
    os.makedirs(os.path.join(STREAM_DIR, 'credentials'), mode=0o700, exist_ok=True)
    conf = os.path.join(STREAM_DIR, 'sunshine.conf')
    with open(conf, 'w') as f:
        f.write(sunshine_conf(env, STREAM_DIR))
    with open(os.path.join(STREAM_DIR, 'apps.json'), 'w') as f:
        f.write(sunshine_apps())
    creds = stream_creds(me)
    if creds:
        RUNNER.run([exe, conf, '--creds', creds[0], creds[1]], timeout=30)
    os.execve(exe, [exe, conf], env)


def sunshine_api(port, method, path, body=None, creds=None, timeout=10):
    """One call to a streamed player's Sunshine web API on this PC (its own certificate, so not checked).
    Returns (status, JSON or {})."""
    import base64
    import ssl
    import urllib.error
    import urllib.request
    ctx = ssl.create_default_context()
    ctx.check_hostname = False
    ctx.verify_mode = ssl.CERT_NONE
    req = urllib.request.Request('https://127.0.0.1:%d%s' % (port + 1, path), method=method,
                                 data=json.dumps(body).encode() if body is not None else None,
                                 headers={'Content-Type': 'application/json'})
    if creds:
        req.add_header('Authorization', 'Basic ' + base64.b64encode(('%s:%s' % creds).encode()).decode())
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
            text = r.read().decode(errors='replace')
            code = r.status
    except urllib.error.HTTPError as e:
        return e.code, {}
    except (urllib.error.URLError, OSError, ValueError):
        return 0, {}
    try:
        return code, json.loads(text) if text.strip() else {}
    except ValueError:
        return code, {}


def addresses():
    rc, out, _ = RUNNER.run(['ip', '-4', '-o', 'addr', 'show', 'scope', 'global'], timeout=10)
    found = []
    for line in out.splitlines() if rc == 0 else []:
        w = line.split()
        if len(w) >= 4 and not w[1].startswith(('docker', 'veth', 'virbr', 'br-')):
            a = w[3].split('/')[0]
            if re.fullmatch(r'[0-9.]{7,15}', a):
                found.append(a)
    return found


def qr_svg(text):
    """A QR code (SVG) of the address, when qrencode is installed; else None."""
    if not have('qrencode'):
        return None
    rc, out, _ = RUNNER.run(['qrencode', '-t', 'SVG', '-m', '1', '-o', '-', text], timeout=10)
    svg = out[out.find('<svg'):] if rc == 0 and '<svg' in out else ''
    if not svg or re.search(r'<\s*script|on\w+\s*=|javascript:|href', svg, re.I):
        return None
    return svg


def stream_seats(c):
    return [s for s in (c or {}).get('seats', []) if s.get('seat') != 1 and seat_kind(c, s) == 'stream' and s.get('stream')]


def stream_info():
    c = load_config()
    if not c:
        raise Fail('multi-seat isn\'t set up')
    addrs = addresses()
    out = []
    for s in stream_seats(c):
        st = s['stream']
        port = int(st.get('port') or 0)
        e = {'seat': s['seat'], 'user': s['user'], 'name': st.get('name'), 'port': port, 'size': st.get('size'),
             'fps': st.get('fps'), 'running': unit_state('hearth-seat@%s.service' % s['user']) == 'active',
             'clients': [], 'pending': [], 'reachable': False,
             'addresses': ['%s:%d' % (a, port) for a in addrs], 'qr': None}
        creds = stream_creds(s['user'])
        if e['running'] and creds:
            code, r = sunshine_api(port, 'GET', '/api/clients/list', creds=creds)
            e['reachable'] = code == 200
            e['clients'] = [{'name': x.get('name'), 'uuid': x.get('uuid')} for x in (r.get('named_certs') or []) if isinstance(x, dict)]
            code, r = sunshine_api(port, 'GET', '/api/pin', creds=creds)
            if code == 200 and isinstance(r.get('pairings'), list):
                e['pending'] = [{'id': x.get('id'), 'name': x.get('name')} for x in r['pairings'] if isinstance(x, dict)]
        if e['addresses']:
            e['qr'] = qr_svg(e['addresses'][0])
        out.append(e)
    return {'seats': out}


def stream_pair(seat, pin, name=None):
    """Pairs the device showing `pin` in Moonlight with player `seat`'s stream. Newer Sunshine lists the devices
    waiting (GET /api/pin) and wants the one meant; older Sunshine takes just the PIN."""
    if not re.fullmatch(r'[0-9]{4}', pin or ''):
        raise Fail('The PIN is the 4 numbers Moonlight shows')
    c = load_config()
    s = next((x for x in stream_seats(c) if x['seat'] == seat), None)
    if not s:
        raise Fail('player %d isn\'t streamed' % seat)
    creds = stream_creds(s['user'])
    if not creds:
        raise Fail('player %d\'s stream has no login (set multi-seat up again)' % seat)
    name = re.sub(r'[^\w .-]', '', name or '')[:40].strip() or 'Player %d\'s device' % seat
    port = int(s['stream']['port'])
    code, r = sunshine_api(port, 'GET', '/api/pin', creds=creds)
    if code == 0:
        raise Fail('Player %d\'s stream isn\'t running. Turn multi-seat on, then try again.' % seat)
    body = {'pin': pin, 'name': name}
    if code == 200 and isinstance(r.get('pairings'), list):
        waiting = [x for x in r['pairings'] if isinstance(x, dict) and re.fullmatch(r'[0-9a-fA-F]{32}', str(x.get('id')))]
        if not waiting:
            raise Fail('Choose "%s" in Moonlight first: it then shows the PIN.' % s['stream'].get('name'))
        body['pairing_id'] = waiting[-1]['id']
    code, r = sunshine_api(port, 'POST', '/api/pin', body, creds=creds, timeout=40)
    if code == 401:
        raise Fail('Player %d\'s stream didn\'t accept Hearth\'s login. Restart multi-seat and try again.' % seat)
    if code != 200 or r.get('status') in (False, 'false'):
        raise Fail('That PIN didn\'t work. In Moonlight, choose "%s" again for a new one.' % s['stream'].get('name'))
    return {'ok': True, 'seat': seat}


def stream_unpair(seat, uuid):
    if not re.fullmatch(r'[0-9A-Fa-f-]{1,64}', uuid or ''):
        raise Fail('that isn\'t a paired device')
    c = load_config()
    s = next((x for x in stream_seats(c) if x['seat'] == seat), None)
    if not s:
        raise Fail('player %d isn\'t streamed' % seat)
    code, _ = sunshine_api(int(s['stream']['port']), 'POST', '/api/clients/unpair', {'uuid': uuid}, creds=stream_creds(s['user']))
    if code != 200:
        raise Fail('Player %d\'s stream isn\'t running' % seat)
    return {'ok': True}


# ---------------------------------------------------------------------------------------------- "Player N, press A"
def wait_button(timeout=20.0, exclude=(), now=time.monotonic):
    """The first controller (from scan_pads) on which a button goes down, or None after `timeout` seconds. Only
    controllers this account may open are listened to (another player's aren't, and don't need to be)."""
    import select
    fds = {}
    for p in scan_pads(load_config()):
        if not p.get('assignable') or p['id'] in exclude:
            continue
        for ev in p['events']:
            try:
                fds[os.open(ev, os.O_RDONLY | os.O_NONBLOCK)] = p
            except OSError:
                pass
    if not fds:
        raise Fail('No controllers to listen to. Connect a controller and try again.')
    bufs = {fd: b'' for fd in fds}
    end = now() + timeout
    try:
        while True:
            left = end - now()
            if left <= 0:
                return None
            ready, _, _ = select.select(list(fds), [], [], min(left, 0.5))
            for fd in ready:
                try:
                    chunk = os.read(fd, INPUT_EVENT.size * 64)
                except BlockingIOError:
                    continue
                except OSError:
                    chunk = b''
                bufs[fd] += chunk
                while len(bufs[fd]) >= INPUT_EVENT.size:
                    _, _, typ, code, value = INPUT_EVENT.unpack_from(bufs[fd])
                    bufs[fd] = bufs[fd][INPUT_EVENT.size:]
                    if typ == EV_KEY and value == 1 and BTN_JOYSTICK <= code <= 0x13e:
                        return fds[fd]
    finally:
        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass


def gamescope_args():
    """Extra gamescope options for the main user's own Game Mode: with a graphics card per player, player 1's
    Game Mode must stay on player 1's card."""
    c = load_config()
    if not c or not c.get('enabled') or c.get('mode') != 'gpu':
        return []
    me = main_user()['name']
    s = next((s for s in c.get('seats', []) if s.get('user') == me), None)
    if not s:
        return []
    args = []
    if s.get('vk_device'):
        args += ['--prefer-vk-device', s['vk_device']]
    if s.get('output'):
        args += ['--prefer-output', s['output'].split('-', 1)[1] if '-' in s['output'] else s['output']]
    return args


