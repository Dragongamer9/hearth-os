HOST_KINDS = ('nested', 'split')   # players whose window player 1's Game Mode hosts
# Presets (hearth-admin accepts nothing else).
STREAM_SIZES = ('1280x720', '1280x800', '1920x1080', '2560x1440', '3840x2160')
STREAM_FPS = (30, 60, 90, 120)
SPLIT_LAYOUTS = {'columns': 2, 'rows': 2, 'grid': 4}
# Each region of a split layout, in % of the screen (labwc's <regions>), in region order.
