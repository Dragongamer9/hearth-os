class Fail(Exception):
    pass


def fail(msg):
    print('error: ' + msg, flush=True)
    sys.exit(1)


def progress(pct, what):
    print('progress: %d %s' % (max(0, min(100, int(pct))), what), flush=True)


class Runner:
    """Runs commands; tests swap it for a fake."""

    def run(self, cmd, input=None, timeout=60):
        try:
            r = subprocess.run(cmd, input=input, capture_output=True, text=True, timeout=timeout)
            return r.returncode, r.stdout, r.stderr
        except FileNotFoundError:
            return 127, '', cmd[0] + ': not found'
        except subprocess.TimeoutExpired:
            return 124, '', cmd[0] + ': timed out'

    def stream(self, cmd, input=None, on_line=None):
        """Like run, but hands each output line to on_line as it comes (live progress)."""
        try:
            p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1)
        except FileNotFoundError:
            return 127, '', cmd[0] + ': not found'
        if input is not None:
            p.stdin.write(input)
        p.stdin.close()
        out = []
        for line in p.stdout:
            out.append(line)
            if on_line:
                on_line(line.rstrip('\n'))
        err = p.stderr.read()
        return p.wait(), ''.join(out), err


RUNNER = Runner()


def read(path, default=''):
    try:
        with open(path, errors='replace') as f:
            return f.read().strip()
    except OSError:
        return default


def read_bytes(path):
    try:
        with open(path, 'rb') as f:
            return f.read()
    except OSError:
        return b''


# ---------------------------------------------------------------------------------------------- scanning
def edid_monitor_name(edid):
    """The monitor's name from its EDID (descriptor 0xFC), or ''."""
    if len(edid) < 128:
        return ''
    for off in (54, 72, 90, 108):
        d = edid[off:off + 18]
        if d[0:3] == b'\0\0\0' and d[3] == 0xFC:
            return d[5:18].split(b'\n')[0].decode('ascii', 'replace').strip()
    return ''


def pci_address(path):
    """The PCI address (0000:03:00.0) of the nearest PCI device in a sysfs path, or ''."""
    found = re.findall(r'/([0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7])(?=/|$)', path)
    return found[-1] if found else ''


def scan_gpus():
    gpus = []
    for card in sorted(glob.glob(os.path.join(SYS, 'class/drm/card[0-9]*')), key=lambda p: int(re.sub(r'\D', '', os.path.basename(p)) or 0)):
        name = os.path.basename(card)
        if not re.fullmatch(r'card\d+', name):
            continue
        dev = os.path.realpath(os.path.join(card, 'device'))
        pci = pci_address(dev)
        vendor = read(os.path.join(card, 'device/vendor')).replace('0x', '')
        device = read(os.path.join(card, 'device/device')).replace('0x', '')
        driver = os.path.basename(os.path.realpath(os.path.join(card, 'device/driver'))) if os.path.exists(os.path.join(card, 'device/driver')) else ''
        outputs = []
        for conn in sorted(glob.glob(os.path.join(SYS, 'class/drm', name + '-*'))):
            cid = os.path.basename(conn)
            connector = cid[len(name) + 1:]
            if connector.startswith('Writeback'):
                continue
            modes = read(os.path.join(conn, 'modes')).splitlines()
            outputs.append({
                'id': cid, 'connector': connector,
                'connected': read(os.path.join(conn, 'status')) == 'connected',
                'enabled': read(os.path.join(conn, 'enabled')) == 'enabled',
                'mode': modes[0].strip() if modes else None,
                'monitor': edid_monitor_name(read_bytes(os.path.join(conn, 'edid'))) or None,
                'internal': bool(re.match(r'(eDP|LVDS|DSI)', connector)),
            })
        gpus.append({
            'id': pci or name, 'card': name, 'pci': pci or None, 'vendor': vendor, 'device': device,
            'vk_device': '%s:%s' % (vendor, device) if vendor and device else None,
            'driver': driver, 'boot_vga': read(os.path.join(card, 'device/boot_vga')) == '1',
            'outputs': outputs,
        })
    return gpus


def has_bits(hexwords, *bits):
    """Linux capability bitmaps: space-separated hex words, most significant first."""
    words = [int(w, 16) for w in hexwords.split()] if hexwords.strip() else []
    words.reverse()
    out = []
    for bit in bits:
        i, b = divmod(bit, 64)
        out.append(i < len(words) and bool(words[i] >> b & 1))
    return out


def usb_port(path):
    """The USB port path (1-2 or 1-2.3) a device hangs off, or None."""
    ports = re.findall(r'/(\d+-\d+(?:\.\d+)*)(?=/|$)', path)
    return ports[-1] if ports else None


def pad_id(uniq, port, phys, bus):
    """How a controller is recognised again after it reconnects. Plugged in: by its USB port (whatever is
    plugged into that port, or a hub on it, belongs to the player; drivers like hid-playstation give the input
    device and the hidraw node different serials over USB). Wireless: by its serial/MAC address."""
    if port and bus == 'usb':
        return 'usb:' + port
    if uniq and re.fullmatch(r'[A-Za-z0-9:._-]{4,64}', uniq):
        return 'uniq:' + uniq
    return None   # can't be told apart after it reconnects; not assignable


def scan_pads(config=None):
    """Game controllers (not virtual ones made by Steam or InputPlumber), one entry per physical controller."""
    pads = {}
    assigned = {}
    for s in (config or {}).get('seats', []):
        for p in s.get('pads', []):
            assigned[p] = s.get('seat')
    for ev in sorted(glob.glob(os.path.join(SYS, 'class/input/event[0-9]*'))):
        inp = os.path.realpath(os.path.join(ev, 'device'))
        if '/devices/virtual/' in inp:
            continue
        joy, pad = has_bits(read(os.path.join(inp, 'capabilities/key')), BTN_JOYSTICK, BTN_GAMEPAD)
        if not (joy or pad):
            continue
        bustype = read(os.path.join(inp, 'id/bustype'))
        bus = {'0003': 'usb', '0005': 'bluetooth'}.get(bustype, 'other')
        uniq = read(os.path.join(inp, 'uniq'))
        port = usb_port(inp)
        pid = pad_id(uniq, port, read(os.path.join(inp, 'phys')), bus)
        key = pid or ('event:' + os.path.basename(ev))
        entry = pads.setdefault(key, {
            'id': pid, 'name': read(os.path.join(inp, 'name')) or 'Controller', 'bus': bus,
            'usb_port': port if bus == 'usb' else None, 'uniq': uniq or None,
            'vendor': read(os.path.join(inp, 'id/vendor')), 'product': read(os.path.join(inp, 'id/product')),
            'events': [], 'hidraw': [], 'seat': assigned.get(pid, 1) if pid else 1,
            'assignable': bool(pid),
        })
        entry['events'].append(os.path.join(DEV, 'input', os.path.basename(ev)))
        # The same controller's hidraw node (Steam reads controllers through it): a sibling under the HID device.
        hid = os.path.dirname(os.path.dirname(inp)) if os.path.basename(os.path.dirname(inp)) == 'input' else ''
        for h in sorted(glob.glob(os.path.join(hid, 'hidraw', 'hidraw[0-9]*'))) if hid else []:
            node = os.path.join(DEV, os.path.basename(h))
            if node not in entry['hidraw']:
                entry['hidraw'].append(node)
    return list(pads.values())


def scan_audio(gpus):
    by_slot = {g['pci'].rsplit('.', 1)[0]: g['id'] for g in gpus if g.get('pci')}
    cards = []
    for c in sorted(glob.glob(os.path.join(SYS, 'class/sound/card[0-9]*'))):
        dev = os.path.realpath(os.path.join(c, 'device'))
        pci = pci_address(dev)
        cards.append({'card': os.path.basename(c), 'id': read(os.path.join(c, 'id')), 'pci': pci or None,
                      'gpu': by_slot.get(pci.rsplit('.', 1)[0]) if pci else None})
    return cards


def passwd_entries():
    out = []
    for line in read(PASSWD).splitlines():
        f = line.split(':')
        if len(f) >= 7 and f[2].isdigit():
            out.append({'name': f[0], 'uid': int(f[2]), 'gid': int(f[3]), 'home': f[5], 'shell': f[6]})
    return out


def group_members(name):
    for line in read(GROUP).splitlines():
        f = line.split(':')
        if len(f) >= 4 and f[0] == name:
            return [m for m in f[3].split(',') if m]
    return []


def main_user():
    """Whoever runs this (the Hearth app runs as the main user)."""
    try:
        pw = pwd.getpwuid(os.getuid())
        return {'name': pw.pw_name, 'uid': pw.pw_uid}
    except KeyError:
        return {'name': str(os.getuid()), 'uid': os.getuid()}


def scan_users():
    me = main_user()
    players = [{'name': e['name'], 'uid': e['uid'], 'home': e['home']} for e in passwd_entries() if PLAYER_RE.fullmatch(e['name'])]
    return {'main': me, 'players': players, 'main_in_input_group': me['name'] in group_members('input')}


def logind_seats():
    rc, out, _ = RUNNER.run(['loginctl', 'list-seats', '--no-legend'], timeout=10)
    if rc != 0:
        return []
    return [line.split()[0] for line in out.splitlines() if line.strip()]


def load_config():
    try:
        with open(CONFIG) as f:
            c = json.load(f)
        return c if isinstance(c, dict) else None
    except (OSError, ValueError):
        return None


def scan():
    config = load_config()
    gpus = scan_gpus()
    users = scan_users()
    warnings = []
    if users['main_in_input_group']:
        warnings.append('Your account is in the "input" group, so your games could still see the other players\' '
                        'controllers. Multi-seat works best without it.')
    return {'gpus': gpus, 'pads': scan_pads(config), 'audio': scan_audio(gpus), 'logind_seats': logind_seats(),
            'users': users, 'config': public_config(config), 'warnings': warnings}


def public_config(config):
    if not config:
        return None
    return {k: config.get(k) for k in ('version', 'mode', 'enabled', 'main_user', 'seats', 'split', 'created_users')}


def seat_kind(config, s):
    """gpu, nested, split, stream, or local (player 1 when every other player is streamed). Set-ups from before
    per-seat modes have one "mode" for everyone."""
    k = s.get('mode') or (config or {}).get('mode')
    if s.get('seat') == 1 and k == 'stream':
        return 'local'
    return k


def config_has(config, *kinds):
    return any(seat_kind(config, s) in kinds for s in (config or {}).get('seats', []) if s.get('seat') != 1)


def hosted(config):
    """Does player 1's Game Mode host other players' windows (another screen, or part of player 1's)?"""
    return config_has(config, *HOST_KINDS)


# ---------------------------------------------------------------------------------------------- planning
def connected_outputs(gpu):
    return [o for o in gpu['outputs'] if o['connected']]


def have(cmd):
    return any(os.access(os.path.join(d, cmd), os.X_OK) for d in os.environ.get('PATH', '/usr/bin:/bin').split(':') if d)


def stream_support():
    """(possible, reason). Streaming a player needs Sunshine (installed in the system, not the Flatpak), labwc
    for the virtual screen, wlr-randr to size it, and a graphics card with a render node."""
    missing = [c for c in ('sunshine', 'labwc', 'wlr-randr') if not have(c)]
    if 'sunshine' in missing:
        return False, 'Streaming a player needs Sunshine, which isn\'t in this edition of Hearth OS yet.'
    if missing:
        return False, 'Streaming a player needs %s.' % ' and '.join(missing)
    if not glob.glob(os.path.join(SYS, 'class/drm', 'renderD[0-9]*')):
        return False, 'Streaming a player needs a graphics card Hearth can use for video.'
    return True, None


def remote_play_port():
    """The port family of player 1's own Sunshine (Settings › Remote play), if it was changed from the default."""
    m = re.search(r'^\s*port\s*=\s*(\d{4,5})\s*$', read(os.path.expanduser('~/.config/sunshine/sunshine.conf')), re.M)
    return int(m.group(1)) if m else STREAM_PORT_FIRST


def stream_port(n):
    """Player n's Sunshine port family (48989, 49989, 50989; each uses its port -5 to +21), as hearth-admin sets."""
    return STREAM_PORT_FIRST + 1000 * (n - 1)


def split_rects(w, h, layout):
    """Each region of a split screen as {x, y, w, h} (even sizes), in region order; the same as hearth-admin's."""
    def ev(v):
        return max(2, int(v) // 2 * 2)
    if layout == 'columns':
        cw = ev(w / 2)
        r = [(0, 0, cw, ev(h)), (cw, 0, cw, ev(h))]
    elif layout == 'rows':
        ch = ev(h / 2)
        r = [(0, 0, ev(w), ch), (0, ch, ev(w), ch)]
    else:
        cw, ch = ev(w / 2), ev(h / 2)
        r = [(0, 0, cw, ch), (cw, 0, cw, ch), (0, ch, cw, ch), (cw, ch, cw, ch)]
    return [{'x': x, 'y': y, 'w': rw, 'h': rh} for x, y, rw, rh in r]


def default_split_layout(size, players=2):
    """Side by side on a wide screen, one above the other on a squarer one, four corners for 3-4 players."""
    m = re.fullmatch(r'(\d+)x(\d+)', size or '')
    if players > 2:
        return 'grid'
    if m and int(m.group(1)) / float(int(m.group(2))) < 1.6 - 1e-9:
        return 'rows'
    return 'columns'


def plan_from(info):
    gpus, pads = info['gpus'], info['pads']
    reasons, warnings = [], list(info.get('warnings', []))
    lit = [g for g in gpus if connected_outputs(g)]
    total_outputs = sum(len(connected_outputs(g)) for g in gpus)
    gpu_ok = len(lit) >= 2
    if gpu_ok:
        ids = [g['vk_device'] for g in lit]
        if len(set(ids)) < len(ids):
            gpu_ok = False
            reasons.append('Two of the graphics cards are the same model, and Game Mode can\'t tell them apart yet.')
        else:
            reasons.append('Each player can have a graphics card of their own (the fastest and most reliable kind).')
    nested_ok = total_outputs >= 2
    if nested_ok:
        reasons.append('There are %d screens connected, so they can be shared out between players.' % total_outputs)
    split_ok = total_outputs >= 1
    if split_ok:
        reasons.append('A TV or monitor can also be split into 2 to 4 parts, a Game Mode in each (Beta Experimental).')
    stream_ok, why = stream_support()
    reasons.append('Players can also play on another device (a TV with Moonlight, a phone, a tablet, a laptop), '
                   'streamed from this PC (Beta Experimental).' if stream_ok else why)
    if stream_ok:
        p = remote_play_port()
        if p != STREAM_PORT_FIRST and any(abs(p - stream_port(n)) <= 30 for n in (2, 3, 4)):
            warnings.append('Remote play was moved to ports the streamed players use (%d). Set it back to its usual '
                            'port in Sunshine\'s settings.' % p)
    if not gpu_ok and not nested_ok and not split_ok:
        reasons.append('Connect a TV or monitor to use multi-seat.')
    mode = 'gpu' if gpu_ok else 'nested' if nested_ok else 'split' if split_ok else 'stream' if stream_ok else None
    layout = None
    if mode:
        layout = propose_layout(mode, gpus, pads, info['users']['main']['name'])
        assignable = [p for p in pads if p.get('assignable')]
        local = [s for s in layout['seats'] if s.get('mode') != 'stream']
        if len(assignable) < len(local):
            warnings.append('Connect a controller for each player. Controllers can be moved between players at any time.')
    if any(p for p in pads if not p.get('assignable')):
        warnings.append('Some controllers have no serial number and aren\'t plugged in by USB, so they always stay with player 1.')
    outputs = [{'id': o['id'], 'connector': o['connector'], 'mode': o['mode'], 'monitor': o['monitor'], 'gpu': g['id']}
               for g in gpus for o in connected_outputs(g)]
    return {'possible': {'gpu': gpu_ok, 'nested': nested_ok, 'split': split_ok, 'stream': stream_ok},
            'recommended': mode, 'reasons': reasons, 'warnings': warnings, 'layout': layout, 'outputs': outputs,
            'presets': {'stream_sizes': list(STREAM_SIZES), 'stream_fps': list(STREAM_FPS),
                        'split_layouts': dict(SPLIT_LAYOUTS)},
            'performance': 'Every extra player shares this PC\'s graphics card and processor (and its power limit), so '
                           'games can run slower for everyone. Each streamed player also needs the graphics card to '
                           'make their video.'}


def propose_layout(mode, gpus, pads, main):
    def rank(g):   # player 1 keeps the screen the PC starts on
        return (not g['boot_vga'], g['card'])
    ordered = sorted(gpus, key=rank)
    if mode == 'gpu':
        picks = [(g, connected_outputs(g)[0]) for g in ordered if connected_outputs(g)][:MAX_SEATS]
    else:
        picks = []
        for g in ordered:
            outs = sorted(connected_outputs(g), key=lambda o: (not o['internal'], o['id']))
            picks += [(g, o) for o in outs]
        picks = picks[:MAX_SEATS]
    seats = []
    split = None
    if mode == 'split' and picks:
        g, o = picks[0]
        split = {'layout': default_split_layout(o.get('mode'))}
        for n in (1, 2):
            seats.append({'seat': n, 'user': main if n == 1 else 'hearth-p%d' % n, 'mode': 'split', 'gpu': g['id'],
                          'output': o['id'], 'region': n - 1, 'pads': [], 'audio': None})
    elif mode == 'stream':
        seats = [{'seat': 1, 'user': main, 'mode': 'local', 'gpu': picks[0][0]['id'] if picks else None,
                  'output': picks[0][1]['id'] if picks else None, 'pads': [], 'audio': None},
                 {'seat': 2, 'user': 'hearth-p2', 'mode': 'stream', 'gpu': None, 'output': None, 'pads': [],
                  'audio': None, 'stream': {'size': '1920x1080', 'fps': 60}}]
    else:
        for n, (g, o) in enumerate(picks, start=1):
            seats.append({'seat': n, 'user': main if n == 1 else 'hearth-p%d' % n, 'mode': mode, 'gpu': g['id'],
                          'output': o['id'], 'pads': [], 'audio': None})
    # Player 1 keeps the first controller; the next ones go one each to the other players (not to streamed ones:
    # their controllers come from their own device).
    assignable = [p for p in pads if p.get('assignable')]
    local = [s for s in seats if s['mode'] != 'stream']
    for i, p in enumerate(assignable[:len(local)]):
        local[i]['pads'].append(p['id'])
    out = {'mode': mode, 'seats': seats}
    if split:
        out['split'] = split
    return out


# ---------------------------------------------------------------------------------------------- root side
def admin(args, payload=None, timeout=600):
    """hearth-admin seats-*: through pkexec (or directly when already root). Progress lines are passed on."""
    cmd = ([ADMIN] if os.geteuid() == 0 else ['pkexec', ADMIN]) + args
    data = json.dumps(payload) if payload is not None else None

    def live(line):
        if line.startswith('progress: ') or line.startswith('log: '):
            print(line, flush=True)
    if hasattr(RUNNER, 'stream'):
        rc, out, err = RUNNER.stream(cmd, input=data, on_line=live)
    else:
        rc, out, err = RUNNER.run(cmd, input=data, timeout=timeout)
        for line in out.splitlines():
            live(line)
    result = None
    for line in out.splitlines():
        if line.startswith('error: '):
            raise Fail(line[7:])
        elif line.startswith('{'):
            try:
                result = json.loads(line)
            except ValueError:
                pass
    if rc != 0:
        if rc in (126, 127) and not out:
            raise Fail('Hearth couldn\'t get permission to change the system (pkexec was cancelled or is missing).')
        raise Fail((err.strip().splitlines() or ['hearth-admin failed'])[-1])
    return result or {}


def normalize_layout(layout):
    """The UI's layout, made consistent before it goes to hearth-admin: every seat says how it plays (older
    layouts have one "mode"), player 1 matches the others, streamed players have no screen or controllers, and
    the top-level mode sums it up."""
    if not isinstance(layout, dict) or not isinstance(layout.get('seats'), list):
        return layout
    top = layout.get('mode')
    seats = []
    for s in layout['seats']:
        if not isinstance(s, dict):
            return layout
        s = dict(s)
        if not s.get('mode') and top:
            s['mode'] = top
        seats.append(s)
    extra = {s.get('mode') for s in seats if s.get('seat') != 1}
    local = extra - {'stream'}
    for s in seats:
        if s.get('seat') == 1:
            if 'gpu' in local:
                s['mode'] = 'gpu'
            elif 'split' in local:
                s['mode'] = 'split'
            elif local:
                s['mode'] = 'nested'
            else:
                s['mode'] = 'local'
        if s.get('mode') == 'stream':
            s['output'] = None
            s['pads'] = []
            s.pop('region', None)
        elif s.get('mode') != 'split':
            s.pop('region', None)
    out = dict(layout, seats=seats)
    out['mode'] = 'gpu' if 'gpu' in local else 'split' if 'split' in local else 'nested' if local else 'stream'
    if out['mode'] != 'split' and not any(s.get('mode') == 'split' for s in seats):
        out.pop('split', None)
    return out


def setup(seats_json, start=False):
    try:
        layout = json.loads(seats_json)
    except ValueError:
        raise Fail('--seats must be JSON like plan\'s "layout"')
    progress(2, 'Checking the layout')
    layout = normalize_layout(layout)
    info = scan()
    check_layout(layout, info)
    payload = dict(layout, start=bool(start))
    result = admin(['seats-setup'], payload)
    return dict(result, restart_game_mode=hosted(layout) and bool(start))


def check_layout(layout, info):
    """Friendly checks before asking for root (hearth-admin checks everything again, strictly)."""
    if not isinstance(layout, dict) or layout.get('mode') not in ('gpu', 'nested', 'split', 'stream'):
        raise Fail('the layout needs a mode: "gpu" (a graphics card per player), "nested" (one card, several screens), '
                   '"split" (parts of one screen) or "stream" (streamed to other devices)')
    seats = layout.get('seats')
    if not isinstance(seats, list) or not 2 <= len(seats) <= MAX_SEATS:
        raise Fail('choose 2 to %d players' % MAX_SEATS)
    outputs = {o['id']: (g, o) for g in info['gpus'] for o in g['outputs']}
    for s in seats:
        kind = seat_kind(layout, s)
        if kind == 'stream':
            ok, why = stream_support()
            if not ok:
                raise Fail(why)
            st = s.get('stream') or {}
            if st.get('size', '1920x1080') not in STREAM_SIZES or st.get('fps', 60) not in STREAM_FPS:
                raise Fail('choose one of the picture sizes and frame rates for player %s' % s.get('seat'))
            continue
        if kind == 'local' and not s.get('output'):
            continue
        o = outputs.get(s.get('output'))
        if not o:
            raise Fail('screen %s isn\'t there any more' % s.get('output'))
        if not o[1]['connected']:
            raise Fail('the screen for player %s (%s) isn\'t connected or is turned off' % (s.get('seat'), o[1]['connector']))
    split = [s for s in seats if seat_kind(layout, s) == 'split']
    if split:
        lay = (layout.get('split') or {}).get('layout')
        if lay not in SPLIT_LAYOUTS:
            raise Fail('choose how to split the screen: side by side, one above the other, or four corners')
        if len(split) > SPLIT_LAYOUTS[lay]:
            raise Fail('that screen layout has room for %d players' % SPLIT_LAYOUTS[lay])
        if len({s.get('region') for s in split}) != len(split):
            raise Fail('each player on the split screen needs their own part of it')
    if seats[0].get('user') != info['users']['main']['name']:
        raise Fail('player 1 must be you (%s)' % info['users']['main']['name'])


