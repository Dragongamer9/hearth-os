def host_paused():
    return host_state().get('failures', 0) >= 2


def reset_host_failures():
    save_host_state({'failures': 0})


def host_seats(c, info_gpus=None):
    """The players whose window player 1's Game Mode hosts (another screen, or a part of player 1's) and whose
    screen is connected right now, player 1 first. Fewer than two: no host."""
    gpus = info_gpus if info_gpus is not None else scan_gpus()
    connected = {o['id']: o for g in gpus for o in g['outputs'] if o['connected']}
    return [dict(s, kind=seat_kind(c, s), connector=connected[s['output']]['connector'],
                 screen=connected[s['output']]['mode'], monitor=connected[s['output']]['monitor'])
            for s in c.get('seats', []) if s.get('output') in connected and seat_kind(c, s) in HOST_KINDS]


def host_check():
    c = load_config()
    if not c or not c.get('enabled') or not hosted(c):
        return False
    if c.get('main_user') != main_user()['name'] or os.environ.get('HEARTH_SEAT'):
        return False
    if host_paused():
        return False
    seats = host_seats(c)
    return len(seats) >= 2 and seats[0]['seat'] == 1


def xml_escape(s):
    return str(s).replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;').replace('"', '&quot;')


def split_region(layout, region):
    """A split player's part of the screen in % (x, y, w, h), or None."""
    regions = SPLIT_REGIONS.get(layout) or []
    return regions[region] if isinstance(region, int) and 0 <= region < len(regions) else None


def host_rc_xml(seats, layout=None):
    """labwc settings for the host: no decorations, no desktop keys, each player's window on their screen.
    Each player's window connects through its own socket marked with security-context-v1 (engine
    "hearth-seat", app id "seatN"), which is what the window rules match on. A player on a split screen gets
    their part of it: a labwc region in % of that screen (so it fits whatever the screen's position), which the
    window snaps to once it's on that screen.

    Not every labwc matches those sandbox rules (seen on the ROG Ally: each player got a title bar and wasn't
    fitted to their part), so two things work without them too: a rule for every window takes the title bars off
    (the host only ever shows players' windows), and automatic placement puts each window, already the size of its
    part, in the free part of the screen (player 1's opens first, so it takes the first part)."""
    rules, regions = ['    <windowRule identifier="*" serverDecoration="no" skipTaskbar="yes" />'], []
    for s in seats:
        acts = ['      <action name="MoveToOutput" output="%s" />' % xml_escape(s['connector'])]
        r = split_region(layout, s.get('region')) if s.get('kind') == 'split' else None
        if r:
            name = 'hearth-seat%d' % s['seat']
            regions.append('    <region name="%s" x="%d%%" y="%d%%" width="%d%%" height="%d%%" />' % ((name,) + tuple(r)))
            acts.append('      <action name="SnapToRegion" region="%s" />' % name)
        if s['seat'] == 1 or not r:
            acts.append('      <action name="Focus" />')
        rules.append('    <windowRule sandboxEngine="hearth-seat" sandboxAppId="seat%d" serverDecoration="no" skipTaskbar="yes">\n'
                     '%s\n    </windowRule>' % (s['seat'], '\n'.join(acts)))
    return ('<?xml version="1.0"?>\n<!-- Hearth multi-seat host, written by hearth-seats; changes are overwritten. -->\n'
            '<labwc_config>\n  <core><decoration>client</decoration><gap>0</gap></core>\n'
            '  <keyboard><default /></keyboard>\n  <mouse><default /></mouse>\n'
            '  <focus><followMouse>no</followMouse></focus>\n'
            '  <placement><policy>automatic</policy></placement>\n'
            + ('  <regions>\n' + '\n'.join(regions) + '\n  </regions>\n' if regions else '') +
            '  <windowRules>\n' + '\n'.join(rules) + '\n  </windowRules>\n</labwc_config>\n')


def player1_cmd(cmd, seat1):
    """Player 1's gamescope command for the host. On a split screen player 1 is a window the size of their part
    (not fullscreen): '-f' goes, and -W/-H/-w/-h for the part go last among gamescope's options (they win over
    any from session.conf)."""
    if not cmd or seat1.get('kind') != 'split':
        return cmd
    m = re.fullmatch(r'(\d{2,5})x(\d{2,5})', seat1.get('size') or '')
    end = cmd.index('--') if '--' in cmd else len(cmd)
    opts = [a for a in cmd[1:end] if a not in ('-f', '--fullscreen')]
    size = ['-W', m.group(1), '-H', m.group(2), '-w', m.group(1), '-h', m.group(2)] if m else []
    return cmd[:1] + opts + size + cmd[end:]


def host(cmd):
    """Player 1's Game Mode when the screens are shared out: labwc drives every screen (gamescope can only drive
    one); player 1's gamescope and each other player's gamescope run in it as windows: fullscreen, one per
    screen, or one per part of a split screen. Returns player 1's Game Mode's exit code, or EXIT_HOST_FALLBACK
    if the host couldn't start."""
    c = load_config()
    seats = host_seats(c) if c else []
    if len(seats) < 2 or not cmd:
        return EXIT_HOST_FALLBACK
    run = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
    d = os.path.join(run, 'hearth-seat-host')
    write_labwc_dir(d, host_rc_xml(seats, (c.get('split') or {}).get('layout')),
                    ['python3', os.path.realpath(__file__), 'host-run', '--'] + player1_cmd(cmd, seats[0]))
    st = host_state()
    started = time.time()
    # The host's own log (labwc's warnings, e.g. window rules it doesn't understand), for bug reports.
    log_path = HOST_LOG
    try:
        os.makedirs(os.path.dirname(log_path), exist_ok=True)
        log = open(log_path, 'w')
        _, ver, _ = RUNNER.run(['labwc', '--version'], timeout=10)
        log.write('%s hearth-seats host: %s; %d players: %s\n' % (time.strftime('%Y-%m-%d %H:%M:%S'), (ver or '?').strip(), len(seats),
                  ', '.join('%d %s on %s%s' % (x['seat'], x.get('kind'), x.get('connector'), ' part %s' % x.get('region') if x.get('kind') == 'split' else '') for x in seats)))
        log.flush()
    except OSError:
        log = None
    rc = subprocess.call(['labwc', '-C', d], stdout=log or subprocess.DEVNULL, stderr=log or subprocess.DEVNULL)
    if log:
        log.close()
    result_file = os.path.join(d, 'result')
    inner = read(result_file)
    try:
        os.remove(result_file)
    except OSError:
        pass
    ok_end = inner.isdigit()
    # A host that falls over straight away twice in a row is paused (back to normal Game Mode) until
    # multi-seat is started again, so a broken set-up can never stop player 1 from playing.
    if not ok_end and time.time() - started < 30:
        st['failures'] = st.get('failures', 0) + 1
        save_host_state(st)
        return EXIT_HOST_FALLBACK
    save_host_state({'failures': 0})
    return int(inner) if ok_end else rc


# ---- a minimal Wayland client: just enough to make security-context-v1 listeners (no libraries needed)
class Wayland:
    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.next_id = 2
        self.buf = b''
        self.globals = {}
        self.registry = None

    def new_id(self):
        i = self.next_id
        self.next_id += 1
        return i

    @staticmethod
    def u32(v):
        return struct.pack('<I', v)

    @staticmethod
    def string(s):
        b = s.encode() + b'\0'
        return struct.pack('<I', len(b)) + b + b'\0' * (-len(b) % 4)

    def send(self, obj, opcode, args=b'', fds=()):
        msg = struct.pack('<II', obj, ((8 + len(args)) << 16) | opcode) + args
        if fds:
            self.sock.sendmsg([msg], [(socket.SOL_SOCKET, socket.SCM_RIGHTS, array.array('i', fds))])
        else:
            self.sock.sendall(msg)

    def read_event(self):
        while True:
            if len(self.buf) >= 8:
                obj, word = struct.unpack('<II', self.buf[:8])
                size, opcode = word >> 16, word & 0xffff
                if size < 8:
                    raise Fail('bad message from the compositor')
                if len(self.buf) >= size:
                    payload, self.buf = self.buf[8:size], self.buf[size:]
                    return obj, opcode, payload
            data, anc, _, _ = self.sock.recvmsg(65536, socket.CMSG_SPACE(16 * 4))
            for level, kind, fdata in anc:   # no events we read carry fds, but never leak any
                if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
                    for fd in array.array('i', fdata[:len(fdata) - len(fdata) % 4]):
                        os.close(fd)
            if not data:
                raise Fail('the compositor closed the connection')
            self.buf += data

    @staticmethod
    def parse_string(payload, off):
        n = struct.unpack_from('<I', payload, off)[0]
        s = payload[off + 4:off + 4 + n - 1].decode(errors='replace')
        return s, off + 4 + n + (-n % 4)

    def roundtrip(self):
        cb = self.new_id()
        self.send(1, 0, self.u32(cb))                     # wl_display.sync
        while True:
            obj, op, payload = self.read_event()
            if obj == 1 and op == 0:                      # wl_display.error
                _, code = struct.unpack_from('<II', payload)
                msg, _ = self.parse_string(payload, 8)
                raise Fail('the compositor refused (%d): %s' % (code, msg))
            if obj == self.registry and op == 0:          # wl_registry.global
                name = struct.unpack_from('<I', payload)[0]
                iface, off = self.parse_string(payload, 4)
                self.globals[iface] = (name, struct.unpack_from('<I', payload, off)[0])
            if obj == cb and op == 0:                     # wl_callback.done
                return

    def start(self):
        self.registry = self.new_id()
        self.send(1, 1, self.u32(self.registry))          # wl_display.get_registry
        self.roundtrip()

    def bind(self, iface, version):
        if iface not in self.globals:
            raise Fail('the compositor doesn\'t offer ' + iface)
        name, have = self.globals[iface]
        oid = self.new_id()
        self.send(self.registry, 0, self.u32(name) + self.string(iface) + self.u32(min(version, have)) + self.u32(oid))
        return oid

    def security_context(self, manager, listen_fd, close_fd, engine, app_id, instance):
        ctx = self.new_id()
        self.send(manager, 1, self.u32(ctx), fds=(listen_fd, close_fd))   # create_listener(new_id, fd, fd)
        self.send(ctx, 1, self.string(engine))            # set_sandbox_engine
        self.send(ctx, 2, self.string(app_id))            # set_app_id
        self.send(ctx, 3, self.string(instance))          # set_instance_id
        self.send(ctx, 4)                                 # commit
        return ctx


def listen_socket(path, mode=0o660):
    try:
        os.unlink(path)
    except FileNotFoundError:
        pass
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.bind(path)
    os.chmod(path, mode)
    s.listen(16)
    return s


def open_seat_sockets(wl, seats, me):
    """One security-context listener per player. Returns [(path, socket, close_write_fd)]."""
    manager = wl.bind('wp_security_context_manager_v1', 1)
    opened = []
    run = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
    for s in seats:
        if s['seat'] == 1:
            path = os.path.join(run, 'hearth-seat1-wayland')
        else:
            path = os.path.join(SEAT_RUN, s['user'], 'wayland-0')
        ls = listen_socket(path)
        r, w = os.pipe()
        wl.security_context(manager, ls.fileno(), r, 'hearth-seat', 'seat%d' % s['seat'], s['user'])
        os.close(r)
        opened.append((path, ls, w, s))
    wl.roundtrip()   # any refusal shows up here
    return opened


def pactl_json(args):
    rc, out, _ = RUNNER.run(['pactl', '-f', 'json'] + args, timeout=10)
    try:
        return json.loads(out) if rc == 0 else []
    except ValueError:
        return []


def pick_sink(sinks, seat):
    """The sound output on this player's screen: the configured one, else the HDMI/DP output whose port names
    the screen's monitor (PipeWire adds the monitor's name from the ELD), else none."""
    if seat.get('audio'):
        return seat['audio']
    mon = (seat.get('monitor') or '').lower()
    if not mon:
        return None
    for s in sinks:
        texts = [s.get('description') or ''] + [p.get('description') or '' for p in s.get('ports', [])]
        if any(mon in t.lower() for t in texts):
            return s.get('name')
    return None


SINK_NAME_RE = re.compile(r'^[A-Za-z0-9._:+-]{1,200}$')


def audio_prefs():
    """Split screen sound (player 1's own setting): each player's volume, and whether only player 1's sound plays."""
    try:
        with open(AUDIO_PREFS) as f:
            p = json.load(f)
    except (OSError, ValueError):
        p = {}
    vols = p.get('volumes') if isinstance(p, dict) and isinstance(p.get('volumes'), dict) else {}
    clean = {}
    for k, v in vols.items():
        if k in ('1', '2', '3', '4') and isinstance(v, int) and not isinstance(v, bool) and 0 <= v <= 100:
            clean[k] = v
    return {'volumes': clean, 'only_p1': bool(isinstance(p, dict) and p.get('only_p1') is True)}


def save_audio_prefs(p):
    try:
        os.makedirs(os.path.dirname(AUDIO_PREFS), exist_ok=True)
        with open(AUDIO_PREFS + '.tmp', 'w') as f:
            json.dump(p, f)
        os.replace(AUDIO_PREFS + '.tmp', AUDIO_PREFS)
    except OSError:
        pass


def split_sink(seat):
    return 'hearth-seat%d' % seat


def apply_seat_volume(seat, prefs):
    """A split player's own sound output: their volume, muted when only player 1's sound plays."""
    sink = split_sink(seat)
    RUNNER.run(['pactl', 'set-sink-volume', sink, '%d%%' % prefs['volumes'].get(str(seat), 100)], timeout=10)
    RUNNER.run(['pactl', 'set-sink-mute', sink, '1' if prefs['only_p1'] and seat != 1 else '0'], timeout=10)


def audio_cmd(seat=None, volume=None, only_p1=None):
    """hearth-seats audio: change and apply (right away when the host runs) the split screen's sound."""
    c = load_config()
    if not c or not config_has(c, 'split'):
        raise Fail('this is for a split screen')
    prefs = audio_prefs()
    split = [s['seat'] for s in c['seats'] if seat_kind(c, s) == 'split']
    if seat is not None:
        if seat not in split:
            raise Fail('player %d isn\'t on the split screen' % seat)
        if volume is None or not 0 <= volume <= 100:
            raise Fail('the volume is 0 to 100')
        prefs['volumes'][str(seat)] = volume
    if only_p1 is not None:
        prefs['only_p1'] = only_p1
    save_audio_prefs(prefs)
    if os.path.exists(os.path.join(SEAT_RUN, 'host.pid')):
        for n in split:
            apply_seat_volume(n, prefs)
    return dict(prefs, ok=True)


def host_modules_file():
    return os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'hearth-seat-host', 'audio-modules.json')


def split_audio(seats, sinks):
    """Split screen: every player plays through the same speakers (the screen's), each through a sound output of
    their own (a PipeWire remap sink on player 1's server) so each has their own volume, or is muted when only
    player 1's sound plays. Returns {seat: sink}."""
    split = [s for s in seats if s.get('kind') == 'split']
    if not split:
        return {}
    master = pick_sink(sinks, split[0])
    if not master:
        rc, out, _ = RUNNER.run(['pactl', 'get-default-sink'], timeout=10)
        master = out.strip() if rc == 0 else None
    if not master or not SINK_NAME_RE.fullmatch(master) or master.startswith('hearth-seat'):
        return {}
    prefs = audio_prefs()
    modules, out_sinks = [], {}
    for s in split:
        name = split_sink(s['seat'])
        rc, out, _ = RUNNER.run(['pactl', 'load-module', 'module-remap-sink', 'sink_name=%s' % name, 'master=%s' % master,
                                 'sink_properties=device.description=Hearth-Player-%d' % s['seat']], timeout=10)
        if rc == 0 and out.strip().isdigit():
            modules.append(out.strip())
            out_sinks[s['seat']] = name
            apply_seat_volume(s['seat'], prefs)
    try:
        with open(host_modules_file(), 'w') as f:
            json.dump({'modules': modules, 'master': master}, f)
    except OSError:
        pass
    return out_sinks


def host_audio(seats, me_uid):
    """Players 2-4 play sound through player 1's sound server (there's one sound card for the screens; two
    servers fighting over it would break both), each on their own screen's output (or, on a split screen, their
    own volume on the shared one). Grants them its sockets."""
    run = os.environ.get('XDG_RUNTIME_DIR') or '/run/user/%d' % me_uid
    sinks = pactl_json(['list', 'sinks'])
    own = split_audio(seats, sinks)
    for s in seats:
        sink = own.get(s['seat']) or pick_sink(sinks, s)
        if s['seat'] == 1:
            if sink:
                RUNNER.run(['pactl', 'set-default-sink', sink], timeout=10)
            continue
        u = s['user']
        RUNNER.run(['setfacl', '-m', 'u:%s:x' % u, run, os.path.join(run, 'pulse')], timeout=10)
        RUNNER.run(['setfacl', '-m', 'u:%s:rw' % u, os.path.join(run, 'pulse', 'native'), os.path.join(run, 'pipewire-0')], timeout=10)
        lines = ['PULSE_SERVER=unix:%s' % os.path.join(run, 'pulse', 'native'),
                 'PIPEWIRE_REMOTE=%s' % os.path.join(run, 'pipewire-0')]
        if sink:
            lines += ['PULSE_SINK=%s' % shlex.quote(sink), 'PIPEWIRE_NODE=%s' % shlex.quote(sink)]
        try:
            path = os.path.join(SEAT_RUN, u, 'audio.env')
            with open(path + '.tmp', 'w') as f:
                f.write('\n'.join(lines) + '\n')
            os.chmod(path + '.tmp', 0o640)
            os.replace(path + '.tmp', path)
        except OSError:
            pass


def revoke_audio(seats, me_uid):
    run = os.environ.get('XDG_RUNTIME_DIR') or '/run/user/%d' % me_uid
    for s in seats:
        if s['seat'] != 1:
            RUNNER.run(['setfacl', '-x', 'u:%s' % s['user'], run, os.path.join(run, 'pulse'),
                        os.path.join(run, 'pulse', 'native'), os.path.join(run, 'pipewire-0')], timeout=10)
    # The split screen's own sound outputs go, and player 1's sound goes back to the screen's.
    try:
        with open(host_modules_file()) as f:
            mods = json.load(f)
        os.remove(host_modules_file())
    except (OSError, ValueError):
        return
    for m in mods.get('modules', []):
        if str(m).isdigit():
            RUNNER.run(['pactl', 'unload-module', str(m)], timeout=10)
    if SINK_NAME_RE.fullmatch(str(mods.get('master') or '')):
        RUNNER.run(['pactl', 'set-default-sink', mods['master']], timeout=10)


def host_run(cmd):
    """Inside the host labwc: open each player's socket, share the sound, run player 1's Game Mode, and close
    the host when it ends (which also ends the other players' sessions: their windows lose their screen)."""
    run = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
    result_file = os.path.join(run, 'hearth-seat-host', 'result')
    c = load_config() or {}
    seats = host_seats(c)
    me = main_user()
    opened = []
    code = None
    try:
        wl = Wayland(os.path.join(run, os.environ['WAYLAND_DISPLAY']) if not os.environ.get('WAYLAND_DISPLAY', '').startswith('/') else os.environ['WAYLAND_DISPLAY'])
        wl.start()
        opened = open_seat_sockets(wl, seats, me['name'])
        try:
            with open(os.path.join(SEAT_RUN, 'host.pid'), 'w') as f:
                f.write(str(os.getpid()))
        except OSError:
            pass
        host_audio(seats, me['uid'])
        env = dict(os.environ)
        env['WAYLAND_DISPLAY'] = opened[0][0]
        env.pop('LABWC_PID', None)       # nimbus-mode must see Game Mode, not the host
        env.pop('DISPLAY', None)
        env['HEARTH_SEAT_HOSTED'] = '1'  # Hearth reads the controllers itself (the host gives only one window input)
        p = subprocess.Popen(cmd, env=env)
        signal.signal(signal.SIGTERM, lambda *_: p.terminate())
        code = p.wait()
    except (Fail, OSError, KeyError) as e:
        print('hearth-seats host: ' + str(e), file=sys.stderr, flush=True)
    finally:
        for path, ls, w, _ in opened:
            try:
                os.unlink(path)
            except OSError:
                pass
            ls.close()
            os.close(w)
        revoke_audio(seats, me['uid'])
        try:
            os.remove(os.path.join(SEAT_RUN, 'host.pid'))
        except OSError:
            pass
        if code is not None:
            try:
                with open(result_file, 'w') as f:
                    f.write(str(code if code >= 0 else 128 - code))
            except OSError:
                pass
        RUNNER.run(['labwc', '--exit'], timeout=10)
    return code if code is not None else 1


# ---------------------------------------------------------------------------------------------- command line
def arg(argv, name):
    if name in argv:
        i = argv.index(name)
        if i + 1 < len(argv):
            return argv[i + 1]
        raise Fail(name + ' needs a value')
    return None


def after_dashes(argv):
    return argv[argv.index('--') + 1:] if '--' in argv else []


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    try:
        if cmd == 'scan':
            print(json.dumps(scan()))
        elif cmd == 'plan':
            print(json.dumps(plan_from(scan())))
        elif cmd == 'setup':
            seats = arg(argv, '--seats')
            if not seats:
                raise Fail('usage: hearth-seats setup --seats JSON [--start]')
            print(json.dumps(setup(seats, start='--start' in argv)))
        elif cmd == 'start':
            print(json.dumps(start()))
        elif cmd == 'stop':
            print(json.dumps(stop()))
        elif cmd == 'status':
            print(json.dumps(status()))
        elif cmd == 'assign-pad':
            pad, seat = arg(argv, '--pad'), arg(argv, '--seat')
            if not pad or not (seat or '').isdigit():
                raise Fail('usage: hearth-seats assign-pad --pad ID --seat N')
            print(json.dumps(assign_pad(pad, int(seat))))
        elif cmd == 'remove':
            print(json.dumps(remove('--delete-users' in argv)))
        elif cmd == 'session':
            session()
        elif cmd == 'host-check':
            return 0 if host_check() else 1
        elif cmd == 'host':
            return host(after_dashes(argv))
        elif cmd == 'host-run':
            return host_run(after_dashes(argv))
        elif cmd == 'gamescope-args':
            print(' '.join(shlex.quote(a) for a in gamescope_args()))
        elif cmd == 'wait-button':
            t = arg(argv, '--timeout') or '20'
            if not t.isdigit() or not 1 <= int(t) <= 120:
                raise Fail('usage: hearth-seats wait-button [--timeout 1-120] [--exclude id,...]')
            ex = [x for x in (arg(argv, '--exclude') or '').split(',') if x]
            print(json.dumps({'pad': wait_button(float(t), ex)}))
        elif cmd == 'stream-info':
            print(json.dumps(stream_info()))
        elif cmd == 'stream-pair':
            seat = arg(argv, '--seat') or ''
            if not seat.isdigit():
                raise Fail('usage: hearth-seats stream-pair --seat N --pin 1234 [--name NAME]')
            print(json.dumps(stream_pair(int(seat), arg(argv, '--pin'), arg(argv, '--name'))))
        elif cmd == 'stream-unpair':
            seat = arg(argv, '--seat') or ''
            if not seat.isdigit():
                raise Fail('usage: hearth-seats stream-unpair --seat N --uuid UUID')
            print(json.dumps(stream_unpair(int(seat), arg(argv, '--uuid'))))
        elif cmd == 'audio':
            seat, vol, only = arg(argv, '--seat'), arg(argv, '--volume'), arg(argv, '--only-p1')
            if (seat is not None and not seat.isdigit()) or (vol is not None and not vol.isdigit()) or only not in (None, 'on', 'off'):
                raise Fail('usage: hearth-seats audio [--seat N --volume 0-100] [--only-p1 on|off]')
            print(json.dumps(audio_cmd(int(seat) if seat else None, int(vol) if vol else None,
                                       None if only is None else only == 'on')))
        elif cmd == 'stream-run':
            return stream_run()
        elif cmd == 'sunshine':
            sunshine_main()
        else:
            raise Fail('usage: hearth-seats scan | plan | setup --seats JSON [--start] | start | stop | status | '
                       'assign-pad --pad ID --seat N | remove [--delete-users] | wait-button | stream-info | '
                       'stream-pair --seat N --pin PIN | stream-unpair --seat N --uuid UUID | audio')
    except Fail as e:
        fail(str(e))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
