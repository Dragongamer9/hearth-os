def assign_pad(pad, seat):
    c = load_config()
    if not c:
        raise Fail('multi-seat isn\'t set up')
    seats = {s['seat']: s for s in c.get('seats', [])}
    if seat not in seats:
        raise Fail('there\'s no player %d' % seat)
    if seat_kind(c, seats[seat]) == 'stream':
        raise Fail('player %d is streamed: their controllers come from their own device' % seat)
    mapping = {}
    for s in c['seats']:
        for p in s.get('pads', []):
            mapping[p] = s['seat']
    mapping[pad] = seat
    return admin(['seats-acl'], {'pads': mapping})


