EXIT_HOST_FALLBACK = 3   # host couldn't start: run normal Game Mode instead
HOST_STATE = os.path.expanduser('~/.local/state/hearth/seat-host.json')
HOST_LOG = os.path.expanduser('~/.local/share/nimbus/seat-host.log')   # the split-screen host's log (in bug reports)
