#!/bin/sh
# Hearth (shared by the editions): turns ostree's boot entries (/boot/loader/entries/*.conf, Boot Loader
# Specification files) into a GRUB menu at /boot/grub2/hearth-bls.cfg, which bootupd's static grub.cfg sources on
# the editions whose GRUB can't read those entries (os-bases/peppermint/system_files/usr/lib/bootupd/grub2-static/
# configs.d/10_blscfg.cfg; the Ubuntu and CachyOS images had the same).
#
# Why: Fedora's GRUB reads those entries itself (its `blscfg` command); Debian's signed GRUB (the one that boots
# with Secure Boot on through Debian's shim) and Arch's have no such command. So the menu is written out here
# whenever the entries change:
#   - at boot and whenever /boot/loader changes (hearth-bls-grub-refresh.path: `bootc rollback`, kargs changes)
#   - at shutdown, right after ostree has finalized a staged update (hearth-bls-grub.service's ExecStop)
#   - by an installer, right after deploying:  hearth-bls-grub --boot /mnt/target/boot
#
# In every image, Anatase's too: a system switched from Peppermint, Ubuntu or CachyOS to Anatase (Settings ›
# Updates › Switch edition) keeps the GRUB and grub.cfg it was installed with, which only read this menu. Without
# this script on the new edition the menu froze at the switch, and the first update after it left GRUB starting a
# version that was gone. Where grub.cfg doesn't read this menu (Anatase's own installs), it does nothing.
#
# Pure POSIX sh + sed/sort, so it also runs from another system's live USB.
set -eu

BOOT=/boot
[ "${1:-}" = "--boot" ] && [ -n "${2:-}" ] && BOOT="$2"
ENTRIES="$BOOT/loader/entries"
OUT_DIR="$BOOT/grub2"
OUT="$OUT_DIR/hearth-bls.cfg"

[ -d "$ENTRIES" ] || { echo "hearth-bls-grub: no $ENTRIES (nothing deployed yet)"; exit 0; }
if [ "$BOOT" = /boot ] && [ -f "$OUT_DIR/grub.cfg" ] && ! grep -q 'hearth-bls\.cfg' "$OUT_DIR/grub.cfg"; then
  echo "hearth-bls-grub: this system's GRUB reads the boot entries itself; nothing to do"
  exit 0
fi
mkdir -p "$OUT_DIR"
TMP="$OUT.tmp.$$"
trap 'rm -f "$TMP" "$TMP.list"' EXIT

# "version<TAB>file" for each entry; ostree gives the default (newest) deployment the highest version.
: > "$TMP.list"
for f in "$ENTRIES"/*.conf; do
  [ -f "$f" ] || continue
  v=$(sed -n 's/^version[[:space:]]\{1,\}//p' "$f" | head -1)
  case "$v" in ''|*[!0-9]*) v=0 ;; esac
  printf '%s\t%s\n' "$v" "$f" >> "$TMP.list"
done

quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

TAB=$(printf '\t')
sort -t "$TAB" -k1,1nr "$TMP.list" | {
  echo "# Written by hearth-bls-grub from $ENTRIES: don't edit, it's rewritten on every update."
  echo "set default=0"
  n=0
  while IFS="$TAB" read -r _ f; do
    title=$(sed -n 's/^title[[:space:]]\{1,\}//p' "$f" | head -1)
    linux=$(sed -n 's/^linux[[:space:]]\{1,\}//p' "$f" | head -1)
    opts=$(sed -n 's/^options[[:space:]]\{1,\}//p' "$f" | head -1)
    initrd=$(sed -n 's/^initrd[[:space:]]\{1,\}//p' "$f" | tr '\n' ' ')
    [ -n "$linux" ] || continue
    title="${title:-Hearth OS}"
    if [ "$n" -gt 0 ]; then title="$title (previous version)"; fi
    id=$(basename "$f" .conf)
    echo "menuentry $(quote "$title") --class hearth --class gnu-linux --id $(quote "$id") {"
    echo "  load_video"
    echo "  set gfxpayload=keep"
    echo "  linux $linux $opts"
    if [ -n "$initrd" ]; then echo "  initrd $initrd"; fi
    echo "}"
    n=$((n + 1))
  done
} > "$TMP"

grep -q '^menuentry' "$TMP" || { echo "hearth-bls-grub: no usable entries in $ENTRIES; keeping the old menu" >&2; exit 1; }
# /boot is written only when something changed (it's what a sudden power cut must not catch mid-write).
if [ -f "$OUT" ] && cmp -s "$TMP" "$OUT"; then
  echo "hearth-bls-grub: $OUT is up to date"
  exit 0
fi
sync
mv -f "$TMP" "$OUT"
sync
echo "hearth-bls-grub: wrote $(grep -c '^menuentry' "$OUT") entries to $OUT"
