#!/bin/sh
# Every account (uid 1000 and up) in the groups Hearth's settings need, whatever made the account: the
# installer, the first-boot setup, or moving from another edition (the account files come from the old system).
#   video: screen brightness where brightnessctl writes the file itself (Debian, Ubuntu).
#   systemd-journal: reading the system's log, so the log report (Settings › About) has it; Fedora's and Arch's
#     wheel group can already, Debian's and Ubuntu's accounts couldn't.
# Runs at start-up, before anyone signs in, so it applies to that sign-in.
for g in video systemd-journal; do
  getent group "$g" >/dev/null || continue
  getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ {print $1}' | while read -r u; do
    id -nG "$u" 2>/dev/null | tr ' ' '\n' | grep -qx "$g" && continue
    # Never multi-seat's extra players (hearth-p2..4): video would let them open every graphics card, the other
    # players' too (docs/MULTI-SEAT.md, "Supplementary groups"), and the system's log isn't theirs to read.
    case "$u" in hearth-p[0-9]*) continue ;; esac
    if command -v usermod >/dev/null; then usermod -aG "$g" "$u"; else gpasswd -a "$u" "$g"; fi && echo "hearth-groups: $u added to $g"
  done
done
# ...and taken out again where an earlier version put them in.
for g in video systemd-journal; do
  getent passwd | awk -F: '$1 ~ /^hearth-p[0-9]+$/ {print $1}' | while read -r u; do
    id -nG "$u" 2>/dev/null | tr ' ' '\n' | grep -qx "$g" || continue
    gpasswd -d "$u" "$g" >/dev/null && echo "hearth-groups: $u taken out of $g"
  done
done
exit 0
