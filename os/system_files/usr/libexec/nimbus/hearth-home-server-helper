                raise Fail('restore-run is started by backup-restore only')
            res = restore_run(*a[2:])
        elif len(a) == 2 and a[0] == 'receive-add':
            res = receive_add(a[1])
        elif len(a) == 2 and a[0] == 'receive-remove':
            res = receive_remove(a[1])
        elif a == ['alerts', 'run']:
            res = alerts_run()
        elif a == ['alerts', 'test']:
            caller()
            res = alerts_run(test=True)
        elif a == ['power', 'run']:
            res = power_run()
        elif a == ['ups-status']:
            caller()
            res = {'ok': True, 'ups': ups_status()}
        else:
            raise Fail('usage: hearth-home-server-helper apply | smb-password | drives | format-plan DEV | format | '
                       'snapshot run | tailscale start|stop | exit-node on|off | wol IFACE | person-add | person-password | '
                       'person-remove NAME | person-folder | backup-secret ID | backup-forget ID | backup run [--now ID] | '
                       'backup-now ID | backup-snapshots ID | backup-restore | receive-add NAME | receive-remove USER | '
                       'alerts run|test | power run | ups-status')
        print(json.dumps(res))
        return 0
    except FAILS as e:
        print(json.dumps({'ok': False, 'error': str(e)}))
        return 1


