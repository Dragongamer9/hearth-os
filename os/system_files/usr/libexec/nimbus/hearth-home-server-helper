POWER_TIMER = 'hearth-home-server-power.timer'
POWER_STATE = '/run/hearth/home-server-power.json'
WAKE_TIMER = 'hearth-home-server-wake.timer'
WAKE_DROPIN = '/etc/systemd/system/hearth-home-server-wake.timer.d/hearth.conf'
AWAKE_UNIT = 'hearth-home-server-awake'
POWER_DEFAULT = {'sleepIdle': 0, 'keepAwake': False, 'spinDown': 0, 'schedule': False, 'sleepAt': '01:00', 'wakeAt': '07:00', 'ups': False}
SPIN_MINUTES = (0, 10, 20, 30, 60)
IDLE_MINUTES = (0, 30, 60, 120, 240)


def clean_power(p):
    p = p if isinstance(p, dict) else {}
    out = dict(POWER_DEFAULT)
    if p.get('sleepIdle') in IDLE_MINUTES:
        out['sleepIdle'] = p['sleepIdle']
    if p.get('spinDown') in SPIN_MINUTES:
        out['spinDown'] = p['spinDown']
    for k in ('keepAwake', 'schedule', 'ups'):
        if isinstance(p.get(k), bool):
            out[k] = p[k]
    for k in ('sleepAt', 'wakeAt'):
        if isinstance(p.get(k), str) and TIME_RE.fullmatch(p[k]):
            out[k] = p[k]
    return out


def hdparm_value(minutes):
    """hdparm -S: 1-240 are 5-second steps (up to 20 minutes), 241-251 are 30-minute steps."""
    if minutes <= 0:
        return 0
    if minutes <= 20:
        return minutes * 12
    return 240 + max(1, min(11, minutes // 30))


def spin_disks():
    """Spinning data drives (never the system's, never an SSD/NVMe, never USB-removable ones the person carries)."""
    sysd = system_disks()
    return [d['path'] for d in lsblk() if d.get('type') == 'disk' and d.get('rota') in (True, 1, '1') and d.get('name') not in sysd
            and DEV_RE.fullmatch(d.get('path') or '') and d.get('rm') not in (True, 1, '1')]


def spin_apply(minutes, st):
    """hdparm -S on each spinning data drive, once per start of the PC or when the time changes."""
    if not which('hdparm'):
        return 'missing'
    disks = spin_disks()
    want = {'value': hdparm_value(minutes), 'disks': disks}
    if st.get('spin') == want:
        return 'same'
    for d in disks:
        run(['hdparm', '-S', str(want['value']), d], timeout=20)
    st['spin'] = want
    return 'set %d' % len(disks)


def smb_sessions():
    """How many of your devices have a share open right now (smbstatus). Tests replace this."""
    if not which('smbstatus'):
        return 0
    code, out = run(['smbstatus', '-b', '--json'], timeout=15)
    try:
        return len(json.loads(out).get('sessions') or {}) if code == 0 else 0
    except ValueError:
        return 0


def jobs_running():
    """A backup, snapshot or restore running now. Tests replace this."""
    code, out = run(['systemctl', 'list-units', '--state=active', '--no-legend', '--plain', 'hearth-home-server-*'], timeout=15)
    return any(u in out for u in ('hearth-home-server-backup', 'hearth-home-server-snapshots', 'hearth-home-server-restore', 'hearth-home-server-mirror'))


def someone_using():
    """Someone is signed in and using this PC (an active session that isn't idle; the login screen doesn't count). When
    the desktop can't say, it counts as used: then Settings › Power's own idle sleep is the one that decides."""
    code, out = run(['loginctl', 'list-sessions', '--no-legend'], timeout=10)
    if code != 0:
        return True
    for l in out.splitlines():
        sid = l.split()[0] if l.split() else ''
        if not re.fullmatch(r'[A-Za-z0-9]+', sid):
            continue
        c, o = run(['loginctl', 'show-session', sid, '-p', 'Active', '-p', 'Class', '-p', 'IdleHint'], timeout=10)
        props = dict(x.split('=', 1) for x in o.splitlines() if '=' in x)
        if props.get('Active') == 'yes' and props.get('Class') == 'user' and props.get('IdleHint') != 'yes':
            return True
    return False


def busy_reasons():
    out = []
    if game_running():
        out.append('Game Mode')
    if smb_sessions():
        out.append('sharing')
    if jobs_running():
        out.append('backing up')
    return out


def in_window(now, start, end):
    t = time.localtime(now)
    cur = t.tm_hour * 60 + t.tm_min
    s = int(start[:2]) * 60 + int(start[3:])
    e = int(end[:2]) * 60 + int(end[3:])
    return s <= cur < e if s < e else (cur >= s or cur < e)


def power_run(now=None):
    """The power timer (every 5 minutes, while a power choice is on): spins down idle data drives, keeps the PC awake
    while your devices use it, and lets it sleep when nobody needs it: never while Game Mode runs, a share is open or a
    backup runs, and never past anything else holding sleep off (logind's inhibitors are respected)."""
    now = time.time() if now is None else now
    plan = plan_read()
    p = clean_power(plan.get('power'))
    st = state_read(POWER_STATE)
    res = {'ok': True}
    if p['spinDown']:
        res['spin'] = spin_apply(p['spinDown'], st)
    busy = busy_reasons()
    res['busy'] = busy
    if p['keepAwake'] and ('sharing' in busy or 'backing up' in busy):
        if run(['systemctl', 'is-active', AWAKE_UNIT + '.service'])[0] != 0:
            run(['systemd-run', '--unit=' + AWAKE_UNIT, '--collect', '--property=RuntimeMaxSec=620', 'systemd-inhibit', '--what=sleep',
                 '--who=Hearth home server', '--why=Your devices are using it', '--mode=block', 'sleep', '600'])
        res['awake'] = True
    using = bool(busy) or someone_using()
    if using or not st.get('quietSince'):
        st['quietSince'] = int(now)
    quiet = now - st['quietSince']
    sleep_why = ''
    if not using and p['sleepIdle'] and quiet >= p['sleepIdle'] * 60:
        sleep_why = 'idle'
    today = time.strftime('%Y-%m-%d', time.localtime(now))
    if not busy and p['schedule'] and in_window(now, p['sleepAt'], p['wakeAt']) and st.get('scheduled') != today:
        sleep_why = sleep_why or 'schedule'
        st['scheduled'] = today
    if sleep_why:
        st['quietSince'] = int(now)
        state_write(POWER_STATE, st)
        code, _ = run(['systemctl', 'suspend', '--check-inhibitors=yes'], timeout=30)
        res['slept'] = sleep_why if code == 0 else 'held off'
    state_write(POWER_STATE, st)
    return res


def wake_apply(p):
    if p['schedule']:
        write(WAKE_DROPIN, '# Hearth home server: wake every day (hearth-home-server-helper).\n[Timer]\nOnCalendar=\nOnCalendar=*-*-* %s:00\nWakeSystem=true\n' % p['wakeAt'])
        run(['systemctl', 'daemon-reload'])
        return unit_switch(WAKE_TIMER, True)
    unit_switch(WAKE_TIMER, False)
    if remove(WAKE_DROPIN):
        run(['systemctl', 'daemon-reload'])
    return 'off'


# ------------------------------------------------------------------ UPS (Network UPS Tools)

NUT_DIR = '/etc/nut'
NUT_MARK = '# Hearth home server (hearth-home-server-helper): your UPS'
NUT_STARTED = '/etc/nut/.hearth-started'
NUT_UNITS = ('nut-driver-enumerator.service', 'nut-server.service', 'nut-monitor.service')


def ups_apply(on):
    """Your UPS through NUT, standalone: when its battery runs low the PC shuts down cleanly. Only files Hearth wrote
    are ever changed (a NUT set up by hand is left alone); off takes Hearth's setup away again."""
    if not os.path.isdir(NUT_DIR) or not which('upsmon'):
        return {'ups': 'missing'} if on else {'ups': 'off'}
    ups_conf = os.path.join(NUT_DIR, 'ups.conf')
    mine = not os.path.exists(ups_conf) or NUT_MARK in read(ups_conf) or not re.search(r'^\s*\[', read(ups_conf), re.M)
    if not mine:
        return {'ups': 'by-hand', 'note': 'NUT is already set up by hand on this PC: Hearth leaves it alone'}
    if on:
        import secrets as _secrets
        upsd_users = os.path.join(NUT_DIR, 'upsd.users')
        try:
            pw = re.search(r'password = (\S+)', read(upsd_users)).group(1) if NUT_MARK in read(upsd_users) else ''
        except (OSError, AttributeError):
            pw = ''
        pw = pw or _secrets.token_hex(16)
        write(os.path.join(NUT_DIR, 'nut.conf'), NUT_MARK + '\nMODE=standalone\n', 0o640)
        write(ups_conf, NUT_MARK + '\n[hearth]\n\tdriver = usbhid-ups\n\tport = auto\n\tdesc = "UPS (Hearth home server)"\n', 0o640)
        write(os.path.join(NUT_DIR, 'upsd.conf'), NUT_MARK + '\nLISTEN 127.0.0.1 3493\nLISTEN ::1 3493\n', 0o640)
        write(upsd_users, NUT_MARK + '\n[hearth-monitor]\n\tpassword = %s\n\tupsmon primary\n' % pw, 0o640)
        write(os.path.join(NUT_DIR, 'upsmon.conf'), NUT_MARK + '\nMONITOR hearth@localhost 1 hearth-monitor %s primary\n'
              'MINSUPPLIES 1\nSHUTDOWNCMD "/sbin/shutdown -h +0"\nPOWERDOWNFLAG /etc/killpower\n' % pw, 0o640)
        for f in ('nut.conf', 'ups.conf', 'upsd.conf', 'upsd.users', 'upsmon.conf'):
            try:
                os.chown(os.path.join(NUT_DIR, f), 0, __import__('grp').getgrnam('nut').gr_gid)
            except (KeyError, OSError):
                pass
        if not os.path.exists(NUT_STARTED):
            open(NUT_STARTED, 'w').close()
        for u in NUT_UNITS:
            run(['systemctl', 'enable', '--now', u], timeout=60)
        return {'ups': 'on'}
    if os.path.exists(NUT_STARTED):
        for u in NUT_UNITS:
            run(['systemctl', 'disable', '--now', u], timeout=60)
        if os.path.exists(os.path.join(NUT_DIR, 'nut.conf')) and NUT_MARK in read(os.path.join(NUT_DIR, 'nut.conf')):
            write(os.path.join(NUT_DIR, 'nut.conf'), NUT_MARK + '\nMODE=none\n', 0o640)
        remove(NUT_STARTED)
    return {'ups': 'off'}


def ups_status():
    """The UPS's charge and whether it's on battery (upsc), or None."""
    if not which('upsc'):
        return None
    code, out = run(['upsc', 'hearth@localhost'], timeout=10)
    if code != 0:
        return None
    v = dict(l.split(': ', 1) for l in out.splitlines() if ': ' in l)
    return {'charge': v.get('battery.charge', ''), 'status': v.get('ups.status', ''), 'runtime': v.get('battery.runtime', '')}


