def hostname():
    """Tests replace this."""
    import socket
    return socket.gethostname().split('.')[0] or 'hearth'


def ensure_dir(path, mode=0o700, owner=None):
    os.makedirs(path, mode=mode, exist_ok=True)
    os.chmod(path, mode)
    if owner is not None:
        try:
            pw = pwd.getpwnam(owner)
            os.chown(path, pw.pw_uid, pw.pw_gid)
        except (KeyError, OSError):
            pass


def unit_switch(unit, on):
    """A unit (a timer) enabled and started, or disabled and stopped, only when it isn't so already."""
    enabled = run(['systemctl', 'is-enabled', unit])[0] == 0
    if on and not enabled:
        run(['systemctl', 'enable', '--now', unit])
    elif not on and enabled:
        run(['systemctl', 'disable', '--now', unit])
    return 'on' if on else 'off'


def user_settings(home):
    """Your own ~/.config/nimbus/home-server.json, read (never written) by root for one live value: Light mode, which
    Game Mode's Quick Access can change without a password. A link, a huge file or one that doesn't parse gives {}."""
    p = os.path.join(home, '.config', 'nimbus', 'home-server.json')
    try:
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return {}
    try:
        import stat as _stat
        st = os.fstat(fd)
        if not _stat.S_ISREG(st.st_mode) or st.st_size > (1 << 20):
            return {}
        data = os.read(fd, 1 << 20)
    except OSError:
        return {}
    finally:
        os.close(fd)
    try:
        v = json.loads(data.decode('utf-8', 'replace'))
    except ValueError:
        return {}
    return v if isinstance(v, dict) else {}


def light_mode(plan):
    """Light mode while you play: your settings file's value when it can be read, else the plan's."""
    pw = getpw(plan.get('user') or '') if isinstance(plan.get('user'), str) else None
    home = pw.pw_dir if pw else ''
    v = user_settings(home).get('lightMode') if home else None
    if isinstance(v, bool):
        return v
    return plan.get('lightMode', True) is not False


RESUME_HOURS = 4


def light_resumed(now=None):
    """"Let paused jobs run now" (Game Mode's Quick Access): a flag in your runtime folder, at most 4 hours old. Only
    ever lets your own big jobs run during your own game; it changes no setting."""
    now = time.time() if now is None else now
    try:
        for u in os.listdir('/run/user'):
            p = '/run/user/%s/hearth-home-server-resume' % u
            try:
                if now - os.lstat(p).st_mtime < RESUME_HOURS * 3600:
                    return True
            except OSError:
                pass
    except OSError:
        pass
    return False


def wait_for_game(plan):
    """True when big jobs wait: Light mode on, Game Mode or a game running, and not let through for now."""
    return light_mode(plan) and game_running() and not light_resumed()


