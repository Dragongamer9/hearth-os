            if os.path.exists(RCLONE_CONF):
                write(RCLONE_CONF, rclone_strip(read(RCLONE_CONF), 'hearth-' + a[1]), 0o600)
            res = {'ok': True, 'forgotten': a[1], 'backupKept': True}
        elif a == ['backup', 'run']:
            res = backup_run()
        elif len(a) == 4 and a[:3] == ['backup', 'run', '--now']:
            res = backup_run(only=a[3], now_flag=True)
