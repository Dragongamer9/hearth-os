#!/usr/bin/python3
"""Hearth OS updates from Hearth Storage (docs/HEARTH-LINK.md, "Hearth OS updates"): the home server fetches each
new image once, the other devices pull it from there, and they wait for one device to start it well first.

  serve          root, one process per connection (hearth-update-mirror.socket, 127.0.0.1:479, Accept=yes): the
                 registry mirror bootc pulls Hearth OS through (/etc/containers/registries.conf.d/
                 60-hearth-storage.conf). Tag manifests always come straight from ghcr.io (never stale, never from
                 anyone else); manifests by digest and layers come from the Hearth Storage server through this
                 user's Hearth Link (`storage.updates.fetch`), checked against their sha256 before a byte is sent,
                 and from ghcr.io when the server hasn't got them, sends something else or isn't there. No server
                 in use: /v2/ answers 503, so bootc skips the mirror and uses ghcr.io itself, as before.
  may-stage      root, an ExecCondition of background updates (next to hearth-boot-guard may-update): hold-back.
                 Exit 1 (skip this run) only when Hearth Link says to wait for another device; anything else
                 (no Hearth Link, no server, an error) lets the update go. Never more than 3 days in a row.
  fetch REF DIR  the Hearth Storage server, as its user (hearth-link runs it): the newest image of REF into DIR
                 (blobs/sha256/<hex>, refs.json), every piece checked; keeps the previous image too. Prints one JSON
                 line.

Safety (MILESTONES.md: an update must never stop a device from starting, and devices must always be able to update
without the server): everything here fails open to ghcr.io; "Update now" is never held; bootc checks every piece
itself as well.
"""
import glob
import hashlib
import json
import os
import re
import shutil
import socket
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

NAMESPACE = 'dragongamer9'
UPSTREAM = os.environ.get('HEARTH_UPSTREAM', 'https://ghcr.io')
SOCKETS = os.environ.get('HEARTH_LINK_SOCKETS', '/run/user/*/hearth-link/link.sock')
STATE = os.environ.get('HEARTH_STATE', '/var/lib/hearth')
RUN = os.environ.get('HEARTH_MIRROR_RUN', '/run/hearth-update-mirror')
HOLD_MAX = 3 * 86400
BAD_FOR = 6 * 3600
CHUNK = 1 << 20
MANIFEST_TYPES = ', '.join([
    'application/vnd.oci.image.index.v1+json', 'application/vnd.docker.distribution.manifest.list.v2+json',
    'application/vnd.oci.image.manifest.v1+json', 'application/vnd.docker.distribution.manifest.v2+json'])
INDEX_TYPES = ('application/vnd.oci.image.index.v1+json', 'application/vnd.docker.distribution.manifest.list.v2+json')
DIGEST = re.compile(r'^sha256:[0-9a-f]{64}$')
REPO = re.compile(r'^' + NAMESPACE + r'/[a-z0-9][a-z0-9._-]{0,63}$')
TAG = re.compile(r'^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$')


def log(msg):
    print(f'hearth-update-mirror: {msg}', file=sys.stderr, flush=True)


def sha256(data):
    return 'sha256:' + hashlib.sha256(data).hexdigest()


def parse_ref(ref):
    """ghcr.io/dragongamer9/NAME[:TAG] → (repo, tag); None for anything else."""
    if not ref.startswith('ghcr.io/'):
        return None
    rest = ref[len('ghcr.io/'):]
    repo, _, tag = rest.partition(':')
    tag = tag or 'latest'
    return (repo, tag) if REPO.match(repo) and TAG.match(tag) else None


# ------------------------------------------------------------------ the real registry
class Upstream:
    """ghcr.io's registry API, anonymous pull tokens (asked for when it says 401)."""

    def __init__(self, base=None):
        self.base = (base or UPSTREAM).rstrip('/')
        self.tokens = {}

    def open(self, method, path, repo, headers=None, timeout=60):
        for attempt in (0, 1):
            req = urllib.request.Request(self.base + path, method=method)
            for k, v in (headers or {}).items():
                req.add_header(k, v)
            if self.tokens.get(repo):
                # Not sent on to where a blob redirects (the storage behind the registry).
                req.add_unredirected_header('Authorization', 'Bearer ' + self.tokens[repo])
            try:
                return urllib.request.urlopen(req, timeout=timeout)
            except urllib.error.HTTPError as e:
                if e.code == 401 and attempt == 0 and self.token(repo, e.headers.get('WWW-Authenticate', '')):
                    continue
                raise

    def token(self, repo, challenge):
        m = re.match(r'\s*Bearer\s+(.*)', challenge or '', re.I)
        if not m:
            return False
        params = dict(re.findall(r'(\w+)="([^"]*)"', m.group(1)))
        realm = params.get('realm', '')
        if not realm.startswith(('https://', 'http://127.0.0.1')):
            return False
        q = urllib.parse.urlencode({'service': params.get('service', ''), 'scope': f'repository:{repo}:pull'})
        with urllib.request.urlopen(realm + ('&' if '?' in realm else '?') + q, timeout=30) as r:
            j = json.load(r)
        self.tokens[repo] = j.get('token') or j.get('access_token') or ''
        return bool(self.tokens[repo])

    def manifest(self, repo, ref, accept=MANIFEST_TYPES, method='GET'):
        with self.open(method, f'/v2/{repo}/manifests/{ref}', repo, {'Accept': accept}) as r:
            body = r.read() if method == 'GET' else b''
            return r.status, {k.lower(): v for k, v in r.headers.items()}, body

    def blob(self, repo, digest, rng=None, method='GET'):
        return self.open(method, f'/v2/{repo}/blobs/{digest}', repo, {'Range': rng} if rng else {}, timeout=120)


# ------------------------------------------------------------------ this device's Hearth Link (the user's service)
class LinkError(Exception):
    pass


def link_call(path, cmd, args=None, timeout=30):
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(path)
        s.sendall((json.dumps({'id': 1, 'cmd': cmd, 'args': args or {}}) + '\n').encode())
        line = s.makefile('rb').readline()
    finally:
        s.close()
    if not line:
        raise LinkError('no answer')
    v = json.loads(line)
    if v.get('ok'):
        return v.get('data')
    raise LinkError(v.get('error') or 'failed')


def link_sockets():
    out = []
    for p in glob.glob(SOCKETS):
        try:
            st = os.stat(p)
        except OSError:
            continue
        if stat.S_ISSOCK(st.st_mode):
            out.append((st.st_uid, p))
    return sorted(out)


def find_link(cmd='storage.updates.mirror', key='use', timeout=10):
    """The first user's Hearth Link that says yes to `cmd`: (uid, socket, answer), or None."""
    for uid, p in link_sockets():
        try:
            v = link_call(p, cmd, {}, timeout)
        except (OSError, ValueError, LinkError):
            continue
        if isinstance(v, dict) and v.get(key):
            return uid, p, v
    return None


# ------------------------------------------------------------------ serve: bootc's mirror
def bad_marker():
    return os.path.join(RUN, 'server-bad')


def server_bad():
    try:
        return time.time() - os.path.getmtime(bad_marker()) < BAD_FOR
    except OSError:
        return False


def mark_bad(why):
    log(f'not using Hearth Storage for {BAD_FOR // 3600} hours: {why}')
    try:
        os.makedirs(RUN, exist_ok=True)
        with open(bad_marker(), 'w') as f:
            f.write(why + '\n')
    except OSError:
        pass


def parse_range(h, size):
    """'bytes=A-B' / 'bytes=A-' → (first, last), None (whole), or False (can't)."""
    if not h:
        return None
    m = re.match(r'^bytes=(\d+)-(\d*)$', h.strip())
    if not m:
        return False
    a = int(m.group(1))
    b = int(m.group(2)) if m.group(2) else size - 1
    if a >= size or b < a:
        return False
    return a, min(b, size - 1)


class Mirror:
    def __init__(self, conn, upstream=None):
        self.conn = conn
        self.up = upstream or Upstream()
        self.link = None  # (uid, socket)
        self.checked = False

    # ---- the connection
    def send(self, status, headers=None, body=b'', head_only=False, length=None):
        reason = {200: 'OK', 206: 'Partial Content', 404: 'Not Found', 405: 'Method Not Allowed', 416: 'Range Not Satisfiable',
                  502: 'Bad Gateway', 503: 'Service Unavailable'}.get(status, 'Status')
        h = {'Content-Length': str(len(body) if length is None else length), 'Docker-Distribution-API-Version': 'registry/2.0'}
        h.update(headers or {})
        out = f'HTTP/1.1 {status} {reason}\r\n' + ''.join(f'{k}: {v}\r\n' for k, v in h.items()) + '\r\n'
        self.conn.sendall(out.encode('latin-1') + (b'' if head_only else body))

    def loop(self):
        buf = b''
        while True:
            while b'\r\n\r\n' not in buf:
                try:
                    chunk = self.conn.recv(65536)
                except OSError:
                    return
                if not chunk:
                    return
                if not buf and chunk[:1] == b'\x16':
                    return  # TLS first (an insecure mirror is tried with https, then http)
                buf += chunk
                if len(buf) > 65536:
                    return
            head, buf = buf.split(b'\r\n\r\n', 1)
            lines = head.decode('latin-1').split('\r\n')
            parts = lines[0].split(' ')
            if len(parts) < 2:
                return
            headers = {}
            for line in lines[1:]:
                if ':' in line:
                    k, v = line.split(':', 1)
                    headers[k.strip().lower()] = v.strip()
            try:
                keep = self.handle(parts[0], parts[1], headers)
            except (BrokenPipeError, ConnectionResetError):
                return
            except Exception as e:  # never a traceback to bootc: a failure it falls back from
                log(f'{parts[0]} {parts[1]}: {e}')
                try:
                    self.send(502)
                except OSError:
                    pass
                return
            if not keep or headers.get('connection', '').lower() == 'close':
                return

    # ---- Hearth Link
    def use_server(self):
        if not self.checked:
            self.checked = True
            if not server_bad():
                found = find_link()
                if found:
                    self.link = found[:2]
        return self.link is not None

    def from_server(self, digest):
        """The piece from the Hearth Storage server, checked: (fd, size) or None."""
        if not self.use_server():
            return None
        uid, sock = self.link
        try:
            v = link_call(sock, 'storage.updates.fetch', {'digest': digest}, timeout=3600)
            fd = os.open(v['path'], os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except (OSError, ValueError, KeyError, TypeError, LinkError) as e:
            log(f'{digest[:19]}: from ghcr.io ({e})')
            return None
        try:
            st = os.fstat(fd)
            if not stat.S_ISREG(st.st_mode) or st.st_uid != uid or st.st_size != v.get('size'):
                raise ValueError('not the file Hearth Link said')
            h = hashlib.sha256()
            while True:
                b = os.read(fd, CHUNK)
                if not b:
                    break
                h.update(b)
            if 'sha256:' + h.hexdigest() != digest:
                raise ValueError('it was not the right piece')
            os.lseek(fd, 0, os.SEEK_SET)
            return fd, st.st_size
        except (OSError, ValueError) as e:
            os.close(fd)
            self.drop(digest)
            mark_bad(str(e))
            self.link = None
            return None

    def drop(self, digest):
        if self.link:
            try:
                link_call(self.link[1], 'storage.updates.drop', {'digest': digest}, 10)
            except (OSError, ValueError, LinkError):
                pass

    # ---- requests
    def handle(self, method, target, headers):
        path = urllib.parse.urlsplit(target).path
        head = method == 'HEAD'
        if method not in ('GET', 'HEAD'):
            self.send(405)
            return True
        if path in ('/v2', '/v2/'):
            if not self.use_server():
                # No Hearth Storage in use: bootc skips this mirror and asks ghcr.io itself.
                self.send(503)
                return False
            self.send(200, {'Content-Type': 'application/json'}, b'{}', head)
            return True
        m = re.match(r'^/v2/(.+)/(manifests|blobs)/([^/]+)$', path)
        if not m or not REPO.match(m.group(1)) or not (DIGEST.match(m.group(3)) or (m.group(2) == 'manifests' and TAG.match(m.group(3)))):
            self.send(404)
            return True
        repo, kind, ref = m.groups()
        if kind == 'manifests':
            return self.manifest(repo, ref, headers, head)
        return self.blob(repo, ref, headers, head)

    def manifest(self, repo, ref, headers, head):
        accept = headers.get('accept') or MANIFEST_TYPES
        if DIGEST.match(ref):
            got = self.from_server(ref)
            if got:
                fd, size = got
                with os.fdopen(fd, 'rb') as f:
                    body = f.read()
                self.drop(ref)
                try:
                    ctype = json.loads(body).get('mediaType')
                except ValueError:
                    ctype = None
                if ctype:
                    self.send(200, {'Content-Type': ctype, 'Docker-Content-Digest': ref}, body, head)
                    return True
        try:
            status, h, body = self.up.manifest(repo, ref, accept, 'HEAD' if head else 'GET')
        except urllib.error.HTTPError as e:
            self.send(404 if e.code == 404 else 502)
            return True
        except (OSError, ValueError) as e:
            log(f'ghcr.io: {e}')
            self.send(502)
            return True
        if DIGEST.match(ref) and not head and sha256(body) != ref:
            self.send(502)
            return True
        out = {'Content-Type': h.get('content-type', 'application/json')}
        if h.get('docker-content-digest'):
            out['Docker-Content-Digest'] = h['docker-content-digest']
        self.send(status, out, body, head, None if not head else int(h.get('content-length', '0') or 0))
        return True

    def blob(self, repo, digest, headers, head):
        rng = headers.get('range')
        got = self.from_server(digest)
        if got:
            fd, size = got
            try:
                r = parse_range(rng, size)
                if r is False:
                    self.send(416, {'Content-Range': f'bytes */{size}'})
                    return True
                first, last = r if r else (0, size - 1)
                h = {'Content-Type': 'application/octet-stream', 'Docker-Content-Digest': digest, 'Accept-Ranges': 'bytes'}
                if r:
                    h['Content-Range'] = f'bytes {first}-{last}/{size}'
                self.send(206 if r else 200, h, b'', True, max(0, last - first + 1))
                if not head:
                    os.lseek(fd, first, os.SEEK_SET)
                    left = last - first + 1
                    while left > 0:
                        b = os.read(fd, min(CHUNK, left))
                        if not b:
                            return False
                        self.conn.sendall(b)
                        left -= len(b)
                return True
            finally:
                os.close(fd)
                self.drop(digest)
        # From ghcr.io, as it comes.
        try:
            resp = self.up.blob(repo, digest, rng, 'HEAD' if head else 'GET')
        except urllib.error.HTTPError as e:
            self.send(e.code if e.code in (404, 416) else 502)
            return True
        except (OSError, ValueError) as e:
            log(f'ghcr.io: {e}')
            self.send(502)
            return True
        with resp:
            h = {'Content-Type': 'application/octet-stream', 'Docker-Content-Digest': digest}
            if resp.headers.get('Content-Range'):
                h['Content-Range'] = resp.headers['Content-Range']
            length = resp.headers.get('Content-Length')
            if length is None:
                h['Connection'] = 'close'
            self.send(resp.status, h, b'', True, int(length) if length else 0)
            if head:
                return length is not None
            if length is None:
                # No length known: the body ends when this connection closes.
                while True:
                    b = resp.read(CHUNK)
                    if not b:
                        return False
                    self.conn.sendall(b)
            left = int(length)
            while left > 0:
                b = resp.read(min(CHUNK, left))
                if not b:
                    return False
                self.conn.sendall(b)
                left -= len(b)
        return True


def cmd_serve():
    conn = socket.socket(fileno=0)  # systemd's connection (Accept=yes)
    conn.settimeout(600)
    try:
        Mirror(conn).loop()
    finally:
        try:
            conn.close()
        except OSError:
            pass
    return 0


# ------------------------------------------------------------------ may-stage: hold-back
def hold_file():
    return os.path.join(STATE, 'update-hold.json')


def may_stage(now=None, ask=None):
    """0: background update may go; 1: wait (another device is starting the new version first)."""
    now = now or time.time()
    try:
        with open(hold_file()) as f:
            st = json.load(f)
    except (OSError, ValueError):
        st = {}
    answer = None
    try:
        answer = (ask or ask_link)()
    except Exception as e:  # anything unexpected: the update goes
        log(f'hold-back: {e}')
    hold = isinstance(answer, dict) and answer.get('hold') is True
    if not hold:
        if st:
            try:
                os.remove(hold_file())
            except OSError:
                pass
        return 0
    first = st.get('first_held') if isinstance(st.get('first_held'), (int, float)) else now
    if now - first >= HOLD_MAX:
        log('hold-back: waited 3 days already, updating anyway')
        return 0
    try:
        os.makedirs(STATE, exist_ok=True)
        with open(hold_file(), 'w') as f:
            json.dump({'first_held': first, 'waiting_for': answer.get('waitingFor'), 'version': answer.get('version')}, f)
    except OSError:
        pass
    who = answer.get('waitingFor') or 'another device'
    log(f'hold-back: waiting until {who} has started {answer.get("version") or "the new version"} well (Hearth Storage)')
    return 1


def ask_link():
    """Hearth Link's answer (it asks the server, waking it if needed); None when there's no Hearth Link."""
    for _, p in link_sockets():
        try:
            return link_call(p, 'storage.updates.hold', {}, 110)
        except (OSError, ValueError, LinkError):
            continue
    return None


# ------------------------------------------------------------------ fetch: the server's copy
def blob_path(d, digest):
    return os.path.join(d, 'blobs', 'sha256', digest[7:])


def store_bytes(d, digest, data):
    p = blob_path(d, digest)
    if not os.path.exists(p):
        os.makedirs(os.path.dirname(p), exist_ok=True)
        with open(p + '.part', 'wb') as f:
            f.write(data)
        os.replace(p + '.part', p)


def download(up, repo, d, desc):
    digest, size = desc['digest'], int(desc.get('size') or 0)
    if not DIGEST.match(digest):
        raise ValueError(f'not a sha256 piece: {digest}')
    p = blob_path(d, digest)
    if os.path.exists(p):
        return 0
    os.makedirs(os.path.dirname(p), exist_ok=True)
    if shutil.disk_usage(os.path.dirname(p)).free < size + (2 << 30):
        raise ValueError('not enough space for the update')
    h = hashlib.sha256()
    n = 0
    with up.blob(repo, digest) as r, open(p + '.part', 'wb') as f:
        while True:
            b = r.read(CHUNK)
            if not b:
                break
            h.update(b)
            f.write(b)
            n += len(b)
    if 'sha256:' + h.hexdigest() != digest or (size and n != size):
        os.remove(p + '.part')
        raise ValueError(f'{digest[:19]} did not arrive right')
    os.replace(p + '.part', p)
    return n


def pick_platform(index):
    for m in index.get('manifests', []):
        pl = m.get('platform') or {}
        if pl.get('os') == 'linux' and pl.get('architecture') == 'amd64':
            return m
    raise ValueError('no linux/amd64 image')


def gc(d, refs):
    keep = set()
    for e in refs.values():
        keep.update(e.get('keep', []))
        keep.update(e.get('previous', []))
    folder = os.path.join(d, 'blobs', 'sha256')
    for name in os.listdir(folder) if os.path.isdir(folder) else []:
        p = os.path.join(folder, name)
        if name.endswith('.part'):
            if time.time() - os.path.getmtime(p) > 86400:
                os.remove(p)
        elif 'sha256:' + name not in keep:
            os.remove(p)


def fetch(ref, d, up=None):
    parsed = parse_ref(ref)
    if not parsed:
        raise ValueError('not a Hearth OS image')
    repo, tag = parsed
    up = up or Upstream()
    _, h, body = up.manifest(repo, tag)
    tag_digest = h.get('docker-content-digest') or sha256(body)
    if sha256(body) != tag_digest:
        raise ValueError('the registry sent a manifest that does not match its digest')
    os.makedirs(d, exist_ok=True)
    store_bytes(d, tag_digest, body)
    keep = [tag_digest]
    m = json.loads(body)
    manifest_digest = tag_digest
    if m.get('mediaType') in INDEX_TYPES or 'manifests' in m:
        desc = pick_platform(m)
        _, _, body = up.manifest(repo, desc['digest'])
        if sha256(body) != desc['digest']:
            raise ValueError('the registry sent a manifest that does not match its digest')
        manifest_digest = desc['digest']
        store_bytes(d, manifest_digest, body)
        keep.append(manifest_digest)
        m = json.loads(body)
    pieces = [m['config']] + list(m.get('layers', []))
    total = sum(int(p.get('size') or 0) for p in pieces)
    got = 0
    for p in pieces:
        got += download(up, repo, d, p)
        keep.append(p['digest'])
    version = ''
    try:
        with open(blob_path(d, m['config']['digest'])) as f:
            labels = (json.load(f).get('config') or {}).get('Labels') or {}
        version = labels.get('org.opencontainers.image.version', '')
    except (OSError, ValueError, AttributeError):
        pass
    rp = os.path.join(d, 'refs.json')
    try:
        with open(rp) as f:
            refs = json.load(f)
    except (OSError, ValueError):
        refs = {}
    old = refs.get(ref) or {}
    prev = old.get('previous', []) if old.get('digest') == tag_digest else old.get('keep', [])
    refs[ref] = {'digest': tag_digest, 'manifest': manifest_digest, 'version': version, 'at': int(time.time()), 'bytes': total,
                 'keep': keep, 'previous': prev}
    with open(rp + '.part', 'w') as f:
        json.dump(refs, f)
    os.replace(rp + '.part', rp)
    gc(d, refs)
    return {'ok': True, 'digest': tag_digest, 'manifest': manifest_digest, 'version': version, 'bytes': total, 'downloaded': got}


def cmd_fetch(ref, d):
    try:
        out = fetch(ref, d)
    except Exception as e:
        out = {'ok': False, 'error': str(e)}
    print(json.dumps(out), flush=True)
    return 0 if out['ok'] else 1


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    if cmd == 'serve':
        return cmd_serve()
    if cmd == 'may-stage':
        try:
            return may_stage()
        except Exception as e:  # never in the way of updating
            log(f'may-stage: {e}')
            return 0
    if cmd == 'fetch' and len(argv) == 4:
        return cmd_fetch(argv[2], argv[3])
    print('usage: hearth-update-mirror serve|may-stage|fetch REF DIR', file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv))
