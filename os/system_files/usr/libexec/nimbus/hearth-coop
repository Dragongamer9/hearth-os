class Runner:
    """Every program this helper starts goes through here, so tests can swap in a fake."""

    def which(self, name):
        return shutil.which(name)

    def run(self, argv, env=None, timeout=20, cwd=None):
        try:
            p = subprocess.run(argv, env=env, cwd=cwd, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                               timeout=timeout)
            return p.returncode, p.stdout, p.stderr
        except (OSError, subprocess.TimeoutExpired) as e:
            return 127, '', str(e)

    def spawn(self, argv, env=None, cwd=None, log=None):
        out = open(log, 'ab') if log else subprocess.DEVNULL
        try:
            p = subprocess.Popen(argv, env=env, cwd=cwd, stdin=subprocess.DEVNULL, stdout=out, stderr=out,
                                 start_new_session=True)
        finally:
            if log:
                out.close()
        return p.pid

    def alive(self, pid):
        if not pid:
            return False
        try:
            os.kill(pid, 0)
        except ProcessLookupError:
            return False
        except PermissionError:
            return True
        try:
            with open('/proc/%d/stat' % pid) as f:
                return f.read().rsplit(')', 1)[1].split()[0] != 'Z'
        except (OSError, IndexError):
            return True

    def killpg(self, pgid, sig):
        try:
            os.killpg(pgid, sig)
            return True
        except (ProcessLookupError, PermissionError):
            return False

    def kill(self, pid, sig):
        try:
            os.kill(pid, sig)
            return True
        except (ProcessLookupError, PermissionError):
            return False

    def reap(self):
        """Collects finished children (the container's instances), so they don't linger as zombies."""
        try:
            while True:
                pid, _ = os.waitpid(-1, os.WNOHANG)
                if pid == 0:
                    return
        except ChildProcessError:
            return


class Ctx:
    def __init__(self, env=None, sys_root='/sys', proc_root='/proc', dev_root='/dev', runner=None, sleep=time.sleep,
                 urlopen=urllib.request.urlopen, out=None, now=time.time, self_path=None, run_udev='/run/udev'):
        self.env = dict(os.environ if env is None else env)
        self.sys_root, self.proc_root, self.dev_root, self.run_udev = sys_root, proc_root, dev_root, run_udev
        self.runner = runner or Runner()
        self.sleep, self.urlopen, self.now = sleep, urlopen, now
        self.out = out or sys.stdout
        self.self_path = self_path or os.path.realpath(sys.argv[0] if sys.argv and sys.argv[0] else __file__)

    @property
    def home(self):
        return self.env.get('HOME') or os.path.expanduser('~')

    @property
    def data_dir(self):
        return os.path.join(self.env.get('XDG_DATA_HOME') or os.path.join(self.home, '.local', 'share'), 'nimbus')

    @property
    def coop_dir(self):
        return os.path.join(self.data_dir, 'coop')

    @property
    def runtime_dir(self):
        return self.env.get('XDG_RUNTIME_DIR') or '/tmp'

    @property
    def session_file(self):
        return os.path.join(self.runtime_dir, 'hearth-coop.json')

    @property
    def last_file(self):
        """How the last session ended when it failed (the session file itself is gone by then)."""
        return os.path.join(self.runtime_dir, 'hearth-coop-last.json')

    @property
    def pads_log(self):
        """What the "press A" listener saw and why it left each controller out (in bug reports)."""
        return os.path.join(self.data_dir, 'multiplay.log')

    def note(self, what):
        try:
            os.makedirs(os.path.dirname(self.pads_log), exist_ok=True)
            if os.path.exists(self.pads_log) and os.path.getsize(self.pads_log) > 256 * 1024:
                os.replace(self.pads_log, self.pads_log + '.old')
            with open(self.pads_log, 'a') as f:
                f.write('%s coop: %s\n' % (time.strftime('%Y-%m-%d %H:%M:%S'), what))
        except OSError:
            pass

    def progress(self, n, text):
        print('progress: %d %s' % (max(0, min(100, int(n))), text), file=self.out, flush=True)

    def emit(self, obj):
        print(json.dumps(obj), file=self.out, flush=True)


# ---------------------------------------------------------------------- small helpers

def read(path, default=''):
    try:
        with open(path, errors='replace') as f:
            return f.read()
    except OSError:
        return default


def read_json(path, default=None):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def write_json(path, obj):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.tmp%d' % os.getpid()
    with open(tmp, 'w') as f:
        json.dump(obj, f, indent=1)
    os.replace(tmp, path)


def safe_name(s):
    return re.sub(r'[^A-Za-z0-9._-]', '_', s)[:120] or 'game'


def norm(s):
    return re.sub(r'[^a-z0-9]', '', (s or '').lower())


def vdf_parse(text):
    """Valve's KeyValues text format, enough for appmanifest and libraryfolders."""
    tokens = re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', text)
    root, stack, key = {}, [], None
    cur = root
    for s, brace in tokens:
        if brace == '{':
            new = {}
            if key is not None:
                cur[key] = new
            stack.append(cur)
            cur, key = new, None
        elif brace == '}':
            cur = stack.pop() if stack else root
            key = None
        elif key is None:
            key = s.replace('\\\\', '\\')
        else:
            cur[key] = s.replace('\\\\', '\\')
            key = None
    return root


def lower_keys(d):
    return {k.lower(): (lower_keys(v) if isinstance(v, dict) else v) for k, v in d.items()} if isinstance(d, dict) else d


def head_bytes(path, n=4096):
    try:
        with open(path, 'rb') as f:
            return f.read(n)
    except OSError:
        return b''


def elf_bits(path):
    """32 or 64 for an ELF file, else None."""
    h = head_bytes(path, 5)
    return {1: 32, 2: 64}.get(h[4]) if len(h) == 5 and h[:4] == b'\x7fELF' else None


def pe_info(path):
    """(bits, [section names]) for a Windows exe/dll, or (None, [])."""
    try:
        with open(path, 'rb') as f:
            mz = f.read(64)
            if len(mz) < 64 or mz[:2] != b'MZ':
                return None, []
            off = struct.unpack_from('<I', mz, 0x3c)[0]
            f.seek(off)
            hdr = f.read(24)
            if len(hdr) < 24 or hdr[:4] != b'PE\0\0':
                return None, []
            machine, nsec = struct.unpack_from('<HH', hdr, 4)
            opt_size = struct.unpack_from('<H', hdr, 20)[0]
            f.seek(off + 24 + opt_size)
            names = []
            for _ in range(min(nsec, 96)):
                sec = f.read(40)
                if len(sec) < 40:
                    break
                names.append(sec[:8].rstrip(b'\0').decode('latin-1'))
            return {0x8664: 64, 0xaa64: 64, 0x14c: 32}.get(machine), names
    except (OSError, struct.error):
        return None, []


# ---------------------------------------------------------------------- controllers

def parse_bits(s):
    """A /proc/bus/input/devices bitmap ("7cdb000000000000 0 0 0 0", most significant word first) as a set."""
    out = set()
    words = s.split()
    for i, w in enumerate(reversed(words)):
        try:
            v = int(w, 16)
        except ValueError:
            continue
        b = 0
        while v:
            if v & 1:
                out.add(i * 64 + b)
            v >>= 1
            b += 1
    return out


def parse_input_devices(text):
    devs = []
    for block in re.split(r'\n\s*\n', text.strip()):
        d = {'handlers': [], 'bits': {}}
        for line in block.splitlines():
            if len(line) < 3 or line[1] != ':':
                continue
            tag, rest = line[0], line[3:].strip()
            if tag == 'I':
                for kv in rest.split():
                    if '=' in kv:
                        k, v = kv.split('=', 1)
                        d[k.lower()] = v.lower()
            elif tag == 'N':
                d['name'] = rest.split('=', 1)[1].strip('"') if '=' in rest else rest
            elif tag in 'PSU' and '=' in rest:
                k, v = rest.split('=', 1)
                d[{'P': 'phys', 'S': 'sysfs', 'U': 'uniq'}[tag]] = v
            elif tag == 'H':
                d['handlers'] = rest.split('=', 1)[1].split() if '=' in rest else []
            elif tag == 'B' and '=' in rest:
                k, v = rest.split('=', 1)
                d['bits'][k] = parse_bits(v)
        if d.get('name') is not None:
            devs.append(d)
    return devs


def is_gamepad(d):
    name = d.get('name', '').lower()
    if any(w in name for w in ('motion sensor', 'touchpad', ' imu', 'accelerometer', 'gyro')):
        return False
    if INPUT_PROP_ACCELEROMETER in d['bits'].get('PROP', set()):
        return False
    keys = d['bits'].get('KEY', set())
    ev = d['bits'].get('EV', set())
    has_buttons = BTN_SOUTH in keys or BTN_TRIGGER in keys
    return (EV_ABS in ev and has_buttons) or any(h.startswith('js') for h in d['handlers'])


def is_keyboard(d):
    keys = d['bits'].get('KEY', set())
    return EV_KEY in d['bits'].get('EV', set()) and all(k in keys for k in (16, 30, 44, 28)) and not is_gamepad(d)


def is_mouse(d):
    rel = d['bits'].get('REL', set())
    return EV_REL in d['bits'].get('EV', set()) and 0 in rel and 1 in rel and BTN_LEFT in d['bits'].get('KEY', set())


def inputplumber_running(ctx):
    try:
        names = os.listdir(ctx.proc_root)
    except OSError:
        return False
    for n in names:
        if n.isdigit() and read(os.path.join(ctx.proc_root, n, 'comm')).strip() == 'inputplumber':
            return True
    return False


def _hid_parent(ctx, d):
    p = os.path.join(ctx.sys_root, d.get('sysfs', '').lstrip('/'), 'device')
    return os.path.realpath(p) if os.path.exists(p) else None


def _hidraw(ctx, d):
    p = os.path.join(ctx.sys_root, d.get('sysfs', '').lstrip('/'), 'device', 'hidraw')
    try:
        return sorted('/dev/' + n for n in os.listdir(p) if n.startswith('hidraw'))
    except OSError:
        return []


def _usable_node(ctx, node):
    """Can this user open /dev/input/<node>? InputPlumber hides the controllers it manages (moves or locks them)."""
    p = os.path.join(ctx.dev_root, 'input', node)
    return os.path.exists(p) and os.access(p, os.R_OK)


def list_pads(ctx):
    """Controllers, keyboards and mice. Heuristic for InputPlumber (documented in COUCH-COOP.md):
      * a gamepad under /devices/virtual/ with no Phys, while InputPlumber runs and named like one of its targets
        (Xbox 360 / Xbox / DualSense / Steam Deck pads, or "InputPlumber..."), is InputPlumber's
        virtual controller: that's what games should get, so it is a usable pad (kind "inputplumber");
      * a physical gamepad whose event node InputPlumber has hidden (gone from /dev/input, unreadable, or listed in
        /dev/inputplumber/sources) is "managed": it is listed under "hidden", not handed to games (its input
        already reaches the virtual pad);
      * any other physical gamepad is used as it is (kind "physical"); other virtual pads are kind "virtual".
    """
    text = read(os.path.join(ctx.proc_root, 'bus', 'input', 'devices'))
    devs = parse_input_devices(text)
    ip = inputplumber_running(ctx)
    ip_sources = set()
    try:
        ip_sources = set(os.listdir(os.path.join(ctx.dev_root, 'inputplumber', 'sources')))
    except OSError:
        pass
    parents = {}
    for d in devs:
        par = _hid_parent(ctx, d)
        if par:
            parents.setdefault(par, []).append(d)
    pads, hidden, keyboards, mice = [], [], [], []
    for d in devs:
        event = next((h for h in d['handlers'] if re.match(r'^event\d+$', h)), None)
        if not event:
            continue
        if is_gamepad(d):
            js = next((h for h in d['handlers'] if re.match(r'^js\d+$', h)), None)
            # uinput/uhid devices live under /devices/virtual; Bluetooth LE pads do too (bluez uses uhid) but have a
            # Phys (the adapter's address), which InputPlumber's targets don't.
            virtual = d.get('sysfs', '').startswith('/devices/virtual/') and not d.get('phys')
            name = d.get('name', 'Controller')
            if virtual:
                kind = 'inputplumber' if (name.startswith('InputPlumber') or (ip and name.startswith(IP_TARGET_NAMES))) else 'virtual'
            else:
                kind = 'physical'
            nodes = ['/dev/input/' + event] + (['/dev/input/' + js] if js else [])
            extra = []
            par = _hid_parent(ctx, d)
            for sib in parents.get(par, []) if par else []:
                if sib is d:
                    continue
                for h in sib['handlers']:
                    if re.match(r'^event\d+$', h):
                        extra.append('/dev/input/' + h)
            pad = {'id': event, 'name': name, 'kind': kind,
                   'label': name + (' (InputPlumber)' if kind == 'inputplumber' else ''),
                   'vendor': d.get('vendor', ''), 'product': d.get('product', ''), 'bus': d.get('bus', ''),
                   'uniq': d.get('uniq', ''), 'event': '/dev/input/' + event, 'js': ('/dev/input/' + js) if js else None,
                   'hidraw': _hidraw(ctx, d), 'extra': sorted(extra), 'nodes': nodes}
            managed = kind == 'physical' and ip and (event in ip_sources or not _usable_node(ctx, event))
            if managed:
                pad['managedBy'] = 'inputplumber'
                pad['why'] = 'InputPlumber manages it (its own virtual controller is used instead).'
                hidden.append(pad)
            elif not _usable_node(ctx, event):
                pad['why'] = "Hearth can't read this controller (no permission)."
                hidden.append(pad)
            else:
                pads.append(pad)
        elif is_keyboard(d):
            keyboards.append({'id': event, 'name': d.get('name', ''), 'event': '/dev/input/' + event})
        elif is_mouse(d):
            mice.append({'id': event, 'name': d.get('name', ''), 'event': '/dev/input/' + event})
    key = lambda p: int(re.sub(r'\D', '', p['id']) or 0)
    return {'pads': sorted(pads, key=key), 'hidden': sorted(hidden, key=key), 'keyboards': keyboards, 'mice': mice,
            'inputplumber': ip}


def wait_button(ctx, timeout=10.0, exclude=()):
    """The first controller (from list_pads) on which a face button / trigger button goes down. What it saw, and
    why it left each controller out, goes to multiplay.log (in bug reports)."""
    found = list_pads(ctx)
    fds, seen, taken, refused = {}, [], 0, 0
    for p in found['pads']:
        label = '%s (%s, %s)' % (p['name'], p['id'], p['kind'])
        if p['id'] in exclude:
            taken += 1
            seen.append(label + ': left out, already joined')
            continue
        try:
            fds[os.open(os.path.join(ctx.dev_root, 'input', p['id']), os.O_RDONLY | os.O_NONBLOCK)] = p
            seen.append(label + ': listening')
        except OSError as e:
            refused += 1
            seen.append(label + ': left out, can\'t open it (%s)' % (e.strerror or e))
    for p in found['hidden']:
        seen.append('%s (%s): left out, %s' % (p['name'], p['id'], p.get('why') or 'hidden'))
    ctx.note('wait-button: ' + ('; '.join(seen) if seen else 'no input device looks like a controller'))
    if not fds:
        # Controllers InputPlumber manages are fine (their input reaches its virtual pad); the others in "hidden"
        # can't be read.
        unusable = [p for p in found['hidden'] if not p.get('managedBy')]
        if taken and not refused and not unusable:
            raise Fail('Every connected controller has already joined. Connect another controller for the next '
                       'player and try again.')
        if refused or unusable:
            why = next((p.get('why') for p in unusable if p.get('why')), None)
            raise Fail('Hearth can\'t use the connected controllers%s. Reconnect them and try again.'
                       % (' (%s)' % why.rstrip('.') if why else ''))
        raise Fail('No controllers to listen to. Connect a controller and try again.')
    bufs = {fd: b'' for fd in fds}
    end = ctx.now() + timeout
    try:
        while True:
            left = end - ctx.now()
            if left <= 0:
                ctx.note('wait-button: no button pressed in %g s' % timeout)
                return None
            ready, _, _ = select.select(list(fds), [], [], min(left, 0.5))
            for fd in ready:
                try:
                    chunk = os.read(fd, EVENT.size * 64)
                except BlockingIOError:
                    continue
                except OSError:
                    chunk = b''
                if not chunk:
                    continue
                bufs[fd] += chunk
                while len(bufs[fd]) >= EVENT.size:
                    _, _, typ, code, value = EVENT.unpack_from(bufs[fd])
                    bufs[fd] = bufs[fd][EVENT.size:]
                    if typ == EV_KEY and value == 1 and (BTN_TRIGGER <= code <= 0x13e):
                        ctx.note('wait-button: %s (%s) pressed a button' % (fds[fd]['name'], fds[fd]['id']))
                        return fds[fd]
    finally:
        for fd in fds:
            try:
                os.close(fd)
            except OSError:
                pass


