              '.var/app/com.valvesoftware.Steam/data/Steam']:
        full = os.path.join(home, p)
        if os.path.isdir(os.path.join(full, 'steamapps')):
            return os.path.realpath(full)
    return None


def steam_libraries(steam):
    out = [steam]
    kv = lower_keys(vdf_parse(read(os.path.join(steam, 'steamapps', 'libraryfolders.vdf'))))
    for _, e in (kv.get('libraryfolders') or {}).items():
        p = e.get('path') if isinstance(e, dict) else e
        if p and os.path.isdir(p):
            rp = os.path.realpath(p)
            if rp not in out:
                out.append(rp)
    return out


def steam_games(home):
    steam = steam_root(home)
    if not steam:
        return []
    games = []
    for lib in steam_libraries(steam):
        apps = os.path.join(lib, 'steamapps')
        try:
            names = sorted(os.listdir(apps))
        except OSError:
            continue
        for n in names:
            if not (n.startswith('appmanifest_') and n.endswith('.acf')):
                continue
            st = lower_keys(vdf_parse(read(os.path.join(apps, n)))).get('appstate') or {}
            app, title, inst = st.get('appid', ''), (st.get('name') or '').strip(), st.get('installdir', '')
            if not app or not title or not inst or app in SKIP_APPS or title.lower().startswith(SKIP_NAMES):
                continue
            try:
                flags = int(st.get('stateflags', '0'))
            except ValueError:
                flags = 0
            d = os.path.join(apps, 'common', inst)
            if not flags & 4 or not os.path.isdir(d):
                continue
            games.append({'id': 'steam:' + app, 'title': title, 'source': 'steam', 'installDir': d, 'exe': None,
                          'args': '', 'steamAppId': app})
    return games


def epic_games(ctx):
    recs = read_json(os.path.join(ctx.data_dir, 'legendary', 'installed.json'), {}) or {}
    out = []
    for app, e in recs.items():
        if not isinstance(e, dict) or e.get('is_dlc') or not e.get('install_path') or not os.path.isdir(e['install_path']):
            continue
        exe = os.path.join(e['install_path'], e['executable'].replace('\\', '/')) if e.get('executable') else None
        out.append({'id': 'epic:' + app, 'title': e.get('title') or app, 'source': 'epic', 'installDir': e['install_path'],
                    'exe': exe, 'args': e.get('launch_parameters') or '', 'steamAppId': None})
    return out


def gog_games(library):
    out = []
    for gid, d in (library.get('gogInstalls') or {}).items():
        if not isinstance(d, str):
            continue
        info = read_json(os.path.join(d, 'goggame-%s.info' % gid))
        if not info:
            continue
        tasks = info.get('playTasks') or []
        task = next((t for t in tasks if t.get('isPrimary')), None) or next((t for t in tasks if t.get('type') == 'FileTask'), None)
        if not task or not task.get('path'):
            continue
        out.append({'id': 'gog:' + gid, 'title': info.get('name') or gid, 'source': 'gog', 'installDir': d,
                    'exe': os.path.join(d, task['path'].replace('\\', '/')), 'args': task.get('arguments') or '',
                    'workDir': os.path.join(d, task['workingDir'].replace('\\', '/')) if task.get('workingDir') else None,
                    'steamAppId': None})
    return out


def manual_games(library):
    out = []
    for m in library.get('manual') or []:
        if not isinstance(m, dict) or not m.get('id') or not m.get('path'):
            continue
        out.append({'id': m['id'], 'title': m.get('title') or 'Game', 'source': 'manual',
                    'installDir': os.path.dirname(m['path']), 'exe': m['path'], 'args': m.get('args') or '',
                    'steamAppId': None})
    return out


def scan_tree(root, max_depth=5, max_entries=30000):
    """[(relative path, is_dir)], breadth-limited: enough to find exes, steam_api and anti-cheat quickly."""
    out, todo = [], [('', 0)]
    while todo and len(out) < max_entries:
        rel, depth = todo.pop(0)
        try:
            it = sorted(os.scandir(os.path.join(root, rel)), key=lambda e: e.name)
        except OSError:
            continue
        for e in it:
            r = os.path.join(rel, e.name) if rel else e.name
            try:
                is_dir = e.is_dir(follow_symlinks=False)
            except OSError:
                continue
            out.append((r, is_dir))
            if is_dir and depth + 1 < max_depth:
                todo.append((r, depth + 1))
    return out


def anti_cheat(tree):
    found = []
    for rel, _ in tree:
        base = os.path.basename(rel).lower()
        for rx, label in ANTI_CHEAT:
            if rx.search(base) and label not in found:
                found.append(label)
    return found


def exe_score(rel, title, size):
    base = os.path.basename(rel).lower()
    stem = re.sub(r'\.(exe|x86_64|x86|sh|bin|elf)$', '', base)
    score = 0
    if BAD_EXE.search(stem):
        score -= 100
    t, s = norm(title), norm(stem.replace('-win64-shipping', '').replace('-linux-shipping', ''))
    if s and t and (s in t or t in s):
        score += 50
    elif s and t and any(len(w) > 3 and w in s for w in re.findall(r'[a-z0-9]+', (title or '').lower())):
        score += 20
    if 'shipping' in base:
        score += 30
    if 'launcher' in base:
        score -= 20
    if 'binaries/win64' in rel.lower() or 'binaries/linux' in rel.lower():
        score += 15
    score -= 5 * rel.count('/')
    score += min(30, size // (20 * 1024 * 1024))
    return score


def guess_exe(root, tree, title):
    """(path, 'native'|'windows') of the most likely game program in a folder, or (None, None)."""
    native, win = [], []
    for rel, is_dir in tree:
        if is_dir:
            continue
        full = os.path.join(root, rel)
        low = rel.lower()
        if low.endswith('.exe'):
            win.append(rel)
        elif not low.endswith(('.so', '.dll', '.txt', '.json', '.ini', '.cfg', '.pak', '.dat')) and '.so.' not in low:
            if (low.endswith(('.x86_64', '.x86')) or elf_bits(full)) and os.access(full, os.X_OK):
                native.append(rel)

    def best(lst):
        scored = []
        for r in lst:
            try:
                size = os.path.getsize(os.path.join(root, r))
            except OSError:
                size = 0
            scored.append((exe_score(r, title, size), r))
        scored.sort(key=lambda x: (-x[0], x[1]))
        return scored[0] if scored and scored[0][0] > -50 else None
    bn, bw = best(native), best(win)
    if bn:
        return os.path.join(root, bn[1]), 'native'
    if bw:
        return os.path.join(root, bw[1]), 'windows'
    return None, None


def broad_dirs(home):
    return {os.path.realpath(p) for p in ('/', '/usr', '/usr/bin', '/usr/local/bin', '/bin', '/opt', '/home', '/var/home',
                                          '/tmp', home or '/', os.path.join(home or '/', 'Desktop'),
                                          os.path.join(home or '/', 'Downloads'))}


def analyze(game, exe_override=None, home=None):
    """How a game would run in Couch Co-op, and whether it can."""
    g = dict(game)
    root = g['installDir']
    tree = [] if os.path.realpath(root) in broad_dirs(home) else scan_tree(root)
    g['antiCheat'] = anti_cheat(tree)
    g['steamApi'] = [rel for rel, d in tree if not d and os.path.basename(rel).lower() in STEAM_API]
    exe = exe_override or g.get('exe')
    guessed = False
    if not exe:
        exe, _ = guess_exe(root, tree, g['title'])
        guessed = bool(exe)
    g['exe'], g['exeGuessed'] = exe, guessed
    notes = []
    why = None
    if exe and exe.lower().endswith('.exe'):
        g['run'] = 'windows'
    elif exe and exe.lower().endswith('.desktop'):
        g['run'] = None
        why = "This game starts through a shortcut (.desktop), which Couch Co-op can't split. Add the game's program instead."
    elif exe:
        g['run'] = 'native'
    else:
        g['run'] = None
        why = "Couch Co-op couldn't find the game's program in its folder."
    if exe and not why and not os.path.isfile(exe):
        why = "The game's program is missing (%s). Is it still installed?" % os.path.basename(exe)
    if exe and not why and os.path.realpath(root) in broad_dirs(home):
        why = ("This game's program sits in a shared folder (%s), so Couch Co-op can't give each player their own "
               "copy. Move the game into a folder of its own.") % root
    g['launcher'] = {'windows': 'umu', 'native': 'direct'}.get(g['run'])
    g['needsSteam'] = bool(g['steamApi'])
    appid = g.get('steamAppId')
    if not appid:
        for rel, d in tree:
            if not d and os.path.basename(rel).lower() == 'steam_appid.txt':
                appid = read(os.path.join(root, rel)).strip() or None
                break
    g['steamAppId'] = appid if appid and appid.isdigit() else None
    g['usesGoldberg'] = g['needsSteam'] and bool(g['steamAppId'])
    if g['needsSteam'] and not g['steamAppId']:
        notes.append("It uses Steam's API but Hearth doesn't know its Steam app id, so it may not start.")
    drm = None
    if exe and g['run'] == 'windows' and os.path.isfile(exe):
        _, secs = pe_info(exe)
        if '.bind' in secs:
            drm = 'steamstub'
    g['drm'] = drm
    if g['antiCheat'] and not why:
        why = ("%s uses anti-cheat (%s), which blocks running several copies at once and blocks the Steam emulator. "
               "It can't be played in Couch Co-op.") % (g['title'], ', '.join(g['antiCheat']))
    if drm and not why:
        why = ("%s is wrapped in Steam's copy protection (SteamStub), so it only starts through Steam itself. "
               "It can't be played in Couch Co-op.") % g['title']
    if g['source'] == 'epic':
        notes.append("Epic games that need Epic's online services (most online multiplayer) won't see each other.")
    if g['source'] == 'gog':
        notes.append("GOG Galaxy multiplayer doesn't work here; games with LAN play do.")
    if g['source'] == 'steam' and not g['needsSteam']:
        notes.append("This Steam game doesn't use Steam's API; it needs its own LAN play to connect the copies.")
    if g['usesGoldberg']:
        notes.append('Steam multiplayer is emulated over LAN between the copies (Goldberg).')
    g['canPlay'] = why is None
    g['why'] = why
    g['notes'] = notes
    return g


def library_json(ctx):
    return read_json(os.path.join(ctx.data_dir, 'library.json'), {}) or {}


def all_games(ctx):
    lib = library_json(ctx)
    seen, out = set(), []
    for g in steam_games(ctx.home) + epic_games(ctx) + gog_games(lib) + manual_games(lib):
        if g['id'] in seen:
            continue
        seen.add(g['id'])
        out.append(g)
    return out


def find_game(ctx, gid):
    for g in all_games(ctx):
        if g['id'] == gid:
            return g
    raise Fail("Couch Co-op can't find that game (%s). It may have been uninstalled." % gid)


