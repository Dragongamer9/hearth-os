def profiles(ctx):
    data = read_json(os.path.join(ctx.coop_dir, 'profiles.json'), {}) or {}
    saved = {p.get('seat'): p for p in data.get('players', []) if isinstance(p, dict)}
    own = (library_json(ctx).get('profile') or {}).get('name')
    out = []
    for seat in range(1, 5):
        default = own if (seat == 1 and own) else 'Player %d' % seat
        out.append({'seat': seat, 'name': (saved.get(seat) or {}).get('name') or default})
    return out


def clean_name(name):
    name = re.sub(r'[\x00-\x1f\x7f\[\]=;"\\]', '', name or '').strip()[:32]
    if not name:
        raise Fail('Type a name for the player.')
    return name


def profile_set(ctx, seat, name):
    if seat not in (1, 2, 3, 4):
        raise Fail('Seats are 1 to 4.')
    players = profiles(ctx)
    players[seat - 1]['name'] = clean_name(name)
    write_json(os.path.join(ctx.coop_dir, 'profiles.json'), {'players': players})
    return players


# ---------------------------------------------------------------------- layout

def screen_size(ctx, width=None, height=None):
    if width and height:
        return int(width), int(height)
    env = dict(ctx.env)
    if env.get('DISPLAY'):
        rc, out, _ = ctx.runner.run(['xrandr', '--current'], env=env, timeout=5)
        m = re.search(r'current (\d+) x (\d+)', out or '') if rc == 0 else None
        if m:
            return int(m.group(1)), int(m.group(2))
        rc, out, _ = ctx.runner.run(['xdpyinfo'], env=env, timeout=5)
        m = re.search(r'dimensions:\s+(\d+)x(\d+)', out or '') if rc == 0 else None
        if m:
            return int(m.group(1)), int(m.group(2))
    return 1280, 800


def even(n):
    return max(2, int(n) // 2 * 2)


def layout_rects(w, h, n, layout='auto'):
    """[{x, y, w, h}] per player. Sizes are even (gamescope likes that); 3 players use the 2x2 grid with a gap."""
    if n < 1 or n > 4:
        raise Fail('Couch Co-op is for 2 to 4 players.')
    if n == 1:
        return [{'x': 0, 'y': 0, 'w': even(w), 'h': even(h)}]
    if layout not in ('auto', 'vertical', 'horizontal', 'grid'):
        raise Fail('Unknown layout %r (use auto, vertical, horizontal or grid).' % layout)
    if n == 2 and layout != 'grid':
        side = layout == 'vertical' or (layout == 'auto' and w / float(h) >= 1.6 - 1e-9)
        if side:
            cw = even(w / 2)
            return [{'x': 0, 'y': 0, 'w': cw, 'h': even(h)}, {'x': cw, 'y': 0, 'w': cw, 'h': even(h)}]
        ch = even(h / 2)
        return [{'x': 0, 'y': 0, 'w': even(w), 'h': ch}, {'x': 0, 'y': ch, 'w': even(w), 'h': ch}]
    if n > 2 and layout in ('vertical', 'horizontal'):
        if layout == 'vertical':
            cw = even(w / n)
            return [{'x': i * cw, 'y': 0, 'w': cw, 'h': even(h)} for i in range(n)]
        ch = even(h / n)
        return [{'x': 0, 'y': i * ch, 'w': even(w), 'h': ch} for i in range(n)]
    cw, ch = even(w / 2), even(h / 2)
    cells = [(0, 0), (cw, 0), (0, ch), (cw, ch)]
    return [{'x': x, 'y': y, 'w': cw, 'h': ch} for x, y in cells[:n]]


# ---------------------------------------------------------------------- per-player data

def player_dir(ctx, seat):
    return os.path.join(ctx.coop_dir, 'players', str(seat))


def prepare_home(ctx, seat):
    """A HOME of the player's own; shared tools (Steam, umu, Proton, Vulkan layers, fonts) link back to the real one."""
    home = os.path.join(player_dir(ctx, seat), 'home')
    for sub in ('.local/share', '.config', '.cache', '.local/state', 'Documents'):
        os.makedirs(os.path.join(home, sub), exist_ok=True)
    real = ctx.home
    for rel in HOME_LINKS:
        src, dst = os.path.join(real, rel), os.path.join(home, rel)
        if not os.path.exists(src) or os.path.lexists(dst):
            continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        os.symlink(src, dst)
    return home


def build_farm(src, dst):
    """A per-player view of the game folder made of folders and symlinks (used when fuse-overlayfs is missing).
    New files land in the view; existing files stay the originals' (read-only inside the sandbox)."""
    for dp, dirs, files in os.walk(src):
        rel = os.path.relpath(dp, src)
        out = dst if rel == '.' else os.path.join(dst, rel)
        os.makedirs(out, exist_ok=True)
        for f in files:
            t = os.path.join(out, f)
            if not os.path.lexists(t):
                os.symlink(os.path.join(dp, f), t)


def real_copy(link):
    if os.path.islink(link):
        src = os.path.realpath(link)
        os.unlink(link)
        shutil.copy2(src, link)


def mount_view(ctx, seat, game):
    """The folder the player's copy runs from: a fuse-overlayfs over the real install (writes go to the player's
    own layer), else a symlink view. Returns {'kind', 'path', 'mounted'}."""
    base = os.path.join(player_dir(ctx, seat), 'games', safe_name(game['id']))
    src = game['installDir']
    fo = ctx.runner.which('fuse-overlayfs')
    if fo:
        upper, work, merged = (os.path.join(base, n) for n in ('upper', 'work', 'merged'))
        for d in (upper, work, merged):
            os.makedirs(d, exist_ok=True)
        unmount(ctx, merged, quiet=True)
        esc = lambda x: x.replace('\\', '\\\\').replace(',', '\\,').replace(':', '\\:')
        opts = 'lowerdir=%s,upperdir=%s,workdir=%s' % (esc(src), esc(upper), esc(work))
        rc, _, err = ctx.runner.run([fo, '-o', opts, merged], timeout=30)
        if rc == 0:
            return {'kind': 'overlay', 'path': merged, 'mounted': True}
        sys.stderr.write('hearth-coop: fuse-overlayfs failed (%s); using a symlink view\n' % err.strip())
    view = os.path.join(base, 'view')
    build_farm(src, view)
    return {'kind': 'symlinks', 'path': view, 'mounted': False}


def unmount(ctx, path, quiet=False):
    fm = ctx.runner.which('fusermount3') or ctx.runner.which('fusermount')
    for argv in ([fm, '-u', '-z', path] if fm else None, ['umount', '-l', path]):
        if argv and ctx.runner.run(argv, timeout=15)[0] == 0:
            return True
    return False


def swap_steam_api(ctx, view, game, seat, name):
    """Puts the emulator's steam_api in place of every copy in the player's view (never the real install), with
    steam_settings: the player's name, a steam id of their own, LAN only."""
    done = []
    for rel in game['steamApi']:
        target = os.path.join(view, rel)
        base = os.path.basename(rel).lower()
        orig = os.path.join(game['installDir'], rel)
        bits = elf_bits(orig) if base.endswith('.so') else (pe_info(orig)[0] or (64 if '64' in base else 32))
        src = gbe_find(ctx, os.path.basename(rel), bits or 64)
        if not src:
            raise Fail("The Steam emulator download doesn't have %s. Try again after an update." % os.path.basename(rel))
        if os.path.lexists(target):
            os.unlink(target)
        shutil.copy2(src, target)
        write_steam_settings(os.path.join(os.path.dirname(target), 'steam_settings'), game['steamAppId'], seat, name)
        done.append(rel)
    if done and game.get('exe'):
        exe_dir = os.path.join(view, os.path.relpath(os.path.dirname(game['exe']), game['installDir']))
        p = os.path.join(exe_dir, 'steam_appid.txt')
        if os.path.isdir(exe_dir):
            if os.path.lexists(p):
                os.unlink(p)
            with open(p, 'w') as f:
                f.write(game['steamAppId'] + '\n')
    return done


def write_steam_settings(d, appid, seat, name):
    os.makedirs(d, exist_ok=True)
    files = {
        'steam_appid.txt': appid + '\n',
        'configs.user.ini': ('[user::general]\naccount_name=%s\naccount_steamid=%d\nlanguage=english\n'
                             % (name, STEAM_ID64_BASE + SEAT_ACCOUNT_BASE + seat)),
        'configs.main.ini': ('[main::connectivity]\ndisable_lan_only=0\ndisable_networking=0\nlisten_port=%d\noffline=0\n'
                             % GBE_PORT),
        'custom_broadcasts.txt': '127.0.0.1\n',
        # The older Goldberg file names, for builds that still read them.
        'force_account_name.txt': name + '\n',
        'force_steamid.txt': '%d\n' % (STEAM_ID64_BASE + SEAT_ACCOUNT_BASE + seat),
        'force_listen_port.txt': '%d\n' % GBE_PORT,
    }
    for fn, text in files.items():
        p = os.path.join(d, fn)
        if os.path.lexists(p):
            os.unlink(p)
        with open(p, 'w') as f:
            f.write(text)


# ---------------------------------------------------------------------- building the launch

def dev_nodes(ctx):
    """Device folders/nodes the sandbox passes through (GPU, sound, ntsync...)."""
    out = []
    try:
        names = sorted(os.listdir(ctx.dev_root))
    except OSError:
        return out
    for n in names:
        if n in DEV_PASS or n.startswith('nvidia'):
            out.append('/dev/' + n)
    return out


def bwrap_args(ctx, nodes, protect, cwd):
    a = ['bwrap', '--dev-bind', '/', '/', '--dev', '/dev']
    for d in dev_nodes(ctx):
        a += ['--dev-bind', d, d]
    a += ['--dir', '/dev/input']
    for n in nodes:
        a += ['--dev-bind', n, n]
    if os.path.isdir(ctx.run_udev):
        a += ['--tmpfs', '/run/udev']       # libudev then lists no devices: nothing to find the other pads by
    # A /tmp of its own. The nested gamescope's X server (Xwayland, through wlroots) refuses a /tmp/.X11-unix that
    # isn't owned by root or the user, and inside bwrap's user namespace the real one (root's) shows up as owned by
    # "nobody": gamescope then crashed at once (gamescope_xwayland_server_t, a null X server) and the player's
    # window closed. Its lock files (/tmp/.X<n>-lock) would also look stale from inside the new pid namespace and get
    # deleted from under the real X servers. Here, gamescope makes its own /tmp/.X11-unix.
    a += ['--perms', '1777', '--tmpfs', '/tmp']
    for p in protect:
        a += ['--ro-bind', p, p]
    a += ['--unshare-pid', '--die-with-parent', '--chdir', cwd, '--']
    return a


def split_args(s):
    try:
        return shlex.split(s or '')
    except ValueError:
        return (s or '').split()


def plan_player(ctx, seat, name, pad, rect, game, view, home, tools, keyboard_nodes):
    rel_exe = os.path.relpath(game['exe'], game['installDir'])
    exe = os.path.join(view['path'], rel_exe)
    cwd = os.path.dirname(exe)
    if game.get('workDir'):
        cwd = os.path.join(view['path'], os.path.relpath(game['workDir'], game['installDir']))
    args = split_args(game.get('args'))
    env = {k: v for k, v in ctx.env.items() if k not in CONTAINER_UNSET}
    pdir = player_dir(ctx, seat)
    env.update({
        'HOME': home, 'XDG_DATA_HOME': os.path.join(home, '.local/share'), 'XDG_CONFIG_HOME': os.path.join(home, '.config'),
        'XDG_CACHE_HOME': os.path.join(home, '.cache'), 'XDG_STATE_HOME': os.path.join(home, '.local/state'),
        # SDL: scan /dev/input instead of asking udev (udev would list every controller on the PC).
        'SDL_JOYSTICK_DISABLE_UDEV': '1',
        # The nested gamescope opens its window on the nested labwc, with an app id labwc's rules match.
        'SDL_VIDEODRIVER': 'wayland', 'SDL_APP_ID': 'hearth-coop-p%d' % seat,
        'SDL_VIDEO_WAYLAND_WMCLASS': 'hearth-coop-p%d' % seat, 'SDL_VIDEO_X11_WMCLASS': 'hearth-coop-p%d' % seat,
        'HEARTH_COOP_SEAT': str(seat), 'HEARTH_COOP_PLAYER': name,
    })
    env.pop('DISPLAY', None)        # the outer gamescope's X server: not for the nested one
    if game['run'] == 'windows':
        prefix = os.path.join(pdir, 'prefixes', safe_name(game['id']))
        os.makedirs(prefix, exist_ok=True)
        env.update({'WINEPREFIX': prefix, 'PROTONPATH': tools['proton'], 'UMU_RUNTIME_UPDATE': '0',
                    'GAMEID': ('umu-' + game['steamAppId']) if game.get('steamAppId') and game['source'] == 'steam' else '0',
                    'STORE': {'steam': 'steam', 'epic': 'egs', 'gog': 'gog'}.get(game['source'], 'none'),
                    'PROTON_VERB': 'waitforexitandrun'})
        game_cmd = [tools['umu'], exe] + args
    else:
        game_cmd = [exe] + args
    inner = ['env'] + [x for k in GAME_UNSET for x in ('-u', k)] + game_cmd
    gs = ['gamescope'] + (['--backend', 'sdl'] if tools['backend'] else []) + \
         ['-W', str(rect['w']), '-H', str(rect['h']), '-w', str(rect['w']), '-h', str(rect['h']), '--']
    nodes = list(pad['nodes'] if pad else []) + list(pad.get('extra', []) if pad else []) + \
        list(pad.get('hidraw', []) if pad else []) + list(keyboard_nodes)
    protect = [game['installDir']]
    steam = steam_root(ctx.home)
    if steam:
        protect += [p for p in (os.path.join(steam, 'userdata'), os.path.join(steam, 'config')) if os.path.isdir(p)]
    argv = bwrap_args(ctx, nodes, protect, cwd) + gs + inner
    return {'seat': seat, 'name': name, 'pad': pad['id'] if pad else 'kbm', 'padName': pad['name'] if pad else 'Keyboard and mouse',
            'rect': rect, 'appId': 'hearth-coop-p%d' % seat, 'argv': argv, 'env': env, 'cwd': cwd, 'view': view,
            'home': home, 'prefix': env.get('WINEPREFIX'), 'nodes': nodes, 'keyboard': bool(keyboard_nodes),
            'pid': None, 'log': os.path.join(pdir, 'last-run.log')}


def rc_xml(players, slot=None):
    """labwc config for the container: no decorations, no gaps, each player's window placed by its app id; the
    'gamescope*' rule is the fallback for gamescope builds that ignore the app id (rewritten before each launch)."""
    def rule(ident, r):
        return ('    <windowRule identifier="%s" serverDecoration="no" skipTaskbar="yes" ignoreFocusRequest="no">\n'
                '      <action name="SetDecorations" decorations="none" />\n'
                '      <action name="MoveTo" x="%d" y="%d" />\n'
                '      <action name="ResizeTo" width="%d" height="%d" />\n'
                '    </windowRule>\n') % (ident, r['x'], r['y'], r['w'], r['h'])
    rules = ''.join(rule(p['appId'], p['rect']) for p in players)
    if slot is not None:
        rules += rule('gamescope*', slot)
    return ('<?xml version="1.0"?>\n<labwc_config>\n'
            '  <core><decoration>server</decoration><gap>0</gap></core>\n'
            '  <placement><policy>automatic</policy></placement>\n'
            '  <focus><followMouse>no</followMouse><raiseOnFocus>no</raiseOnFocus></focus>\n'
            '  <keyboard>\n    <keybind key="W-Escape"><action name="Exit" /></keybind>\n  </keyboard>\n'
            '  <windowRules>\n%s  </windowRules>\n</labwc_config>\n') % rules


def container_env(ctx):
    env = {k: v for k, v in ctx.env.items() if k not in CONTAINER_UNSET}
    if ctx.env.get('GAMESCOPE_WAYLAND_DISPLAY') and ctx.env.get('DISPLAY'):
        # In Game Mode: one X11 window in gamescope (gamescope's own Wayland socket isn't a full desktop).
        env.pop('WAYLAND_DISPLAY', None)
        env['WLR_BACKENDS'] = 'x11'
    env['WLR_NO_HARDWARE_CURSORS'] = '1'
    return env


# ---------------------------------------------------------------------- session

def load_session(ctx):
    return read_json(ctx.session_file)


def save_session(ctx, s):
    write_json(ctx.session_file, s)


def session_alive(ctx, s):
    if not s:
        return False
    r = ctx.runner
    return r.alive(s.get('labwcPid')) or r.alive(s.get('containerPid')) or any(r.alive(p.get('pid')) for p in s.get('players', []))


def cleanup(ctx, s):
    for p in (s or {}).get('players', []):
        v = p.get('view') or {}
        if v.get('mounted'):
            unmount(ctx, v['path'])
            v['mounted'] = False


def stop_session(ctx, s, grace=5.0):
    r = ctx.runner
    groups = [p['pid'] for p in s.get('players', []) if p.get('pid')]
    others = [x for x in (s.get('containerPid'), s.get('labwcPid')) if x]
    for g in groups:
        r.killpg(g, signal.SIGTERM)
    end = ctx.now() + grace
    while ctx.now() < end and any(r.alive(g) for g in groups):
        r.reap()
        ctx.sleep(0.25)
    killed = 0
    for g in groups:
        if r.alive(g):
            r.killpg(g, signal.SIGKILL)
            killed += 1
    for pid in others:
        if pid != os.getpid():
            r.kill(pid, signal.SIGTERM)
            r.killpg(pid, signal.SIGTERM)
    end = ctx.now() + grace
    while ctx.now() < end and any(r.alive(x) for x in others if x != os.getpid()):
        ctx.sleep(0.25)
    for pid in others:
        if pid != os.getpid() and r.alive(pid):
            r.killpg(pid, signal.SIGKILL)
            r.kill(pid, signal.SIGKILL)
    cleanup(ctx, s)
    try:
        os.unlink(ctx.session_file)
    except OSError:
        pass
    return {'stopped': True, 'forced': killed}


def status(ctx):
    s = load_session(ctx)
    if not s:
        last = last_failure(ctx)
        return {'running': False, 'lastError': last.get('error'), 'lastErrorAt': last.get('at')} if last else {'running': False}
    alive = session_alive(ctx, s)
    if not alive:
        cleanup(ctx, s)
        try:
            os.unlink(ctx.session_file)
        except OSError:
            pass
        return {'running': False, 'ended': True, 'game': s.get('game'), 'error': last_failure(ctx).get('error')}
    return {'running': True, 'state': s.get('state'), 'game': s.get('game'), 'startedAt': s.get('startedAt'),
            'layout': s.get('layout'), 'screen': s.get('screen'), 'containerPid': s.get('containerPid'),
            'labwcPid': s.get('labwcPid'), 'error': s.get('error'),
            'players': [{'seat': p['seat'], 'name': p['name'], 'pad': p['pad'], 'padName': p.get('padName'),
                         'rect': p['rect'], 'pid': p.get('pid'), 'alive': ctx.runner.alive(p.get('pid'))}
                        for p in s.get('players', [])]}


def public_player(p):
    return {k: p[k] for k in ('seat', 'name', 'pad', 'padName', 'rect', 'appId', 'pid', 'keyboard', 'home', 'prefix') if k in p} | \
        {'view': p['view']['kind']}


def start(ctx, a):
    players = a['players']
    if players < 2 or players > 4:
        raise Fail('Couch Co-op is for 2 to 4 players.')
    pad_ids = [x.strip() for x in (a.get('pads') or '').split(',') if x.strip()]
    if len(pad_ids) != players:
        raise Fail('Pick one controller for each of the %d players.' % players)
    if len(set(pad_ids)) != len(pad_ids):
        raise Fail('Each player needs their own controller.')
    if pad_ids.count('kbm') > 1:
        raise Fail('Only one player can use the keyboard and mouse.')
    old = load_session(ctx)
    if old and session_alive(ctx, old):
        raise Fail('Couch Co-op is already running. Stop it first.')
    if old:
        cleanup(ctx, old)
    ctx.progress(2, 'Checking this system')
    r = ctx.runner
    for tool, msg in (('gamescope', 'gamescope'), ('labwc', 'labwc'), ('bwrap', 'bubblewrap (bwrap)')):
        if not r.which(tool):
            raise Fail("Couch Co-op needs %s, which isn't installed." % msg)
    found = list_pads(ctx)
    by_id = {p['id']: p for p in found['pads']}
    chosen = []
    for pid in pad_ids:
        if pid == 'kbm':
            chosen.append(None)
        elif pid in by_id:
            chosen.append(by_id[pid])
        else:
            raise Fail('A chosen controller (%s) is no longer connected. Pick controllers again.' % pid)
    ctx.progress(5, 'Looking at the game')
    game = analyze(find_game(ctx, a['game']), a.get('exe'), ctx.home)
    if not game['canPlay']:
        raise Fail(game['why'])
    tools = {'backend': gamescope_has_backend(ctx), 'umu': None, 'proton': None}
    if game['run'] == 'windows':
        tools['umu'] = find_umu(ctx)
        if not tools['umu']:
            raise Fail("Windows games need umu-launcher, which isn't installed.")
        pv = proton_versions(ctx)
        if not pv:
            raise Fail('No Proton yet. Start any Windows game once in Hearth (that fetches Proton), then try again.')
        tools['proton'] = pv[0]['path']
    if game['usesGoldberg']:
        kinds = sorted({'linux' if rel.lower().endswith('.so') else 'windows' for rel in game['steamApi']})
        gbe_fetch(ctx, kinds, base=8, span=25)
    w, h = screen_size(ctx, a.get('width'), a.get('height'))
    rects = layout_rects(w, h, players, a.get('layout') or 'auto')
    names = profiles(ctx)
    kb_seat = a.get('keyboard_seat', 1)
    if 'kbm' in pad_ids:
        kb_seat = pad_ids.index('kbm') + 1
    kb_nodes = [k['event'] for k in found['keyboards'] + found['mice']]
    plan = []
    try:
        for i in range(players):
            seat = i + 1
            ctx.progress(35 + 40 * i / players, 'Getting player %d ready' % seat)
            name = names[i]['name']
            home = prepare_home(ctx, seat)
            view = {'kind': 'direct', 'path': game['installDir'], 'mounted': False}
            if not a.get('dry_run'):
                view = mount_view(ctx, seat, game)
                if view['kind'] == 'symlinks' and game['run'] == 'native':
                    # Native games find their files from /proc/self/exe, which sees through symlinks: copy the exe.
                    real_copy(os.path.join(view['path'], os.path.relpath(game['exe'], game['installDir'])))
                if game['usesGoldberg']:
                    swap_steam_api(ctx, view['path'], game, seat, name)
            plan.append(plan_player(ctx, seat, name, chosen[i], rects[i], game, view, home, tools,
                                    kb_nodes if seat == kb_seat else []))
    except Exception:
        cleanup(ctx, {'players': plan})
        raise
    # The keyboard player's window opens last, so labwc gives it keyboard focus.
    order = [p['seat'] for p in plan if not p['keyboard']] + [p['seat'] for p in plan if p['keyboard']]
    run_dir = os.path.join(ctx.runtime_dir, 'hearth-coop')
    session = {'state': 'starting', 'startedAt': int(ctx.now() * 1000),
               'game': {'id': game['id'], 'title': game['title'], 'run': game['run'], 'usesGoldberg': game['usesGoldberg']},
               'layout': a.get('layout') or 'auto', 'screen': {'w': w, 'h': h}, 'order': order, 'runDir': run_dir,
               'stagger': a.get('stagger', 4.0), 'players': plan, 'containerPid': None, 'labwcPid': None}
    if a.get('dry_run'):
        return {'dryRun': True, 'session': session}
    os.makedirs(run_dir, exist_ok=True)
    with open(os.path.join(run_dir, 'rc.xml'), 'w') as f:
        f.write(rc_xml(plan))
    with open(os.path.join(run_dir, 'autostart'), 'w') as f:
        f.write('exec %s %s _container --session %s\n' % (shlex.quote(sys.executable or '/usr/bin/python3'),
                                                          shlex.quote(ctx.self_path), shlex.quote(ctx.session_file)))
    try:
        os.unlink(ctx.last_file)
    except OSError:
        pass
    save_session(ctx, session)
    ctx.progress(80, 'Opening the split screen')
    # From here on only the container writes the session file (it adds labwc's pid and the players' pids).
    labwc = r.spawn(['labwc', '-C', run_dir], env=container_env(ctx), log=os.path.join(run_dir, 'labwc.log'))
    session['labwcPid'] = labwc
    ctx.progress(85, 'Starting the players')
    end = ctx.now() + 30 + session['stagger'] * players
    while ctx.now() < end:
        s = load_session(ctx) or session
        s['labwcPid'] = s.get('labwcPid') or labwc
        if s.get('state') == 'running':
            session = s
            break
        if s.get('state') == 'failed' or not r.alive(labwc):
            stop_session(ctx, s, grace=2)
            raise Fail(s.get('error') or last_failure(ctx).get('error') or
                       "The split screen didn't open (labwc stopped). See %s/labwc.log." % run_dir)
        ctx.sleep(0.5)
    else:
        stop_session(ctx, load_session(ctx) or session, grace=2)
        raise Fail("The players didn't start in time.")
    ctx.progress(100, 'Playing')
    return {'started': True, 'warning': session.get('error'), 'game': session['game'], 'screen': session['screen'], 'layout': session['layout'],
            'labwcPid': session['labwcPid'], 'containerPid': session.get('containerPid'),
            'players': [public_player(p) for p in session['players']]}


def set_output_size(ctx, w, h):
    rc, out, _ = ctx.runner.run(['wlr-randr'], timeout=5)
    names = [l.split()[0] for l in (out or '').splitlines() if l and not l[0].isspace()]
    if names:
        ctx.runner.run(['wlr-randr', '--output', names[0], '--custom-mode', '%dx%d' % (w, h)], timeout=5)


ERROR_LINE = re.compile(r'error|fail|not owned|cannot|can\'t|denied|no such|segmentation|abort|core dumped', re.I)


def log_lines(path, n=3):
    """The lines of a player's log that say what went wrong (else its last lines)."""
    lines = [l.strip() for l in read(path).splitlines()[-200:] if l.strip()]
    bad = [l for l in lines if ERROR_LINE.search(l)]
    return [l[:300] for l in (bad or lines)[-n:]]


def early_exit_text(dead):
    parts = []
    for p in dead:
        lines = log_lines(p.get('log') or '')
        parts.append('Player %d\'s game closed right after starting%s' % (p['seat'], (': ' + lines[-1]) if lines else ''))
    return '. '.join(parts) + '. (Its log: %s)' % (dead[0].get('log') or '')


def remember_failure(ctx, s, why, dead):
    write_json(ctx.last_file, {'error': why, 'at': int(ctx.now() * 1000), 'game': s.get('game'),
                               'players': [{'seat': p['seat'], 'log': p.get('log'), 'lines': log_lines(p.get('log') or '', 12)}
                                           for p in dead]})


def last_failure(ctx):
    return read_json(ctx.last_file) or {}


def container(ctx, session_path, poll=1.0):
    """Runs inside the nested labwc (its autostart): starts each player's copy, waits, tidies up at the end."""
    s = read_json(session_path)
    if not s:
        return 1
    r = ctx.runner
    s['containerPid'] = os.getpid()
    labwc = int(ctx.env.get('LABWC_PID') or s.get('labwcPid') or 0)
    s['labwcPid'] = labwc or None
    write_json(session_path, s)
    stopping = {'now': False}

    def on_term(signum, frame):
        stopping['now'] = True
    try:
        signal.signal(signal.SIGTERM, on_term)
        signal.signal(signal.SIGHUP, on_term)
    except ValueError:
        pass
    set_output_size(ctx, s['screen']['w'], s['screen']['h'])
    by_seat = {p['seat']: p for p in s['players']}
    rc_path = os.path.join(s['runDir'], 'rc.xml')
    try:
        for i, seat in enumerate(s['order']):
            if stopping['now']:
                break
            p = by_seat[seat]
            with open(rc_path, 'w') as f:
                f.write(rc_xml(s['players'], slot=p['rect']))
            if labwc:
                r.kill(labwc, signal.SIGHUP)        # labwc re-reads rc.xml
            env = dict(p['env'])
            for k in ('WAYLAND_DISPLAY', 'XDG_RUNTIME_DIR'):     # the nested labwc's socket, not gamescope's
                if ctx.env.get(k):
                    env[k] = ctx.env[k]
            p['pid'] = r.spawn(p['argv'], env=env, cwd=p['cwd'], log=p['log'])
            p['spawnedAt'] = ctx.now()
            write_json(session_path, s)
            if i < len(s['order']) - 1:
                ctx.sleep(s.get('stagger', 4.0))
        # A player whose copy closed straight away (gamescope or the game crashed at start): tell why, with the
        # last lines of that player's log, instead of the split screen just closing.
        settle_end = ctx.now() + s.get('settle', 3.0)
        while ctx.now() < settle_end and not stopping['now'] and all(r.alive(p.get('pid')) for p in s['players']):
            r.reap()
            ctx.sleep(min(poll, 0.5))
        r.reap()
        dead = [p for p in s['players'] if p.get('pid') and not r.alive(p['pid'])]
        if dead and not stopping['now']:
            why = early_exit_text(dead)
            if len(dead) == len(s['players']):
                s['state'], s['error'] = 'failed', why
                remember_failure(ctx, s, why, dead)
            else:
                s['state'], s['error'] = 'running', why
            write_json(session_path, s)
        else:
            s['state'] = 'running'
            write_json(session_path, s)
    except Exception as e:  # noqa: BLE001
        s['state'], s['error'] = 'failed', "A player's game couldn't start: %s" % e
        remember_failure(ctx, s, s['error'], [])
        write_json(session_path, s)
    while not stopping['now'] and any(r.alive(p.get('pid')) for p in s['players']):
        r.reap()
        ctx.sleep(poll)
    # Everyone has quit (or Stop was pressed): stop the rest, unmount, close labwc.
    cur = read_json(session_path) or s
    cur['containerPid'] = None
    stop_session(ctx, cur, grace=5)
    if labwc:
        r.kill(labwc, signal.SIGTERM)
    return 0


# ---------------------------------------------------------------------- command line

def parse_opts(argv, spec):
    """--key value / --flag options; spec maps option name to type (int, float, str, bool)."""
    out, i = {}, 0
    while i < len(argv):
        k = argv[i]
        if not k.startswith('--') or k[2:] not in spec:
            raise Fail('Unknown option %s.' % k)
        name, typ = k[2:], spec[k[2:]]
        if typ is bool:
            out[name.replace('-', '_')] = True
            i += 1
            continue
        if i + 1 >= len(argv):
            raise Fail('%s needs a value.' % k)
        try:
            out[name.replace('-', '_')] = typ(argv[i + 1])
        except ValueError:
            raise Fail('%s: %r is not a valid value.' % (k, argv[i + 1]))
        i += 2
    return out


def main(argv=None, ctx=None):
    argv = sys.argv[1:] if argv is None else argv
    ctx = ctx or Ctx()
    cmd = argv[0] if argv else ''
    rest = argv[1:]
    try:
        if cmd == 'check':
            ctx.emit(check(ctx))
        elif cmd == 'pads':
            ctx.emit(list_pads(ctx))
        elif cmd == 'wait-button':
            o = parse_opts(rest, {'timeout': float, 'exclude': str})
            p = wait_button(ctx, o.get('timeout', 10.0), [x for x in o.get('exclude', '').split(',') if x])
            ctx.emit({'pad': p})
        elif cmd == 'games':
            games = []
            lst = all_games(ctx)
            for i, g in enumerate(lst):
                ctx.progress(100 * i / max(1, len(lst)), 'Looking at ' + g['title'])
                games.append(analyze(g, home=ctx.home))
            games.sort(key=lambda g: (not g['canPlay'], g['title'].lower()))
            ctx.emit({'games': games})
        elif cmd == 'profiles':
            ctx.emit({'players': profiles(ctx)})
        elif cmd == 'profile-set':
            o = parse_opts(rest, {'seat': int, 'name': str})
            ctx.emit({'players': profile_set(ctx, o.get('seat', 0), o.get('name', ''))})
        elif cmd == 'gbe-fetch':
            o = parse_opts(rest, {'kind': str})
            kinds = [o['kind']] if o.get('kind') in GBE_ASSETS else list(GBE_ASSETS)
            ctx.emit({'tag': GBE_TAG, 'cached': gbe_fetch(ctx, kinds, 0, 100)})
        elif cmd == 'start':
            o = parse_opts(rest, {'game': str, 'players': int, 'pads': str, 'layout': str, 'width': int, 'height': int,
                                  'keyboard-seat': int, 'exe': str, 'stagger': float, 'dry-run': bool})
            if not o.get('game'):
                raise Fail('Pick a game first.')
            o.setdefault('players', len([x for x in o.get('pads', '').split(',') if x]))
            ctx.emit(start(ctx, o))
        elif cmd == 'status':
            ctx.emit(status(ctx))
        elif cmd == 'stop':
            s = load_session(ctx)
            ctx.emit(stop_session(ctx, s) if s else {'stopped': False, 'running': False})
        elif cmd == '_container':
            o = parse_opts(rest, {'session': str})
            return container(ctx, o.get('session') or ctx.session_file)
        else:
            raise Fail('usage: hearth-coop check|pads|wait-button|games|profiles|profile-set|gbe-fetch|start|status|stop')
    except Fail as e:
        print('error: %s' % e, file=ctx.out, flush=True)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
