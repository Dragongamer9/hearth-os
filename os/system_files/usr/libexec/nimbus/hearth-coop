def find_umu(ctx):
    p = ctx.runner.which('umu-run')
    if p:
        return p
    p = os.path.join(ctx.data_dir, 'tools', 'umu', 'umu-run')
    return p if os.path.isfile(p) else None


def proton_versions(ctx):
    found = []
    steam = steam_root(ctx.home)
    dirs = []
    if steam:
        dirs.append(os.path.join(steam, 'compatibilitytools.d'))
        for lib in steam_libraries(steam):
            dirs.append(os.path.join(lib, 'steamapps', 'common'))
    dirs += [os.path.join(ctx.home, '.local/share/Steam/compatibilitytools.d'), '/usr/share/steam/compatibilitytools.d']
    seen = set()
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for n in names:
            p = os.path.join(d, n)
            rp = os.path.realpath(p)
            if rp in seen or not os.path.isfile(os.path.join(p, 'proton')):
                continue
            seen.add(rp)
            found.append({'name': n, 'path': p})

    def rank(v):
        n = v['name'].lower()
        family = 2 if ('ge-proton' in n or 'umu-proton' in n) else (1 if n.startswith('proton') and 'experimental' not in n else 0)
        nums = tuple(int(x) for x in re.findall(r'\d+', n)[:3])
        return (family, nums)
    found.sort(key=rank, reverse=True)
    return found


def gbe_dir(ctx):
    return os.path.join(ctx.coop_dir, 'gbe', safe_name(GBE_TAG))


def gbe_find(ctx, filename, bits):
    """The emulator's copy of steam_api(64).dll / libsteam_api.so for 32 or 64 bit, from the cache."""
    root = os.path.join(gbe_dir(ctx), 'linux' if filename.endswith('.so') else 'windows')
    want = {64: ('x64', 'x86_64', '64'), 32: ('x32', 'x86', '32')}[bits]
    best = None
    for dp, _, files in os.walk(root):
        for f in files:
            if f.lower() != filename.lower():
                continue
            rel = os.path.relpath(os.path.join(dp, f), root).lower()
            parts = rel.split(os.sep)
            if any(x in rel for x in ('experimental', 'steamclient', 'debug', 'tools')):
                continue
            score = (2 if 'regular' in parts else 0) + (1 if any(w in parts for w in want) else 0)
            if best is None or score > best[0]:
                best = (score, os.path.join(dp, f))
    return best[1] if best else None


def gbe_cached(ctx):
    d = gbe_dir(ctx)
    return {k: os.path.isfile(os.path.join(d, k, '.done')) for k in GBE_ASSETS}


def _seven_zip(ctx):
    for n in ('7z', '7za', '7zz', 'bsdtar'):
        p = ctx.runner.which(n)
        if p:
            return n, p
    return None, None


def safe_extract_tar(path, dest):
    with tarfile.open(path) as t:
        base = os.path.realpath(dest)
        for m in t.getmembers():
            target = os.path.realpath(os.path.join(dest, m.name))
            if not (target == base or target.startswith(base + os.sep)) or m.issym() or m.islnk() or m.isdev():
                raise Fail('The Steam emulator download looks damaged (unsafe file inside).')
        if hasattr(tarfile, 'data_filter'):
            t.extractall(dest, filter='data')
        else:
            t.extractall(dest)


def gbe_latest_url(ctx, kind):
    """The newest gbe_fork release's archive for 'linux' or 'windows' games: used when the pinned release is gone
    (gbe_fork deletes old releases; 0.1.9's pin answered 404 and Couch Co-op couldn't start)."""
    api = 'https://api.github.com/repos/%s/releases/latest' % GBE_REPO
    req = urllib.request.Request(api, headers={'User-Agent': 'hearth-coop', 'Accept': 'application/vnd.github+json'})
    with ctx.urlopen(req, timeout=30) as r:
        rel = json.loads(r.read().decode('utf-8', 'replace'))
    assets = [a for a in rel.get('assets', []) if isinstance(a, dict) and a.get('browser_download_url', '').startswith('https://github.com/')]
    exact = [a for a in assets if a.get('name') == GBE_ASSETS[kind]]
    if not exact:
        word, ext = ('linux', ('.tar.bz2', '.tar.gz', '.tar.xz')) if kind == 'linux' else ('win', ('.7z',))
        exact = [a for a in assets if word in a.get('name', '').lower() and a.get('name', '').lower().endswith(ext)
                 and 'debug' not in a.get('name', '').lower()]
    if not exact:
        raise Fail("Couldn't find the Steam emulator for %s games in its newest release." % kind.capitalize())
    return exact[0]['browser_download_url'], rel.get('tag_name', 'latest')


def gbe_fetch(ctx, kinds, base=0, span=30):
    """Downloads and unpacks gbe_fork (pinned GBE_TAG) into the cache, for 'linux' and/or 'windows' games."""
    have = gbe_cached(ctx)
    todo = [k for k in kinds if not have.get(k)]
    for i, kind in enumerate(todo):
        asset = GBE_ASSETS[kind]
        url = 'https://github.com/%s/releases/download/%s/%s' % (GBE_REPO, GBE_TAG, asset)
        dest = os.path.join(gbe_dir(ctx), kind)
        shutil.rmtree(dest, ignore_errors=True)
        os.makedirs(dest, exist_ok=True)
        arch = os.path.join(gbe_dir(ctx), asset)
        if kind == 'windows' and not _seven_zip(ctx)[0]:
            raise Fail('Unpacking the Steam emulator for Windows games needs 7-Zip, which is missing on this system.')
        ctx.progress(base + span * i / max(1, len(todo)), 'Downloading the Steam emulator (%s games)' % kind.capitalize())
        h = hashlib.sha256()
        tag = GBE_TAG

        def download(u):
            with ctx.urlopen(urllib.request.Request(u, headers={'User-Agent': 'hearth-coop'}), timeout=60) as r, open(arch, 'wb') as f:
                while True:
                    chunk = r.read(1 << 16)
                    if not chunk:
                        break
                    h.update(chunk)
                    f.write(chunk)
        try:
            try:
                download(url)
            except urllib.error.HTTPError as e:
                if e.code != 404:
                    raise
                # The pinned release was deleted: the newest one instead (no pinned checksum for it).
                url, tag = gbe_latest_url(ctx, kind)
                h = hashlib.sha256()
                download(url)
        except Fail:
            raise
        except Exception as e:  # noqa: BLE001 - any network problem gets the same plain message
            raise Fail("Couldn't download the Steam emulator (%s). Check your internet connection and try again." % e)
        want = GBE_SHA256.get(kind) if tag == GBE_TAG else None
        if want and h.hexdigest() != want:
            os.unlink(arch)
            raise Fail("The Steam emulator download didn't match what Hearth expects, so it wasn't used.")
        ctx.progress(base + span * (i + 0.5) / max(1, len(todo)), 'Unpacking the Steam emulator')
        if kind == 'linux':
            try:
                safe_extract_tar(arch, dest)
            except tarfile.TarError:
                raise Fail('The Steam emulator download is damaged. Try again.')
        else:
            tool, path = _seven_zip(ctx)
            argv = [path, '-xf', arch, '-C', dest] if tool == 'bsdtar' else [path, 'x', '-y', '-o' + dest, arch]
            rc, _, err = ctx.runner.run(argv, timeout=300)
            if rc != 0:
                raise Fail("Couldn't unpack the Steam emulator (%s)." % (err.strip().splitlines() or ['7-Zip failed'])[-1])
        try:
            os.unlink(arch)
        except OSError:
            pass
        with open(os.path.join(dest, '.done'), 'w') as f:
            json.dump({'tag': tag, 'sha256': h.hexdigest(), 'at': int(ctx.now())}, f)
    return gbe_cached(ctx)


def gamescope_has_backend(ctx):
    rc, out, err = ctx.runner.run(['gamescope', '--help'], timeout=10)
    return '--backend' in (out + err)


def check(ctx):
    r = ctx.runner
    tools = {n: r.which(n) for n in ('gamescope', 'labwc', 'bwrap', 'fuse-overlayfs', 'wlr-randr', 'xrandr', 'xdpyinfo')}
    tools['fusermount'] = r.which('fusermount3') or r.which('fusermount')
    tools['umu-run'] = find_umu(ctx)
    tools['7z'] = _seven_zip(ctx)[1]
    userns = read('/proc/sys/user/max_user_namespaces', '1').strip() != '0'
    problems = []
    for n, msg in (('gamescope', 'gamescope is missing.'), ('labwc', 'labwc is missing.'),
                   ('bwrap', "bubblewrap (bwrap) is missing, so controllers can't be kept apart.")):
        if not tools[n]:
            problems.append(msg)
    if not userns:
        problems.append('User namespaces are turned off, so bubblewrap can\'t keep controllers apart.')
    protons = proton_versions(ctx)
    warnings = []
    if not tools['umu-run']:
        warnings.append("umu-run is missing: Windows games can't run in Couch Co-op.")
    elif not protons:
        warnings.append('No Proton found yet: play any Windows game once in Hearth, then Windows games work here.')
    if not tools['fuse-overlayfs']:
        warnings.append("fuse-overlayfs is missing: games that save into their own folder may fail.")
    if not tools['7z']:
        warnings.append("7-Zip is missing: Windows Steam games can't get the Steam emulator.")
    return {'ready': not problems, 'problems': problems, 'warnings': warnings,
            'tools': {k: bool(v) for k, v in tools.items()}, 'paths': {k: v for k, v in tools.items() if v},
            'gamescopeBackend': bool(tools['gamescope']) and gamescope_has_backend(ctx),
            'userNamespaces': userns, 'proton': protons,
            'gbe': {'tag': GBE_TAG, 'cached': gbe_cached(ctx)}, 'inputplumber': inputplumber_running(ctx),
            'maxPlayers': 4, 'experimental': True}


