# ---------------------------------------------------------------------- accounts (Settings › Users)
# Hearth's administrators are the "wheel" group (the installer puts the first account there; sudo and the
# polkit rules use it). Account names are checked strictly and only ever passed as single arguments.
USERNAME_RE = re.compile(r'^[a-z_][a-z0-9_-]{0,31}$')
FULLNAME_RE = re.compile(r'^[^\x00-\x1f\x7f:,=]{0,64}$')
ADMIN_GROUP = 'wheel'
ADMIN_GROUPS = ('wheel', 'sudo', 'admin')   # any of these counts as an administrator when listing
PASSWD_FILE = '/etc/passwd'
GROUP_FILE = '/etc/group'
ACCOUNTS_DIR = '/var/lib/AccountsService'
PICTURE_MAX = 5 * 1024 * 1024
UID_MIN, UID_MAX = 1000, 59999


def read_text(path):
    try:
        with open(path, errors='replace') as f:
            return f.read()
    except OSError:
        return ''


def people(passwd_text=None, group_text=None):
    """The people's accounts (not system ones): [{name, uid, fullname, home, admin, player}]."""
    passwd_text = read_text(PASSWD_FILE) if passwd_text is None else passwd_text
    group_text = read_text(GROUP_FILE) if group_text is None else group_text
    admins = set()
    for line in group_text.splitlines():
        f = line.split(':')
        if len(f) >= 4 and f[0] in ADMIN_GROUPS:
            admins.update(x for x in f[3].split(',') if x)
    out = []
    for line in passwd_text.splitlines():
        f = line.split(':')
        if len(f) < 7 or not f[2].isdigit():
            continue
        uid = int(f[2])
        if not UID_MIN <= uid <= UID_MAX or f[6].endswith(('nologin', '/false')):
            continue
        out.append({'name': f[0], 'uid': uid, 'fullname': f[4].split(',')[0], 'home': f[5],
                    'admin': f[0] in admins, 'player': bool(SEAT_PLAYER_RE.fullmatch(f[0]))})
    return out


def group_names(group_text=None):
    group_text = read_text(GROUP_FILE) if group_text is None else group_text
    return {line.split(':')[0] for line in group_text.splitlines() if ':' in line}


def user_add_request(name, kind, raw):
    """user-add's input, checked strictly: (name, admin, fullname, password); raises ValueError with the reason."""
    if not isinstance(name, str) or not USERNAME_RE.fullmatch(name):
        raise ValueError('account names use small letters, numbers, - and _ (up to 32), starting with a letter or _')
    if SEAT_PLAYER_RE.fullmatch(name):
        raise ValueError('that name is kept for multi-seat players')
    if kind not in ('standard', 'admin'):
        raise ValueError('the account type is standard or admin')
    try:
        req = json.loads(raw or 'null')
        password_ = req['password']
        fullname = req.get('fullname', '') or ''
    except (ValueError, KeyError, TypeError, AttributeError):
        raise ValueError('expected {"password": ..., "fullname": ...}')
    if not isinstance(password_, str) or not isinstance(fullname, str):
        raise ValueError('expected {"password": ..., "fullname": ...}')
    if len(password_) < 4:
        raise ValueError('the password needs at least 4 characters')
    if len(password_) > 512 or '\n' in password_ or '\r' in password_ or '\0' in password_:
        raise ValueError('the password can\'t contain line breaks')
    fullname = fullname.strip()
    if not FULLNAME_RE.fullmatch(fullname):
        raise ValueError('the full name can be up to 64 characters, without : , or =')
    return name, kind == 'admin', fullname, password_


def user_add(name, kind):
    caller()
    try:
        name, admin, fullname, password_ = user_add_request(name, kind, sys.stdin.readline())
    except ValueError as e:
        fail(str(e))
    if any(p['name'] == name for p in people()) or name in {l.split(':')[0] for l in read_text(PASSWD_FILE).splitlines()}:
        fail('there\'s already an account called %s' % name)
    if name in group_names():
        fail('%s is already used by the system' % name)
    base = '/var/home' if os.path.isdir('/var/home') else '/home'
    cmd = ['useradd', '--create-home', '--home-dir', os.path.join(base, name), '--shell', '/bin/bash', '--user-group']
    if fullname:
        cmd += ['--comment', fullname]
    if admin:
        if ADMIN_GROUP not in group_names():
            fail('the administrators group (%s) is missing' % ADMIN_GROUP)
        cmd += ['--groups', ADMIN_GROUP]
    code, out = admin_run(cmd + ['--', name])
    if code != 0:
        fail('couldn\'t create the account (%s)' % last_line(out, 'useradd failed'))
    code, out = admin_run(['chpasswd'], input='%s:%s\n' % (name, password_))
    if code != 0:
        admin_run(['userdel', '-r', '--', name])
        fail('couldn\'t set the password, so the account wasn\'t kept (%s)' % last_line(out, 'chpasswd failed'))
    print(json.dumps({'ok': True, 'user': name, 'admin': admin}))


def user_remove_check(name, mode, me, accounts):
    """Why this account can't be removed (None if it can)."""
    if not isinstance(name, str) or not USERNAME_RE.fullmatch(name):
        return 'not a valid account name'
    if mode not in ('keep-home', 'delete-home'):
        return 'say keep-home or delete-home'
    if name == me:
        return 'you can\'t remove the account you\'re using'
    acct = next((a for a in accounts if a['name'] == name), None)
    if not acct:
        return 'there\'s no such account (system accounts can\'t be removed here)'
    if acct['player']:
        return 'multi-seat player accounts are removed in Settings › Multi-seat'
    if acct['admin'] and not any(a['admin'] and a['name'] != name for a in accounts):
        return 'this is the last administrator'
    return None


def user_remove(name, mode):
    me = caller().pw_name
    why = user_remove_check(name, mode, me, people())
    if why:
        fail(why)
    admin_run(['loginctl', 'terminate-user', '--', name], timeout=30)
    time.sleep(1)
    cmd = ['userdel'] + (['-r'] if mode == 'delete-home' else []) + ['--', name]
    code, out = admin_run(cmd)
    # userdel -r exits 12 when it removed the account but not every file (e.g. no mail spool): still removed.
    if code not in (0, 12) or any(p['name'] == name for p in people()):
        if 'currently used' in out or 'logged in' in out:
            fail('%s is still signed in somewhere. Sign them out and try again' % name)
        fail('couldn\'t remove the account (%s)' % last_line(out, 'userdel failed'))
    for path in (os.path.join(ACCOUNTS_DIR, 'icons', name), os.path.join(ACCOUNTS_DIR, 'users', name)):
        try:
            os.remove(path)
        except OSError:
            pass
    print(json.dumps({'ok': True, 'user': name, 'homeDeleted': mode == 'delete-home'}))


def picture_kind(data):
    if data.startswith(b'\x89PNG\r\n\x1a\n'):
        return 'png'
    if data.startswith(b'\xff\xd8\xff'):
        return 'jpeg'
    return None


def accounts_user_file(text, icon):
    """AccountsService's file for an account with Icon= set (or removed when icon is None), the rest kept."""
    lines = text.splitlines()
    if not any(l.strip() == '[User]' for l in lines):
        lines = ['[User]'] + lines
    out, in_user, done = [], False, False
    for l in lines:
        s = l.strip()
        if s.startswith('['):
            if in_user and not done and icon:
                out.append('Icon=' + icon)
                done = True
            in_user = s == '[User]'
            out.append(l)
            continue
        if in_user and s.startswith('Icon='):
            if icon and not done:
                out.append('Icon=' + icon)
                done = True
            continue
        out.append(l)
    if in_user and not done and icon:
        out.append('Icon=' + icon)
    return '\n'.join(out) + '\n'


def user_picture():
    me = caller().pw_name
    if not USERNAME_RE.fullmatch(me):
        fail('unusual account name')
    data = sys.stdin.buffer.read(PICTURE_MAX + 1)
    icons, users = os.path.join(ACCOUNTS_DIR, 'icons'), os.path.join(ACCOUNTS_DIR, 'users')
    icon = os.path.join(icons, me)
    if not data:
        try:
            os.remove(icon)
        except OSError:
            pass
        icon = None
    else:
        if len(data) > PICTURE_MAX:
            fail('the picture is too big (up to 5 MB)')
        if not picture_kind(data):
            fail('use a PNG or JPEG picture')
        os.makedirs(icons, mode=0o755, exist_ok=True)
        tmp = icon + '.hearth-tmp'
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
        with os.fdopen(fd, 'wb') as f:
            f.write(data)
        os.replace(tmp, icon)
    os.makedirs(users, mode=0o700, exist_ok=True)
    path = os.path.join(users, me)
    text = accounts_user_file(read_text(path), icon)
    tmp = path + '.hearth-tmp'
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write(text)
    os.replace(tmp, path)
    print(json.dumps({'ok': True, 'picture': bool(icon)}))


# ---------------------------------------------------------------------- printers (Settings › Printers, CUPS)
PRINTER_NAME_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9_.-]{0,126}$')
PRINTER_URI_RE = re.compile(r'^(ipp|ipps|http|https|dnssd|usb|socket|lpd|hp|implicitclass)://'
                            r'[A-Za-z0-9._~:/?#\[\]@!$&()*+,;=%-]{1,500}$')
PRINTER_INFO_RE = re.compile(r'^[^\x00-\x1f\x7f]{1,127}$')
DRIVERLESS_SCHEMES = ('ipp', 'ipps', 'http', 'https', 'dnssd', 'implicitclass')


def parse_lpinfo_devices(text):
    """lpinfo -l -v: the devices that are real printers (have an address), [{uri, cls, info, makeModel, deviceId,
    location}]. The bare backends ("network socket", "direct usb") are left out."""
    out, cur = [], None
    for line in text.splitlines():
        m = re.match(r'^Device:\s*uri\s*=\s*(\S+)\s*$', line)
        if m:
            cur = {'uri': m.group(1), 'cls': '', 'info': '', 'makeModel': '', 'deviceId': '', 'location': ''}
            out.append(cur)
            continue
        m = re.match(r'^\s+(class|info|make-and-model|device-id|location)\s*=\s*(.*?)\s*$', line)
        if m and cur is not None:
            key = {'class': 'cls', 'make-and-model': 'makeModel', 'device-id': 'deviceId'}.get(m.group(1), m.group(1))
            cur[key] = m.group(2)
    keep = []
    for d in out:
        scheme, _, rest = d['uri'].partition('://')
        if not rest or not PRINTER_URI_RE.fullmatch(d['uri']):
            continue
        if d['makeModel'].lower() == 'unknown':
            d['makeModel'] = ''
        keep.append(d)
    return keep


def printer_discover():
    caller()
    code, out = admin_run(['lpinfo', '-l', '-v', '--timeout', '8', '--exclude-schemes', 'beh,cups-brf,cups-pdf,serial,parallel'], timeout=60)
    if code != 0 and not out.startswith('Device:'):
        fail('couldn\'t look for printers (%s). Is CUPS running?' % last_line(out, 'lpinfo failed'))
    devices = parse_lpinfo_devices(out)
    # The same printer is often found several ways (dnssd and ipp): keep the dnssd one, the most stable address.
    seen, unique = set(), []
    for d in sorted(devices, key=lambda d: (0 if d['uri'].startswith('dnssd://') else 1, d['uri'])):
        key = (d['info'] or d['makeModel'] or d['uri']).lower()
        if key in seen:
            continue
        seen.add(key)
        unique.append(d)
    print(json.dumps({'devices': unique}))


def printer_args(args):
    """printer-add's arguments: NAME URI [--info TEXT]. (name, uri, info) or None."""
    if len(args) not in (2, 4):
        return None
    name, uri = args[0], args[1]
    info = None
    if len(args) == 4:
        if args[2] != '--info' or not PRINTER_INFO_RE.fullmatch(args[3]):
            return None
        info = args[3]
    if not PRINTER_NAME_RE.fullmatch(name) or not PRINTER_URI_RE.fullmatch(uri):
        return None
    return name, uri, info


def printer_models(uri):
    """The drivers to try for a printer, best first: driverless IPP Everywhere, cups-filters' driverless PPD,
    then the first driver CUPS has for the printer's make and model."""
    out = []
    scheme = uri.split('://', 1)[0]
    if scheme in DRIVERLESS_SCHEMES:
        out.append('everywhere')
        if shutil.which('driverless'):
            out.append('driverless:' + uri)
    code, text = admin_run(['lpinfo', '-l', '-v', '--timeout', '5'], timeout=60)
    mm = next((d['makeModel'] for d in parse_lpinfo_devices(text) if d['uri'] == uri and d['makeModel']), '')
    if mm:
        code, text = admin_run(['lpinfo', '--make-and-model', mm, '-m'], timeout=60)
        for line in text.splitlines() if code == 0 else []:
            model = line.split(' ', 1)[0]
            if model and model not in ('everywhere',) and not model.startswith('driverless:') and model not in out:
                out.append(model)
                break
    return out


def printer_add(name, uri, info):
    caller()
    errors = []
    for model in printer_models(uri):
        cmd = ['lpadmin', '-p', name, '-E', '-v', uri, '-m', model, '-o', 'printer-is-shared=false']
        if info:
            cmd += ['-D', info]
        code, out = admin_run(cmd, timeout=120)
        if code == 0:
            admin_run(['cupsenable', name])
            admin_run(['cupsaccept', name])
            print(json.dumps({'ok': True, 'name': name, 'model': model}))
            return
        errors.append(last_line(out, 'lpadmin failed'))
    if not errors:
        fail('no driver found for this printer')
    fail('couldn\'t add the printer (%s)' % errors[-1])


def printer_exists(name):
    code, out = admin_run(['lpstat', '-v'])
    return any(l.startswith('device for %s:' % name) for l in out.splitlines())


def printer_remove(name):
    caller()
    if not PRINTER_NAME_RE.fullmatch(name or '') or not printer_exists(name):
        fail('there\'s no printer called that')
    code, out = admin_run(['lpadmin', '-x', name])
    if code != 0:
        fail('couldn\'t remove the printer (%s)' % last_line(out, 'lpadmin failed'))
    print(json.dumps({'ok': True, 'removed': name}))


def printer_default(name):
    caller()
    if not PRINTER_NAME_RE.fullmatch(name or '') or not printer_exists(name):
        fail('there\'s no printer called that')
    code, out = admin_run(['lpadmin', '-d', name])
    if code != 0:
        fail('couldn\'t make it the default (%s)' % last_line(out, 'lpadmin failed'))
    print(json.dumps({'ok': True, 'default': name}))


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    if cmd == 'tdp-info':
        return tdp_info()
    if cmd == 'space-status' and len(argv) == 2:
        return space('status', [])   # read-only; without root it leaves out what needs the drive itself
    if os.geteuid() != 0:
        fail('needs root (run through pkexec)')
    if cmd == 'autologin' and len(argv) == 3:
        autologin(argv[2])
    elif cmd == 'hostname' and len(argv) == 3:
        hostname(argv[2])
    elif cmd == 'password':
        password()
    elif cmd == 'update-status':
        print(json.dumps(bootc_status()))
    elif cmd == 'update-check':
        update_check()
    elif cmd == 'update':
        update()
    elif cmd == 'tdp' and len(argv) == 3:
        tdp(argv[2])
    elif cmd == 'hibernate-setup':
        hibernate_setup()
    elif cmd == 'move-to-new-os' and move_args(argv[2:]):
        move_to_new_os(*move_args(argv[2:]))
    elif cmd == 'seats-setup':
        seats_setup()
    elif cmd == 'seats-remove' and len(argv) in (2, 3) and argv[2:] in ([], ['--delete-users']):
        seats_remove(argv[2:] == ['--delete-users'])
    elif cmd == 'seats-acl':
        seats_acl()
    elif cmd in ('seats-start', 'seats-stop'):
        seats_start_stop(cmd == 'seats-start')
    elif cmd == 'space-grow':
        args = space_args(argv[2:])
        if args is None:
            fail('usage: hearth-admin space-grow --from /dev/... | free --gb N [--dry-run]')
        space('grow', args)
    elif cmd == 'space-clear-journal' and len(argv) == 2:
        space('clear-journal', [])
    elif cmd == 'timezone' and len(argv) == 3:
        timezone(argv[2])
    elif cmd == 'ntp' and len(argv) == 3:
        ntp(argv[2])
    elif cmd == 'time-set' and len(argv) == 3:
        time_set(argv[2])
    elif cmd == 'user-add' and len(argv) == 4:
        user_add(argv[2], argv[3])
    elif cmd == 'user-remove' and len(argv) == 4:
        user_remove(argv[2], argv[3])
    elif cmd == 'user-picture' and len(argv) == 2:
        user_picture()
    elif cmd == 'printer-discover' and len(argv) == 2:
        printer_discover()
    elif cmd == 'printer-add' and printer_args(argv[2:]):
        printer_add(*printer_args(argv[2:]))
    elif cmd == 'printer-remove' and len(argv) == 3:
        printer_remove(argv[2])
    elif cmd == 'printer-default' and len(argv) == 3:
        printer_default(argv[2])
    elif cmd in ('import-scan', 'import-run', 'import-unmount', 'takeover-plan', 'takeover-run'):
        # Bringing games and files over from other drives, and removing the old system afterwards: their own
        # scripts, run as root like the rest.
        name, sub = cmd.split('-', 1)
        helper = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'hearth-' + name)
        os.execv(sys.executable, [sys.executable, helper, sub])
    else:
        fail('usage: hearth-admin autologin on|off | hostname NAME | password | update-status | update-check | update | tdp-info | tdp WATTS | seats-setup | seats-remove [--delete-users] | seats-acl | seats-start | seats-stop | space-status | space-grow --from DEV|free --gb N [--dry-run] | space-clear-journal | move-to-new-os [--edition anatase|ubuntu|cachyos|peppermint] [--testing] | timezone ZONE | ntp on|off | time-set "YYYY-MM-DD HH:MM" | user-add NAME standard|admin | user-remove NAME keep-home|delete-home | user-picture | printer-discover | printer-add NAME URI [--info TEXT] | printer-remove NAME | printer-default NAME')


if __name__ == '__main__':
    main(sys.argv)
