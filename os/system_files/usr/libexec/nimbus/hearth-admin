SPACE_DEV_RE = re.compile(r'^/dev/[A-Za-z0-9][A-Za-z0-9/_-]{0,63}$')


def space_args(args):
    """space-grow's arguments, checked strictly before anything runs as root: --from /dev/<name> or free,
    --gb 1..65536, optionally --dry-run. Returns the list for hearth-space, or None."""
    out, seen = [], set()
    i = 0
    while i < len(args):
        a = args[i]
        if a in seen:
            return None
        seen.add(a)
        if a == '--from' and i + 1 < len(args) and (args[i + 1] == 'free' or (SPACE_DEV_RE.match(args[i + 1]) and '..' not in args[i + 1])):
            out += [a, args[i + 1]]
            i += 2
        elif a == '--gb' and i + 1 < len(args) and re.fullmatch(r'[1-9][0-9]{0,4}', args[i + 1]) and int(args[i + 1]) <= 65536:
            out += [a, args[i + 1]]
            i += 2
        elif a == '--dry-run':
            out.append(a)
            i += 1
        else:
            return None
    return out if {'--from', '--gb'} <= seen else None


def space(sub, args):
    helper = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'hearth-space')
    os.execv(sys.executable, [sys.executable, helper, sub] + args)


# ---------------------------------------------------------------------- moving to the new Hearth OS (Anatase)
NEW_OS_IMAGE = 'ghcr.io/dragongamer9/hearth-os'
# The editions the old Hearth can move to: edition -> (image, tags it has). Never a free-form image. The Beta
# Experimental editions only have :testing, so that's what they get with or without --testing.
NEW_OS_EDITIONS = {
    'anatase': (NEW_OS_IMAGE, ('latest', 'testing')),
    'ubuntu': ('ghcr.io/dragongamer9/hearth-ubuntu', ('testing',)),
    'cachyos': ('ghcr.io/dragongamer9/hearth-cachyos', ('testing',)),
    'peppermint': ('ghcr.io/dragongamer9/hearth-peppermint', ('testing',)),
}
# CachyOS' image is built for x86-64-v3: these processor features (the ones /proc/cpuinfo names) must be there.
X86_64_V3_FLAGS = ('avx2', 'bmi2', 'fma', 'movbe')
CLEAN_INSTALL = '/var/lib/hearth/clean-install.json'
BAZZITE_INFO = '/usr/share/ublue-os/image-info.json'
# What the new system's first start keeps (hearth-clean-install there does it; this is what the plan says).
CLEAN_INSTALL_KEEPS = ['steam-library', 'steam-userdata', 'hearth-epic-gog-games', 'wine-prefixes', 'heroic-lutris-games',
                       'hand-added-games']
# Where Bazzite keeps the lists of Flatpak apps it puts on every device (the new system takes those off).
BAZZITE_FLATPAK_LISTS = ['/usr/share/ublue-os/**/flatpak*/*install*', '/usr/share/ublue-os/**/*flatpak*.list',
                         '/usr/share/ublue-os/**/system-flatpaks*', '/etc/ublue-os/*flatpak*.list']
APP_ID = re.compile(r'^[A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+){2,}$')


def flatpak_ids(text):
    """App ids from a Flatpak list ("app/org.foo.Bar/x86_64/stable", "org.foo.Bar", "org.foo.Bar//23.08",
    comments); runtimes and extensions ("runtime/...") left out."""
    out = []
    for line in text.splitlines():
        tok = line.split('#', 1)[0].strip().split()
        if not tok:
            continue
        t = tok[0]
        if t.startswith('runtime/'):
            continue
        if t.startswith('app/'):
            t = t[4:]
        t = t.split('/', 1)[0]
        if APP_ID.match(t) and t not in out:
            out.append(t)
    return out


def bazzite_flatpaks(patterns=None):
    ids = []
    for pat in patterns or BAZZITE_FLATPAK_LISTS:
        for f in sorted(glob.glob(pat, recursive=True)):
            try:
                with open(f, errors='replace') as fh:
                    ids += [i for i in flatpak_ids(fh.read()) if i not in ids]
            except OSError:
                continue
    return ids


def os_name():
    try:
        with open('/etc/os-release') as f:
            for line in f:
                if line.startswith('PRETTY_NAME='):
                    return line.split('=', 1)[1].strip().strip('"')
    except OSError:
        pass
    return 'Linux'


def new_os_image(edition, testing=False):
    """The image for an edition from the fixed list (None for anything else)."""
    if edition not in NEW_OS_EDITIONS:
        return None
    repo, tags = NEW_OS_EDITIONS[edition]
    tag = 'testing' if testing or 'latest' not in tags else 'latest'
    return repo + ':' + tag


def move_args(args):
    """move-to-new-os's options: [--edition NAME] [--testing], each at most once. (edition, testing), or None."""
    edition, testing, i = 'anatase', False, 0
    seen = set()
    while i < len(args):
        a = args[i]
        if a in seen:
            return None
        seen.add(a)
        if a == '--testing':
            testing = True
            i += 1
        elif a == '--edition' and i + 1 < len(args) and args[i + 1] in NEW_OS_EDITIONS:
            edition = args[i + 1]
            i += 2
        else:
            return None
    return edition, testing


def x86_64_v3(cpuinfo):
    """Every processor in /proc/cpuinfo has the x86-64-v3 features CachyOS' image needs."""
    flags = [set(line.split(':', 1)[1].split()) for line in cpuinfo.splitlines() if line.split(':', 1)[0].strip() == 'flags' and ':' in line]
    return bool(flags) and all(all(f in fl for f in X86_64_V3_FLAGS) for fl in flags)


def clean_install_plan(user, flatpaks, image, now=None, edition='anatase'):
    """What the new Hearth OS does at its first start (/var/lib/hearth/clean-install.json, read by
    hearth-clean-install there): which account, when, and that only games and saves are kept."""
    return {
        'version': 1,
        'user': user.pw_name, 'uid': user.pw_uid, 'home': user.pw_dir,
        'created': int(now if now is not None else time.time()),
        'image': image, 'edition': edition, 'from': os_name(),
        'keep': CLEAN_INSTALL_KEEPS,
        'removeFlatpaks': flatpaks,
        'oldFilesDays': 30,
    }


def move_to_new_os(edition='anatase', testing=False):
    user = caller()
    if not os.path.exists('/run/ostree-booted'):
        fail('this only works on Hearth OS')
    if not os.path.exists(BAZZITE_INFO) or os.path.exists('/usr/share/nimbus/image-info.json'):
        fail('this Hearth OS is already the new one')
    if user.pw_uid == 0:
        fail('run this from your own account')
    image = new_os_image(edition, testing)
    if not image:
        fail('unknown edition')
    if edition == 'cachyos':
        try:
            with open('/proc/cpuinfo') as f:
                ok = x86_64_v3(f.read())
        except OSError:
            ok = False
        if not ok:
            fail('Hearth OS on CachyOS needs a newer processor (x86-64-v3: AVX2, BMI2, FMA, MOVBE)')
    print('log: Moving to ' + image, flush=True)
    plan = clean_install_plan(user, bazzite_flatpaks(), image, edition=edition)
    os.makedirs(os.path.dirname(CLEAN_INSTALL), mode=0o755, exist_ok=True)
    tmp = CLEAN_INSTALL + '.tmp'
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), 'w') as f:
        json.dump(plan, f, indent=2)
    os.replace(tmp, CLEAN_INSTALL)
    print('log: The new Hearth OS will keep your games and saves; your other files are put aside for 30 days', flush=True)
    progress(0, 'Getting the new Hearth OS')
    stage = Stage()
    try:
        if layered():
            # Packages added on top of this system don't come along (it's a clean install): drop them, then move.
            print('log: Taking off the packages added on top of this system', flush=True)
            run_logged(['rpm-ostree', 'reset', '--overlays', '--overrides'])
            rpm_ostree_upgrade(stage, ['rpm-ostree', 'rebase', 'ostree-unverified-registry:' + image])
        else:
            bootc_upgrade_with_progress(0, 100, stage, ['bootc', 'switch', image])
    except (UpgradeFailed, SystemExit) as e:
        try:
            os.remove(CLEAN_INSTALL)
        except OSError:
            pass
        if isinstance(e, SystemExit):
            raise
        fail("couldn't get the new Hearth OS: " + str(e)[:300])
    done = 'Done. Restart to start the new Hearth OS.'
    progress(100, done)
    stage.emit(force=True, phase='done', pct=100.0, desc=done, staged=True)
    st = bootc_status()
    st.update({'moved': True, 'restart': True, 'image': image})
    print(json.dumps(st))


# ---------------------------------------------------------------------- date and time (Settings › Date & time)
TIMEZONE_RE = re.compile(r'^[A-Za-z0-9_+-]{1,40}(/[A-Za-z0-9_+-]{1,40}){0,2}$')
TIME_SET_RE = re.compile(r'^(20[0-9]{2})-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01]) ([01][0-9]|2[0-3]):([0-5][0-9])$')
ZONEINFO = '/usr/share/zoneinfo'


def admin_run(cmd, input=None, timeout=120, env=None):
    """Commands for the date/time, account and printer commands (tests replace it). Returns (code, output)."""
    try:
        r = subprocess.run(cmd, input=input, capture_output=True, text=True, timeout=timeout,
                           env=dict(os.environ, LC_ALL='C', **(env or {})))
        return r.returncode, (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, str(e)


def last_line(out, default):
    return ((out or '').strip().splitlines() or [default])[-1][:300]


def valid_timezone(zone):
    """A time zone name the system knows: the right shape, and listed by timedatectl (or in the zone files)."""
    if not isinstance(zone, str) or not TIMEZONE_RE.fullmatch(zone) or '..' in zone:
        return False
    code, out = admin_run(['timedatectl', 'list-timezones'], timeout=30)
    if code == 0 and out:
        return zone in out.split()
    return os.path.isfile(os.path.join(ZONEINFO, zone))


def timezone(zone):
