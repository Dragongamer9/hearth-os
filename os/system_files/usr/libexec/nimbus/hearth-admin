#!/usr/bin/python3
"""hearth-admin: the few things the Hearth app does that need root, on Hearth (the OS).

Run by the Hearth app through pkexec; /usr/share/polkit-1/rules.d/49-hearth-admin.rules lets the person
signed in at the device (local, active session, in the wheel group) run it without a password prompt,
which a handheld with no keyboard couldn't answer. Each command does one narrow job and checks its input.

  hearth-admin autologin on|off      sign straight into Hearth at boot, or show the login screen
  hearth-admin hostname NAME         the device's name on the network
  hearth-admin password              change your password; stdin: {"old": "...", "new": "..."}
                                     (the current password is checked first)
  hearth-admin update-status         JSON: the running version, a downloaded update, an available one
  hearth-admin update-check          look for an update, then the same JSON
  hearth-admin update                download and stage the update (applies at restart), and update the
                                     system Flatpak apps; progress lines, then the JSON
  hearth-admin tdp-info              JSON: how this device's power limit can be set, its range and value
                                     (read-only; works without root)
  hearth-admin tdp WATTS             set the power limit: ASUS firmware attributes, asus-nb-wmi, or ryzenadj

Output: progress lines as "log: ...", percentages as "progress: <0-100> <what>", the result as one JSON line. Exit 1 with "error: ..." on failure.
"""
import json
import os
import pwd
import re
import subprocess
import sys
import threading
import time

NO_AUTOLOGIN = '/etc/nimbus/no-autologin'
AUTOLOGIN_SCRIPT = '/usr/libexec/nimbus/nimbus-autologin'


def fail(msg):
    print('error: ' + msg, flush=True)
    sys.exit(1)


def caller():
    """The account that ran pkexec."""
    uid = os.environ.get('PKEXEC_UID')
    if not uid or not uid.isdigit():
        fail('run this through pkexec')
    return pwd.getpwuid(int(uid))


def autologin(state):
    if state == 'on':
        if os.path.exists(NO_AUTOLOGIN):
            os.remove(NO_AUTOLOGIN)
    elif state == 'off':
        os.makedirs(os.path.dirname(NO_AUTOLOGIN), exist_ok=True)
        open(NO_AUTOLOGIN, 'w').close()
    else:
        fail('autologin on|off')
    subprocess.run([AUTOLOGIN_SCRIPT], check=True)   # writes or clears the login screen's settings
    print(json.dumps({'autologin': state == 'on'}))


def hostname(name):
    if not re.fullmatch(r'[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?', name or ''):
        fail('use letters, numbers and dashes (up to 63), not starting or ending with a dash')
    subprocess.run(['hostnamectl', 'hostname', name], check=True)
    print(json.dumps({'hostname': name}))


def password():
    user = caller()
    try:
        req = json.loads(sys.stdin.readline())
        old, new = str(req['old']), str(req['new'])
    except (ValueError, KeyError, TypeError):
        fail('expected {"old": ..., "new": ...}')
    if len(new) < 4:
        fail('the new password needs at least 4 characters')
    if '\n' in new or '\r' in new:
        fail('the new password can\'t contain line breaks')
    # Check the current password the way the login screen does (pam_unix's helper, run as that user).
    chk = subprocess.run(['runuser', '-u', user.pw_name, '--', '/usr/sbin/unix_chkpwd', user.pw_name, 'nullok'],
                         input=(old + '\0').encode(), capture_output=True)
    if chk.returncode != 0:
        fail('the current password is incorrect')
    r = subprocess.run(['chpasswd'], input=f'{user.pw_name}:{new}\n'.encode(), capture_output=True)
    if r.returncode != 0:
        fail(r.stderr.decode(errors='replace').strip() or 'couldn\'t change the password')
    print(json.dumps({'ok': True}))


def bootc_status():
    r = subprocess.run(['bootc', 'status', '--format', 'json'], capture_output=True, text=True)
    if r.returncode != 0:
        fail(r.stderr.strip() or 'bootc status failed')
    st = json.loads(r.stdout).get('status') or {}

    def info(entry):
        if not entry:
            return None
        img = entry.get('image') or {}
        return {'version': img.get('version'), 'timestamp': img.get('timestamp'),
                'image': ((img.get('image') or {}).get('image'))}

    booted = st.get('booted') or {}
    cached = booted.get('cachedUpdate')
    staged = st.get('staged')
    return {
        'booted': info(booted),
        'staged': info(staged),
        'available': ({'version': cached.get('version'), 'timestamp': cached.get('timestamp')} if cached else None),
    }


def run_logged(cmd):
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    last = ''
    for line in p.stdout:
        line = line.rstrip()
        if line:
            last = line
            print('log: ' + line[:300], flush=True)
    if p.wait() != 0:
        if re.search(r'lock|another|in progress', last, re.I):
            fail('another update is already running (Hearth also updates by itself in the background). Try again in a few minutes.')
        fail(last or ' '.join(cmd) + ' failed')


def update_check():
    run_logged(['bootc', 'upgrade', '--check'])
    print(json.dumps(bootc_status()))


def progress(pct, what):
    print('progress: %.1f %s' % (max(0.0, min(100.0, pct)), what), flush=True)


class Stage:
    """Detailed update progress for the Updates page, one JSON line at a time ("stage: {...}"):
    phase download (bytes, speed, time left, layers), install (bootc's deploy steps) or apps (Flatpak).
    Printed at most a few times a second."""

    def __init__(self):
        self.last = 0.0
        self.samples = []   # (time, bytes) for the speed

    def emit(self, force=False, **info):
        now = time.monotonic()
        if not force and now - self.last < 0.5:
            return
        self.last = now
        print('stage: ' + json.dumps(info), flush=True)

    def download(self, done, total, desc, layer=None, layers=None):
        now = time.monotonic()
        self.samples.append((now, done))
        self.samples = [x for x in self.samples if now - x[0] <= 6] or [(now, done)]
        t0, b0 = self.samples[0]
        bps = (done - b0) / (now - t0) if now - t0 >= 1 else 0
        eta = (total - done) / bps if bps > 0 and total > done else None
        self.emit(force=done >= total, phase='download', pct=round(100.0 * done / total, 1) if total else None,
                  done=done, total=total, bps=round(bps), eta=round(eta) if eta else None,
                  layer=layer, layers=layers, desc=desc)


def bootc_upgrade_with_progress(lo, hi, stage):
    """bootc upgrade, reporting its download (and then its install steps) as lo..hi percent and as detailed
    stages (bootc's --progress-fd JSON). Older bootc without that option: plain output, no percentage."""
    help_text = subprocess.run(['bootc', 'upgrade', '--help'], capture_output=True, text=True).stdout
    if '--progress-fd' not in help_text:
        stage.emit(force=True, phase='download', pct=None, desc='Downloading the system update')
        return run_logged(['bootc', 'upgrade'])
    rfd, wfd = os.pipe()
    p = subprocess.Popen(['bootc', 'upgrade', '--progress-fd', str(wfd)], pass_fds=(wfd,),
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    os.close(wfd)
    last = ['']
    downloaded = [False]

    def logs():
        for line in p.stdout:
            line = line.rstrip()
            if line:
                last[0] = line
                print('log: ' + line[:300], flush=True)
                # "No changes" / staging messages without progress events still move the page on.
                if re.search(r'stag|deploy|writing|commit', line, re.I) and not downloaded[0]:
                    downloaded[0] = True
                    stage.emit(force=True, phase='install', pct=None, desc='Installing the update')
    t = threading.Thread(target=logs, daemon=True)
    t.start()
    mid = lo + (hi - lo) * 0.85   # download is most of the time; installing the rest
    with os.fdopen(rfd) as events:
        for line in events:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            kind, task = ev.get('type'), ev.get('task') or ''
            done, total = ev.get('bytes') or 0, ev.get('bytesTotal') or 0
            steps, steps_total = ev.get('steps') or 0, ev.get('stepsTotal') or 0
            if kind == 'ProgressBytes' and total:
                progress(lo + (mid - lo) * done / total,
                         'Downloading (%.2f of %.2f GB)' % (done / 1e9, total / 1e9))
                stage.download(done, total, ev.get('description') or 'Downloading the system update',
                               layer=min(steps + 1, steps_total) if steps_total else None, layers=steps_total or None)
            elif kind == 'ProgressSteps' and steps_total:
                downloaded[0] = True
                pct = 100.0 * steps / steps_total
                sub = [x.get('description') for x in (ev.get('subtasks') or []) if not x.get('completed')]
                desc = sub[-1] if sub and sub[-1] else (ev.get('description') or 'Installing the update')
                progress(mid + (hi - mid) * steps / steps_total, desc)
                stage.emit(force=steps >= steps_total, phase='install', pct=round(pct, 1), step=steps, steps=steps_total,
                           desc=desc, task=task)
    t.join()
    if p.wait() != 0:
        if re.search(r'lock|another|in progress', last[0], re.I):
            fail('another update is already running (Hearth also updates by itself in the background). Try again in a few minutes.')
        fail(last[0] or 'bootc upgrade failed')
    stage.emit(force=True, phase='install', pct=100.0, desc='System update installed')


def flatpak_update(stage, lo, hi):
    """flatpak update with a count: "Updating 3 of 12 apps"."""
    r = subprocess.run(['flatpak', 'remote-ls', '--updates', '--system', '--columns=application'],
                       capture_output=True, text=True)
    names = [l.strip() for l in r.stdout.splitlines() if l.strip()]
    total = len(names)
    if total == 0:
        stage.emit(force=True, phase='apps', pct=100.0, n=0, total=0, desc='Your apps are up to date')
        return
    stage.emit(force=True, phase='apps', pct=0.0, n=0, total=total, desc='Updating %d app%s' % (total, '' if total == 1 else 's'))
    p = subprocess.Popen(['flatpak', 'update', '--system', '-y', '--noninteractive'],
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    seen, last = set(), ''
    for line in p.stdout:
        line = line.rstrip()
        if not line:
            continue
        last = line
        print('log: ' + line[:300], flush=True)
        m = re.match(r'^(?:Updating|Installing)\s+(?:(?:app|runtime)/)?([A-Za-z0-9_-]+\.[A-Za-z0-9_.-]+)', line)
        if m and m.group(1) not in seen:
            seen.add(m.group(1))
            n = min(len(seen), total)
            progress(lo + (hi - lo) * (n - 1) / total, 'Updating apps (%d of %d)' % (n, total))
            stage.emit(force=True, phase='apps', pct=round(100.0 * (n - 1) / total, 1), n=n, total=total,
                       desc='Updating %s' % m.group(1))
    if p.wait() != 0:
        fail(last or 'flatpak update failed')
    stage.emit(force=True, phase='apps', pct=100.0, n=total, total=total, desc='Apps updated')


def update():
    stage = Stage()
    progress(0, 'Starting')
    print('log: Downloading the system update…', flush=True)
    bootc_upgrade_with_progress(0, 90, stage)
    if subprocess.run(['sh', '-c', 'command -v flatpak'], capture_output=True).returncode == 0:
        progress(90, 'Updating apps')
        print('log: Updating apps…', flush=True)
        flatpak_update(stage, 90, 100)
    progress(100, 'Done')
    stage.emit(force=True, phase='done', pct=100.0, desc='Done')
    print(json.dumps(bootc_status()))


# ---------------------------------------------------------------------- power limit (TDP)
FW_GLOB = '/sys/class/firmware-attributes/*/attributes/ppt_pl1_spl'
WMI = '/sys/devices/platform/asus-nb-wmi'


def read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def tdp_method():
    """(method, details) for the first way this device offers."""
    import glob
    for spl in sorted(glob.glob(FW_GLOB)):
        base = os.path.dirname(spl)
        lo, hi = read_int(os.path.join(spl, 'min_value')), read_int(os.path.join(spl, 'max_value'))
        if hi:
            return 'firmware', {'base': base, 'min': lo or 5, 'max': hi, 'watts': read_int(os.path.join(spl, 'current_value'))}
    if os.path.exists(os.path.join(WMI, 'ppt_pl1_spl')):
        return 'asus-wmi', {'min': 7, 'max': 30, 'watts': read_int(os.path.join(WMI, 'ppt_pl1_spl'))}
    if subprocess.run(['sh', '-c', 'command -v ryzenadj'], capture_output=True).returncode == 0:
        with open('/proc/cpuinfo') as f:
            if 'AuthenticAMD' in f.read():
                return 'ryzenadj', {'min': 5, 'max': 30, 'watts': None}
    return None, {}


def tdp_info():
    method, d = tdp_method()
    print(json.dumps({'method': method, 'min': d.get('min'), 'max': d.get('max'), 'watts': d.get('watts'), 'default': 15}))


def write_value(path, value):
    with open(path, 'w') as f:
        f.write(str(value))


def tdp(watts):
    method, d = tdp_method()
    if not method:
        fail("this device's power limit can't be set (no ASUS firmware attributes, asus-nb-wmi or ryzenadj)")
    try:
        w = int(watts)
    except ValueError:
        fail('watts must be a number')
    w = max(d['min'], min(d['max'], w))
    if method == 'firmware':
        # sustained, short boost and fast boost limits, each within its own range
        for name in ('ppt_pl1_spl', 'ppt_pl2_sppt', 'ppt_pl3_fppt'):
            attr = os.path.join(d['base'], name)
            if not os.path.isdir(attr):
                continue
            lo = read_int(os.path.join(attr, 'min_value')) or 0
            hi = read_int(os.path.join(attr, 'max_value')) or w
            write_value(os.path.join(attr, 'current_value'), max(lo, min(hi, w)))
    elif method == 'asus-wmi':
        for name in ('ppt_pl1_spl', 'ppt_pl2_sppt', 'ppt_fppt'):
            if os.path.exists(os.path.join(WMI, name)):
                write_value(os.path.join(WMI, name), w)
    else:
        mw = str(w * 1000)
        r = subprocess.run(['ryzenadj', '--stapm-limit=' + mw, '--fast-limit=' + mw, '--slow-limit=' + mw], capture_output=True, text=True)
        if r.returncode != 0:
            fail((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else 'ryzenadj failed')
    print(json.dumps({'method': method, 'watts': w}))


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    if cmd == 'tdp-info':
        return tdp_info()
    if os.geteuid() != 0:
        fail('needs root (run through pkexec)')
    if cmd == 'autologin' and len(argv) == 3:
        autologin(argv[2])
    elif cmd == 'hostname' and len(argv) == 3:
        hostname(argv[2])
    elif cmd == 'password':
        password()
    elif cmd == 'update-status':
        print(json.dumps(bootc_status()))
    elif cmd == 'update-check':
        update_check()
    elif cmd == 'update':
        update()
    elif cmd == 'tdp' and len(argv) == 3:
        tdp(argv[2])
    else:
        fail('usage: hearth-admin autologin on|off | hostname NAME | password | update-status | update-check | update | tdp-info | tdp WATTS')


if __name__ == '__main__':
    main(sys.argv)
