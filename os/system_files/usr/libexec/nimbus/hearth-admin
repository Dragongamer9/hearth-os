#!/usr/bin/python3
"""hearth-admin: the few things the Hearth app does that need root, on Hearth (the OS).

Run by the Hearth app through pkexec; /usr/share/polkit-1/rules.d/49-hearth-admin.rules lets the person
signed in at the device (local, active session, in the wheel group) run it without a password prompt,
which a handheld with no keyboard couldn't answer. Each command does one narrow job and checks its input.

  hearth-admin autologin on|off      sign straight into Hearth at boot, or show the login screen
  hearth-admin hostname NAME         the device's name on the network
  hearth-admin password              change your password; stdin: {"old": "...", "new": "..."}
                                     (the current password is checked first)
  hearth-admin update-status         JSON: the running version, a downloaded update, an available one
  hearth-admin update-check          look for an update, then the same JSON
  hearth-admin update                download and stage the update (applies at restart), and update the
                                     system Flatpak apps; progress lines, then the JSON
  hearth-admin tdp-info              JSON: how this device's power limit can be set, its range and value
                                     (read-only; works without root)
  hearth-admin tdp WATTS             set the power limit: ASUS firmware attributes, asus-nb-wmi, or ryzenadj
  hearth-admin import-scan|import-run|import-unmount
                                     games and files from other drives (see hearth-import)
  hearth-admin takeover-plan|takeover-run
                                     remove other systems from Hearth's drive (see hearth-takeover)
  hearth-admin seats-setup|seats-remove|seats-acl|seats-start|seats-stop
                                     multi-seat: several players at once, each on their own screen with their own
                                     account (see hearth-seats and docs/MULTI-SEAT.md)
  hearth-admin space-status          JSON: Hearth's space and what the other systems on its drive could give
                                     (see hearth-space; read-only, works without root with fewer details)
  hearth-admin space-grow --from DEV|free --gb N [--dry-run]
                                     make Hearth bigger with space from another system (Beta Experimental)
  hearth-admin space-clear-journal   after an interrupted space-grow was looked at
  hearth-admin hibernate-setup       room on the drive (a swap file the size of memory) so the PC can turn
                                     off with Quick Resume games kept, and the boot options to come back to it

Output: progress lines as "log: ...", percentages as "progress: <0-100> <what>", the result as one JSON line. Exit 1 with "error: ..." on failure.
"""
import json
import os
import pwd
import re
import subprocess
import sys
import threading
import time

NO_AUTOLOGIN = '/etc/nimbus/no-autologin'
AUTOLOGIN_SCRIPT = '/usr/libexec/nimbus/nimbus-autologin'


def fail(msg):
    print('error: ' + msg, flush=True)
    sys.exit(1)


def caller():
    """The account that ran pkexec."""
    uid = os.environ.get('PKEXEC_UID')
    if not uid or not uid.isdigit():
        fail('run this through pkexec')
    return pwd.getpwuid(int(uid))


def autologin(state):
    if state == 'on':
        if os.path.exists(NO_AUTOLOGIN):
            os.remove(NO_AUTOLOGIN)
    elif state == 'off':
        os.makedirs(os.path.dirname(NO_AUTOLOGIN), exist_ok=True)
        open(NO_AUTOLOGIN, 'w').close()
    else:
        fail('autologin on|off')
    subprocess.run([AUTOLOGIN_SCRIPT], check=True)   # writes or clears the login screen's settings
    print(json.dumps({'autologin': state == 'on'}))


def hostname(name):
    if not re.fullmatch(r'[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?', name or ''):
        fail('use letters, numbers and dashes (up to 63), not starting or ending with a dash')
    subprocess.run(['hostnamectl', 'hostname', name], check=True)
    print(json.dumps({'hostname': name}))


def password():
    user = caller()
    try:
        req = json.loads(sys.stdin.readline())
        old, new = str(req['old']), str(req['new'])
    except (ValueError, KeyError, TypeError):
        fail('expected {"old": ..., "new": ...}')
    if len(new) < 4:
        fail('the new password needs at least 4 characters')
    if '\n' in new or '\r' in new:
        fail('the new password can\'t contain line breaks')
    # Check the current password the way the login screen does (pam_unix's helper, run as that user).
    chk = subprocess.run(['runuser', '-u', user.pw_name, '--', '/usr/sbin/unix_chkpwd', user.pw_name, 'nullok'],
                         input=(old + '\0').encode(), capture_output=True)
    if chk.returncode != 0:
        fail('the current password is incorrect')
    r = subprocess.run(['chpasswd'], input=f'{user.pw_name}:{new}\n'.encode(), capture_output=True)
    if r.returncode != 0:
        fail(r.stderr.decode(errors='replace').strip() or 'couldn\'t change the password')
    print(json.dumps({'ok': True}))


def bootc_status():
    r = subprocess.run(['bootc', 'status', '--format', 'json'], capture_output=True, text=True)
    if r.returncode != 0:
        fail(r.stderr.strip() or 'bootc status failed')
    st = json.loads(r.stdout).get('status') or {}

    def info(entry):
        if not entry:
            return None
        img = entry.get('image') or {}
        return {'version': img.get('version'), 'timestamp': img.get('timestamp'),
                'image': ((img.get('image') or {}).get('image'))}

    booted = st.get('booted') or {}
    cached = booted.get('cachedUpdate')
    staged = st.get('staged')
    return {
        'booted': info(booted),
        'staged': info(staged),
        'available': ({'version': cached.get('version'), 'timestamp': cached.get('timestamp')} if cached else None),
    }


def run_logged(cmd):
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    last = ''
    for line in p.stdout:
        line = line.rstrip()
        if line:
            last = line
            print('log: ' + line[:300], flush=True)
    if p.wait() != 0:
        if BUSY.search(last):
            fail('another update is already running (Hearth also updates by itself in the background). Try again in a few minutes.')
        fail(last or ' '.join(cmd) + ' failed')


def update_check():
    if layered():
        # rpm-ostree: exit 77 means there's nothing new.
        r = subprocess.run(['rpm-ostree', 'upgrade', '--check'], capture_output=True, text=True)
        for line in (r.stdout + r.stderr).splitlines():
            if line.strip():
                print('log: ' + line.strip()[:300], flush=True)
        if r.returncode not in (0, 77):
            fail((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else 'rpm-ostree upgrade --check failed')
        print(json.dumps(bootc_status()))
        return
    run_logged(['bootc', 'upgrade', '--check'])
    st = bootc_status()
    # bootc can miss what rpm-ostree (the terminal's update) finds: ask it too.
    if not st.get('available') and not st.get('staged'):
        try:
            if rpm_ostree_has_update():
                st['available'] = {'version': 'newer', 'timestamp': None}
                print('log: rpm-ostree found a newer version', flush=True)
        except UpgradeFailed as e:
            print('log: ' + str(e)[:200], flush=True)
    print(json.dumps(st))
    return
    print(json.dumps(bootc_status()))


def progress(pct, what):
    print('progress: %.1f %s' % (max(0.0, min(100.0, pct)), what), flush=True)


class Stage:
    """Detailed update progress for the Updates page, one JSON line at a time ("stage: {...}"):
    phase download (bytes, speed, time left, layers), install (bootc's deploy steps) or apps (Flatpak).
    Printed at most a few times a second."""

    def __init__(self):
        self.last = 0.0
        self.samples = []   # (time, bytes) for the speed

    def emit(self, force=False, **info):
        now = time.monotonic()
        if not force and now - self.last < 0.5:
            return
        self.last = now
        print('stage: ' + json.dumps(info), flush=True)

    def download(self, done, total, desc, layer=None, layers=None):
        now = time.monotonic()
        self.samples.append((now, done))
        self.samples = [x for x in self.samples if now - x[0] <= 6] or [(now, done)]
        t0, b0 = self.samples[0]
        bps = (done - b0) / (now - t0) if now - t0 >= 1 else 0
        eta = (total - done) / bps if bps > 0 and total > done else None
        self.emit(force=done >= total, phase='download', pct=round(100.0 * done / total, 1) if total else None,
                  done=done, total=total, bps=round(bps), eta=round(eta) if eta else None,
                  layer=layer, layers=layers, desc=desc)


def bootc_upgrade_with_progress(lo, hi, stage):
    """bootc upgrade, reporting its download (and then its install steps) as lo..hi percent and as detailed
    stages (bootc's --progress-fd JSON). Older bootc without that option: plain output, no percentage."""
    help_text = subprocess.run(['bootc', 'upgrade', '--help'], capture_output=True, text=True).stdout
    probe = subprocess.run(['bootc', 'upgrade', '--progress-fd', '1', '--check'], capture_output=True, text=True)
    if '--progress-fd' not in help_text and re.search(r'unexpected argument|unrecognized|unknown option', probe.stderr or '', re.I):
        stage.emit(force=True, phase='download', pct=None, desc='Downloading the system update')
        return run_logged(['bootc', 'upgrade'])
    rfd, wfd = os.pipe()
    p = subprocess.Popen(['bootc', 'upgrade', '--progress-fd', str(wfd)], pass_fds=(wfd,),
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    os.close(wfd)
    last = ['']
    downloaded = [False]

    def logs():
        for line in p.stdout:
            line = line.rstrip()
            if line:
                last[0] = line
                print('log: ' + line[:300], flush=True)
                # "No changes" / staging messages without progress events still move the page on.
                if re.search(r'stag|deploy|writing|commit', line, re.I) and not downloaded[0]:
                    downloaded[0] = True
                    stage.emit(force=True, phase='install', pct=None, desc='Installing the update')
    t = threading.Thread(target=logs, daemon=True)
    t.start()
    mid = lo + (hi - lo) * 0.85   # download is most of the time; installing the rest
    with os.fdopen(rfd) as events:
        for line in events:
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            kind, task = ev.get('type'), ev.get('task') or ''
            done, total = ev.get('bytes') or 0, ev.get('bytesTotal') or 0
            steps, steps_total = ev.get('steps') or 0, ev.get('stepsTotal') or 0
            if kind == 'ProgressBytes' and total:
                progress(lo + (mid - lo) * done / total,
                         'Downloading (%.2f of %.2f GB)' % (done / 1e9, total / 1e9))
                stage.download(done, total, ev.get('description') or 'Downloading the system update',
                               layer=min(steps + 1, steps_total) if steps_total else None, layers=steps_total or None)
            elif kind == 'ProgressSteps' and steps_total:
                downloaded[0] = True
                pct = 100.0 * steps / steps_total
                sub = [x.get('description') for x in (ev.get('subtasks') or []) if not x.get('completed')]
                desc = sub[-1] if sub and sub[-1] else (ev.get('description') or 'Installing the update')
                progress(mid + (hi - mid) * steps / steps_total, desc)
                stage.emit(force=steps >= steps_total, phase='install', pct=round(pct, 1), step=steps, steps=steps_total,
                           desc=desc, task=task)
    t.join()
    if p.wait() != 0:
        if BUSY.search(last[0]):
            fail('another update is already running (Hearth also updates by itself in the background). Try again in a few minutes.')
        raise UpgradeFailed(last[0] or 'bootc upgrade failed')
    stage.emit(force=True, phase='install', pct=100.0, desc='System update installed')


class UpgradeFailed(Exception):
    pass


BUSY = re.compile(r'\block(ed)?\b|another (transaction|update|operation)|transaction in progress|in progress|busy', re.I)


def layered():
    """Packages added on top of the image (rpm-ostree install): bootc refuses to update such a system, so it
    goes through rpm-ostree, the way Bazzite's own updater does."""
    try:
        r = subprocess.run(['rpm-ostree', 'status', '--json', '--booted'], capture_output=True, text=True, timeout=60)
        d = next((x for x in json.loads(r.stdout).get('deployments', []) if x.get('booted')), {})
        return bool(d.get('requested-packages') or d.get('requested-local-packages') or d.get('requested-base-removals')
                    or d.get('requested-base-local-replacements'))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return False


SIZE_UNITS = {'b': 1, 'kb': 1e3, 'kib': 1024, 'mb': 1e6, 'mib': 1024 ** 2, 'gb': 1e9, 'gib': 1024 ** 3}


def size_of(text):
    """'95.3 MB' -> bytes (0 when there's no size)."""
    m = re.search(r'([\d.]+)\s*([kKmMgG]i?[bB]|[bB])\b', text)
    return int(float(m.group(1)) * SIZE_UNITS.get(m.group(2).lower(), 1)) if m else 0


def rpm_ostree_upgrade(stage):
    """rpm-ostree upgrade with real progress: it says how many layers it needs and how big they are, then
    fetches them one at a time ("Fetching ostree chunk sha256:… (95.3 MB)… done")."""
    stage.emit(force=True, phase='download', pct=None, desc='Looking for the update')
    p = subprocess.Popen(['rpm-ostree', 'upgrade'], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    last, total, done, needed, fetched, current = '', 0, 0, 0, 0, 0
    for line in p.stdout:
        line = line.rstrip()
        if not line:
            continue
        last = line
        print('log: ' + line[:300], flush=True)
        m = re.search(r'layers needed:\s*(\d+)', line, re.I)
        if m:
            needed += int(m.group(1))
            total += size_of(line[m.end():])
            stage.download(done, total or 1, 'Downloading the system update', layer=0, layers=needed or None)
            continue
        if re.search(r'^\s*Fetching', line):
            done += current            # the one before it finished
            current = size_of(line)
            fetched += 1
            if total:
                progress(85.0 * done / total, 'Downloading (%.2f of %.2f GB)' % (done / 1e9, total / 1e9))
                stage.download(done, total, 'Downloading the system update', layer=min(fetched, needed) if needed else None, layers=needed or None)
            if line.endswith('done'):
                done += current
                current = 0
            continue
        if re.search(r'staging|writing objects|checking out|deploy|committing', line, re.I):
            if total:
                stage.download(total, total, 'Downloaded', layer=needed or None, layers=needed or None)
            progress(88, 'Installing the update')
            stage.emit(force=True, phase='install', pct=None, desc='Installing the update')
    if p.wait() != 0:
        if BUSY.search(last):
            fail('another update is already running (Hearth also updates by itself in the background). Try again in a few minutes.')
        fail(last or 'rpm-ostree upgrade failed')
    stage.emit(force=True, phase='install', pct=100.0, desc='System update installed')


def rpm_ostree_has_update():
    """rpm-ostree's own look: exit 0 = there's an update, 77 = nothing new; anything else (busy: Bazzite's
    background updater holds the lock, no network) is a problem worth saying, not "nothing new"."""
    try:
        r = subprocess.run(['rpm-ostree', 'upgrade', '--check'], capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise UpgradeFailed('rpm-ostree didn\'t answer (%s)' % e)
    if r.returncode == 0:
        return True
    if r.returncode == 77:
        return False
    last = ((r.stderr or r.stdout).strip().splitlines() or ['rpm-ostree upgrade --check failed'])[-1]
    if BUSY.search(last):
        fail('another update is already running (Hearth also updates by itself in the background). Try again in a few minutes.')
    raise UpgradeFailed(last)


def staged_any():
    """A new version is downloaded and waiting for the restart (bootc's view, or rpm-ostree's)."""
    try:
        if (bootc_status() or {}).get('staged'):
            return True
    except SystemExit:
        pass
    try:
        r = subprocess.run(['rpm-ostree', 'status', '--json'], capture_output=True, text=True, timeout=60)
        return any(d.get('staged') for d in json.loads(r.stdout).get('deployments', []))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return False


def flatpak_update(stage, lo, hi):
    """flatpak update with a count: "Updating 3 of 12 apps"."""
    r = subprocess.run(['flatpak', 'remote-ls', '--updates', '--system', '--columns=application'],
                       capture_output=True, text=True)
    names = [l.strip() for l in r.stdout.splitlines() if l.strip()]
    total = len(names)
    if total == 0:
        stage.emit(force=True, phase='apps', pct=100.0, n=0, total=0, desc='Your apps are up to date')
        return
    stage.emit(force=True, phase='apps', pct=0.0, n=0, total=total, desc='Updating %d app%s' % (total, '' if total == 1 else 's'))
    p = subprocess.Popen(['flatpak', 'update', '--system', '-y', '--noninteractive'],
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    seen, last = set(), ''
    for line in p.stdout:
        line = line.rstrip()
        if not line:
            continue
        last = line
        print('log: ' + line[:300], flush=True)
        m = re.match(r'^(?:Updating|Installing)\s+(?:(?:app|runtime)/)?([A-Za-z0-9_-]+\.[A-Za-z0-9_.-]+)', line)
        if m and m.group(1) not in seen:
            seen.add(m.group(1))
            n = min(len(seen), total)
            progress(lo + (hi - lo) * (n - 1) / total, 'Updating apps (%d of %d)' % (n, total))
            stage.emit(force=True, phase='apps', pct=round(100.0 * (n - 1) / total, 1), n=n, total=total,
                       desc='Updating %s' % m.group(1))
    if p.wait() != 0:
        fail(last or 'flatpak update failed')
    stage.emit(force=True, phase='apps', pct=100.0, n=total, total=total, desc='Apps updated')


def update():
    stage = Stage()
    progress(0, 'Starting')
    print('log: Downloading the system update…', flush=True)
    if layered():
        print('log: This system has extra packages installed on top, so it updates through rpm-ostree', flush=True)
        rpm_ostree_upgrade(stage)
    else:
        try:
            bootc_upgrade_with_progress(0, 90, stage)
            # bootc can finish at once saying there's nothing new while rpm-ostree (what the terminal's update
            # uses) finds one: check nothing was missed, so "Done" really means updated.
            if not staged_any() and rpm_ostree_has_update():
                print('log: bootc found nothing new but there is an update; getting it through rpm-ostree', flush=True)
                rpm_ostree_upgrade(stage)
        except UpgradeFailed as e:
            # bootc refused (a system managed by rpm-ostree, or bootc not set up for it): the other way.
            print('log: bootc couldn\'t update this system (%s); trying rpm-ostree' % str(e)[:200], flush=True)
            rpm_ostree_upgrade(stage)
    system_new = staged_any()
    if subprocess.run(['sh', '-c', 'command -v flatpak'], capture_output=True).returncode == 0:
        progress(90, 'Updating apps')
        print('log: Updating apps…', flush=True)
        try:
            flatpak_update(stage, 90, 100)
        except SystemExit:
            # The system part is done: an app that didn't update isn't a failed system update.
            print('log: some apps couldn\'t be updated; they\'ll be tried again next time', flush=True)
    # Say what really happened: a new version waiting for the restart, or nothing new.
    done = 'Done. Restart to finish updating.' if system_new else 'Hearth OS is already up to date.'
    progress(100, done)
    stage.emit(force=True, phase='done', pct=100.0, desc=done, staged=system_new)
    print(json.dumps(bootc_status()))


# ---------------------------------------------------------------------- power limit (TDP)
FW_GLOB = '/sys/class/firmware-attributes/*/attributes/ppt_pl1_spl'
WMI = '/sys/devices/platform/asus-nb-wmi'


def read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def tdp_method():
    """(method, details) for the first way this device offers."""
    import glob
    for spl in sorted(glob.glob(FW_GLOB)):
        base = os.path.dirname(spl)
        lo, hi = read_int(os.path.join(spl, 'min_value')), read_int(os.path.join(spl, 'max_value'))
        if hi:
            return 'firmware', {'base': base, 'min': lo or 5, 'max': hi, 'watts': read_int(os.path.join(spl, 'current_value'))}
    if os.path.exists(os.path.join(WMI, 'ppt_pl1_spl')):
        return 'asus-wmi', {'min': 7, 'max': 30, 'watts': read_int(os.path.join(WMI, 'ppt_pl1_spl'))}
    if subprocess.run(['sh', '-c', 'command -v ryzenadj'], capture_output=True).returncode == 0:
        with open('/proc/cpuinfo') as f:
            if 'AuthenticAMD' in f.read():
                return 'ryzenadj', {'min': 5, 'max': 30, 'watts': None}
    return None, {}


def tdp_info():
    method, d = tdp_method()
    print(json.dumps({'method': method, 'min': d.get('min'), 'max': d.get('max'), 'watts': d.get('watts'), 'default': 15}))


def write_value(path, value):
    with open(path, 'w') as f:
        f.write(str(value))


def tdp(watts):
    method, d = tdp_method()
    if not method:
        fail("this device's power limit can't be set (no ASUS firmware attributes, asus-nb-wmi or ryzenadj)")
    try:
        w = int(watts)
    except ValueError:
        fail('watts must be a number')
    w = max(d['min'], min(d['max'], w))
    if method == 'firmware':
        # sustained, short boost and fast boost limits, each within its own range
        for name in ('ppt_pl1_spl', 'ppt_pl2_sppt', 'ppt_pl3_fppt'):
            attr = os.path.join(d['base'], name)
            if not os.path.isdir(attr):
                continue
            lo = read_int(os.path.join(attr, 'min_value')) or 0
            hi = read_int(os.path.join(attr, 'max_value')) or w
            write_value(os.path.join(attr, 'current_value'), max(lo, min(hi, w)))
    elif method == 'asus-wmi':
        for name in ('ppt_pl1_spl', 'ppt_pl2_sppt', 'ppt_fppt'):
            if os.path.exists(os.path.join(WMI, name)):
                write_value(os.path.join(WMI, name), w)
    else:
        mw = str(w * 1000)
        r = subprocess.run(['ryzenadj', '--stapm-limit=' + mw, '--fast-limit=' + mw, '--slow-limit=' + mw], capture_output=True, text=True)
        if r.returncode != 0:
            fail((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else 'ryzenadj failed')
    print(json.dumps({'method': method, 'watts': w}))


HIBERNATE_FILE = '/var/swap/hearth-hibernate'


def hibernate_setup():
    """Quick Resume through a power-off: hibernation needs swap on the drive at least as big as memory, and the
    kernel told where it is (resume= and resume_offset=). zram stays the everyday swap (higher priority)."""
    state = open('/sys/power/state').read() if os.path.exists('/sys/power/state') else ''
    if 'disk' not in state:
        fail("this PC's kernel can't save memory to the drive")
    lock = '/sys/kernel/security/lockdown'
    if os.path.exists(lock) and '[none]' not in open(lock).read():
        fail('Secure Boot is on, which doesn\'t allow saving memory to the drive')
    mem_kb = 0
    for line in open('/proc/meminfo'):
        if line.startswith('MemTotal:'):
            mem_kb = int(line.split()[1])
    gib = -(-int(mem_kb * 1.05) // (1024 * 1024))   # rounded up, a little extra
    os.makedirs(os.path.dirname(HIBERNATE_FILE), exist_ok=True)
    fstype = subprocess.run(['findmnt', '-no', 'FSTYPE', '-T', os.path.dirname(HIBERNATE_FILE)], capture_output=True, text=True).stdout.strip()
    if os.path.exists(HIBERNATE_FILE) and os.path.getsize(HIBERNATE_FILE) < gib * 1024 ** 3:
        subprocess.run(['swapoff', HIBERNATE_FILE], capture_output=True)
        os.remove(HIBERNATE_FILE)
    if not os.path.exists(HIBERNATE_FILE):
        print(f'log: making room for {gib} GB on the drive', flush=True)
        if fstype == 'btrfs':
            r = subprocess.run(['btrfs', 'filesystem', 'mkswapfile', '--size', f'{gib}g', HIBERNATE_FILE], capture_output=True, text=True)
            if r.returncode != 0:
                fail('couldn\'t make the swap file: ' + (r.stderr or r.stdout).strip())
        else:
            for c in (['fallocate', '-l', f'{gib}G', HIBERNATE_FILE], ['chmod', '600', HIBERNATE_FILE], ['mkswap', HIBERNATE_FILE]):
                r = subprocess.run(c, capture_output=True, text=True)
                if r.returncode != 0:
                    fail('couldn\'t make the swap file: ' + (r.stderr or r.stdout).strip())
    # SELinux only lets a file be swap with the swap label.
    subprocess.run(['semanage', 'fcontext', '-a', '-t', 'swapfile_t', HIBERNATE_FILE], capture_output=True)   # kept after a relabel
    subprocess.run(['restorecon', HIBERNATE_FILE], capture_output=True)
    subprocess.run(['chcon', '-t', 'swapfile_t', HIBERNATE_FILE], capture_output=True)
    r = subprocess.run(['swapon', '-p', '1', HIBERNATE_FILE], capture_output=True, text=True)
    if r.returncode != 0 and 'busy' not in (r.stderr or ''):
        fail("couldn't turn on the space for keeping games (" + ((r.stderr or '').strip().splitlines() or ['swapon failed'])[-1] + ')')
    fstab = open('/etc/fstab').read() if os.path.exists('/etc/fstab') else ''
    if HIBERNATE_FILE not in fstab:
        with open('/etc/fstab', 'a') as f:
            f.write(('' if fstab.endswith('\n') or not fstab else '\n') + f'{HIBERNATE_FILE} none swap defaults,pri=1,nofail 0 0\n')
    # Where the saved memory is, for the next start.
    uuid = subprocess.run(['findmnt', '-no', 'UUID', '-T', HIBERNATE_FILE], capture_output=True, text=True).stdout.strip()
    if fstype == 'btrfs':
        offset = subprocess.run(['btrfs', 'inspect-internal', 'map-swapfile', '-r', HIBERNATE_FILE], capture_output=True, text=True).stdout.strip()
    else:
        out = subprocess.run(['filefrag', '-v', HIBERNATE_FILE], capture_output=True, text=True).stdout
        m = re.search(r'^\s*0:\s+0\.\.\s*\d+:\s+(\d+)\.\.', out, re.M)
        offset = m.group(1) if m else ''
    if not uuid or not offset.isdigit():
        fail('couldn\'t find where the swap file is on the drive')
    cur = open('/proc/cmdline').read().split()
    old = [a for a in cur if a.startswith('resume=') or a.startswith('resume_offset=')]
    want = [f'resume=UUID={uuid}', f'resume_offset={offset}']
    if sorted(old) != sorted(want):
        args = ['rpm-ostree', 'kargs'] + [f'--delete-if-present={a}' for a in old] + [f'--append-if-missing={a}' for a in want]
        r = subprocess.run(args, capture_output=True, text=True)
        if r.returncode != 0:
            fail('couldn\'t set the boot options: ' + (r.stderr or r.stdout).strip().splitlines()[-1:][0] if (r.stderr or r.stdout).strip() else 'couldn\'t set the boot options')
    print(json.dumps({'ok': True, 'gb': gib, 'restart': sorted(old) != sorted(want)}))


# ---------------------------------------------------------------------- multi-seat (experimental)
# Root side of /usr/libexec/nimbus/hearth-seats (docs/MULTI-SEAT.md). Everything it does is listed in
# /etc/hearth/seats.json so seats-remove can undo it, and a failed seats-setup undoes its own steps. Player 1
# (the person who ran it) is never changed: only the extra players' accounts, devices and units are.
#
#   hearth-admin seats-setup            stdin: {"mode": "gpu"|"nested", "seats": [...], "start": bool}
#   hearth-admin seats-remove [--delete-users]
#   hearth-admin seats-acl              stdin: {"pads": {"usb:1-2": 2, "uniq:aa:bb:cc:dd:ee:ff": 1}}
#   hearth-admin seats-start | seats-stop
SEATS_CONFIG = '/etc/hearth/seats.json'
SEATS_ENV_DIR = '/etc/hearth/seats'
SEATS_RULES = '/etc/udev/rules.d/72-hearth-seats.rules'
SEATS_TMPFILES = '/etc/tmpfiles.d/hearth-seats.conf'
SEATS_SDDM = '/etc/sddm.conf.d/zzz-hearth-seats.conf'
SEATS_SYSTEMD_ETC = '/etc/systemd/system'
SEATS_RUN = '/run/hearth-seats'
SEATS_SYS = '/sys'
SEATS_DEV = '/dev'
SEATS_GROUP_FILE = '/etc/group'
SEATS_PASSWD_FILE = '/etc/passwd'
SEATS_PLAYER_GROUPS = ('render', 'gamemode')   # not input, audio, video or wheel: see docs/MULTI-SEAT.md
SEAT_PLAYER_RE = re.compile(r'^hearth-p([2-4])$')
SEAT_PAD_RE = re.compile(r'^(usb:[0-9]{1,3}-[0-9]{1,3}(\.[0-9]{1,3}){0,6}|uniq:[A-Za-z0-9:._-]{4,64})$')
SEAT_OUTPUT_RE = re.compile(r'^(card[0-9]{1,2})-[A-Za-z]+(-[A-Za-z0-9]+){0,4}$')
SEAT_PCI_RE = re.compile(r'^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$')
SEAT_SINK_RE = re.compile(r'^[A-Za-z0-9._:+-]{1,200}$')


class SeatsError(Exception):
    pass


def seats_run(cmd, input=None):
    """Commands for the seats section (tests replace it). Returns (code, output)."""
    try:
        r = subprocess.run(cmd, input=input, capture_output=True, text=True, timeout=120)
        return r.returncode, (r.stdout + r.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, str(e)


def seats_must(cmd, what, input=None):
    code, out = seats_run(cmd, input)
    if code != 0:
        raise SeatsError('%s (%s)' % (what, (out.splitlines() or [' '.join(cmd) + ' failed'])[-1][:200]))
    return out


def seats_read(path, default=''):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def seats_load():
    try:
        with open(SEATS_CONFIG) as f:
            c = json.load(f)
        return c if isinstance(c, dict) else None
    except (OSError, ValueError):
        return None


def seats_atomic_write(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.hearth-tmp'
    with open(tmp, 'w') as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def seats_existing_users():
    names = {}
    for line in seats_read(SEATS_PASSWD_FILE).splitlines():
        f = line.split(':')
        if len(f) >= 7:
            names[f[0]] = f
    return names


def seats_existing_groups():
    return {line.split(':')[0] for line in seats_read(SEATS_GROUP_FILE).splitlines() if ':' in line}


def seats_card_pci(card):
    m = re.findall(r'/([0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7])(?=/|$)',
                   os.path.realpath(os.path.join(SEATS_SYS, 'class/drm', card, 'device')))
    return m[-1] if m else None


def seats_gpu_audio(gpu_pci):
    """The sound functions on the same card as the GPU (its HDMI/DisplayPort sound), as PCI addresses."""
    slot = gpu_pci.rsplit('.', 1)[0]
    out = []
    import glob
    for c in sorted(glob.glob(os.path.join(SEATS_SYS, 'class/sound/card[0-9]*'))):
        m = re.findall(r'/([0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7])(?=/|$)', os.path.realpath(os.path.join(c, 'device')))
        if m and m[-1].rsplit('.', 1)[0] == slot and m[-1] != gpu_pci and m[-1] not in out:
            out.append(m[-1])
    return out


def seats_validate(req, main_user):
    """The request, checked strictly (this runs as root for anyone in wheel at the device) and filled in from the
    system itself (the graphics card of each screen, its Vulkan id and sound), never from the request."""
    if not isinstance(req, dict):
        raise SeatsError('expected a JSON object')
    mode = req.get('mode')
    if mode not in ('gpu', 'nested'):
        raise SeatsError('mode must be "gpu" or "nested"')
    seats = req.get('seats')
    if not isinstance(seats, list) or not 2 <= len(seats) <= 4:
        raise SeatsError('choose 2 to 4 players')
    if not all(isinstance(s, dict) and isinstance(s.get('seat'), int) and not isinstance(s.get('seat'), bool) for s in seats) \
            or sorted(s['seat'] for s in seats) != list(range(1, len(seats) + 1)):
        raise SeatsError('players must be numbered 1 to %d' % len(seats))
    out, outputs, gpus, pads_seen = [], set(), set(), set()
    for s in sorted(seats, key=lambda s: s['seat']):
        n = s['seat']
        user = s.get('user')
        if n == 1:
            if user != main_user:
                raise SeatsError('player 1 must be you (%s)' % main_user)
        elif not isinstance(user, str) or not SEAT_PLAYER_RE.match(user) or user != 'hearth-p%d' % n:
            raise SeatsError('player %d\'s account must be called hearth-p%d' % (n, n))
        output = s.get('output')
        m = SEAT_OUTPUT_RE.match(output) if isinstance(output, str) else None
        if not m or not os.path.isdir(os.path.join(SEATS_SYS, 'class/drm', output)):
            raise SeatsError('player %d\'s screen (%s) isn\'t there' % (n, output))
        if output in outputs:
            raise SeatsError('two players can\'t share one screen')
        outputs.add(output)
        card = m.group(1)
        gpu = seats_card_pci(card)
        if not gpu or not SEAT_PCI_RE.match(gpu):
            raise SeatsError('couldn\'t find the graphics card for %s' % output)
        entry = {'seat': n, 'user': user, 'output': output, 'card': card, 'gpu': gpu,
                 'vk_device': '%s:%s' % (seats_read(os.path.join(SEATS_SYS, 'class/drm', card, 'device/vendor')).replace('0x', ''),
                                         seats_read(os.path.join(SEATS_SYS, 'class/drm', card, 'device/device')).replace('0x', '')),
                 'size': (seats_read(os.path.join(SEATS_SYS, 'class/drm', output, 'modes')).splitlines() or [''])[0].strip() or None,
                 'pads': [], 'audio': None, 'audio_pci': []}
        if not re.fullmatch(r'[0-9a-f]{4}:[0-9a-f]{4}', entry['vk_device']):
            entry['vk_device'] = None
        if entry['size'] and not re.fullmatch(r'\d{2,5}x\d{2,5}', entry['size']):
            entry['size'] = None
        if mode == 'gpu':
            if gpu in gpus:
                raise SeatsError('with a graphics card per player, each player needs a different card')
            gpus.add(gpu)
            entry['audio_pci'] = seats_gpu_audio(gpu)
        pads = s.get('pads') or []
        if not isinstance(pads, list) or len(pads) > 16:
            raise SeatsError('pads must be a list')
        for p in pads:
            if not isinstance(p, str) or not SEAT_PAD_RE.match(p):
                raise SeatsError('%r isn\'t a controller Hearth knows how to recognise' % (p,))
            if p in pads_seen:
                raise SeatsError('a controller can only belong to one player')
            pads_seen.add(p)
            entry['pads'].append(p)
        audio = s.get('audio')
        if audio is not None:
            if not isinstance(audio, str) or not SEAT_SINK_RE.match(audio):
                raise SeatsError('player %d\'s sound output name isn\'t valid' % n)
            entry['audio'] = audio
        out.append(entry)
    return {'version': 1, 'mode': mode, 'main_user': main_user, 'seats': out, 'start': bool(req.get('start'))}


def seats_rules(config):
    """udev rules giving each extra player's devices to that player only: out of logind's seats (so no session
    gets them through "uaccess", and no new seat or login screen appears) and an ACL for the player's account."""
    lines = ['# Hearth multi-seat: written by hearth-admin seats-setup, removed by seats-remove. Don\'t edit.',
             '# Runs after 71-seat.rules (seat tags) and before 73-seat-late.rules (uaccess ACLs).',
             'ACTION=="remove", GOTO="hearth_seats_end"']
    pads = [p for s in config['seats'] if s['seat'] != 1 for p in s.get('pads', [])]
    if any(p.startswith('uniq:') for p in pads):
        lines.append('SUBSYSTEM=="hidraw", IMPORT{parent}="HID_UNIQ"')
    for s in config['seats']:
        if s['seat'] == 1:
            continue
        user = s['user']
        if not SEAT_PLAYER_RE.match(user):
            raise SeatsError('bad account name')
        give = 'ENV{ID_SEAT}="seat-%s", ENV{HEARTH_SEAT_USER}="%s", TAG-="seat", TAG-="master-of-seat", TAG-="uaccess"' % (user, user)
        lines.append('# player %d (%s)' % (s['seat'], user))
        for p in s.get('pads', []):
            if not SEAT_PAD_RE.match(p):
                raise SeatsError('bad controller id')
            kind, val = p.split(':', 1)
            if kind == 'usb':
                lines.append('SUBSYSTEMS=="usb", KERNELS=="%s", SUBSYSTEM=="input|hidraw", %s' % (val, give))
            else:
                lines.append('SUBSYSTEM=="input", ATTRS{uniq}=="%s", %s' % (val, give))
                lines.append('SUBSYSTEM=="hidraw", ENV{HID_UNIQ}=="%s", %s' % (val, give))
        if config['mode'] == 'gpu':
            if not SEAT_PCI_RE.match(s['gpu']):
                raise SeatsError('bad graphics card address')
            lines.append('SUBSYSTEM=="drm", KERNEL=="card[0-9]*", KERNELS=="%s", %s' % (s['gpu'], give))
            for a in s.get('audio_pci', []):
                if not SEAT_PCI_RE.match(a):
                    raise SeatsError('bad sound card address')
                lines.append('SUBSYSTEM=="sound", KERNELS=="%s", %s' % (a, give))
        lines.append('ENV{HEARTH_SEAT_USER}=="%s", ENV{DEVNAME}=="?*", GROUP:="root", MODE:="0660", '
                     'RUN+="/usr/bin/setfacl -m u:%s:rw $devnode"' % (user, user))
    lines.append('LABEL="hearth_seats_end"')
    return '\n'.join(lines) + '\n'


def seats_env(config, s):
    lines = ['# Hearth multi-seat: player %d (written by hearth-admin)' % s['seat'],
             'HEARTH_SEAT_MODE=%s' % config['mode'],
             'HEARTH_SEAT_OUTPUT=%s' % s['output'].split('-', 1)[1],
             'HEARTH_SEAT_HOST_USER=%s' % config['main_user']]
    if config['mode'] == 'gpu':
        lines.append('HEARTH_SEAT_GPU=%s' % s['gpu'])
        if s.get('vk_device'):
            lines.append('HEARTH_SEAT_VK_DEVICE=%s' % s['vk_device'])
    elif s.get('size'):
        lines.append('HEARTH_SEAT_SIZE=%s' % s['size'])
    return '\n'.join(lines) + '\n'


def seats_tmpfiles(config):
    main = config['main_user']
    if not re.fullmatch(r'[a-z_][a-z0-9_.-]{0,31}', main):
        raise SeatsError('unusual account name for player 1')
    lines = ['# Hearth multi-seat (written by hearth-admin): where player 1\'s Game Mode opens the other players\' screens',
             'd %s 0755 %s %s -' % (SEATS_RUN, main, main)]
    for s in config['seats']:
        if s['seat'] != 1:
            lines.append('d %s/%s 2750 %s %s -' % (SEATS_RUN, s['user'], main, s['user']))
    return '\n'.join(lines) + '\n'


def seats_unit(config, s):
    return 'hearth-seat@%s.%s' % (s['user'], 'path' if config['mode'] == 'nested' else 'service')


class SeatsJournal:
    """What seats-setup has done so far, to undo it if a later step fails."""

    def __init__(self):
        self.steps = []

    def write(self, path, text, mode=0o644):
        before = None
        if os.path.exists(path):
            with open(path) as f:
                before = f.read()
        seats_atomic_write(path, text, mode)
        self.steps.append(('file', path, before))

    def user(self, name):
        self.steps.append(('user', name, None))

    def unit(self, name):
        self.steps.append(('unit', name, None))

    def rollback(self):
        for kind, what, before in reversed(self.steps):
            try:
                if kind == 'file':
                    if before is None:
                        os.remove(what)
                    else:
                        seats_atomic_write(what, before)
                elif kind == 'user':
                    seats_run(['userdel', '-r', what])
                elif kind == 'unit':
                    seats_run(['systemctl', 'disable', '--now', what])
            except OSError:
                pass
        seats_run(['udevadm', 'control', '--reload'])
        seats_run(['systemctl', 'daemon-reload'])


def seats_pad_nodes(pad):
    """(sysfs path, /dev node) of a controller's input and hidraw devices, found right now."""
    import glob
    kind, val = pad.split(':', 1)
    found = []
    for cls, pattern in (('input', 'event[0-9]*'), ('input', 'js[0-9]*'), ('hidraw', 'hidraw[0-9]*')):
        for p in sorted(glob.glob(os.path.join(SEATS_SYS, 'class', cls, pattern))):
            real = os.path.realpath(p)
            if '/devices/virtual/' in real:
                continue
            if kind == 'usb':
                hit = re.search(r'/%s(\.[0-9]+)*/' % re.escape(val), real) is not None
            elif cls == 'input':
                hit = seats_read(os.path.join(real, '..', 'uniq')) == val
            else:
                ue = seats_read(os.path.join(real, '..', '..', 'uevent'))
                hit = ('HID_UNIQ=' + val) in ue.splitlines()
            if hit:
                found.append((real, os.path.join(SEATS_DEV, 'input' if cls == 'input' else '', os.path.basename(p)).replace('//', '/')))
    return found


def seats_apply_pads(pads, reconnect=True):
    """After the rules change: clear the old ACLs, have udev apply the new ones, and reconnect the controllers so
    games that already had them open let go (they can only be taken away at open time)."""
    seats_run(['udevadm', 'control', '--reload'])
    for pad in pads:
        nodes = seats_pad_nodes(pad)
        for _, node in nodes:
            seats_run(['setfacl', '-b', node])
        if nodes:
            seats_run(['udevadm', 'trigger', '--action=change'] + [sp for sp, _ in nodes])
        if not reconnect or not nodes:
            continue
        kind, val = pad.split(':', 1)
        auth = os.path.join(SEATS_SYS, 'bus/usb/devices', val, 'authorized')
        if kind == 'usb' and os.path.exists(auth):
            try:
                write_value(auth, 0)
                time.sleep(0.5)
                write_value(auth, 1)
            except OSError:
                pass
        else:
            sps = [sp for sp, _ in nodes]
            seats_run(['udevadm', 'trigger', '--action=remove'] + sps)
            seats_run(['udevadm', 'settle', '--timeout=5'])
            seats_run(['udevadm', 'trigger', '--action=add'] + sps)


def seats_remove_impl(config, delete_users, quiet=False):
    """Undo everything (also what an older or half-finished set-up left). Best effort: never stops half-way."""
    import glob
    import shutil
    config = config or {}
    players = sorted({s.get('user') for s in config.get('seats', []) if SEAT_PLAYER_RE.match(str(s.get('user')))} |
                     {u for u in seats_existing_users() if SEAT_PLAYER_RE.match(u)})
    units = set()
    for wants in glob.glob(os.path.join(SEATS_SYSTEMD_ETC, '*.wants', 'hearth-seat@*')):
        units.add(os.path.basename(wants))
    for u in players:
        units.update({'hearth-seat@%s.service' % u, 'hearth-seat@%s.path' % u})
    if not quiet:
        progress(10, 'Stopping the other players\' screens')
    for u in sorted(units):
        if re.fullmatch(r'hearth-seat@hearth-p[2-4]\.(service|path)', u):
            seats_run(['systemctl', 'disable', '--now', u])
    old_pads = [p for s in config.get('seats', []) for p in s.get('pads', []) if SEAT_PAD_RE.match(str(p))]
    if not quiet:
        progress(35, 'Giving the controllers back')
    for path in [SEATS_RULES, SEATS_TMPFILES] + glob.glob(os.path.join(SEATS_ENV_DIR, 'hearth-p*.env')):
        try:
            os.remove(path)
        except OSError:
            pass
    seats_apply_pads(old_pads, reconnect=not quiet)
    for u in players:
        for node in glob.glob(os.path.join(SEATS_DEV, 'input', '*')) + glob.glob(os.path.join(SEATS_DEV, 'hidraw*')) + \
                glob.glob(os.path.join(SEATS_DEV, 'snd', '*')) + glob.glob(os.path.join(SEATS_DEV, 'dri', 'card*')):
            seats_run(['setfacl', '-x', 'u:' + u, node])
    shutil.rmtree(SEATS_RUN, ignore_errors=True)
    seats_run(['systemctl', 'daemon-reload'])
    removed, kept = [], []
    created = [u for u in config.get('created_users', []) if SEAT_PLAYER_RE.match(str(u))]
    if delete_users:
        if not quiet:
            progress(60, 'Removing the extra players\' accounts')
        for u in created:
            seats_run(['loginctl', 'terminate-user', u])
            code, _ = seats_run(['userdel', '-r', u])
            (removed if code == 0 else kept).append(u)
    kept += [u for u in players if u not in removed and u not in kept]
    if not kept:
        try:
            os.remove(SEATS_SDDM)
        except OSError:
            pass
    if not quiet:
        try:
            os.remove(SEATS_CONFIG)
        except OSError:
            pass
    return {'removed_users': removed, 'kept_users': kept, 'restart': config.get('mode') == 'gpu'}


def seats_setup():
    me = caller().pw_name
    try:
        req = json.loads(sys.stdin.read() or 'null')
    except ValueError:
        fail('expected the layout as JSON on stdin')
    try:
        config = seats_validate(req, me)
    except SeatsError as e:
        fail(str(e))
    previous = seats_load()
    created = list((previous or {}).get('created_users', []))
    if previous:
        progress(5, 'Replacing the previous set-up')
        seats_remove_impl(previous, delete_users=False, quiet=True)
    j = SeatsJournal()
    try:
        progress(15, 'Creating the players\' accounts')
        users = seats_existing_users()
        groups = [g for g in SEATS_PLAYER_GROUPS if g in seats_existing_groups()]
        base = '/var/home' if os.path.isdir('/var/home') else '/home'
        for s in config['seats'][1:]:
            u = s['user']
            if u in users:
                continue
            cmd = ['useradd', '--create-home', '--home-dir', os.path.join(base, u), '--comment', 'Hearth Player %d' % s['seat'],
                   '--shell', '/bin/bash', '--user-group']
            if groups:
                cmd += ['--groups', ','.join(groups)]
            seats_must(cmd + [u], 'couldn\'t create the account for player %d' % s['seat'])
            j.user(u)
            created.append(u)
        progress(35, 'Saving the set-up')
        for s in config['seats'][1:]:
            j.write(os.path.join(SEATS_ENV_DIR, s['user'] + '.env'), seats_env(config, s))
        j.write(SEATS_TMPFILES, seats_tmpfiles(config))
        # The extra accounts aren't for signing in at the login screen.
        hidden = sorted({s['user'] for s in config['seats'][1:]} | {u for u in seats_existing_users() if SEAT_PLAYER_RE.match(u)})
        j.write(SEATS_SDDM, '# Hearth multi-seat: the extra players\' accounts\n[Users]\nHideUsers=%s\n' % ','.join(hidden))
        progress(50, 'Giving each player their controllers')
        j.write(SEATS_RULES, seats_rules(config))
        seats_apply_pads([p for s in config['seats'][1:] for p in s['pads']])
        progress(70, 'Preparing the screens')
        seats_must(['systemd-tmpfiles', '--create', SEATS_TMPFILES], 'couldn\'t prepare the players\' screen folders')
        seats_must(['systemctl', 'daemon-reload'], 'couldn\'t reload systemd')
        progress(80, 'Turning it on' if config['start'] else 'Setting it up for the next start')
        for s in config['seats'][1:]:
            unit = seats_unit(config, s)
            seats_must(['systemctl', 'enable'] + (['--now'] if config['start'] else []) + [unit],
                       'couldn\'t turn on player %d\'s session' % s['seat'])
            j.unit(unit)
        progress(95, 'Finishing')
        saved = {k: config[k] for k in ('version', 'mode', 'main_user', 'seats')}
        saved.update(enabled=config['start'], created_users=sorted(set(created)),
                     files=[SEATS_RULES, SEATS_TMPFILES, SEATS_SDDM] + [os.path.join(SEATS_ENV_DIR, s['user'] + '.env') for s in config['seats'][1:]],
                     units=[seats_unit(config, s) for s in config['seats'][1:]])
        seats_atomic_write(SEATS_CONFIG, json.dumps(saved, indent=1) + '\n')
    except (SeatsError, OSError) as e:
        progress(100, 'Undoing the changes')
        j.rollback()
        try:
            os.remove(SEATS_CONFIG)
        except OSError:
            pass
        fail('multi-seat couldn\'t be set up: %s. %s' % (e, 'The earlier multi-seat set-up was turned off; player 1 '
             'works as normal.' if previous else 'Nothing was changed.'))
    progress(100, 'Done')
    print(json.dumps({'ok': True, 'mode': config['mode'], 'seats': saved['seats'], 'enabled': saved['enabled'],
                      'created_users': saved['created_users'], 'restart': config['mode'] == 'gpu'}))


def seats_remove(delete_users):
    caller()
    r = seats_remove_impl(seats_load(), delete_users)
    progress(100, 'Back to one player')
    print(json.dumps(dict(r, ok=True)))


def seats_acl():
    caller()
    config = seats_load()
    if not config:
        fail('multi-seat isn\'t set up')
    try:
        req = json.loads(sys.stdin.read() or 'null')
        pads = req['pads']
        if not isinstance(pads, dict) or len(pads) > 32:
            raise ValueError
    except (ValueError, KeyError, TypeError):
        fail('expected {"pads": {"<controller>": <player>, ...}}')
    numbers = {s['seat'] for s in config['seats']}
    for p, n in pads.items():
        if not SEAT_PAD_RE.match(p):
            fail('%r isn\'t a controller Hearth knows how to recognise' % p)
        if not isinstance(n, int) or isinstance(n, bool) or n not in numbers:
            fail('there\'s no player %r' % (n,))
    before = {p: s['seat'] for s in config['seats'] for p in s.get('pads', [])}
    for s in config['seats']:
        s['pads'] = sorted(p for p, n in pads.items() if n == s['seat'])
    old_rules = seats_read(SEATS_RULES, None)
    try:
        seats_atomic_write(SEATS_RULES, seats_rules(config))
    except (SeatsError, OSError) as e:
        if old_rules is not None:
            seats_atomic_write(SEATS_RULES, old_rules + '\n')
        fail('couldn\'t move the controller: %s' % e)
    seats_atomic_write(SEATS_CONFIG, json.dumps(config, indent=1) + '\n')
    changed = sorted(p for p in set(before) | set(pads) if before.get(p, 1) != pads.get(p, 1))
    seats_apply_pads(changed)
    print(json.dumps({'ok': True, 'pads': {p: pads.get(p, 1) for p in sorted(set(before) | set(pads))}, 'changed': changed}))


def seats_start_stop(on):
    caller()
    config = seats_load()
    if not config:
        fail('multi-seat isn\'t set up')
    problems = []
    for s in config['seats'][1:]:
        unit = seats_unit(config, s)
        if not re.fullmatch(r'hearth-seat@hearth-p[2-4]\.(service|path)', unit):
            continue
        code, out = seats_run(['systemctl', 'enable' if on else 'disable', '--now', unit])
        if not on:
            seats_run(['systemctl', 'stop', 'hearth-seat@%s.service' % s['user']])
        if code != 0:
            problems.append('player %d: %s' % (s['seat'], (out.splitlines() or ['failed'])[-1][:200]))
    config['enabled'] = on
    seats_atomic_write(SEATS_CONFIG, json.dumps(config, indent=1) + '\n')
    if problems and on:
        fail('some players couldn\'t start (%s)' % '; '.join(problems))
    print(json.dumps({'ok': True, 'enabled': on, 'mode': config['mode']}))


SPACE_DEV_RE = re.compile(r'^/dev/[A-Za-z0-9][A-Za-z0-9/_-]{0,63}$')


def space_args(args):
    """space-grow's arguments, checked strictly before anything runs as root: --from /dev/<name> or free,
    --gb 1..65536, optionally --dry-run. Returns the list for hearth-space, or None."""
    out, seen = [], set()
    i = 0
    while i < len(args):
        a = args[i]
        if a in seen:
            return None
        seen.add(a)
        if a == '--from' and i + 1 < len(args) and (args[i + 1] == 'free' or (SPACE_DEV_RE.match(args[i + 1]) and '..' not in args[i + 1])):
            out += [a, args[i + 1]]
            i += 2
        elif a == '--gb' and i + 1 < len(args) and re.fullmatch(r'[1-9][0-9]{0,4}', args[i + 1]) and int(args[i + 1]) <= 65536:
            out += [a, args[i + 1]]
            i += 2
        elif a == '--dry-run':
            out.append(a)
            i += 1
        else:
            return None
    return out if {'--from', '--gb'} <= seen else None


def space(sub, args):
    helper = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'hearth-space')
    os.execv(sys.executable, [sys.executable, helper, sub] + args)


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    if cmd == 'tdp-info':
        return tdp_info()
    if cmd == 'space-status' and len(argv) == 2:
        return space('status', [])   # read-only; without root it leaves out what needs the drive itself
    if os.geteuid() != 0:
        fail('needs root (run through pkexec)')
    if cmd == 'autologin' and len(argv) == 3:
        autologin(argv[2])
    elif cmd == 'hostname' and len(argv) == 3:
        hostname(argv[2])
    elif cmd == 'password':
        password()
    elif cmd == 'update-status':
        print(json.dumps(bootc_status()))
    elif cmd == 'update-check':
        update_check()
    elif cmd == 'update':
        update()
    elif cmd == 'tdp' and len(argv) == 3:
        tdp(argv[2])
    elif cmd == 'hibernate-setup':
        hibernate_setup()
    elif cmd == 'seats-setup':
        seats_setup()
    elif cmd == 'seats-remove' and len(argv) in (2, 3) and argv[2:] in ([], ['--delete-users']):
        seats_remove(argv[2:] == ['--delete-users'])
    elif cmd == 'seats-acl':
        seats_acl()
    elif cmd in ('seats-start', 'seats-stop'):
        seats_start_stop(cmd == 'seats-start')
    elif cmd == 'space-grow':
        args = space_args(argv[2:])
        if args is None:
            fail('usage: hearth-admin space-grow --from /dev/... | free --gb N [--dry-run]')
        space('grow', args)
    elif cmd == 'space-clear-journal' and len(argv) == 2:
        space('clear-journal', [])
    elif cmd in ('import-scan', 'import-run', 'import-unmount', 'takeover-plan', 'takeover-run'):
        # Bringing games and files over from other drives, and removing the old system afterwards: their own
        # scripts, run as root like the rest.
        name, sub = cmd.split('-', 1)
        helper = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'hearth-' + name)
        os.execv(sys.executable, [sys.executable, helper, sub])
    else:
        fail('usage: hearth-admin autologin on|off | hostname NAME | password | update-status | update-check | update | tdp-info | tdp WATTS | seats-setup | seats-remove [--delete-users] | seats-acl | seats-start | seats-stop | space-status | space-grow --from DEV|free --gb N [--dry-run] | space-clear-journal')


if __name__ == '__main__':
    main(sys.argv)
