#!/usr/bin/python3
"""hearth-import: brings games and personal files from this PC's other drives into Hearth.

Run as root through hearth-admin (pkexec): other drives have to be mounted, and their files may belong to
another account (a Steam Deck's "deck" user, Windows). It only ever reads from those drives, except when
you choose Move, and only ever writes into your own home folder.

  hearth-import scan        JSON: every other drive, what's on it (Steam, Epic and GOG games, personal
                            folders, with sizes) and why a drive can't be read (BitLocker, encrypted...)
  hearth-import run         stdin: {"mode": "copy"|"move", "items": [keys from scan], "root": "<games folder>"}
                            copies them in (progress as "stage: {json}" lines), then one JSON result line
  hearth-import unmount     unmounts what scan mounted

Move (Beta Experimental, docs/MOVE-AND-GROW.md): each item is copied, then checked file by file against the
original (every file there, same size, same bytes, read back from the drive), registered (Steam's manifest),
and only then is the original deleted, with the launcher's own record of it (Steam's appmanifest, Epic's .item,
Heroic's installed.json entry, Lutris' "installed" mark). Anything that doesn't check out is kept, and the copy
is removed. Windows' drive is only written to when Windows was fully shut down (no Fast Startup or
hibernation): otherwise the game is copied and the original stays. Stopping (SIGTERM, or the file
/run/user/<uid>/hearth-import.cancel) finishes or removes the item in progress, never half of both.

Drives are mounted read-only under /run/hearth-import/. Steam games go into your Steam library with their
manifest (so Steam sees them as installed and only checks them), plus their Proton data from Linux (local
saves). Epic and GOG games go into Hearth's games folder; the Hearth app registers them afterwards.
Personal folders go into the same folder in your home, under "Imported from <drive>".
"""
import json
import os
import pwd
import re
import shutil
import signal
import sqlite3
import subprocess
import sys
import time

MNT = '/run/hearth-import'
READABLE = {'ntfs', 'ext4', 'ext3', 'btrfs', 'exfat', 'vfat', 'xfs', 'f2fs'}
LOCKED = {'BitLocker': "it's locked with BitLocker. Turn BitLocker off in Windows (Settings › Privacy & security › Device encryption), then scan again",
          'crypto_LUKS': "it's encrypted. Unlock it in Mantel's file manager first, then scan again"}
SYSTEM_MOUNTS = ('/', '/sysroot', '/boot', '/boot/efi', '/efi', '/var', '/etc', '/usr', '/var/home', '/home', '/sysroot/ostree/deploy')
SKIP_APPS = {'228980', '250820', '1070560', '1391110', '1628350', '1493710', '1826330', '2180100', '2348590'}
SKIP_NAMES = ('Steamworks', 'Proton', 'Steam Linux Runtime', 'SteamVR')
FOLDERS = ['Desktop', 'Documents', 'Downloads', 'Music', 'Pictures', 'Videos']
SKIP_USERS = {'Public', 'Default', 'Default User', 'All Users', 'defaultuser0', 'WDAGUtilityAccount'}
current = {'proc': None, 'stop': False, 'partial': [], 'critical': False, 'flag': None}
GIB = 1024 ** 3


def fail(msg):
    print('error: ' + msg, flush=True)
    sys.exit(1)


def caller():
    uid = os.environ.get('PKEXEC_UID')
    if not uid or not uid.isdigit():
        fail('run this through hearth-admin')
    return pwd.getpwuid(int(uid))


# ---------------------------------------------------------------------- small helpers

def vdf_parse(text):
    """Valve's KeyValues text format, enough for appmanifest and libraryfolders."""
    tokens = re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', text)
    root, stack, key = {}, [], None
    cur = root
    for s, brace in tokens:
        if brace == '{':
            new = {}
            if key is not None:
                cur[key] = new
            stack.append(cur)
            cur, key = new, None
        elif brace == '}':
            cur = stack.pop() if stack else root
            key = None
        elif key is None:
            key = s
        else:
            cur[key] = s.replace('\\\\', '\\')
            key = None
    return root


def vdf_load(p):
    try:
        with open(p, encoding='utf-8', errors='replace') as f:
            return vdf_parse(f.read())
    except OSError:
        return {}


def ci(d, key):
    """Case-insensitive dict lookup (Steam isn't consistent about case)."""
    for k, v in d.items():
        if k.lower() == key.lower():
            return v
    return None


def isdir(p):
    try:
        return os.path.isdir(p) and not os.path.islink(p)
    except OSError:
        return False


def listdir(p):
    try:
        return sorted(os.listdir(p))
    except OSError:
        return []


def du(p, timeout=20):
    """Size of a folder in bytes (None if it takes too long)."""
    try:
        r = subprocess.run(['du', '-sb', '--', p], capture_output=True, text=True, timeout=timeout)
        return int(r.stdout.split()[0]) if r.returncode == 0 and r.stdout else None
    except (subprocess.TimeoutExpired, ValueError, IndexError):
        return None


def inside(mnt, p):
    """A path from the scanned system (/home/deck/...) as a path under its mount, if it's on that drive."""
    if not p or not p.startswith('/'):
        return None
    for base in ('', '/var'):
        cand = os.path.normpath(mnt + base + p)
        if os.path.exists(cand):
            return cand
    return None


# ---------------------------------------------------------------------- drives

def drives():
    r = subprocess.run(['lsblk', '-J', '-b', '-o', 'NAME,KNAME,PATH,FSTYPE,LABEL,PARTLABEL,SIZE,MOUNTPOINTS,TYPE,RM,TRAN,MODEL'],
                       capture_output=True, text=True)
    try:
        tree = json.loads(r.stdout).get('blockdevices', [])
    except ValueError:
        return []
    out = []

    def walk(devs, disk=None):
        for d in devs:
            parent = disk or d
            if d.get('children'):
                walk(d['children'], parent)
                continue
            mps = [m for m in (d.get('mountpoints') or []) if m]
            if any(m in SYSTEM_MOUNTS or m.startswith(('/sysroot', '/boot', '/usr', '/etc')) for m in mps):
                continue
            fs = d.get('fstype') or ''
            size = int(d.get('size') or 0)
            if fs in ('swap', '') or (fs == 'vfat' and size < 2 * 1024**3) or (fs == 'ntfs' and size < 3 * 1024**3):
                continue   # swap, EFI, Microsoft's small recovery partition, unformatted
            if fs not in READABLE and fs not in LOCKED:
                continue
            out.append({'id': d['kname'], 'dev': d['path'], 'fs': fs, 'size': size,
                        'label': d.get('label') or d.get('partlabel') or '',
                        'removable': bool(d.get('rm')) or (parent.get('tran') in ('usb', 'mmc')),
                        'disk': (parent.get('model') or '').strip(), 'mounts': mps})
    walk(tree)
    return out


def mount_tries(fs):
    return {'ntfs': [['-t', 'ntfs3', '-o', 'ro'], ['-t', 'ntfs-3g', '-o', 'ro'], ['-t', 'ntfs3', '-o', 'ro,force']],
            'btrfs': [['-o', 'ro,subvolid=5'], ['-o', 'ro']]}.get(fs, [['-o', 'ro']])


def mount(d):
    """Mount point for a drive: where it's already mounted, or read-only under /run/hearth-import."""
    for m in d['mounts']:
        if os.path.isdir(m):
            return m, None
    target = os.path.join(MNT, d['id'])
    d['ours'] = True
    if os.path.ismount(target):
        return target, None
    os.makedirs(target, exist_ok=True)
    err = ''
    for opts in mount_tries(d['fs']):
        r = subprocess.run(['mount', *opts, d['dev'], target], capture_output=True, text=True)
        if r.returncode == 0:
            # Opened only by forcing it (Windows hibernated or with Fast Startup): readable, never written to.
            d['forced'] = 'force' in opts[-1]
            d['mountOpts'] = opts
            return target, None
        err = (r.stderr or '').strip()
    if d['fs'] == 'ntfs' and re.search(r'hibernat|dirty|unclean|fast', err, re.I):
        return None, "Windows wasn't fully shut down (Fast Startup or hibernation). In Windows, hold Shift while choosing Shut down, then scan again"
    return None, "it couldn't be opened" + (': ' + err.splitlines()[-1] if err else '')


# ---------------------------------------------------------------------- what's on a drive

def homes(mnt):
    """Linux home folders on a drive: /home/*, /var/home/* (Fedora Atomic, Bazzite), a home partition
    (SteamOS keeps /home on its own partition), btrfs subvolumes (home, @home, root/...)."""
    found = []
    roots = [mnt, os.path.join(mnt, 'home'), os.path.join(mnt, 'var', 'home'), os.path.join(mnt, '@home'),
             os.path.join(mnt, 'root', 'home'), os.path.join(mnt, 'root', 'var', 'home')]
    for sub in listdir(mnt):   # btrfs top level: <subvolume>/home, <subvolume>/var/home (ostree deploys too)
        roots += [os.path.join(mnt, sub, 'home'), os.path.join(mnt, sub, 'var', 'home')]
    for r in roots:
        for u in listdir(r):
            h = os.path.join(r, u)
            if isdir(h) and any(os.path.exists(os.path.join(h, x)) for x in ('.local', '.steam', '.config', '.var')):
                real = os.path.realpath(h)
                if real not in found:
                    found.append(real)
    return found


def windows_users(mnt):
    base = os.path.join(mnt, 'Users')
    return [os.path.join(base, u) for u in listdir(base)
            if u not in SKIP_USERS and isdir(os.path.join(base, u)) and not u.startswith(('.', '$'))]


def steam_libraries(mnt, kind, home_list):
    libs = []
    if kind == 'windows' or os.path.isdir(os.path.join(mnt, 'Program Files (x86)')):
        libs += [os.path.join(mnt, 'Program Files (x86)', 'Steam'), os.path.join(mnt, 'Program Files', 'Steam')]
    for h in home_list:
        libs += [os.path.join(h, '.local', 'share', 'Steam'), os.path.join(h, '.var', 'app', 'com.valvesoftware.Steam', '.local', 'share', 'Steam'),
                 os.path.join(h, '.var', 'app', 'com.valvesoftware.Steam', 'data', 'Steam')]
        link = os.path.join(h, '.steam', 'steam')
        if os.path.islink(link):
            t = inside(mnt, os.readlink(link))
            if t:
                libs.append(t)
    # Libraries at the top of a drive (an SD card, a games drive) or one level down.
    libs += [mnt] + [os.path.join(mnt, x) for x in listdir(mnt)]
    out = []
    for lib in libs:
        sa = os.path.join(lib, 'steamapps')
        if isdir(sa):
            real = os.path.realpath(sa)
            if real not in out:
                out.append(real)
            # More libraries on the same drive.
            lf = ci(vdf_load(os.path.join(sa, 'libraryfolders.vdf')), 'libraryfolders') or {}
            for e in lf.values():
                p = ci(e, 'path') if isinstance(e, dict) else e
                q = inside(mnt, p) if p and p.startswith('/') else None
                if q and isdir(os.path.join(q, 'steamapps')):
                    r2 = os.path.realpath(os.path.join(q, 'steamapps'))
                    if r2 not in out:
                        out.append(r2)
    return out


def steam_games(steamapps, drive_id):
    games = []
    for f in listdir(steamapps):
        m = re.fullmatch(r'appmanifest_(\d+)\.acf', f)
        if not m:
            continue
        man = os.path.join(steamapps, f)
        st = ci(vdf_load(man), 'AppState') or {}
        appid, name, idir = ci(st, 'appid') or m.group(1), ci(st, 'name') or '', ci(st, 'installdir') or ''
        try:
            flags = int(ci(st, 'StateFlags') or 0)
        except ValueError:
            flags = 0
        if appid in SKIP_APPS or not name or not idir or any(name.startswith(p) for p in SKIP_NAMES):
            continue
        if '/' in idir or '\\' in idir or idir in ('.', '..'):
            continue   # never a real game folder (and steamapps/common/.. would be the whole library)
        if not flags & 4 or flags & (256 | 1024 | 524288 | 1048576 | 2097152 | 4194304):
            continue   # not fully installed, or Steam is in the middle of updating it
        game = os.path.join(steamapps, 'common', idir)
        if not isdir(game):
            continue
        try:
            size = int(ci(st, 'SizeOnDisk') or 0) or None
        except ValueError:
            size = None
        compat = os.path.join(steamapps, 'compatdata', appid)
        games.append({'key': f'steam:{drive_id}:{appid}', 'appid': appid, 'name': name, 'size': size or du(game, 60),
                      'path': game, 'manifest': man, 'installdir': idir,
                      'compat': compat if isdir(compat) else None,
                      'records': [{'type': 'file', 'path': man}]})
    return games


def epic_games(mnt, kind, home_list, all_mounts, drive_id):
    out = []
    if kind == 'windows':
        mdir = os.path.join(mnt, 'ProgramData', 'Epic', 'EpicGamesLauncher', 'Data', 'Manifests')
        for f in listdir(mdir):
            if not f.endswith('.item'):
                continue
            try:
                with open(os.path.join(mdir, f), encoding='utf-8', errors='replace') as fh:
                    it = json.load(fh)
            except (OSError, ValueError):
                continue
            if it.get('bIsIncompleteInstall') or not it.get('AppName') or not it.get('InstallLocation'):
                continue
            if it.get('MainGameAppName') and it.get('MainGameAppName') != it.get('AppName'):
                continue   # DLC
            path = windows_path(it['InstallLocation'], mnt, all_mounts)
            if path:
                out.append({'key': f'epic:{drive_id}:{it["AppName"]}', 'app': it['AppName'], 'name': it.get('DisplayName') or it['AppName'],
                            'size': int(it.get('InstallSize') or 0) or du(path, 60), 'path': path,
                            'records': [{'type': 'file', 'path': os.path.join(mdir, f)}]})
    for h in home_list:   # Heroic (Epic through legendary) on Linux
        for cfg in (os.path.join(h, '.config', 'heroic', 'legendaryConfig', 'legendary', 'installed.json'),
                    os.path.join(h, '.var', 'app', 'com.heroicgameslauncher.hgl', 'config', 'heroic', 'legendaryConfig', 'legendary', 'installed.json'),
                    os.path.join(h, '.config', 'legendary', 'installed.json')):
            try:
                with open(cfg) as fh:
                    recs = json.load(fh)
            except (OSError, ValueError):
                continue
            for app, e in recs.items():
                if not isinstance(e, dict) or e.get('is_dlc'):
                    continue
                path = inside(mnt, e.get('install_path') or '')
                if path and isdir(path) and not any(x['app'] == app for x in out):
                    out.append({'key': f'epic:{drive_id}:{app}', 'app': app, 'name': e.get('title') or app,
                                'size': int(e.get('install_size') or 0) or du(path, 60), 'path': path,
                                'records': [{'type': 'json-key', 'path': cfg, 'key': app}]})
    return out


def windows_path(p, mnt, all_mounts):
    """C:\\Games\\X: on this drive if it's there, otherwise on another Windows drive (D:, E:...)."""
    rel = re.sub(r'^[A-Za-z]:[\\/]*', '', p).replace('\\', '/')
    for base in [mnt] + [m for m in all_mounts if m != mnt]:
        cand = os.path.join(base, rel)
        if isdir(cand):
            return cand
    return None


def gog_games(mnt, kind, home_list, drive_id):
    places = []
    if kind == 'windows' or isdir(os.path.join(mnt, 'GOG Games')):
        places += [os.path.join(mnt, 'GOG Games'), os.path.join(mnt, 'Program Files (x86)', 'GOG Galaxy', 'Games'),
                   os.path.join(mnt, 'Program Files', 'GOG Galaxy', 'Games'), os.path.join(mnt, 'Games')]
    for h in home_list:
        places += [os.path.join(h, 'Games', 'Heroic'), os.path.join(h, 'Games'), os.path.join(h, 'GOG Games')]
    out, seen = [], set()
    for base in places:
        for g in listdir(base):
            d = os.path.join(base, g)
            if not isdir(d):
                continue
            for f in listdir(d):
                m = re.fullmatch(r'goggame-(\d+)\.info', f)
                if not m:
                    continue
                try:
                    with open(os.path.join(d, f), encoding='utf-8', errors='replace') as fh:
                        info = json.load(fh)
                except (OSError, ValueError):
                    continue
                gid = str(info.get('gameId') or m.group(1))
                if info.get('rootGameId') and str(info['rootGameId']) != gid:
                    continue   # DLC
                if gid in seen:
                    continue
                seen.add(gid)
                out.append({'key': f'gog:{drive_id}:{gid}', 'id': gid, 'name': info.get('name') or g, 'size': du(d, 60), 'path': d})
    return out


def lutris_games(mnt, home_list, drive_id):
    """Games installed with Lutris (its database, pga.db, plus each game's settings file for the program)."""
    out = []
    for h in home_list:
        for base in (os.path.join(h, '.local', 'share', 'lutris'), os.path.join(h, '.var', 'app', 'net.lutris.Lutris', 'data', 'lutris')):
            db = os.path.join(base, 'pga.db')
            if not os.path.isfile(db):
                continue
            cfgdir = os.path.join(os.path.dirname(os.path.dirname(base)) if '.var' in base else os.path.join(h, '.config'), 'lutris', 'games')
            if '.var' in base:
                cfgdir = os.path.join(h, '.var', 'app', 'net.lutris.Lutris', 'config', 'lutris', 'games')
            try:
                con = sqlite3.connect(f'file:{db}?mode=ro&immutable=1', uri=True)
                rows = con.execute('SELECT name, slug, runner, directory, configpath FROM games WHERE installed = 1').fetchall()
                con.close()
            except sqlite3.Error:
                continue
            for name, slug, runner, directory, configpath in rows:
                path = inside(mnt, directory or '')
                if not path or not isdir(path) or path.rstrip('/') == h.rstrip('/'):
                    continue
                exe = None
                try:
                    with open(os.path.join(cfgdir, (configpath or '') + '.yml')) as f:
                        m = re.search(r'^\s+exe:\s*(.+?)\s*$', f.read(), re.M)
                        exe = m.group(1).strip('\'"') if m else None
                except OSError:
                    pass
                out.append({'key': f'lutris:{drive_id}:{slug}', 'name': name or slug, 'slug': slug, 'runner': runner or '',
                            'size': du(path, 60), 'path': path, 'oldDir': directory, 'exe': exe,
                            'records': [{'type': 'lutris', 'path': db, 'slug': slug}]})
    return out


def personal_files(kind, mnt, home_list, drive_id):
    users = windows_users(mnt) if kind == 'windows' else home_list
    out = []
    for u in users:
        who = os.path.basename(u)
        for name in FOLDERS:
            p = os.path.join(u, name)
            if isdir(p) and listdir(p):
                size = du(p)
                if size is None or size > 0:
                    out.append({'key': f'files:{drive_id}:{who}:{name}', 'name': name, 'user': who, 'size': size, 'path': p})
    return out


def describe(mnt, d, home_list):
    if os.path.isdir(os.path.join(mnt, 'Windows', 'System32')):
        return 'windows', 'Windows'
    rel = ''
    for p in (os.path.join(mnt, 'etc', 'os-release'), os.path.join(mnt, 'usr', 'lib', 'os-release')):
        try:
            rel = open(p).read()
            break
        except OSError:
            pass
    m = re.search(r'^PRETTY_NAME="?([^"\n]+)', rel, re.M)
    if any(os.path.basename(h) == 'deck' for h in home_list):
        return 'linux', 'SteamOS' if not m else m.group(1)
    if m:
        return 'linux', m.group(1)
    if home_list:
        return 'linux', 'Linux'
    return 'data', 'SD card' if d['removable'] and d['fs'] in ('ext4', 'exfat', 'btrfs') else 'Drive'


def scan():
    os.makedirs(MNT, exist_ok=True)
    ds = drives()
    mounted = []
    for d in ds:
        if d['fs'] in LOCKED:
            d['problem'] = LOCKED[d['fs']]
            continue
        mnt, problem = mount(d)
        d['mount'] = mnt
        if problem:
            d['problem'] = problem
        if mnt:
            mounted.append(mnt)
    windows_mounts = [d['mount'] for d in ds if d.get('mount') and d['fs'] == 'ntfs']
    for d in ds:
        mnt = d.get('mount')
        d.update({'kind': 'locked' if d['fs'] in LOCKED else 'unreadable', 'name': d['label'] or d['disk'] or d['dev'],
                  'steam': [], 'epic': [], 'gog': [], 'lutris': [], 'files': []})
        if not mnt:
            continue
        home_list = homes(mnt)
        kind, osname = describe(mnt, d, home_list)
        d['kind'], d['os'] = kind, osname
        d['name'] = d['label'] or osname
        seen = set()
        for sa in steam_libraries(mnt, kind, home_list):
            for g in steam_games(sa, d['id']):
                if g['appid'] not in seen:
                    seen.add(g['appid'])
                    d['steam'].append(g)
        d['epic'] = epic_games(mnt, kind, home_list, windows_mounts, d['id'])
        d['gog'] = gog_games(mnt, kind, home_list, d['id'])
        d['lutris'] = lutris_games(mnt, home_list, d['id'])
        if kind in ('windows', 'linux'):
            d['files'] = personal_files(kind, mnt, home_list, d['id'])
    user = caller()
    usage = shutil.disk_usage(user.pw_dir)
    return {'free': usage.free, 'drives': ds}


# ---------------------------------------------------------------------- copying

def user_steamapps(user):
    for p in (os.path.join(user.pw_dir, '.local', 'share', 'Steam'), os.path.join(user.pw_dir, '.steam', 'steam'),
              os.path.join(user.pw_dir, '.var', 'app', 'com.valvesoftware.Steam', '.local', 'share', 'Steam')):
        if os.path.isdir(p):
            return os.path.join(os.path.realpath(p), 'steamapps')
    return os.path.join(user.pw_dir, '.local', 'share', 'Steam', 'steamapps')


def under(path, base):
    path, base = os.path.realpath(path), os.path.realpath(base)
    return path == base or path.startswith(base + os.sep)


def chown_tree(p, user):
    """Hands what was copied (and any folders made for it) to you."""
    if not os.path.exists(p):
        return
    subprocess.run(['chown', '-R', f'{user.pw_uid}:{user.pw_gid}', '--', p], capture_output=True)
    parent = os.path.dirname(os.path.realpath(p))
    while under(parent, user.pw_dir) and parent != os.path.realpath(user.pw_dir):
        try:
            if os.stat(parent).st_uid == 0:
                os.chown(parent, user.pw_uid, user.pw_gid)
        except OSError:
            pass
        parent = os.path.dirname(parent)


def stage(**info):
    print('stage: ' + json.dumps(info), flush=True)


def rsync(src, dst, on_bytes):
    """Copies src/ into dst/, calling on_bytes(done, bps) as it goes. rsync checks every file it writes."""
    os.makedirs(dst, exist_ok=True)
    cmd = ['rsync', '-rlt', '--partial', '--info=progress2', '--no-inc-recursive', '--no-human-readable',
           '--chmod=Du=rwx,Dgo=rx,Fu=rw,Fgo=r', '--', src.rstrip('/') + '/', dst.rstrip('/') + '/']
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1)
    current['proc'] = p
    buf = ''
    while True:
        ch = p.stdout.read(1)
        if not ch:
            break
        if ch in '\r\n':
            m = re.match(r'\s*([\d,]+)\s+(\d+)%\s+([\d.,]+)([kMG]?B)/s', buf)
            if m:
                done = int(m.group(1).replace(',', ''))
                mult = {'B': 1, 'kB': 1e3, 'MB': 1e6, 'GB': 1e9}.get(m.group(4), 1)
                on_bytes(done, float(m.group(3).replace(',', '')) * mult)
            buf = ''
        else:
            buf += ch
    err = p.stderr.read()
    current['proc'] = None
    if p.wait() != 0:
        raise RuntimeError((err or 'copy failed').strip().splitlines()[-1])


def fix_manifest(src, dst, installdir):
    """Steam's manifest from the other system, marked fully installed (Steam checks the files on next start)."""
    with open(src, encoding='utf-8', errors='replace') as f:
        text = f.read()
    text = re.sub(r'("StateFlags"\s*)"\d+"', r'\1"4"', text, flags=re.I)
    text = re.sub(r'("installdir"\s*)"[^"]*"', lambda m: m.group(1) + '"' + installdir.replace('\\', '\\\\') + '"', text, flags=re.I)
    text = re.sub(r'\s*"LauncherPath"\s*"[^"]*"', '', text, flags=re.I)
    with open(dst, 'w', encoding='utf-8') as f:
        f.write(text)


class Stopped(Exception):
    pass


class Keep(Exception):
    """The copy is good, but the original can't (or mustn't) be deleted: it stays where it was."""


class VerifyError(Exception):
    pass


def stop_requested():
    if current['stop']:
        return True
    flag = current.get('flag')
    if flag and os.path.lexists(flag):
        current['stop'] = True
        p = current['proc']
        if p and p.poll() is None:
            p.terminate()
    return current['stop']


def same_bytes(a, b, on_bytes=None, chunk=4 * 1024 * 1024):
    """True if files a and b hold the same bytes. b (the new copy) is read back from the drive, not from memory."""
    with open(a, 'rb') as fa, open(b, 'rb') as fb:
        try:
            os.posix_fadvise(fb.fileno(), 0, 0, os.POSIX_FADV_DONTNEED)
        except (AttributeError, OSError):
            pass
        while True:
            if stop_requested():
                raise Stopped()
            x, y = fa.read(chunk), fb.read(chunk)
            if x != y:
                return False
            if not x:
                return True
            if on_bytes:
                on_bytes(len(x))


def verify_tree(src, dst, on_bytes=None):
    """Checks that every file and link under src has an identical copy under dst: the same file count, sizes and
    contents (compared byte for byte). Returns (files, bytes); raises VerifyError with what's wrong."""
    import stat
    if not os.path.isdir(dst) or os.path.islink(dst):
        raise VerifyError("the copy isn't there")
    files = total = 0
    for root, dirs, names in os.walk(src, followlinks=False):
        rel = os.path.relpath(root, src)
        troot = dst if rel == '.' else os.path.join(dst, rel)
        if not os.path.isdir(troot) or os.path.islink(troot):
            raise VerifyError(f'the folder "{rel}" is missing from the copy')
        entries = names + [d for d in dirs if os.path.islink(os.path.join(root, d))]
        for name in entries:
            a, b = os.path.join(root, name), os.path.join(troot, name)
            what = os.path.normpath(os.path.join(rel, name))
            st = os.lstat(a)
            if stat.S_ISLNK(st.st_mode):
                if not os.path.islink(b) or os.readlink(a) != os.readlink(b):
                    raise VerifyError(f'the link "{what}" is different in the copy')
            elif stat.S_ISREG(st.st_mode):
                try:
                    tb = os.lstat(b)
                except OSError:
                    raise VerifyError(f'"{what}" is missing from the copy')
                if not stat.S_ISREG(tb.st_mode) or tb.st_size != st.st_size:
                    raise VerifyError(f'"{what}" has a different size in the copy')
                if not same_bytes(a, b, on_bytes):
                    raise VerifyError(f'"{what}" is different in the copy')
                total += st.st_size
            else:
                raise VerifyError(f'"{what}" is a special file that can\'t be copied')
            files += 1
    # Count once more from the copy's side: everything that was checked is really there.
    found = 0
    for root, dirs, names in os.walk(dst, followlinks=False):
        rel = os.path.relpath(root, dst)
        sroot = src if rel == '.' else os.path.join(src, rel)
        found += sum(1 for n in names + [d for d in dirs if os.path.islink(os.path.join(root, d))]
                     if os.path.lexists(os.path.join(sroot, n)))
    if found != files:
        raise VerifyError(f'the copy has {found} of {files} files')
    return files, total


def owner_mount(path, mounts):
    """The longest mount point that path is under (which drive a file is on)."""
    best = None
    for m in mounts:
        if m and under(path, m) and (best is None or len(m) > len(best)):
            best = m
    return best


def is_readonly(mnt):
    try:
        return bool(os.statvfs(mnt).f_flag & os.ST_RDONLY)
    except OSError:
        return True


def ntfs_writable(dev):
    """(ok, why): whether Windows' NTFS drive may be written to. Never when Windows is hibernated or was shut
    down with Fast Startup on (its drive is still 'in use' by Windows, and writing to it loses data)."""
    hint = "Windows wasn't fully shut down (Fast Startup or hibernation), so Hearth only read from it. The copy in Hearth is fine; to free the space, start Windows, hold Shift while choosing Shut down, then move it again"
    if shutil.which('ntfs-3g.probe'):
        r = subprocess.run(['ntfs-3g.probe', '--readwrite', dev], capture_output=True, text=True)
        if r.returncode == 0:
            return True, ''
        if r.returncode in (14, 15) or re.search(r'hibernat|unclean|fast', r.stdout + r.stderr, re.I):
            return False, hint
        return False, "Windows' drive can't be changed right now (" + ((r.stderr or r.stdout).strip().splitlines() or ['?'])[-1] + ')'
    if shutil.which('ntfsfix'):
        r = subprocess.run(['ntfsfix', '-n', dev], capture_output=True, text=True)
        if re.search(r'hibernat|unclean|fast|dirty', r.stdout + r.stderr, re.I):
            return False, hint
        return (r.returncode == 0), ('' if r.returncode == 0 else "Windows' drive needs a check (chkdsk) before Hearth can change it")
    return False, "Hearth can't check that Windows' drive is safe to change (ntfs-3g is missing), so it only read from it"


def make_writable(d, mnt, state):
    """Makes the drive at mnt writable for deleting, or raises Keep. Drives Hearth opened read-only are opened
    again for writing (Windows' only after checking it was fully shut down); drives another app opened read-only
    are left alone."""
    if mnt in state['rw']:
        return
    if not is_readonly(mnt):
        state['rw'].add(mnt)
        return
    if not d.get('ours'):
        raise Keep("the drive is open read-only in another app, so the original couldn't be deleted")
    if d.get('forced'):
        raise Keep("Windows wasn't fully shut down (Fast Startup or hibernation), so Hearth only read from its drive. The copy in Hearth is fine; to free the space, start Windows, hold Shift while choosing Shut down, then move it again")
    if d['fs'] == 'ntfs':
        if subprocess.run(['umount', mnt], capture_output=True).returncode != 0:
            raise Keep("Windows' drive is busy, so the original couldn't be deleted")
        ok, why = ntfs_writable(d['dev'])
        mounted = False
        if ok:
            for opts in (['-t', 'ntfs3', '-o', 'rw'], ['-t', 'ntfs-3g', '-o', 'rw']):   # never with force
                if subprocess.run(['mount', *opts, d['dev'], mnt], capture_output=True).returncode == 0:
                    mounted = True
                    break
        if not mounted:
            for opts in d.get('mountOpts') and [d['mountOpts']] or mount_tries('ntfs'):   # back to read-only
                if subprocess.run(['mount', *opts, d['dev'], mnt], capture_output=True).returncode == 0:
                    break
            raise Keep(why or "Windows' drive couldn't be opened for changes")
    elif subprocess.run(['mount', '-o', 'remount,rw', mnt], capture_output=True).returncode != 0:
        raise Keep("the drive couldn't be opened for changes")
    state['rw'].add(mnt)
    state['ours'].add(mnt)


PROTECTED_NAMES = {'windows', 'users', 'program files', 'program files (x86)', 'programdata', 'steamapps', 'common',
                   'home', 'var', 'etc', 'usr', 'boot', 'root', '@', '@home', 'deck', 'steam'}


def safe_to_delete(path, mnt, protect=()):
    """Only ever a game's own folder: under the drive, not the drive itself, not a system or home folder, and not
    a folder that holds something else that matters (a home folder, a Steam library)."""
    if not path or not mnt or os.path.islink(path) or not os.path.isdir(path):
        return False
    real, base = os.path.realpath(path), os.path.realpath(mnt)
    if real == base or not under(real, base):
        return False
    if os.path.basename(real).lower() in PROTECTED_NAMES:
        return False
    for p in protect:
        if p and under(os.path.realpath(p), real):   # path would contain a home folder or a library
            return False
    return True


def remove_record(rec, state):
    """A launcher's own record of the game on the old system, so it doesn't list a game that's gone."""
    p = rec.get('path') or ''
    if rec['type'] == 'file':
        if os.path.isfile(p) and not os.path.islink(p):
            os.remove(p)
    elif rec['type'] == 'json-key':
        with open(p, encoding='utf-8') as f:
            data = json.load(f)
        if isinstance(data, dict) and rec['key'] in data:
            del data[rec['key']]
            tmp = p + '.hearth-tmp'
            with open(tmp, 'w', encoding='utf-8') as f:
                json.dump(data, f, indent=2)
            os.replace(tmp, p)
    elif rec['type'] == 'lutris':
        con = sqlite3.connect(p)
        try:
            con.execute('UPDATE games SET installed = 0 WHERE slug = ?', (rec['slug'],))
            con.commit()
        finally:
            con.close()


def remove_original(kind, d, it, drives, state, compat_moved):
    """Deletes what was moved, after it was copied and checked. Raises Keep when it can't or mustn't."""
    mounts = [x.get('mount') for x in drives if x.get('mount')]
    path = it['path']
    mnt = owner_mount(path, mounts)
    if not mnt:
        raise Keep("couldn't tell which drive the original is on")
    drive = next((x for x in drives if x.get('mount') == mnt), d)
    # Never a folder that holds a home folder, a drive or another game (a Lutris game "installed" in ~/Games).
    protect = state['protect'] + [q for q in state.get('paths', []) if os.path.realpath(q) != os.path.realpath(path)]
    if kind == 'files':
        if not os.path.isdir(path) or os.path.islink(path) or not under(path, mnt):
            raise Keep("the folder isn't where it was")
    elif not safe_to_delete(path, mnt, protect):
        raise Keep("that folder holds more than this game, so Hearth left it alone")
    make_writable(drive, mnt, state)
    records = [r for r in it.get('records') or [] if r.get('path')]
    for r in records:   # those files are on their own drive (Epic's manifests are on C:, the game may be on D:)
        rm = owner_mount(r['path'], mounts)
        if rm and rm != mnt:
            make_writable(next((x for x in drives if x.get('mount') == rm), d), rm, state)
    current['critical'] = True   # from here the item is finished even if Stop is pressed
    try:
        if kind == 'files':
            # A personal folder (Documents...) stays, empty: Windows and Linux expect it to be there.
            for name in listdir(path):
                if name.lower() == 'desktop.ini':
                    continue
                q = os.path.join(path, name)
                if os.path.isdir(q) and not os.path.islink(q):
                    shutil.rmtree(q)
                else:
                    os.remove(q)
        else:
            # Renamed first, so a folder that's half deleted never looks like an installed game.
            trash = os.path.join(os.path.dirname(path), '.hearth-moved-' + os.path.basename(path))
            if os.path.lexists(trash):
                shutil.rmtree(trash, ignore_errors=True)
            os.rename(path, trash)
            problems = []
            for r in records:
                try:
                    remove_record(r, state)
                except (OSError, ValueError, sqlite3.Error) as e:
                    problems.append(str(e))
            if compat_moved and it.get('compat') and safe_to_delete(it['compat'], mnt, protect):
                shutil.rmtree(it['compat'], ignore_errors=True)
            shutil.rmtree(trash)
            if problems:
                print('log: the old launcher still lists it: ' + '; '.join(problems)[:300], flush=True)
    except OSError as e:
        raise Keep('the original was only partly deleted (' + str(e) + '). Your copy in Hearth is complete')
    finally:
        current['critical'] = False
        os.sync()
    return mnt


def free_bytes(p):
    try:
        st = os.statvfs(p)
        return st.f_bavail * st.f_frsize
    except OSError:
        return 0


def remove_partial(paths):
    for p in paths:
        try:
            if os.path.isdir(p) and not os.path.islink(p):
                shutil.rmtree(p)
            elif os.path.lexists(p):
                os.remove(p)
        except OSError:
            pass


def destination(kind, d, it, user, root, steamapps):
    if kind == 'steam':
        return os.path.join(steamapps, 'common', it['installdir'])
    if kind in ('epic', 'gog'):
        return os.path.join(root, 'Epic' if kind == 'epic' else 'GOG', os.path.basename(it['path'].rstrip('/')))
    if kind == 'lutris':
        return os.path.join(root, 'Lutris', os.path.basename(it['path'].rstrip('/')))
    return os.path.join(user.pw_dir, it['name'], 'Imported from ' + re.sub(r'[/\\]', '-', d['name']) +
                        (f' ({it["user"]})' if it.get('user') else ''))


def do_items(items, mode, user, root, steamapps, drives):
    """Copies (or moves) each item. Returns the result for the app."""
    result = {'done': [], 'skipped': [], 'failed': [], 'kept': [], 'epic': [], 'gog': [], 'lutris': [], 'steam': 0,
              'mode': mode, 'moved': [], 'freed': []}
    total = sum(it.get('size') or 0 for _, _, it in items)
    stage(phase='start', total=total, n=len(items), mode=mode)
    homes_all = [h for x in drives if x.get('mount') for h in homes(x['mount'])]
    state = {'rw': set(), 'ours': set(), 'protect': homes_all + [x['mount'] for x in drives if x.get('mount')],
             'paths': [x['path'] for dr in drives for k in ('steam', 'epic', 'gog', 'lutris', 'files') for x in dr.get(k) or [] if x.get('path')]}
    freed = {}
    finished = 0
    for i, (kind, d, it) in enumerate(items):
        if stop_requested():
            break
        size = it.get('size') or 0
        name = it['name'] + (f' ({it["user"]})' if kind == 'files' and it.get('user') else '')
        last = [0.0]

        def progress(done, bps, _i=i, _name=name, _size=size, _kind=kind):
            now = time.monotonic()
            if now - last[0] < 0.4:
                return
            last[0] = now
            stop_requested()
            part = min(done, _size or done)   # moving: copying is the first half of each item, checking the second
            stage(phase='copy', i=_i, n=len(items), key=it['key'], name=_name, kind=_kind, done=done, size=_size, bps=round(bps),
                  overall=finished + (part // 2 if mode == 'move' else part), total=total)

        stage(phase='copy', i=i, n=len(items), key=it['key'], name=name, kind=kind, done=0, size=size, bps=0, overall=finished, total=total)
        dst = destination(kind, d, it, user, root, steamapps)
        man_dst = os.path.join(steamapps, f'appmanifest_{it["appid"]}.acf') if kind == 'steam' else None
        if kind == 'steam' and os.path.exists(man_dst):
            result['skipped'].append({'key': it['key'], 'name': name, 'why': 'already installed in Hearth'})
            finished += size
            continue
        if mode == 'move' and size and free_bytes(os.path.dirname(dst) if os.path.isdir(os.path.dirname(dst)) else user.pw_dir) < size + GIB:
            result['failed'].append({'key': it['key'], 'name': name, 'why': 'not enough free space in Hearth for it. Nothing was changed'})
            finished += size
            continue
        # What this item creates, removed again if it doesn't finish (Stop, a failed copy or check).
        cdst = os.path.join(steamapps, 'compatdata', it['appid']) if kind == 'steam' and it.get('compat') else None
        compat_new = bool(cdst) and not os.path.exists(cdst)
        current['partial'] = [p for p in ([dst] if not os.path.exists(dst) else []) + ([cdst] if compat_new else [])]
        try:
            rsync(it['path'], dst, progress)
            if compat_new:
                rsync(it['compat'], cdst, lambda *_: None)
            if stop_requested():
                raise Stopped()
            if mode == 'move':
                os.sync()
                checked = [0]
                vlast = [0.0]

                def on_bytes(n, _i=i, _name=name, _size=size, _kind=kind):
                    checked[0] += n
                    now = time.monotonic()
                    if now - vlast[0] >= 0.4:
                        vlast[0] = now
                        stage(phase='verify', i=_i, n=len(items), key=it['key'], name=_name, kind=_kind, done=checked[0], size=_size, bps=0,
                              overall=finished + (_size + min(checked[0], _size)) // 2, total=total)
                stage(phase='verify', i=i, n=len(items), key=it['key'], name=name, kind=kind, done=0, size=size, bps=0, overall=finished + size // 2, total=total)
                verify_tree(it['path'], dst, on_bytes)
                if compat_new:
                    verify_tree(it['compat'], cdst)
            # Registered with its launcher (Steam: the manifest; the others: by the app, from the result).
            if kind == 'steam':
                fix_manifest(it['manifest'], man_dst, it['installdir'])
                current['partial'].append(man_dst)
                for x in (dst, cdst, man_dst):
                    if x:
                        chown_tree(x, user)
                result['steam'] += 1
            elif kind in ('epic', 'gog'):
                chown_tree(dst, user)
                result[kind].append({'app' if kind == 'epic' else 'id': it['app'] if kind == 'epic' else it['id'], 'name': it['name'], 'path': dst})
            elif kind == 'lutris':
                chown_tree(dst, user)
                exe = it.get('exe')
                old = (it.get('oldDir') or '').rstrip('/')
                if exe and old and exe.startswith(old + '/'):
                    exe = dst + exe[len(old):]           # the program moved with the game folder
                elif exe and not exe.startswith('/'):
                    exe = os.path.join(dst, exe)
                result['lutris'].append({'name': it['name'], 'path': dst, 'exe': exe if exe and os.path.exists(exe) else None})
            else:
                chown_tree(dst, user)
            current['partial'] = []
            result['done'].append({'key': it['key'], 'name': name, 'kind': kind})
        except Stopped:
            remove_partial(current['partial'])
            current['partial'] = []
            break
        except VerifyError as e:
            remove_partial(current['partial'])
            current['partial'] = []
            result['failed'].append({'key': it['key'], 'name': name, 'why': "the copy didn't match the original (" + str(e) + '). The original was kept and the copy removed'})
            finished += size
            continue
        except Exception as e:   # one item failing doesn't stop the rest
            remove_partial(current['partial'])
            current['partial'] = []
            if stop_requested():
                break
            result['failed'].append({'key': it['key'], 'name': name, 'why': str(e)})
            finished += size
            continue
        finished += size

        if mode == 'move':
            stage(phase='delete', i=i, n=len(items), key=it['key'], name=name, kind=kind, done=size, size=size, bps=0, overall=finished, total=total)
            mnt = owner_mount(it['path'], [x.get('mount') for x in drives if x.get('mount')])
            before = free_bytes(mnt) if mnt else 0
            try:
                mnt = remove_original(kind, d, it, drives, state, compat_new)
                gained = max(free_bytes(mnt) - before, 0) or size
                drive = next((x for x in drives if x.get('mount') == mnt), d)
                f = freed.setdefault(drive['id'], {'drive': drive['id'], 'dev': drive['dev'], 'name': drive.get('name') or drive['dev'], 'bytes': 0})
                f['bytes'] += gained
                result['moved'].append({'key': it['key'], 'name': name, 'kind': kind, 'freed': gained, 'drive': drive['id']})
            except Keep as e:
                result['kept'].append({'key': it['key'], 'name': name, 'why': str(e)})
    for mnt in state['rw'] & state['ours']:
        subprocess.run(['mount', '-o', 'remount,ro', mnt], capture_output=True)
    result['freed'] = list(freed.values())
    if current['stop']:
        result['stopped'] = True
    stage(phase='done', overall=total if not current['stop'] else finished, total=total)
    return result


def cancel_flag(user):
    return f'/run/user/{user.pw_uid}/hearth-import.cancel'


def clear_flag(path):
    try:
        if os.path.lexists(path) and not os.path.isdir(path):
            os.remove(path)
    except OSError:
        pass


def run():
    user = caller()
    try:
        req = json.loads(sys.stdin.readline())
    except ValueError:
        fail('expected {"mode": ..., "items": [...], "root": ...}')
    mode = req.get('mode', 'copy')
    keys = set(req.get('items') or [])
    root = os.path.realpath(req.get('root') or os.path.join(user.pw_dir, 'Games'))
    if mode not in ('copy', 'move') or not keys:
        fail('nothing to import')
    if not under(root, user.pw_dir):
        fail('the games folder has to be inside your home folder')
    current['running'] = True
    current['flag'] = cancel_flag(user)
    clear_flag(current['flag'])

    # Only what a fresh scan finds can be imported (paths never come from the caller).
    found = scan()
    items = []
    for d in found['drives']:
        for kind in ('steam', 'epic', 'gog', 'lutris', 'files'):
            for it in d[kind]:
                if it['key'] in keys:
                    items.append((kind, d, it))
    if not items:
        fail("the selected items weren't found any more. Scan again")
    result = do_items(items, mode, user, root, user_steamapps(user), found['drives'])
    unmount()
    clear_flag(current['flag'])
    print(json.dumps(result))


def unmount():
    for x in listdir(MNT):
        p = os.path.join(MNT, x)
        if os.path.ismount(p):
            subprocess.run(['umount', p], capture_output=True)
        try:
            os.rmdir(p)
        except OSError:
            pass


def on_term(*_):
    """Stop: the copy in progress ends, its partial files are removed (the original is never touched), and the
    result says what finished. A delete that already started finishes first."""
    p = current['proc']
    if not current.get('running'):   # scanning: just let go of the drives
        if p:
            p.terminate()
        unmount()
        sys.exit(1)
    current['stop'] = True
    if p and p.poll() is None:
        p.terminate()


def main(argv):
    signal.signal(signal.SIGTERM, on_term)
    cmd = argv[1] if len(argv) > 1 else ''
    if cmd == 'scan':
        print(json.dumps(scan()))
    elif cmd == 'run':
        run()
    elif cmd == 'unmount':
        unmount()
        print(json.dumps({'ok': True}))
    else:
        fail('usage: hearth-import scan | run | unmount')


if __name__ == '__main__':
    main(sys.argv)
