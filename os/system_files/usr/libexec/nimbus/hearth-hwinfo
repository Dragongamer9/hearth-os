#!/usr/bin/python3
"""hearth-hwinfo: the memory and slot tables Resource Monitor's "Your PC" shows, read from the firmware's SMBIOS table.

Run by Resource Monitor (desktop/shell/hearth-resmon) through pkexec, on demand only: once, then the answer is cached in
the person's ~/.cache/hearth/resmon-hwinfo.json (by the caller, not here). /usr/share/polkit-1/rules.d/49-hearth-hwinfo.rules
lets the person at the device (local, active session) run it without a password: it only reads.

  hearth-hwinfo                 one JSON line: {"ok": true, "memory": {"arrays": [...], "devices": [...]},
                                "slots": [...], "ports": [...]}

Only these four tables are given back, and only these fields:
  memory arrays (SMBIOS type 16)   location, use, ECC, maximum capacity, number of slots
  memory devices (type 17)         slot and bank names, size, type, form factor, speed, configured speed, maker, part
                                   number, rank, voltages, data width
  slots (type 9)                   name, type, lanes, in use or free, the PCI address of what's in it
  ports (type 8)                   internal and external names, connector and port type
Never serial numbers, asset tags, UUIDs or anything else in the table. It takes no arguments when run as root, writes
nothing and changes nothing. /sys/firmware/dmi/tables/DMI is readable by root only (that's why this exists).
"""
import json
import os
import struct
import sys

TABLE = '/sys/firmware/dmi/tables/DMI'

MEM_TYPES = {0x12: 'DDR', 0x13: 'DDR2', 0x14: 'DDR2 FB-DIMM', 0x18: 'DDR3', 0x1A: 'DDR4', 0x1B: 'LPDDR', 0x1C: 'LPDDR2',
             0x1D: 'LPDDR3', 0x1E: 'LPDDR4', 0x1F: 'Logical non-volatile', 0x20: 'HBM', 0x21: 'HBM2', 0x22: 'DDR5',
             0x23: 'LPDDR5', 0x24: 'HBM3'}
FORM_FACTORS = {0x09: 'DIMM', 0x0B: 'Row of chips', 0x0D: 'SODIMM', 0x0F: 'FB-DIMM', 0x10: 'Die', 0x12: 'CAMM'}
ARRAY_LOCATION = {0x03: 'System board', 0x04: 'Add-on card'}
ECC = {0x03: 'None', 0x04: 'Parity', 0x05: 'Single-bit ECC', 0x06: 'Multi-bit ECC', 0x07: 'CRC'}
USAGE = {0x03: 'available', 0x04: 'in use', 0x05: 'unavailable'}
WIDTH = {0x08: 1, 0x09: 2, 0x0A: 4, 0x0B: 8, 0x0C: 12, 0x0D: 16, 0x0E: 32}
PORT_TYPES = {0x10: 'USB', 0x1F: 'Network', 0x1C: 'Video', 0x1D: 'Audio', 0x0D: 'Keyboard', 0x0E: 'Mouse', 0x20: 'SATA',
              0x21: 'SAS', 0x09: 'Serial', 0x05: 'Parallel', 0x1E: 'Modem', 0x11: 'FireWire', 0x23: 'USB-C'}


def slot_type(code):
    if code in (0x14, 0x15, 0x16, 0x17):
        return {0x14: 'M.2 Socket 1-DP', 0x15: 'M.2 Socket 1-SD', 0x16: 'M.2 Socket 2', 0x17: 'M.2 Socket 3'}[code]
    gens = [(0xA5, 0xAA, ''), (0xAB, 0xB0, ' 2.0'), (0xB1, 0xB6, ' 3.0'), (0xB8, 0xBD, ' 4.0'), (0xBE, 0xC3, ' 5.0'), (0xC4, 0xC9, ' 6.0')]
    for lo, hi, g in gens:
        if lo <= code <= hi:
            off = code - lo
            return 'PCIe' + g + ('' if off == 0 else ' x%d' % [1, 2, 4, 8, 16][off - 1])
    if code in (0x06, 0x0E):
        return 'PCI'
    if code == 0x24:
        return 'PCIe Mini'
    return 'Other'


def structures(data):
    """[(type, formatted bytes, [strings])] for every structure in a raw SMBIOS table."""
    out, i, n = [], 0, len(data)
    while i + 4 <= n:
        typ, length = data[i], data[i + 1]
        if length < 4 or i + length > n:
            break
        formatted = data[i:i + length]
        j = i + length
        end = data.find(b'\0\0', j)
        if end < 0:
            break
        raw = data[j:end]
        strings = [s.decode('ascii', 'replace').strip() for s in raw.split(b'\0')] if raw else []
        out.append((typ, formatted, strings))
        if typ == 127:
            break
        i = end + 2
    return out


def _s(strings, f, off):
    if off >= len(f):
        return ''
    k = f[off]
    if k == 0 or k > len(strings):
        return ''
    v = strings[k - 1]
    return '' if v.lower() in ('not specified', 'unknown', 'none', 'undefined', '[empty]', 'no dimm', 'to be filled by o.e.m.') else v[:64]


def _w(f, off):
    return struct.unpack_from('<H', f, off)[0] if off + 2 <= len(f) else None


def _d(f, off):
    return struct.unpack_from('<I', f, off)[0] if off + 4 <= len(f) else None


def _q(f, off):
    return struct.unpack_from('<Q', f, off)[0] if off + 8 <= len(f) else None


def memory_device(f, strings):
    size = None
    raw = _w(f, 0x0C)
    if raw is not None and raw != 0xFFFF:
        if raw == 0:
            size = 0
        elif raw == 0x7FFF:
            ext = _d(f, 0x1C)
            size = (ext & 0x7FFFFFFF) * 1048576 if ext is not None else None
        else:
            size = (raw & 0x7FFF) * (1024 if raw & 0x8000 else 1048576)
    speed = _w(f, 0x15)
    if speed == 0xFFFF:
        speed = _d(f, 0x54)
    conf = _w(f, 0x20)
    if conf == 0xFFFF:
        conf = _d(f, 0x58)
    attrs = f[0x1B] if len(f) > 0x1B else 0
    mv = lambda off: (round(_w(f, off) / 1000, 3) if _w(f, off) else None)
    width = _w(f, 0x0A)
    return {'locator': _s(strings, f, 0x10), 'bank': _s(strings, f, 0x11), 'size': size,
            'type': MEM_TYPES.get(f[0x12] if len(f) > 0x12 else 0, ''), 'formFactor': FORM_FACTORS.get(f[0x0E] if len(f) > 0x0E else 0, ''),
            'speed': speed or None, 'configuredSpeed': conf or None, 'manufacturer': _s(strings, f, 0x17) if size else '',
            'partNumber': _s(strings, f, 0x1A) if size else '', 'rank': (attrs & 0x0F) or None,
            'voltage': mv(0x22), 'maxVoltage': mv(0x24), 'configuredVoltage': mv(0x26),
            'dataWidth': width if width not in (None, 0xFFFF) else None}


def memory_array(f):
    cap = _d(f, 0x07)
    if cap == 0x80000000:
        cap_b = _q(f, 0x0F)
    else:
        cap_b = cap * 1024 if cap else None
    return {'location': ARRAY_LOCATION.get(f[0x04] if len(f) > 4 else 0, 'Other'), 'use': 'System memory' if len(f) > 5 and f[5] == 0x03 else 'Other',
            'ecc': ECC.get(f[0x06] if len(f) > 6 else 0, ''), 'maxCapacity': cap_b, 'slots': _w(f, 0x0D)}


def system_slot(f, strings):
    addr = None
    if len(f) >= 0x11:
        seg, bus, devfn = _w(f, 0x0D), f[0x0F], f[0x10]
        if seg != 0xFFFF and bus != 0xFF and devfn != 0xFF:
            addr = '%04x:%02x:%02x.%d' % (seg, bus, devfn >> 3, devfn & 7)
    return {'designation': _s(strings, f, 0x04), 'type': slot_type(f[0x05] if len(f) > 5 else 0),
            'width': WIDTH.get(f[0x06] if len(f) > 6 else 0), 'usage': USAGE.get(f[0x07] if len(f) > 7 else 0, 'unknown'), 'address': addr}


def port_connector(f, strings):
    return {'internal': _s(strings, f, 0x04), 'external': _s(strings, f, 0x06),
            'kind': PORT_TYPES.get(f[0x08] if len(f) > 8 else 0, 'Other')}


def parse(data):
    """The four tables from a raw SMBIOS table, and nothing else."""
    out = {'ok': True, 'memory': {'arrays': [], 'devices': []}, 'slots': [], 'ports': []}
    for typ, f, strings in structures(data):
        try:
            if typ == 16:
                out['memory']['arrays'].append(memory_array(f))
            elif typ == 17:
                out['memory']['devices'].append(memory_device(f, strings))
            elif typ == 9:
                out['slots'].append(system_slot(f, strings))
            elif typ == 8:
                out['ports'].append(port_connector(f, strings))
        except (IndexError, struct.error):
            continue
    out['memory']['devices'] = out['memory']['devices'][:32]
    out['slots'] = out['slots'][:24]
    out['ports'] = out['ports'][:48]
    return out


def main(argv):
    path = TABLE
    if len(argv) > 1:
        # A test can hand it a table file, but never when it runs as root (nothing but the firmware's table is read then).
        if os.geteuid() == 0 or len(argv) != 3 or argv[1] != '--file':
            print(json.dumps({'ok': False, 'error': 'hearth-hwinfo takes no arguments'}))
            return 2
        path = argv[2]
    try:
        with open(path, 'rb') as fh:
            data = fh.read(1 << 20)
    except OSError as e:
        print(json.dumps({'ok': False, 'error': "the firmware's table can't be read: %s" % e.strerror}))
        return 1
    print(json.dumps(parse(data), separators=(',', ':')))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
