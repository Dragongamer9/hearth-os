#!/usr/bin/python3
"""hearth-decky: Decky Loader for Hearth's Steam Game Mode (docs/STEAM-GAME-MODE.md), as root.

Decky Loader is built into Hearth OS: the image ships a pinned stable release in /usr/lib/hearth-decky (PluginLoader and
its version, os-bases/peppermint/build.sh) and a service template, hearth-decky@.service (User=root, as Decky needs; not
started at boot). nimbus-session starts hearth-decky@<you>.service when Steam Game Mode starts and stops it afterwards,
without a password (49-hearth-decky.rules: only your own instance, only from the active session at the device, only
for administrators). The service runs:

  hearth-decky run USER       get ready, then become Decky Loader: ~USER/homebrew and Steam's CEF remote debugging for
                              USER (Decky needs it), Hearth Sync (/usr/share/hearth/decky-hearth-sync, docs/HEARTH-SYNC.md)
                              and the image's other plugins in PLUGINS (Hearth Link, Hearth Music) brought up to date in
                              Decky's plugins folder, the older Hearth plugin Hearth put there taken
                              away, and an install from before (hearth-decky.service and /var/lib/hearth-decky) removed

Older Hearth OS versions downloaded Decky when asked (hearth-admin decky-install, an administrator's password); those
commands stay for images without the built-in one and for clean-up:

  hearth-decky install USER   built in: only the user side and Hearth Sync (nothing downloaded). Otherwise Decky Loader's
                              latest stable release from its GitHub releases into /var/lib/hearth-decky and
                              hearth-decky.service (never started at boot), as before
  hearth-decky remove USER    an install from before: its service, program, Hearth's plugins and the CEF debugging file
                              Hearth made (Decky's settings and other plugins in ~/homebrew stay). Refused for the
                              built-in one (it runs only in Steam Game Mode anyway)
  hearth-decky start|stop     the service of an install from before (the built-in one is started by nimbus-session)

Plugin updates without a system update (docs/PLUGIN-UPDATES.md), as you: plugins-status, plugins-check, plugins-update,
plugins-auto (the daily timer), plugins-builtin, plugins-auto-set on|off (see "plugin updates" below).

A Decky installed with Decky's own installer (plugin_loader.service) is always left alone: it runs by itself, and the
built-in one doesn't start next to it. Prints one JSON line ({"ok": true, ...}); errors print "error: ..." and exit 1.
Paths can be moved for tests with HEARTH_DECKY_ROOT (a folder standing in for /).
"""
import filecmp
import hashlib
import json
import os
import pwd
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.request

ROOT = os.environ.get('HEARTH_DECKY_ROOT', '/')
RELEASES = 'https://api.github.com/repos/SteamDeckHomebrew/decky-loader/releases'
UNIT_NAME = 'hearth-decky.service'
MARK = '.hearth-made-this'


def path(*p):
    return os.path.join(ROOT, *[x.lstrip('/') for x in p])


def unit_path():
    return path('etc/systemd/system', UNIT_NAME)


def upstream_unit():
    return path('etc/systemd/system/plugin_loader.service')


def lib_dir():
    return path('var/lib/hearth-decky')


def builtin_dir():
    """The image's own Decky Loader (os-bases/peppermint/build.sh): PluginLoader and version."""
    return path('usr/lib/hearth-decky')


def builtin_binary():
    return os.path.join(builtin_dir(), 'PluginLoader')


def builtin_unit():
    return path('usr/lib/systemd/system/hearth-decky@.service')


def builtin():
    """Whether this image has Decky Loader built in (the program and the service template)."""
    return os.path.isfile(builtin_binary()) and os.path.isfile(builtin_unit())


def builtin_version():
    try:
        return open(os.path.join(builtin_dir(), 'version')).read().strip() or None
    except OSError:
        return None


def shipped_plugin(name='decky-hearth-sync'):
    """One of the plugins the image ships (/usr/share/hearth/<folder>; Hearth Sync unless named)."""
    return path('usr/share/hearth', name)


# Hearth Sync's folder in Decky's plugins folder, and the older Hearth plugin's (hosts/decky-hearth, the takeover: no
# longer shipped; its code stays in the repo).
PLUGIN_DIR = 'decky-hearth-sync'
OLD_PLUGIN_DIR = 'decky-hearth'
OLD_PLUGIN = {'name': 'Hearth', 'author': 'Dragongamer9'}
# Every plugin the image ships (/usr/share/hearth/<folder>): Hearth Sync first, then Hearth Link
# (docs/HEARTH-LINK-PLUGIN.md) and Hearth Music (docs/HEARTH-MUSIC.md). Each is copied on install, brought up to date
# on start and taken away on remove the same way (refresh_plugins); one the image doesn't have is skipped.
PLUGINS = (PLUGIN_DIR, 'decky-hearth-link', 'decky-hearth-music')


def shipped(name=PLUGIN_DIR):
    return os.path.isfile(os.path.join(shipped_plugin(name), 'plugin.json'))


def copy_others(home):
    """The other plugins in PLUGINS: {folder: copied} for the ones the image ships."""
    return {n: copy_plugin(home, name=n) for n in PLUGINS[1:] if shipped(n)}


def refresh_plugins(home, out, say_missing=False):
    """Every plugin in PLUGINS that isn't the one this image ships is replaced by it (after a Hearth OS update Decky would
    otherwise keep the old one). out gets 'plugin' for Hearth Sync and the folder name for the others.
    Plugin updates (docs/PLUGIN-UPDATES.md): a downloaded plugin newer than the image's is put in place instead, and the
    image's older one never replaces it; an image that brings a newer one wins. Downloaded plugins on trial are checked
    first (a version that didn't load goes back to the copy before it)."""
    try:
        check_trials(home, out)
    except (OSError, ValueError) as e:
        out['trial'] = 'couldn\'t check (%s)' % e
    for n in PLUGINS:
        key = 'plugin' if n == PLUGIN_DIR else n
        try:
            if apply_downloaded(home, n, out, key):
                continue
        except (OSError, ValueError) as e:
            out[key + 'Update'] = 'downloaded copy not used (%s)' % e
        try:
            if plugin_outdated(home, n):
                out[key] = 'updated' if copy_plugin(home, name=n) else 'not shipped'
            elif say_missing and n == PLUGIN_DIR and not shipped(n):
                out[key] = 'not shipped'
        except OSError as e:
            out[key] = 'couldn\'t update (%s)' % e
    try:
        note_installed(home)
    except Exception:
        pass
    return out


def fail(msg):
    print('error: ' + msg, flush=True)
    sys.exit(1)


def person(name):
    """A person's account (ids 1000-59999), never root or a system account."""
    try:
        pw = pwd.getpwnam(name)
    except (KeyError, TypeError):
        raise ValueError('unknown account')
    if not 1000 <= pw.pw_uid < 60000:
        raise ValueError('only a person\'s own account')
    return pw


def home_of(pw):
    """The person's home (tests, with HEARTH_DECKY_ROOT set, may give another with HEARTH_DECKY_TEST_HOME)."""
    if ROOT != '/' and os.environ.get('HEARTH_DECKY_TEST_HOME'):
        return os.environ['HEARTH_DECKY_TEST_HOME']
    return pw.pw_dir


def unit_text(home, user, binary):
    """Decky's own service (dist/plugin_loader-release.service), with Hearth's changes: the program in a root-owned
    folder, the user named, no [Install] section (never started at boot), Decky's updater told to keep this file."""
    hb = os.path.join(home, 'homebrew')
    return '\n'.join([
        '# Hearth: Decky Loader for Steam Game Mode (Experimental). Started only while Steam Game Mode runs',
        '# (nimbus-session, hearth-admin decky-start); never at boot. Remove: Settings > System > Steam Game Mode.',
        '[Unit]',
        'Description=Decky Loader (Hearth Steam Game Mode)',
        'After=network.target',
        '[Service]',
        'Type=simple',
        'User=root',
        'Restart=on-failure',
        'RestartSec=3',
        'StartLimitBurst=3',
        'KillMode=process',
        'TimeoutStopSec=15',
        'ExecStart=' + binary,
        'WorkingDirectory=' + os.path.dirname(binary),
        'Environment=UNPRIVILEGED_PATH=' + hb,
        'Environment=PRIVILEGED_PATH=' + hb,
        'Environment=UNPRIVILEGED_USER=' + user,
        'Environment=KEEP_SYSTEMD_SERVICE=1',
        'Environment=LOG_LEVEL=INFO',
        '',
    ])


def pick_asset(releases, machine):
    """The newest stable release's PluginLoader for this CPU (what Decky's installer picks): (version, url)."""
    want = 'PluginLoader-arm64' if machine in ('aarch64', 'arm64') else 'PluginLoader'
    for r in releases if isinstance(releases, list) else []:
        if not isinstance(r, dict) or r.get('prerelease') or r.get('draft'):
            continue
        for a in r.get('assets') or []:
            url = a.get('browser_download_url') or ''
            if a.get('name') == want and url.startswith('https://github.com/SteamDeckHomebrew/decky-loader/releases/download/'):
                return r.get('tag_name') or '?', url
        return None
    return None


def fetch(url, limit=200 * 1024 * 1024):
    req = urllib.request.Request(url, headers={'User-Agent': 'Hearth'})
    with urllib.request.urlopen(req, timeout=60) as r:
        data = r.read(limit + 1)
    if len(data) > limit:
        raise ValueError('download too big')
    return data


def as_user(pw, fn):
    """Runs fn() with the person's ids (files in their home are theirs)."""
    if os.geteuid() != 0:
        return fn()
    pid = os.fork()
    if pid == 0:
        try:
            os.setgid(pw.pw_gid)
            os.setuid(pw.pw_uid)
            fn()
            os._exit(0)
        except Exception:
            os._exit(1)
    _, status = os.waitpid(pid, 0)
    return os.WEXITSTATUS(status) == 0


def cef_files(home):
    return [os.path.join(home, '.steam/steam/.cef-enable-remote-debugging'),
            os.path.join(home, '.var/app/com.valvesoftware.Steam/data/Steam/.cef-enable-remote-debugging')]


def user_side(home):
    """~/homebrew and Steam's CEF debugging flag, made as the person. Notes which flag files Hearth made."""
    hb = os.path.join(home, 'homebrew')
    for d in ('settings', 'data', 'logs'):
        os.makedirs(os.path.join(hb, d), exist_ok=True)
    made = []
    for i, f in enumerate(cef_files(home)):
        steam_dir = os.path.dirname(f)
        if i == 1 and not os.path.isdir(steam_dir):
            continue   # no Flathub Steam
        if not os.path.exists(f):
            os.makedirs(steam_dir, exist_ok=True)
            open(f, 'w').close()
            made.append(f)
    if made:
        with open(os.path.join(hb, MARK), 'w') as m:
            m.write('\n'.join(made) + '\n')


def copy_plugin(home, owner_root=True, name=PLUGIN_DIR):
    """One of the image's plugins (Hearth Sync unless named) into Decky's plugins folder (root's, as Decky keeps it). False when not shipped."""
    src = shipped_plugin(name)
    if not os.path.isfile(os.path.join(src, 'plugin.json')):
        return False
    plugins = os.path.join(home, 'homebrew', 'plugins')
    os.makedirs(plugins, exist_ok=True)
    dst = os.path.join(plugins, name)
    tmp = dst + '.new'
    shutil.rmtree(tmp, ignore_errors=True)
    shutil.copytree(src, tmp, symlinks=False)
    shutil.rmtree(dst, ignore_errors=True)
    os.rename(tmp, dst)
    if owner_root and os.geteuid() == 0:
        for d in (plugins, dst):
            os.chown(d, 0, 0)
        for base, dirs, files in os.walk(dst):
            for n in dirs + files:
                os.lchown(os.path.join(base, n), 0, 0)
        os.chmod(plugins, 0o755)
    return True


def old_plugin_ours(home):
    """Whether ~/homebrew/plugins/decky-hearth is the older Hearth plugin Hearth put there: a real folder (not a link)
    whose plugin.json says name "Hearth" by Dragongamer9. A plugin installed from Decky's store under another name,
    or anything else in that folder, is never taken away."""
    d = os.path.join(home, 'homebrew', 'plugins', OLD_PLUGIN_DIR)
    if os.path.islink(d) or not os.path.isdir(d):
        return False
    try:
        with open(os.path.join(d, 'plugin.json')) as f:
            meta = json.load(f)
    except (OSError, ValueError):
        return False
    return isinstance(meta, dict) and all(meta.get(k) == v for k, v in OLD_PLUGIN.items())


def remove_old_plugin(home):
    """Takes the older Hearth plugin away when it's the one Hearth put there. True when it did."""
    if not old_plugin_ours(home):
        return False
    shutil.rmtree(os.path.join(home, 'homebrew', 'plugins', OLD_PLUGIN_DIR))
    return True


def systemctl(*args):
    if ROOT != '/':
        return True
    return subprocess.run(['systemctl', *args], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def install(user, download=None, machine=None):
    pw = person(user)
    home = home_of(pw)
    plugin = False
    if os.path.isfile(upstream_unit()):
        # Decky installed with its own installer: kept as it is, only the Hearth plugin is added.
        as_user(pw, lambda: user_side(home))
        plugin = copy_plugin(home)
        return {'ok': True, 'via': 'decky', 'plugin': plugin, 'others': copy_others(home), 'oldPluginRemoved': remove_old_plugin(home)}
    if builtin():
        # Nothing to download: the image has Decky. Only the user side, Hearth Sync, and the old install gone.
        out = prepare(pw.pw_name)
        return {'ok': True, 'via': 'builtin', 'version': builtin_version(), 'plugin': out.get('plugin') != 'not shipped',
                'others': {n: os.path.isdir(os.path.join(home, 'homebrew', 'plugins', n)) for n in PLUGINS[1:] if shipped(n)},
                'oldPluginRemoved': out.get('oldPlugin') == 'removed', 'migrated': out.get('migrated', False)}
    download = download or (lambda: pick_asset(json.loads(fetch(RELEASES)), machine or os.uname().machine))
    got = download()
    if not got:
        raise ValueError('no Decky Loader release for this device was found (or GitHub couldn\'t be reached)')
    version, url = got
    os.makedirs(lib_dir(), mode=0o755, exist_ok=True)
    binary = os.path.join(lib_dir(), 'PluginLoader')
    data = fetch(url) if isinstance(url, str) else url()
    if len(data) < 1024 * 1024 or not data.startswith(b'\x7fELF'):
        raise ValueError('the download isn\'t Decky Loader\'s program')
    fd, tmp = tempfile.mkstemp(dir=lib_dir())
    with os.fdopen(fd, 'wb') as f:
        f.write(data)
    os.chmod(tmp, 0o755)
    os.rename(tmp, binary)
    with open(os.path.join(lib_dir(), 'version'), 'w') as f:
        f.write(version + '\n')
    if ROOT == '/' and shutil.which('getenforce'):
        enforcing = subprocess.run(['getenforce'], capture_output=True, text=True).stdout.strip() == 'Enforcing'
        if enforcing:
            subprocess.run(['chcon', '-t', 'bin_t', binary], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    as_user(pw, lambda: user_side(home))
    plugin = copy_plugin(home)
    others = copy_others(home)
    os.makedirs(os.path.dirname(unit_path()), exist_ok=True)
    with open(unit_path(), 'w') as f:
        f.write(unit_text(home, pw.pw_name, binary))
    systemctl('daemon-reload')
    return {'ok': True, 'via': 'hearth', 'version': version, 'plugin': plugin, 'others': others, 'oldPluginRemoved': remove_old_plugin(home)}


def remove(user):
    pw = person(user)
    home = home_of(pw)
    if builtin() and not os.path.isfile(unit_path()):
        raise ValueError('Decky Loader is part of Hearth OS; it runs only while Steam Game Mode does')
    if os.path.isfile(unit_path()):
        systemctl('stop', UNIT_NAME)
        os.remove(unit_path())
        systemctl('daemon-reload')
    shutil.rmtree(lib_dir(), ignore_errors=True)
    for n in PLUGINS:
        shutil.rmtree(os.path.join(home, 'homebrew', 'plugins', n), ignore_errors=True)
    remove_old_plugin(home)
    mark = os.path.join(home, 'homebrew', MARK)
    try:
        made = [l.strip() for l in open(mark) if l.strip()]
    except OSError:
        made = []
    for f in made:
        if f in cef_files(home) and os.path.isfile(f):
            os.remove(f)
    if os.path.exists(mark):
        os.remove(mark)
    return {'ok': True}


def unit_home():
    """The person's home from Hearth's Decky service (its PRIVILEGED_PATH=<home>/homebrew), or None."""
    try:
        for line in open(unit_path()):
            if line.startswith('Environment=PRIVILEGED_PATH='):
                hb = line.split('=', 2)[2].strip()
                return os.path.dirname(hb) if hb.endswith('/homebrew') and hb.startswith('/') else None
    except OSError:
        pass
    return None


def plugin_outdated(home, name=PLUGIN_DIR):
    """A plugin in Decky's folder (Hearth Sync unless named) isn't the one this image ships (missing, or an update brought a new one)."""
    src = shipped_plugin(name)
    dst = os.path.join(home, 'homebrew', 'plugins', name)
    if not os.path.isfile(os.path.join(src, 'plugin.json')):
        return False
    for rel in ('plugin.json', 'package.json', 'main.py', 'steam_import.py', 'dist/index.js'):
        a, b = os.path.join(src, rel), os.path.join(dst, rel)
        if not os.path.isfile(a):
            continue
        if not os.path.isfile(b) or not filecmp.cmp(a, b, shallow=False):
            return True
    return False


def start_stop(verb):
    if not os.path.isfile(unit_path()):
        return {'ok': True, 'skipped': True}
    out = {}
    if verb == 'start':
        # Decky keeps its own copy of Hearth's plugin: after a Hearth OS update, the image's new one replaces it
        # before Decky starts (otherwise Steam Game Mode keeps the plugin of the version Decky was installed with).
        # An install from before Hearth Sync gets it here, and the older Hearth plugin Hearth put there goes.
        home = unit_home()
        if home:
            refresh_plugins(home, out)
        try:
            if home and remove_old_plugin(home):
                out['oldPlugin'] = 'removed'
        except OSError as e:
            out['oldPlugin'] = 'couldn\'t remove (%s)' % e
    out['ok'] = systemctl(verb, UNIT_NAME)
    return out


def hearth_made(unit):
    """Whether a hearth-decky.service file is the one an older Hearth OS wrote (unit_text's first line)."""
    try:
        with open(unit) as f:
            return f.readline().startswith('# Hearth: Decky Loader')
    except OSError:
        return False


def migrate():
    """An install from before Decky was built in (hearth-admin decky-install): its service file and its downloaded
    program go; the built-in one takes over. That service was never enabled and only ran during Steam Game Mode, which
    starts the built-in one instead now, so nothing is running from it. True when something was removed."""
    done = False
    if hearth_made(unit_path()):
        os.remove(unit_path())
        done = True
    for f in ('PluginLoader', 'version'):
        p = os.path.join(lib_dir(), f)
        if os.path.isfile(p):
            os.remove(p)
            done = True
    try:
        os.rmdir(lib_dir())
    except OSError:
        pass
    return done


def decky_env(home, user, base=None):
    """What Decky Loader is told (as in Decky's own service): the person and their ~/homebrew."""
    hb = os.path.join(home, 'homebrew')
    env = dict(base if base is not None else os.environ)
    env.update({'UNPRIVILEGED_PATH': hb, 'PRIVILEGED_PATH': hb, 'UNPRIVILEGED_USER': user,
                'KEEP_SYSTEMD_SERVICE': '1', 'LOG_LEVEL': env.get('LOG_LEVEL') or 'INFO'})
    return env


def prepare(user):
    """Everything before the built-in Decky Loader starts for USER (see run). Returns what it did."""
    pw = person(user)
    home = home_of(pw)
    out = {'ok': True}
    if os.path.isfile(upstream_unit()):
        raise ValueError('Decky Loader from its own installer is here; it runs by itself')
    if not builtin():
        raise ValueError('this Hearth OS has no built-in Decky Loader')
    try:
        if migrate():
            out['migrated'] = True
    except OSError as e:
        out['migrated'] = 'couldn\'t (%s)' % e
    as_user(pw, lambda: user_side(home))
    refresh_plugins(home, out, say_missing=True)
    try:
        if remove_old_plugin(home):
            out['oldPlugin'] = 'removed'
    except OSError as e:
        out['oldPlugin'] = 'couldn\'t remove (%s)' % e
    return out


def run(user):
    """The built-in service's program (hearth-decky@USER.service): prepare, then become Decky Loader. Decky works in the
    service's runtime folder (its own updater would download there; Decky is updated with Hearth OS instead)."""
    out = prepare(user)
    pw = person(user)
    print('hearth-decky: ' + json.dumps(out), flush=True)
    # A downloaded plugin on trial: a watcher outlives this process (which becomes Decky) and puts the copy before it
    # back when the new one gives no sign within WATCH seconds (docs/PLUGIN-UPDATES.md). Never stops Decky starting.
    try:
        home = home_of(pw)
        if trials(home):
            decky_pid = os.getpid()
            if os.fork() == 0:
                try:
                    os.setsid()
                    watch_trial(home, pw.pw_name, decky_pid)
                finally:
                    os._exit(0)
    except Exception as e:
        print('hearth-decky: plugin trial watcher not started (%s)' % e, flush=True)
    work = os.environ.get('RUNTIME_DIRECTORY', '').split(':')[0] or '/tmp'
    os.chdir(work)
    binary = builtin_binary()
    os.execve(binary, [binary], decky_env(home_of(pw), pw.pw_name))


# ===================================================================================================== plugin updates
# Hearth's Decky plugins update without a system update (docs/PLUGIN-UPDATES.md). The owner publishes a "plugins"
# release (plugins-v<his version>, .github/workflows/decky-plugins-release.yml) with the three archives, plugins.json and
# SHA256SUMS. As you (never root):
#
#   hearth-decky plugins-status        what's installed, built in and downloaded, the switch and the last check
#   hearth-decky plugins-check         the newest published plugins release (never a draft or prerelease)
#   hearth-decky plugins-update        check, download what's newer than both the installed and the built-in version,
#                                      verify it (SHA-256 against plugins.json and SHA256SUMS, the minimum Hearth OS and
#                                      Decky versions, plugin.json, main.py, dist/index.js and the version inside), keep
#                                      it in ~/.local/share/hearth/decky-plugins/<name>, then restart only Decky
#                                      (hearth-decky@<you>) when it's running, so it's put in place now
#   hearth-decky plugins-auto          the daily timer (hearth-plugin-updates.timer): nothing unless "Update plugins
#                                      automatically" is on; applied now only when Decky isn't running a game, else at
#                                      the next Steam Game Mode start
#   hearth-decky plugins-builtin       "Use the built-in plugins": the downloaded copies go; the image's come back
#   hearth-decky plugins-auto-set on|off   the switch (also Mantel's Settings › Updates), saved with hearth_settings_io
#
# Decky's plugins folder is root's, so the copy goes in there in prepare (hearth-decky@<you>, as root, before Decky
# starts): refresh_plugins puts a downloaded plugin in place when it's newer than the image's (the copy before it kept as
# ~/homebrew/hearth-prev/<name>.prev: inside plugins/ Decky would load it as a second plugin), and never lets the image's
# older one replace it. A downloaded plugin is on trial until its backend writes its load mark (hearth_only.py): no mark
# within WATCH seconds of its first run, or after two starts, puts the copy before it back (or the built-in one) and that
# version is never picked again. Nothing here touches booting, the image, the session or system files.

PLUGIN_REPO = 'Dragongamer9/hearth-os'
PLUGIN_RELEASES = 'https://api.github.com/repos/%s/releases?per_page=40' % PLUGIN_REPO
PLUGIN_TAG = 'plugins-v'
PLUGIN_DOWNLOAD = 'https://github.com/%s/releases/download/%s' % (PLUGIN_REPO, PLUGIN_TAG)
ARCHIVE_LIMIT = 64 * 1024 * 1024
UNPACKED_LIMIT = 256 * 1024 * 1024
MARKER = '.hearth-update.json'
TRIAL = 'hearth-plugin-trial.json'
WATCH = 180
CHECK_EVERY = 20 * 3600
NEEDED = ('plugin.json', 'main.py', 'package.json', 'dist/index.js')


def parse_version(v):
    """'v1.2.3' -> ((1, 2, 3), ''); the part after the numbers is kept for ties. None when it doesn't start with one."""
    v = (v or '').strip()
    if v[:1] in 'vV':
        v = v[1:]
    nums, rest = [], v
    while rest:
        i = 0
        while i < len(rest) and rest[i].isdigit():
            i += 1
        if i == 0:
            break
        nums.append(int(rest[:i]))
        rest = rest[i:]
        if rest.startswith('.') and rest[1:2].isdigit():
            rest = rest[1:]
        else:
            break
    return (tuple(nums), rest) if nums else None


def cmp_versions(a, b):
    """By number, part by part, missing parts are 0 (docs/UPDATES.md). Unreadable counts as lowest."""
    pa, pb = parse_version(a), parse_version(b)
    if pa is None or pb is None:
        return (pa is not None) - (pb is not None)
    na, nb = pa[0], pb[0]
    for i in range(max(len(na), len(nb))):
        x, y = (na[i] if i < len(na) else 0), (nb[i] if i < len(nb) else 0)
        if x != y:
            return 1 if x > y else -1
    return (pa[1] > pb[1]) - (pa[1] < pb[1])


def newer(a, b):
    return cmp_versions(a, b) > 0


def safe_version(v):
    return isinstance(v, str) and 0 < len(v) <= 64 and parse_version(v) is not None and \
        all(c.isalnum() or c in '.+-_' for c in v) and not v.startswith('.')


def folder_version(d):
    try:
        with open(os.path.join(d, 'package.json')) as f:
            v = json.load(f).get('version')
        return v if isinstance(v, str) else None
    except (OSError, ValueError, AttributeError):
        return None


def hearth_os_version():
    try:
        return open(path('usr/share/nimbus/version')).read().strip() or None
    except OSError:
        return None


def decky_loader_version():
    v = builtin_version()
    return v[1:] if v and v[:1] in 'vV' else v


def on_hearth_os():
    """The same rule as the plugins' own check (hosts/decky-shared/hearth_only.py): Hearth's os-release and Hearth's files."""
    fields = {}
    for rel in ('etc/os-release', 'usr/lib/os-release'):
        try:
            for line in open(path(rel), encoding='utf-8', errors='replace'):
                if '=' in line and not line.startswith('#'):
                    k, v = line.strip().split('=', 1)
                    fields[k] = v.strip().strip('"\'')
            break
        except OSError:
            continue
    named = fields.get('NAME') == 'Hearth' or fields.get('VARIANT_ID', '').lower().startswith('hearth')
    return named and any(os.path.exists(path(m)) for m in ('usr/lib/systemd/system/hearth-decky@.service', 'usr/libexec/nimbus'))


