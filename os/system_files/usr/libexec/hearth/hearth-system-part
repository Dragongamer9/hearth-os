#!/usr/bin/python3 -I
"""System parts through the Hearth Store (Hearth OS 1.18, docs/STORE-SYSTEM-PARTS.md): a newer copy of one of
Hearth's helpers that run as root, used instead of the one built into Hearth OS, without a system update and without
a restart. The image itself is never touched.

    hearth-system-part path <id> <built-in path>           prints the path to start: the Store's copy or the built-in one
    hearth-system-part run <id> <built-in program> [args]  starts the Store's copy, or the built-in program
    hearth-system-part install <id>                        (root) the newest copy the signed list names; stdin may
                                                           carry the Store's refreshed list: {"catalog": text, "sig": hex}
    hearth-system-part remove <id>                         (root) back to the built-in one for good
    hearth-system-part retry <id>                          (root) a copy that failed is tried again
    hearth-system-part status                              what's installed, as JSON (anyone may read it)

Why this is its own kind (the plan's rule): a program that runs as root must never run a file from your home folder,
since anything running as you can change those. So a system part:

  * lives in /var/lib/hearth/system-parts/<id>/<version>/, owned by root and writable by no one else;
  * is installed only by root, and only what the list signed with the owner's key names: the id must be one of
    /usr/share/hearth/store/system-parts.json's (the helpers Hearth allows), and the download's SHA-256 must be the
    signed list's. The request names only the id; the version, link and SHA-256 come from the signed list itself,
    checked here with the key built into Hearth OS, never from the caller;
  * is used only when every folder from /var/lib/hearth down to the program is root's and not group- or
    world-writable, it was made for this Hearth OS, and it hasn't failed twice (then the version before, else the
    built-in one, and Hearth says so);
  * never touches starting the PC: the boot menu, Recovery, the login screen and the units in the boot chain are
    never system parts (system-parts.json only names helpers), they come only with system updates.

Anything wrong or missing means the built-in one: this never stops a helper from working.
"""
import hashlib
import json
import os
import shutil
import signal
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request

ROOT = os.environ.get("HEARTH_SYSTEM_PARTS", "/var/lib/hearth/system-parts")
ALLOWED = os.environ.get("HEARTH_SYSTEM_PARTS_ALLOWED", "/usr/share/hearth/store/system-parts.json")
CATALOG = os.environ.get("HEARTH_SYSTEM_PARTS_CATALOG", "/usr/share/hearth/store/catalog.json")
KEY = os.environ.get("HEARTH_SYSTEM_PARTS_KEY", "/usr/share/hearth/store/catalog-key.pub")
VERSION_FILE = os.environ.get("HEARTH_VERSION_FILE", "/usr/share/nimbus/version")
# Tests run as a normal user: the owner the folders must have (root's 0 everywhere else).
OWNER = int(os.environ.get("HEARTH_SYSTEM_PARTS_OWNER", "0"))
QUICK = float(os.environ.get("HEARTH_PART_QUICK", "15"))
# The environment a helper sees when hearth-system-part started it (its first lines then don't come back here).
MARK = "HEARTH_SYSTEM_PART"


def _read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, dict) else None
    except (OSError, ValueError):
        return None


def _write_json(path, data):
    os.makedirs(os.path.dirname(path), mode=0o755, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def _safe_id(i):
    return isinstance(i, str) and 0 < len(i) <= 64 and all(c.isalnum() or c in "-_." for c in i) and not i.startswith(".")


def os_version():
    try:
        with open(VERSION_FILE, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        return ""


def fits(made_for, here):
    if not made_for or not here:
        return False
    for m in made_for if isinstance(made_for, list) else str(made_for).split(","):
        m = str(m).strip()
        if m and (here == m or here.startswith(m + ".")):
            return True
    return False


def allowed():
    """{id: {"builtin": path, "services": [units], "name": words}} from the image (root's file, never the caller's)."""
    d = _read_json(ALLOWED) or {}
    parts = d.get("parts") if isinstance(d.get("parts"), dict) else {}
    return {k: v for k, v in parts.items() if _safe_id(k) and isinstance(v, dict)}


def _root_safe(path, stop):
    """Every folder and file from `stop` down to `path` is OWNER's and not group- or world-writable, and nothing on the
    way is a link. Anything else: not safe."""
    try:
        path = os.path.abspath(path)
        stop = os.path.abspath(stop)
        if not (path == stop or path.startswith(stop + os.sep)):
            return False
        cur = path
        while True:
            st = os.lstat(cur)
            if stat.S_ISLNK(st.st_mode) or st.st_uid != OWNER or st.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
                return False
            if cur == stop:
                return True
            cur = os.path.dirname(cur)
    except OSError:
        return False


def _tree_safe(top):
    """Everything inside a version's folder is OWNER's, not group- or world-writable, no links, no set-id bits."""
    try:
        for base, dirs, files in os.walk(top):
            for n in [base] + [os.path.join(base, x) for x in dirs + files]:
                st = os.lstat(n)
                if stat.S_ISLNK(st.st_mode) or st.st_uid != OWNER or st.st_mode & (stat.S_IWGRP | stat.S_IWOTH | stat.S_ISUID | stat.S_ISGID):
                    return False
        return True
    except OSError:
        return False


def info(pid):
    p = os.path.join(ROOT, pid, "part.json")
    return _read_json(p) if _root_safe(p, os.path.dirname(ROOT)) else None


def state(pid):
    p = os.path.join(ROOT, pid, "state.json")
    return (_read_json(p) if _root_safe(p, os.path.dirname(ROOT)) else None) or {}


def _program(pid, version, inner):
    inner = str(inner or "").strip("/")
    if not _safe_id(version) or ".." in inner.split("/"):
        return None
    top = os.path.join(ROOT, pid, version)
    p = os.path.join(top, inner) if inner else top
    if not (_root_safe(p, os.path.dirname(ROOT)) and _tree_safe(top)):
        return None
    return p


def chosen(pid, builtin):
    """The Store's copy when it may be used (its version, else the one before it), else the built-in path. Never raises."""
    try:
        if not _safe_id(pid) or pid not in allowed():
            return builtin
        i = info(pid)
        if not i or not fits(i.get("os"), os_version()):
            return builtin
        st = state(pid)
        bad = st.get("bad") if isinstance(st.get("bad"), list) else []
        for v in (i.get("version"), i.get("previous")):
            if not isinstance(v, str) or not v or v in bad:
                continue
            p = _program(pid, v, i.get("path"))
            if not p or not os.path.exists(p):
                continue
            if os.path.isfile(builtin) and not (os.path.isfile(p) and os.access(p, os.X_OK)):
                continue
            if os.path.isdir(builtin) and not os.path.isdir(p):
                continue
            return p
        return builtin
    except Exception:  # noqa: BLE001 - anything at all: the built-in one
        return builtin


def version_of(p):
    """Which version a chosen path is (the folder under <ROOT>/<id>/)."""
    rel = os.path.relpath(p, ROOT).split(os.sep)
    return rel[1] if len(rel) > 1 else ""


def _notify(text):
    """Said once in the journal (system parts run as root, with no desktop to show it on); the Store's Hearth parts
    page shows the same from state.json."""
    try:
        print("hearth-system-part: " + text, file=sys.stderr, flush=True)
    except OSError:
        pass


def failed(pid, version):
    """A copy that didn't work: counted; twice in a row and it's left out (the one before is used)."""
    if not (_safe_id(pid) and _safe_id(version)) or os.geteuid() != OWNER:
        return
    st = state(pid)
    fails = st.get("fails") if isinstance(st.get("fails"), dict) else {}
    fails[version] = int(fails.get(version, 0)) + 1
    bad = st.get("bad") if isinstance(st.get("bad"), list) else []
    if fails[version] >= 2 and version not in bad:
        bad.append(version)
        _notify(f"{pid} {version} didn't work twice, so the version before it is used. Hearth Store › Hearth parts shows it.")
    try:
        _write_json(os.path.join(ROOT, pid, "state.json"), {"fails": fails, "bad": bad, "at": int(time.time())})
    except OSError:
        pass


def ok(pid, version):
    if not (_safe_id(pid) and _safe_id(version)) or os.geteuid() != OWNER:
        return
    st = state(pid)
    fails = st.get("fails") if isinstance(st.get("fails"), dict) else {}
    if fails.get(version):
        fails.pop(version, None)
        try:
            _write_json(os.path.join(ROOT, pid, "state.json"), {"fails": fails, "bad": st.get("bad") or [], "at": int(time.time())})
        except OSError:
            pass


BROKEN = ("Traceback (most recent call last):", "SyntaxError:", "ImportError:", "ModuleNotFoundError:")


def run(pid, builtin, args):
    os.environ[MARK] = "1"
    p = chosen(pid, builtin)
    if p == builtin:
        os.execv(builtin, [builtin] + args)
    v = version_of(p)
    started = time.monotonic()
    try:
        child = subprocess.Popen([p] + args, stderr=subprocess.PIPE)
    except OSError:
        failed(pid, v)
        os.execv(builtin, [builtin] + args)
    for s in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal.signal(s, lambda n, _f: child.send_signal(n))
    broken = False
    for line in child.stderr:
        try:
            sys.stderr.buffer.write(line)
            sys.stderr.flush()
        except OSError:
            pass
        if line.decode(errors="replace").lstrip().startswith(BROKEN):
            broken = True
    code = child.wait()
    crashed = code < 0 and code not in (-signal.SIGTERM, -signal.SIGINT, -signal.SIGHUP)
    if broken or crashed or code in (126, 127):
        failed(pid, v)
        if time.monotonic() - started < QUICK:
            # The built-in one does what was asked (a helper's request that the copy couldn't carry out).
            os.execv(builtin, [builtin] + args)
    else:
        ok(pid, v)
    sys.exit(code if code >= 0 else 128 - code)


# ------------------------------------------------------------------ the signed list
def _unhex(s):
    try:
        return bytes.fromhex("".join(s.split()))
    except ValueError:
        return None


def built_in_key():
    try:
        with open(KEY, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#"):
                    k = _unhex(line)
                    return k if k and len(k) == 32 else None
    except OSError:
        pass
    return None


def verify(key, text, sig_hex):
    """Whether sig_hex is the owner's Ed25519 signature of exactly these bytes (the Store's check, catalog.rs)."""
    sig = _unhex(sig_hex or "")
    if not key or not sig or len(sig) != 64:
        return False
    try:
        from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
        from cryptography.exceptions import InvalidSignature
        try:
            Ed25519PublicKey.from_public_bytes(key).verify(sig, text)
            return True
        except (InvalidSignature, ValueError):
            return False
    except ImportError:
        pass
    # Without python3-cryptography: OpenSSL, with the key in its own wrapping (SubjectPublicKeyInfo for Ed25519).
    with tempfile.TemporaryDirectory() as d:
        der = bytes.fromhex("302a300506032b6570032100") + key
        open(os.path.join(d, "k.der"), "wb").write(der)
        open(os.path.join(d, "m"), "wb").write(text)
        open(os.path.join(d, "s"), "wb").write(sig)
        r = subprocess.run(["openssl", "pkeyutl", "-verify", "-pubin", "-keyform", "DER", "-inkey", os.path.join(d, "k.der"),
                            "-rawin", "-in", os.path.join(d, "m"), "-sigfile", os.path.join(d, "s")],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return r.returncode == 0


def signed_list(extra=None):
    """The list to install from: the built-in one (root's, in the image), or the Store's refreshed one when it's signed
    with the built-in key and newer. Returns (serial, entries)."""
    def entries(d):
        return [e for e in (d.get("apps") or []) + (d.get("tests") or []) if isinstance(e, dict)]
    built = _read_json(CATALOG) or {}
    best = (int(built.get("serial", 0) or 0), entries(built))
    if extra and isinstance(extra, dict) and isinstance(extra.get("catalog"), str):
        text = extra["catalog"].encode("utf-8")
        if verify(built_in_key(), text, extra.get("sig", "")):
            try:
                d = json.loads(text)
            except ValueError:
                d = {}
            if isinstance(d, dict) and int(d.get("serial", 0) or 0) > best[0]:
                best = (int(d["serial"]), entries(d))
    return best


def newer(a, b):
    def nums(s):
        return [int("".join(c for c in x if c.isdigit()) or 0) for x in str(s).lstrip("vV").replace("-", ".").split(".")]
    x, y = nums(a), nums(b)
    n = max(len(x), len(y))
    return x + [0] * (n - len(x)) > y + [0] * (n - len(y))


def install(pid, extra=None, opener=None):
    if os.geteuid() != OWNER:
        raise SystemExit("hearth-system-part: installing a system part needs root (the Store asks for the admin password)")
    if not _safe_id(pid) or pid not in allowed():
        raise SystemExit("hearth-system-part: that isn't one of Hearth's system parts")
    _, apps = signed_list(extra)
    part = None
    for e in apps:
        pt = e.get("part") if isinstance(e.get("part"), dict) else {}
        if pt.get("id") == pid and pt.get("system") is True:
            part = pt
            break
    if not part:
        raise SystemExit("hearth-system-part: the signed list has no copy of it")
    version, url, sha, made_for, inner = (str(part.get(k) or "") for k in ("version", "url", "sha256", "os", "path"))
    if not (_safe_id(version) and url.startswith("https://") and len(sha) == 64 and fits(made_for, os_version())):
        raise SystemExit("hearth-system-part: the list's copy isn't for this Hearth OS")
    if ".." in inner.strip("/").split("/"):
        raise SystemExit("hearth-system-part: a bad name")
    old = (info(pid) or {}).get("version")
    if old and not newer(version, old):
        raise SystemExit("hearth-system-part: it's up to date")
    base = os.path.join(ROOT, pid)
    os.makedirs(base, mode=0o755, exist_ok=True)
    for d in (os.path.dirname(ROOT), ROOT, base):
        os.chmod(d, 0o755)
    fd, tmp = tempfile.mkstemp(dir=base, prefix=".download-", suffix=".tar.gz")
    os.close(fd)
    unpack = tempfile.mkdtemp(dir=base, prefix=".unpack-")
    try:
        h = hashlib.sha256()
        with (opener or urllib.request.urlopen)(url, timeout=60) as r, open(tmp, "wb") as f:
            while True:
                b = r.read(1 << 16)
                if not b:
                    break
                h.update(b)
                f.write(b)
        if h.hexdigest().lower() != sha.lower():
            raise SystemExit("hearth-system-part: the download doesn't match the signed list's SHA-256, so nothing changed")
        with tarfile.open(tmp, "r:gz") as t:
            t.extractall(unpack, filter="data")
        # root's, writable only by root, no set-id bits, no links
        for b2, dirs, files in os.walk(unpack):
            for n in [b2] + [os.path.join(b2, x) for x in dirs + files]:
                if os.path.islink(n):
                    os.unlink(n)
                    continue
                os.lchown(n, OWNER, -1) if os.geteuid() == 0 else None
                m = stat.S_IMODE(os.lstat(n).st_mode)
                os.chmod(n, m & ~(stat.S_IWGRP | stat.S_IWOTH | stat.S_ISUID | stat.S_ISGID))
        os.chmod(unpack, 0o755)
        dest = os.path.join(base, version)
        if os.path.exists(dest):
            shutil.rmtree(dest)
        os.replace(unpack, dest)
        prog = _program(pid, version, inner)
        if not prog or not os.path.exists(prog):
            shutil.rmtree(dest, ignore_errors=True)
            raise SystemExit("hearth-system-part: the download doesn't have the program it should, so nothing changed")
        _write_json(os.path.join(base, "part.json"),
                    {"id": pid, "version": version, "os": made_for, "path": inner, "sha256": sha.lower(), "url": url,
                     "installed": int(time.time()), "previous": old if old != version else None})
        # A new version starts with a clean slate; keep only it and the one before.
        st = state(pid)
        _write_json(os.path.join(base, "state.json"), {"fails": {}, "bad": [b for b in (st.get("bad") or []) if b != version], "at": int(time.time())})
        for d in os.listdir(base):
            if d not in (version, old, "part.json", "state.json") and not d.startswith("."):
                shutil.rmtree(os.path.join(base, d), ignore_errors=True)
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        shutil.rmtree(unpack, ignore_errors=True)
    restart_services(pid)
    return version


def restart_services(pid):
    """Its services start again with the new copy (no restart of the PC); only the ones that are running."""
    for unit in allowed().get(pid, {}).get("services") or []:
        if isinstance(unit, str) and unit.endswith((".service", ".socket")) and "/" not in unit:
            subprocess.run(["systemctl", "try-restart", unit], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def remove(pid):
    if os.geteuid() != OWNER:
        raise SystemExit("hearth-system-part: needs root")
    if _safe_id(pid) and pid in allowed():
        shutil.rmtree(os.path.join(ROOT, pid), ignore_errors=True)
        restart_services(pid)


def retry(pid):
    if os.geteuid() != OWNER:
        raise SystemExit("hearth-system-part: needs root")
    if _safe_id(pid) and pid in allowed() and os.path.isdir(os.path.join(ROOT, pid)):
        _write_json(os.path.join(ROOT, pid, "state.json"), {"fails": {}, "bad": [], "at": int(time.time())})


def status():
    out = {}
    here = os_version()
    for pid, a in allowed().items():
        i = info(pid)
        st = state(pid)
        row = {"name": a.get("name") or pid, "builtin": True}
        if i:
            builtin = a.get("builtin") or ""
            used = chosen(pid, builtin)
            row = {"name": a.get("name") or pid, "version": i.get("version"), "previous": i.get("previous"),
                   "fits": fits(i.get("os"), here), "used": version_of(used) if used != builtin else "built-in",
                   "bad": st.get("bad") or []}
        out[pid] = row
    print(json.dumps(out))


def main(argv):
    if len(argv) < 2:
        print(__doc__)
        return 2
    cmd = argv[1]
    if cmd == "path" and len(argv) == 4:
        print(chosen(argv[2], argv[3]))
        return 0
    if cmd == "run" and len(argv) >= 4:
        run(argv[2], argv[3], argv[4:])
        return 0
    if cmd == "install" and len(argv) == 3:
        extra = None
        if not sys.stdin.isatty():
            try:
                extra = json.loads(sys.stdin.read(4 << 20) or "null")
            except ValueError:
                extra = None
        print(json.dumps({"ok": True, "id": argv[2], "version": install(argv[2], extra)}))
        return 0
    if cmd == "remove" and len(argv) == 3:
        remove(argv[2])
        print(json.dumps({"ok": True}))
        return 0
    if cmd == "retry" and len(argv) == 3:
        retry(argv[2])
        print(json.dumps({"ok": True}))
        return 0
    if cmd == "status":
        status()
        return 0
    print(__doc__)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
