# Hearth: Bazzite's handheld edition (bazzite-deck) with the Hearth session (the Nimbus UI) as what it boots into.
# Built by .github/workflows/os.yml from the repository root:
#   podman build -f os/Containerfile -t hearth .
# os/nimbus-app must hold the unpacked Linux build of Nimbus (electron-builder --linux dir); CI puts it there.

# Files the build script needs, kept out of the final image.
FROM scratch AS ctx
COPY os/build_files /
COPY os/system_files /system_files
COPY os/branding/wallpapers /wallpapers
COPY os/nimbus-app /nimbus-app
COPY hosts/linux/session /session
COPY hosts/linux/desktop /desktop

FROM ghcr.io/ublue-os/bazzite-deck:stable

ARG NIMBUS_VERSION=0.0.0
LABEL org.opencontainers.image.title="Hearth" \
      org.opencontainers.image.description="Hearth: Bazzite with a controller-first Game Mode and Desktop Mode" \
      org.opencontainers.image.source="https://github.com/Dragongamer9/nimbus" \
      org.opencontainers.image.version="${NIMBUS_VERSION}" \
      containers.bootc=1

RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    NIMBUS_VERSION="${NIMBUS_VERSION}" /ctx/build.sh

RUN bootc container lint
