# Hearth Recovery: a USB stick that repairs an installed Hearth OS (like SteamOS's recovery image). Made from Hearth
# OS on Debian (ghcr.io/dragongamer9/hearth-peppermint, by digest; 1.12) so it has the same kernel, Handheld Daemon
# (the Ally's built-in controller), Wi-Fi and graphics drivers, ostree, bootc and bootupd as the devices it repairs,
# plus a live boot and the recovery screen instead of Hearth's session. Built by .github/workflows/recovery-iso.yml
# (context: os/), turned into an ISO by Titanoboa. Unlike the offline installer it carries no copy of the Hearth OS
# image: updating and factory reset download it. (The Anatase-based build is kept in archive/os/recovery-anatase.)
ARG BASE=ghcr.io/dragongamer9/hearth-peppermint:testing
FROM ${BASE}
COPY recovery/src /src
COPY live/src/hearth-install live/src/hearth-live-prep /src/installer/
COPY live/src/branding /src/branding
RUN --mount=type=cache,target=/var/cache/apt /src/build.sh && rm -rf /src
