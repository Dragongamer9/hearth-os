#!/usr/bin/python3
"""hearth-install: Hearth's own installer, the engine behind both of its faces (the Hearth app and Mantel).

Run as root (pkexec; the live user is allowed). Installed only on the live USB.

  hearth-install disks          JSON: the drives Hearth can go on (not the USB it's running from), with their
                                size, model, partitions and the systems already on them (Windows, SteamOS,
                                other Linux)
  hearth-install check PART     JSON: next to the Linux on partition PART: its size, how much is used, how
                                much room it can give Hearth, and what's in the way
  hearth-install run            reads the plan as JSON on stdin and installs. Progress lines as
                                "stage: {json}", then "result: {json}" or "error: <message>"

The plan:
  {"mode": "whole" | "beside",          whole: erase the drive; beside: install next to what's on it
   "disk": "/dev/nvme0n1",
   "part": "/dev/nvme0n1p8",            beside next to Linux: the partition that gives the room (ext4 or btrfs;
                                        SteamOS: its home partition). Left out: Windows (hearth-live-prep)
   "give": 137438953472,                beside only: how much space to take (bytes)
   "user": {"name": "sam", "full": "Sam", "password": "..."},
   "hostname": "sams-deck", "timezone": "America/Chicago",
   "edition": "anatase",                optional; which Hearth OS (EDITIONS: anatase, ubuntu, cachyos,
                                        peppermint); defaults to Hearth OS on Anatase. Never a free-form image
   "firmware": true}                    optional; false skips adding the boot entry (for tests)

How (the same way Fedora's installer puts an atomic system on a drive, without the installer):
  1. partitions: a new EFI partition (or Windows' existing one), /boot (ext4) and Hearth (btrfs, with
     "root" and "home" subvolumes)
  2. `ostree container image deploy` downloads Hearth OS straight onto the drive (nothing is kept in RAM)
  3. bootupd installs the boot loader and adds the boot entry
  4. fstab, the user account, the computer's name, time zone and Wi-Fi networks are written into the new system
"""
import glob
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import time

MIB = 1024 * 1024
GIB = 1024 * MIB
MIN_DISK = 64 * GIB
ESP_SIZE = 600 * MIB
BOOT_SIZE = 2 * GIB
ESP_TYPE = 'c12a7328-f81f-11d2-ba4b-00a0c93ec93b'
LINUX_TYPE = '0fc63daf-8483-4772-8e79-3d69d8477de4'
XBOOTLDR_TYPE = 'bc13c2ff-59e6-4262-a352-b275fd6f7172'
TARGET = '/run/hearth-install/target'
PREP = '/usr/libexec/nimbus/hearth-live-prep'
RESERVED = {'root', 'bin', 'daemon', 'adm', 'lp', 'sync', 'shutdown', 'halt', 'mail', 'operator', 'games', 'ftp',
            'nobody', 'liveuser', 'admin', 'system', 'systemd', 'dbus', 'polkitd', 'sddm', 'gdm', 'wheel', 'users',
            # System groups every edition has: a person named like one got a second group of that name (with
            # their own number), so files and permissions for that group went to the wrong one.
            'audio', 'video', 'input', 'render', 'kvm', 'tty', 'disk', 'dialout', 'plugdev', 'sudo', 'utmp', 'sys',
            'cdrom', 'sshd', 'nogroup', 'kmem', 'mem', 'floppy', 'tape'}


# ------------------------------------------------------------------ small helpers

class Fail(Exception):
    pass


def sh(cmd, check=True, input=None, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, input=input, **kw)
    if check and r.returncode != 0:
        last = ((r.stderr or r.stdout or '').strip().splitlines() or [' '.join(cmd) + ' failed'])[-1]
        raise Fail(f'{os.path.basename(cmd[0])}: {last}')
    return r


_STAGE_LOCK = __import__('threading').Lock()


def stage(name, pct, text, **extra):
    with _STAGE_LOCK:
            print('stage: ' + json.dumps({'stage': name, 'pct': round(max(0, min(100, pct)), 1), 'text': text, **extra}), flush=True)


def part_path(disk, n):
    """/dev/sda + 3 -> /dev/sda3; /dev/nvme0n1 + 3 -> /dev/nvme0n1p3; /dev/loop0 -> /dev/loop0p3."""
    return f'{disk}{"p" if disk[-1].isdigit() else ""}{n}'


def uuid_of(dev):
    return sh(['blkid', '-s', 'UUID', '-o', 'value', dev]).stdout.strip()


# ------------------------------------------------------------------ checks on what was asked

def check_plan(p):
    """Raises Fail with a message people can act on; returns the plan with defaults filled in."""
    if p.get('mode') not in ('whole', 'beside'):
        raise Fail('choose how to install: on the whole drive, or next to Windows')
    if not re.fullmatch(r'/dev/[A-Za-z0-9/_-]+', p.get('disk') or ''):
        raise Fail('choose a drive')
    u = p.get('user') or {}
    name = (u.get('name') or '').strip()
    if not re.fullmatch(r'[a-z_][a-z0-9_-]{0,31}', name):
        raise Fail('the user name can only have small letters, numbers, - and _, and has to start with a letter')
    if name in RESERVED:
        raise Fail(f'"{name}" is used by the system: pick another user name')
    nopass = bool(u.get('nopassword'))
    if not u.get('password') and not nopass:
        raise Fail('choose a password (or choose no password)')
    if '\n' in (u.get('password') or '') or ':' in name:
        raise Fail("the password can't have a line break in it")
    host = (p.get('hostname') or 'hearth').strip().lower()
    # The screens' default device name is "<user name>-hearth", and a user name may have "_" in it, which a
    # device name can't: make it a "-" instead of refusing the install.
    host = re.sub(r'_+', '-', host).strip('-') or 'hearth'
    if not re.fullmatch(r'[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?', host):
        raise Fail('the device name can only have letters, numbers and -')
    tz = p.get('timezone') or 'UTC'
    if not re.fullmatch(r'[A-Za-z0-9_+/-]+', tz) or '..' in tz:
        raise Fail('unknown time zone')
    if p.get('part') and not re.fullmatch(r'/dev/[A-Za-z0-9/_-]+', p['part']):
        raise Fail('choose what to install next to')
    if p['mode'] == 'beside' and not (isinstance(p.get('give'), int) and p['give'] >= MIN_DISK):
        raise Fail(f'Hearth needs at least {MIN_DISK // GIB} GB')
    edition = plan_edition(p)
    image = image_of(edition)
    signin = p.get('signin') if p.get('signin') in ('auto', 'start', 'always') else 'auto'
    if nopass:
        signin = 'auto'   # nothing to ask for
    extra = [k for k in (p.get('kargs') or []) if isinstance(k, str) and re.fullmatch(r'[A-Za-z0-9_.,=:/-]+', k)]
    return {**p, 'signin': signin, 'kargs': extra, 'hostname': host, 'timezone': tz, 'image': image, 'edition': edition,
            'user': {'name': name, 'full': (u.get('full') or name).replace(':', ' ').strip(),
                     'password': '' if nopass else u['password'], 'nopassword': nopass}}


# ------------------------------------------------------------------ which Hearth OS
# Every Hearth OS this installer can put on a drive: a fixed table, never a free-form image. Hearth OS on Anatase
# (one image for AMD, Intel and Nvidia) is the one to install; the others are Beta Experimental editions and have
# only :testing. The same list as the Hearth app's "Move to a new Hearth OS" (hosts/hearth-core/src/newos.rs).
EDITIONS = {
    'anatase': {'image': 'ghcr.io/dragongamer9/hearth-os:latest', 'label': 'Hearth OS on Anatase', 'beta': False,
                'about': 'The new Hearth OS. Starts and updates fast, the same for every PC and handheld.'},
    'ubuntu': {'image': 'ghcr.io/dragongamer9/hearth-ubuntu:testing', 'label': 'Ubuntu', 'beta': True,
               'about': 'Hearth OS built on Ubuntu. Still being tested: some things may not work yet.'},
    'cachyos': {'image': 'ghcr.io/dragongamer9/hearth-cachyos:testing', 'label': 'CachyOS', 'beta': True,
                'about': 'Hearth OS built on CachyOS, tuned for newer processors. Still being tested: some things may not work yet.'},
    'peppermint': {'image': 'ghcr.io/dragongamer9/hearth-peppermint:testing', 'label': 'Peppermint', 'beta': True,
                   'about': 'Hearth OS built on Peppermint OS (Debian). Still being tested: some things may not work yet.'},
}
DEFAULT_EDITION = 'anatase'
# CachyOS' image is built for x86-64-v3: every processor in /proc/cpuinfo needs these features.
X86_64_V3_FLAGS = ('avx2', 'bmi2', 'fma', 'movbe')
SB_VAR = '/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d0-aa4b-00e098032b8c'
NO_V3 = "Hearth OS on CachyOS needs a newer processor (x86-64-v3: AVX2, BMI2, FMA and MOVBE). Choose another one."
SB_CACHYOS = ("Secure Boot is on, and Hearth OS on CachyOS can't start with it on (it has no signed boot loader). "
              "Turn Secure Boot off in your PC's firmware settings (UEFI) before you restart, or choose another one.")


def image_of(edition=None):
    """The image of an edition in EDITIONS (default: Hearth OS on Anatase). Fail for anything else."""
    e = EDITIONS.get(edition or DEFAULT_EDITION)
    if not e:
        raise Fail('unknown edition: choose Hearth OS on Anatase, Ubuntu, CachyOS or Peppermint')
    return e['image']


def image(edition=None):
    """The image to install: the edition's, from the fixed table."""
    return image_of(edition)


def plan_edition(p):
    """The plan's edition: "edition" (an EDITIONS key), or an "image" that is exactly one of the table's images
    (older callers). Anything else is refused. CachyOS is refused on a processor without x86-64-v3."""
    ed, img = p.get('edition'), p.get('image')
    if ed is not None and (not isinstance(ed, str) or ed not in EDITIONS):
        raise Fail('unknown edition: choose Hearth OS on Anatase, Ubuntu, CachyOS or Peppermint')
    if img is not None:
        by_image = next((k for k, v in EDITIONS.items() if v['image'] == img), None)
        if not by_image or (ed and ed != by_image):
            raise Fail('bad image name')
        ed = by_image
    ed = ed or usb_edition()
    if ed == 'cachyos' and not cpu_v3():
        raise Fail(NO_V3)
    return ed


def x86_64_v3(cpuinfo):
    """Every processor listed in /proc/cpuinfo has the x86-64-v3 features."""
    flags = [set(line.split(':', 1)[1].split()) for line in cpuinfo.splitlines()
             if ':' in line and line.split(':', 1)[0].strip() == 'flags']
    return bool(flags) and all(all(f in fl for f in X86_64_V3_FLAGS) for fl in flags)


def cpu_v3(path='/proc/cpuinfo'):
    try:
        with open(path) as f:
            return x86_64_v3(f.read())
    except OSError:
        return False


def secure_boot(var=SB_VAR):
    """True/False: Secure Boot is on (the SecureBoot EFI variable: 4 bytes of attributes, then 1 when on, else
    mokutil's answer). None: couldn't tell (not a UEFI PC)."""
    try:
        with open(var, 'rb') as f:
            b = f.read()
        if len(b) > 4:
            return b[4] == 1
    except OSError:
        pass
    if shutil.which('mokutil'):
        out = sh(['mokutil', '--sb-state'], check=False).stdout.lower()
        if 'secureboot enabled' in out:
            return True
        if 'secureboot disabled' in out:
            return False
    return None


def edition_warning(edition, sb):
    """What to tell people before installing this edition. With Secure Boot on only CachyOS can't start: Anatase
    is signed for Fedora's shim, and Ubuntu and Peppermint bring their own signed shim on a fresh install."""
    return SB_CACHYOS if edition == 'cachyos' and sb else None


def this_usb(path='/etc/hearth-live'):
    """What this USB was built as: "installer" (the small online installer: every edition), or the edition it
    carries for installing offline: "anatase" (the full live USB) or "ubuntu", "cachyos", "peppermint" (the offline
    installers: the small installer plus that edition's image on the stick)."""
    try:
        with open(path) as f:
            name = f.read().strip()
    except OSError:
        name = ''
    if name in ('auto', 'installer'):
        return 'installer'
    return name if name in EDITIONS else DEFAULT_EDITION


def usb_edition(usb=None):
    """The edition this USB installs when none is picked: the one it carries, or Hearth OS on Anatase."""
    u = usb or this_usb()
    return DEFAULT_EDITION if u == 'installer' else u


def editions_offered(usb=None):
    """The editions the install screens offer: all of them on the small installer, which downloads what it installs;
    on an offline USB, the one it carries (it's on the stick, so no internet is needed)."""
    u = usb or this_usb()
    return list(EDITIONS) if u == 'installer' else [u]


def published(img, timeout=6):
    """Is this image on GitHub's registry? Asked anonymously, the way bootc does. None: couldn't tell (offline)."""
    import urllib.error
    import urllib.request
    repo, tag = img.split('/', 1)[1].rsplit(':', 1)
    try:
        with urllib.request.urlopen(f'https://ghcr.io/token?scope=repository:{repo}:pull', timeout=timeout) as r:
            token = json.load(r)['token']
        req = urllib.request.Request(f'https://ghcr.io/v2/{repo}/manifests/{tag}', method='HEAD', headers={
            'Authorization': f'Bearer {token}',
            'Accept': 'application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json, '
                      'application/vnd.docker.distribution.manifest.v2+json, application/vnd.docker.distribution.manifest.list.v2+json'})
        with urllib.request.urlopen(req, timeout=timeout):
            return True
    except urllib.error.HTTPError as e:
        return False if e.code in (401, 403, 404) else None
    except Exception:
        return None


def reachable(img, tries=3, wait=2):
    """Can this image be downloaded right now? Asked a few times (a network that just came up). None: couldn't
    reach GitHub's registry at all."""
    for i in range(tries):
        r = published(img)
        if r is not None:
            return r
        if i < tries - 1:
            time.sleep(wait)
    return None


def published_all(offered):
    """{edition: published?} for the editions offered, asked at once. An offline USB's own edition isn't asked."""
    if len(offered) == 1:
        return {}
    import threading
    out = {}

    def ask(k):
        out[k] = published(EDITIONS[k]['image'])
    ts = [threading.Thread(target=ask, args=(k,), daemon=True) for k in offered]
    for t in ts:
        t.start()
    for t in ts:
        t.join(10)
    return out


def edition_choices(offered, v3, sb, pubs=None):
    """The picker's rows: [{id, label, about, image, beta, recommended, allowed, reason, warning}]. Not allowed:
    CachyOS on a processor without x86-64-v3, or an image that isn't published yet (when that could be asked)."""
    out = []
    for k in offered:
        e = EDITIONS[k]
        reason = NO_V3 if k == 'cachyos' and not v3 else 'Not ready yet' if (pubs or {}).get(k) is False else None
        out.append({'id': k, 'label': e['label'], 'about': e['about'], 'image': e['image'], 'beta': e['beta'],
                    'recommended': k == DEFAULT_EDITION, 'allowed': reason is None, 'reason': reason,
                    'warning': edition_warning(k, sb)})
    return out


# ------------------------------------------------------------------ drives

def live_disk():
    """The USB stick Hearth is running from (never offered)."""
    for mnt in ('/run/initramfs/live', '/run/initramfs/isoscan'):
        r = sh(['findmnt', '-no', 'SOURCE', mnt], check=False)
        src = r.stdout.strip()
        if src:
            pk = sh(['lsblk', '-no', 'PKNAME', src], check=False).stdout.strip().splitlines()
            return '/dev/' + (pk[0] if pk and pk[0] else os.path.basename(src))
    return None


def disks():
    tree = json.loads(sh(['lsblk', '-J', '-b', '-o', 'NAME,PATH,TYPE,SIZE,MODEL,TRAN,RM,RO,FSTYPE,LABEL,PARTTYPE,PARTLABEL,UUID']).stdout)
    live = live_disk()
    out = []
    for d in tree.get('blockdevices', []):
        test_loop = d.get('type') == 'loop' and os.environ.get('HEARTH_INSTALL_TEST')   # the CI test's disk image
        if (d.get('type') != 'disk' and not test_loop) or d.get('ro') or int(d.get('size') or 0) < 8 * GIB:
            continue
        if re.match(r'/dev/(zram|sr|ram)', d['path']) or (d['path'].startswith('/dev/loop') and not os.environ.get('HEARTH_INSTALL_TEST')):
            continue
        parts = [{'dev': c['path'], 'fs': c.get('fstype'), 'label': c.get('label'), 'size': int(c.get('size') or 0),
                  'type': (c.get('parttype') or '').lower(), 'partlabel': c.get('partlabel') or '', 'uuid': c.get('uuid')}
                 for c in (d.get('children') or []) if c.get('type') == 'part']
        # Linux in LVM volumes (Ubuntu's and Fedora's encrypted or LVM installs): looked at, never shrunk.
        lvs = [{'dev': g['path'], 'fs': g.get('fstype'), 'label': g.get('label'), 'size': int(g.get('size') or 0), 'type': '',
                'partlabel': '', 'uuid': g.get('uuid'), 'lvm': True}
               for c in (d.get('children') or []) for g in (c.get('children') or []) if g.get('type') == 'lvm']
        out.append({
            'dev': d['path'], 'size': int(d['size']), 'model': (d.get('model') or '').strip() or 'Drive',
            'tran': d.get('tran') or '', 'removable': bool(d.get('rm')), 'live': d['path'] == live,
            'parts': parts,
            'windows': any(p['fs'] in ('ntfs', 'BitLocker') and p['size'] > 30 * GIB for p in parts),
            'systems': systems(parts + lvs, d['path'] == live),
            'tooSmall': int(d['size']) < MIN_DISK,
        })
    return out


# ------------------------------------------------------------------ what's already on a drive

STEAMOS_LABELS = {'rootfs-A', 'rootfs-B', 'var-A', 'var-B', 'efi-A', 'efi-B'}
SHRINKABLE = ('ext4', 'btrfs')


def is_ours(p):
    return (p.get('partlabel'), p.get('type')) in (('boot', XBOOTLDR_TYPE), ('hearth', LINUX_TYPE))


def parse_os_release(text):
    vals = {}
    for line in text.splitlines():
        m = re.match(r'\s*([A-Z_]+)=(.*)', line)
        if m:
            vals[m.group(1)] = m.group(2).strip().strip('"\'')
    return vals


def os_name(vals):
    if vals.get('ID') == 'steamos':
        return 'SteamOS'
    return vals.get('NAME') or vals.get('PRETTY_NAME') or vals.get('ID') or 'Linux'


def peek_mount(dev, fs, mnt):
    opts = {'ext4': 'ro,noload', 'ntfs': 'ro'}.get(fs, 'ro')
    for t in (['-t', 'ntfs3'], ['-t', 'ntfs-3g']) if fs == 'ntfs' else ([],):
        if sh(['mount', *t, '-o', opts, dev, mnt], check=False).returncode == 0:
            return True
    return False


def inside(root, rel):
    """A file inside a mounted system, following its links inside that system (never into this USB's)."""
    root = os.path.normpath(root)
    p = os.path.normpath(os.path.join(root, rel))
    for _ in range(8):
        if p != root and not p.startswith(root + os.sep):
            return None
        if not os.path.islink(p):
            return p if os.path.isfile(p) else None
        t = os.readlink(p)
        p = os.path.normpath(os.path.join(root, t.lstrip('/')) if t.startswith('/') else os.path.join(os.path.dirname(p), t))
    return None


def home_uuid(fstab_text):
    """The UUID a system mounts as /home (or /var/home), from its fstab."""
    for line in fstab_text.splitlines():
        bits = line.split()
        if len(bits) >= 2 and not bits[0].startswith('#') and bits[1] in ('/home', '/var/home') and bits[0].startswith('UUID='):
            return bits[0][5:]
    return None


def read_os_release(dev, fs):
    """(os-release, /home's UUID) of the Linux on a partition, looked at read-only; None if there's none.
    Plain installs, btrfs subvolumes (Fedora, openSUSE, Arch's @), and atomic ones (ostree: Bazzite, Silverblue)."""
    mnt = f'/run/hearth-install/peek-{os.path.basename(dev)}'
    os.makedirs(mnt, exist_ok=True)
    if not peek_mount(dev, fs, mnt):
        return None
    try:
        roots = [os.path.join(mnt, sub) for sub in ('', 'root', '@', '@root', '@rootfs')]
        roots += sorted(glob.glob(f'{mnt}/ostree/deploy/*/deploy/*.0')) + sorted(glob.glob(f'{mnt}/root/ostree/deploy/*/deploy/*.0'))
        for root in roots:
            f = inside(root, 'etc/os-release') or inside(root, 'usr/lib/os-release')
            if not f:
                continue
            vals = parse_os_release(open(f, errors='replace').read())
            fstab = inside(root, 'etc/fstab')
            return vals, (home_uuid(open(fstab, errors='replace').read()) if fstab else None)
        return None
    except OSError:
        return None
    finally:
        sh(['umount', mnt], check=False)


def has_windows(dev):
    """True/False: Windows' folders on an NTFS partition; None when it can't be looked at (hibernated...)."""
    mnt = f'/run/hearth-install/peek-{os.path.basename(dev)}'
    os.makedirs(mnt, exist_ok=True)
    if not peek_mount(dev, 'ntfs', mnt):
        return None
    try:
        names = {n.lower() for n in os.listdir(mnt)}
        return 'windows' in names and any(os.path.isdir(os.path.join(mnt, n, 'System32')) or os.path.isdir(os.path.join(mnt, n, 'system32'))
                                          for n in os.listdir(mnt) if n.lower() == 'windows')
    except OSError:
        return None
    finally:
        sh(['umount', mnt], check=False)


LINUX_FS = ('ext4', 'ext3', 'btrfs', 'xfs', 'f2fs', 'jfs', 'reiserfs')


def systems(parts, live=False, peek=read_os_release, peek_win=has_windows):
    """Every system on a drive's partitions: Windows, SteamOS and any other Linux, as [{kind, name, part,
    shrink}]. `shrink` is the partition that can give Hearth room (None when Hearth can't shrink it: XFS, LVM,
    encrypted); free space on the drive works for those."""
    if live:
        return []
    out, taken = [], set()
    for p in parts:
        if p['size'] < 30 * GIB:
            continue
        if p['fs'] == 'BitLocker':
            out.append({'kind': 'windows', 'name': 'Windows', 'part': p['dev'], 'shrink': p['dev']})
        elif p['fs'] == 'ntfs':
            w = peek_win(p['dev'])
            if w or (w is None and not any(x['kind'] == 'windows' for x in out)):   # can't look (hibernated): assume Windows
                out.append({'kind': 'windows', 'name': 'Windows', 'part': p['dev'], 'shrink': p['dev']})
    labels = {p.get('partlabel') for p in parts}
    if labels & STEAMOS_LABELS:
        # SteamOS (Steam Deck layout): two read-only system copies and a big "home" (ext4) with the games.
        home = next((p for p in parts if p.get('partlabel') == 'home' and p['fs'] in SHRINKABLE), None)
        out.append({'kind': 'linux', 'name': 'SteamOS', 'part': (home or {}).get('dev') or next(p['dev'] for p in parts if p.get('partlabel') in STEAMOS_LABELS),
                    'shrink': home['dev'] if home else None})
        taken |= {p['dev'] for p in parts if p.get('partlabel') in STEAMOS_LABELS | {'home', 'esp'}}
    by_uuid = {p.get('uuid'): p for p in parts if p.get('uuid')}
    for p in parts:
        if p['dev'] in taken or is_ours(p) or p['type'] in (ESP_TYPE, XBOOTLDR_TYPE) or p['size'] < 2 * GIB:
            continue
        if p['fs'] == 'crypto_LUKS':
            out.append({'kind': 'linux', 'name': 'Linux (encrypted)', 'part': p['dev'], 'shrink': None})
            continue
        if p['fs'] not in LINUX_FS:
            continue
        found = peek(p['dev'], p['fs'])
        if not found:
            continue
        vals, home = found
        shrink = p['dev'] if p['fs'] in SHRINKABLE and not p.get('lvm') else None
        h = by_uuid.get(home) if home else None
        if h and h['dev'] != p['dev'] and h['dev'] not in taken:
            taken.add(h['dev'])                              # its /home: not a system of its own
            if h['fs'] in SHRINKABLE and not h.get('lvm') and (not shrink or h['size'] > p['size']):
                shrink = h['dev']                           # the bigger one, usually with the games
        taken.add(p['dev'])
        out.append({'kind': 'linux', 'name': os_name(vals), 'part': p['dev'], 'shrink': shrink})
    # Two of the same (two Windows, two Ubuntus): tell them apart.
    seen = {}
    for x in out:
        seen[x['name']] = seen.get(x['name'], 0) + 1
        if seen[x['name']] > 1:
            x['name'] = f"{x['name']} ({seen[x['name']]})"
    return out


def fs_usage(dev, fs):
    """(size, used) in bytes of a file system, looked at read-only."""
    mnt = f'/run/hearth-install/peek-{os.path.basename(dev)}'
    os.makedirs(mnt, exist_ok=True)
    sh(['mount', '-o', 'ro,noload' if fs == 'ext4' else 'ro', dev, mnt])
    try:
        st = os.statvfs(mnt)
        size = st.f_blocks * st.f_frsize
        return size, size - st.f_bfree * st.f_frsize
    finally:
        sh(['umount', mnt], check=False)


KEEP_FREE = 20 * GIB


def can_give(size, used, part_size):
    """How much a Linux file system can give: it keeps what's used plus 20 GB, in whole GB."""
    keep = used + KEEP_FREE
    return max(0, (min(part_size, size) - keep) // GIB * GIB)


def check_linux(part):
    """Next to the Linux on `part`: {target: {...}, problems: [...], suggested}."""
    info = json.loads(sh(['lsblk', '-J', '-b', '-o', 'PATH,PKNAME,FSTYPE,SIZE,PARTLABEL,MOUNTPOINTS', part]).stdout)['blockdevices'][0]
    fs, psize = info.get('fstype'), int(info.get('size') or 0)
    problems = []
    # The drive it's on (an LVM volume's parent isn't the drive itself: find it through the systems list).
    d = next((x for x in disks() if any(part in (s.get('shrink'), s.get('part')) for s in x.get('systems', []))), None)
    disk = d['dev'] if d else '/dev/' + (info.get('pkname') or '')
    sysinfo = next((x for x in (d or {}).get('systems', []) if part in (x.get('shrink'), x.get('part'))), None)
    name = (sysinfo or {}).get('name') or 'Linux'
    shrinkable = fs in SHRINKABLE and bool(sysinfo and sysinfo.get('shrink') == part)
    target = {'kind': 'linux', 'name': name, 'part': part, 'disk': disk, 'fs': fs, 'size': psize, 'used': 0, 'min': psize, 'canGive': 0}
    free = free_regions(disk)
    target['freeSpace'] = free[0][1] * sector_size(disk) if free else 0
    if not shrinkable:
        if target['freeSpace'] < MIN_DISK:
            why = 'is encrypted' if fs == 'crypto_LUKS' else 'uses LVM' if sysinfo and part.startswith('/dev/mapper/') else f"uses {fs or 'a file system'}"
            problems.append({'id': 'fs', 'text': f"{name} {why}, which Hearth can't make smaller. Make {MIN_DISK // GIB} GB or more of free (unpartitioned) space on that drive in {name} first, or install on another drive."})
    else:
        if any(m for m in (info.get('mountpoints') or []) if m):
            release(disk)
        try:
            size, used = fs_usage(part, fs)
            target.update(used=used, min=used + KEEP_FREE, canGive=can_give(size, used, psize))
        except Fail as e:
            problems.append({'id': 'mount', 'text': f"Couldn't look inside {name}'s drive ({e}). It may need a check: start {name} once and shut it down properly."})
    if not existing_esp(disk):
        problems.append({'id': 'esp', 'text': f'{name} on this drive starts the old way (legacy BIOS). Hearth needs UEFI.'})
    give = max(target['canGive'], target['freeSpace'])   # free space already there, or what shrinking gives
    if not problems and give < MIN_DISK:
        problems.append({'id': 'room', 'text': f"{name} doesn't have room to give: Hearth needs {MIN_DISK // GIB} GB and {name} can give {give // GIB} GB. Free up space in {name}, or install on another drive."})
    suggested = min(give, max(MIN_DISK, give // 2 // (16 * GIB) * (16 * GIB)))
    return {'target': {**target, 'canGive': give}, 'problems': problems, 'suggested': suggested}


def sector_size(disk):
    """The drive's logical sector size: the unit of sfdisk's start=/size= and of its free-space list. Most drives
    say 512, but NVMe drives formatted with 4K sectors say 4096; counting those as 512 made every partition the
    wrong size (and put a shrunk partition's start somewhere else)."""
    try:
        with open(f'/sys/class/block/{os.path.basename(os.path.realpath(disk))}/queue/logical_block_size') as f:
            return int(f.read().strip()) or 512
    except (OSError, ValueError):
        return 512


def free_regions(disk):
    """Unpartitioned space on a drive: [(start_sector, sectors)], biggest first (sfdisk -F)."""
    out = sh(['sfdisk', '-F', '--bytes', disk]).stdout
    return parse_free(out)


def parse_free(text):
    regions = []
    for line in text.splitlines():
        m = re.match(r'\s*(\d+)\s+(\d+)\s+(\d+)\s+\d+', line)
        if m:
            start, end, n = int(m.group(1)), int(m.group(2)), int(m.group(3))
            regions.append((start, n))
    return sorted(regions, key=lambda r: -r[1])


def release(disk):
    """Nothing on the drive may be in use: unmount it and turn off swap on it."""
    for line in sh(['lsblk', '-nrpo', 'NAME,MOUNTPOINTS', disk], check=False).stdout.splitlines():
        bits = line.split(None, 1)
        if len(bits) == 2 and bits[1].strip():
            for m in bits[1].split('\\x0a'):
                if m.strip() == '[SWAP]':
                    sh(['swapoff', bits[0]], check=False)
                elif m.strip():
                    sh(['umount', '-R', m.strip()], check=False)


def settle(disk):
    sh(['partx', '-u', disk], check=False)
    sh(['udevadm', 'settle', '-t', '10'], check=False)
    time.sleep(1)


# ------------------------------------------------------------------ partitions

def partition_whole(disk):
    """GPT with EFI, /boot and Hearth. Returns (esp, boot, root, esp_is_new)."""
    release(disk)
    stage('disk', 1, 'Erasing the drive')
    sh(['wipefs', '-a', disk])
    ss = sector_size(disk)
    layout = (f'label: gpt\n'
              f'size={ESP_SIZE // ss}, type={ESP_TYPE}, name="EFI System"\n'
              f'size={BOOT_SIZE // ss}, type={XBOOTLDR_TYPE}, name="boot"\n'
              f'type={LINUX_TYPE}, name="hearth"\n')
    sh(['sfdisk', '--wipe', 'always', '--wipe-partitions', 'always', disk], input=layout)
    settle(disk)
    return part_path(disk, 1), part_path(disk, 2), part_path(disk, 3), True


def existing_esp(disk):
    """The EFI partition already on this drive (Windows' or SteamOS'): Hearth's boot loader goes next to theirs."""
    # Straight from the partition table: right after a resize, lsblk's view (udev) can still be the old one.
    for p in table(disk):
        if (p.get('type') or '').lower() == ESP_TYPE:
            return p['node']
    return None


def table(disk):
    """The drive's partitions as sfdisk reads them: [{node, start, size, type, name}]."""
    r = sh(['sfdisk', '-J', disk], check=False)
    try:
        return json.loads(r.stdout)['partitiontable'].get('partitions', [])
    except (ValueError, KeyError):
        return []


def partition_beside(disk, give):
    """Shrinks Windows (hearth-live-prep) and adds /boot and Hearth in the space it gave. Returns like above."""
    # A try that stopped after making Hearth's partitions: take those away again first (only ours: named
    # "boot" and "hearth" with Linux partition types, which Windows never makes).
    remove_ours(disk)
    # Already room (a try that stopped after shrinking, or Ember's "Switch to Hearth OS" made it): use it.
    room = free_regions(disk)
    if room and room[0][1] * sector_size(disk) >= min(give, MIN_DISK) * 0.95:
        stage('shrink', 14, 'Using the free space next to Windows')
        return partition_free(disk)
    stage('shrink', 0, 'Checking Windows')
    # The Windows on this drive (hearth-live-prep would otherwise pick the biggest Windows on any drive).
    p = subprocess.Popen([PREP, 'shrink', str(give), disk], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    last = ''
    for line in p.stdout:
        line = line.strip()
        m = re.match(r'progress: ([\d.]+) (.*)', line)
        if m:
            stage('shrink', float(m.group(1)) * 0.14, m.group(2))
        elif line.startswith('error: '):
            last = line[7:]
    if p.wait() != 0:
        raise Fail(last or "Windows' drive couldn't be shrunk")
    return partition_free(disk)


def partition_beside_linux(disk, part, give):
    """Makes room next to a Linux (SteamOS' home, or another Linux's ext4/btrfs) and installs there."""
    remove_ours(disk)
    room = free_regions(disk)
    if room and room[0][1] * sector_size(disk) >= min(give, MIN_DISK) * 0.95:
        stage('shrink', 14, 'Using the free space on the drive')
        return partition_free(disk)
    if part not in [p['dev'] for p in disks_parts(disk) if p['fs'] in SHRINKABLE]:
        raise Fail('there isn\'t enough free space on the drive, and that system can\'t be made smaller')
    shrink_linux(disk, part, give)
    return partition_free(disk)


def disks_parts(disk):
    return next((d['parts'] for d in disks() if d['dev'] == disk), [])


def part_number(part):
    return int(re.search(r'(\d+)$', part).group(1))


def new_fs_size(size, give, used):
    """The file system's size after giving `give` bytes, in whole MiB; Fail if that would squeeze what's on it."""
    new = (size - give) // MIB * MIB
    if new < used + KEEP_FREE:
        raise Fail(f'that leaves too little room for what is already there: it can give at most {max(0, size - used - KEEP_FREE) // GIB} GB')
    return new


def shrink_linux(disk, part, give):
    """Shrinks the ext4 or btrfs file system on `part`, then its partition (its start stays where it is)."""
    info = json.loads(sh(['lsblk', '-J', '-b', '-o', 'PATH,FSTYPE,SIZE,START', part]).stdout)['blockdevices'][0]
    fs, psize = info.get('fstype'), int(info['size'])
    if fs not in SHRINKABLE:
        raise Fail(f"that partition uses {fs}, which can't be made smaller")
    release(disk)
    stage('shrink', 1, 'Checking the drive')
    size, used = fs_usage(part, fs)
    new = new_fs_size(min(size, psize), give, used)
    if fs == 'ext4':
        r = sh(['e2fsck', '-f', '-y', part], check=False)
        if r.returncode not in (0, 1):
            raise Fail('the drive needs repairs first: ' + ((r.stderr or r.stdout).strip().splitlines() or ['e2fsck failed'])[-1])
        stage('shrink', 4, 'Making room (this can take a while if the drive is full)')
        sh(['resize2fs', part, f'{new // 1024}K'])
    else:
        mnt = '/run/hearth-install/shrink'
        os.makedirs(mnt, exist_ok=True)
        sh(['mount', part, mnt])
        try:
            stage('shrink', 4, 'Making room (this can take a while if the drive is full)')
            devid = (re.search(r'devid\s+(\d+)', sh(['btrfs', 'filesystem', 'show', mnt]).stdout) or [None, '1'])[1]
            sh(['btrfs', 'filesystem', 'resize', f'{devid}:{new}', mnt])
        finally:
            sh(['umount', mnt], check=False)
    stage('shrink', 12, 'Making room')
    # The start as sfdisk counts it (in the drive's sectors; /sys counts 512-byte units whatever the drive uses).
    start = next((int(p['start']) for p in table(disk) if p.get('node') == part and p.get('start') is not None), None)
    if start is None:
        start = int(open(f'/sys/class/block/{os.path.basename(part)}/start').read()) * 512 // sector_size(disk)
    sh(['sfdisk', '--no-reread', '--force', '-N', str(part_number(part)), disk], input=f'start={start}, size={new // sector_size(disk)}\n')
    settle(disk)


HEARTH_ESP_NAME = 'Hearth EFI'


def remove_ours(disk):
    ours = [p for p in table(disk) if (p.get('name'), (p.get('type') or '').lower()) in
            (('boot', XBOOTLDR_TYPE), ('hearth', LINUX_TYPE), (HEARTH_ESP_NAME, ESP_TYPE))]
    if not ours:
        return
    release(disk)
    for p in sorted(ours, key=lambda p: -part_number(p['node'])):
        sh(['sfdisk', '--no-reread', '--force', '--delete', disk, str(part_number(p['node']))])
    settle(disk)


def partition_free(disk):
    """Hearth's own EFI partition, /boot and Hearth in the biggest free space on a drive that has Windows or
    Linux. Hearth starts from its own EFI partition, in its own space, not from the other system's: that system
    (or its updates) can't overwrite or hide Hearth's boot loader, and a Fedora-based system already there
    (its EFI/fedora folder) can't make the PC start that system instead of Hearth."""
    release(disk)
    regions = free_regions(disk)
    ss = sector_size(disk)
    if not regions or regions[0][1] * ss < MIN_DISK:
        raise Fail("there's no room for Hearth on the drive after making room")
    start, n = regions[0]
    align = MIB // ss   # 1 MiB
    start = (start + align - 1) // align * align
    esp_n, boot_n = ESP_SIZE // ss, BOOT_SIZE // ss
    sh(['sfdisk', '--append', '--no-reread', '--force', disk],
       input=f'start={start}, size={esp_n}, type={ESP_TYPE}, name="{HEARTH_ESP_NAME}"\n'
             f'start={start + esp_n}, size={boot_n}, type={XBOOTLDR_TYPE}, name="boot"\n'
             f'start={start + esp_n + boot_n}, type={LINUX_TYPE}, name="hearth"\n')
    settle(disk)
    by_start = {int(p.get('start') or 0): p['node'] for p in table(disk)}
    esp, boot, root = by_start.get(start), by_start.get(start + esp_n), by_start.get(start + esp_n + boot_n)
    if not esp or not boot or not root:
        raise Fail("couldn't find the new partitions")
    return esp, boot, root, True


# ------------------------------------------------------------------ file systems

def make_filesystems(esp, boot, root, esp_new):
    stage('format', 15, 'Preparing the drive')
    if esp_new:
        sh(['mkfs.vfat', '-F', '32', '-n', 'EFI', esp])
    sh(['mkfs.ext4', '-F', '-q', '-L', 'boot', boot])
    sh(['mkfs.btrfs', '-f', '-q', '-L', 'hearth', root])
    os.makedirs(TARGET, exist_ok=True)
    sh(['mount', root, TARGET])
    for sv in ('root', 'home'):
        sh(['btrfs', 'subvolume', 'create', f'{TARGET}/{sv}'])
    sh(['umount', TARGET])
    sh(['mount', '-o', 'subvol=root,compress=zstd:1', root, TARGET])
    os.makedirs(f'{TARGET}/boot', exist_ok=True)
    sh(['mount', boot, f'{TARGET}/boot'])
    os.makedirs(f'{TARGET}/boot/efi', exist_ok=True)
    sh(['mount', '-o', 'umask=0077', esp, f'{TARGET}/boot/efi'])


def unmount_all():
    sh(['umount', '-R', TARGET], check=False)


# ------------------------------------------------------------------ Hearth OS itself

def parse_needed(line):
    """'layers already present: 3; layers needed: 62 (4.1 GB)' -> (62, bytes)."""
    m = re.search(r'layers needed:\s*(\d+)\s*\(([\d.]+)\s*([kMGT]?B)\)', line)
    if not m:
        return None
    mult = {'B': 1, 'kB': 1e3, 'MB': 1e6, 'GB': 1e9, 'TB': 1e12}[m.group(3)]
    return int(m.group(1)), int(round(float(m.group(2)) * mult))


def rx_bytes(net='/proc/net/dev'):
    """Bytes received so far on every network interface but loopback."""
    total = 0
    try:
        for line in open(net).read().splitlines()[2:]:
            name, _, rest = line.partition(':')
            if name.strip() != 'lo' and rest.split():
                total += int(rest.split()[0])
    except OSError:
        pass
    return total


# The full live ISO carries the Hearth OS on Anatase image itself (an OCI copy, made by
# .github/workflows/live-iso.yml), so it installs without the internet; the small installer USB doesn't, and
# downloads the edition picked. Either way the installed system updates from the edition's image in EDITIONS.
LOCAL_OCI = '/usr/share/hearth/image'


def local_image(image, oci=LOCAL_OCI):
    """The copy of `image` on this USB stick, as an image reference ostree reads, or None (not on this USB,
    or another edition was picked)."""
    try:
        with open(oci + '.ref') as f:
            ref = f.read().strip()
    except OSError:
        return None
    def name(r):   # ghcr.io/dragongamer9/hearth-os from ...:latest or ...@sha256:...
        r = r.split('@')[0]
        return r.rsplit(':', 1)[0] if ':' in r.rsplit('/', 1)[-1] else r
    if not ref or name(ref) != name(image) or not os.path.isfile(os.path.join(oci, 'index.json')):
        return None
    return f'ostree-unverified-image:oci:{oci}:hearth'


def download_text(got, total, bps, local=False):
    """'Downloading Hearth OS · 3.2 of 9.6 GB · 12.4 MB/s' ('Copying Hearth OS from the USB stick' offline)"""
    if local:
        return 'Copying Hearth OS from the USB stick' + (f' · {min(got, total) / 1e9:.1f} of {total / 1e9:.1f} GB' if total else '')
    t = 'Downloading Hearth OS'
    if total:
        t += f' · {min(got, total) / 1e9:.1f} of {total / 1e9:.1f} GB'
    if bps:
        t += f' · {bps / 1e6:.1f} MB/s'
    return t


def deploy(image, root_uuid):
    """Puts Hearth OS on the drive: from this USB stick when it has the image (the full ISOs, no internet needed),
    otherwise downloaded. Either way the installed system takes its updates from the online image, and its first
    update only downloads what changed since the USB was made."""
    src = local_image(image)
    if src:
        try:
            return deploy_from(image, root_uuid, src)
        except Fail as e:
            print(f'log: installing from the USB stick failed ({e}); downloading instead', flush=True)
            for d in glob.glob(f'{TARGET}/ostree') + glob.glob(f'{TARGET}/boot'):
                shutil.rmtree(d, ignore_errors=True)
    return deploy_from(image, root_uuid, None)


def deploy_from(image, root_uuid, src):
    """Downloads Hearth OS onto the drive (or copies it from `src`). Progress from ostree's "Fetching layer" lines."""
    local = src is not None
    stage('download', 18, 'Preparing' if local else 'Connecting')
    sh(['ostree', 'admin', 'init-fs', '--modern', TARGET])
    sh(['ostree', 'admin', 'stateroot-init', '--sysroot', TARGET, 'default'], check=False).returncode == 0 or \
        sh(['ostree', 'admin', 'os-init', '--sysroot', TARGET, 'default'])
    repo = f'{TARGET}/ostree/repo'
    sh(['ostree', 'config', '--repo', repo, 'set', 'sysroot.bootloader', 'none'])
    sh(['ostree', 'config', '--repo', repo, 'set', 'sysroot.readonly', 'true'])
    ref = f'ostree-unverified-registry:{image}'
    cmd = ['ostree', 'container', 'image', 'deploy', '--sysroot', TARGET, '--stateroot', 'default',
           '--imgref', src or ref, '--target-imgref', ref,
           '--karg', f'root=UUID={root_uuid}', '--karg', 'rootflags=subvol=root', '--karg', 'rw']
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    st = {'needed': 0, 'done': 0, 'total': 0, 'unpacking': False}
    tail = []
    started = time.time()
    rx0 = rx_bytes()

    # Every second: how much has come in (the network's own count) and how fast, so the screen moves even while
    # one big piece downloads. The layer count is the fallback when the network count isn't there.
    def watch():
        last_t, last_rx, bps = time.time(), (0 if local else rx_bytes()), 0.0
        while p.poll() is None:
            time.sleep(1)
            if st['unpacking']:
                continue
            now = time.time()
            if local:   # nothing comes over the network: the layers copied so far say how far it is
                rx = int(st['total'] * st['done'] / st['needed']) if st['needed'] else 0
                got = rx
            else:
                rx = rx_bytes()
                got = max(0, rx - rx0)
            inst = (rx - last_rx) / max(0.001, now - last_t)
            bps = inst if bps == 0 else bps * 0.7 + inst * 0.3   # smoothed, so the number doesn't jump around
            last_t, last_rx = now, rx
            total = st['total']
            frac_layers = st['done'] / st['needed'] if st['needed'] else 0
            frac = min(0.99, max(frac_layers, got / total if total else 0))
            left = int((total - got) / bps) if total and bps > 50_000 and got < total else None
            stage('download', 20 + 60 * frac, download_text(got, total, bps, local), done=st['done'], of=st['needed'], bytes=total,
                  got=min(got, total) if total else got, speed=int(bps), left=left, percent=int(frac * 100))

    import threading
    threading.Thread(target=watch, daemon=True).start()
    for line in p.stdout:
        line = line.strip()
        if not line:
            continue
        tail = (tail + [line])[-8:]
        n = parse_needed(line)
        if n:
            st['needed'], st['total'] = n
            stage('download', 20, download_text(0, st['total'], 0, local), bytes=st['total'], got=0, speed=0, percent=0)
        elif re.match(r'Fetching (layer|ostree chunk|ostree commit)', line):
            st['done'] = min(st['done'] + 1, st['needed'] or st['done'] + 1)
        elif re.search(r'Deploying|Staging|Writing|Committing', line):
            st['unpacking'] = True
            stage('download', 81, 'Unpacking Hearth OS')
    if p.wait() != 0:
        msg = next((l for l in reversed(tail) if re.search(r'error', l, re.I)), tail[-1] if tail else 'download failed')
        if re.search(r'resolve|network|connect|timeout|TLS|dial', msg, re.I):
            raise Fail("couldn't download Hearth OS. Check the internet connection and try again")
        raise Fail('installing Hearth OS failed: ' + msg)
    found = sorted(glob.glob(f'{TARGET}/ostree/deploy/default/deploy/*.0'), key=os.path.getmtime)
    if not found:
        raise Fail("Hearth OS was downloaded but couldn't be found on the drive")
    return found[-1]


def image_kargs(dep):
    """Kernel options the image asks for (/usr/lib/bootc/kargs.d/*.toml, e.g. Nvidia's), which bootc would add."""
    out = []
    for f in sorted(glob.glob(f'{dep}/usr/lib/bootc/kargs.d/*.toml')):
        text = open(f).read()
        if re.search(r'match-architectures\s*=\s*\[([^\]]*)\]', text) and 'x86_64' not in text:
            continue
        m = re.search(r'kargs\s*=\s*\[([^\]]*)\]', text, re.S)
        if m:
            out += re.findall(r'"([^"]+)"', m.group(1))
    return out


def add_kargs(kargs):
    if not kargs:
        return
    args = ['ostree', 'admin', 'kargs', 'edit-in-place', '--sysroot', TARGET]
    r = sh(args + [f'--append-if-missing={k}' for k in kargs], check=False)
    if r.returncode != 0:   # older ostree: append to the boot entry by hand
        for entry in glob.glob(f'{TARGET}/boot/loader/entries/*.conf'):
            text = open(entry).read()
            text = re.sub(r'^(options .*)$', lambda m: m.group(1) + ''.join(' ' + k for k in kargs if k not in m.group(1)), text, flags=re.M)
            open(entry, 'w').write(text)


def remount_esp(esp, mnt=None):
    """Hearth's EFI partition back at TARGET/boot/efi: bootupctl --device mounts it somewhere of its own and
    unmounts it again, so after it nothing is there (asking findmnt for it then failed the whole install, after
    the boot loader was already in place, leaving no user account, fstab or time zone)."""
    mnt = mnt or f'{TARGET}/boot/efi'
    os.makedirs(mnt, exist_ok=True)
    if not os.path.ismount(mnt):
        sh(['mount', '-o', 'umask=0077', esp, mnt])


def bootloader(disk, firmware, dep=None, esp=None):
    stage('boot', 84, 'Setting up starting up')
    # UEFI only (Hearth's PCs and Windows next to it all start that way); --auto would also try BIOS on some.
    cmd = ['bootupctl', 'backend', 'install', '--component', 'EFI', '--with-static-configs', '--write-uuid', '--device', disk]
    # The boot loader from Hearth OS itself (the installer USB may be a different system with an older one).
    if dep and os.path.isdir(f'{dep}/usr/lib/bootupd'):
        cmd += ['--src-root', dep]
    if firmware:
        cmd.append('--update-firmware')
    r = sh(cmd + [TARGET], check=False)
    for flag, instead in (('--src-root', []), ('--component', ['--auto']), ('--with-static-configs', [])):
        if r.returncode != 0 and flag in ((r.stderr or '') + (r.stdout or '')) and flag in cmd:
            i = cmd.index(flag)
            cmd = cmd[:i] + instead + cmd[i + (2 if flag in ('--component', '--src-root') else 1):]
            r = sh(cmd + [TARGET], check=False)
    if r.returncode != 0:
        raise Fail('setting up the boot loader failed: ' + ((r.stderr or r.stdout).strip().splitlines() or ['?'])[-1])
    if esp:
        remount_esp(esp)
    if firmware:
        ensure_boot_entry(disk, esp)


# Other systems' boot loaders on EFI partitions: "Windows", "SteamOS", ... in Hearth's boot menu.
KNOWN_LOADERS = [('Microsoft', 'Boot/bootmgfw.efi', 'Windows'), ('steamos', 'steamcl.efi', 'SteamOS')]
GENERIC_LOADERS = ('shimx64.efi', 'grubx64.efi', 'systemd-bootx64.efi')
SKIP_DIRS = {'boot', 'fedora', 'hearth', 'tools', 'linux', 'efi'}


def efi_loader(esp_root):
    """Hearth's boot loader on its EFI partition, as the firmware names it: \\EFI\\<distro>\\shimx64.efi (or grub).
    Fedora-based Hearth installs EFI/fedora, the Debian and Ubuntu editions EFI/debian or EFI/ubuntu."""
    efi = next((os.path.join(esp_root, n) for n in os.listdir(esp_root) if n.lower() == 'efi'), None) if os.path.isdir(esp_root) else None
    for d in ('fedora', 'debian', 'ubuntu', 'anatase', 'cachyos', 'arch'):
        for f in ('shimx64.efi', 'grubx64.efi'):
            real = next((os.path.join(efi, n) for n in (os.listdir(efi) if efi else []) if n.lower() == d), None)
            if real and os.path.isfile(os.path.join(real, f)):
                return f'\\EFI\\{os.path.basename(real)}\\{f}'
    return '\\EFI\\fedora\\grubx64.efi'


def find_loaders(esp_root, skip=()):
    """[(title, path on the EFI partition)] of other systems' boot loaders under esp_root/EFI."""
    efi = next((os.path.join(esp_root, n) for n in os.listdir(esp_root) if n.lower() == 'efi'), None) if os.path.isdir(esp_root) else None
    if not efi:
        return []
    out = []
    dirs = sorted(os.listdir(efi))
    for d in dirs:
        full = os.path.join(efi, d)
        if not os.path.isdir(full) or d.lower() in SKIP_DIRS or d.lower() in skip:
            continue
        hit = None
        for name, rel, title in KNOWN_LOADERS:
            if d.lower() == name.lower() and os.path.isfile(os.path.join(full, rel)):
                hit = (title, f'/EFI/{d}/{rel}')
        if not hit:
            for f in GENERIC_LOADERS:
                if os.path.isfile(os.path.join(full, f)):
                    hit = (d.capitalize() if d.islower() else d, f'/EFI/{d}/{f}')
                    break
        if hit:
            out.append(hit)
    return out


def menu_text(entries):
    """grub menu entries that start each system's own boot loader (chainloader), by EFI partition UUID."""
    out = ['# Other systems on this PC, found by Hearth\'s installer. Each starts that system\'s own boot loader.']
    for title, uuid, path in entries:
        safe = re.sub(r"[^A-Za-z0-9 ._()-]", '', title) or 'Other system'
        out.append(f"menuentry '{safe}' --class os {{\n"
                   f"  insmod part_gpt\n  insmod fat\n  insmod chain\n"
                   f"  search --no-floppy --fs-uuid --set=root {uuid}\n"
                   f"  chainloader {path}\n}}")
    return '\n'.join(out) + '\n'


def other_systems_menu(esp=None):
    """Adds Windows, SteamOS and other systems to Hearth's boot menu (custom.cfg, which Hearth's boot loader
    reads), and shows the menu at start when there are any. `esp`: Hearth's own EFI partition."""
    entries = []
    mine = esp or sh(['findmnt', '-no', 'SOURCE', f'{TARGET}/boot/efi'], check=False).stdout.strip()
    # Every EFI partition on every drive, from the partition tables themselves (fresh after the changes).
    esps = []
    for name in json.loads(sh(['lsblk', '-J', '-d', '-o', 'PATH,TYPE']).stdout).get('blockdevices', []):
        if name.get('type') == 'disk' or (name.get('type') == 'loop' and os.environ.get('HEARTH_INSTALL_TEST')):
            for p in table(name['path']):
                if (p.get('type') or '').lower() == ESP_TYPE:
                    uuid = sh(['blkid', '-s', 'UUID', '-o', 'value', p['node']], check=False).stdout.strip()
                    if uuid:
                        esps.append({'path': p['node'], 'uuid': uuid})
    for d in esps:
        if d['path'] == mine:
            root = f'{TARGET}/boot/efi'
            # Hearth's own boot loader folder (EFI/debian on the Debian editions) isn't "another system".
            own = efi_loader(root).split('\\')[2].lower()
            entries += [(t, d['uuid'], p) for t, p in find_loaders(root, {own})]
            continue
        mnt = '/run/hearth-install/esp-peek'
        os.makedirs(mnt, exist_ok=True)
        if sh(['mount', '-o', 'ro', d['path'], mnt], check=False).returncode == 0:
            try:
                entries += [(t, d['uuid'], p) for t, p in find_loaders(mnt)]
            finally:
                sh(['umount', mnt], check=False)
    seen, uniq = set(), []
    for e in entries:
        if (e[1], e[2]) not in seen:
            seen.add((e[1], e[2])); uniq.append(e)
    if not uniq:
        return []
    grub = grub_dir(f'{TARGET}/boot')
    os.makedirs(grub, exist_ok=True)
    with open(f'{grub}/custom.cfg', 'w') as f:
        f.write(menu_text(uniq))
    env = f'{grub}/grubenv'
    editenv = shutil.which('grub2-editenv') or shutil.which('grub-editenv')
    if os.path.exists(env) and editenv:
        sh([editenv, env, 'unset', 'menu_auto_hide'], check=False)   # show the menu: there's a choice
    return uniq


def grub_dir(boot):
    """The folder of the GRUB menu that starts this system, where custom.cfg is read ($prefix/custom.cfg).
    Every edition boots through bootupd's static GRUB config, whatever its GRUB (Fedora's, Debian's and Ubuntu's
    signed one, Arch's): its EFI part looks for <boot>/grub2 (then <boot>/boot/grub2) and its 41_custom.cfg sources
    custom.cfg from there. Only a /boot with a menu in grub/ and none in grub2/ (a GRUB set up the distribution's
    usual way, not by bootupd) uses grub/."""
    for d in ('grub2', 'boot/grub2'):
        if os.path.isfile(os.path.join(boot, d, 'grub.cfg')):
            return os.path.join(boot, d)
    if os.path.isfile(os.path.join(boot, 'grub', 'grub.cfg')):
        return os.path.join(boot, 'grub')
    return os.path.join(boot, 'grub2')


def entry_label(line):
    """'Boot0001* Hearth OS\tHD(...)' (or two spaces before the path) -> 'Hearth OS'."""
    m = re.match(r'^Boot[0-9A-Fa-f]{4}\*?\s+(.*?)(?:\t|\s{2,}|\s+(?:HD|PciRoot|VenHw|FvVol|BBS)\(|$)', line)
    return m.group(1).strip() if m else ''


def boot_entries(text):
    """efibootmgr -v: ({'0003': line, ...}, ['0003', '0000', ...] boot order)."""
    entries = {m.group(1): m.group(0) for m in re.finditer(r'^Boot([0-9A-Fa-f]{4})\*?\s.*$', text, re.M)}
    m = re.search(r'^BootOrder:\s*([0-9A-Fa-f,]*)', text, re.M)
    return entries, [x for x in (m.group(1).split(',') if m else []) if x]


def ensure_boot_entry(disk, esp=None):
    """A firmware boot entry for Hearth's own EFI partition (`esp`, known from partitioning), first in the boot
    order. Old "Hearth OS" entries that point somewhere else go (they'd start another system, or nothing)."""
    if not os.path.isdir('/sys/firmware/efi'):
        return
    esp_part = esp or sh(['findmnt', '-no', 'SOURCE', f'{TARGET}/boot/efi'], check=False).stdout.strip()
    if not esp_part or not re.search(r'\d+$', esp_part):
        raise Fail("couldn't tell which EFI partition Hearth's boot loader is on")
    partuuid = sh(['blkid', '-s', 'PARTUUID', '-o', 'value', esp_part], check=False).stdout.strip().lower()
    num = re.search(r'(\d+)$', esp_part).group(1)
    loader = efi_loader(f'{TARGET}/boot/efi')
    entries, order = boot_entries(sh(['efibootmgr', '-v'], check=False).stdout)
    for n, line in entries.items():
        if 'Hearth OS' in line and partuuid and partuuid not in line.lower():
            sh(['efibootmgr', '-q', '-b', n, '-B'], check=False)
    entries, order = boot_entries(sh(['efibootmgr', '-v'], check=False).stdout)
    mine = next((n for n, line in entries.items() if partuuid and partuuid in line.lower()), None)
    # bootupd names the entry after the system it runs on: the USB ("Hearth installer", "Hearth OS offline
    # installer (peppermint)"). The firmware's boot menu should say Hearth OS.
    if mine and entry_label(entries[mine]) != 'Hearth OS':
        sh(['efibootmgr', '-q', '-b', mine, '-B'], check=False)
        entries, order = boot_entries(sh(['efibootmgr', '-v'], check=False).stdout)
        mine = None
    if not mine:
        sh(['efibootmgr', '-q', '-c', '-d', disk, '-p', num, '-L', 'Hearth OS', '-l', loader], check=False)
        entries, order = boot_entries(sh(['efibootmgr', '-v'], check=False).stdout)
        mine = next((n for n, line in entries.items() if partuuid and partuuid in line.lower()), None)
    if mine:
        sh(['efibootmgr', '-q', '-o', ','.join([mine] + [x for x in order if x.upper() != mine.upper()])], check=False)


# ------------------------------------------------------------------ the new system's settings

def write_fstab(dep, esp, boot, root):
    ru, bu, eu = uuid_of(root), uuid_of(boot), uuid_of(esp)
    text = fstab_text(ru, bu, eu)
    with open(f'{dep}/etc/fstab', 'w') as f:
        f.write(text)


def fstab_text(ru, bu, eu):
    return ('# Written by Hearth\'s installer\n'
            f'UUID={ru} / btrfs subvol=root,compress=zstd:1,x-systemd.device-timeout=0 0 0\n'
            f'UUID={bu} /boot ext4 defaults 1 2\n'
            f'UUID={eu} /boot/efi vfat umask=0077,shortname=winnt 0 2\n'
            f'UUID={ru} /var/home btrfs subvol=home,compress=zstd:1,x-systemd.device-timeout=0 0 0\n')


def setup_system(dep, root, plan):
    stage('user', 90, 'Creating your account')
    var = f'{TARGET}/ostree/deploy/default/var'
    os.makedirs(f'{dep}/var', exist_ok=True)
    sh(['mount', '--bind', var, f'{dep}/var'])
    os.makedirs(f'{dep}/var/home', exist_ok=True)
    sh(['mount', '-o', 'subvol=home,compress=zstd:1', root, f'{dep}/var/home'])
    try:
        u = plan['user']
        # The account written straight into the new system's files (no useradd/chpasswd: the USB's tools
        # failed against another root, and the new system's PAM refused passwords). No password: signing in,
        # the lock screen and system changes just need Enter (pam_unix nullok).
        add_account(dep, u['name'], u['full'], '' if u.get('nopassword') else password_hash(u['password']))
        with open(f'{dep}/etc/hostname', 'w') as f:
            f.write(plan['hostname'] + '\n')
        if os.path.exists(f'{dep}/usr/share/zoneinfo/{plan["timezone"]}'):
            lt = f'{dep}/etc/localtime'
            if os.path.lexists(lt):
                os.remove(lt)
            os.symlink(f'../usr/share/zoneinfo/{plan["timezone"]}', lt)
        copy_wifi(dep)
        signin_choice(dep, u['name'], plan['signin'])
        # Hearth's first start offers to import games from Windows (beside) and sets up the rest.
        os.makedirs(f'{dep}/etc/nimbus', exist_ok=True)
        with open(f'{dep}/etc/nimbus/installed.json', 'w') as f:
            json.dump({'mode': plan['mode'], 'edition': plan.get('edition', DEFAULT_EDITION), 'image': plan.get('image', ''),
                       'at': int(time.time())}, f)
        relabel(dep, ['/etc', '/var/home'])
    finally:
        sh(['umount', f'{dep}/var/home'], check=False)
        sh(['umount', f'{dep}/var'], check=False)


def signin_choice(dep, name, signin):
    """auto: straight in at start, no lock after sleep. start: the login screen at start. always: the login
    screen at start and the password after sleep (Game Mode and Mantel). Changeable in Settings › Sign-in."""
    if signin in ('start', 'always'):
        os.makedirs(f'{dep}/etc/nimbus', exist_ok=True)
        open(f'{dep}/etc/nimbus/no-autologin', 'w').close()
    if signin == 'always':
        ent = next(l.split(':') for l in open(f'{dep}/etc/passwd') if l.split(':')[0] == name)
        uid, gid, home = int(ent[2]), int(ent[3]), dep + ent[5]
        d = f'{home}/.local/share/nimbus'
        os.makedirs(d, exist_ok=True)
        with open(f'{d}/desktop.json', 'w') as f:
            json.dump({'lockOnWake': True}, f)
        for path in (f'{home}/.local', f'{home}/.local/share', d, f'{d}/desktop.json'):
            os.chown(path, uid, gid)


def copy_wifi(dep):
    """The Wi-Fi networks joined on the USB, so the installed Hearth is online straight away."""
    src = '/etc/NetworkManager/system-connections'
    dst = f'{dep}/etc/NetworkManager/system-connections'
    if not os.path.isdir(src):
        return
    os.makedirs(dst, exist_ok=True)
    for f in glob.glob(f'{src}/*.nmconnection'):
        out = os.path.join(dst, os.path.basename(f))
        shutil.copy2(f, out)
        os.chmod(out, 0o600)


def read_lines(path):
    try:
        with open(path) as f:
            return f.read().splitlines()
    except OSError:
        return None


def write_lines(path, lines, mode):
    """Rewrites an account file in place of the old one, keeping its permissions and owner."""
    try:
        st = os.stat(path)
        mode, uid, gid = stat.S_IMODE(st.st_mode), st.st_uid, st.st_gid
    except OSError:
        uid = gid = 0
    tmp = path + '.hearth-new'
    with open(tmp, 'w') as f:
        f.write('\n'.join(lines) + '\n')
    os.chmod(tmp, mode)
    os.chown(tmp, uid, gid)
    os.replace(tmp, path)


def account_lines(passwd, group, name, full, shell):
    """(uid, passwd line, group line) for a new person: the first id from 1000 that is free as a user and as a
    group, and a group of their own with the same number."""
    used = {int(l.split(':')[2]) for l in passwd if l.count(':') >= 6 and l.split(':')[2].isdigit()}
    used |= {int(l.split(':')[2]) for l in group if l.count(':') >= 3 and l.split(':')[2].isdigit()}
    if any(l.split(':')[0] == name for l in passwd):
        raise Fail(f'"{name}" is already a user on the new system: pick another user name')
    uid = next(i for i in range(1000, 60000) if i not in used)
    full = full.replace(':', ' ').replace('\n', ' ')
    return uid, f'{name}:x:{uid}:{uid}:{full}:/var/home/{name}:{shell}', f'{name}:x:{uid}:'


def with_member(lines, group, name):
    """The group file with `name` added to `group` (if that group is there). Returns (lines, added?)."""
    out, added = [], False
    for l in lines:
        f = l.split(':')
        if len(f) >= 4 and f[0] == group:
            members = [m for m in f[3].split(',') if m]
            if name not in members:
                members.append(name)
            f[3] = ','.join(members)
            l, added = ':'.join(f), True
        out.append(l)
    return out, added


def add_account(dep, name, full, pw_hash):
    """The person's account, written into the new system's own files: passwd, group, shadow, gshadow,
    subuid/subgid (containers), in wheel (or sudo) for admin rights; their home folder from /etc/skel."""
    etc = f'{dep}/etc'
    passwd, group = read_lines(f'{etc}/passwd'), read_lines(f'{etc}/group')
    shadow, gshadow = read_lines(f'{etc}/shadow'), read_lines(f'{etc}/gshadow')
    if passwd is None or group is None or shadow is None:
        raise Fail("the new system's account files are missing")
    shell = '/bin/bash' if os.path.exists(f'{dep}/usr/bin/bash') or os.path.exists(f'{dep}/bin/bash') else '/bin/sh'
    uid, pline, gline = account_lines(passwd, group, name, full, shell)
    admin = next((g for g in ('wheel', 'sudo') if any(l.split(':')[0] == g for l in group)), None)
    group = group + [gline]
    if admin:
        group, _ = with_member(group, admin, name)
    days = int(time.time() // 86400)
    write_lines(f'{etc}/passwd', passwd + [pline], 0o644)
    write_lines(f'{etc}/group', group, 0o644)
    write_lines(f'{etc}/shadow', shadow + [f'{name}:{pw_hash}:{days}:0:99999:7:::'], 0o000)
    if gshadow is not None:
        gs = gshadow + [f'{name}:!::']
        if admin:
            gs, _ = with_member(gs, admin, name)
        write_lines(f'{etc}/gshadow', gs, 0o000)
    for sub in ('subuid', 'subgid'):
        lines = read_lines(f'{etc}/{sub}')
        if lines is not None and not any(l.split(':')[0] == name for l in lines):
            starts = [int(l.split(':')[1]) + int(l.split(':')[2]) for l in lines if l.count(':') == 2 and l.split(':')[1].isdigit() and l.split(':')[2].isdigit()]
            write_lines(f'{etc}/{sub}', lines + [f'{name}:{max(starts + [524288])}:65536'], 0o644)
    home = f'{dep}/var/home/{name}'
    if not os.path.exists(home):
        if os.path.isdir(f'{etc}/skel'):
            shutil.copytree(f'{etc}/skel', home, symlinks=True)
        else:
            os.makedirs(home)
    for d, dirs, files in os.walk(home):
        for x in [d] + [os.path.join(d, f) for f in dirs + files]:
            os.lchown(x, uid, uid)
    os.chmod(home, 0o700)
    return uid


def password_hash(password):
    """SHA-512 crypt ($6$...) of a password, made with openssl (no stdin echo, never on a command line)."""
    r = sh(['openssl', 'passwd', '-6', '-stdin'], input=password + '\n')
    h = r.stdout.strip()
    if not h.startswith('$6$'):
        raise Fail("couldn't set the password")
    return h


def selinux_on(dep):
    """Whether the new system uses SELinux (Fedora-based Anatase does; Ubuntu, Peppermint and CachyOS don't)."""
    try:
        text = open(f'{dep}/etc/selinux/config').read()
    except OSError:
        return False
    m = re.search(r'^\s*SELINUX\s*=\s*(\w+)', text, re.M)
    return bool(m) and m.group(1).lower() != 'disabled'


def mark_autorelabel(dep):
    """Relabel on first start instead. The deployment's own root is immutable (ostree), so /etc holds the mark
    (selinux-autorelabel reads /.autorelabel, which an ostree system links from /etc); never fatal."""
    for f in (f'{dep}/etc/.autorelabel', f'{dep}/.autorelabel'):
        try:
            open(f, 'w').close()
            return True
        except OSError:
            continue
    return False


def relabel(dep, paths):
    """SELinux labels for what was written (or logging in fails on the new system). Nothing on a system
    without SELinux."""
    if not selinux_on(dep):
        return
    fc = f'{dep}/etc/selinux/targeted/contexts/files/file_contexts'
    if not os.path.exists(fc) or not shutil.which('setfiles'):
        mark_autorelabel(dep)
        return
    r = sh(['setfiles', '-F', '-r', dep, fc] + [dep + p for p in paths], check=False)
    if r.returncode != 0:
        mark_autorelabel(dep)


# ------------------------------------------------------------------ the whole run

def run(plan):
    plan = check_plan(plan)
    disk = plan['disk']
    info = next((d for d in disks() if d['dev'] == disk), None)
    if not info:
        raise Fail('that drive is gone or can\'t be used')
    if info['live']:
        raise Fail("that's the USB stick Hearth is running from")
    if plan.get('firmware', True) and not os.path.isdir('/sys/firmware/efi'):
        raise Fail('this PC started the USB in legacy (BIOS) mode. Restart, and start the USB in UEFI mode from the boot menu')
    if plan['mode'] == 'whole' and info['tooSmall']:
        raise Fail(f'that drive is too small: Hearth needs at least {MIN_DISK // GIB} GB')
    warning = edition_warning(plan['edition'], secure_boot())
    if warning:
        print(f'log: {warning}', flush=True)   # a warning, not a stop: Secure Boot can be turned off afterwards
    print(f"log: installing {EDITIONS[plan['edition']]['label']} ({plan['image']})", flush=True)
    # Hearth OS is downloaded after the drive is erased (or Windows made smaller): without the internet the
    # install stopped there, with the drive already wiped. Ask first, before anything on the drive changes.
    if not local_image(plan['image']) and reachable(plan['image']) is None:
        raise Fail("there's no internet connection, and Hearth OS is downloaded while it installs. Connect to Wi-Fi "
                   "or plug in a cable, then try again. Nothing on the drive was changed")
    unmount_all()
    try:
        if plan['mode'] == 'whole':
            esp, boot, root, esp_new = partition_whole(disk)
        elif plan.get('part') and any(plan['part'] in (x.get('part'), x.get('shrink')) for x in info['systems'] if x['kind'] == 'linux'):
            esp, boot, root, esp_new = partition_beside_linux(disk, plan['part'], plan['give'])
        else:
            esp, boot, root, esp_new = partition_beside(disk, plan['give'])
        make_filesystems(esp, boot, root, esp_new)
        dep = deploy(plan['image'], uuid_of(root))
        # Hearth mounts what's in its fstab and nothing else: systemd's automatic partition mounting would pick up
        # another Linux's /home or /var on the same drive (SteamOS marks its partitions that way) and fail.
        add_kargs(image_kargs(dep) + ['systemd.gpt_auto=0', 'rd.systemd.gpt_auto=0'] + plan['kargs'])
        # Debian- and Ubuntu-based editions: their signed GRUB can't read ostree's boot entries itself, so the
        # image's helper writes the GRUB menu from them (Fedora-based images don't have, or need, it).
        bls = f'{dep}/usr/libexec/nimbus/hearth-bls-grub'
        if os.path.isfile(bls):
            sh(['sh', bls, '--boot', f'{TARGET}/boot'])
        bootloader(disk, plan.get('firmware', True), dep, esp)
        if os.path.isfile(bls):   # again: bootupd may have rewritten /boot/grub2
            sh(['sh', bls, '--boot', f'{TARGET}/boot'])
        other_systems_menu(esp)
        write_fstab(dep, esp, boot, root)
        setup_system(dep, root, plan)
        stage('finish', 97, 'Finishing up')
        sh(['sync'])
    finally:
        unmount_all()
    stage('done', 100, 'Hearth OS is installed')
    return {'ok': True, 'disk': disk, 'mode': plan['mode'], 'user': plan['user']['name'], 'edition': plan['edition'],
            'image': plan['image'], 'warning': warning}


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    if os.geteuid() != 0:
        print('error: run this as root (pkexec)', flush=True)
        return 1
    try:
        if cmd == 'disks':
            img = image(usb_edition())
            sb = secure_boot()
            # offline: this USB carries Hearth OS itself (the full live USB), so installing needs no internet.
            # editions: the picker (the small installer offers every edition; the live USB, the one it carries).
            print(json.dumps({'disks': disks(), 'image': img, 'edition': usb_edition(), 'offline': local_image(img) is not None,
                              'efi': os.path.isdir('/sys/firmware/efi'), 'secureBoot': sb,
                              'editions': edition_choices(editions_offered(), cpu_v3(), sb, published_all(editions_offered()))}))
        elif cmd == 'check' and len(argv) > 2:
            print(json.dumps(check_linux(argv[2])))
        elif cmd == 'run':
            print('result: ' + json.dumps(run(json.loads(sys.stdin.read() or '{}'))), flush=True)
        else:
            print('error: usage: hearth-install disks | check PART | run < plan.json', flush=True)
            return 1
    except (Fail, json.JSONDecodeError) as e:
        print('error: ' + str(e), flush=True)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
