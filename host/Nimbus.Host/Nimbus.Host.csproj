<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nimbus.Host</RootNamespace>
    <AssemblyName>Nimbus</AssemblyName>
    <!-- Release builds get their version from the git tag (vX.Y.Z) in CI. -->
    <Version>0.4.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned to the version verified to build. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <!-- WMI, for screen brightness -->
    <PackageReference Include="System.Management" Version="8.0.0" />
    <!-- DPAPI, for the Xbox sign-in token -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Copy the web UI next to the exe as wwwroot/ -->
  <ItemGroup>
    <Content Include="..\..\ui\**\*.*" LinkBase="wwwroot">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
