; Engine configuration file.
; Quad Mech Prototype - Godot 4.3+

config_version=5

[application]

config/name="Quad Mech Prototype"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3")

[autoload]

Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[physics]

common/physics_ticks_per_second=60

[rendering]

anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/use_taa=true
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/ssao/quality=2
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0.5, 0.55, 0.6, 1)
lights_and_shadows/directional_shadow/16_bits=false
global_illumination/sdfgi/probe_ray_count=2
