# Hearth OS — Oukitel RT8 kernel fragment
# Applied after: gki_defconfig mimir.config entry_level.config halium.config
#
# Hardware below comes from the stock RT8 device tree (vendor_boot dtb +
# dtbo) and the stock vendor module list. Everything marked "stock .ko" is a
# module Oukitel ships; the matching driver source already exists in the
# Volla MT8781 kernel tree.

# --- Display ---------------------------------------------------------------
# RT8 ships one of three 1200x1920 DSI panels (BOE ICNL9551R 60/90 Hz or
# Hongxun HX83102 90 Hz). Driven by the DT-described common panel driver
# ("wb,drm_lcm"), which can take over the panel LK already initialised.
CONFIG_WB_DRM_LCM_SUPPORT=m

# --- Touch -----------------------------------------------------------------
# Stock DT node "focaltech@0" carries both Focaltech and Chipone properties;
# the unit ships with one or the other. stock .ko: chipone-tddi.ko
CONFIG_TOUCHSCREEN_CHIPONE=m
CONFIG_TOUCHSCREEN_CHIPONE_I2C=m
CONFIG_TOUCHSCREEN_FTS_I2C_V42=m

# --- Charging / USB-C ------------------------------------------------------
# stock .ko: sc8960x_charger.ko (SC89601D), aw35615 Type-C PD controller,
# and the MT6375 sub-PMIC (charger, TCPC, ADC) that the Volla Tablet lacks.
CONFIG_CHARGER_SC8960X=m
CONFIG_AW35615_PD=m
CONFIG_MFD_MT6375=m
CONFIG_CHARGER_MT6375=m
CONFIG_TCPC_MT6375=m
CONFIG_MEDIATEK_MT6375_ADC=m
CONFIG_MEDIATEK_MT6375_AUXADC=m

# --- Audio -----------------------------------------------------------------
# Awinic AW883xx smart amplifier on i2c8 (stock DT fragment@13)
CONFIG_SND_SOC_AW883XX=m

# --- NFC -------------------------------------------------------------------
# ST21NFC on the stock DT (fragment@22)
CONFIG_NFC_ST21NFC=m

# --- Hearth userspace needs ------------------------------------------------
# Game controllers over USB and Bluetooth (Xbox-style pads are Hearth's default).
CONFIG_INPUT_JOYDEV=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_JOYSTICK_XPAD_FF=y
CONFIG_JOYSTICK_XPAD_LEDS=y
CONFIG_HID_MICROSOFT=m
CONFIG_HID_SONY=m
CONFIG_HID_NINTENDO=m
CONFIG_HID_STEAM=m
CONFIG_UHID=y
# Flatpak / bubblewrap and container tooling
CONFIG_USER_NS=y
CONFIG_OVERLAY_FS=y
CONFIG_FUSE_FS=y
