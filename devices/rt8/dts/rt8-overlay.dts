/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {
		};
	};

	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {

			fixedregulator@0 {
				compatible = "regulator-fixed";
				gpio = <0xffffffff 0x5f 0x00>;
				regulator-name = "sdio_fixed_3v3";
				regulator-min-microvolt = <0x325aa0>;
				regulator-max-microvolt = <0x325aa0>;
				enable-active-high;
				regulator-always-on;
				phandle = <0x65>;
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			hardware = "mt8781";
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			compatible = "mediatek,pwm-leds";

			backlight {
				led_mode = <0x05>;
				pwms = <0xffffffff 0x00 0x99d9>;
				gate_enable = <0x00>;
				pwm_config = <0x00 0x01 0x00 0x00 0x00>;
				max-hw-brightness = <0x56c>;
				default-state = "on";
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			lcd_bias_enp0 {
				phandle = <0x01>;

				pins_cmd_dat {
					pinmux = <0x9c00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcd_bias_enp1_gpio {
				phandle = <0x02>;

				pins_cmd_dat {
					pinmux = <0x9c00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcd_bias_enn0_gpio {
				phandle = <0x03>;

				pins_cmd_dat {
					pinmux = <0x9e00>;
					slew-rate = <0x01>;
					output-low;
				};
			};

			lcd_bias_enn1_gpio {
				phandle = <0x04>;

				pins_cmd_dat {
					pinmux = <0x9e00>;
					slew-rate = <0x01>;
					output-high;
				};
			};

			lcm_rst_out1_gpio {
				phandle = <0x05>;

				pins_cmd_dat {
					pinmux = <0x5500>;
					slew-rate = <0x01>;
					output-high;
				};
