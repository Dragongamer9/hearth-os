[Desktop Entry]
Name=Passwords & Keys
GenericName=Passwords and Keys
Comment=See and remove passwords saved in your keyring and your saved Wi-Fi passwords
Exec=/usr/bin/hearth-tools --app passwords
TryExec=/usr/bin/hearth-tools
Icon=hearth-passwords
Type=Application
Categories=System;Utility;
Keywords=password;passwords;keys;keyring;secrets;wallet;kwallet;gnome-keyring;wifi;credentials;seahorse;
StartupWMClass=io.github.dragongamer9.hearth.passwords
