# Hearth's KWin defaults for Mantel (1.14, docs/DESKTOPS.md "Mantel on KWin"). A system default: nimbus-session puts
# this folder first in XDG_CONFIG_DIRS, under your own ~/.config/kwinrc, so anything you (or KWin's own settings)
# change there wins and this file is never written to.

[Windows]
FocusPolicy=ClickToFocus
# Mantel's bar has its own Show desktop and window list; no hot corners.
ElectricBorderMaximize=true
ElectricBorderTiling=true

[ElectricBorders]
Top=None
TopRight=None
Right=None
BottomRight=None
Bottom=None
BottomLeft=None
Left=None
TopLeft=None

[TouchEdges]
Top=None
Right=None
Bottom=None
Left=None

# The Super key alone opens Mantel's launcher (Mantel's own shortcuts), not KDE's (there's no Plasma here).
[ModifierOnlyShortcuts]
Meta=

# Breeze window borders with Hearth's colours (theme/apply.sh writes kdeglobals), buttons on the right.
[org.kde.kdecoration2]
library=org.kde.breeze
theme=Breeze
ButtonsOnLeft=
ButtonsOnRight=IAX
BorderSize=Normal

# Mantel has its own on-screen keyboard (hearth-pad, docs/OSK.md).
[Wayland]
InputMethod=
VirtualKeyboardEnabled=false

[NightColor]
Active=false

[Xwayland]
XwaylandEavesdrops=None
