# Hearth Desktop Mode on KWin: Super pressed and let go on its own opens Mantel's app menu (like labwc's Super_L),
# through hearth-kwin-bridge (org.hearth.Windows). Read through XDG_CONFIG_DIRS: your own kwinrc wins.
[ModifierOnlyShortcuts]
Meta=org.hearth.Windows,/org/hearth/Windows,org.hearth.Windows,Launcher

# Four virtual desktops named like labwc's (rc.xml <desktops>), for the taskbar's desktop buttons and "Move to desktop".
[Desktops]
Number=4
Rows=1
Name_1=Desktop 1
Name_2=Desktop 2
Name_3=Desktop 3
Name_4=Desktop 4

# Window frames: Hearth's own Aurorae theme (theme/hearth_aurorae.py; hearth-theme writes it for your look and accent
# to ~/.local/share/aurorae/themes/hearth). The window menu (the app's icon) on the left, minimize, maximize and close
# on the right, as on labwc. A decoration you pick in your own kwinrc wins.
[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__hearth
ButtonsOnLeft=M
ButtonsOnRight=IAX
ShowToolTips=true

# A double-click on the title bar maximizes (and restores), as on labwc.
[Windows]
TitlebarDoubleClickCommand=Maximize

# Alt+Tab (and the controller's LB / RB): Hearth's own switcher, live pictures of the windows in Mantel's look
# (os/system_files/usr/share/kwin/tabbox/org.hearth.switcher, in the image). One you pick in Settings › Window
# effects (your ~/.config/kwinrc) wins.
[TabBox]
LayoutName=org.hearth.switcher
