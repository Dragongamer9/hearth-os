#!/bin/sh
# Run by labwc when Desktop Mode starts.
SHARE="${NIMBUS_SHARE:-/usr/local/share/nimbus}"

# Let portals (screen sharing, file pickers) and D-Bus-started apps see this session.
# DISPLAY too (Xwayland's; Game Mode's gamescope display is gone by now), and the portals' failures from Game Mode
# are forgotten, or systemd wouldn't start them again for a while ("start-limit-hit").
{ dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE NIMBUS_SHARE NIMBUS_APP
  systemctl --user reset-failed xdg-desktop-portal.service xdg-desktop-portal-gtk.service; } >/dev/null 2>&1 &

# Resolution, refresh rate and scale chosen in Settings › Display. Until you choose, small sharp screens
# (handhelds, high-DPI laptops) get a comfortable scale so text and buttons are big enough to touch.
if [ -x "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/display.sh" ]; then
  "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/display.sh"
elif command -v wlr-randr >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  wlr-randr --json 2>/dev/null | python3 -c '
import json, subprocess, sys
for o in json.load(sys.stdin):
    mode = next((m for m in o.get("modes", []) if m.get("current")), None)
    mm = (o.get("physical_size") or {}).get("width") or 0
    if not o.get("enabled") or not mode or mm <= 0:
        continue
    dpi = mode["width"] / (mm / 25.4)      # size and mode both follow the panel, not the rotation
    scale = 1.5 if dpi > 250 else 1.25 if dpi > 175 else 1.0
    if scale != 1.0:
        subprocess.run(["wlr-randr", "--output", o["name"], "--scale", str(scale)])
' 2>/dev/null
fi

# The Hearth look for apps (colors for Qt/KDE and GTK apps).
[ -x "$SHARE/desktop/theme/apply.sh" ] && "$SHARE/desktop/theme/apply.sh"

# The Hearth taskbar, launcher, Quick Access, notifications and wallpaper (Quickshell).
# Without it Desktop Mode is an empty black screen you can't leave on a handheld, so it's watched: if it
# can't start (or keeps crashing), go back to Game Mode, which shows why.
RUN="${XDG_RUNTIME_DIR:-/tmp}"
SHELL_LOG="$RUN/nimbus-shell.log"
give_up() {
  { echo "$1"; echo; tail -n 12 "$SHELL_LOG" 2>/dev/null; } >"$RUN/nimbus-desktop-failed"
  nimbus-mode game
}
if [ ! -f "$SHARE/desktop/shell/shell.qml" ]; then
  give_up "The Desktop Mode files are missing ($SHARE/desktop/shell)."
elif ! command -v quickshell >/dev/null 2>&1; then
  give_up "Desktop Mode needs Quickshell, which isn't installed."
else
  (
    : >"$SHELL_LOG"
    fails=0
    while :; do
      # Desktop Mode ended (labwc gone): stop watching, or the "keeps closing" fallback would fire in Game Mode.
      if [ -n "$LABWC_PID" ] && ! kill -0 "$LABWC_PID" 2>/dev/null; then exit 0; fi
      started=$(date +%s)
      quickshell -p "$SHARE/desktop/shell" >>"$SHELL_LOG" 2>&1
      if [ $(($(date +%s) - started)) -lt 20 ]; then fails=$((fails + 1)); else fails=0; fi
      if [ "$fails" -ge 3 ]; then give_up "Desktop Mode's taskbar and menus (Quickshell) keep closing right after they start."; exit 0; fi
      echo "--- restarting the shell" >>"$SHELL_LOG"
      sleep 1
    done
  ) &
fi

# Password prompts for apps that need admin rights: the first polkit agent found.
for agent in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
             /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
             /usr/libexec/polkit-gnome-authentication-agent-1 \
             /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1 \
             /usr/libexec/polkit-kde-authentication-agent-1 \
             /usr/lib/polkit-kde-authentication-agent-1 \
             lxqt-policykit-agent; do
  if command -v "$agent" >/dev/null 2>&1; then "$agent" >/dev/null 2>&1 & break; fi
done

# Your own additions: ~/.config/nimbus/autostart (any executable script).
[ -x "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/autostart" ] && "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/autostart" &

# Hearth asked for an app to open here (Game Mode's "Sign in from Desktop Mode"): only Hearth's own launchers.
OPEN_AFTER="$RUN/hearth-open-after"
if [ -f "$OPEN_AFTER" ]; then
  app=$(head -n1 "$OPEN_AFTER"); rm -f "$OPEN_AFTER"
  case "$app" in "${XDG_DATA_HOME:-$HOME/.local/share}/nimbus/"*) [ -x "$app" ] && (sleep 4; "$app" >/dev/null 2>&1) & ;; esac
fi

# A store sign-in asked for in Game Mode (Library › Stores): Hearth opens here in a window and starts it.
[ -f "$SHARE/desktop/shell/hearth-signin" ] && command -v python3 >/dev/null 2>&1 && python3 "$SHARE/desktop/shell/hearth-signin" desktop-start >/dev/null 2>&1 &
