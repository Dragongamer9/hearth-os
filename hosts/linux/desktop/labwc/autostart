#!/bin/sh
# Run when Desktop Mode starts: by labwc, or (1.14) by KWin through desktop/kwin/autostart, or (2.0 preview) by
# Firehold, Hearth's own compositor, through desktop/firehold/autostart. HEARTH_WM says which
# (nimbus-session sets it); HEARTH_DESKTOP_PID is the window manager's process id either way (labwc's LABWC_PID; under
# KWin our parent, KWin itself), for everything started from here that asks "is Desktop Mode up?" (nimbus-mode).
SHARE="${NIMBUS_SHARE:-/usr/local/share/nimbus}"
RUN="${XDG_RUNTIME_DIR:-/tmp}"
if [ "${HEARTH_WM:-}" = kwin ] || [ "${HEARTH_WM:-}" = firehold ]; then
  # KWin, or (2.0 preview) Hearth's own compositor (desktop/firehold/autostart): our parent is it.
  [ -n "${HEARTH_DESKTOP_PID:-}" ] || HEARTH_DESKTOP_PID=$PPID
  unset LABWC_PID
else
  HEARTH_WM=labwc
  [ -n "${LABWC_PID:-}" ] && HEARTH_DESKTOP_PID=$LABWC_PID
fi
export HEARTH_WM HEARTH_DESKTOP_PID

# Let portals (screen sharing, file pickers) and D-Bus-started apps see this session.
# DISPLAY too (Xwayland's; Game Mode's gamescope display is gone by now), and the portals' failures from Game Mode
# are forgotten, or systemd wouldn't start them again for a while ("start-limit-hit").
# XDG_DATA_DIRS too (with Flatpak's folders, from nimbus-session), so apps D-Bus starts find Flatpak apps and icons.
# XDG_CONFIG_DIRS and HEARTH_WM too (1.14): under KWin (XDG_CURRENT_DESKTOP Hearth:Nimbus:KDE) the portals read
# hearth-portals.conf, under labwc (Nimbus:wlroots) nimbus-portals.conf (wlroots'); when the window manager changed since
# the portal started, it starts again (once, at the start of Desktop Mode).
{ dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_DATA_DIRS XDG_CONFIG_DIRS NIMBUS_SHARE NIMBUS_APP HEARTH_WM
  systemctl --user reset-failed xdg-desktop-portal.service xdg-desktop-portal-gtk.service xdg-desktop-portal-kde.service
  if [ "$(cat "$RUN/hearth-portal-wm" 2>/dev/null)" != "$HEARTH_WM" ]; then
    echo "$HEARTH_WM" >"$RUN/hearth-portal-wm"
    systemctl --user try-restart xdg-desktop-portal.service
  fi; } >/dev/null 2>&1 &

# (1.14: under KWin Mantel starts its bridge to KWin itself, desktop/shell/hearth-kwin-bridge.)
# Under KWin: accessibility (the screen reader, colour filters) and the pointer and keyboard settings applied the KWin
# way, and kept applied as devices come and go (feature/kwin-pages), in the background.
if [ "$HEARTH_WM" = kwin ] && command -v python3 >/dev/null 2>&1; then
  [ -f "$SHARE/desktop/shell/hearth-access" ] && python3 "$SHARE/desktop/shell/hearth-access" apply kwin >/dev/null 2>&1 &
  if [ -f "$SHARE/desktop/shell/hearth-kwin-settings" ]; then
    ( python3 "$SHARE/desktop/shell/hearth-kwin-settings" pointer-apply >/dev/null 2>&1
      exec python3 "$SHARE/desktop/shell/hearth-kwin-settings" input-watch >/dev/null 2>&1 ) &
  fi
fi

# Resolution, refresh rate and scale chosen in Settings › Display. Until you choose, small sharp screens
# (handhelds, high-DPI laptops) get a comfortable scale so text and buttons are big enough to touch.
# Under KWin (1.14) the screens are hearth-screens' (the hook below: "restore", when it's there); wlr-randr is labwc's.
if [ "$HEARTH_WM" = kwin ]; then
  screens="$SHARE/desktop/shell/hearth-screens"
  if [ -x "$screens" ]; then timeout 20 "$screens" restore >/dev/null 2>&1
  elif [ -f "$screens" ]; then timeout 20 python3 "$screens" restore >/dev/null 2>&1; fi
elif [ -x "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/display.sh" ]; then
  "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/display.sh"
  # A screen turned off there, and the one left on is unplugged now: never no screen at all.
  if command -v wlr-randr >/dev/null 2>&1 && ! wlr-randr 2>/dev/null | grep -q "Enabled: yes"; then
    for o in $(wlr-randr 2>/dev/null | grep -o '^[^ ]*'); do wlr-randr --output "$o" --on; done
  fi
elif command -v wlr-randr >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
  wlr-randr --json 2>/dev/null | python3 -c '
import json, subprocess, sys
for o in json.load(sys.stdin):
    mode = next((m for m in o.get("modes", []) if m.get("current")), None)
    mm = (o.get("physical_size") or {}).get("width") or 0
    if not o.get("enabled") or not mode or mm <= 0:
        continue
    dpi = mode["width"] / (mm / 25.4)      # size and mode both follow the panel, not the rotation
    scale = 1.5 if dpi > 250 else 1.25 if dpi > 175 else 1.0
    if scale != 1.0:
        subprocess.run(["wlr-randr", "--output", o["name"], "--scale", str(scale)])
' 2>/dev/null
fi

# The Hearth look for apps (colors for Qt/KDE and GTK apps).
[ -x "$SHARE/desktop/theme/apply.sh" ] && "$SHARE/desktop/theme/apply.sh"

# ---- Accessibility (Settings › Accessibility): inverted colours, the screen reader and the apps' text size, as set
# (the magnifier and the rest are in the labwc folder hearth-system made).
[ -f "$SHARE/desktop/shell/hearth-access" ] && python3 "$SHARE/desktop/shell/hearth-access" apply desktop >/dev/null 2>&1 &
# ---- end Accessibility

# The Hearth taskbar, launcher, Quick Access, notifications and wallpaper (Quickshell).
# Without it Desktop Mode is an empty black screen you can't leave on a handheld, so it's watched: if it
# can't start (or keeps crashing), go to Game Mode (Steam Game Mode) instead.
SHELL_LOG="$RUN/nimbus-shell.log"
give_up() {
  { echo "$1"; echo; tail -n 12 "$SHELL_LOG" 2>/dev/null; } >"$RUN/nimbus-desktop-failed"
  # Under KWin (1.14): not Game Mode, but the safe start: KWin ends with the reason left for nimbus-session, which
  # opens Mantel on labwc instead (run_kwin; no next mode is written, so it isn't taken for a switch you asked for).
  if [ "$HEARTH_WM" = kwin ] && [ -n "$HEARTH_DESKTOP_PID" ]; then
    echo "Mantel didn't keep running under KWin: $1" >"$RUN/hearth-kwin-shell-failed"
    kill -TERM "$HEARTH_DESKTOP_PID" 2>/dev/null
    return 0
  fi
  # >>> labwc on the Fedora edition (1.16): not Game Mode but KDE Plasma (nimbus-session run_fedora_labwc reads why).
  if [ "${HEARTH_FEDORA_LABWC:-}" = 1 ] && [ -n "$HEARTH_DESKTOP_PID" ]; then
    echo "$1" >"$RUN/hearth-labwc-shell-failed"
    kill -TERM "$HEARTH_DESKTOP_PID" 2>/dev/null
    return 0
  fi
  # <<< labwc on the Fedora edition
  # Game Mode couldn't start a moment ago (the session fell back to here): asking for it again would only come
  # straight back to Desktop Mode and fail again, restarting it about once a minute. Stay, and say why (the
  # desktop's right-click menu still switches modes and logs out).
  # The same when Steam Game Mode just failed and the session opened Desktop Mode instead (hearth-steam-mode-failed):
  # never back and forth between the two.
  if [ -n "$(find "$RUN/nimbus-game-unavailable" "$RUN/hearth-steam-mode-failed" -mmin -10 2>/dev/null)" ]; then
    msg="$1 Game Mode can't start either ($(head -c 200 "$RUN/hearth-steam-mode-failed" 2>/dev/null || echo "gamescope or Steam is missing")), so you're staying in Desktop Mode. Right-click the desktop for a menu."
    ( notify-send -u critical "Hearth" "$msg" 2>/dev/null || zenity --error --title=Hearth --text="$msg" 2>/dev/null \
      || kdialog --title Hearth --error "$msg" 2>/dev/null ) >/dev/null 2>&1 &
    return 0
  fi
  # (Game Mode on this PC off: still allowed, Game Mode stays available for recovery.)
  HEARTH_GM_RECOVERY=1 nimbus-mode game
}
if [ ! -f "$SHARE/desktop/shell/shell.qml" ]; then
  give_up "The Desktop Mode files are missing ($SHARE/desktop/shell)."
elif ! command -v quickshell >/dev/null 2>&1; then
  give_up "Desktop Mode needs Quickshell, which isn't installed."
else
  (
    : >"$SHELL_LOG"
    fails=0
    while :; do
      # Desktop Mode ended (labwc or KWin gone): stop watching, or the "keeps closing" fallback would fire in Game Mode.
      if [ -n "$HEARTH_DESKTOP_PID" ] && ! kill -0 "$HEARTH_DESKTOP_PID" 2>/dev/null; then exit 0; fi
      started=$(date +%s)
      # A newer Mantel from the Hearth Store (hearth-part, docs/HEARTH-STORE.md "Quick updates") when there's one that
      # may be used; else, and whenever anything about it is off, the one built into Hearth OS.
      shell_dir="$SHARE/desktop/shell"
      if [ -x /usr/libexec/hearth/hearth-part ]; then
        pick=$(/usr/libexec/hearth/hearth-part path mantel "$shell_dir" 2>/dev/null) || pick="$shell_dir"
        [ -n "$pick" ] && [ -f "$pick/shell.qml" ] || pick="$shell_dir"
      else
        pick="$shell_dir"
      fi
      quickshell -p "$pick" >>"$SHELL_LOG" 2>&1
      if [ $(($(date +%s) - started)) -lt 20 ]; then
        # The Store's copy closing right away: the built-in one next time (hearth-part says so), not counted here.
        if [ "$pick" != "$shell_dir" ]; then /usr/libexec/hearth/hearth-part failed mantel 2>/dev/null; echo "--- the Store's Mantel closed right away; the built-in one" >>"$SHELL_LOG"; else fails=$((fails + 1)); fi
      else
        fails=0
        if [ "$pick" != "$shell_dir" ]; then /usr/libexec/hearth/hearth-part ok mantel 2>/dev/null; fi
      fi
      if [ "$fails" -ge 3 ]; then give_up "Desktop Mode's taskbar and menus (Quickshell) keep closing right after they start."; exit 0; fi
      echo "--- restarting the shell" >>"$SHELL_LOG"
      sleep 1
    done
  ) &
fi

# Password prompts for apps that need admin rights (RED FLAG: they must always work). 1.14: Mantel draws Hearth's own
# (PolkitPrompt.qml); hearth-polkit-fallback starts the classic agent (the first one found of the list below, which it
# keeps the same) when Mantel's isn't registered within a few seconds, and again at once whenever the shell stops.
# It watches the window manager: HEARTH_DESKTOP_PID (KWin or labwc, 1.14), else labwc's own LABWC_PID.
# Without the fallback script (an older shell folder), the classic agent starts right away as before.
if [ -f "$SHARE/desktop/shell/hearth-polkit-fallback" ]; then
  sh "$SHARE/desktop/shell/hearth-polkit-fallback" "${HEARTH_DESKTOP_PID:-$LABWC_PID}" >/dev/null 2>&1 &
else
# (not indented: base-peppermint.yml's image check reads this list from a line starting with "for agent in")
for agent in /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
             /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 \
             /usr/libexec/polkit-gnome-authentication-agent-1 \
             /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1 \
             /usr/libexec/polkit-kde-authentication-agent-1 \
             /usr/lib/polkit-kde-authentication-agent-1 \
             /usr/libexec/polkit-mate-authentication-agent-1 \
             /usr/lib/x86_64-linux-gnu/mate-polkit/polkit-mate-authentication-agent-1 \
             lxpolkit \
             lxqt-policykit-agent; do
  if command -v "$agent" >/dev/null 2>&1; then "$agent" >/dev/null 2>&1 & break; fi
done
fi

# Settings › Remote desktop (hearth-vnc): its server again, only while its switch is on (it does nothing when off and never
# fails); a few seconds after the taskbar, without waiting. Not for a second player's seat.
if [ -z "$HEARTH_SEAT" ] && [ -f "$SHARE/desktop/shell/hearth-vnc" ] && command -v python3 >/dev/null 2>&1; then
  (sleep 6; python3 "$SHARE/desktop/shell/hearth-vnc" session >/dev/null 2>&1) &
fi

# Your own additions: ~/.config/nimbus/autostart (any executable script).
[ -x "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/autostart" ] && "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/autostart" &

# The apps that start when you sign in (~/.config/autostart and /etc/xdg/autostart, the ones that are on in Task
# Manager › Startup), like on any desktop: Discord, sync clients, password managers... A few seconds after the
# taskbar, so their tray icons find it. Steam isn't started here (Hearth starts it when it's needed), nor parts of
# other desktops. Not for a second player's seat (their apps are the first player's).
if [ -z "$HEARTH_SEAT" ] && [ -f "$SHARE/desktop/shell/hearth-tasks" ] && command -v python3 >/dev/null 2>&1; then
  (sleep 4; python3 "$SHARE/desktop/shell/hearth-tasks" autostart-run >/dev/null 2>&1) &
fi

# Hearth asked for an app to open here (Game Mode's "Sign in from Desktop Mode"): only Hearth's own launchers.
OPEN_AFTER="$RUN/hearth-open-after"
if [ -f "$OPEN_AFTER" ]; then
  app=$(head -n1 "$OPEN_AFTER"); rm -f "$OPEN_AFTER"
  case "$app" in "${XDG_DATA_HOME:-$HOME/.local/share}/nimbus/"*) [ -x "$app" ] && (sleep 4; "$app" >/dev/null 2>&1) & ;; esac
fi

# A store sign-in asked for in Game Mode (Library › Stores): Hearth opens here in a window and starts it.
[ -f "$SHARE/desktop/shell/hearth-signin" ] && command -v python3 >/dev/null 2>&1 && python3 "$SHARE/desktop/shell/hearth-signin" desktop-start >/dev/null 2>&1 &

# Briefcase auto-sync (hearth-briefcase-sync.service): asked for without waiting; it skips itself when no Briefcase has
# auto-sync on, and nothing here waits for it or fails with it. Not for a second player's seat.
[ -z "$HEARTH_SEAT" ] && command -v systemctl >/dev/null 2>&1 && systemctl --user start --no-block hearth-briefcase-sync.service >/dev/null 2>&1 &

# The file index (hearth-search.service, like Baloo): asked for without waiting, lowest priority; it skips itself when
# Settings › Search has indexing off, and nothing here waits for it or fails with it. Not for a second player's seat.
[ -z "$HEARTH_SEAT" ] && command -v systemctl >/dev/null 2>&1 && systemctl --user start --no-block hearth-search.service >/dev/null 2>&1 &

# ---- Welcome & Tips (hosts/hearth-tools): the first-run tour, the first time Desktop Mode starts on this account.
# hearth-tools remembers it was shown (~/.local/share/nimbus/welcome-done) and does nothing after that. Not on a live
# USB (the installer has its own welcome) or a second player's seat.
if [ -z "$HEARTH_SEAT" ] && [ ! -e /etc/hearth-live ] && command -v hearth-tools >/dev/null 2>&1 \
   && [ ! -e "${XDG_DATA_HOME:-$HOME/.local/share}/nimbus/welcome-done" ]; then
  (sleep 6; hearth-tools --app welcome --first-run >/dev/null 2>&1) &
fi
# ---- end Welcome & Tips
