<?xml version="1.0"?>
<!--
  Hearth Desktop Mode: labwc settings. labwc's own defaults fill in everything not set here
  (see `man labwc-config`). Your own ~/.config/labwc/rc.xml is not read in Desktop Mode;
  change this file in /usr/local/share/nimbus/desktop/labwc instead.
-->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>6</gap>
  </core>

  <theme>
    <cornerRadius>10</cornerRadius>
    <dropShadows>yes</dropShadows>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
    </titlebar>
    <font place="ActiveWindow"><name>sans</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>sans</name><size>10</size></font>
    <font place="MenuItem"><name>sans</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>sans</name><size>11</size></font>
  </theme>

  <placement><policy>cascade</policy></placement>

  <!-- Drag a window to a screen edge for half the screen, into a corner for a quarter, to the top to maximize.
       Hold Super (or Ctrl/Alt/Shift) while dragging to drop it into one of the regions below instead. -->
  <snapping>
    <range inner="12" outer="12" />
    <cornerRange>60</cornerRange>
    <overlay enabled="yes"><delay inner="300" outer="300" /></overlay>
    <topMaximize>yes</topMaximize>
  </snapping>
  <regions>
    <region name="top-left" x="0%" y="0%" width="50%" height="50%" />
    <region name="top-right" x="50%" y="0%" width="50%" height="50%" />
    <region name="bottom-left" x="0%" y="50%" width="50%" height="50%" />
    <region name="bottom-right" x="50%" y="50%" width="50%" height="50%" />
    <region name="left-third" x="0%" y="0%" width="33%" height="100%" />
    <region name="middle-third" x="33%" y="0%" width="34%" height="100%" />
    <region name="right-third" x="67%" y="0%" width="33%" height="100%" />
    <region name="center" x="12%" y="8%" width="76%" height="84%" />
  </regions>

  <!-- Virtual desktops: the numbered buttons on the taskbar, Super+Ctrl+Left/Right, Super+Ctrl+1-4. -->
  <desktops number="4">
    <popupTime>700</popupTime>
    <prefix>Desktop</prefix>
    <names><name>Desktop 1</name><name>Desktop 2</name><name>Desktop 3</name><name>Desktop 4</name></names>
  </desktops>

  <!-- Alt+Tab (LB/RB on the controller): window previews with their icons and names, Hearth colors (themerc).
       Older labwc versions ignore the thumbnail style and show the list with icons. -->
  <windowSwitcher show="yes" style="thumbnail" preview="yes" outlines="yes" allWorkspaces="no">
    <osd show="yes" style="thumbnail" output="all" thumbnailLabelFormat="%T" />
    <fields>
      <field content="icon" width="8%" />
      <field content="desktop_entry_name" width="27%" />
      <field content="title" width="65%" />
    </fields>
  </windowSwitcher>

  <menu><ignoreButtonReleasePeriod>250</ignoreButtonReleasePeriod><showIcons>yes</showIcons></menu>

  <keyboard>
    <default />
    <!-- Super opens the Nimbus launcher, like the Start/Steam button. -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="sh -c 'quickshell ipc -p $NIMBUS_SHARE/desktop/shell call launcher toggle'" /></keybind>
    <keybind key="W-space"><action name="Execute" command="sh -c 'quickshell ipc -p $NIMBUS_SHARE/desktop/shell call launcher toggle'" /></keybind>
    <!-- Clipboard history (Settings › Clipboard) -->
    <keybind key="W-v"><action name="Execute" command="sh -c 'quickshell ipc -p $NIMBUS_SHARE/desktop/shell call clipboard toggle'" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="sh -c 'sh $NIMBUS_SHARE/desktop/open.sh terminal'" /></keybind>
    <keybind key="W-e"><action name="Execute" command="sh -c 'sh $NIMBUS_SHARE/desktop/open.sh files'" /></keybind>
    <keybind key="C-S-Escape"><action name="Execute" command="sh -c 'quickshell ipc -p $NIMBUS_SHARE/desktop/shell call tasks toggle'" /></keybind>
    <keybind key="W-g"><action name="Execute" command="nimbus-mode game" /></keybind>
    <keybind key="W-l"><action name="Execute" command="sh -c 'quickshell ipc -p &quot;$NIMBUS_SHARE/desktop/shell&quot; call lock lock'" /></keybind>
    <keybind key="W-q"><action name="Close" /></keybind>
    <!-- Snapping from the keyboard (View + D-pad on the controller): Left/Right for halves; Up/Down on a half
         makes it a quarter, on a quarter back to the half; Up maximizes, Down restores, then minimizes. -->
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="W-Up">
      <action name="If"><query tiled="left" />
        <then><action name="SnapToRegion" region="top-left" /></then>
        <else><action name="If"><query tiled="right" />
          <then><action name="SnapToRegion" region="top-right" /></then>
          <else><action name="If"><query tiled_region="bottom-left" />
            <then><action name="SnapToEdge" direction="left" /></then>
            <else><action name="If"><query tiled_region="bottom-right" />
              <then><action name="SnapToEdge" direction="right" /></then>
              <else><action name="Maximize" /></else>
            </action></else>
          </action></else>
        </action></else>
      </action>
    </keybind>
    <keybind key="W-Down">
      <action name="If"><query tiled="left" />
        <then><action name="SnapToRegion" region="bottom-left" /></then>
        <else><action name="If"><query tiled="right" />
          <then><action name="SnapToRegion" region="bottom-right" /></then>
          <else><action name="If"><query tiled_region="top-left" />
            <then><action name="SnapToEdge" direction="left" /></then>
            <else><action name="If"><query tiled_region="top-right" />
              <then><action name="SnapToEdge" direction="right" /></then>
              <else><action name="If"><query maximized="both" />
                <then><action name="UnMaximize" /></then>
                <else><action name="Iconify" /></else>
              </action></else>
            </action></else>
          </action></else>
        </action></else>
      </action>
    </keybind>
    <keybind key="W-d"><action name="ToggleShowDesktop" /></keybind>
    <!-- Virtual desktops: switch, take the window along, or send it without following.
         Super+Alt+number is what the taskbar's "Move to desktop" types (with wtype). -->
    <keybind key="W-C-Left"><action name="GoToDesktop" to="left" wrap="no" /></keybind>
    <keybind key="W-C-Right"><action name="GoToDesktop" to="right" wrap="no" /></keybind>
    <keybind key="W-C-S-Left"><action name="SendToDesktop" to="left" wrap="no" /></keybind>
    <keybind key="W-C-S-Right"><action name="SendToDesktop" to="right" wrap="no" /></keybind>
    <keybind key="W-C-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-C-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-C-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-C-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <keybind key="W-A-1"><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="W-A-2"><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="W-A-3"><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="W-A-4"><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <keybind key="Print"><action name="Execute" command="sh -c 'sh $NIMBUS_SHARE/desktop/open.sh screenshot'" /></keybind>
    <!-- Volume and power keys go to the shell (volume bar, over-amplification, Settings › Power button);
         wpctl directly if the shell isn't running. -->
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="sh -c 'quickshell ipc -p $NIMBUS_SHARE/desktop/shell call buttons up || wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+'" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="sh -c 'quickshell ipc -p $NIMBUS_SHARE/desktop/shell call buttons down || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-'" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="sh -c 'quickshell ipc -p $NIMBUS_SHARE/desktop/shell call buttons mute || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle'" /></keybind>
    <keybind key="XF86PowerOff"><action name="Execute" command="sh -c 'quickshell ipc -p $NIMBUS_SHARE/desktop/shell call buttons power'" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set 5%+" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-" /></keybind>
  </keyboard>

  <mouse><default /></mouse>

  <windowRules>
    <!-- Hearth Settings and the Hearth app open as normal windows with title bars (fullscreen ones have none anyway). -->
  </windowRules>
</labwc_config>
