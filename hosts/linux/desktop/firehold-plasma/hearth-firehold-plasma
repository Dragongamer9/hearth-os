    js = ('var v="%s";desktops().forEach(function(d){if(d.type=="%s"){d.currentConfigGroup=["General"];d.writeConfig("request",v);}});'
          'panels().forEach(function(p){p.widgets().forEach(function(w){if(w.type=="org.hearthos.firehold.posture"||w.type=="org.hearthos.firehold.app"){'
          'w.currentConfigGroup=["General"];w.writeConfig("modes",v);}});});' % (v, CONTAINMENT))
