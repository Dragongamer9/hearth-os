def dnd_watch():
    """Do not disturb pressed in Hearth's shared Quick Settings or notifications (hearth-quick writes the same live
    file, $XDG_RUNTIME_DIR/hearth-firehold-plasma/dnd): watched with inotify, no timer, so Firehold's KWin script
    hears it at once. None when inotify isn't there (the press from Firehold's own buttons still tells it)."""
    try:
        import ctypes
        libc = ctypes.CDLL(None, use_errno=True)
        fd = libc.inotify_init1(os.O_NONBLOCK | os.O_CLOEXEC)
        if fd < 0:
            return None
        d = run_dir()
        os.makedirs(d, exist_ok=True)
        if libc.inotify_add_watch(fd, d.encode(), 0x00000008 | 0x00000080) < 0:   # IN_CLOSE_WRITE | IN_MOVED_TO
            os.close(fd)
            return None
        return fd
    except (OSError, AttributeError):
        return None


