def own_menus(pid):
    """Whether an app has menus of its own for KDE's global menu: a Qt Widgets app (KDE's, most Qt apps) or a GTK app
    with the app menu module exports them; games, Windows apps (Wine), Electron and Qt Quick apps don't."""
    # What KDE's global menu reads: the app's D-Bus connection with a /MenuBar object (com.canonical.dbusmenu).
    names = re.findall(r'string "(:[0-9.]+)"', dbus_send('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus.ListNames', timeout=3))
    seen_dbus = bool(names)
    for n in names:
        got = re.search(r'uint32 (\d+)', dbus_send('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus.GetConnectionUnixProcessID', 'string:' + n, timeout=2))
        if got and int(got.group(1)) == pid:
            if 'node name="MenuBar"' in dbus_send(n, '/', 'org.freedesktop.DBus.Introspectable.Introspect', timeout=2):
                return True
    if seen_dbus:
        return False
    try:
        maps = open('/proc/%d/maps' % pid, encoding='utf-8', errors='replace').read()
    except OSError:
        return True      # can't tell: the app's own (KDE's global menu shows whatever it has)
    if re.search(r'libQt[56]Widgets\.so', maps):
        return True
    return 'appmenu-gtk-module' in maps or 'libappmenu-gtk' in maps


def window_action(what, arg=''):
    """The Desk bar's Window menu (mockup firehold-plasma 12), on the window in front, through KWin's script API."""
    if what in WINDOW_JS:
        kwin_run('var w = workspace.activeWindow; if (w) { %s }' % WINDOW_JS[what], 'org.hearthos.firehold.window')
    elif what == 'move' and re.match(r'^[A-Za-z0-9_.-]{1,40}$', arg):
        # Move to screen: KWin sends it there; on a Couch screen the KWin script makes a game full screen.
        kwin_run('var w = workspace.activeWindow; var o = workspace.screens.filter(function (s) { return s.name == "%s"; })[0];'
                 ' if (w && o) workspace.sendClientToScreen(w, o);' % arg, 'org.hearthos.firehold.window')
    elif what == 'kill' and arg.isdigit():
        try:
            os.kill(int(arg), signal.SIGKILL)
        except OSError:
            pass
    elif what == 'screenshot':
        detach(['spectacle', '-b', '-n', '-a'])
    elif what == 'record':
        detach(['spectacle', '-b', '-n', '--record', 'window'])
    elif what == 'folder' and arg.isdigit():
        try:
            exe = os.path.realpath('/proc/%s/exe' % arg)
            # A Windows app's folder is its .exe's (Wine's command line), else the program's own.
            cmd = open('/proc/%s/cmdline' % arg, 'rb').read().split(b'\0')
            win = [c.decode(errors='replace') for c in cmd if c.lower().endswith(b'.exe')]
            folder = os.path.dirname(win[0].replace('\\', '/')) if win and win[0].startswith('/') else os.path.dirname(exe)
            detach(['xdg-open', folder])
        except OSError:
            return {'ok': False}
    elif what == 'logs':
        detach(['hearth-send-logs', ('Sent from the Desk bar: ' + arg)[:200]])
    elif what == 'search':
        detach(['krunner'])
    elif what == 'shortcuts':
        detach(['systemsettings', 'kcm_keys'])
    else:
        raise ValueError('unknown window action')
    return {'ok': True}


