            'battery': batt, 'wifi': wifi_state(), 'bt': bt_state(), 'osk': osk_on(), 'night': night_light(),
            'dnd': dnd_state(s), 'sinks': sinks(), 'brightness': brightness_list(), 'power': prof,
            'powerNames': POWER_STEPS.get(key, {'power-saver': 'Power saver', 'balanced': 'Balanced', 'performance': 'Performance'}),
            'devices': device_batteries(), 'gameModeOff': desk.get('gameModeOff') is True, 'modes': screen_modes()}


def dnd_state(s=None):
    """Do not disturb: Firehold's schedule (firehold.json "dnd": {"from": "23:00", "to": "07:00", "games": true}) and
    whether it's on now (on by hand, in the schedule's hours, or a game full screen)."""
    s = settings() if s is None else s
    d = s.get('dnd') if isinstance(s.get('dnd'), dict) else {}
    frm, to = d.get('from', '23:00'), d.get('to', '07:00')
    now = time.strftime('%H:%M')
    in_hours = (frm <= now < to) if frm < to else (now >= frm or now < to)
    by_hand = read_small(os.path.join(run_dir(), 'dnd')) == 'on'
    sched = d.get('schedule', True) is not False
    def ampm(hm):
        try:
            h, m = map(int, hm.split(':'))
        except ValueError:
            return hm
        return '%d%s %s' % (h % 12 or 12, (':%02d' % m) if m else '', 'AM' if h < 12 else 'PM')
    return {'on': by_hand or (sched and in_hours), 'byHand': by_hand, 'schedule': sched, 'from': ampm(frm), 'to': ampm(to),
            'games': d.get('games', True) is not False, 'family': d.get('family', True) is not False}


def qs_do(what, arg=''):
    """A Quick Settings press."""
    if what == 'wifi':
        quiet(['nmcli', 'radio', 'wifi', 'off' if wifi_state()['on'] else 'on'], 6)
    elif what == 'bt':
        quiet(['bluetoothctl', 'power', 'off' if bt_state()['on'] else 'on'], 6)
    elif what == 'dnd':
        # Do not disturb by hand (live state until you turn it off or restart; the schedule is a setting).
        p = os.path.join(run_dir(), 'dnd')
        write_small(p, 'off' if read_small(p) == 'on' else 'on')
        tell_dnd()
        # Firehold's KWin script hears it too (the coordinator: after a Do not disturb press, tell it ourselves).
        dbus_send('org.kde.kglobalaccel', '/component/kwin', 'org.kde.kglobalaccel.Component.invokeShortcut',
                  'string:Firehold dnd ' + read_small(p), reply=False)
    elif what == 'night':
        # KDE's own Night Light switch (kwinrc [NightColor] Active, through KConfig; KWin reads it again). A KWin
        # inhibit wouldn't outlast this short helper, so the tile is the setting itself, changed only by your press.
        import hearth_kconfig as kc
        on = night_light()['on']
        kc.update(kc.user_path('kwinrc'), {'NightColor': {'Active': 'false' if on else 'true'}})
        dbus_send('org.kde.KWin', '/KWin', 'org.kde.KWin.reconfigure', reply=False)
    elif what == 'screenshot':
        return do('screenshot')
    elif what == 'osk':
        return do('osk')
    elif what == 'volume' and re.match(r'^\d{1,3}$', arg):
        quiet(['wpctl', 'set-volume', '@DEFAULT_AUDIO_SINK@', '%d%%' % min(100, int(arg))], 3)
    elif what == 'output' and re.match(r'^[A-Za-z0-9_.:-]{1,160}$', arg):
        quiet(['pactl', 'set-default-sink', arg], 4)
    elif what == 'brightness' and re.match(r'^[A-Za-z0-9_]{0,60}:\d{1,3}$', arg):
        d, v = arg.split(':')
        if d:
            b = [x for x in brightness_list() if x['id'] == d]
            if b:
                dbus_send('org.kde.ScreenBrightness', '/org/kde/ScreenBrightness/' + d, 'org.kde.ScreenBrightness.Display.SetBrightness',
                          'int32:%d' % round(int(v) * b[0]['max'] / 100), 'uint32:0', reply=False)
        else:
            quiet(['brightnessctl', 'set', '%d%%' % int(v)], 3)
    elif what == 'power' and arg in ('power-saver', 'balanced', 'performance'):
        quiet(['powerprofilesctl', 'set', arg], 5)
    elif what == 'lock':
        detach(['loginctl', 'lock-session'])
    elif what in ('sleep', 'restart', 'shutdown'):
        detach(['systemctl', {'sleep': 'suspend', 'restart': 'reboot', 'shutdown': 'poweroff'}[what]])
    elif what == 'logout':
        dbus_send('org.kde.Shutdown', '/Shutdown', 'org.kde.Shutdown.logout', reply=False)
    elif what == 'gamemode':
        return do('gamemode')
    elif what == 'settings':
        detach(['hearth-settings-app'] + (['--page', arg] if re.match(r'^[a-z0-9-]{1,40}$', arg or '') else []))
    else:
        raise ValueError('unknown')
    return {'ok': True}


def tell_dnd():
    """KDE's own Do not disturb follows (the notifications applet's inhibition, through its D-Bus service)."""
    ping_modes('dnd')


def games(argv):
    h = os.path.join(SHELL_DIR, 'hearth-firehold')
    r = subprocess.run([sys.executable, h] + argv, capture_output=True, text=True, timeout=90)
    sys.stdout.write(r.stdout)
    return r.returncode


def main(argv):
    what = argv[1] if len(argv) > 1 else ''
    a = argv[2:]
    try:
        if what == 'choice':
            print(effective_choice())
        elif what == 'choose' and a:
            choose(a[0])
        elif what == 'pick':
            return pick()
        elif what == 'start-shell':
            print(shell_for(start_posture()))
        elif what == 'session':
            return session()
        elif what == 'ready' and a and re.match(r'^[a-z.]+$', a[0]):
            write_small(os.path.join(run_dir(), 'ready-' + a[0]), str(time.time()))
            if a[0] == COUCH:
                couch_quick_widget()
        elif what == 'switch' and a:
            why = a[a.index('--why') + 1] if '--why' in a[:-1] else ''
            tab = next((x for x in a[1:] if x in ('home', 'library', 'apps', 'store', 'switcher', 'settings')), '')
            switch(a[0], tab, why)
        elif what == 'ping' and a and a[0] in ('modes', 'popup', 'popup-off', 'identify', 'identify-off', 'qs', 'qs-off', 'notes', 'notes-off', 'menu-app', 'menu-window', 'menu-move', 'menu-help', 'menu-off', 'hint', 'hint-off'):
            # The Desk's mode pill and the Couch: read the modes again, open or close Modes (on SCREEN), Identify.
            scr = a[1] if len(a) > 1 and re.match(r'^[A-Za-z0-9_.-]{1,40}$', a[1]) else ''
            ping_modes(a[0], scr)
        elif what == 'menus' and a and a[0].isdigit():
            print('own' if own_menus(int(a[0])) else 'standard')
        elif what == 'tip':
            # The Desk bar's first-run tip: shown once (state in ~/.local/state, not a setting).
            f = os.path.join(os.path.dirname(state_path()), 'firehold-bar-tip')
            if os.environ.get('HEARTH_FIREHOLD_TIP') == 'always' or not os.path.exists(f):
                print('show')
                try:
                    write_small(f, str(int(time.time())))
                except OSError:
                    pass
            else:
                print('seen')
        elif what in ('qs', 'qs-do') and os.path.isfile(HEARTH_QUICK) and (what == 'qs' or (a and a[0] in SHARED_QS)):
            # Hearth's shared Quick Settings backend (one for Hearth Classic and Firehold) when it's installed.
            r = subprocess.run([sys.executable, HEARTH_QUICK, what] + a[:2], capture_output=True, text=True, timeout=20)
            sys.stdout.write(r.stdout)
        elif what == 'qs':
            print(json.dumps(quick_settings()))
        elif what == 'qs-do' and a:
            print(json.dumps(qs_do(a[0], a[1] if len(a) > 1 else '')))
        elif what == 'ping-later' and len(a) == 2 and a[0].isdigit() and a[1] in ('hint-off',):
            time.sleep(min(int(a[0]), 60))
            ping_modes(a[1])
        elif what == 'pad-button' and a and re.match(r'^[a-z]{1,12}$', a[0]):
            # A controller button pressed on the Desk (the checks use it: no controller in CI).
            if current_posture() == 'desk':
                desk_pad(a[0])
        elif what == 'modes':
            print(json.dumps(modes_info()))
        elif what == 'mode' and len(a) >= 2:
            why = a[a.index('--why') + 1] if '--why' in a[:-1] else 'pick'
            if why not in WHY:
                raise ValueError('bad reason')
            targets = [x for x in a[0].split(',') if re.match(r'^[A-Za-z0-9_.-]{1,40}$', x)]
            set_modes(targets, a[1], why)
        elif what == 'away-later' and a and a[0].isdigit():
            return away_later(int(a[0]))
        elif what == 'back' and a and a[0] in ('pad', 'mouse', 'keys', 'pick'):
            come_back(a[0])
        elif what == 'begin' and a and a[0] in (COUCH, DESK):
            begin(a[0])
        elif what == 'plain':
            plain()
        elif what == 'ask' and a:
            ask(a[0])
        elif what == 'listen':
            return listen(a[0] if a and a[0] in ('bar-posture', 'bar-app') else '')
        elif what == 'state' and a and a[0] in ('front', 'back', 'guide'):
            write_small(os.path.join(run_dir(), 'front'), a[0])
        elif what == 'tab':
            t = read_small(os.path.join(run_dir(), 'tab'))
            try:
                os.unlink(os.path.join(run_dir(), 'tab'))
            except OSError:
                pass
            print(t or 'home')
        elif what == 'get':
            print(json.dumps(settings()))
        elif what == 'set' and len(a) == 2:
            set_setting(a[0], json.loads(a[1]))
        elif what == 'sys':
            print(json.dumps(sysinfo(bool(a and a[0] == 'all'))))
        elif what == 'do' and a:
            print(json.dumps(do(a[0], a[1] if len(a) > 1 else '')))
        elif what == 'home':
            print(json.dumps(home_cards(bool(a and a[0] == 'fast'))))
        elif what == 'home-after' and a and a[0].isdigit():
            return home_after(int(a[0]), len(a) > 1 and a[1] == 'fast')
        elif what == 'apps':
            print(json.dumps(apps()))
        elif what == 'launch' and a:
            launch(a[0])
        elif what in ('library', 'cached', 'play', 'page'):
            return games([what] + a)
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        print('error: %s' % e)
        return 1
    return 0


def pick():
    """Plasma's menu entry "Firehold (Plasma, test)": the Desktop Mode choice, saved only when you press OK."""
    cur = effective_choice()
    if not have('kdialog'):
        print(cur)
        return 0
    r = subprocess.run(['kdialog', '--title', 'Firehold (Plasma, test)', '--radiolist',
                        'Desktop Mode on this test edition:', 'plasma', 'KDE Plasma (the default)', 'on' if cur == 'plasma' else 'off',
                        'firehold', 'Firehold (Plasma, test): Couch and Desk', 'on' if cur == 'firehold' else 'off'],
                       capture_output=True, text=True)
    v = r.stdout.strip()
    if r.returncode != 0 or v not in ('plasma', 'firehold'):
        return 0
    choose(v)
    if v != cur:
        if v == 'firehold':
            msg = 'Firehold starts the next time you open Desktop Mode. Your apps stay open when you switch between Couch and Desk.'
        else:
            msg = 'KDE Plasma starts the next time you open Desktop Mode.'
        detach(['kdialog', '--title', 'Firehold (Plasma, test)', '--msgbox', msg])
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
