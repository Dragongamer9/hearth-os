            'autoPad': s.get('autoPad', True) is not False, 'autoPadScope': s.get('autoPadScope') if s.get('autoPadScope') in ('tv', 'every') else 'tv',
            'autoMouse': s.get('autoMouse', True) is not False,
            'awayAfter': s.get('awayAfter') if isinstance(s.get('awayAfter'), int) and s.get('awayAfter') >= 0 else 20,
            'why': WHY}


