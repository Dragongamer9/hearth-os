def ping_modes(what='modes', screen=''):
    """The Couch and the Desk's posture applets read the modes again (Plasma's scripting: their "modes" key; the time
    is all it carries)."""
    v = '%s|%d|%s' % (what, int(time.time() * 1000), screen)
