def tell_kwin_screens(screens):
    """KWin's side, a screen at a time (the KWin script's own shortcuts, "Firehold Couch on NAME" / "Firehold Desk on NAME")."""
    for s in screens:
        name = ('Firehold Couch on ' if s['mode'] == 'couch' else 'Firehold Desk on ') + s['name']
        dbus_send('org.kde.kglobalaccel', '/component/kwin', 'org.kde.kglobalaccel.Component.invokeShortcut', 'string:' + name, reply=False)


def away_power(on):
    """Away: the power saver profile while every screen is Away (the profile you had comes back with you)."""
    saved = os.path.join(run_dir(), 'away-profile')
    if not have('powerprofilesctl'):
        return
    if on and not os.path.exists(saved):
        cur = quiet(['powerprofilesctl', 'get'], 3).strip()
        if cur:
            write_small(saved, cur)
            quiet(['powerprofilesctl', 'set', 'power-saver'], 5)
    elif not on and os.path.exists(saved):
        prev = read_small(saved)
        try:
            os.unlink(saved)
        except OSError:
            pass
        if prev in ('power-saver', 'balanced', 'performance'):
            quiet(['powerprofilesctl', 'set', prev], 5)


def set_modes(targets, mode, why=''):
    """TARGETS: screen names, "all", "tv" (the TVs) or "others" (every screen but the TVs)."""
    if mode not in MODES:
        raise ValueError('couch, desk or away')
    screens = screen_modes()
    if not screens:
        return switch(mode if mode != 'away' else 'couch', '', why)
    d = read_modes()
    before = None
    if mode == 'away' and not any(s['mode'] == 'away' for s in screens):
        before = {s['name']: s['mode'] for s in screens}
    now = int(time.time() * 1000)
    for s in screens:
        hit = ('all' in targets or s['name'] in targets or ('tv' in targets and s['tv']) or ('others' in targets and not s['tv']))
        if hit and s['mode'] != mode:
            s.update({'mode': mode, 'why': why, 'at': now})
    write_modes(screens, before if before is not None else d.get('before'))
    apply_modes(screens, why)
    if mode == 'away' and all(x['mode'] == 'away' for x in screens):
        detach([sys.executable, os.path.realpath(__file__), 'away-later', str(now)])
    return None


def away_later(since):
    """While Away (Settings › Couch, Desk and Away › While Away): the screens off after their time, then the lock
    (your PIN), only if it's still the same Away. Asleep until then."""
    s = settings()
    off = s.get('awayScreenOff') if isinstance(s.get('awayScreenOff'), int) else 10
    lock = s.get('awayLock') if isinstance(s.get('awayLock'), int) else 10
    steps = sorted([(off, 'off'), (lock, 'lock')])
    start = since / 1000.0
    for mins, what in steps:
        if mins <= 0:
            continue
        wait = start + mins * 60 - time.time()
        if wait > 0:
            time.sleep(wait)
        ss = screen_modes()
        if not ss or not all(x['mode'] == 'away' for x in ss) or min(x['at'] for x in ss) > since:
            return 0
        if what == 'off' and have('kscreen-doctor'):
            quiet(['kscreen-doctor', '--dpms', 'off'], 10)
        elif what == 'lock' and have('loginctl'):
            quiet(['loginctl', 'lock-session'], 10)
    return 0


def come_back(why):
    """Back from Away: the modes the screens had before (the controller brings the TVs to the Couch)."""
    d = read_modes()
    before = d.get('before') if isinstance(d.get('before'), dict) else {}
    screens = screen_modes()
    now = int(time.time() * 1000)
    for s in screens:
        if s['mode'] == 'away':
            m = before.get(s['name']) if before.get(s['name']) in ('couch', 'desk') else 'desk'
            if why == 'pad' and s['tv']:
                m = 'couch'
            elif why in ('mouse', 'keys') and not s['tv']:
                m = 'desk'
            s.update({'mode': m, 'why': why, 'at': now})
    write_modes(screens, {})
    apply_modes(screens, why)


def apply_modes(screens, why=''):
    modes = [s['mode'] for s in screens]
    away_power(bool(modes) and all(m == 'away' for m in modes))
    live = [m for m in modes if m != 'away']
    if live:
        want = 'couch' if all(m == 'couch' for m in live) else 'desk'
    else:
        want = current_posture()
    tell_kwin_screens(screens)
    pkg = shell_for(want)
    if read_small(os.path.join(run_dir(), 'shell')) != pkg or current_posture() != want:
        switch(want, '', why, keep_modes=True)
    else:
        ping_modes()


