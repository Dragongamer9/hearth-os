  stampAll(panels());
  print(JSON.stringify({ok: true, hearth: true}));
} else print(JSON.stringify({ok: true, hearth: false}));
'''

UNDO_JS = r'''
var ps = panels();
for (var i = ps.length - 1; i >= 0; i--) if (ps[i].widgets("org.hearthos.panel").length) ps[i].remove();
if (!panels().length) loadTemplate("org.kde.plasma.desktop.defaultPanel");
print(JSON.stringify({ok: true, panels: panels().length}));
'''


# KDE's own settings Hearth's panel changes while it's in use, and what they were (saved with your panels; `undo`
# puts each back, or removes it when it wasn't set). Each is one of KDE's pieces Hearth's panel draws itself:
#   KDE's critical pop-ups while Hearth holds KDE's pop-ups (Hearth shows every notification itself; when Hearth's
#   panel isn't running nothing is held, so KDE's pop-ups all come back), KDE's on-screen display (Hearth's volume and
#   brightness bars), the window frames (Mantel's own, theme/hearth_aurorae.py) and Alt+Tab (Mantel's own switcher,
#   org.hearth.switcher, the one Mantel on KWin uses).
KDE_KEYS = [('plasmanotifyrc', 'Notifications', 'CriticalInDndMode', 'false'),
            ('plasmarc', 'OSD', 'Enabled', 'false'),
            ('kwinrc', 'org.kde.kdecoration2', 'library', 'org.kde.kwin.aurorae'),
            ('kwinrc', 'org.kde.kdecoration2', 'theme', '__aurorae__svg__hearth'),
            ('kwinrc', 'TabBox', 'LayoutName', 'org.hearth.switcher')]


# Mantel's lock screen in KDE's screen locker (the same LockScreen.qml as Mantel on KWin, desktop/kwin-lock), as a
# Plasma look-and-feel package with only a lock screen (install.sh). The locker reads its lock screen from the theme
# kscreenlockerrc [Greeter] Theme names; Hearth's panel names this one only after the locker's own test run (off
# screen) showed it loading, so a lock screen that can't show is never picked (the locker would cover the screen).
# Undo puts the setting back as it was.
LOCK_ID = 'org.hearthos.mantel-lock'
LOCK_KEY = ('kscreenlockerrc', 'Greeter', 'Theme', LOCK_ID)


def lock_ok():
    pkg = os.path.join('/usr/share/plasma/look-and-feel', LOCK_ID)
    if not os.path.isfile(os.path.join(pkg, 'contents', 'lockscreen', 'LockScreen.qml')):
        return False, "Hearth's lock screen isn't installed"
    try:
        import importlib.machinery
        import importlib.util
        import tempfile
        loader = importlib.machinery.SourceFileLoader('hearth_lockcheck', os.path.join(SHELL, 'hearth-lockcheck'))
        spec = importlib.util.spec_from_loader('hearth_lockcheck', loader)
        lc = importlib.util.module_from_spec(spec)
        loader.exec_module(lc)
    except (OSError, ImportError, SyntaxError) as e:
        return False, 'no lock check here (%s)' % e
    g = lc.greeter()
    if not g:
        return False, "KDE's screen locker isn't installed"
    tmp = tempfile.mkdtemp(prefix='hearth-lock-')
    try:
        with open(os.path.join(tmp, 'kscreenlockerrc'), 'w') as fh:
            fh.write('[Greeter]\nTheme=%s\n' % LOCK_ID)
        env = dict(os.environ, XDG_CONFIG_HOME=tmp, QT_QPA_PLATFORM='offscreen', QT_FORCE_STDERR_LOGGING='1')
        for k in ('WAYLAND_DISPLAY', 'WAYLAND_SOCKET', 'DISPLAY'):
            env.pop(k, None)
        out = lc.run_greeter(g, env)
    except OSError as e:
        return False, "the screen locker won't run: %s" % e
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    bad = [m for m in lc.FAIL_MARKS if m in out]
    if bad:
        return False, bad[0]
    if lc.LOADED not in out:
        return False, "the screen locker's test run didn't show Hearth's lock screen"
    return True, 'ok'


def kcfg(tool):
    for t in (tool + '6', tool):
        if shutil.which(t):
            return t
    return None


def kread(f, g, k):
    t = kcfg('kreadconfig')
    if not t:
        return None
    r = subprocess.run([t, '--file', f, '--group', g, '--key', k, '--default', '__hearth_none__'], capture_output=True, text=True, timeout=10)
    v = r.stdout.rstrip('\n')
    return None if v == '__hearth_none__' else v


def kwrite(f, g, k, v):
    t = kcfg('kwriteconfig')
    if not t:
        return False
    # --notify: the running session's KDE pieces read it again now (Plasma's notification pop-ups keep their
    # settings in memory and only re-read a change sent this way), not only at the next sign-in.
    args = [t, '--file', f, '--group', g, '--key', k, '--notify'] + (['--delete'] if v is None else [v])
    if subprocess.run(args, capture_output=True, timeout=10).returncode == 0:
        return True
    args.remove('--notify')    # an older kwriteconfig without --notify: the file still changes
    return subprocess.run(args, capture_output=True, timeout=10).returncode == 0


def last_kde_settings():
    root = backup_root()
    for d in sorted(os.listdir(root), reverse=True) if os.path.isdir(root) else []:
        old = read_json(os.path.join(root, d, 'kde-settings.json'))
        if isinstance(old, dict):
            return old
    return None


def kde_take(dest):
    # Picked again while it's in use: KDE's settings as they were before Hearth's panel (the last saved copy), not
    # Hearth's own, are what undo puts back.
    before = last_kde_settings() if in_use() else None
    keys = list(KDE_KEYS)
    ok, why = lock_ok()
    if ok:
        keys.append(LOCK_KEY)
    else:
        sys.stderr.write("hearth-plasma-panel: KDE's own lock screen stays (%s)\n" % why)
    old = {}
    for f, g, k, v in keys:
        key = '%s|%s|%s' % (f, g, k)
        old[key] = before[key] if before and key in before else kread(f, g, k)
        kwrite(f, g, k, v)
    try:
        with open(os.path.join(dest, 'kde-settings.json'), 'w') as fh:
            json.dump(old, fh)
    except OSError:
        pass
    frames()


def kde_give_back():
    old = last_kde_settings()
    for key, v in (old or {}).items():
        f, g, k = key.split('|')
        kwrite(f, g, k, v)
    subprocess.run(['dbus-send', '--session', '--type=method_call', '--dest=org.kde.KWin', '/KWin', 'org.kde.KWin.reconfigure'],
                   capture_output=True, timeout=10)


def in_use():
    d = read_json(os.path.join(data(), 'nimbus', 'desktop.json'), {}) or {}
    return d.get('plasmaPanel') == 'hearth'


def frames():
    """Mantel's own window frames for your look (theme/hearth-theme writes the Aurorae theme and picks it), while
    Hearth's panel is in use."""
    ht = os.path.join(os.path.dirname(SHELL), 'theme', 'hearth-theme')
    if not os.path.isfile(ht):
        return 1
    env = dict(os.environ, HEARTH_WM='kwin')
    subprocess.run([sys.executable, ht], env=env, capture_output=True, timeout=60)
    kwrite('kwinrc', 'org.kde.kdecoration2', 'library', 'org.kde.kwin.aurorae')
    subprocess.run(['dbus-send', '--session', '--type=method_call', '--dest=org.kde.KWin', '/KWin', 'org.kde.KWin.reconfigure'],
                   capture_output=True, timeout=10)
    return 0


def apply():
    dest = save_panels()
    kde_take(dest)
    out = plasma_js(params() + APPLY_JS)
    o = last_json(out)
    if not o or not o.get('ok'):
        print(json.dumps({'ok': False, 'why': "Plasma's panel didn't answer", 'saved': dest}))
        return 1
    remember('hearth')
    print(json.dumps({'ok': True, 'saved': dest}))
    return 0


def undo():
    out = plasma_js(UNDO_JS)
    o = last_json(out)
    if not o or not o.get('ok'):
        print(json.dumps({'ok': False, 'why': "Plasma's panel didn't answer"}))
        return 1
    remember('kde')
    kde_give_back()
    print(json.dumps({'ok': True}))
    return 0


def restore(which=''):
    root = backup_root()
    dirs = sorted(os.listdir(root)) if os.path.isdir(root) else []
    pick = which if which in dirs else (dirs[-1] if dirs else '')
    if not pick:
        print(json.dumps({'ok': False, 'why': 'No saved panels'}))
        return 1
    src = os.path.join(root, pick)
    for f in os.listdir(src):
        shutil.copy2(os.path.join(src, f), os.path.join(cfg(), f))
    detach(['sh', '-c', 'systemctl --user restart plasma-plasmashell.service || (kquitapp6 plasmashell; sleep 2; kstart plasmashell)'])
    remember('kde')
    print(json.dumps({'ok': True, 'restored': pick}))
    return 0


def sync():
    if in_use():
        frames()
    out = plasma_js(params() + SYNC_JS)
    o = last_json(out) or {'ok': False}
    print(json.dumps(o))
    return 0


def hold_popups():
    """While Hearth draws the notifications (Mantel's pop-ups), KDE's own pop-ups stay away: an inhibition held by
    this process (org.freedesktop.Notifications.Inhibit, Plasma's own way for an app to pause pop-ups, not a setting:
    nothing is saved). Every notification still comes in and is kept in the history; Hearth shows it. It ends when
    the panel goes (this process ends with plasmashell), so KDE's pop-ups come back with KDE's panel. Sleeps; never polls."""
    import signal
    try:
        import ctypes
        ctypes.CDLL('libc.so.6').prctl(1, signal.SIGTERM)   # PR_SET_PDEATHSIG: end with the panel
    except (OSError, AttributeError):
        pass
    try:
        import dbus
        bus = dbus.SessionBus()
        n = dbus.Interface(bus.get_object('org.freedesktop.Notifications', '/org/freedesktop/Notifications'), 'org.freedesktop.Notifications')
        cookie = n.Inhibit('org.hearthos.panel', "Hearth's panel shows your notifications", {})
    except Exception as e:   # no dbus-python or no service: KDE's pop-ups stay as they are
        print(json.dumps({'ok': False, 'why': str(e)[:200]}))
        return 1
    print(json.dumps({'ok': True, 'cookie': int(cookie)}), flush=True)
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(0))
    while True:
        signal.pause()


# ------------------------------------------------------------------ Mantel's hearth-notifyd, on Plasma
# Mantel's tray extras (background apps, the camera, printing, removable disks, Caps Lock / Num Lock, dock badges)
# come from hearth-notifyd, which talks in JSON lines on its stdin / stdout. Plasma's command runner only hands
# back what a program printed once it ends, so a small go-between keeps hearth-notifyd running and answers the panel
# one change at a time: the panel waits with `notifyd-wait SEQ` (asleep until something changes, then it prints the
# changes since SEQ and ends, and the panel asks again), and `notifyd-send JSON` passes the panel's asks on (cancel
# a print, eject a disk, quit a background app). Nothing polls; it goes away a little while after the panel does.
# Job progress is Plasma's own (plasmashell serves org.kde.JobViewServer, so hearth-notifyd leaves it alone); a job
# hearth-notifyd does serve (no Plasma service yet) comes through too.
NOTIFYD = os.environ.get('HEARTH_NOTIFYD') or os.path.join(SHELL, 'hearth-notifyd')
BRIDGE_IDLE = 30


def bridge_sock():
    return os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'hearth-plasma-panel', 'notifyd.sock')


def notifyd_bridge():
    import socket
    import threading
    path = bridge_sock()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        if os.path.exists(path):
            try:   # one already answering: this one isn't needed
                c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM); c.settimeout(2); c.connect(path); c.close()
                return 0
            except OSError:
                os.unlink(path)
        srv.bind(path)
    except OSError:
        return 0
    srv.listen(8)
    lock = threading.Condition()
    st = {'seq': 0, 'kept': {}, 'waiting': 0, 'last': time.time(), 'proc': None, 'stop': False, 'tries': 0}

    def key(m):
        t = m.get('t', '')
        if t in ('job', 'badge'):
            return '%s:%s' % (t, m.get('id', m.get('app', '')))
        if t == 'done':
            return 'done:%d' % (st['seq'] + 1)
        return t

    def keep(m):
        with lock:
            st['seq'] += 1
            m = dict(m, _seq=st['seq'])
            st['kept'][key(m)] = m
            dones = sorted((k for k in st['kept'] if k.startswith('done:')), key=lambda k: st['kept'][k]['_seq'])
            for k in dones[:-20]:
                del st['kept'][k]
            lock.notify_all()

    def run_notifyd():
        while not st['stop'] and st['tries'] < 8:
            try:
                p = subprocess.Popen(['python3', NOTIFYD, 'serve', '--stdio'], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.DEVNULL, text=True, bufsize=1)
            except OSError:
                return
            st['proc'] = p
            started = time.time()
            for line in p.stdout:
                try:
                    m = json.loads(line)
                except ValueError:
                    continue
                if isinstance(m, dict):
                    keep(m)
            p.wait()
            st['proc'] = None
            if time.time() - started > 60:
                st['tries'] = 0
            st['tries'] += 1
            if not st['stop']:
                time.sleep(2 * st['tries'])

    def closed(c):
        import select
        try:
            r, _, _ = select.select([c], [], [], 0)
            return bool(r) and c.recv(1, socket.MSG_PEEK) == b''
        except OSError:
            return True

    def client(c):
        try:
            f = c.makefile('rw')
            line = f.readline().strip()
            if line.startswith('SEND '):
                p = st['proc']
                ok = False
                if p and p.stdin:
                    try:
                        p.stdin.write(line[5:] + '\n'); p.stdin.flush(); ok = True
                    except OSError:
                        ok = False
                f.write(json.dumps({'ok': ok}) + '\n'); f.flush()
            elif line.startswith('WAIT '):
                try:
                    since = int(line[5:])
                except ValueError:
                    since = 0
                with lock:
                    st['waiting'] += 1
                    if since > st['seq']:   # the go-between started again: everything, from the start
                        since = 0
                    gone = False
                    while st['seq'] <= since and not st['stop'] and not gone:
                        lock.wait(15)
                        gone = closed(c)     # the panel stopped waiting (plasmashell went)
                    out = sorted((m for m in st['kept'].values() if m['_seq'] > since), key=lambda m: m['_seq'])
                    seq = st['seq']
                    st['waiting'] -= 1
                    st['last'] = time.time()
                if not gone:
                    f.write(json.dumps({'seq': seq, 'msgs': out}) + '\n'); f.flush()
        except OSError:
            with lock:
                st['last'] = time.time()
        finally:
            try:
                c.close()
            except OSError:
                pass

    def idle():   # nobody has asked for a while (the panel went): stop
        while True:
            time.sleep(BRIDGE_IDLE)
            with lock:
                if st['waiting'] == 0 and time.time() - st['last'] > BRIDGE_IDLE:
                    st['stop'] = True
                    lock.notify_all()
            if st['stop']:
                p = st['proc']
                if p:
                    try:
                        p.stdin.close()
                    except OSError:
                        pass
                try:
                    os.unlink(path)
                except OSError:
                    pass
                os._exit(0)

    threading.Thread(target=run_notifyd, daemon=True).start()
    threading.Thread(target=idle, daemon=True).start()
    while True:
        c, _ = srv.accept()
        threading.Thread(target=client, args=(c,), daemon=True).start()


def bridge_ask(line, timeout=None):
    import socket
    for attempt in range(12):
        c = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            c.connect(bridge_sock())
        except OSError:
            c.close()
            if attempt == 0:
                detach(['python3', os.path.abspath(__file__), 'notifyd-bridge'])
            time.sleep(0.5)
            continue
        c.settimeout(timeout)
        c.sendall((line + '\n').encode())
        f = c.makefile('r')
        out = f.readline()
        c.close()
        return out.strip()
    return ''


def notifyd_wait(since):
    import signal
    try:
        import ctypes
        ctypes.CDLL('libc.so.6').prctl(1, signal.SIGTERM)   # PR_SET_PDEATHSIG: ends with the panel
    except (OSError, AttributeError):
        pass
    if not os.path.exists(NOTIFYD):
        print(json.dumps({'seq': 0, 'msgs': [], 'missing': True}))
        return 1
    out = bridge_ask('WAIT %d' % since)
    print(out or json.dumps({'seq': since, 'msgs': [], 'down': True}))
    return 0 if out else 1


def notifyd_send(obj):
    out = bridge_ask('SEND ' + json.dumps(json.loads(obj)), timeout=10)
    print(out or json.dumps({'ok': False}))
    return 0

# ------------------------------------------------------------------ new accounts, and a panel that can't start
# The owner (Nov 19): Hearth's panel is the default on new Fedora installs: only on a fresh install or a new account's
# first sign-in, never switched for anyone who already has a panel. A new account gets NEW_MARK from /etc/skel (an
# account made before this update never has it); the first sign-in puts Hearth's panel in, then takes the mark away.
NEW_MARK = os.path.join('.config', 'hearth', 'plasma-panel-new')
READY_SECS = 45


def ready_path():
    return os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'hearth-plasma-panel', 'ready-bar')


def mark_ready():
    p = ready_path()
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, 'w') as f:
        f.write(str(int(time.time())))
    return 0


def notify(text):
    detach(['notify-send', '-a', 'Hearth', '-i', 'hearth', "Hearth's panel", text])


def first_login():
    """A new account's first sign-in: Hearth's panel. Done once (the mark goes either way)."""
    mark = os.path.join(home(), NEW_MARK)
    if not os.path.isfile(mark):
        return 'not new'
    try:
        os.remove(mark)
    except OSError:
        pass
    if in_use():
        return 'already'
    return 'applied' if apply() == 0 else 'failed'


def guard(wait=READY_SECS):
    """Hearth's panel in use but its bar never said it's up (READY_SECS after sign-in): KDE's own panel back, so the
    desktop always has a panel, and you're told (Settings › Bar and dock puts Hearth's back)."""
    if not in_use():
        return 'not in use'
    since = time.time()
    while time.time() - since < wait:
        try:
            if os.path.getmtime(ready_path()) >= since - 120:
                return 'up'
        except OSError:
            pass
        time.sleep(1)
    undo()
    notify("Hearth's panel couldn't start, so KDE's panel is back. Settings › Bar and dock can try Hearth's panel again.")
    return 'fell back'


def login():
    """At sign-in (autostart): a new account's first sign-in gets Hearth's panel; then the panel is checked."""
    a = first_login()
    b = guard()
    print(json.dumps({'first': a, 'guard': b}))
    return 0


def main(argv):
    cmd, rest = (argv[1] if len(argv) > 1 else 'status'), argv[2:]
    if cmd == 'env':
        print(json.dumps(env()))
    elif cmd == 'apps':
        print(json.dumps(apps()))
    elif cmd == 'launch' and rest:
        return launch(rest[0], rest[1] if len(rest) > 1 else '')
    elif cmd == 'run':
        return run(rest)
    elif cmd == 'osk':       # the on-screen keyboard (KWin's), on or off
        cur = subprocess.run(['dbus-send', '--session', '--print-reply', '--dest=org.kde.KWin', '/VirtualKeyboard',
                              'org.freedesktop.DBus.Properties.Get', 'string:org.kde.kwin.VirtualKeyboard', 'string:active'],
                             capture_output=True, text=True, timeout=5).stdout
        on = 'true' in cur
        subprocess.run(['dbus-send', '--session', '--dest=org.kde.KWin', '/VirtualKeyboard', 'org.freedesktop.DBus.Properties.Set',
                        'string:org.kde.kwin.VirtualKeyboard', 'string:active', 'variant:boolean:' + ('false' if on else 'true')],
                       capture_output=True, timeout=5)
    elif cmd == 'status':
        return status()
    elif cmd == 'apply':
        return apply()
    elif cmd == 'undo':
        return undo()
    elif cmd == 'restore':
        return restore(rest[0] if rest else '')
    elif cmd == 'sync':
        return sync()
    elif cmd == 'frames':        # hearth-plasma-looks after a Global Theme: Mantel's frames back, if Hearth's panel is in use
        return frames() if in_use() else 0
    elif cmd == 'login':
        return login()
    elif cmd == 'ready':
        return mark_ready()
    elif cmd == 'hold-popups':
        return hold_popups()
    elif cmd == 'notifyd-bridge':
        return notifyd_bridge()
    elif cmd == 'notifyd-wait':
        return notifyd_wait(int(rest[0]) if rest and rest[0].isdigit() else 0)
    elif cmd == 'notifyd-send' and rest:
        return notifyd_send(rest[0])
    elif cmd == 'open' and rest and rest[0] in ('launcher', 'quick', 'calendar', 'search', 'power', 'deskmenu', 'osd', 'osd-bright', 'close'):
        # Opens (or closes again) the app menu, Quick settings or the dashboard on Hearth's bar: for a shortcut
        # of your own, and CI's pictures.
        out = plasma_js('var ps=panels();for(var i=0;i<ps.length;i++){var ws=ps[i].widgets("org.hearthos.panel");'
                        'for(var j=0;j<ws.length;j++){ws[j].currentConfigGroup=["General"];if(String(ws[j].readConfig("role","bar"))==="bar")'
                        'ws[j].writeConfig("open",%s);}}print("{}");' % json.dumps('%s:%.3f' % (rest[0], time.time())))
        return 0 if out is not None else 1
    elif cmd == 'js' and rest:       # CI and checks: the layout script as it would run (nothing applied)
        print(params() + {'apply': APPLY_JS, 'sync': SYNC_JS, 'undo': UNDO_JS}.get(rest[0], ''))
    else:
        print(__doc__)
        return 2
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
