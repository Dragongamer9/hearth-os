SYNC_JS = r'''
var ps = panels(), bar = null, dock = null;
for (var i = 0; i < ps.length; i++) { var r = roleOf(ps[i]); if (r === "bar") bar = ps[i]; else if (r === "dock") dock = ps[i]; }
