USERDIRS = [('DESKTOP', 'Desktop'), ('DOCUMENTS', 'Documents'), ('DOWNLOAD', 'Downloads'), ('MUSIC', 'Music'),
            ('PICTURES', 'Pictures'), ('VIDEOS', 'Videos'), ('PUBLICSHARE', 'Public'), ('TEMPLATES', 'Templates')]


def userdirs():
    f = fixture('userdirs.json')
    if f is not None:
        return f
    base = os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config')
    text = read(os.path.join(base, 'user-dirs.dirs'))
    home = os.path.expanduser('~')
    out = []
    for key, label in USERDIRS:
        m = re.search(r'^XDG_%s_DIR="(.*)"' % key, text, re.M)
        path = (m.group(1) if m else '$HOME/' + label).replace('$HOME', home)
        out.append({'key': key, 'label': label, 'path': path})
    return out


def userdir_set(key, path):
    if key not in dict(USERDIRS):
        raise Fail('%s is not one of your folders' % key)
    path = os.path.abspath(os.path.expanduser(path))
    if not os.path.isdir(path):
        raise Fail('%s is not a folder' % path)
    if fixture_dir():
        return userdirs()
    if not shutil.which('xdg-user-dirs-update'):
        raise Fail('xdg-user-dirs-update is not installed')
    code, out, err = run(['xdg-user-dirs-update', '--set', key, path], 10)
    if code != 0:
        raise Fail((err or out).strip()[:300] or 'It could not be changed')
    hsio.log_event('kde: folder %s -> %s' % (key, path))
    return userdirs()


# ------------------------------------------------------------------ device actions (Solid's .desktop files)
KINDS = [('StorageVolume', 'Drives'), ('OpticalDisc', 'Discs'), ('Camera', 'Cameras'), ('PortableMediaPlayer', 'Music players and phones'),
         ('StorageAccess', 'Drives'), ('Block', 'Drives')]


def action_dirs():
    return [os.path.join(d, 'solid/actions') for d in data_dirs()]


def parse_desktop(path):
    groups, g = {}, None
    for line in read(path).splitlines():
        line = line.strip()
        if line.startswith('[') and line.endswith(']'):
            g = line[1:-1]
            groups.setdefault(g, {})
        elif '=' in line and g is not None and not line.startswith('#'):
            k, v = line.split('=', 1)
            groups[g][k.strip()] = v.strip()
    return groups


def device_actions():
    f = fixture('deviceactions.json')
    if f is not None:
        return f
    user = action_dirs()[0]
    system_files = {os.path.basename(p) for d in action_dirs()[1:] for p in glob.glob(os.path.join(d, '*.desktop'))}
    seen, out = set(), []
    for d in action_dirs():
        for p in sorted(glob.glob(os.path.join(d, '*.desktop'))):
            b = os.path.basename(p)
            if b in seen:
                continue
            seen.add(b)
            g = parse_desktop(p)
            de = g.get('Desktop Entry', {})
            if de.get('Hidden', '').lower() == 'true':
                continue
            pred = de.get('X-KDE-Solid-Predicate', '')
            kinds = sorted({label for k, label in KINDS if k in pred}) or ['Devices']
            for a in [x for x in de.get('Actions', '').split(';') if x]:
                da = g.get('Desktop Action ' + a, {})
                mine = p.startswith(user)
                out.append({'file': b, 'action': a, 'name': da.get('Name', a), 'exec': da.get('Exec', ''), 'kinds': ', '.join(kinds),
                            'mine': mine and b not in system_files, 'system': b in system_files, 'changed': mine and b in system_files})
    return out


def device_action_add(raw):
    try:
        a = json.loads(raw or '{}')
    except ValueError:
        raise Fail('expected JSON')
    name, cmd, kind = (a.get('name') or '').strip()[:80], (a.get('exec') or '').strip()[:400], a.get('kind', 'StorageVolume')
    if not name or not cmd or kind not in dict(KINDS) or '\n' in name + cmd:
        raise Fail('An action needs a name, a command and a kind of device')
    slug = re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-')[:40] or 'action'
    d = action_dirs()[0]
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, 'hearth-%s.desktop' % slug)
    if os.path.exists(path):
        raise Fail('There is already an action with that name')
    text = ('[Desktop Entry]\nX-KDE-Solid-Predicate=IS %s\nType=Service\nActions=open;\n\n'
            '[Desktop Action open]\nName=%s\nExec=%s\nIcon=system-run\n' % (kind, name, cmd))
    hsio.write_text(path, text)
    hsio.log_event('kde: device action %s' % name)
    return device_actions()


def system_action(fname):
    for d in action_dirs()[1:]:
        p = os.path.join(d, fname)
        if os.path.isfile(p):
            return p
    return None


def device_action_edit(raw):
    """A system action changed the way KDE's page does it: your own copy with the same name (in your solid/actions),
    which KDE uses instead; the system's file is never touched."""
    try:
        a = json.loads(raw or '{}')
    except ValueError:
        raise Fail('expected JSON')
    fname, act = a.get('file', ''), a.get('action', '')
    name, cmd = (a.get('name') or '').strip()[:80], (a.get('exec') or '').strip()[:400]
    if not re.match(r'^[A-Za-z0-9_.-]+\.desktop$', fname) or not re.match(r'^[A-Za-z0-9_.-]{1,60}$', act):
        raise Fail('bad action')
    if not name or not cmd or '\n' in name + cmd:
        raise Fail('An action needs a name and a command')
    user = os.path.join(action_dirs()[0], fname)
    if not os.path.isfile(user):
        src = system_action(fname)
        if not src:
            raise Fail('That action is gone')
        os.makedirs(os.path.dirname(user), exist_ok=True)
        hsio.write_text(user, read(src))
    kc.update(user, {'Desktop Action ' + act: {'Name': name, 'Exec': cmd}})
    hsio.log_event('kde: device action changed %s' % fname)
    return device_actions()


def device_action_reset(fname):
