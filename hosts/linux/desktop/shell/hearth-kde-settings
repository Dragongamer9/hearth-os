ACT = ('org.kde.ActivityManager', '/ActivityManager/Activities', 'org.kde.ActivityManager.Activities')
# "Don't remember what's opened in it" (KDE's activity page: isPrivate): the Scoring plugin's off-the-record switch.
FEAT = ('org.kde.ActivityManager', '/ActivityManager/Features', 'org.kde.ActivityManager.Features')
OTR = 'org.kde.ActivityManager.Resources.Scoring/isOTR/%s'
# The icons the page offers (freedesktop names every icon theme has).
ACT_ICONS = ('activities', 'user-home', 'applications-games', 'applications-office', 'applications-internet',
             'applications-multimedia', 'applications-graphics', 'applications-development', 'folder-music', 'weather-clear-night')


def activity_keys(aid):
    try:
        values, _, _ = kc.effective('kglobalshortcutsrc')
    except kc.BadFile:
        return []
    v = values.get('ActivityManager', {}).get('switch-to-activity-' + aid, '')
    return split_keys(v.split(',')[0]) if v else []


def activities():
    f = fixture('activities.json')
    if f is not None:
        return f
    if not has_name(ACT[0]):
        return {'running': False, 'list': []}
    try:
        ids = call(*ACT, 'ListActivities')[0]
        cur = call(*ACT, 'CurrentActivity')[0]
        out = []
        for i in ids:
            a = {'id': i, 'name': call(*ACT, 'ActivityName', '(s)', (i,))[0], 'icon': '', 'private': False, 'shortcut': []}
            try:
                a['icon'] = call(*ACT, 'ActivityIcon', '(s)', (i,))[0]
            except Fail:
                pass
            try:
                a['private'] = bool(call(*FEAT, 'GetValue', '(s)', (OTR % i,))[0])
            except Fail:
                pass
            a['shortcut'] = activity_keys(i)
            out.append(a)
        return {'running': True, 'current': cur, 'list': out}
    except Fail as e:
        return {'running': False, 'list': [], 'error': str(e)}


def activity(op, a):
    if fixture_dir():
        return activities()
    if not has_name(ACT[0]):
        raise Fail("KDE's activities only run on KDE Plasma")
    if op == 'add':
        name = (a[0] if a else '').strip()[:80]
        if not name:
            raise Fail('An activity needs a name')
        call(*ACT, 'AddActivity', '(s)', (name,))
    elif op == 'rename':
        call(*ACT, 'SetActivityName', '(ss)', (a[0], a[1].strip()[:80]))
    elif op == 'remove':
        if len(activities()['list']) <= 1:
            raise Fail('The last activity stays')
        call(*ACT, 'RemoveActivity', '(s)', (a[0],))
    elif op == 'switch':
        call(*ACT, 'SetCurrentActivity', '(s)', (a[0],))
    elif op == 'icon':
        if a[1] not in ACT_ICONS:
            raise Fail('%s is not one of the icons offered' % a[1])
        call(*ACT, 'SetActivityIcon', '(ss)', (a[0], a[1]))
    elif op == 'private':
        from gi.repository import GLib
        try:
            bus().call_sync(FEAT[0], FEAT[1], FEAT[2], 'SetValue', GLib.Variant('(sv)', (OTR % a[0], GLib.Variant('b', a[1] == 'on'))), None, 0, 4000, None)
        except Exception as e:
            raise Fail('It wasn\'t changed: %s' % (str(e).split(':')[-1].strip() or e))
    elif op == 'shortcut':
        name = next((x['name'] for x in activities()['list'] if x['id'] == a[0]), a[0])
        set_keys(['ActivityManager', 'switch-to-activity-' + a[0], 'Activity Manager', 'Switch to activity "%s"' % name], a[1])
    hsio.log_event('kde: activity %s' % op)
    return activities()


