# ------------------------------------------------------------------ push services (KUnifiedPush, as KDE's Push Services)
PUSH_DEST = 'org.unifiedpush.Distributor.kde'
PUSH_PROVIDERS = {'Ntfy': 'ntfy', 'Autopush': 'Mozilla Autopush', 'Gotify': 'Gotify', 'NextPush': 'NextPush (Nextcloud)'}


def push_obj():
    """Where KDE's push service has its management methods (found by asking it, not guessed)."""
    for path in ('/Management', '/'):
        try:
            xml = call(PUSH_DEST, path, 'org.freedesktop.DBus.Introspectable', 'Introspect')[0]
        except Fail:
            continue
        m = re.search(r'<interface name="([^"]+)">(?:(?!</interface>).)*setPushProvider', xml, re.S)
        if m:
            return path, m.group(1)
    return None


def push():
    f = fixture('push.json')
    if f is not None:
        return f
    o = push_obj() if has_name(PUSH_DEST) else None
    if not o:
        return {'running': False, 'providers': PUSH_PROVIDERS}
    out = {'running': True, 'providers': PUSH_PROVIDERS}
    for prop in ('pushProviderId', 'pushProviderConfiguration'):
        try:
            out[prop] = call(PUSH_DEST, o[0], 'org.freedesktop.DBus.Properties', 'Get', '(ss)', (o[1], prop))[0]
        except Fail:
            pass
    cfg = out.get('pushProviderConfiguration') or {}
    out['url'] = cfg.get('Url', '') if isinstance(cfg, dict) else ''
    return out


def push_set(provider, url):
    if provider not in ('Ntfy', 'Autopush'):
        raise Fail('%s needs a sign-in: pick it on KDE Plasma in its own window' % PUSH_PROVIDERS.get(provider, provider))
    if url and not re.match(r'^https?://[^\s]+$', url):
        raise Fail('The server must be a web address (https://...)')
    if fixture_dir():
        return {'running': True, 'pushProviderId': provider, 'url': url, 'providers': PUSH_PROVIDERS, 'preview': True}
    o = push_obj() if has_name(PUSH_DEST) else None
    if not o:
        raise Fail("KDE's push service isn't running here (it runs on KDE Plasma)")
    from gi.repository import GLib
    cfg = {'Url': GLib.Variant('s', url)} if url else {}
    try:
        bus().call_sync(PUSH_DEST, o[0], o[1], 'setPushProvider', GLib.Variant('(sa{sv})', (provider, cfg)), None, 0, 6000, None)
    except Exception as e:
        raise Fail('It wasn\'t changed: %s' % (str(e).split(':')[-1].strip() or e))
    hsio.log_event('kde: push provider %s %s' % (provider, url))
    return push()


# ------------------------------------------------------------------ passwords: only into KDE Wallet (or KDE's own service)
# A password typed on a page comes on stdin only (never on the command line, in the environment, a file or a log) and
# goes straight to KDE Wallet over its D-Bus interface (kwalletd6), or to KDE's push service, which keeps it itself.
WALLET = ('org.kde.kwalletd6', '/modules/kwalletd6', 'org.kde.KWallet')
APPID = 'Hearth Settings'


def secret_in():
    v = sys.stdin.read()
    v = v[:-1] if v.endswith('\n') else v
    if not v or len(v) > 4096 or '\n' in v:
        raise Fail('Type the password (one line)')
    return v


def wallet_call(method, sig, args):
    """One call to KDE Wallet (tests replace this with a pretend wallet)."""
    if not has_name(WALLET[0]):
        raise Fail('KDE Wallet isn\'t running (it runs on KDE Plasma), so the password can\'t be kept')
    from gi.repository import GLib, Gio
    try:
        r = bus().call_sync(WALLET[0], WALLET[1], WALLET[2], method, GLib.Variant(sig, tuple(args)), None, Gio.DBusCallFlags.NONE, 120000, None)
    except Exception as e:
        raise Fail('KDE Wallet said no: %s' % (str(e).split(':')[-1].strip() or 'it was closed'))
    return r.unpack()[0] if r is not None else None


def wallet_write(folder, key, value):
    name = 'kdewallet'
    try:
        name = wallet_call('networkWallet', '()', ()) or name
    except Fail:
        pass
    h = wallet_call('open', '(sxs)', (name, 0, APPID))
    if not isinstance(h, int) or h < 0:
        raise Fail('KDE Wallet stayed closed (it asks for its own password first)')
    if not wallet_call('hasFolder', '(iss)', (h, folder, APPID)):
        wallet_call('createFolder', '(iss)', (h, folder, APPID))
    if wallet_call('writePassword', '(issss)', (h, folder, key, value, APPID)) != 0:
        raise Fail('KDE Wallet didn\'t keep it')
    wallet_call('close', '(ibs)', (h, False, APPID))


def wallet_remove(folder, key):
    h = wallet_call('open', '(sxs)', ('kdewallet', 0, APPID))
    if isinstance(h, int) and h >= 0:
        wallet_call('removeEntry', '(isss)', (h, folder, key, APPID))
        wallet_call('close', '(ibs)', (h, False, APPID))


# Remote desktop (RDP): KDE's KRDP keeps its users' names in krdpserverrc [General] Users and each one's password in
# KDE Wallet (QtKeychain, service "KRDP"), as kcm_krdpserver does.
def rdp_users():
    f = fixture('rdpusers.json')
    if f is not None:
        return f
    try:
        v, _, _ = kc.effective('krdpserverrc')
    except kc.BadFile as e:
        return {'users': [], 'why': str(e)}
    return {'users': [u for u in (v.get('General', {}).get('Users', '')).split(',') if u.strip()], 'wallet': has_name(WALLET[0])}


def rdp_user_add(user):
    if not re.match(r'^[A-Za-z0-9_.@-]{1,64}$', user):
        raise Fail('A name with letters, numbers, . _ - or @')
    secret = secret_in()
    if fixture_dir():
        return rdp_users()
    wallet_write('KRDP', user, secret)
    del secret
    users = rdp_users()['users']
    if user not in users:
        kc.update(kc.user_path('krdpserverrc'), {'General': {'Users': ','.join(users + [user])}})
    hsio.log_event('kde: RDP user %s added (password in KDE Wallet)' % user)
    return rdp_users()


def rdp_user_remove(user):
    users = rdp_users()['users']
    if user not in users:
        raise Fail('%s is not an RDP user' % user)
    if fixture_dir():
        return rdp_users()
    try:
        wallet_remove('KRDP', user)
    except Fail:
        pass
    kc.update(kc.user_path('krdpserverrc'), {'General': {'Users': ','.join(u for u in users if u != user)}})
    hsio.log_event('kde: RDP user %s removed' % user)
    return rdp_users()


def push_signin(provider, url, user):
    """Gotify (its client token) or NextPush (your Nextcloud name and an app password): handed to KDE's push service
    over its own D-Bus call, which keeps them itself; nothing is written by Hearth."""
    if provider not in ('Gotify', 'NextPush'):
        raise Fail('bad provider')
    if not re.match(r'^https?://[^\s]+$', url or ''):
        raise Fail('The server must be a web address (https://...)')
    if provider == 'NextPush' and not re.match(r'^[^\s]{1,128}$', user or ''):
        raise Fail('Type your Nextcloud name')
    secret = secret_in()
    if fixture_dir():
        return {'running': True, 'pushProviderId': provider, 'url': url, 'providers': PUSH_PROVIDERS, 'preview': True}
    o = push_obj() if has_name(PUSH_DEST) else None
    if not o:
        raise Fail("KDE's push service isn't running here (it runs on KDE Plasma)")
    from gi.repository import GLib
    cfg = {'Url': GLib.Variant('s', url)}
    if provider == 'Gotify':
        cfg['ClientToken'] = GLib.Variant('s', secret)
    else:
        cfg['UserName'] = GLib.Variant('s', user)
        cfg['AppPassword'] = GLib.Variant('s', secret)
    try:
        bus().call_sync(PUSH_DEST, o[0], o[1], 'setPushProvider', GLib.Variant('(sa{sv})', (provider, cfg)), None, 0, 6000, None)
    except Exception as e:
        raise Fail('It wasn\'t changed: %s' % (str(e).split(':')[-1].strip() or e))
    del secret, cfg
    hsio.log_event('kde: push provider %s %s' % (provider, url))
    return push()


# ------------------------------------------------------------------ "Get New…": the KDE Store, as KNewStuff gets it
# KNewStuff's own description of each kind (/usr/share/knsrcfiles/*.knsrc: its store, categories and how to install)
# and the store's OCS API (what KNewStuff's dialog talks to). Downloads go to ~/.cache/hearth/kde-store; installs go
# only into your own folders (kpackagetool6 without --global, or ~/.local/share/<TargetDir>); what each install put
# where is kept in ~/.local/share/hearth/kde-store.json so Remove takes away just that.
STORE_KINDS = {'lookandfeel': 'lookandfeel.knsrc', 'colorschemes': 'colorschemes.knsrc', 'plasma-themes': 'plasma-themes.knsrc',
               'aurorae': 'aurorae.knsrc'}
OCS = 'https://api.kde-look.org/ocs/v1/'
UA = {'User-Agent': 'Hearth Settings (KNewStuff-compatible)'}


def knsrc(kind):
    if kind not in STORE_KINDS:
        raise Fail('no store kind %s' % kind)
    for d in data_dirs():
        p = os.path.join(d, 'knsrcfiles', STORE_KINDS[kind])
        if os.path.isfile(p):
            g = parse_desktop(p)
            return g.get('KNewStuff3') or g.get('KNewStuff') or {}
    raise Fail("KDE's description of this kind (%s) isn't installed" % STORE_KINDS[kind])


def cache_dir():
    d = os.path.join(os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache'), 'hearth', 'kde-store')
    os.makedirs(d, exist_ok=True)
    return d


def fetch(url, limit=300 << 20, secs=60):
    import urllib.request
    if not url.startswith('https://'):
        raise Fail('Only https downloads')
    req = urllib.request.Request(url, headers=UA)
    with urllib.request.urlopen(req, timeout=secs) as r:
        data = r.read(limit + 1)
    if len(data) > limit:
        raise Fail('That download is too big')
    return data


def ocs_xml(path):
    import xml.etree.ElementTree as ET
    try:
        return ET.fromstring(fetch(OCS + path, 8 << 20, 30))
    except Fail:
        raise
    except Exception as e:
        raise Fail("The KDE Store didn't answer (%s)" % str(e)[:160])


def store_registry():
    p = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'), 'hearth', 'kde-store.json')
    try:
        with open(p, encoding='utf-8') as f:
            return p, json.load(f)
    except (OSError, ValueError):
        return p, {}


def store(kind, search='', sort='down'):
    f = fixture('store-%s.json' % kind)
    if f is not None:
        return f
    k = knsrc(kind)
    wanted = [c.strip() for c in k.get('Categories', '').split(',') if c.strip()]
    cats = []
    for c in ocs_xml('content/categories').iter('category'):
        name, cid = (c.findtext('name') or ''), (c.findtext('id') or '')
        if name in wanted or (c.findtext('display_name') or '') in wanted:
            cats.append(cid)
    if not cats:
        raise Fail("The KDE Store has no %s now" % kind)
    import urllib.parse
    q = urllib.parse.urlencode({'categories': 'x'.join(cats), 'search': search[:80], 'sortmode': sort if sort in ('down', 'new', 'high') else 'down',
                                'page': 0, 'pagesize': 24})
    items = []
    _, reg = store_registry()
    for c in ocs_xml('content/data?' + q).iter('content'):
        cid = c.findtext('id') or ''
        if not re.match(r'^\d{1,12}$', cid):
            continue
        items.append({'id': cid, 'name': (c.findtext('name') or '')[:80], 'by': (c.findtext('personid') or '')[:60],
                      'downloads': c.findtext('downloads') or '', 'score': c.findtext('score') or '',
                      'summary': re.sub(r'<[^>]+>', '', c.findtext('summary') or c.findtext('description') or '')[:200],
                      'preview': c.findtext('smallpreviewpic1') or c.findtext('previewpic1') or '', 'installed': cid in reg.get(kind, {})})
    # The pictures, fetched at most once each (into the cache), four at a time.
    from concurrent.futures import ThreadPoolExecutor
    def thumb(it):
        url = it.pop('preview', '')
        path = os.path.join(cache_dir(), '%s.img' % it['id'])
        if url.startswith('https://') and not os.path.exists(path):
            try:
                data = fetch(url, 4 << 20, 15)
                with open(path + '.part', 'wb') as fh:
                    fh.write(data)
                os.replace(path + '.part', path)
            except Exception:
                pass
        it['thumb'] = path if os.path.exists(path) else ''
        return it
    with ThreadPoolExecutor(4) as ex:
        items = list(ex.map(thumb, items))
    return {'kind': kind, 'items': items}


def safe_extract(archive, dest):
    import tarfile, zipfile
    os.makedirs(dest, exist_ok=True)
    top = []
    if zipfile.is_zipfile(archive):
        with zipfile.ZipFile(archive) as z:
            for n in z.namelist():
                t = os.path.realpath(os.path.join(dest, n))
                if not t.startswith(os.path.realpath(dest) + os.sep):
                    raise Fail('That download has files outside its folder')
            z.extractall(dest)
            top = sorted({n.split('/')[0] for n in z.namelist() if n.split('/')[0]})
    else:
        with tarfile.open(archive) as t:
            t.extractall(dest, filter='data')
            top = sorted({m.name.split('/')[0] for m in t.getmembers() if m.name.split('/')[0] not in ('', '.')})
    return [os.path.join(dest, x) for x in top]


def store_install(kind, cid):
    if not re.match(r'^\d{1,12}$', cid):
        raise Fail('bad item')
    if fixture_dir():
        return {'ok': True, 'preview': True}
    k = knsrc(kind)
    c = next(iter(ocs_xml('content/data/%s' % cid).iter('content')), None)
    url = c.findtext('downloadlink1') if c is not None else ''
    if not url:
        raise Fail('That item has nothing to download')
    print('progress: 10 Downloading', flush=True)
    data = fetch(url)
    name = re.sub(r'[^A-Za-z0-9._-]+', '_', (c.findtext('downloadname1') or 'item'))[:100]
    path = os.path.join(cache_dir(), cid + '-' + name)
    with open(path, 'wb') as fh:
        fh.write(data)
    print('progress: 60 Installing', flush=True)
    share = os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share')
    put = []
    if k.get('KPackageType'):
        if not shutil.which('kpackagetool6'):
            raise Fail('kpackagetool6 is only on KDE Plasma')
        before = set(glob.glob(os.path.join(share, 'plasma', '*', '*')))
        code, out, err = run(['kpackagetool6', '--type', k['KPackageType'], '--install', path], 120)
        if code != 0:
            code, out, err = run(['kpackagetool6', '--type', k['KPackageType'], '--upgrade', path], 120)
        if code != 0:
            raise Fail((err or out).strip().splitlines()[-1][:300] if (err or out).strip() else 'It could not be installed')
        put = sorted(set(glob.glob(os.path.join(share, 'plasma', '*', '*'))) - before)
    else:
        target = os.path.join(share, k.get('TargetDir') or k.get('InstallPath') or '')
        if target.rstrip('/') == share.rstrip('/'):
            raise Fail("KDE's description says nowhere to put it")
        if k.get('Uncompress', 'never') in ('archive', 'always', 'subdir') and not path.endswith('.colors'):
            put = safe_extract(path, target)
        else:
            os.makedirs(target, exist_ok=True)
            dest = os.path.join(target, name)
            shutil.copyfile(path, dest)
            put = [dest]
    os.remove(path)
    reg_path, reg = store_registry()
    reg.setdefault(kind, {})[cid] = {'name': c.findtext('name') or cid, 'paths': put}
    os.makedirs(os.path.dirname(reg_path), exist_ok=True)
    hsio.write_text(reg_path, json.dumps(reg, indent=1))
    hsio.log_event('kde: store %s %s installed' % (kind, cid))
    return {'ok': True, 'installed': put}


def store_remove(kind, cid):
    reg_path, reg = store_registry()
    it = reg.get(kind, {}).get(cid)
    if not it:
        raise Fail('Only what was installed from here can be removed here')
    if fixture_dir():
        return {'ok': True, 'preview': True}
    share = os.path.realpath(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'))
    keep = os.path.join(cache_dir(), 'removed')
    os.makedirs(keep, exist_ok=True)
    for p in it.get('paths', []):
        rp = os.path.realpath(p)
        if rp.startswith(share + os.sep) and os.path.exists(rp):
            shutil.move(rp, os.path.join(keep, os.path.basename(rp)))
    del reg[kind][cid]
    hsio.write_text(reg_path, json.dumps(reg, indent=1))
    hsio.log_event('kde: store %s %s removed (kept in %s)' % (kind, cid, keep))
    return {'ok': True}


def main(argv):
    c = argv[1] if len(argv) > 1 else ''
    a = argv[2:]
    if c == 'status':
        return status()
    if c == 'get' and len(a) == 1:
        return get(a[0])
    if c == 'set' and len(a) == 1:
        return set_file(a[0], os.environ.get('HEARTH_INPUT') or sys.stdin.read())
    if c == 'apply' and len(a) == 2:
        return apply_tool(a[0], a[1])
    if c == 'list' and len(a) == 1:
        return list_kind(a[0])
    if c == 'info' and len(a) == 1:
        return info_kind(a[0])
    if c == 'firmware':
        return firmware_get()
    if c == 'firmware-set' and len(a) == 1 and a[0] in ('on', 'off'):
        return firmware_set(a[0] == 'on')
    if c == 'kded':
        return kded()
    if c == 'kded-set' and len(a) == 2 and a[1] in ('on', 'off'):
        return kded_set(a[0], a[1] == 'on')
    if c == 'activities':
        return activities()
    if c == 'activity' and a and a[0] in ('add', 'rename', 'remove', 'switch', 'icon', 'private', 'shortcut'):
        return activity(a[0], a[1:])
    if c == 'userdirs':
        return userdirs()
    if c == 'userdir-set' and len(a) == 2:
        return userdir_set(a[0], a[1])
    if c == 'device-actions':
        return device_actions()
    if c == 'device-action-add':
        return device_action_add(os.environ.get('HEARTH_INPUT') or sys.stdin.read())
    if c == 'device-action-edit':
        return device_action_edit(os.environ.get('HEARTH_INPUT') or sys.stdin.read())
    if c == 'device-action-reset' and len(a) == 1:
        return device_action_reset(a[0])
    if c == 'device-action-remove' and len(a) == 1:
        return device_action_remove(a[0])
    if c == 'shortcuts':
        return shortcuts()
    if c == 'shortcut-set' and len(a) == 3:
        return shortcut_set(a[0], a[1], a[2])
    if c == 'commands':
        return commands()
    if c == 'command-set':
        return command_set(os.environ.get('HEARTH_INPUT') or sys.stdin.read())
    if c == 'command-keys' and len(a) == 2:
        return command_keys(a[0], a[1])
    if c == 'command-remove' and len(a) == 1:
        return command_remove(a[0])
    if c == 'store' and len(a) in (1, 2, 3):
        return store(a[0], a[1] if len(a) > 1 else '', a[2] if len(a) > 2 else 'down')
    if c == 'store-install' and len(a) == 2:
        return store_install(a[0], a[1])
    if c == 'store-remove' and len(a) == 2:
        return store_remove(a[0], a[1])
    if c == 'rdp-users':
        return rdp_users()
    if c == 'rdp-user-add' and len(a) == 1:
        return rdp_user_add(a[0])
    if c == 'rdp-user-remove' and len(a) == 1:
        return rdp_user_remove(a[0])
    if c == 'push-signin' and len(a) in (2, 3):
        return push_signin(a[0], a[1], a[2] if len(a) > 2 else '')
    if c == 'push':
        return push()
    if c == 'push-set' and len(a) in (1, 2):
        return push_set(a[0], a[1] if len(a) > 1 else '')
    if c == 'fonts':
        return fonts()
    if c == 'font-install' and len(a) == 1:
        return font_install(a[0])
    if c == 'font-remove' and len(a) == 1:
        return font_remove(a[0])
    if c == 'font-off' and len(a) == 2 and a[1] in ('on', 'off'):
        return font_off(a[0], a[1] == 'off')
    if c == 'colord':
        return colord()
    if c == 'colord-default' and len(a) == 2:
        return colord_default(a[0], a[1])
    if c == 'colord-import' and len(a) == 1:
        return colord_import(a[0])
    if c == 'allowlist':
        return {f: {g: sorted(k) for g, k in gs.items()} for f, gs in allowlist().items()}
    raise Fail(__doc__.split('\n\n')[2] if c in ('', '-h', '--help') else 'unknown command %s' % c)


if __name__ == '__main__':
    try:
        print(json.dumps(main(sys.argv)))
    except Fail as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
    except kc.BadFile as e:
