def kded():
    f = fixture('kded.json')
    if f is not None:
        return f
    mods = []
    for pd in plugin_dirs():
        for so in sorted(glob.glob(os.path.join(pd, 'kf6/kded/*.so'))):
            mods.append(os.path.basename(so)[:-3])
    loaded = []
    try:
        loaded = list(call('org.kde.kded6', '/kded', 'org.kde.kded6', 'loadedModules')[0])
    except Fail:
        pass
    conf, _, _ = kc.effective('kded5rc')
    out = []
    for m in mods:
        auto = (conf.get('Module-' + m, {}).get('autoload', 'true')).lower() != 'false'
        label, what = KDED.get(m, (m.replace('kded_', '').replace('_', ' ').capitalize(), ''))
        out.append({'name': m, 'label': label, 'what': what, 'running': m in loaded, 'autoload': auto})
    return {'modules': out, 'kded': bool(loaded) or has_name('org.kde.kded6')}


def kded_set(name, on):
    if not re.match(r'^[A-Za-z0-9_.-]{1,80}$', name):
        raise Fail('bad module name')
    known = [m['name'] for m in kded()['modules']]
    if name not in known:
        raise Fail('%s isn\'t one of KDE\'s background services here' % name)
    kc.update(kc.user_path('kded5rc'), {'Module-' + name: {'autoload': bool(on)}})
    try:
        call('org.kde.kded6', '/kded', 'org.kde.kded6', 'loadModule' if on else 'unloadModule', '(s)', (name,))
        now = True
    except Fail:
        now = False
    hsio.log_event('kde: kded %s %s' % (name, 'on' if on else 'off'))
    return {'name': name, 'autoload': bool(on), 'now': now}


# ------------------------------------------------------------------ activities (kactivitymanagerd over D-Bus)
ACT = ('org.kde.ActivityManager', '/ActivityManager/Activities', 'org.kde.ActivityManager.Activities')


def activities():
    f = fixture('activities.json')
    if f is not None:
        return f
    if not has_name(ACT[0]):
        return {'running': False, 'list': []}
    try:
        ids = call(*ACT, 'ListActivities')[0]
        cur = call(*ACT, 'CurrentActivity')[0]
        return {'running': True, 'current': cur, 'list': [{'id': i, 'name': call(*ACT, 'ActivityName', '(s)', (i,))[0]} for i in ids]}
    except Fail as e:
        return {'running': False, 'list': [], 'error': str(e)}


def activity(op, a):
    if fixture_dir():
        return activities()
    if not has_name(ACT[0]):
        raise Fail("KDE's activities only run on KDE Plasma")
    if op == 'add':
        name = (a[0] if a else '').strip()[:80]
        if not name:
            raise Fail('An activity needs a name')
        call(*ACT, 'AddActivity', '(s)', (name,))
    elif op == 'rename':
        call(*ACT, 'SetActivityName', '(ss)', (a[0], a[1].strip()[:80]))
    elif op == 'remove':
        if len(activities()['list']) <= 1:
            raise Fail('The last activity stays')
        call(*ACT, 'RemoveActivity', '(s)', (a[0],))
    elif op == 'switch':
        call(*ACT, 'SetCurrentActivity', '(s)', (a[0],))
    hsio.log_event('kde: activity %s' % op)
    return activities()


# ------------------------------------------------------------------ your folders (xdg-user-dirs, as KDE's Locations page)
USERDIRS = [('DESKTOP', 'Desktop'), ('DOCUMENTS', 'Documents'), ('DOWNLOAD', 'Downloads'), ('MUSIC', 'Music'),
            ('PICTURES', 'Pictures'), ('VIDEOS', 'Videos'), ('PUBLICSHARE', 'Public'), ('TEMPLATES', 'Templates')]


def userdirs():
    f = fixture('userdirs.json')
    if f is not None:
        return f
    base = os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config')
    text = read(os.path.join(base, 'user-dirs.dirs'))
    home = os.path.expanduser('~')
    out = []
    for key, label in USERDIRS:
        m = re.search(r'^XDG_%s_DIR="(.*)"' % key, text, re.M)
        path = (m.group(1) if m else '$HOME/' + label).replace('$HOME', home)
        out.append({'key': key, 'label': label, 'path': path})
    return out


def userdir_set(key, path):
    if key not in dict(USERDIRS):
        raise Fail('%s is not one of your folders' % key)
    path = os.path.abspath(os.path.expanduser(path))
    if not os.path.isdir(path):
        raise Fail('%s is not a folder' % path)
    if fixture_dir():
        return userdirs()
    if not shutil.which('xdg-user-dirs-update'):
        raise Fail('xdg-user-dirs-update is not installed')
    code, out, err = run(['xdg-user-dirs-update', '--set', key, path], 10)
    if code != 0:
        raise Fail((err or out).strip()[:300] or 'It could not be changed')
    hsio.log_event('kde: folder %s -> %s' % (key, path))
    return userdirs()


# ------------------------------------------------------------------ device actions (Solid's .desktop files)
KINDS = [('StorageVolume', 'Drives'), ('OpticalDisc', 'Discs'), ('Camera', 'Cameras'), ('PortableMediaPlayer', 'Music players and phones'),
         ('StorageAccess', 'Drives'), ('Block', 'Drives')]


def action_dirs():
    return [os.path.join(d, 'solid/actions') for d in data_dirs()]


def parse_desktop(path):
    groups, g = {}, None
    for line in read(path).splitlines():
        line = line.strip()
        if line.startswith('[') and line.endswith(']'):
            g = line[1:-1]
            groups.setdefault(g, {})
        elif '=' in line and g is not None and not line.startswith('#'):
            k, v = line.split('=', 1)
            groups[g][k.strip()] = v.strip()
    return groups


def device_actions():
    f = fixture('deviceactions.json')
    if f is not None:
        return f
    user = action_dirs()[0]
    seen, out = set(), []
    for d in action_dirs():
        for p in sorted(glob.glob(os.path.join(d, '*.desktop'))):
            b = os.path.basename(p)
            if b in seen:
                continue
            seen.add(b)
            g = parse_desktop(p)
            de = g.get('Desktop Entry', {})
            if de.get('Hidden', '').lower() == 'true':
                continue
            pred = de.get('X-KDE-Solid-Predicate', '')
            kinds = sorted({label for k, label in KINDS if k in pred}) or ['Devices']
            for a in [x for x in de.get('Actions', '').split(';') if x]:
                da = g.get('Desktop Action ' + a, {})
                out.append({'file': b, 'name': da.get('Name', a), 'exec': da.get('Exec', ''), 'kinds': ', '.join(kinds),
                            'mine': p.startswith(user)})
    return out


def device_action_add(raw):
    try:
        a = json.loads(raw or '{}')
    except ValueError:
        raise Fail('expected JSON')
    name, cmd, kind = (a.get('name') or '').strip()[:80], (a.get('exec') or '').strip()[:400], a.get('kind', 'StorageVolume')
    if not name or not cmd or kind not in dict(KINDS) or '\n' in name + cmd:
        raise Fail('An action needs a name, a command and a kind of device')
    slug = re.sub(r'[^a-z0-9]+', '-', name.lower()).strip('-')[:40] or 'action'
    d = action_dirs()[0]
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, 'hearth-%s.desktop' % slug)
    if os.path.exists(path):
        raise Fail('There is already an action with that name')
    text = ('[Desktop Entry]\nX-KDE-Solid-Predicate=IS %s\nType=Service\nActions=open;\n\n'
            '[Desktop Action open]\nName=%s\nExec=%s\nIcon=system-run\n' % (kind, name, cmd))
    hsio.write_text(path, text)
    hsio.log_event('kde: device action %s' % name)
    return device_actions()


def device_action_remove(fname):
    if not re.match(r'^[A-Za-z0-9_.-]+\.desktop$', fname):
        raise Fail('bad name')
    path = os.path.join(action_dirs()[0], fname)
    if not os.path.isfile(path):
        raise Fail('Only actions you made can be removed')
    os.replace(path, path + '.bak')
    hsio.log_event('kde: device action removed %s (kept as .bak)' % fname)
    return device_actions()


def main(argv):
    c = argv[1] if len(argv) > 1 else ''
    a = argv[2:]
    if c == 'status':
        return status()
    if c == 'get' and len(a) == 1:
        return get(a[0])
    if c == 'set' and len(a) == 1:
        return set_file(a[0], os.environ.get('HEARTH_INPUT') or sys.stdin.read())
    if c == 'apply' and len(a) == 2:
        return apply_tool(a[0], a[1])
    if c == 'list' and len(a) == 1:
        return list_kind(a[0])
    if c == 'info' and len(a) == 1:
        return info_kind(a[0])
    if c == 'firmware':
        return firmware_get()
    if c == 'firmware-set' and len(a) == 1 and a[0] in ('on', 'off'):
        return firmware_set(a[0] == 'on')
    if c == 'kded':
        return kded()
    if c == 'kded-set' and len(a) == 2 and a[1] in ('on', 'off'):
        return kded_set(a[0], a[1] == 'on')
    if c == 'activities':
        return activities()
    if c == 'activity' and a and a[0] in ('add', 'rename', 'remove', 'switch'):
        return activity(a[0], a[1:])
    if c == 'userdirs':
        return userdirs()
    if c == 'userdir-set' and len(a) == 2:
        return userdir_set(a[0], a[1])
    if c == 'device-actions':
        return device_actions()
    if c == 'device-action-add':
        return device_action_add(os.environ.get('HEARTH_INPUT') or sys.stdin.read())
    if c == 'device-action-remove' and len(a) == 1:
        return device_action_remove(a[0])
    if c == 'allowlist':
        return {f: {g: sorted(k) for g, k in gs.items()} for f, gs in allowlist().items()}
    raise Fail(__doc__.split('\n\n')[2] if c in ('', '-h', '--help') else 'unknown command %s' % c)


if __name__ == '__main__':
    try:
        print(json.dumps(main(sys.argv)))
    except Fail as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
    except kc.BadFile as e:
        print(str(e), file=sys.stderr)
        sys.exit(1)
