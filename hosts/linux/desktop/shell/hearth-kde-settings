# ------------------------------------------------------------------ keyboard shortcuts (kglobalaccel, as KDE's Shortcuts)
QT_MODS = {'meta': 0x10000000, 'super': 0x10000000, 'ctrl': 0x04000000, 'control': 0x04000000, 'alt': 0x08000000, 'shift': 0x02000000}
QT_KEYS = {'space': 0x20, 'esc': 0x01000000, 'escape': 0x01000000, 'tab': 0x01000001, 'backtab': 0x01000002, 'backspace': 0x01000003,
           'return': 0x01000004, 'enter': 0x01000005, 'ins': 0x01000006, 'insert': 0x01000006, 'del': 0x01000007, 'delete': 0x01000007,
           'pause': 0x01000008, 'print': 0x01000009, 'sysreq': 0x0100000a, 'home': 0x01000010, 'end': 0x01000011, 'left': 0x01000012,
           'up': 0x01000013, 'right': 0x01000014, 'down': 0x01000015, 'pgup': 0x01000016, 'pageup': 0x01000016, 'pgdown': 0x01000017,
           'pagedown': 0x01000017, 'menu': 0x01000055, 'volume down': 0x01000070, 'volume mute': 0x01000071, 'volume up': 0x01000072,
           'media play': 0x01000080, 'media stop': 0x01000081, 'media previous': 0x01000082, 'media next': 0x01000083,
           'launch mail': 0x010000a0, 'calculator': 0x010000cb, 'monbrightnessup': 0x010000b2, 'monbrightnessdown': 0x010000b3}


def key_code(text):
    """'Meta+Shift+S' -> Qt's combined key code (QKeyCombination::toCombined)."""
    parts = [x for x in re.split(r'\+(?=.)', text.strip()) if x]
    if not parts:
        raise Fail('no key')
    code = 0
    for m in parts[:-1]:
        if m.lower() not in QT_MODS:
            raise Fail('%s is not Ctrl, Alt, Shift or Meta' % m)
        code |= QT_MODS[m.lower()]
    k = parts[-1]
    if len(k) == 1:
        c = ord(k.upper())
        if c > 0xff:
            raise Fail('%s can\'t be a shortcut key' % k)
        code |= c
    elif re.match(r'^F([1-9]|[1-2][0-9]|3[0-5])$', k, re.I):
        code |= 0x01000030 + int(k[1:]) - 1
    elif k.lower() in QT_KEYS:
        code |= QT_KEYS[k.lower()]
    else:
        raise Fail('%s is not a key Hearth knows' % k)
    return code


def split_keys(v):
    return [] if not v or v == 'none' else [x for x in v.split('\t') if x and x != 'none']


def shortcuts():
    f = fixture('shortcuts.json')
    if f is not None:
        return f
    try:
        values, _, _ = kc.effective('kglobalshortcutsrc')
    except kc.BadFile as e:
        return {'ok': False, 'why': "Your kglobalshortcutsrc couldn't be read (%s)" % e, 'components': []}
    comps = []
    for g, kv in sorted(values.items()):
        if g == kc.DEFAULT_GROUP:
            continue
        name = kv.get('_k_friendly_name') or g.split('][')[-1].replace('.desktop', '')
        acts = []
        for k, v in sorted(kv.items()):
            if k.startswith('_k_'):
                continue
            parts = v.split(',')
            if len(parts) >= 3:
                cur, dflt, friendly = parts[0], parts[1], ','.join(parts[2:])
            else:
                cur, dflt, friendly = v, '', k
            acts.append({'id': k, 'name': friendly or k, 'keys': split_keys(cur), 'default': split_keys(dflt)})
        if acts:
            comps.append({'id': g, 'name': name, 'actions': sorted(acts, key=lambda a: a['name'].lower())})
    comps.sort(key=lambda c: c['name'].lower())
    return {'ok': True, 'running': has_name('org.kde.kglobalaccel'), 'components': comps}


def shortcut_set(comp, action, keys_text):
    keys = split_keys(keys_text.replace(' / ', '\t'))
    codes = [key_code(k) for k in keys]
    sc = shortcuts()
    c = next((x for x in sc['components'] if x['id'] == comp), None)
    a = next((x for x in (c or {}).get('actions', []) if x['id'] == action), None)
    if a is None:
        raise Fail('That shortcut is not one of KDE\'s')
    for other in sc['components']:
        for oa in other['actions']:
            if (other['id'], oa['id']) != (comp, action) and set(oa['keys']) & set(keys):
                raise Fail('%s is already used by %s (%s): change that one first' % (', '.join(set(oa['keys']) & set(keys)), oa['name'], other['name']))
    set_keys([comp.split('][')[-1], action, c['name'], a['name']], '\t'.join(keys))
    return {'ok': True}


def set_keys(ident, keys_text):
    """Gives KDE's shortcut service (kglobalaccel) the keys for one action: [component, action, their names]."""
    keys = split_keys(keys_text)
    codes = [key_code(k) for k in keys]
    if fixture_dir():
        return
    if not has_name('org.kde.kglobalaccel'):
        raise Fail("KDE's shortcuts can only be changed on KDE Plasma (its shortcut service isn't running here)")
    from gi.repository import GLib
    try:
        bus().call_sync('org.kde.kglobalaccel', '/kglobalaccel', 'org.kde.KGlobalAccel', 'setForeignShortcutKeys',
                        GLib.Variant('(asa(ai))', (ident, [[x] for x in codes])), None, 0, 4000, None)
    except Exception as e:
        raise Fail('The shortcut wasn\'t changed: %s' % (str(e).split(':')[-1].strip() or e))
    hsio.log_event('kde: shortcut %s / %s = %s' % (ident[0], ident[1], keys_text))


# Your own commands with a shortcut, as KDE's Shortcuts page makes them ("Add New › Command or Script"): an app file
# net.local.<name>.desktop in your applications folder with X-KDE-GlobalAccel-CommandShortcut=true, its keys given to
# kglobalaccel for that file's "_launch".
def apps_dir():
    return os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'), 'applications')


def commands():
    f = fixture('commands.json')
    if f is not None:
        return f
    try:
        values, _, _ = kc.effective('kglobalshortcutsrc')
    except kc.BadFile:
        values = {}
    out = []
    for p in sorted(glob.glob(os.path.join(apps_dir(), 'net.local.*.desktop'))):
        g = parse_desktop(p).get('Desktop Entry', {})
        if g.get('X-KDE-GlobalAccel-CommandShortcut', '').lower() != 'true':
            continue
        b = os.path.basename(p)
        v = values.get('services][' + b, {}).get('_launch', '')
        out.append({'file': b, 'name': g.get('Name', b), 'exec': g.get('Exec', ''), 'keys': split_keys(v.split(',')[0]) if v else []})
    return out


def command_set(raw):
    try:
        a = json.loads(raw or '{}')
    except ValueError:
        raise Fail('expected JSON')
    name, cmd, keys = (a.get('name') or '').strip()[:80], (a.get('exec') or '').strip()[:500], (a.get('keys') or '').strip()
    if not name or not cmd or '\n' in name + cmd:
        raise Fail('A command needs a name and what it runs')
    fname = a.get('file') or ''
    if fname:
        if not re.match(r'^net\.local\.[A-Za-z0-9_.-]+\.desktop$', fname):
            raise Fail('bad command')
    else:
        slug = re.sub(r'[^a-z0-9]+', '-', cmd.split()[0].rsplit('/', 1)[-1].lower()).strip('-') or 'command'
        fname = 'net.local.%s.desktop' % slug
        n = 1
        while os.path.exists(os.path.join(apps_dir(), fname)):
            n += 1
            fname = 'net.local.%s-%d.desktop' % (slug, n)
    for k in split_keys(keys):
        key_code(k)
    path = os.path.join(apps_dir(), fname)
    os.makedirs(apps_dir(), exist_ok=True)
    text = ('[Desktop Entry]\nType=Application\nName=%s\nExec=%s\nNoDisplay=true\nX-KDE-GlobalAccel-CommandShortcut=true\n'
            % (name, cmd))
    hsio.write_text(path, text)
    set_keys([fname, '_launch', name, name], keys)
    hsio.log_event('kde: command shortcut %s' % fname)
    return commands()


def command_keys(fname, keys):
    if not re.match(r'^net\.local\.[A-Za-z0-9_.-]+\.desktop$', fname):
