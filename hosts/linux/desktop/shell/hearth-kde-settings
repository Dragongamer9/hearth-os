# ------------------------------------------------------------------ fonts (KDE's Font Management)
FONT_EXT = ('.ttf', '.otf', '.ttc', '.otc', '.pfb', '.pfa', '.woff', '.woff2', '.pcf', '.bdf')


def font_dir():
    return os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'), 'fonts')


def reject_conf():
    base = os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config')
    return os.path.join(base, 'fontconfig', 'conf.d', '90-hearth-fonts-turned-off.conf')


def turned_off():
    return re.findall(r'<glob>(.*?)</glob>', read(reject_conf()))


def fonts():
    f = fixture('fonts.json')
    if f is not None:
        return f
    mine = font_dir()
    code, out, _ = run(['fc-list', '-f', '%{family[0]}|%{style[0]}|%{file}\\n'], 20) if shutil.which('fc-list') else (1, '', '')
    families, user, files = set(), [], {}
    for line in out.splitlines():
        parts = line.split('|')
        if len(parts) != 3:
            continue
        families.add(parts[0])
        # One file per family for its preview: the regular one when there is one.
        if parts[0] not in files or parts[1].lower() in ('regular', 'book', 'roman'):
            files[parts[0]] = parts[2]
        if parts[2].startswith(mine) or parts[2].startswith(os.path.expanduser('~/.fonts')):
            user.append({'family': parts[0], 'style': parts[1], 'file': parts[2], 'off': False})
    off = turned_off()
    for g in off:
        if os.path.exists(g) and not any(u['file'] == g for u in user):
            user.append({'family': os.path.basename(g), 'style': '', 'file': g, 'off': True})
    for u in user:
        u['off'] = u['file'] in off
    return {'yours': sorted(user, key=lambda u: (u['family'], u['style'])), 'families': sorted(families), 'count': len(families),
            'files': files}


def fc_cache():
    if shutil.which('fc-cache'):
        run(['fc-cache', '-f', font_dir()], 120)


def font_install(path):
    path = os.path.abspath(path)
    if not os.path.isfile(path) or not path.lower().endswith(FONT_EXT):
        raise Fail('%s is not a font file' % os.path.basename(path))
    if fixture_dir():
        return fonts()
    d = font_dir()
    os.makedirs(d, exist_ok=True)
    dest = os.path.join(d, os.path.basename(path))
    if os.path.exists(dest):
        raise Fail('%s is already installed' % os.path.basename(path))
    tmp = dest + '.part'
    shutil.copyfile(path, tmp)
    os.replace(tmp, dest)
    fc_cache()
    hsio.log_event('kde: font installed %s' % os.path.basename(path))
    return fonts()


def font_remove(path):
    path = os.path.abspath(path)
    if not path.startswith(font_dir() + os.sep) or not os.path.isfile(path):
        raise Fail('Only fonts you installed can be removed')
    if fixture_dir():
        return fonts()
    keep = os.path.join(font_dir(), '.removed')
    os.makedirs(keep, exist_ok=True)
    os.replace(path, os.path.join(keep, os.path.basename(path)))
    fc_cache()
    hsio.log_event('kde: font removed %s (kept in %s)' % (os.path.basename(path), keep))
    return fonts()


def font_off(path, off):
    path = os.path.abspath(path)
    cur = [g for g in turned_off() if g != path]
    if off:
        cur.append(path)
    if fixture_dir():
        return fonts()
    esc = lambda x: x.replace('&', '&amp;').replace('<', '&lt;').replace('>', '&gt;')
    text = ('<?xml version="1.0"?>\n<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">\n'
            '<!-- Hearth Settings > Font management: fonts you turned off (every app leaves them out). -->\n<fontconfig>\n'
            '  <selectfont>\n    <rejectfont>\n' + ''.join('      <glob>%s</glob>\n' % esc(g) for g in cur) +
            '    </rejectfont>\n  </selectfont>\n</fontconfig>\n')
    os.makedirs(os.path.dirname(reject_conf()), exist_ok=True)
    hsio.write_text(reject_conf(), text)
    fc_cache()
    hsio.log_event('kde: font %s %s' % ('off' if off else 'on', os.path.basename(path)))
    return fonts()


# ------------------------------------------------------------------ colour profiles (colord, as KDE's Color Management)
def colormgr(args, secs=10):
    if not shutil.which('colormgr'):
        raise Fail('Colour management (colord) is not installed')
    code, out, err = run(['colormgr'] + args, secs)
    if code != 0:
        raise Fail((err or out).strip()[:300] or 'colord did not answer')
    return out


def blocks(text):
    out, cur = [], {}
    for line in text.splitlines():
        if not line.strip():
            if cur:
                out.append(cur)
                cur = {}
            continue
        if ':' in line:
            k, v = line.split(':', 1)
            k = k.strip()
            if k.startswith('Profile '):
                cur.setdefault('profiles', []).append(v.strip())
            else:
                cur[k] = v.strip()
    if cur:
        out.append(cur)
    return out


def colord():
    f = fixture('colord.json')
    if f is not None:
        return f
    try:
        devs = blocks(colormgr(['get-devices']))
        profs = blocks(colormgr(['get-profiles']))
    except Fail as e:
        return {'ok': False, 'why': str(e), 'devices': [], 'profiles': []}
    devices = [{'path': d.get('Object Path', ''), 'kind': d.get('Kind', ''), 'name': ' '.join(x for x in (d.get('Vendor', ''), d.get('Model', '')) if x) or d.get('Device ID', ''),
                'profiles': [p.split(' ')[0] for p in d.get('profiles', [])]} for d in devs]
    profiles = [{'path': p.get('Object Path', ''), 'title': p.get('Title', '') or os.path.basename(p.get('Filename', '')), 'file': p.get('Filename', '')} for p in profs]
    return {'ok': True, 'devices': devices, 'profiles': profiles}


def colord_default(dev, prof):
    if not (dev.startswith('/org/freedesktop/ColorManager/') and prof.startswith('/org/freedesktop/ColorManager/')):
        raise Fail('bad device or profile')
    if fixture_dir():
        return colord()
    cur = next((d for d in colord()['devices'] if d['path'] == dev), None)
    if cur is None:
        raise Fail('That device is gone')
    if prof not in cur['profiles']:
        colormgr(['device-add-profile', dev, prof])
    colormgr(['device-make-profile-default', dev, prof])
    hsio.log_event('kde: colour profile %s for %s' % (prof, dev))
    return colord()


def colord_import(path):
    path = os.path.abspath(path)
    if not os.path.isfile(path) or not path.lower().endswith(('.icc', '.icm')):
        raise Fail('%s is not a colour profile (.icc)' % os.path.basename(path))
