def ensure_units():
    """Writes the unit files only when they're missing or different, then reloads systemd --user."""
    changed = False
    os.makedirs(UNIT_DIR, exist_ok=True)
    for name, text in unit_texts().items():
        p = os.path.join(UNIT_DIR, name)
        try:
            with open(p) as f:
                if f.read() == text:
                    continue
        except OSError:
            pass
        sio.write_text(p, text)
        changed = True
    if changed:
        cmd(['systemctl', '--user', 'daemon-reload'], 30)
    return changed


def unit(aid):
    return 'hearth-app@%s.service' % aid


def timer(aid):
    return 'hearth-app@%s.timer' % aid


def unit_state(aid):
    """active, failed or inactive (systemctl --user is-active)."""
    code, o = cmd(['systemctl', '--user', 'is-active', unit(aid)], 10)
    st = o.strip().splitlines()[0] if o.strip() else ''
    return st if st in ('active', 'activating', 'failed', 'deactivating') else 'inactive'


