def settings():
    """Your choices with the defaults filled in (never saved). A damaged file is put back from its .bak."""
    raw = sio.load_json(SETTINGS, {})
    s = sio.with_defaults(raw if isinstance(raw, dict) else {}, DEFAULTS)
    apps = s.get('apps') if isinstance(s.get('apps'), dict) else {}
    s['apps'] = {k: app_cfg(apps.get(k), k) for k in CATALOG}
    s['ntfy'] = sio.with_defaults(s['ntfy'] if isinstance(s.get('ntfy'), dict) else {}, NTFY_DEFAULT)
    s['worlds'] = worlds_cfg(s.get('worlds'))
    return s


def app_cfg(v, aid):
    v = sio.with_defaults(v if isinstance(v, dict) else {}, APP_DEFAULT)
    if v.get('reach') not in ('home', 'tailscale'):
        v['reach'] = CATALOG[aid]['reach']
    opts = v.get('opts') if isinstance(v.get('opts'), dict) else {}
    v['opts'] = {k: (opts[k] if k in opts and opt_ok(CATALOG[aid]['opts'][k], opts[k]) else o['default'])
                 for k, o in CATALOG[aid]['opts'].items()}
    v['on'] = v.get('on') is True
    v['eula'] = v.get('eula') is True
    return v


def save_app(aid, key, value):
    """Only that key of that app is written, under the lock (and only when it's different from what you have)."""
    def change(d):
        apps = d.get('apps') if isinstance(d.get('apps'), dict) else {}
        cur = dict(apps.get(aid)) if isinstance(apps.get(aid), dict) else {}
        if key.startswith('opts.'):
            o = dict(cur.get('opts')) if isinstance(cur.get('opts'), dict) else {}
            o[key[5:]] = value
            cur['opts'] = o
        else:
            cur[key] = value
        apps[aid] = cur
        d['apps'] = apps
    sio.update_json(SETTINGS, change)


def save_ntfy(key, value):
    def change(d):
        n = dict(d.get('ntfy')) if isinstance(d.get('ntfy'), dict) else {}
        n[key] = value
        d['ntfy'] = n
    sio.update_json(SETTINGS, change)


def state():
    v = sio.load_json(STATE, {}, repair=False) if os.path.exists(STATE) else {}
    return v if isinstance(v, dict) else {}


def state_set(name, **kw):
    def change(d):
        cur = dict(d.get(name)) if isinstance(d.get(name), dict) else {}
        cur.update(kw)
        d[name] = cur
    sio.update_json(STATE, change)


def secrets_read():
    try:
        with open(SECRETS) as f:
            v = json.load(f)
        return v if isinstance(v, dict) else {}
    except (OSError, ValueError):
        return {}


def secret_set(aid, key, value):
    os.makedirs(os.path.dirname(SECRETS), exist_ok=True)
    with sio.locked(SECRETS):
        d = secrets_read()
        cur = dict(d.get(aid)) if isinstance(d.get(aid), dict) else {}
        if value:
            cur[key] = value
        else:
            cur.pop(key, None)
        d[aid] = cur
        sio.write_text(SECRETS, json.dumps(d, indent=2) + '\n', mode=0o600)


def opt_ok(o, v):
    if not isinstance(v, str):
        return False
    if 'choices' in o:
        return v in o['choices']
    if o.get('text'):
        return _text(v)
    if o.get('folder'):
        p = os.path.expanduser(v)
        return v.startswith(('~/', '/')) and '..' not in v.split('/') and len(v) < 300 and not p.startswith(('/proc', '/sys', '/dev', '/etc', '/boot'))
    return False


def app_or_fail(aid):
    if aid not in CATALOG:
        raise Fail('Not in the catalog: ' + str(aid)[:40])
    return CATALOG[aid]


