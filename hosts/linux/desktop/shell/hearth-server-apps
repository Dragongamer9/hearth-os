def cmd(args, timeout=60, env=None):
    """(exit code, output) of a command as you; never a shell. Tests replace this."""
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=env, stdin=subprocess.DEVNULL)
        return p.returncode, (p.stdout or '') + (p.stderr or '')
    except (OSError, subprocess.SubprocessError) as e:
        return 127, str(e)


def have(name):
    """Whether a program is on this PC. Tests replace this."""
