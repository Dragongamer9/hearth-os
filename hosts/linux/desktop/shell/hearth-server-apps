def horizon_game_files(home=None):
    """The newest game files Horizon's launcher prepared from your own Minecraft: (folder, game version) or (None, None).
    They're in ~/.local/share/horizon-launcher/versions/<version>/.local/horizon-client/<game version>."""
    root = os.path.join(home or HOME, '.local', 'share', 'horizon-launcher', 'versions')
    found = []
    try:
        for v in os.listdir(root):
            base = os.path.join(root, v, '.local', 'horizon-client')
            for g in (os.listdir(base) if os.path.isdir(base) else []):
                d = os.path.join(base, g)
                m = os.path.join(d, 'horizon-resources.json')
                if os.path.isfile(m):
                    found.append((os.path.getmtime(m), d, g))
    except OSError:
        pass
    if not found:
        return None, None
    found.sort()
    return found[-1][1], found[-1][2]


def _https_get(url, limit, timeout=60, dest=None, progress=None):
    """An https download from GitHub only (redirects too): bytes, or the file written to dest and its SHA-256."""
    import hashlib
    import urllib.parse

    def ok(u):
        u = urllib.parse.urlparse(u)
        return u.scheme == 'https' and u.hostname in HORIZON_HOSTS

    class Only(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            if not ok(newurl):
                raise Fail('a download tried to go somewhere else (%s): stopped' % urllib.parse.urlparse(newurl).hostname)
            return super().redirect_request(req, fp, code, msg, headers, newurl)
    if not ok(url):
        raise Fail('not an allowed address')
    req = urllib.request.Request(url, headers={'User-Agent': 'Hearth-OS-server-apps', 'Accept': 'application/vnd.github+json'})
    h = hashlib.sha256()
    got = 0
    chunks = []
    try:
        with urllib.request.build_opener(Only).open(req, timeout=timeout) as r:
            total = int(r.headers.get('Content-Length') or 0)
            f = open(dest, 'wb') if dest else None
            try:
                while True:
                    c = r.read(1 << 20)
                    if not c:
                        break
                    got += len(c)
                    if got > limit:
                        raise Fail('the download was bigger than expected')
                    h.update(c)
                    if f:
                        f.write(c)
                    else:
                        chunks.append(c)
                    if progress and total:
                        progress(got, total)
            finally:
                if f:
                    f.close()
    except (OSError, urllib.error.URLError) as e:
        raise Fail('couldn\'t download from %s (%s)' % (url.split('/')[2], e))
    return h.hexdigest() if dest else b''.join(chunks)


def horizon_release(get=None):
    """Horizon's current server build, as its own installer picks it: the Nightly, else the latest release. Returns
    {tag, signed_as, url, digest, sums_url, sig_url}."""
    get = get or (lambda u: _https_get(u, 8 << 20))
    rel = None
    for path in ('tags/nightly', 'latest'):
        try:
            rel = json.loads(get('https://api.github.com/repos/%s/releases/%s' % (HORIZON_REPO, path)).decode('utf-8', 'replace'))
            break
        except (Fail, ValueError):
            continue
    if not isinstance(rel, dict) or not rel.get('tag_name'):
        raise Fail('couldn\'t find Horizon\'s newest release')
    tag = str(rel['tag_name'])
    assets = {a.get('name'): a for a in rel.get('assets') or [] if isinstance(a, dict)}
    a = assets.get(HORIZON_ASSET)
    if not a:
        raise Fail('Horizon\'s newest release (%s) has no server build for this PC' % tag[:40])
    signed_as, sig = tag, 'SHA256SUMS.sig'
    if tag == 'nightly' or tag.startswith('nightly-'):
        m = re.match(r'^Nightly (\d{4}-\d{2}-\d{2}) · ([0-9a-f]{7,40})$', str(rel.get('name') or ''))
        if not m:
            raise Fail('this Horizon Nightly\'s title doesn\'t name its date and commit, so its signature can\'t be checked')
        signed_as, sig = 'nightly-%s-%s' % m.groups(), 'SHA256SUMS.v2.sig'
    dg = str(a.get('digest') or '')
    return {'tag': signed_as, 'url': a.get('browser_download_url'), 'digest': dg[7:].lower() if dg.startswith('sha256:') else '',
            'sums_url': (assets.get('SHA256SUMS') or {}).get('browser_download_url'),
            'sig_url': (assets.get(sig) or {}).get('browser_download_url')}


def ed25519_ok(message, sig_lines, keys=None):
    """Whether one of the signature lines (base64) verifies message with one of Horizon's keys (OpenSSL 3)."""
    import base64
    keys = HORIZON_KEYS if keys is None else keys
    with tempfile.TemporaryDirectory() as t:
        mf = os.path.join(t, 'message')
        with open(mf, 'wb') as f:
            f.write(message)
        for k in keys:
            kf = os.path.join(t, 'key.der')
            with open(kf, 'wb') as f:
                f.write(ED25519_SPKI + base64.b64decode(k))
            for line in sig_lines:
                line = line.strip()
                if not line:
                    continue
                sf = os.path.join(t, 'sig')
                try:
                    with open(sf, 'wb') as f:
                        f.write(base64.b64decode(line))
                except ValueError:
                    continue
                if cmd(['openssl', 'pkeyutl', '-verify', '-rawin', '-pubin', '-keyform', 'DER', '-inkey', kf, '-in', mf,
                        '-sigfile', sf], 30)[0] == 0:
                    return True
    return False


def horizon_expected_sha(rel, get=None):
    """The SHA-256 the server build must have: from Horizon's signed SHA256SUMS (checked against its release key), else
    nothing: an unsigned build isn't installed."""
    get = get or (lambda u: _https_get(u, 1 << 20))
    if not rel.get('sums_url') or not rel.get('sig_url'):
        raise Fail('Horizon\'s release %s has no signed checksums: not installed' % rel['tag'][:40])
    if not have('openssl'):
        raise Fail('OpenSSL isn\'t on this PC, so Horizon\'s release signature can\'t be checked: not installed')
    sums = get(rel['sums_url'])
    sig = get(rel['sig_url']).decode('ascii', 'replace').splitlines()
    if not ed25519_ok(('horizon release %s\n' % rel['tag']).encode() + sums, sig):
        raise Fail('Horizon\'s SHA256SUMS signature doesn\'t match its release key: not installed')
    for line in sums.decode('utf-8', 'replace').splitlines():
        f = line.split()
        if len(f) >= 2 and f[1].lstrip('*') == HORIZON_ASSET and re.fullmatch(r'[0-9a-f]{64}', f[0]):
            if rel.get('digest') and rel['digest'] != f[0]:
                raise Fail('Horizon\'s two checksums for its server build don\'t agree: not installed')
            return f[0]
    raise Fail('Horizon\'s signed SHA256SUMS doesn\'t list its server build: not installed')


def tar_safe(listing):
    """An archive listing (tar -tzvf) with nothing outside its own folder and no devices."""
    for line in (listing or '').splitlines():
        if not line.strip():
            continue
        if line[0] not in '-dlh':
            return False
        parts = line.split(None, 5)
        if len(parts) < 6:
            return False
        nm = parts[5].split(' -> ')[0].split(' link to ')[0].strip()
        if nm.startswith('/') or '..' in nm.split('/'):
            return False
        if ' -> ' in parts[5] and (parts[5].split(' -> ', 1)[1].startswith('/') or '..' in parts[5].split(' -> ', 1)[1].split('/')):
            return False
    return True


def engine_install(aid, progress=None):
    """Horizon's server build: found, its signature and checksum checked, unpacked beside the old one, then swapped in."""
    rel = horizon_release()
    want = horizon_expected_sha(rel)
    root = engine_dir(aid)
    os.makedirs(os.path.join(root, 'releases'), exist_ok=True)
    tmp = tempfile.mkdtemp(prefix='.download-', dir=root)
    try:
        f = os.path.join(tmp, HORIZON_ASSET)
        got = _https_get(rel['url'], 512 << 20, timeout=120, dest=f, progress=progress)
        if got != want:
            raise Fail('Horizon\'s download doesn\'t match its signed checksum: not installed')
        code, listing = cmd(['tar', '-tzvf', f], 300)
        if code != 0 or not tar_safe(listing):
            raise Fail('Horizon\'s archive isn\'t safe to unpack: not installed')
        x = os.path.join(tmp, 'x')
        os.makedirs(x)
        code, o = cmd(['tar', '-xzf', f, '-C', x, '--no-same-owner', '--no-same-permissions'], 600)
        if code != 0:
            raise Fail('Horizon couldn\'t be unpacked: ' + o.strip()[-160:])
        src = next((dp for dp, _dn, fn in os.walk(x) if 'horizon-server' in fn), None)
        if not src or not all(os.path.isfile(os.path.join(src, b)) for b in ('horizon-server', 'horizon-engine')):
            raise Fail('Horizon\'s archive has no server (horizon-server and horizon-engine)')
        for b in ('horizon-server', 'horizon-engine', 'horizon-prepare'):
            if os.path.isfile(os.path.join(src, b)):
                os.chmod(os.path.join(src, b), 0o755)
        # Where the game files are mounted (read-only) inside the read-only engine folder.
        os.makedirs(os.path.join(src, '.local', 'horizon-client'), exist_ok=True)
        dest = os.path.join(root, 'releases', re.sub(r'[^\w.-]', '_', rel['tag'])[:80])
        if os.path.isdir(dest):
            shutil.rmtree(dest)
        os.rename(src, dest)
        link = os.path.join(root, 'current')
        prev = os.path.realpath(link) if os.path.lexists(link) else ''
        tmp_link = link + '.new'
        if os.path.lexists(tmp_link):
            os.remove(tmp_link)
        os.symlink(os.path.relpath(dest, root), tmp_link)
        os.replace(tmp_link, link)
        for old in os.listdir(os.path.join(root, 'releases')):        # the new one and the one before it stay
            p = os.path.join(root, 'releases', old)
            if os.path.realpath(p) not in (os.path.realpath(dest), prev):
                shutil.rmtree(p, ignore_errors=True)
        return rel['tag']
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def ts_ip4():
    if not have('tailscale'):
        return ''
    code, o = cmd(['tailscale', 'ip', '-4'], 8)
    ip = o.strip().splitlines()[0].strip() if code == 0 and o.strip() else ''
    return ip if TS_IP_RE.fullmatch(ip) else ''


def lan_ip():
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(('192.0.2.1', 9))
        ip = s.getsockname()[0]
        s.close()
        return ip
    except OSError:
        return ''


def data_dir(aid, sub=''):
    d = os.path.join(DATA_ROOT, CATALOG[aid]['name'])
    return os.path.join(d, sub) if sub else d


def name(aid):
    return 'hearth-app-' + aid


def port_args(aid, reach, ts_ip):
    """-p for each port: everywhere for 'home', 127.0.0.1 and the Tailscale address only for 'tailscale'."""
    args = []
    for p in CATALOG[aid]['ports']:
        host, proto = p[0], p[1]
        inner = p[2] if len(p) > 2 else host
        if reach == 'home':
            args += ['-p', '%d:%d/%s' % (host, inner, proto)]
        else:
            for a in ['127.0.0.1'] + ([ts_ip] if ts_ip else []):
                args += ['-p', '%s:%d:%d/%s' % (a, host, inner, proto)]
    return args


def env_for(aid, cfg, sec):
    a = CATALOG[aid]
    env = dict(a.get('env') or {})
    for k, o in a['opts'].items():
        if o.get('env'):
            v = cfg['opts'][k]
            env[o['env']] = (o.get('map') or {}).get(v, v)
    pw = a.get('password')
    if pw and pw.get('env') and sec.get('password'):
        env[pw['env']] = sec['password']
    if aid == 'immich':
        env['DB_PASSWORD'] = sec.get('db', '')
    if aid == 'vaultwarden':
        env['ROCKET_PORT'] = '80'
    if aid == 'palworld':
        env['PORT'] = '8211'
    return env


def env_file(aid, env):
    """A 0600 file in your runtime folder: passwords never go on a command line (anyone can read those)."""
    rt = os.path.join(os.environ.get('XDG_RUNTIME_DIR') or tempfile.gettempdir(), 'hearth-server-apps')
    os.makedirs(rt, mode=0o700, exist_ok=True)
    p = os.path.join(rt, aid + '.env')
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        for k, v in sorted(env.items()):
            f.write('%s=%s\n' % (k, str(v).replace('\n', ' ')))
    return p


def run_argv(aid, cfg=None, sec=None, ts_ip=None):
    """The podman run line for an app's main container (tests check it)."""
    a = app_or_fail(aid)
    cfg = cfg or settings()['apps'][aid]
    sec = secrets_read().get(aid) or {} if sec is None else sec
    ts_ip = ts_ip4() if ts_ip is None else ts_ip
    argv = ['podman', 'run', '--rm', '--replace', '--name', name(aid), '--pull=never', '--label', 'hearth.app=' + aid,
            '--security-opt', 'no-new-privileges', '--stop-timeout', str(a.get('stopTimeout') or 30)]
    if a.get('pod'):
        argv += ['--pod', name(aid) + '-pod']
    else:
        argv += port_args(aid, cfg['reach'], ts_ip)
    for sub, inner in a['volumes']:
        if aid == 'immich' and sub == 'database':
            continue
        argv += ['-v', '%s:%s:Z' % (data_dir(aid, sub), inner)]
    for k, o in a['opts'].items():
        if o.get('folder'):
            argv += ['-v', '%s:%s:ro' % (os.path.expanduser(cfg['opts'][k]), o['mount'])]
    if a.get('engine'):
        # The engine and your own prepared game files, both read-only (Horizon finds them beside its program).
        argv += ['-v', '%s:/opt/horizon:ro' % os.path.realpath(os.path.join(engine_dir(aid), 'current'))]
        gf, gv = horizon_game_files()
        if gf:
            argv += ['-v', '%s:/opt/horizon/.local/horizon-client/%s:ro' % (gf, gv)]
    argv += ['--env-file', '@ENV@', a['images'][0]] + list(a.get('args') or [])
    if aid == 'terraria':
        w = '/root/.local/share/Terraria/Worlds/%s.wld' % cfg['opts']['worldName'].replace(' ', '_')
        argv += ['-world', w, '-autocreate', cfg['opts']['worldSize'], '-worldname', cfg['opts']['worldName']]
    return argv


def run(aid):
    """hearth-app@ID.service: the app in the foreground (exec), so systemd sees it stop."""
    a = app_or_fail(aid)
    s = settings()
    cfg = s['apps'][aid]
    if not cfg['on']:
        raise Fail('%s is off (Settings › Home server › Server apps)' % a['name'])
    if a.get('eula') and not cfg['eula']:
        raise Fail('Accept Minecraft\'s EULA first')
    if a.get('engine') and not horizon_game_files()[0]:
        raise Fail('Horizon needs the game files from your own Minecraft: open Horizon once from Hearth Games (it prepares them), then turn this on again')
    sec = secrets_read().get(aid) or {}
    pw = a.get('password')
    if pw and pw.get('required') and len(sec.get('password') or '') < pw['min']:
        raise Fail('%s needs a password of at least %d characters' % (a['name'], pw['min']))
    for sub, _ in a['volumes']:
        os.makedirs(data_dir(aid, sub), exist_ok=True)
    ts_ip = ts_ip4()
    argv = run_argv(aid, cfg, sec, ts_ip)
    argv[argv.index('@ENV@')] = env_file(aid, env_for(aid, cfg, sec))
    state_set(aid, listen=['0.0.0.0'] if cfg['reach'] == 'home' else ['127.0.0.1'] + ([ts_ip] if ts_ip else []), started=int(time.time()))
    if a.get('pod'):
        pod = name(aid) + '-pod'
        cmd(['podman', 'pod', 'rm', '-f', '--ignore', pod], 60)
        code, o = cmd(['podman', 'pod', 'create', '--name', pod] + port_args(aid, cfg['reach'], ts_ip), 60)
        if code != 0:
            raise Fail('Couldn\'t make its pod: ' + o.strip()[-200:])
        imgs = a['images']
        code, o = cmd(['podman', 'run', '-d', '--rm', '--name', name(aid) + '-db', '--pod', pod, '--pull=never',
                       '-e', 'POSTGRES_USER=immich', '-e', 'POSTGRES_DB=immich', '--env-file', db_env(sec),
                       '-v', '%s:/var/lib/postgresql/data:Z' % data_dir(aid, 'database'), imgs[1]], 120)
        if code != 0:
            raise Fail('Its database didn\'t start: ' + o.strip()[-200:])
        code, o = cmd(['podman', 'run', '-d', '--rm', '--name', name(aid) + '-redis', '--pod', pod, '--pull=never', imgs[2]], 60)
        if code != 0:
            raise Fail('Its cache didn\'t start: ' + o.strip()[-200:])
    os.execvp('podman', argv)


def db_env(sec):
    rt = os.path.join(os.environ.get('XDG_RUNTIME_DIR') or tempfile.gettempdir(), 'hearth-server-apps')
    os.makedirs(rt, mode=0o700, exist_ok=True)
    p = os.path.join(rt, 'immich-db.env')
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w') as f:
        f.write('POSTGRES_PASSWORD=%s\n' % sec.get('db', ''))
    return p


def stop(aid):
    app_or_fail(aid)
    cmd(['podman', 'stop', '--ignore', '-t', '30', name(aid)], 60)
    if CATALOG[aid].get('pod'):
        cmd(['podman', 'pod', 'rm', '-f', '--ignore', name(aid) + '-pod'], 90)
    return {'ok': True}


# ------------------------------------------------------------------ world backups (1.13)
# What holds each game server's world (a volume, and a folder in it; the servers' own program files are left out).
WORLDS = {'minecraft': ('world', ''), 'horizon': ('world', ''), 'valheim': ('config', ''), 'terraria': ('worlds', ''),
          'palworld': ('server', 'Pal/Saved')}
TIME_RE = re.compile(r'^([01]\d|2[0-3]):[0-5]\d$')
BACKUP_RE = re.compile(r'^(\d{4}-\d{2}-\d{2} \d{4})( [a-z -]{1,40})?\.tar\.gz$')


def worlds_cfg(v):
    v = sio.with_defaults(v if isinstance(v, dict) else {}, WORLDS_DEFAULT)
    v['on'] = v.get('on') is not False
    v['at'] = v['at'] if isinstance(v.get('at'), str) and TIME_RE.match(v['at']) else WORLDS_DEFAULT['at']
    v['keep'] = v['keep'] if isinstance(v.get('keep'), int) and 1 <= v['keep'] <= 90 else WORLDS_DEFAULT['keep']
    return v


def settings_raw_worlds():
    raw = sio.load_json(SETTINGS, {}) if os.path.exists(SETTINGS) else {}
    return raw.get('worlds') if isinstance(raw, dict) else {}


def world_dir(aid):
    return os.path.join(DATA_ROOT, 'World backups', CATALOG[aid]['name'])


def world_source(aid):
    vol, sub = WORLDS[aid]
    return data_dir(aid, vol), sub


def world_list(aid):
    d = world_dir(aid)
    out = []
    try:
        names = os.listdir(d)
    except OSError:
        names = []
    for n in names:
        m = BACKUP_RE.match(n)
        if not m:
            continue
        p = os.path.join(d, n)
        try:
            st = os.stat(p)
        except OSError:
            continue
        out.append({'file': n, 'at': int(st.st_mtime), 'why': (m.group(2) or '').strip() or 'nightly', 'size': st.st_size})
    out.sort(key=lambda b: b['at'], reverse=True)
    return out


def world_prune(aid, keep_days, now=None):
    """Backups older than the days you keep go; the newest always stays, whatever its age."""
    now = time.time() if now is None else now
    gone = 0
    for b in world_list(aid)[1:]:
        if now - b['at'] > keep_days * 86400:
            try:
                os.remove(os.path.join(world_dir(aid), b['file']))
                gone += 1
            except OSError:
                pass
    return gone


def world_stop(aid):
    """Stopped cleanly (the server saves the world as it stops); True when it was running."""
    was = unit_state(aid) in ('active', 'activating')
    if was:
        cmd(['systemctl', '--user', 'stop', unit(aid)], 120)
    return was


def world_backup(aid, why='nightly', now=None):
    """The world (stopped cleanly first, started again after) into ~/Server apps/World backups/<game>/."""
    if aid not in WORLDS:
        raise Fail('%s has no world to back up' % CATALOG.get(aid, {}).get('name', aid))
    src, sub = world_source(aid)
    if not os.path.isdir(os.path.join(src, sub) if sub else src):
        return {'ok': True, 'skipped': 'no world yet'}
    now = time.time() if now is None else now
    os.makedirs(world_dir(aid), exist_ok=True)
    name_ = time.strftime('%Y-%m-%d %H%M', time.localtime(now)) + ('' if why == 'nightly' else ' ' + re.sub(r'[^a-z -]', '', why.lower())[:40]) + '.tar.gz'
    dest = os.path.join(world_dir(aid), name_)
    tmp = dest + '.part'
    was = world_stop(aid)
    try:
        # podman unshare: the server's files belong to its container's users; read them as that container's root.
        code, o = cmd(['podman', 'unshare', 'tar', '-C', src, '-czf', tmp, sub or '.'], 3 * 3600)
        if code != 0:
            raise Fail('the backup of %s didn\'t finish: %s' % (CATALOG[aid]['name'], o.strip()[-160:]))
        os.replace(tmp, dest)
    finally:
        try:
            os.remove(tmp)
        except OSError:
            pass
        if was:
            cmd(['systemctl', '--user', 'start', unit(aid)], 120)
    state_set(aid, worldAt=int(now), worldFile=name_)
    return {'ok': True, 'file': name_}


def world_restore(aid, fname):
    """Roll back: the server stopped cleanly, today's world kept as a backup first, then the one you picked put back."""
    if aid not in WORLDS:
        raise Fail('That server has no world')
    if not BACKUP_RE.match(fname or '') or fname not in [b['file'] for b in world_list(aid)]:
        raise Fail('That backup isn\'t there any more')
    path = os.path.join(world_dir(aid), fname)
    code, listing = cmd(['tar', '-tzvf', path], 600)
    if code != 0 or not tar_safe(listing):
        raise Fail('That backup can\'t be read safely, so nothing was changed')
    world_backup(aid, 'before rollback')
    src, sub = world_source(aid)
    was = world_stop(aid)
    try:
        target = os.path.join(src, sub) if sub else src
        code, o = cmd(['podman', 'unshare', 'sh', '-c', 'find "$1" -mindepth 1 -delete', 'sh', target], 1800)
        if code != 0:
            raise Fail('the old world couldn\'t be cleared: %s' % o.strip()[-160:])
        code, o = cmd(['podman', 'unshare', 'tar', '-C', src, '-xzf', path], 3 * 3600)
        if code != 0:
            raise Fail('the backup couldn\'t be put back (today\'s world is kept as "before rollback"): %s' % o.strip()[-160:])
    finally:
        if was:
            cmd(['systemctl', '--user', 'start', unit(aid)], 120)
    return {'ok': True, 'restored': fname}


def players_on(aid):
    """Someone is playing on a TCP game server right now (Minecraft, Horizon, Terraria): the nightly backup waits."""
    tcp = [p[0] for p in CATALOG[aid]['ports'] if p[1] == 'tcp']
    if not tcp or not have('ss'):
        return False
    code, o = cmd(['ss', '-Htn', 'state', 'established', '( sport = :%d )' % tcp[0]], 10)
    return code == 0 and bool(o.strip())


def worlds_run(now=None):
    """The nightly run: every installed game server's world (one with players on waits an hour, once), then pruning."""
    w = settings()['worlds']
    done, waited = [], []
    if not w['on']:
        return {'ok': True, 'done': done, 'off': True}
    for aid in WORLDS:
        if not os.path.isdir(data_dir(aid)):
            continue
        if players_on(aid):
            time.sleep(0 if now else 3600)
            if players_on(aid):
                waited.append(aid)
                continue
        try:
            r = world_backup(aid, 'nightly', now)
            if r.get('file'):
                done.append(aid)
        except Fail as e:
            state_set(aid, worldError=str(e))
        world_prune(aid, w['keep'], now)
    return {'ok': True, 'done': done, 'waited': waited}


def worlds_sync():
    """The nightly timer on only while backups are on and a game server is installed."""
    w = settings()['worlds']
    want = w['on'] and any(os.path.isdir(data_dir(a)) for a in WORLDS)
    ensure_units()
    cmd(['systemctl', '--user', 'enable' if want else 'disable', '--now', 'hearth-server-worlds.timer'], 30)
    return want


def worlds_set(key, value):
    if key == 'on':
        if value not in ('on', 'off'):
            raise Fail('on or off')
        v = value == 'on'
    elif key == 'at':
        if not TIME_RE.match(value):
            raise Fail('a time like 04:30')
        v = value
    elif key == 'keep':
        if not value.isdigit() or not 1 <= int(value) <= 90:
            raise Fail('1 to 90 days')
        v = int(value)
    else:
        raise Fail('on, at or keep')
    if settings()['worlds'][key] != v:
        def change(d):
            cur = dict(d.get('worlds')) if isinstance(d.get('worlds'), dict) else {}
            cur[key] = v
            d['worlds'] = cur
        sio.update_json(SETTINGS, change)
    worlds_sync()
    return worlds_view()


def worlds_view():
    w = settings()['worlds']
    return {'settings': w, 'servers': [{'id': a, 'name': CATALOG[a]['name'], 'backups': world_list(a)[:30],
                                        'error': (state().get(a) or {}).get('worldError', '')}
                                       for a in WORLDS if os.path.isdir(data_dir(a))]}


# ------------------------------------------------------------------ install, switch, remove

def install(aid, update=False):
    a = app_or_fail(aid)
    if not podman_ok():
        raise Fail('Podman isn\'t on this PC')
    st = state().get(aid) or {}
    if st.get('installing') and time.time() - (st.get('begun') or 0) < 3 * 3600:
        return {'started': False, 'note': 'already working on it'}
    if aid == 'immich' and not (secrets_read().get('immich') or {}).get('db'):
        secret_set('immich', 'db', secrets.token_urlsafe(24))     # its own database's password, made once, never shown
    state_set(aid, installing=True, progress=0, step='starting', error='', begun=int(time.time()))
    code, o = cmd(['systemd-run', '--user', '--unit=hearth-app-install-%s-%d' % (aid, int(time.time())), '--collect',
                   '--property=Nice=10', '--property=IOSchedulingClass=idle', '--property=RuntimeMaxSec=3h',
                   sys.executable, script(), 'job', aid] + (['update'] if update else []), 30)
    if code != 0:
        state_set(aid, installing=False, error='couldn\'t start: ' + o.strip()[-160:])
        raise Fail('Couldn\'t start it: %s' % o.strip()[-200:])
    return {'started': True, 'name': a['name']}


def job(aid, update=False):
    """The pull itself. Anything wrong: you're told why, and an installed app keeps its old images."""
    a = app_or_fail(aid)
    imgs = a['images']
    try:
        if update and aid in WORLDS:
            state_set(aid, step='backing up the world first', progress=0)
            world_backup(aid, 'before update')
        for i, ref in enumerate(imgs):
            state_set(aid, step='downloading %s' % ref.split('/')[-1], progress=int(100 * i / len(imgs)))
            code, o = cmd(['podman', 'pull', ref], 3 * 3600)
            if code != 0 or not image_there(ref):
                raise Fail('the download of %s didn\'t finish: %s' % (ref.split('/')[-1], o.strip()[-160:]))
        if a.get('engine'):
            state_set(aid, step='downloading %s' % a['name'], progress=50)
            ver = engine_install(aid, progress=lambda got, total: state_set(aid, progress=50 + int(45 * got / total)))
            state_set(aid, version=ver)
        state_set(aid, installing=False, progress=100, step='done', error='', installedAt=int(time.time()))
        if aid in WORLDS:
            os.makedirs(data_dir(aid), exist_ok=True)
            worlds_sync()
        if update and settings()['apps'][aid]['on']:
            cmd(['systemctl', '--user', 'restart', unit(aid)], 60)
    except Fail as e:
        state_set(aid, installing=False, error=str(e))
        raise
    return {'ok': True}


def switch(aid, on):
    a = app_or_fail(aid)
    cfg = settings()['apps'][aid]
    if on:
        if not installed(aid):
            raise Fail('Install %s first' % a['name'])
        if a.get('eula') and not cfg['eula']:
            raise Fail('Accept Minecraft\'s EULA first (it\'s Mojang\'s, linked on this page)')
        if a.get('engine') and not horizon_game_files()[0]:
            raise Fail('Open Horizon once from Hearth Games first: it prepares the game files from your own Minecraft, which this server uses')
        pw = a.get('password')
        if pw and pw.get('required') and len((secrets_read().get(aid) or {}).get('password') or '') < pw['min']:
            raise Fail('Set a password of at least %d characters first' % pw['min'])
        clash = [CATALOG[o]['name'] for o, c in settings()['apps'].items() if o != aid and c['on']
                 and {p[0] for p in CATALOG[o]['ports']} & {p[0] for p in a['ports']}]
        if clash:
            raise Fail('%s uses the same port: turn it off first' % clash[0])
    if cfg['on'] != on:
        save_app(aid, 'on', on)
    ensure_units()
    cmd(['systemctl', '--user', 'reset-failed', unit(aid)], 10)
    if on:
        cmd(['systemctl', '--user', 'enable', timer(aid)], 30)
        cmd(['systemctl', '--user', 'restart', unit(aid)], 60)
    else:
        cmd(['systemctl', '--user', 'disable', timer(aid)], 30)
        cmd(['systemctl', '--user', 'stop', unit(aid)], 90)
    return {'ok': True, 'on': on}


def set_key(aid, key, value):
    a = app_or_fail(aid)
    if key == 'on':
        if value not in ('on', 'off'):
            raise Fail('on or off')
        return switch(aid, value == 'on')
    if key == 'reach':
        if value not in ('home', 'tailscale'):
            raise Fail('home or tailscale')
        save_app(aid, 'reach', value)
    elif key == 'eula':
        if not CATALOG[aid].get('eula') or value not in ('on', 'off'):
            raise Fail('Only Minecraft and Horizon have an EULA (on|off)')
        save_app(aid, 'eula', value == 'on')
        if value == 'off' and settings()['apps'][aid]['on']:
            switch(aid, False)
    else:
        raise Fail('on, reach or eula')
    restart_if_on(aid)
    return {'ok': True, 'name': a['name']}


def set_opt(aid, key, value):
    a = app_or_fail(aid)
    o = a['opts'].get(key)
    if not o:
        raise Fail('%s has no option %s' % (a['name'], str(key)[:30]))
    if not opt_ok(o, value):
        raise Fail('Not a choice for %s' % o['label'])
    save_app(aid, 'opts.' + key, value)
    restart_if_on(aid)
    return {'ok': True}


def restart_if_on(aid):
    if settings()['apps'][aid]['on']:
        cmd(['systemctl', '--user', 'restart', unit(aid)], 60)


def set_password(aid, text):
    a = app_or_fail(aid)
    pw = a.get('password')
    if not pw:
        raise Fail('%s has no password here (it has its own accounts)' % a['name'])
    text = (text or '').strip()
    if text and (len(text) < pw['min'] or len(text) > 64 or '\n' in text):
        raise Fail('At least %d characters (64 at most)' % pw['min'])
    if not text and pw.get('required'):
        raise Fail('%s needs a password' % a['name'])
    secret_set(aid, 'password', text)
    restart_if_on(aid)
    return {'ok': True, 'set': bool(text)}


def remove(aid, args):
    a = app_or_fail(aid)
    if settings()['apps'][aid]['on']:
        switch(aid, False)
    for ref in a['images']:
        cmd(['podman', 'rmi', '--ignore', ref], 120)
    state_set(aid, installedAt=0, error='', installing=False)
    gone = False
    if args[:3] == ['data', 'sure', 'really-sure']:
        d = data_dir(aid)
        if os.path.isdir(d) and not os.path.islink(d) and os.path.realpath(d).startswith(os.path.realpath(DATA_ROOT) + os.sep):
            code, _ = cmd(['podman', 'unshare', 'rm', '-rf', '--one-file-system', d], 600)
            gone = code == 0 and not os.path.exists(d)
    return {'ok': True, 'dataRemoved': gone, 'note': '%s removed%s' % (a['name'], ' with its data' if gone else '; its data is kept in ' + data_dir(aid))}


def logs(aid):
    app_or_fail(aid)
    code, o = cmd(['podman', 'logs', '--tail', '40', name(aid)], 20)
    return {'lines': o.splitlines()[-40:] if code == 0 else [], 'error': '' if code == 0 else 'It isn\'t running'}


# ------------------------------------------------------------------ what the pages show

def address(aid, cfg, ts_ip, lan, host):
    a = CATALOG[aid]
    port = a['ports'][0][0]
    web = a.get('web')
    fmt = (lambda h: '%s://%s:%d' % (web, h, port)) if web else (lambda h: '%s:%d' % (h, port))
    addrs = []
    if cfg['reach'] == 'home' and lan:
        addrs.append({'where': 'Home network', 'url': fmt(lan)})
    if ts_ip:
        addrs.append({'where': 'Tailscale', 'url': fmt(host or ts_ip)})
    addrs.append({'where': 'This PC', 'url': fmt('localhost')})
    return addrs


def list_apps():
    s = settings()
    st = state()
    sec = secrets_read()
    pod = podman_ok()
    ts_ip, lan, host = ts_ip4(), lan_ip(), socket.gethostname().split('.')[0]
    apps = []
    for aid, a in CATALOG.items():
        cfg = s['apps'][aid]
        ist = st.get(aid) or {}
        inst = pod and all(image_there(r) for r in a['images']) and engine_ok(aid)
        us = unit_state(aid) if cfg['on'] else 'inactive'
        pw = a.get('password')
        apps.append({
            'id': aid, 'name': a['name'], 'kind': a['kind'], 'icon': a['icon'], 'desc': a['desc'], 'size': a['size'],
            'images': a['images'], 'ports': ['%d/%s' % (p[0], p[1]) for p in a['ports']],
            'installed': inst, 'installing': ist.get('installing') is True, 'progress': ist.get('progress') or 0,
            'step': ist.get('step') or '', 'error': ist.get('error') or '',
            'on': cfg['on'], 'state': us, 'running': us == 'active', 'failed': us == 'failed', 'reach': cfg['reach'],
            'defaultReach': a['reach'], 'eula': cfg['eula'] if a.get('eula') else None, 'eulaUrl': a.get('eula', ''),
            'opts': [{'key': k, 'label': o['label'], 'value': cfg['opts'][k], 'choices': o.get('choices') or [],
                      'text': bool(o.get('text')), 'folder': bool(o.get('folder'))} for k, o in a['opts'].items()],
            'password': None if not pw else {'set': bool((sec.get(aid) or {}).get('password')), 'min': pw['min'], 'required': bool(pw.get('required'))},
            'data': data_dir(aid), 'addresses': address(aid, cfg, ts_ip, lan, host) if inst else [],
        })
    return {'podman': pod, 'tailscale': bool(ts_ip), 'apps': apps, 'on': sum(1 for x in apps if x['on'])}


def quick():
    """The apps that are on, in short: no podman calls (Server mode's dashboard asks every few seconds)."""
    s = settings()
    rows = []
    for aid, a in CATALOG.items():
        cfg = s['apps'][aid]
        if cfg['on']:
            us = unit_state(aid)
            rows.append({'id': aid, 'name': a['name'], 'kind': a['kind'], 'state': us, 'reach': cfg['reach'],
                         'port': a['ports'][0][0]})
    return {'apps': rows, 'on': len(rows), 'running': sum(1 for r in rows if r['state'] == 'active'),
            'failed': [r['name'] for r in rows if r['state'] == 'failed']}


# ------------------------------------------------------------------ phone notifications (ntfy)

def ntfy_view():
    s = settings()['ntfy']
    st = state().get('ntfy') or {}
    url = '%s/%s' % (s['server'].rstrip('/'), s['topic']) if s['topic'] else ''
    return {'settings': s, 'url': url, 'last': st.get('last') or None, 'timer': s['on']}


def ntfy_set(key, value):
    n = settings()['ntfy']
    if key in ('on', 'alerts', 'apps'):
        if value not in ('on', 'off'):
            raise Fail('on or off')
        v = value == 'on'
        if key == 'on' and v and not n['topic']:
            raise Fail('Make a topic first')
        if n[key] != v:
            save_ntfy(key, v)
        if key == 'on':
            ensure_units()
            cmd(['systemctl', '--user', 'enable' if v else 'disable', 'hearth-server-ntfy.timer'], 30)
            if v:
                cmd(['systemctl', '--user', 'start', 'hearth-server-ntfy.timer'], 30)
            else:
                cmd(['systemctl', '--user', 'stop', 'hearth-server-ntfy.timer'], 30)
    elif key == 'server':
        v = (value or '').strip().rstrip('/')
        if not URL_RE.fullmatch(v):
            raise Fail('An address like https://ntfy.sh or http://this-pc:2586')
        save_ntfy('server', v)
    elif key == 'topic':
        v = 'hearth-' + secrets.token_urlsafe(12).replace('_', 'x').replace('-', 'y') if value == 'new' else (value or '').strip()
        if not TOPIC_RE.fullmatch(v):
            raise Fail('Letters, numbers, - and _ only (64 at most)')
        save_ntfy('topic', v)
    else:
        raise Fail('on, alerts, apps, server or topic')
    return ntfy_view()


def post(url, text, title, priority='default', tags=''):
    """One message to ntfy (urllib, 10 seconds at most). Tests replace this."""
    req = urllib.request.Request(url, data=text.encode('utf-8'), method='POST',
                                 headers={'Title': title.encode('ascii', 'replace').decode(), 'Priority': priority, 'Tags': tags})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            return 200 <= r.status < 300, ''
    except (urllib.error.URLError, OSError, ValueError) as e:
        return False, str(getattr(e, 'reason', e))[:160]


def ntfy_send(text, title='Hearth home server', priority='default', tags='house'):
    v = ntfy_view()
    if not v['url']:
        raise Fail('No topic yet')
    ok, err = post(v['url'], text, title, priority, tags)
    state_set('ntfy', last={'at': int(time.time()), 'ok': ok, 'error': err, 'text': text[:200]})
    if not ok:
        raise Fail('ntfy didn\'t take it: ' + (err or 'no answer'))
    return {'ok': True}


def ntfy_forward(now=None):
    """What's new since last time: Home server alerts (and again after a day while they last), and apps that stopped."""
    now = time.time() if now is None else now
    n = settings()['ntfy']
    if not n['on'] or not n['topic']:
        return {'sent': 0, 'note': 'off'}
    found = []
    host = socket.gethostname().split('.')[0]
    if n['alerts']:
        a = sio.load_json(ALERT_STATE, {}, repair=False) if os.path.exists(ALERT_STATE) else {}
        for f in (a.get('active') or []) if isinstance(a, dict) else []:
            if isinstance(f, dict) and f.get('key') and f.get('text'):
                found.append({'key': 'alert:' + str(f['key']), 'text': str(f['text']),
                              'urgent': f.get('kind') in ('smart', 'mirror')})
    if n['apps']:
        for r in quick()['apps']:
            if r['state'] == 'failed':
                found.append({'key': 'app:' + r['id'], 'text': '%s stopped and couldn\'t start again. Settings › Home server › Server apps shows why.' % r['name'],
                              'urgent': False})
    told = (state().get('ntfy') or {}).get('told') or {}
    keys = {f['key'] for f in found}
    told = {k: t for k, t in told.items() if k in keys}
    sent = 0
    for f in found:
        if f['key'] not in told or now - told[f['key']] >= AGAIN:
            ok, _ = post(ntfy_view()['url'], f['text'], 'Hearth: ' + host, 'high' if f['urgent'] else 'default', 'warning')
            if ok:
                told[f['key']] = int(now)
                sent += 1
    state_set('ntfy', told=told, checked=int(now))
    return {'sent': sent, 'active': len(found)}


# ------------------------------------------------------------------ main

def main(argv):
    a = argv[1:]
    if not a:
        raise Fail('list, quick, install, set, opt, password, logs, remove, ntfy …')
    c = a[0]
    if c == 'list':
        return list_apps()
    if c == 'quick':
        return quick()
    if c in ('install', 'update') and len(a) == 2:
        return install(a[1], c == 'update')
    if c == 'job' and len(a) >= 2:
        return job(a[1], a[2:3] == ['update'])
    if c == 'set' and len(a) == 4:
        return set_key(a[1], a[2], a[3])
    if c == 'opt' and len(a) == 4:
        return set_opt(a[1], a[2], a[3])
    if c == 'password' and len(a) == 2:
        return set_password(a[1], os.environ.get('HEARTH_INPUT', ''))
    if c == 'logs' and len(a) == 2:
        return logs(a[1])
    if c == 'remove' and len(a) >= 2:
        return remove(a[1], a[2:])
    if c == 'run' and len(a) == 2:
        return run(a[1])
    if c == 'stop' and len(a) == 2:
        return stop(a[1])
    if c == 'worlds':
        return worlds_view()
    if c == 'worlds-set' and len(a) == 3:
        return worlds_set(a[1], a[2])
    if c == 'world-backup' and len(a) == 2:
        return world_backup(a[1], 'by hand')
    if c == 'world-restore' and len(a) == 3:
        return world_restore(a[1], a[2])
    if c == 'worlds-run':
        return worlds_run()
    if c == 'ntfy':
        return ntfy_view()
    if c == 'ntfy-set' and len(a) == 3:
        return ntfy_set(a[1], a[2])
    if c == 'ntfy-test':
        return ntfy_send('This is a test from your Hearth home server: phone notifications reach you here.', tags='white_check_mark')
    if c == 'ntfy-forward':
        return ntfy_forward()
    raise Fail('unknown command: ' + ' '.join(a)[:60])


if __name__ == '__main__':
    try:
        out(main(sys.argv))
    except Fail as e:
        print('error: ' + str(e))
        sys.exit(1)
