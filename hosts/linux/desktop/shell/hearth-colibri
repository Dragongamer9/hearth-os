    return v if isinstance(v, dict) else {}


def state_set(**kw):
    """Install and download progress, what's downloaded: state, never a setting (merged under the lock)."""
    def change(d):
        for k, v in kw.items():
            if v is None:
                d.pop(k, None)
            else:
                d[k] = v
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    sio.update_json(STATE, change)


