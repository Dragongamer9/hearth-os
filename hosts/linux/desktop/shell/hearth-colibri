def coli(args, timeout=120, env=None):
    """(code, output) of Colibri's own launcher, from the pinned release."""
    if not installed():
        raise Fail('Install Colibri first')
    return cmd([sys.executable or 'python3', coli_path()] + args, timeout, env=coli_env(env), cwd=ENGINE)


def last_json(out):
    """The JSON a coli command printed (it may say other things first)."""
    out = out or ''
    for start in [m.start() for m in re.finditer(r'^[\[{]', out, re.M)]:
        try:
            return json.loads(out[start:])
        except ValueError:
            continue
    return None


# ------------------------------------------------------------------ this PC

def meminfo_gb():
    try:
        with open('/proc/meminfo') as f:
            for line in f:
                if line.startswith('MemTotal:'):
                    return round(int(line.split()[1]) * 1024 / GB, 1)
    except (OSError, ValueError, IndexError):
        pass
    return 0.0


def gpu():
    """{name, vramGb} of the graphics card, or {}."""
    if shutil.which('nvidia-smi'):
        code, out = cmd(['nvidia-smi', '--query-gpu=name,memory.total', '--format=csv,noheader,nounits'], 6)
        if code == 0 and out.strip():
            try:
                name, mem = [x.strip() for x in out.strip().splitlines()[0].split(',')[:2]]
                return {'name': name.replace('NVIDIA GeForce ', ''), 'vramGb': round(float(mem) / 1024, 1)}
            except ValueError:
                pass
    drm = '/sys/class/drm'
    for card in sorted(os.listdir(drm)) if os.path.isdir(drm) else []:
        p = os.path.join(drm, card, 'device', 'mem_info_vram_total')
        try:
            with open(p) as f:
                return {'name': 'Graphics card', 'vramGb': round(int(f.read().strip()) / (1 << 30), 1)}
        except (OSError, ValueError):
            continue
    return {}


def free_bytes(path):
    """Free space where PATH is (or would be: its nearest folder that exists)."""
    p = path
    while p and not os.path.isdir(p):
        p = os.path.dirname(p)
    try:
        st = os.statvfs(p or '/')
        return st.f_bavail * st.f_frsize
    except OSError:
        return 0


def dir_bytes(path):
    total = 0
    for root, _dirs, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(root, f)).st_size
            except OSError:
                pass
    return total


def hardware(models=None):
    models = models or eng.models_dir()
    g = gpu()
    return {'ramGb': meminfo_gb(), 'vramGb': g.get('vramGb', 0.0), 'gpu': g.get('name', ''), 'modelsDir': models,
            'diskFreeGb': round(free_bytes(models) / GB, 1)}


# ------------------------------------------------------------------ the catalog, with an honest fit for this PC

def fit_for(m, hw, have):
    """(fit, label, why) for one catalog model on this PC: good | slow | very-slow | no-ram | no-disk.
    Small models run from RAM; large ones stream their experts from the drive, so the share of the model that fits in
    RAM decides how often a token waits for the drive."""
    ram, vram, free = hw.get('ramGb') or 0, hw.get('vramGb') or 0, hw.get('diskFreeGb') or 0
    dl = float(m.get('download_gb') or 0)
    need = disk_needed_gb(dl)
    rmin, rgood, dense = float(m.get('ram_min_gb') or 0), float(m.get('ram_good_gb') or 0), float(m.get('dense_gb') or 0)
    small = 'from RAM' in str(m.get('runs') or '')
    if not have and free and need > free:
        return 'no-disk', 'Not enough disk space', 'needs %s free, %s free in %s' % (gb(need), gb(free), 'your models folder')
    if ram and ram * 1.05 < rmin:        # "32 GB" of RAM shows a little under 32 once the firmware and graphics take theirs
        return 'no-ram', 'Won\'t run here: needs %s of memory' % gb(rmin), 'this PC has %s' % gb(ram)
    gpu_note = (' · hot experts on the %s GB graphics card' % (('%g' % vram))) if vram >= 6 else ''
    if small:
        if ram >= rgood:
            return 'good', 'Runs well', 'every expert fits in RAM' + gpu_note
        return 'slow', 'Slow', 'only part of its experts fit in RAM (%s of the %s it likes)' % (gb(ram), gb(rgood))
    share = max(0.0, ram - dense) / dl if dl else 0
    if ram >= rgood and share >= 0.4:
        return 'slow', 'Slow', 'streams its cold experts from the drive; about %d%% of it fits in RAM' % round(100 * min(1, share)) + gpu_note
    return 'very-slow', 'Very slow — streams from disk', 'about %d%% of it fits in RAM; most tokens wait for the drive' % round(100 * min(1, share))


def disk_needed_gb(download_gb):
    """The download plus room for Colibri's own files and the drive not running full (5%, at least 5 GB)."""
    return round(download_gb + max(5.0, download_gb * 0.05), 1)


def gb(v):
    v = float(v or 0)
    return ('%.2f TB' % (v / 1000)) if v >= 1000 else ('%d GB' % round(v)) if v >= 10 else ('%.1f GB' % v)


def downloaded():
    st = state().get('models') or {}
    out = {}
    for mid, rec in st.items() if isinstance(st, dict) else []:
        if isinstance(rec, dict) and ID_RE.fullmatch(mid or '') and os.path.isdir(rec.get('dir') or ''):
            out[mid] = rec
    return out


def catalog():
    """Every model in Colibri's own catalog (nothing hidden, nothing hand-picked), with this PC's fit."""
    if FIXTURE:
        return (sio.load_json(FIXTURE, {}, repair=False).get('catalog') or {})
    models = eng.models_dir()
    hw = hardware(models)
    code, out = coli(['setup', '--list', '--all', '--json', '--dir', models], 120)
    rows = last_json(out) if code == 0 else None
    if not isinstance(rows, list):
        raise Fail('Colibri didn\'t list its models: %s' % (out.strip().splitlines() or ['no answer'])[-1][:200])
    have = downloaded()
    cfg = eng.load()
    dl = state().get('download') or {}
    res = []
    for r in rows:
        if not isinstance(r, dict) or not ID_RE.fullmatch(str(r.get('id') or '')):
            continue
        mid = r['id']
        fit, label, why = fit_for(r, hw, mid in have)
        expect = EXPECT.get(fit, '')
        res.append({'id': mid, 'name': str(r.get('name') or mid)[:80], 'family': str(r.get('family') or '')[:40],
                    'kind': 'image' if r.get('kind') == 'image' else 'text', 'summary': str(r.get('summary') or '')[:200],
                    'downloadGb': float(r.get('download_gb') or 0), 'diskGb': disk_needed_gb(float(r.get('download_gb') or 0)),
                    'ramMinGb': r.get('ram_min_gb'), 'ramGoodGb': r.get('ram_good_gb'), 'runs': str(r.get('runs') or ''),
                    'fit': fit, 'fitLabel': label, 'why': why, 'expect': expect, 'measured': MEASURED.get(mid, 'no speed published yet'),
                    'colibriSays': str(r.get('reason') or '')[:200], 'recommended': r.get('recommended') is True,
                    'license': str(r.get('license_note') or '')[:120], 'have': mid in have, 'chosen': mid == cfg['colibri']['model'],
                    'downloading': dl.get('id') == mid and dl.get('running') is True})
    for m in res:
        m['group'] = 'standard'
    for e in extra_models():
        mid = e['id']
        row = {'download_gb': e['downloadGb'], 'ram_min_gb': e['ramMinGb'], 'ram_good_gb': e['ramGoodGb'],
               'dense_gb': e.get('denseGb') or 0, 'runs': e['runs']}
        fit, label, why = fit_for(row, hw, mid in have)
        res.append({'id': mid, 'name': e['name'][:80], 'family': e.get('family', ''), 'familyName': e.get('familyName', ''),
                    'group': 'uncensored', 'kind': 'text', 'summary': e.get('goodAt', '')[:200], 'quant': e.get('quant', ''),
                    'quantNote': e.get('quantNote', ''), 'architecture': e.get('architecture', ''),
                    'repo': e['source']['repo'], 'file': e['source']['file'],
                    'downloadGb': e['downloadGb'], 'diskGb': disk_needed_gb(e['downloadGb']),
                    'ramMinGb': e['ramMinGb'], 'ramGoodGb': e['ramGoodGb'], 'runs': e['runs'],
                    'fit': fit, 'fitLabel': label, 'why': why, 'expect': EXPECT.get(fit, ''),
                    'measured': 'no speed published for this build (its Qwen original: %s)' % MEASURED.get(
                        'qwen3-coder-30b' if 'coder' in mid else 'qwen36-35b', ''),
                    'colibriSays': '', 'recommended': e.get('recommended') is True, 'license': e.get('licence', '')[:120],
                    'have': mid in have, 'chosen': mid == cfg['colibri']['model'],
                    'downloading': dl.get('id') == mid and dl.get('running') is True})
    return {'hardware': hw, 'models': res, 'source': 'Colibri %s catalog' % COLIBRI_TAG,
            'groups': [{'id': 'standard', 'label': 'Standard (filtered)'}, {'id': 'uncensored', 'label': 'Uncensored'}]}


def extra_models():
    """The uncensored group from Hearth's model list (ai-models.json): GGUF files on Hugging Face of an architecture
    Colibri runs. An entry that isn't well formed is left out, never guessed at."""
    d = sio.load_json(AI_MODELS, {}, repair=False) if os.path.isfile(AI_MODELS) else {}
    out = []
    for e in d.get('models') or [] if isinstance(d, dict) else []:
        try:
            src = e['source']
            if e.get('group') != 'uncensored' or src.get('kind') != 'hf-gguf' or not ID_RE.fullmatch(e['id']):
                continue
            if not HF_REPO_RE.fullmatch(src['repo']) or not HF_FILE_RE.fullmatch(src['file']) or e.get('architecture') not in GGUF_ARCHS:
                continue
            if not (0 < int(src['sizeBytes']) < 4 << 40):
                continue
            float(e['downloadGb']), float(e['ramMinGb']), float(e['ramGoodGb'])
            out.append(e)
        except (KeyError, TypeError, ValueError, AttributeError):
            continue
    return out


def plan(mid):
    """A downloaded model's real plan on this PC (Colibri's planner and its read-only doctor)."""
    if FIXTURE:
        return (sio.load_json(FIXTURE, {}, repair=False).get('plan') or {})
    rec = downloaded().get(mid)
    if not rec:
        raise Fail('Download it first')
    code, out = coli(['plan', '--json', '--model', rec['dir']], 120)
    p = last_json(out) if code == 0 else None
    code2, out2 = coli(['doctor', '--json', '--model', rec['dir']], 180)
    d = last_json(out2)
    res = {'id': mid}
    if isinstance(p, dict):
        t = p.get('tiers') or {}
        res.update({'vramGb': round(((t.get('vram') or {}).get('hot_expert_bytes') or 0) / GB + ((t.get('vram') or {}).get('trunk_bytes') or 0) / GB, 1),
                    'ramGb': round(((t.get('ram') or {}).get('budget_bytes') or 0) / GB, 1),
                    'diskGb': round(((t.get('disk') or {}).get('model_bytes') or 0) / GB, 1),
