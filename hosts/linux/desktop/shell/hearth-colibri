def server_view():
    base = 'http://127.0.0.1:%d' % COLIBRI_PORT
    health = http_json(base + '/health')
    if not isinstance(health, dict):
        return {'health': 'down'}
    out = {'health': 'ready' if health.get('status') == 'ok' else str(health.get('status') or 'starting')[:20]}
    models = http_json(base + '/v1/models') or {}
    data = models.get('data') if isinstance(models, dict) else None
    if data and isinstance(data[0], dict):
        out['modelId'] = str(data[0].get('id') or '')[:80]
    prof = http_json(base + '/profile') or {}
