def safe_members(tf):
    """The archive's members, or why it isn't safe: no absolute paths, nothing climbing out, no links out, no devices."""
    out = []
    for m in tf.getmembers():
        n = m.name
        if n.startswith('/') or '..' in n.split('/'):
            raise Fail('Colibri\'s archive has a path outside its folder (%s)' % n[:80])
        if not (m.isfile() or m.isdir() or m.issym()):
            raise Fail('Colibri\'s archive has a special file (%s)' % n[:80])
        if m.issym():
            t = os.path.normpath(os.path.join(os.path.dirname(n), m.linkname))
            if m.linkname.startswith('/') or t.startswith('..'):
                raise Fail('Colibri\'s archive has a link outside its folder (%s)' % n[:80])
        out.append(m)
    return out


def install_run():
    """The install itself (in its own unit): the pinned archive, both checksums, unpacked beside the old one, swapped.
    Anything wrong: nothing changes and you're told why."""
    state_set(install={'running': True, 'progress': 0, 'error': '', 'started': int(time.time())})
    work = os.path.join(DATA, '.download')
    new = os.path.join(DATA, '.engine.new')
    try:
        if os.uname().machine not in ('x86_64', 'amd64'):
            raise Fail('Colibri\'s release is for x86-64 PCs')
        os.makedirs(DATA, exist_ok=True)
        if free_bytes(DATA) < 4 * ARCHIVE_MAX:
            raise Fail('not enough free space in your Home for Colibri (about 256 MB)')
        sums = sums_lookup(http_get(COLIBRI_SUMS).decode('utf-8', 'replace'), COLIBRI_ASSET)
        if sums != COLIBRI_SHA256:
            raise Fail('Colibri\'s published checksum isn\'t the one this Hearth pins: not installing it')
        for p in (work, new):
            shutil.rmtree(p, ignore_errors=True)
        os.makedirs(work, 0o700)
        f = os.path.join(work, COLIBRI_ASSET)
        got = download(COLIBRI_URL, f, ARCHIVE_MAX, lambda g, t: state_set(install={'running': True, 'progress': int(g * 90 / t), 'error': '',
                                                                                       'started': int(time.time())}))
        if got != COLIBRI_SHA256:
            raise Fail('the download doesn\'t match Colibri\'s checksum: not installed')
        os.makedirs(new, 0o755)
        with tarfile.open(f, 'r:gz') as tf:
            members = safe_members(tf)
            try:
                tf.extractall(new, members=members, filter='data')
            except TypeError:          # Python without extraction filters: the members were checked above
                tf.extractall(new, members=members)
        for exe in ('coli', 'colibri'):
            if not os.path.isfile(os.path.join(new, exe)):
                raise Fail('Colibri\'s archive doesn\'t have %s where it should be' % exe)
        for name in os.listdir(new):
            p = os.path.join(new, name)
            if os.path.isfile(p) and '.' not in name:
                os.chmod(p, 0o755)
        old = os.path.join(DATA, '.engine.old')
        shutil.rmtree(old, ignore_errors=True)
        if os.path.isdir(ENGINE):
            os.rename(ENGINE, old)
        os.rename(new, ENGINE)
        shutil.rmtree(old, ignore_errors=True)
        state_set(install={'running': False, 'progress': 100, 'error': '', 'version': COLIBRI_TAG, 'sha256': got, 'at': int(time.time())})
        eng.refresh_listing()
        if unit_active(UNIT):
            cmd(['systemctl', '--user', 'restart', UNIT], 30)
        return {'installed': True, 'version': COLIBRI_TAG}
    except (Fail, OSError, tarfile.TarError) as e:
        state_set(install={'running': False, 'progress': 0, 'error': str(e)[:240]})
        raise Fail(str(e))
    finally:
        for p in (work, new):
            shutil.rmtree(p, ignore_errors=True)


def start_unit(name, args):
    code, out = cmd(['systemd-run', '--user', '--unit=%s' % name, '--collect', '--property=Nice=10',
                     '--property=IOSchedulingClass=idle', '--property=RuntimeMaxSec=48h',
                     sys.executable or 'python3', os.path.realpath(__file__)] + args, 30)
    if code != 0:
        raise Fail('Couldn\'t start it: %s' % out.strip()[-200:])


def install():
    st = state().get('install') or {}
    if st.get('running') and time.time() - (st.get('started') or 0) < 3600:
        return {'started': False, 'note': 'already installing'}
    state_set(install={'running': True, 'progress': 0, 'error': '', 'started': int(time.time())})
    try:
        start_unit('hearth-colibri-install-%d' % int(time.time()), ['install-run'])
    except Fail as e:
        state_set(install={'running': False, 'progress': 0, 'error': str(e)})
        raise
    return {'started': True}


def remove():
    cmd(['systemctl', '--user', 'disable', TIMER], 30)
    cmd(['systemctl', '--user', 'stop', UNIT], 60)
    if os.path.isdir(ENGINE) and os.path.realpath(ENGINE).startswith(os.path.realpath(DATA) + os.sep):
        shutil.rmtree(ENGINE)
    state_set(install=None)
    return {'removed': True, 'modelsKept': True}


