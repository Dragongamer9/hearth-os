def catalog_row(mid):
    code, out = coli(['setup', '--list', '--all', '--json', '--dir', eng.models_dir()], 120)
    rows = last_json(out) if code == 0 else None
    for r in rows if isinstance(rows, list) else []:
        if isinstance(r, dict) and r.get('id') == mid:
            return r
    raise Fail('%s isn\'t in Colibri\'s catalog' % mid)


def download_start(mid):
    """One model, only when you ask: free space checked first; Colibri's setup downloads it (resumable, checked)."""
    if not ID_RE.fullmatch(mid or ''):
        raise Fail('not a Colibri model id')
    if not installed():
        raise Fail('Install Colibri first')
    dl = state().get('download') or {}
    if dl.get('running') and unit_active(dl.get('unit') or DL_UNIT):
        raise Fail('Already downloading %s: wait for it or cancel it' % dl.get('id'))
    extra = next((e for e in extra_models() if e['id'] == mid), None)
    row = {'download_gb': extra['downloadGb'], 'name': extra['name']} if extra else catalog_row(mid)
    models = eng.models_dir()
    target = os.path.join(models, mid)
    present = dir_bytes(target) if os.path.isdir(target) else 0
    if extra:
        part = os.path.join(models, 'gguf', extra['source']['file'] + '.part')
        present += os.path.getsize(part) if os.path.isfile(part) else 0
    need = disk_needed_gb(float(row.get('download_gb') or 0)) * GB - present
    free = free_bytes(models)
    if need > free:
        raise Fail('Not enough disk space: %s needs %s free in %s, and %s is free. Pick another drive for your models '
                   'or make room' % (row.get('name') or mid, gb(need / GB), models, gb(free / GB)))
    unit = '%s-%d' % (DL_UNIT, int(time.time()))
    state_set(download={'id': mid, 'name': str(row.get('name') or mid)[:80], 'running': True, 'unit': unit,
                        'started': int(time.time()), 'error': '', 'dir': target})
    try:
        start_unit(unit, ['download-run', mid])
    except Fail as e:
        state_set(download={'id': mid, 'running': False, 'error': str(e)})
        raise
    return {'started': True, 'id': mid, 'needGb': round(need / GB, 1), 'freeGb': round(free / GB, 1)}


def gguf_run(e, models):
    """An uncensored build: its GGUF from Hugging Face (https, resumed, its size and SHA-256 as Hugging Face lists them
    checked), then `coli import` writes the model folder beside it (the engine reads the GGUF in place)."""
    src = e['source']
    listing = hf_json('https://huggingface.co/api/models/%s/tree/%s' % (src['repo'], src.get('revision') or 'main'))
    info = next((f for f in listing if isinstance(f, dict) and f.get('path') == src['file']), None) if isinstance(listing, list) else None
    if not info:
        raise Fail('%s isn\'t in %s any more' % (src['file'], src['repo']))
    size = int(info.get('size') or 0)
    sha = str(((info.get('lfs') or {}).get('oid') or '')).lower()
    if size != int(src['sizeBytes']):
        raise Fail('the file on Hugging Face isn\'t the size Hearth expects (%s, not %s): not downloading it' % (gb(size / GB), gb(int(src['sizeBytes']) / GB)))
    gdir = os.path.join(models, 'gguf')
    os.makedirs(gdir, exist_ok=True)
    dest = os.path.join(gdir, src['file'])
    if not os.path.isfile(dest):
        def prog(got, total, rate):
            d = dict(state().get('download') or {})
            d.update({'done': got, 'total': total, 'rate': rate, 'pct': round(100.0 * got / total, 1), 'phase': 'download'})
            state_set(download=d)
        url = 'https://huggingface.co/%s/resolve/%s/%s' % (src['repo'], src.get('revision') or 'main', urllib.parse.quote(src['file']))
        got = hf_download(url, dest, size, prog)
        if re.fullmatch(r'[0-9a-f]{64}', sha) and got != sha:
            os.remove(dest)
            raise Fail('the download doesn\'t match the SHA-256 Hugging Face publishes for it: deleted, not used')
    out_dir = os.path.join(models, e['id'])
    d = dict(state().get('download') or {})
    d['phase'] = 'import'
    state_set(download=d)
    code, out = coli(['import', dest, '--out', out_dir], 3600)
    if code != 0 or not os.path.isfile(os.path.join(out_dir, 'config.json')):
        raise Fail('coli import didn\'t take it: %s' % ((out or '').strip().splitlines() or ['no answer'])[-1][:200])
    env = {'COLI_VULKAN': '1'} if gpu() else {}
    return {'dir': out_dir, 'backend': 'vulkan' if env else 'cpu', 'env': env}


def download_run(mid):
    """In its own unit: Colibri's own setup for this one model (or, for an uncensored build, its GGUF and coli import),
    not started afterwards (Hearth starts it)."""
    models = eng.models_dir()
    os.makedirs(models, exist_ok=True)
    extra = next((e for e in extra_models() if e['id'] == mid), None)
    if extra:
        try:
            r = gguf_run(extra, models)
        except (Fail, OSError) as ex:
            dl = dict(state().get('download') or {})
            dl.update({'running': False, 'error': str(ex)[:240]})
            state_set(download=dl)
            raise Fail(str(ex))
        models_st = dict(state().get('models') or {})
        models_st[mid] = {'dir': r['dir'], 'at': int(time.time()), 'backend': r['backend'], 'env': r['env'], 'gguf': extra['source']['file']}
        dl = dict(state().get('download') or {})
        dl.update({'running': False, 'error': '', 'done': True})
        state_set(models=models_st, download=dl)
        return {'downloaded': mid, 'dir': r['dir']}
    code, out = coli(['setup', '--model', mid, '--dir', models, '--backend', 'auto', '--no-start', '--yes', '--no-browser',
                      '--json'], 48 * 3600)
    dl = dict(state().get('download') or {})
    res = last_json(out)
    if code != 0 or not isinstance(res, dict):
        lines = [l.strip() for l in (out or '').splitlines() if l.strip()]
        msg = next((l for l in lines if l.startswith(('setup stopped', 'download stopped'))), lines[-1] if lines else 'it stopped')[:240]
        dl.update({'running': False, 'error': msg})
        state_set(download=dl)
        raise Fail(msg)
    conf = res.get('config') if isinstance(res.get('config'), dict) else {}
    mdir = conf.get('model_dir') or os.path.join(models, mid)
    models_st = dict(state().get('models') or {})
    models_st[mid] = {'dir': mdir, 'at': int(time.time()), 'backend': str(conf.get('backend') or '')[:20],
                      'env': {k: str(v) for k, v in (conf.get('env') or {}).items() if re.fullmatch(r'[A-Z][A-Z0-9_]{0,63}', str(k))}}
    dl.update({'running': False, 'error': '', 'done': True})
    state_set(models=models_st, download=dl)
    return {'downloaded': mid, 'dir': mdir}


def cancel():
    dl = state().get('download') or {}
    if dl.get('unit'):
        cmd(['systemctl', '--user', 'stop', dl['unit']], 60)
    dl.update({'running': False, 'error': 'cancelled (what was downloaded stays: download again to continue)'})
    state_set(download=dl)
    return {'cancelled': True}


def adopt(mid):
    """A model another app downloaded with Colibri's own setup (Hearth AI / Ithil's "Install & use" runs
    `coli setup --model ID --no-start`): found in Hearth's setup folder or Colibri's own, or in a models folder, and
    noted as downloaded so `use` can serve it. Only a folder named after the model with Colibri's config.json in it."""
    if not ID_RE.fullmatch(mid or ''):
        return None
    homes = [SETUP_HOME, os.path.join(DATA_HOME, 'colibri')]
    for h in homes:
        cfg = sio.load_json(os.path.join(h, 'setup.json'), {}, repair=False) if os.path.exists(os.path.join(h, 'setup.json')) else {}
        if isinstance(cfg, dict) and (cfg.get('model') or {}).get('id') == mid and cfg.get('status') == 'ready':
            d = cfg.get('model_dir') or ''
            if os.path.isfile(os.path.join(d, 'config.json')):
                return d, cfg
    for root in (eng.models_dir(), os.path.join(HOME, 'colibri-models')):
        d = os.path.join(root, mid)
        man = sio.load_json(os.path.join(d, '.colibri-download.json'), {}, repair=False) \
            if os.path.isfile(os.path.join(d, '.colibri-download.json')) else {}
        if os.path.isfile(os.path.join(d, 'config.json')) and isinstance(man, dict) and man.get('complete') is True:
            return d, {}      # Colibri's own download manifest says every file is there
    return None


def use(mid):
    if mid not in downloaded():
        found = adopt(mid)
        if not found:
            raise Fail('Download it first')
        d, cfg = found
        models_st = dict(state().get('models') or {})
        models_st[mid] = {'dir': d, 'at': int(time.time()), 'backend': str(cfg.get('backend') or '')[:20], 'adopted': True,
                          'env': {k: str(v) for k, v in (cfg.get('env') or {}).items() if re.fullmatch(r'[A-Z][A-Z0-9_]{0,63}', str(k))}}
        state_set(models=models_st)
    eng.set_key('colibriModel', mid)
    if unit_active(UNIT):
        cmd(['systemctl', '--user', 'restart', UNIT], 30)
    return {'model': mid}


def remove_model(mid):
    rec = downloaded().get(mid)
    if not rec:
        raise Fail('That model isn\'t downloaded')
    d = os.path.realpath(rec['dir'])
    if os.path.basename(d) != mid or d in ('/', os.path.realpath(HOME)):
        raise Fail('That folder doesn\'t look like a Colibri model')
    if eng.load()['colibri']['model'] == mid and unit_active(UNIT):
        cmd(['systemctl', '--user', 'stop', UNIT], 60)
    shutil.rmtree(d)
    if rec.get('gguf') and HF_FILE_RE.fullmatch(rec['gguf']):
        g = os.path.join(os.path.dirname(d), 'gguf', rec['gguf'])
        if os.path.isfile(g):
            os.remove(g)
    models_st = dict(state().get('models') or {})
    models_st.pop(mid, None)
    state_set(models=models_st)
    return {'removed': mid}


def folders():
    """Your Home and every mounted drive you can write to, with free space (where models could go)."""
    out = [{'path': os.path.join(HOME, 'colibri-models'), 'label': 'Your Home', 'freeGb': round(free_bytes(HOME) / GB, 1)}]
    seen = {os.stat(HOME).st_dev} if os.path.isdir(HOME) else set()
    user = os.environ.get('USER') or ''
    for base in ('/run/media/' + user, '/media/' + user, '/mnt', '/srv'):
        for name in sorted(os.listdir(base)) if os.path.isdir(base) else []:
            p = os.path.join(base, name)
            try:
                if not os.path.ismount(p) or not os.access(p, os.W_OK) or os.stat(p).st_dev in seen:
                    continue
                seen.add(os.stat(p).st_dev)
            except OSError:
                continue
            out.append({'path': os.path.join(p, 'colibri-models'), 'label': name, 'freeGb': round(free_bytes(p) / GB, 1)})
    return {'folders': out, 'current': eng.models_dir()}


