# ------------------------------------------------------------------ small helpers (tests replace cmd, http_*, hardware)

def cmd(args, timeout=60, env=None, cwd=None):
    """(exit code, output) of a command as you; never a shell."""
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=env, cwd=cwd, stdin=subprocess.DEVNULL)
        return p.returncode, (p.stdout or '') + (p.stderr or '')
    except (OSError, subprocess.SubprocessError) as e:
        return 127, str(e)


def http_json(url, timeout=1.5):
    """A local JSON answer (Colibri on this PC), or None."""
    try:
        with urllib.request.urlopen(url, timeout=timeout) as r:
            data = r.read(4 << 20)
        v = json.loads(data.decode('utf-8', 'replace'))
        return v if isinstance(v, (dict, list)) else None
    except (OSError, ValueError):
        return None


def _opener():
    class Only(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            u = urllib.parse.urlparse(newurl)
            if u.scheme != 'https' or u.hostname not in DOWNLOAD_HOSTS:
                raise Fail('a download tried to go somewhere else (%s): stopped' % (u.hostname or '?'))
            return super().redirect_request(req, fp, code, msg, headers, newurl)
    return urllib.request.build_opener(Only)


def url_ok(url):
    u = urllib.parse.urlparse(url or '')
    return u.scheme == 'https' and u.hostname in DOWNLOAD_HOSTS


def hf_ok(url):
    u = urllib.parse.urlparse(url or '')
    h = u.hostname or ''
    return u.scheme == 'https' and (h in HF_HOSTS or h.endswith(HF_SUFFIXES))


def _hf_opener():
    class Only(urllib.request.HTTPRedirectHandler):
        def redirect_request(self, req, fp, code, msg, headers, newurl):
            if not hf_ok(newurl):
                raise Fail('a download tried to go somewhere else (%s): stopped' % (urllib.parse.urlparse(newurl).hostname or '?'))
            return super().redirect_request(req, fp, code, msg, headers, newurl)
    return urllib.request.build_opener(Only)


def hf_json(url):
    """A small JSON answer from Hugging Face's API (a repository's file list, with each file's size and SHA-256)."""
    if not hf_ok(url):
        raise Fail('not an allowed address')
    try:
        with _hf_opener().open(urllib.request.Request(url, headers={'User-Agent': 'Hearth-OS'}), timeout=30) as r:
            return json.loads(r.read(8 << 20).decode('utf-8', 'replace'))
    except (OSError, ValueError) as e:
        raise Fail('couldn\'t reach Hugging Face (%s)' % e)


def hf_download(url, dest, size, progress=None):
    """A big file to DEST, carrying on from DEST.part (resume); its SHA-256 (hex). Never more than SIZE bytes."""
    if not hf_ok(url):
        raise Fail('not an allowed address')
    part = dest + '.part'
    h = hashlib.sha256()
    got = 0
    if os.path.exists(part):
        with open(part, 'rb') as f:
            for chunk in iter(lambda: f.read(8 << 20), b''):
                h.update(chunk)
                got += len(chunk)
        if got > size:
            os.remove(part)
            h, got = hashlib.sha256(), 0
    headers = {'User-Agent': 'Hearth-OS'}
    if got:
        headers['Range'] = 'bytes=%d-' % got
    t0, g0 = time.time(), got
    try:
        with _hf_opener().open(urllib.request.Request(url, headers=headers), timeout=60) as r:
            if got and r.status != 206:          # the server sent the whole file again: start over
                h, got = hashlib.sha256(), 0
                mode = 'wb'
            else:
                mode = 'ab' if got else 'wb'
            with open(part, mode) as f:
                last = 0
                while True:
                    chunk = r.read(4 << 20)
                    if not chunk:
                        break
                    got += len(chunk)
                    if got > size:
                        raise Fail('the download is bigger than Hugging Face says the file is')
                    h.update(chunk)
                    f.write(chunk)
                    if progress and time.time() - last > 1:
                        last = time.time()
                        progress(got, size, (got - g0) / max(0.1, time.time() - t0))
    except OSError as e:
        raise Fail('the download stopped (%s); download again to continue' % e)
    if got != size:
        raise Fail('the download stopped at %s of %s; download again to continue' % (gb(got / GB), gb(size / GB)))
    os.replace(part, dest)
    return h.hexdigest()


def http_get(url, limit=1 << 20):
    """A small https answer from Colibri's release (its checksum file)."""
    if not url_ok(url):
        raise Fail('not an allowed address')
    try:
        with _opener().open(urllib.request.Request(url, headers={'User-Agent': 'Hearth-OS'}), timeout=30) as r:
            data = r.read(limit + 1)
    except OSError as e:
        raise Fail('couldn\'t reach Colibri\'s release (%s)' % e)
    if len(data) > limit:
        raise Fail('the answer was too big')
    return data


def download(url, dest, limit, progress=None):
    """The archive to DEST; its SHA-256 (hex)."""
    if not url_ok(url):
        raise Fail('not an allowed address')
    h, got = hashlib.sha256(), 0
    try:
        with _opener().open(urllib.request.Request(url, headers={'User-Agent': 'Hearth-OS'}), timeout=60) as r, open(dest, 'wb') as f:
            total = int(r.headers.get('Content-Length') or 0)
            if total > limit:
                raise Fail('the download is bigger than expected')
            while True:
                chunk = r.read(1 << 20)
                if not chunk:
                    break
                got += len(chunk)
                if got > limit:
                    raise Fail('the download is bigger than expected')
                h.update(chunk)
                f.write(chunk)
                if progress and total:
                    progress(got, total)
    except OSError as e:
        raise Fail('the download stopped (%s)' % e)
    return h.hexdigest()


def sums_lookup(text, name):
    for line in (text or '').splitlines():
        parts = line.strip().split()
        if len(parts) >= 2 and re.fullmatch(r'[0-9a-f]{64}', parts[0].lower()) and parts[-1].lstrip('*').lstrip('./') == name:
            return parts[0].lower()
    return ''


def state():
