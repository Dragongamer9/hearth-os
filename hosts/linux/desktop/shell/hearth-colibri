    code, out = cmd([sys.executable or 'python3', os.path.join(HERE, 'hearth-home-server')] + args, 120)
    line = (out.strip().splitlines() or [''])[-1]
    if code != 0 or line.startswith('error: '):
        raise Fail(line[7:] if line.startswith('error: ') else line or 'that didn\'t work')
    try:
        return json.loads(line)
    except ValueError:
        return {}


def set_key(key, value):
    if key == 'engine':
        if value not in ('ollama', 'colibri', 'both'):
            raise Fail('ollama, colibri or both')
        if value in ('colibri', 'both') and not installed():
            raise Fail('Install Colibri first')
        res = {}
        # The engine you add first, the one you leave second: never a moment with neither when you asked for one.
        want_ai, want_co = value in ('ollama', 'both'), value in ('colibri', 'both')
        if want_co:
            res['colibri'] = home_server(['set', 'colibriOn', 'on'])
        if want_ai:
            res['ollama'] = home_server(['set', 'aiOn', 'on'])
        if not want_ai:
            res['ollama'] = home_server(['set', 'aiOn', 'off'])
        if not want_co:
            res['colibri'] = home_server(['set', 'colibriOn', 'off'])
        eng.refresh_listing()
        if eng.load()['default'] == 'colibri' and not want_co:
            eng.set_key('default', 'ollama')
            res['defaultBack'] = 'Hearth\'s AI uses Ollama again (Colibri is off now)'
        return res
    if key == 'default':
        if value == 'colibri' and not eng.home_server_on().get('colibri'):
            raise Fail('Turn Colibri on first')
        return eng.set_key('default', value)
    if key == 'modelsDir':
        if not value.startswith('/'):
            raise Fail('a folder on this PC')
        return eng.set_key('colibriModelsDir', value)
    if key == 'pause':
        return home_server(['set', 'colibriPause', value])
    raise Fail('engine, default, modelsDir or pause')


# ------------------------------------------------------------------ the service

def ts_ip4():
    if not shutil.which('tailscale'):
        return ''
    code, out = cmd(['tailscale', 'ip', '-4'], 8)
    ip = out.strip().splitlines()[0].strip() if code == 0 and out.strip() else ''
    return ip if re.fullmatch(r'100\.\d{1,3}\.\d{1,3}\.\d{1,3}', ip) else ''


def from_tailscale(ip):
    try:
        a = ipaddress.ip_address(ip)
    except ValueError:
        return False
    return any(a in n for n in TS_NETS)


def forward(listen_ip, port, stop):
    """This PC's Tailscale address → Colibri on 127.0.0.1 (coli serve listens on one address). Only Tailscale's own
    addresses get an answer; Hearth's firewall rule lets only Tailscale reach the port too."""
    try:
        srv = socket.create_server((listen_ip, port), reuse_port=False)
    except OSError as e:
        print('hearth-colibri: not on Tailscale (%s)' % e, flush=True)
        return
    srv.settimeout(1.0)

    def pump(a, b):
        try:
            while True:
                data = a.recv(1 << 16)
                if not data:
                    break
                b.sendall(data)
        except OSError:
            pass
        finally:
            for s in (a, b):
                try:
                    s.shutdown(socket.SHUT_RDWR)
                except OSError:
                    pass

    while not stop.is_set():
        try:
            c, addr = srv.accept()
        except socket.timeout:
            continue
        except OSError:
            break
        if not from_tailscale(addr[0]):
            c.close()
            continue
        try:
            up = socket.create_connection(('127.0.0.1', port), timeout=5)
            up.settimeout(None)
        except OSError:
            c.close()
            continue
        threading.Thread(target=pump, args=(c, up), daemon=True).start()
        threading.Thread(target=pump, args=(up, c), daemon=True).start()
    srv.close()


def run_argv(mid, rec, allowed=()):
    argv = [sys.executable or 'python3', coli_path(), 'serve', '--model', rec['dir'], '--host', '127.0.0.1',
            '--port', str(COLIBRI_PORT), '--model-id', mid, '--auto-tier']
    for h in allowed:
        argv += ['--allowed-host', h]
    env = {k: v for k, v in (rec.get('env') or {}).items() if re.fullmatch(r'[A-Z][A-Z0-9_]{0,63}', k)}
    if rec.get('backend') == 'vulkan':
        env.setdefault('COLI_VULKAN', '1')
    return argv, env


def run():
    """hearth-colibri.service. No model yet, or not downloaded: it ends quietly (exit 0, so it isn't restarted)."""
    cfg = eng.load()
    mid = cfg['colibri']['model']
    rec = downloaded().get(mid)
    if not installed():
        print('hearth-colibri: Colibri isn\'t installed', flush=True)
        return 0
    if not mid or not rec:
        print('hearth-colibri: no model picked and downloaded yet (Settings › Home server › AI engine)', flush=True)
        return 0
    ip = ts_ip4()
    host = socket.gethostname().split('.')[0]
    argv, env = run_argv(mid, rec, [ip, host] if ip else [])
    try:
        state_set(listen=['127.0.0.1'] + ([ip] if ip else []))
    except OSError:
        pass
    child = subprocess.Popen(argv, env=coli_env(env), cwd=ENGINE, stdin=subprocess.DEVNULL)
    stop = threading.Event()

    def end(signum, _frame):
        stop.set()
        try:
            child.send_signal(signal.SIGTERM)
        except OSError:
            pass
    signal.signal(signal.SIGTERM, end)
    signal.signal(signal.SIGINT, end)
    if ip:
        threading.Thread(target=forward, args=(ip, COLIBRI_PORT, stop), daemon=True).start()
    code = child.wait()
    stop.set()
    return code


# ------------------------------------------------------------------ main

def main(argv):
    try:
        a = argv
        if a == ['status']:
            res = status()
        elif a == ['catalog']:
            res = catalog()
        elif len(a) == 2 and a[0] == 'plan':
            res = plan(a[1])
        elif a == ['install']:
            res = install()
        elif a == ['install-run']:
            res = install_run()
        elif len(a) == 2 and a[0] == 'download':
            res = download_start(a[1])
        elif len(a) == 2 and a[0] == 'download-run':
            res = download_run(a[1])
        elif a == ['cancel']:
            res = cancel()
        elif len(a) == 2 and a[0] == 'use':
            res = use(a[1])
        elif len(a) == 3 and a[0] == 'set':
            res = set_key(a[1], a[2])
        elif len(a) == 3 and a[0] == 'remove-model' and a[2] == 'sure':
            res = remove_model(a[1])
        elif a == ['remove']:
            res = remove()
        elif a == ['folders']:
            res = folders()
        elif a == ['run']:
            return run()
        else:
            raise Fail('status | catalog | plan ID | install | download ID | cancel | use ID | set KEY VALUE | '
                       'remove-model ID sure | remove | folders | run')
        print(json.dumps(res))
        return 0
    except (Fail, eng.Fail, OSError, ValueError) as e:
        print('error: %s' % e, flush=True)
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
