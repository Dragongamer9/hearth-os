def cmd_set(i, k, v):
    a = app(i)
    if k == 'proton':
        if v and not hp.find(v) and not hp.downloadable(v):
            raise Fail('%s isn\'t a Proton Hearth knows' % v)
        save_app(a['dir'], {'proton': v})
    elif k in ('dxvk', 'vkd3d'):
        if v not in ('on', 'off'):
            raise Fail('%s is on or off' % k)
        save_app(a['dir'], {k: v == 'on'})
    elif k == 'winver':
        if v not in WINVERS:
            raise Fail('Windows version: one of %s' % ', '.join(w for w in WINVERS if w))
        save_app(a['dir'], {'winver': v})
    elif k == 'exe':
        real = os.path.realpath(v)
        if not (real.startswith(os.path.realpath(a['prefix']) + os.sep) and real.lower().endswith(PROGRAM_EXTS) and os.path.isfile(real)):
            raise Fail('Pick a program inside this app')
        save_app(a['dir'], {'exe': real, 'args': [], 'cwd': '', 'icon_from': '', 'installer': True})
        write_entry(load_app(a['dir']))
    elif k == 'name':
        v = v.strip()[:60]
        if not v:
            raise Fail('The name can\'t be empty')
        save_app(a['dir'], {'name': v})
        write_entry(load_app(a['dir']))
        if a['steam']:
            steam_set(load_app(a['dir']), True)
    else:
        raise Fail('Unknown setting %s' % k)
    return public(load_app(a['dir']))


