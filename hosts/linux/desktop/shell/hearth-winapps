def steam_set(a, on):
    def ch(d):
        lst = [e for e in d.get('apps', []) if isinstance(e, dict) and e.get('id') != 'hearth-winapps:' + a['id']]
        if on:
            icon = os.path.join(icon_dir(), a['id'] + '.png')
