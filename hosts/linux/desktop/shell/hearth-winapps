def tail_text(path, n):
    try:
        with open(path, 'rb') as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - 256 * 1024))
            lines = f.read().decode('utf-8', 'replace').splitlines()
    except OSError:
        return ''
    skip = max(0, len(lines) - n)
    return ('[… %d older lines left out …]\n' % skip if skip else '') + '\n'.join(lines[skip:])


def cmd_log(i):
    a = app(i)
    return {'id': a['id'], 'log': last_log(a) if os.path.isfile(last_log(a)) else '', 'tail': tail_text(last_log(a), 80),
            'detailedLog': detailed_log(a) if os.path.isfile(detailed_log(a)) else ''}


def vulkan_report():
    """What DXVK and VKD3D need: the Vulkan drivers this device has (64- and 32-bit) and what vulkaninfo says."""
    out = []
    for arch in ('x86_64-linux-gnu', 'i386-linux-gnu'):
        libs = []
        for d in ('/usr/lib/%s' % arch, '/usr/lib/%s/vulkan' % arch):
            try:
                libs += sorted(n for n in os.listdir(d) if n.startswith(('libvulkan_', 'libvulkan.so')))
            except OSError:
                pass
        out.append('Vulkan libraries (%s): %s' % (arch, ', '.join(sorted(set(libs))) or 'none'))
    try:
        icds = sorted(os.listdir('/usr/share/vulkan/icd.d'))
    except OSError:
        icds = []
    out.append('Vulkan drivers (icd.d): %s' % (', '.join(icds) or 'none'))
    if shutil.which('vulkaninfo'):
        try:
            p = subprocess.run(['vulkaninfo', '--summary'], capture_output=True, text=True, timeout=8)
            text = (p.stdout or '') + (p.stderr or '')
            keep = [l for l in text.splitlines() if re.search(
                r'(Vulkan Instance Version|GPU\d|apiVersion|driverVersion|vendorID|deviceType|deviceName|driverID|driverName|'
                r'driverInfo|conformanceVersion|ERROR|error|WARNING)', l)]
            out.append('--- vulkaninfo --summary (code %s)' % p.returncode)
            out += keep[:60] or text.splitlines()[:40]
        except (OSError, subprocess.SubprocessError) as e:
            out.append('vulkaninfo: %s' % e)
    else:
        out.append('vulkaninfo: not installed')
        if shutil.which('glxinfo'):
            try:
                p = subprocess.run(['glxinfo', '-B'], capture_output=True, text=True, timeout=15)
                out += [l for l in p.stdout.splitlines() if re.search(r'(Device|renderer|version)', l)][:12]
            except (OSError, subprocess.SubprocessError):
                pass
    return '\n'.join(out)


def cmd_report():
    """Send logs' "Windows apps" section: each app (install state, Proton, program, last result and the end of its
    last log), the Protons on this device, the built-in GE-Proton and Vulkan. The home folder is taken out by Send
    logs (logs.rs redact)."""
    out = []
    b, v = hp.builtin(), hp.valve()
    rules = hp.load_rules()
    want = rules.get('builtin', '')
    out.append('Built-in GE-Proton: %s%s' % ('%s at %s' % b if b else 'MISSING',
                                             '' if not want or (b and b[0] == want) else ' (Hearth\'s table expects %s)' % want))
    try:
        sysd = sorted(os.listdir(hp.system_dir()))
    except OSError:
        sysd = []
    out.append('In %s: %s' % (hp.system_dir(), ', '.join(sysd) or 'nothing'))
    out.append("Valve's Proton from Steam: %s" % ('%s at %s' % v if v else 'none'))
    d = hp.downloaded()
    out.append('Downloaded GE-Protons: %s' % (', '.join('%s (%s)' % kv for kv in sorted(d.items())) or 'none'))
    out.append('Steam folders: %s' % (', '.join(hp.steam_roots()) or 'none (Windows apps don\'t need one)'))
    ft = ['%s %s' % (b, 'yes' if os.path.exists('/usr/lib/%s/libfreetype.so.6' % d) else 'MISSING')
          for b, d in (('64-bit', 'x86_64-linux-gnu'), ('32-bit', 'i386-linux-gnu'))]
    out.append('FreeType (Wine draws text with it): %s' % ', '.join(ft))
    out.append('icoutils (programs\' own icons): %s' % ('yes' if shutil.which('wrestool') and shutil.which('icotool') else 'no'))
    lst = apps()
    out.append('Windows apps: %d (in %s)' % (len(lst), apps_root()))
    for a in lst:
        s = state(a)
        out.append('')
        out.append('--- %s (%s)' % (a['name'], a['id']))
        if a['installer']:
            inst = 'installed by %s' % (os.path.basename(a['source']) or 'an installer') if a['exe'] else \
                'its installer (%s) has installed nothing Hearth could find' % os.path.basename(a['source'])
        else:
            inst = 'a program opened directly' + (' (but it looks like an installer)' if a['exe'] and is_installer(a['exe']) else '')
        out.append('state: %s' % inst)
        out.append('program: %s%s' % (a['exe'] or '(none)', (' ' + ' '.join(a['args'])) if a['args'] else ''))
        if a['cwd']:
            out.append('folder: %s' % a['cwd'])
        out.append('Proton: %s; DXVK %s, VKD3D %s, Windows version %s; in Steam: %s' % (
            a['proton'] or 'automatic', 'on' if a['dxvk'] else 'off', 'on' if a['vkd3d'] else 'off',
            winver_needed(a) or "Proton's own", 'yes' if a['steam'] else 'no'))
        try:
            pick = hp.pick(key(a), a['exe'] or a['source'])
        except Exception:  # noqa: BLE001 - a report never fails on one app
            pick = None
        out.append('the detector would start it with: %s' % (pick['name'] if pick else 'nothing (no Proton)'))
        if s.get('at'):
            out.append('last start: %s, %s with %s, closed after %s with code %s%s' % (
                time.strftime('%Y-%m-%d %H:%M', time.localtime(s['at'])), s.get('what', 'started'), s.get('proton'),
                describe(float(s.get('seconds') or 0)), s.get('code'), ' (closed right away)' if s.get('crashed') else ''))
        else:
            out.append('last start: never')
        out.append('menu entry: %s' % ('yes' if os.path.isfile(desktop_path(a['id'])) else 'no'))
        if os.path.isfile(last_log(a)):
            out.append('--- end of its last log (%s)' % last_log(a))
            out.append(tail_text(last_log(a), 80))
        if os.path.isfile(detailed_log(a)):
            out.append('--- end of its detailed Proton log (%s)' % detailed_log(a))
            out.append(tail_text(detailed_log(a), 120))
    out.append('')
    out.append('--- Vulkan (DXVK and VKD3D draw through it)')
    out.append(vulkan_report())
    return '\n'.join(out)


def main(argv):
    a = argv[1:]
    try:
        if a[:1] == ['open'] and len(a) == 2:
            r = cmd_open(a[1])
        elif a[:1] == ['run'] and len(a) in (2, 4) and (len(a) == 2 or a[2] == '--proton'):
            r = cmd_run(a[1], a[3] if len(a) == 4 else None)
        elif a[:1] == ['detailed'] and len(a) == 3:
            r = cmd_detailed(a[1], a[2])
        elif a[:1] == ['log'] and len(a) == 2:
            r = cmd_log(a[1])
        elif a == ['report']:
            print(cmd_report(), flush=True)
            return 0
        elif a == ['list']:
            r = cmd_list()
        elif a[:1] == ['protons'] and len(a) == 2:
            r = cmd_protons(a[1])
        elif a[:1] == ['set'] and len(a) == 4:
            r = cmd_set(a[1], a[2], a[3])
        elif a[:1] == ['exes'] and len(a) == 2:
            r = cmd_exes(a[1])
        elif a[:1] == ['steam'] and len(a) == 3:
            r = cmd_steam(a[1], a[2])
        elif a[:1] == ['remove'] and len(a) == 2:
            r = cmd_remove(a[1])
        elif a[:1] == ['fetch'] and len(a) == 2:
            r = cmd_fetch(a[1])
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except (Fail, ValueError, OSError) as e:
        print('error: %s' % e, flush=True)
        if a[:1] == ['open']:
            notify("Couldn't open that Windows program", str(e))
        return 1
    print(json.dumps(r), flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
