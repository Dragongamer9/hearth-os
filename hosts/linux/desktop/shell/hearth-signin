#!/usr/bin/python3
"""hearth-signin: a store sign-in asked for in Game Mode, opened in Desktop Mode (where windows, the mouse and the
keyboard work normally). Run by labwc's autostart when Desktop Mode starts.

  hearth-signin desktop-start   take Game Mode's request, if any, and open Hearth in a window at that sign-in
  hearth-signin take            print the store a fresh request asks for (and remove the request), or nothing

Game Mode's Hearth writes $XDG_STATE_HOME/hearth/desktop-signin.json ({"store": "epic", "at": <seconds>}) and
switches to Desktop Mode. A request is used once, and only when it's under 10 minutes old. Hearth opens with
`--windowed --signin <store>`; if a windowed Hearth is already open, the request is handed to it instead
($XDG_RUNTIME_DIR/hearth-signin-route.json, which it looks for every couple of seconds).
The same rules are in hosts/hearth-core/src/signin_handoff.rs.
"""
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time

# crate::stores::STORES, plus Steam (its own window). Kept equal by test_hearth_signin.py.
STORES = ('epic', 'gog', 'xbox')
VALID = STORES + ('steam',)
MAX_AGE = 600          # 10 minutes
ROUTE_MAX_AGE = 60
SKEW = 60              # a clock a minute ahead is fine


def home():
    return os.environ.get('HOME') or os.path.expanduser('~')


def request_path():
    state = os.environ.get('XDG_STATE_HOME') or os.path.join(home(), '.local', 'state')
    return os.path.join(state, 'hearth', 'desktop-signin.json')


def route_path():
    return os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'hearth-signin-route.json')


def log(text):
    try:
        d = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.join(home(), '.local', 'share'), 'nimbus')
        os.makedirs(d, exist_ok=True)
        with open(os.path.join(d, 'session.log'), 'a') as f:
            f.write(time.strftime('%Y-%m-%d %H:%M:%S') + ' sign-in: ' + text + '\n')
    except OSError:
        pass


def parse(text, now, max_age=MAX_AGE):
    """The store a request asks for, if it's one Hearth knows and the request is fresh; otherwise None."""
    try:
        v = json.loads(text)
    except (ValueError, TypeError):
        return None
    if not isinstance(v, dict):
        return None
    store, at = v.get('store'), v.get('at')
    if not isinstance(store, str) or store not in VALID:
        return None
    if isinstance(at, bool) or not isinstance(at, (int, float)):
        return None
    if at > 1e11:          # milliseconds
        at = at / 1000.0
    age = now - at
    if age < -SKEW or age >= max_age:
        return None
    return store


def take(path=None, now=None, max_age=MAX_AGE):
    """Reads the request and removes it, fresh or not (moved aside first, so it's only ever taken once)."""
    path = path or request_path()
    taken = '%s.taken-%d' % (path, os.getpid())
    try:
        os.rename(path, taken)
    except OSError:
        return None
    try:
        with open(taken, encoding='utf-8', errors='replace') as f:
            text = f.read(4096)
    except OSError:
        text = ''
    try:
        os.remove(taken)
    except OSError:
        pass
    return parse(text, time.time() if now is None else now, max_age)


def running_hearth(proc='/proc', uid=None):
    """The process id of a windowed Hearth of this user that's open (`nimbus --windowed ...`), or None."""
    uid = os.getuid() if uid is None else uid
    me = os.getpid()
    try:
        pids = [p for p in os.listdir(proc) if p.isdigit()]
    except OSError:
        return None
    for p in sorted(pids, key=int):
        if int(p) == me:
            continue
        d = os.path.join(proc, p)
        try:
            if os.stat(d).st_uid != uid:
                continue
            with open(os.path.join(d, 'cmdline'), 'rb') as f:
                argv = [a.decode('utf-8', 'replace') for a in f.read().split(b'\0') if a]
        except OSError:
            continue
        if argv and os.path.basename(argv[0]) in ('nimbus', 'hearth') and '--windowed' in argv[1:]:
            return int(p)
    return None


def hand_over(store, now=None):
    """Gives the request to the windowed Hearth that's open."""
    path = route_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix='.hearth-signin-')
    with os.fdopen(fd, 'w') as f:
        json.dump({'store': store, 'at': int(time.time() if now is None else now)}, f)
    os.replace(tmp, path)


def app():
    """The Hearth app: the session's NIMBUS_APP, or the installed one."""
    for c in (os.environ.get('NIMBUS_APP'), '/usr/bin/nimbus', shutil.which('nimbus')):
        if c and os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    return None


def command(store):
    exe = app()
    return [exe, '--windowed', '--signin', store] if exe else None


def desktop_start(wait=3.0):
    store = take()
    if not store:
        return 0
    log('%s: asked for in Game Mode' % store)
    time.sleep(wait)          # let the taskbar and the rest of the desktop come up first
    pid = running_hearth()
    if pid:
        hand_over(store)
        log('%s: handed to the Hearth window that is open (%d)' % (store, pid))
        return 0
    cmd = command(store)
    if not cmd:
        log('%s: Hearth app not found' % store)
        return 1
    subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    log('%s: opened %s' % (store, ' '.join(cmd)))
    return 0


def main(argv):
    what = argv[1] if len(argv) > 1 else ''
    if what == 'desktop-start':
        return desktop_start()
    if what == 'take':
        s = take()
        if s:
            print(s)
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv))
