def hour_clock(hhmm):
    h, m = int(hhmm[:2]), int(hhmm[3:])
    return '%d:%02d %s' % (h % 12 or 12, m, 'AM' if h < 12 else 'PM')


def backup_words(x, t):
    """"tonight 4:00 AM", "Nov 25, stopped", "Nov 25 4:00 AM" from a world backup's name (YYYY-MM-DD HHMM why.tar.gz)."""
    m = re.match(r'(\d{4})-(\d{2})-(\d{2}) (\d{2})(\d{2})( (.+))?\.tar\.gz$', x.get('file', ''))
    if not m:
        return x.get('file', '')
    ts = datetime.datetime(int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4)), int(m.group(5))).timestamp()
    why = m.group(7) or ''
    if why and why != 'nightly':
        return '%s, %s' % (short_day(ts), why)
    if datetime.date.fromtimestamp(ts) == datetime.date.fromtimestamp(t) or 0 < t - ts < 6 * 3600:
        return 'tonight %s' % clock(ts)
    return '%s %s' % (short_day(ts), clock(ts))


