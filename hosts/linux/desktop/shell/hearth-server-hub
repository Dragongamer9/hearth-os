def retro_games(limit=60):
    """Hearth Retro's games (the ROM folders it uses: RetroDECK's and EmuDeck's, one folder a system), newest first;
    each streams through Hearth Retro's own --play, in the emulator it set up."""
    out = []
    for root_ in RETRO_ROOTS:
        try:
            systems = sorted(os.listdir(root_))
        except OSError:
            continue
        for sysname in systems:
            d = os.path.join(root_, sysname)
            try:
                files = os.listdir(d)
            except OSError:
                continue
            for n in files:
                p = os.path.join(d, n)
                if n.startswith('.') or n.lower().endswith(RETRO_SKIP) or not os.path.isfile(p):
                    continue
                title = re.sub(r'\s*[\(\[][^)\]]*[\)\]]', '', os.path.splitext(n)[0]).strip() or n
                out.append({'id': 'retro-' + hashlib_short(p), 'name': title[:60], 'kind': 'retro', 'file': p, 'system': sysname,
                            'art': RETRO_ART.get(sysname.lower()), 'last': int(os.path.getmtime(p))})
    out.sort(key=lambda g: -g['last'])
    return out[:limit]


def hashlib_short(text):
    import hashlib
    return hashlib.sha1(text.encode('utf-8', 'surrogateescape')).hexdigest()[:12]


