def steam_library():
    """The games installed in Steam on this PC (its appmanifest files: only their names and ids are read), the newest
    played first, then your own games."""
    out = []
    try:
        names = os.listdir(STEAM_APPS)
    except OSError:
        names = []
    for n in names:
        m = re.fullmatch(r'appmanifest_(\d+)\.acf', n)
        if not m:
            continue
        try:
            with open(os.path.join(STEAM_APPS, n), encoding='utf-8', errors='replace') as f:
                txt = f.read(65536)
        except OSError:
            continue
        nm = re.search(r'"name"\s+"([^"]+)"', txt)
        lp = re.search(r'"LastPlayed"\s+"(\d+)"', txt)
        if nm and not re.search(r'Proton|Steam Linux Runtime|Steamworks', nm.group(1)):
            out.append({'id': 'steam-' + m.group(1), 'name': nm.group(1), 'kind': 'steam', 'last': int(lp.group(1)) if lp else 0})
    out.sort(key=lambda g: -g['last'])
    for gid, (name, *_r) in OWN.items():
        out.append({'id': gid, 'name': name, 'kind': 'own', 'art': OWN_ART.get(gid)})
    out += retro_games()
    out.append({'id': 'desktop', 'name': 'The whole desktop', 'kind': 'desktop'})
    return out


