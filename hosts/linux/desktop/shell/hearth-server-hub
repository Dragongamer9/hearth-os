def in_span(days, t):
    d = datetime.datetime.fromtimestamp(t)
    v = days.get(DAYS[d.weekday()]) if isinstance(days, dict) else None
    if not (isinstance(v, list) and len(v) == 2):
        return False
    hm = d.strftime('%H:%M')
    return v[0] <= hm < v[1]


def tick(t=None):
    """Once every 5 minutes: each game server's schedule, stopping one nobody's been on for a while, a fair share of
    the CPU while you play here, the players this hour, and the streaming rules. Small reads only."""
    t = t or now()
    s = settings()
    g = s['games']
    catalog()
    m = sa()
    did = []
    apps = {a['id']: a for a in m.list_apps().get('apps') or [] if a.get('kind') == 'game'}
    st = seen()
    hour = datetime.datetime.fromtimestamp(t).strftime('%Y-%m-%dT%H')
    total = 0
    idle = st.get('idle') or {}
    for gid, a in apps.items():
        sched = (g.get('schedule') or {}).get(gid) or {}
        if sched and a.get('installed'):
            want = in_span(sched, t)
            if want and not a.get('running'):
                m.switch(gid, True)
                did.append('started %s (its schedule)' % gid)
            elif not want and a.get('running') and not players(gid).get('n'):
                m.switch(gid, False)
                did.append('stopped %s (its schedule)' % gid)
        if a.get('running'):
            n = int(players(gid).get('n') or 0)
            total += n
            idle[gid] = 0 if n else int(idle.get(gid) or 0) + 5
            if g.get('idleStop') and idle[gid] >= int(g['idleStop']) and not sched:
                m.switch(gid, False)
                idle[gid] = 0
                did.append("stopped %s (nobody on for %d min)" % (gid, int(g['idleStop'])))
            # Pause while you play here: the servers get a small share of the CPU (never stopped: players stay on).
            weight = '10' if (g.get('pauseWhilePlaying') and game_playing()) else '100'
            cmd(['systemctl', '--user', 'set-property', '--runtime', m.unit(gid), 'CPUWeight=' + weight], 15)
    streaming = play_rules(s, t, did)

    def change(d):
        p = d.get('players') if isinstance(d.get('players'), dict) else {}
        p[hour] = max(int(p.get(hour) or 0), total)
        for k in sorted(p)[:-24 * 8]:
            del p[k]
        d['players'] = p
        d['idle'] = idle
        if streaming:
            w = d.get('streamed') if isinstance(d.get('streamed'), dict) else {}
            key = '%s|%s' % (datetime.date.fromtimestamp(t).isoformat(), streaming)
            w[key] = int(w.get(key) or 0) + 5
            for k in sorted(w)[:-60]:
                del w[k]
            d['streamed'] = w
    seen_update(change)
    return {'ok': True, 'did': did}


