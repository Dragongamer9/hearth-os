def world_info(gid, opts):
    """Valheim's world: its seed (from the .fwl file) and day, where known."""
    def live():
        catalog()
        d = sa().data_dir(gid, 'config')
        w = opts.get('worldName') or 'Hearth'
        p = os.path.join(d, 'worlds_local', w + '.fwl')
        with open(p, 'rb') as f:
            b = f.read(4096)
        i = 8

        def s7(i):
            n, shift = 0, 0
            while True:
                c = b[i]
                i += 1
                n |= (c & 0x7f) << shift
                shift += 7
                if not c & 0x80:
                    return b[i:i + n].decode('utf-8', 'replace'), i + n
        _, i = s7(i)
        seed, i = s7(i)
        return {'seed': seed}
    return src('world.' + gid, live, {}) or {}


