    month_hit, month_miss = int(v.get('monthHit') or 0), int(v.get('monthMiss') or 0)
    pct = round(100 * month_hit / (month_hit + month_miss)) if month_hit + month_miss else 0
    internet = float(v.get('internetMbps') or 300)
    wait = float(v.get('waitMbps') or internet)     # what downloads from the internet really averaged
    saved = int(total.get('hit') or 0)
    since = total.get('since') or 0
    now_rows = v.get('now') or []
    top = now_rows[0] if now_rows else None
    stores = c.get('stores') or {}
    dev_month = v.get('devicesMonth') or {}
    mx = max([int(x) for x in dev_month.values()] or [1]) or 1
    games = list(v.get('games') or [])      # in the order each was first cached
    rows = []
    for x in games[:7]:
        last = int(x.get('last') or 0)
        rows.append({'game': x.get('game') or '', 'store': x.get('store') or '', 'cached': gb(x.get('miss') or 0), 'by': ', '.join(x.get('devices') or []),
                     'saved': gb(x.get('hit') or 0), 'used': 'now' if top and (top.get('what') or '').startswith(x.get('game') or '-') else
                     ('today' if now() - last < 3600 else short_day(last)) if last else ''})
