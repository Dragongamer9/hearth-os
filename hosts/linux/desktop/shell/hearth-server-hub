PING_MS = re.compile(r'(?:time[=<]|in )([\d.]+) ?ms')


def stream_peer_ip(stream, ts):
    """The streaming device's address: the Tailscale device receiving the stream (hearth-remote-desktop sees it), or
    the device by Moonlight's name for it on your tailnet (Tailscale goes straight across your home network too)."""
    if stream.get('peerIp'):
        return stream['peerIp']
    who = _norm(stream.get('who') or stream.get('device') or '')
    for p in ts.get('peers') or []:
        if who and (_norm(p.get('name')) == who or who.startswith(_norm(p.get('name')) or '-')):
            return p.get('ip') or ''
    return ''


def ping_ms(ip):
    code, o, _ = cmd(['ping', '-n', '-c', '1', '-W', '1', ip], 4)
    m = PING_MS.search(o or '')
    if code == 0 and m:
        return round(float(m.group(1)))
    code, o, _ = cmd(['tailscale', 'ping', '--c', '1', '--timeout', '2s', ip], 5)
    m = PING_MS.search(o or '')
    return round(float(m.group(1))) if m else None


def frame_grab(out=SHOT):
    """A small picture of what's being streamed (this PC's screen is the stream): grim on the desktop, gamescope's own
    screenshot in Game Mode; scaled down with ffmpeg when it's there. Kept in ~/.cache only."""
    os.makedirs(os.path.dirname(out), exist_ok=True)
    tmp = out + '.png'
    ok = False
    if os.environ.get('WAYLAND_DISPLAY') and have('grim'):
        ok = cmd(['grim', '-s', '0.4', tmp], 10)[0] == 0
    elif os.environ.get('DISPLAY') and have('xprop'):
        before = set(os.listdir('/tmp'))
        if cmd(['xprop', '-root', '-f', 'GAMESCOPECTRL_REQUEST_SCREENSHOT', '32c', '-set', 'GAMESCOPECTRL_REQUEST_SCREENSHOT', '1'], 5)[0] == 0:
            for _ in range(15):
                time.sleep(0.2)
                new = [n for n in os.listdir('/tmp') if n not in before and n.startswith('gamescope_') and n.endswith('.png')]
                if new:
                    shutil.move(os.path.join('/tmp', new[0]), tmp)
                    ok = True
                    break
    if not ok:
        return ''
    if have('ffmpeg'):
        ok = cmd(['ffmpeg', '-nostdin', '-loglevel', 'error', '-y', '-i', tmp, '-vf', 'scale=640:-2', '-q:v', '5', out], 20)[0] == 0
        os.unlink(tmp)
    else:
        os.replace(tmp, out)
    return out if ok else ''


def play_watch():
    """While a stream is on: the delay to the device every 5 seconds (the network's round trip, what Moonlight calls
    its network latency) and a small picture of the stream every 20, then it ends with the stream. Started by the
    Remote play page or the timer as a transient user unit; nothing of it stays after the stream."""
    n = 0
    while True:
        st = rd_status()
        stream = st.get('stream') or {}
        if not stream.get('on'):
            break
        ip = stream_peer_ip(stream, ts_status())
        ms = ping_ms(ip) if ip else None
        if ms is not None:
            try:
                with open(DELAYS, encoding='utf-8') as f:
                    d = json.load(f)
            except (OSError, ValueError):
                d = {}
            if d.get('since') != stream.get('since'):
                d = {'since': stream.get('since'), 'samples': []}
            d['samples'] = (d.get('samples') or [])[-119:] + [ms]
            sio.write_text(DELAYS, json.dumps(d))
        if n % 4 == 0:
            frame_grab()
        n += 1
        time.sleep(5)
    for f in (DELAYS, SHOT):
        try:
            os.unlink(f)
        except OSError:
            pass
    return {'ok': True}


