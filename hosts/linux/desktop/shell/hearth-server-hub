def sleep_tick(s, st, did):
    """Let it sleep after 30 min with nobody: only when it can be woken again (its network card known for
    Wake-on-LAN), nobody streams or plays here or is on a game server, nothing of Hearth's is copying or recording,
    and nobody touched it for 30 minutes; it says so 5 minutes before. Never at start-up (the PC up 30 min first)."""
    p = s['play']
    if not p.get('sleepAfter') or not (p.get('wakeMac') or my_mac()):
        st.pop('quietSince', None)
        return
    t = now()
    busy = bool((rd_status().get('stream') or {}).get('on')) or game_playing() or busy_here()
    for gid in running_apps():
        if int(players(gid).get('n') or 0):
            busy = True
    code, o, _ = cmd(['systemctl', '--user', 'list-units', '--state=active', '--no-legend', '--plain',
                      'hearth-media-*', 'hearth-join-*', 'hearth-moonlight-*', 'hearth-backup*', 'hearth-vault*'], 10)
    if o.strip():
        busy = True
    code, idle, _ = cmd(['loginctl', 'show-session', os.environ.get('XDG_SESSION_ID', 'self'), '-p', 'IdleHint', '--value'], 5)
    if idle.strip() == 'no' and os.environ.get('XDG_SESSION_ID'):
        busy = True
    try:
        up = float(open('/proc/uptime').read().split()[0])
    except (OSError, ValueError):
        up = 0
    if busy or up < 1800:
        st['quietSince'] = int(t)
        st.pop('sleepTold', None)
        return
    quiet = t - int(st.get('quietSince') or t)
    st.setdefault('quietSince', int(t))
    if quiet >= 25 * 60 and not st.get('sleepTold'):
        st['sleepTold'] = int(t)
        cmd(['notify-send', '-a', 'Hearth', 'Home server', 'Nobody has used this PC for 25 minutes: it sleeps in 5. Wake it from Moonlight or any Hearth device.'], 10)
    elif quiet >= 30 * 60 and st.get('sleepTold'):
        st['quietSince'] = int(t)
        st.pop('sleepTold', None)
        did.append('sleeping: nobody for 30 minutes')
        cmd(['systemctl', 'suspend'], 30)


def play_rules(s, t, did):
    """While someone streams: Colibri and Imagine stopped to free the graphics card (started again after), the game
    servers stopped unless you keep them; the Model vault's upload waits for $XDG_RUNTIME_DIR/hearth-streaming."""
    p = s['play']
    st = rd_status()
    stream = st.get('stream') or st.get('streaming') or {}
    on = bool(stream.get('on'))
    rt = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
    mark = os.path.join(rt, 'hearth-streaming')
    gpu_units = ['hearth-colibri.service', 'hearth-imagine.service']
    if on:
        if p.get('pauseVault'):
            sio.write_text(mark, '%d\n' % int(t))
        if p.get('freeGpu'):
            for u in gpu_units:
                code, o, _ = cmd(['systemctl', '--user', 'is-active', u], 10)
                if o.strip() == 'active':
                    cmd(['systemctl', '--user', 'stop', '--no-block', u], 15)
                    sio.write_text(os.path.join(rt, 'hearth-hub-stopped-' + u), 'stream\n')
                    did.append('stopped %s for the stream' % u)
        return short_name(stream.get('device')) or 'a device'
    for u in gpu_units:
        f = os.path.join(rt, 'hearth-hub-stopped-' + u)
        if os.path.exists(f):
            os.unlink(f)
            cmd(['systemctl', '--user', 'start', '--no-block', u], 15)
            did.append('started %s again' % u)
    if os.path.exists(mark):
        os.unlink(mark)
    return ''


