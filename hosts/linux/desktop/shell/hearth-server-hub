def media_space(scan):
    """Space: the media drive itself (its size, what's used) and each kind's share, from the files."""
    def live():
        os.makedirs(MEDIA, exist_ok=True) if os.path.isdir(HOME) else None
        u = shutil.disk_usage(os.path.realpath(MEDIA))
        code, o, _ = cmd(['findmnt', '-n', '-o', 'LABEL', '-T', os.path.realpath(MEDIA)], 5)
        label = (o.strip() or 'Media drive')
        k = scan.get('kinds') or {}
        bits = ', '.join('%s %s' % (n, gb(b).replace(' TB', '').replace(' GB', '') if b >= 1e12 else gb(b)) for n, b in sorted(k.items(), key=lambda x: -x[1]) if b)
        return {'title': '%s · %s' % (label, gb(u.total, 0)), 'used': u.used / u.total if u.total else 0,
                'line': '%s used%s' % (gb(u.used), ' · ' + bits if bits else '')}
    return src('space', live, {}) or {}


