def magic_packet(mac):
    m = re.fullmatch(r'([0-9a-fA-F]{2})[:-]?' * 5 + r'([0-9a-fA-F]{2})', mac or '')
    if not m:
        raise Fail("the PC's network card isn't known yet: open this page on the PC once")
    hw = bytes(int(x, 16) for x in m.groups())
    return b'\xff' * 6 + hw * 16


def send_wol(mac):
    """A Wake-on-LAN packet for that network card, on this device's own network."""
    pkt = magic_packet(mac)
    if faking():
        return True
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for port in (9, 7):
            s.sendto(pkt, ('255.255.255.255', port))
    finally:
        s.close()
    return True


def my_mac():
    """This PC's wired network card (the one Wake-on-LAN wakes), from /sys."""
    for n in sorted(os.listdir('/sys/class/net')) if os.path.isdir('/sys/class/net') else []:
        if n.startswith(('en', 'eth')):
            try:
                return open('/sys/class/net/%s/address' % n).read().strip()
            except OSError:
                pass
    return ''


def play_wake(peer=''):
    """Wake the PC: on this network straight away; from away (Wake it from away, over Tailscale) another of your
    Hearth devices that's on at home sends the packet for you over Hearth Link (Wake-on-LAN can't cross the internet)."""
    mac = settings()['play'].get('wakeMac') or ''
    if peer:
        if not re.fullmatch(r'[0-9a-f]{64}', peer):
            raise Fail('not one of your devices')
        res = link_call('server.wake', {'peer': peer}, 120)
        return {'ok': True, 'via': res.get('via') or ''}
    send_wol(mac)
    return {'ok': True}


