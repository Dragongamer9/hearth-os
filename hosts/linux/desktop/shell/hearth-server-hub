# --- players: Steam's server query (A2S) and Minecraft's server list ping, both read only

def a2s(port, host='127.0.0.1', timeout=1.5):
    """(players, max, [(name, seconds)]) from a Steam-query server (Valheim, Palworld, 7 Days to Die, Ark)."""
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(timeout)
    try:
        req = b'\xff\xff\xff\xffTSource Engine Query\x00'
        s.sendto(req, (host, port))
        data = s.recv(1400)
        if data[4:5] == b'A':                       # a challenge first (newer servers)
            s.sendto(req + data[5:9], (host, port))
            data = s.recv(1400)
        info = a2s_info(data)
        s.sendto(b'\xff\xff\xff\xffU\xff\xff\xff\xff', (host, port))
        ch = s.recv(1400)
        names = []
        if ch[4:5] == b'A':
            s.sendto(b'\xff\xff\xff\xffU' + ch[5:9], (host, port))
            names = a2s_players(s.recv(4096))
        return info[0], info[1], names
    finally:
        s.close()


def _cstr(b, i):
    j = b.index(b'\x00', i)
    return b[i:j].decode('utf-8', 'replace'), j + 1


def a2s_info(data):
    if data[4:5] != b'I':
        raise ValueError('not an A2S_INFO answer')
    i = 6
    for _ in range(4):                 # name, map, folder, game
        _, i = _cstr(data, i)
    i += 2                             # the app id
    return data[i], data[i + 1]


def a2s_players(data):
    if data[4:5] != b'D':
        return []
    n, i, out = data[5], 6, []
    for _ in range(n):
        i += 1
        name, i = _cstr(data, i)
        _score, secs = struct.unpack_from('<lf', data, i)
        i += 8
        if name:
            out.append((name, int(secs)))
    return out


def _varint(n):
    out = b''
    while True:
        b = n & 0x7f
        n >>= 7
        out += bytes([b | (0x80 if n else 0)])
        if not n:
            return out


def slp(port=25565, host='127.0.0.1', timeout=1.5):
    """(players, max, [names]) from a Minecraft server's list ping."""
    with socket.create_connection((host, port), timeout) as s:
        hs = b'\x00' + _varint(767) + _varint(len(host)) + host.encode() + struct.pack('>H', port) + b'\x01'
        s.sendall(_varint(len(hs)) + hs + b'\x01\x00')
        buf = b''
        while True:
            c = s.recv(65536)
            if not c:
                break
            buf += c
            try:
                j = json.loads(buf[buf.index(b'{'):].decode('utf-8'))
                break
            except ValueError:
                continue
    p = j.get('players') or {}
    return p.get('online', 0), p.get('max', 0), [x.get('name', '') for x in p.get('sample') or []]


RAKNET_MAGIC = bytes.fromhex('00ffff00fefefefefdfdfdfd12345678')


def raknet_ping(port=19132, host='127.0.0.1', timeout=1.5):
    """(players, max) from a Bedrock server's unconnected ping (RakNet; its answer is "MCPE;motd;…;players;max;…")."""
    s_ = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s_.settimeout(timeout)
    try:
        s_.sendto(b'\x01' + struct.pack('>q', int(time.time() * 1000)) + RAKNET_MAGIC + struct.pack('>q', 0x48454152), (host, port))
        data = s_.recv(2048)
    finally:
        s_.close()
    if data[:1] != b'\x1c':
        raise ValueError('not a Bedrock answer')
    n = struct.unpack_from('>H', data, 33)[0]
    parts = data[35:35 + n].decode('utf-8', 'replace').split(';')
    return int(parts[4]), int(parts[5])


