LINK_HOME = os.environ.get('HEARTH_LINK_HOME') or os.path.join(HOME, '.local', 'share', 'nimbus', 'link')


def updates_served():
    """Hearth OS updates your devices got from this PC instead of the internet (Hearth Link counts what it serves:
    updates-served.json, {day: {device: bytes}}), and what this PC fetched once for them (its update copy's size)."""
    def live():
        try:
            with open(os.path.join(LINK_HOME, 'updates-served.json'), encoding='utf-8') as f:
                days = json.load(f)
        except (OSError, ValueError):
            days = {}
        hit, devs, last = 0, set(), 0
        for day, per in (days.items() if isinstance(days, dict) else []):
            for dev, b in (per.items() if isinstance(per, dict) else []):
                hit += int(b or 0)
                devs.add(dev)
            try:
                last = max(last, int(datetime.datetime.fromisoformat(day).timestamp()) + 86399)
            except ValueError:
                pass
        miss = 0
        for dp, _d, files in os.walk(os.path.join(LINK_HOME, 'updates')):
            for n in files:
                try:
                    miss += os.path.getsize(os.path.join(dp, n))
                except OSError:
                    pass
        return {'hit': hit, 'miss': miss, 'devices': len(devs), 'last': last} if hit or miss else None
    return src('updatesServed', live, None)


