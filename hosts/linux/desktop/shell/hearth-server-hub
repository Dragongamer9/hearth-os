def game_addrs(gid):
    """The addresses connected to a game server right now: inside its container (/proc/net) and Podman's own
    forwarding on this PC (ss: pasta keeps each player's address)."""
    def live():
        host, inner = game_ports(gid)
        out = set()
        code, o, _ = cmd(['podman', 'exec', 'hearth-app-' + gid, 'cat', '/proc/net/tcp', '/proc/net/tcp6', '/proc/net/udp', '/proc/net/udp6'], 10)
        if code == 0:
            out |= proc_net_peers(o, inner)
        code, o, _ = cmd(['ss', '-Hntu', 'state', 'established'], 10)
