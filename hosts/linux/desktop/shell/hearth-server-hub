def player_addrs(gid, names):
    """{player: address} for the players on now. Minecraft: its own log says each player's address. Other games: when
    one player is on from one address that's theirs; otherwise what the 5-minute timer learned (a new player and a new
    address in the same 5 minutes, and nobody else came or went), remembered for next time."""
    out = {}
    if gid == 'minecraft':
        out.update({k: v for k, v in minecraft_addrs(log_lines(gid)).items() if k in names})
    learned = src('whoIs.' + gid, lambda: (seen().get('whoIs') or {}).get(gid), {}) or {}
    addrs = game_addrs(gid)
    for n in names:
        if n not in out and learned.get(n) in addrs:
            out[n] = learned[n]
    left = [n for n in names if n not in out]
    free = [x for x in addrs if x not in out.values()]
    if len(left) == 1 and len(free) == 1:
        out[left[0]] = free[0]
    return out


def learn_addrs(st, gid, names, addrs):
    """The timer's part of player_addrs: compares who and which addresses were on 5 minutes ago."""
    prev = (st.get('flows') or {}).get(gid) or {}
    new_n = [n for n in names if n not in (prev.get('names') or [])]
    new_a = [a for a in addrs if a not in (prev.get('addrs') or [])]
    gone = [n for n in prev.get('names') or [] if n not in names]
    who = st.setdefault('whoIs', {}).setdefault(gid, {})
    if len(new_n) == 1 and len(new_a) == 1 and not gone:
        who[new_n[0]] = new_a[0]
    if len(names) == 1 and len(addrs) == 1:
        who[names[0]] = addrs[0]
    for k in list(who)[:-200]:
        del who[k]
    st.setdefault('flows', {})[gid] = {'names': list(names), 'addrs': list(addrs)}


def shared_with(s, ts, apps, sel):
    """Who this game is shared with: everyone you shared this PC with on Tailscale (its shared-in devices say whose they
    are) and who you made an invite for here (Make an invite link: "for whom"), with the games each was invited to."""
    shared = s.get('shared') if isinstance(s.get('shared'), dict) else {}
    out, seen_ = [], set()
    for who, games in shared.items():
        if isinstance(games, list) and games and sel not in games:
            if len(games) == 1:
                out.append('%s (%s only)' % (who, (apps.get(games[0]) or {}).get('name') or OWN.get(games[0], (games[0],))[0]))
