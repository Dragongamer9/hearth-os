def r2_profile(gid, mods):
    """r2modman's profile export (export.r2x in a zip), what Thunderstore's profile codes carry."""
    import io
    import zipfile
    lines = ['profileName: Hearth %s' % gid.title(), 'mods:']
    for m in mods:
        ma, mi, pa = m['version'].split('.')
        lines += ['  - name: %s' % m['id'], '    version:', '      major: %s' % ma, '      minor: %s' % mi, '      patch: %s' % pa, '    enabled: true']
