def archive_search(title):
    """Public-domain films on the Internet Archive (its own search API, the feature_films collection)."""
    q = 'title:(%s) AND collection:(feature_films) AND mediatype:(movies)' % re.sub(r'[^\w\s\'-]', ' ', title)
    url = 'https://archive.org/advancedsearch.php?' + urllib.parse.urlencode({'q': q, 'fl[]': ['identifier', 'title', 'year', 'licenseurl'], 'rows': 5, 'output': 'json'}, doseq=True)
    with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'Hearth'}), timeout=20) as r:
