    for d in links:
        if d.get('kind') in ('handheld', 'laptop', 'desktop') and not any(_norm(d.get('name')) == _norm(n) for n in names):
            names.append(d.get('name'))
    if not names:
        names = [v['name'] for v in DEVICE_DEFAULTS.values()] if faking() else []
    mine = s.get('devices') or {}
    streamed = src('streamed', lambda: None, None) or seen().get('streamed') or {}
    out = []
    for name in names[:6]:
        did = next((k for k, v in DEVICE_DEFAULTS.items() if v['name'] == name), dev_id(name))
