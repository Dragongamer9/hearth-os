def magic_packet(mac):
    m = re.fullmatch(r'([0-9a-fA-F]{2})[:-]?' * 5 + r'([0-9a-fA-F]{2})', mac or '')
    if not m:
        raise Fail("the PC's network card isn't known yet: open this page on the PC once")
    hw = bytes(int(x, 16) for x in m.groups())
    return b'\xff' * 6 + hw * 16


def play_wake():
    mac = settings()['play'].get('wakeMac') or ''
    pkt = magic_packet(mac)
    if faking():
        return {'ok': True}
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for port in (9, 7):
            s.sendto(pkt, ('255.255.255.255', port))
    finally:
        s.close()
    return {'ok': True}


def play_rules(s, t, did):
    """While someone streams: Colibri and Imagine stopped to free the graphics card (started again after), the game
    servers stopped unless you keep them; the Model vault's upload waits for $XDG_RUNTIME_DIR/hearth-streaming."""
    p = s['play']
    st = rd_status()
    stream = st.get('stream') or st.get('streaming') or {}
    on = bool(stream.get('on'))
    rt = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
    mark = os.path.join(rt, 'hearth-streaming')
    gpu_units = ['hearth-colibri.service', 'hearth-imagine.service']
    if on:
        if p.get('pauseVault'):
            sio.write_text(mark, '%d\n' % int(t))
        if p.get('freeGpu'):
            for u in gpu_units:
                code, o, _ = cmd(['systemctl', '--user', 'is-active', u], 10)
                if o.strip() == 'active':
                    cmd(['systemctl', '--user', 'stop', '--no-block', u], 15)
                    sio.write_text(os.path.join(rt, 'hearth-hub-stopped-' + u), 'stream\n')
                    did.append('stopped %s for the stream' % u)
        return short_name(stream.get('device')) or 'a device'
    for u in gpu_units:
        f = os.path.join(rt, 'hearth-hub-stopped-' + u)
        if os.path.exists(f):
            os.unlink(f)
            cmd(['systemctl', '--user', 'start', '--no-block', u], 15)
            did.append('started %s again' % u)
    if os.path.exists(mark):
        os.unlink(mark)
    return ''


