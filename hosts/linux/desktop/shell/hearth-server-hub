def thunderstore(full):
    ns, name = full.split('-', 1)
    url = 'https://thunderstore.io/api/experimental/package/%s/%s/' % (urllib.parse.quote(ns), urllib.parse.quote(name))
    with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'Hearth'}), timeout=20) as r:
        j = json.loads(r.read(2 << 20).decode('utf-8'))
    if j.get('is_deprecated'):
        raise Fail('%s is marked deprecated on Thunderstore' % full)
    latest = j.get('latest') or {}
    dl = latest.get('download_url') or ''
    if not dl.startswith('https://'):
        raise Fail("Thunderstore didn't give a download for %s" % full)
    return {'name': latest.get('name') or name, 'version': latest.get('version_number') or '', 'url': dl}


