def human_bytes(s):
    m = re.match(r'([\d.]+)\s*([kKMGT]?i?B)?', s or '')
    if not m:
        return 0
    mult = {'B': 1, 'kB': 1e3, 'KB': 1e3, 'KiB': 1024, 'MB': 1e6, 'MiB': 1 << 20, 'GB': 1e9, 'GiB': 1 << 30, 'TB': 1e12, 'TiB': 1 << 40}
    return int(float(m.group(1)) * mult.get(m.group(2) or 'B', 1))


