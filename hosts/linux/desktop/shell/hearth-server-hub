def gb(n, digits=1):
    n = float(n or 0)
    if n >= 1e12:
        return ((('%.2f' % (n / 1e12)).rstrip('0').rstrip('.')) if digits else '%.0f' % (n / 1e12)) + ' TB'
    if n >= 1e10:
        return '%d GB' % round(n / 1e9)
    if n >= 1e9:
        return '%.1f GB' % (n / 1e9)
    return '%d MB' % round(n / 1e6)


def clock(ts):
    t = datetime.datetime.fromtimestamp(ts)
    h = t.hour % 12 or 12
    return '%d:%02d %s' % (h, t.minute, 'AM' if t.hour < 12 else 'PM')


def day_clock(ts):
    t = datetime.datetime.fromtimestamp(ts)
    return '%s %d %s' % (t.strftime('%b'), t.day, clock(ts))


def short_day(ts):
    t = datetime.datetime.fromtimestamp(ts)
    return '%s %d' % (t.strftime('%b'), t.day)


def dur(secs):
    secs = int(max(0, secs))
    h, m = secs // 3600, secs % 3600 // 60
    if h and m:
        return '%d h %d min' % (h, m)
    if h:
        return '%d h' % h
    return '%d min' % max(1, m)


def hour_words(hhmm, pm_mark=True):
    """06:00 → "6 AM", 22:00 → "10", 12:00 → "noon" (as the schedule grid writes them)."""
    h, m = int(hhmm[:2]), int(hhmm[3:])
    if h == 12 and m == 0:
        return 'noon'
    hh = h % 12 or 12
    s = str(hh) if m == 0 else '%d:%02d' % (hh, m)
    return s + (' ' + ('AM' if h < 12 else 'PM') if pm_mark else '')


def span_words(a, b):
    if a == '00:00' and b in ('24:00', '23:59'):
        return 'all day'
    ha, hb = int(a[:2]), int(b[:2]) if b != '24:00' else 24
    same = (ha < 12) == (hb < 12) or b == '12:00'
    if a == '12:00':
        return 'noon–%s' % hour_words(b, False)
    if same:
        return '%s–%s' % (hour_words(a, False), hour_words(b, True))
    return '%s–%s' % (hour_words(a, True), hour_words(b, False))


