def _norm(n):
    return re.sub(r'[^a-z0-9]', '', (n or '').lower())


def device_words(ip, ts, links):
    """Where a player's address is: one of your devices on Tailscale ("the ROG Ally", Hearth Link's name for it when
    it's one of your Hearth devices), a friend's shared device ("over Tailscale (shared)"), your home network, this PC."""
    if not ip:
        return ''
    p = ts_by_ip(ts).get(ip)
    if p:
        if p.get('shared'):
            return 'over Tailscale (shared)'
        nm = p.get('name') or ''
        for ln in links:
            if _norm(ln) == _norm(nm) or _norm(ln).startswith(_norm(nm)) and _norm(nm):
                return 'the ' + ln
        return 'the ' + nm if nm else 'over Tailscale'
    try:
        import ipaddress
        a = ipaddress.ip_address(ip)
        if a.is_loopback:
            return 'this PC'
        if a.is_private:
            return 'on your home network'
    except ValueError:
        pass
    return 'over the internet'


