def steam_common(name):
    """A Steam game's folder in any of this PC's Steam libraries (libraryfolders.vdf)."""
    libs = [os.path.dirname(STEAM_APPS)]
    try:
        with open(os.path.join(STEAM_APPS, 'libraryfolders.vdf'), encoding='utf-8', errors='replace') as f:
            libs += re.findall(r'"path"\s+"([^"]+)"', f.read())
    except OSError:
        pass
    for lib in libs:
        p = os.path.join(lib, 'steamapps', 'common', name)
        if os.path.isdir(p):
            return p
    return ''


def _unzip_into(zpath, dest, strip=''):
    """A mod's zip into dest, never outside it (no absolute paths, no ..); `strip` drops a leading folder."""
    import zipfile
    with zipfile.ZipFile(zpath) as z:
        for info in z.infolist():
            n = info.filename.replace('\\', '/')
            if strip:
                if not n.startswith(strip + '/'):
                    continue
                n = n[len(strip) + 1:]
            if not n or n.endswith('/'):
                continue
            target = os.path.realpath(os.path.join(dest, n))
            if not target.startswith(os.path.realpath(dest) + os.sep):
                raise Fail("a mod's zip tried to write outside its folder")
            os.makedirs(os.path.dirname(target), exist_ok=True)
            with z.open(info) as src_, open(target + '.part', 'wb') as out:
                shutil.copyfileobj(src_, out)
            os.replace(target + '.part', target)


def mods_sync(peer, gid):
    """This device's Valheim gets the server's mods: the same versions, from Thunderstore itself (each download is
    Thunderstore's; the server only says which). What Hearth put in before and the server dropped is taken out again;
    anything you added yourself is left alone."""
    if gid != 'valheim':
        return {'ok': True, 'mods': 0}
    want = (link_ask(peer, 'mods', {'game': gid}) or {}).get('mods') or []
    game = steam_common('Valheim')
    if not game:
        raise Fail("Valheim isn't installed in Steam on this device")
    st = sio.load_json(MODS_STATE, {})
    st = st if isinstance(st, dict) else {}
    mine = (st.get(gid) or {}).get('mods') or {}
    plugins = os.path.join(game, 'BepInEx', 'plugins')
    keep = {}
    for m in want:
        mid, ver, url = m.get('id', ''), m.get('version', ''), m.get('url', '')
        if not MOD_RE.fullmatch(mid) or not re.fullmatch(r'\d+\.\d+\.\d+', ver) or not url.startswith('https://thunderstore.io/package/download/'):
            continue
        keep[mid] = ver
        if mine.get(mid) == ver:
            continue
        tmp = os.path.join(STATE_HOME, 'nimbus', 'mod-%s.zip' % mid)
        os.makedirs(os.path.dirname(tmp), exist_ok=True)
        code, _, _ = cmd(['curl', '-fsSL', '--proto', '=https', '--max-time', '300', '-o', tmp, url], 320)
        if code != 0:
            raise Fail("%s didn't download" % mid)
        try:
            if mid.endswith('BepInExPack_Valheim'):
                _unzip_into(tmp, game, 'BepInExPack_Valheim')      # the loader goes next to the game
            else:
                d = os.path.join(plugins, mid)
                shutil.rmtree(d, ignore_errors=True)
                _unzip_into(tmp, d)
        finally:
            if os.path.exists(tmp):
                os.unlink(tmp)
    for mid in mine:
        if mid not in keep and not mid.endswith('BepInExPack_Valheim'):
            shutil.rmtree(os.path.join(plugins, mid), ignore_errors=True)

    def change(d):
        d[gid] = {'mods': keep, 'at': int(now()), 'from': peer}
    sio.update_json(MODS_STATE, change)
    return {'ok': True, 'mods': len(keep)}


def game_join(peer, gid):
    """Join a game server on another of your PCs from this device: its mods first, then the game itself with the
    server's address (Valheim through BepInEx's start script when the mods need it, else Steam)."""
    if not ID_RE.fullmatch(gid or ''):
