def link_call(cmd_, args=None, timeout=30):
    """One call to this user's Hearth Link (`hearth-link call`); Fail with its words when it says no."""
    if faking():
        v = (fixture().get('link') or {}).get(cmd_ + (':' + (args or {}).get('op', '') if cmd_ == 'server.ask' else ''))
        if v is None:
            raise Fail("Hearth Link isn't running")
        return v
    try:
        r = subprocess.run([LINK_BIN, 'call', cmd_, json.dumps(args or {})], capture_output=True, text=True, timeout=timeout + 5,
                           env=dict(os.environ, HEARTH_LINK_CALL_TIMEOUT=str(int(timeout))))
