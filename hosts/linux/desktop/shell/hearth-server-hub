    if gid == 'valheim' and synced['mods'] and os.path.isfile(starter):
        args = ['systemd-run', '--user', '--collect', '--unit=hearth-join-valheim', '--working-directory=' + game, '/bin/bash', starter, '+connect', addr]
    elif gid == 'valheim':
