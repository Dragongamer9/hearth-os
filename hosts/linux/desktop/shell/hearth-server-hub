def walk_files(root_, exts, limit=400000):
    n = 0
    for dp, dirs, files in os.walk(root_):
        dirs[:] = [d for d in dirs if not d.startswith('.')]
        for f in files:
            if f.lower().endswith(exts):
                p = os.path.join(dp, f)
                try:
                    yield p, os.path.getsize(p), os.path.getmtime(p)
                except OSError:
                    continue
                n += 1
                if n >= limit:
                    return


def media_scan():
    """What's in Music, Pictures and the library folders, counted from the files themselves (each top folder of
    Music is a row; photos by count and size; each kind's size for Space), and the same photo kept twice (the same
    bytes, or the same picture at another size: a small fingerprint of each, made with ffmpeg). Run in its own unit
    at most every 6 hours; the page reads what it found."""
    out = {'at': int(now())}
    rows = {}
    total_n = total_b = 0
    for p, size, _mt in walk_files(MUSIC, AUDIO_EXT):
        top = os.path.relpath(p, MUSIC).split(os.sep)[0] if os.sep in os.path.relpath(p, MUSIC) else 'Loose songs'
        r = rows.setdefault(top, [0, 0, set()])
        r[0] += 1
        r[1] += size
        parts = os.path.relpath(p, MUSIC).split(os.sep)
        if len(parts) > 2:
            r[2].add(parts[1])
        total_n += 1
        total_b += size
    out['music'] = {'n': total_n, 'bytes': total_b,
                    'rows': [[k, '%d albums · %s' % (len(v[2]), gb(v[1])) if v[2] else gb(v[1]), v[0]] for k, v in sorted(rows.items(), key=lambda x: -x[1][0])[:4]]}
    photos, vids, pb, newest = [], 0, 0, 0
    by_size = {}
    for p, size, mt in walk_files(PICTURES, PHOTO_EXT + PHOTO_VID):
        pb += size
        newest = max(newest, mt)
        if p.lower().endswith(PHOTO_VID):
            vids += 1
            continue
        photos.append(p)
        by_size.setdefault(size, []).append(p)
    out['photos'] = {'n': len(photos), 'videos': vids, 'bytes': pb, 'newest': int(newest)}
    out['dupes'] = dupes(photos, by_size)
    kinds = {}
    for k, d in (('TV and movies', os.path.join(MEDIA, SUB['movie'])), ('TV and movies', os.path.join(MEDIA, SUB['tv'])),
                 ('home videos', os.path.join(MEDIA, SUB['own']))):
        kinds[k] = kinds.get(k, 0) + sum(sz for _p, sz, _m in walk_files(d, VIDEO_EXT))
    kinds['photos'] = pb
    kinds['music'] = total_b
    out['kinds'] = kinds
    if not faking():
        def change(d):
            d['mediaScan'] = out
        seen_update(change)
    return out


def dupes(photos, by_size, max_fp=6000):
    """Groups of the same photo: identical files (same size, then the same SHA-256), then the same picture saved
    again at another size (fingerprints within 4 bits), at most `max_fp` fingerprints a scan."""
    import hashlib
    groups = []
    seen_p = set()
    for size, ps in by_size.items():
        if len(ps) < 2:
            continue
        h = {}
        for p in ps:
            try:
                with open(p, 'rb') as f:
                    h.setdefault(hashlib.sha256(f.read()).hexdigest(), []).append(p)
            except OSError:
                pass
        for g in h.values():
            if len(g) > 1:
                groups.append(g)
                seen_p |= set(g)
    if have('ffmpeg'):
        fps = []
        for p in [x for x in photos if x not in seen_p][:max_fp]:
            fp = fingerprint(p)
            if fp is not None:
                fps.append((fp, p))
        fps.sort()
        used = set()
        for i, (a_, pa) in enumerate(fps):
            if pa in used:
                continue
            g = [pa]
            for b_, pb_ in fps[i + 1:i + 40]:
                if pb_ not in used and bin(a_ ^ b_).count('1') <= 4:
                    g.append(pb_)
            if len(g) > 1:
                used |= set(g)
                groups.append(g)
    return {'groups': groups[:2000], 'n': sum(len(g) - 1 for g in groups)}


def fingerprint(path):
    code, o, _ = cmd_bytes(['ffmpeg', '-nostdin', '-loglevel', 'error', '-i', path, '-vf', 'scale=9:8:flags=area,format=gray', '-frames:v', '1', '-f', 'rawvideo', '-'], 20)
    if code != 0 or len(o) < 72:
        return None
    v = 0
    for r in range(8):
        for c in range(8):
            v = v << 1 | (1 if o[r * 9 + c] > o[r * 9 + c + 1] else 0)
    return v


def cmd_bytes(args, timeout=30):
    try:
        r = subprocess.run(args, capture_output=True, timeout=timeout)
        return r.returncode, r.stdout, r.stderr
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, b'', str(e).encode()


def media_scan_start():
    if faking() or cmd(['systemctl', '--user', 'is-active', '--quiet', 'hearth-media-scan.service'], 5)[0] == 0:
        return
    cmd(['systemd-run', '--user', '--collect', '--unit=hearth-media-scan', '--nice=15', '-p', 'IOSchedulingClass=idle',
         '/usr/bin/python3', os.path.realpath(__file__), 'media-scan'], 15)


def dupes_open():
    """Look through them: a folder of links to each group (Pictures/Same photo twice/1/…), opened in Files. Nothing
    is moved or deleted: you keep or delete the ones you want there."""
    g = ((seen().get('mediaScan') or {}).get('dupes') or {}).get('groups') or []
    if faking():
        return {'ok': True}
    if not g:
        raise Fail('no photo is kept twice')
    root_ = os.path.join(PICTURES, 'Same photo twice')
    shutil.rmtree(root_, ignore_errors=True)
    for i, grp in enumerate(g[:500], 1):
        d = os.path.join(root_, str(i))
        os.makedirs(d, exist_ok=True)
        for p in grp:
            if os.path.exists(p):
                try:
                    os.symlink(p, os.path.join(d, os.path.basename(p)))
                except OSError:
                    pass
    cmd(['xdg-open', root_], 10)
    return {'ok': True, 'open': root_}


def immich_counts():
    """People and places from Immich (Hearth's photos app), when it's on and has its key: what its own AI found."""
    code, key, _ = cmd(['secret-tool', 'lookup', 'hearth-app', 'server-hub', 'key', 'immich'], 10)
    if not key.strip():
        return None
    base = os.environ.get('HEARTH_IMMICH', 'http://127.0.0.1:2283')

    def get(path):
        req = urllib.request.Request(base + path, headers={'x-api-key': key.strip(), 'Accept': 'application/json'})
        with urllib.request.urlopen(req, timeout=10) as r:
            return json.loads(r.read(8 << 20).decode('utf-8'))
    people = get('/api/people?withHidden=false')
