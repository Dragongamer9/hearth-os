    elif gid == 'minecraft':
        return {'ok': True, 'address': addr, 'say': 'Open Minecraft › Multiplayer › Add server: ' + addr}
    else:
        return {'ok': True, 'address': addr}
    code, _, e = cmd(args, 30)
    if code != 0:
        raise Fail("the game didn't start")
    return {'ok': True, 'mods': synced['mods'], 'address': addr}


