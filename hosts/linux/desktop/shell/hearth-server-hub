def peers():
    """Your other Hearth PCs as their status says, with Hearth Server's part of it (its jobs, watts) on top, the way a
    PC's card reads them."""
    ts = ts_status()
    out = []
    for d in link_devices():
        hs = d.get('hearthServer') if isinstance(d.get('hearthServer'), dict) else None
        if hs is None and not d.get('hearthServer') is True:
            continue
        p = dict(d)
        if hs:
            p['jobs'] = [{'name': j.get('name', ''), 'kind': j.get('kind', 'services'), 'share': j.get('share') or {}, 'on': True}
                         for j in hs.get('jobs') or [] if isinstance(j, dict)]
            if hs.get('watts') is not None:
