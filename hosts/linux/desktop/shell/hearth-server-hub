def tried_words(moved):
    """The last time a PC went off and its work moved: what moved, and when it went back (from the moves' record)."""
    off = [m for m in moved if str(m.get('why', '')).endswith('went off')]
    if not off:
        return '', ''
    m = off[-1]
    back = next((b for b in moved if b.get('at', 0) > m.get('at', 0) and b.get('what') == m.get('what') and b.get('to') == m.get('from')), None)
    text = '%s turned off. %s moved to %s%s' % (m.get('from'), m.get('what'), m.get('to'), ', and moved back at %s.' % clock(back['at']) if back else ' and runs there until it\'s back.')
    return text, short_day(m.get('at') or 0)


