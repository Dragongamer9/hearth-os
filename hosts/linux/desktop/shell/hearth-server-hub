def watts_now():
    """What this PC draws, where it can say: the graphics card (nvidia-smi), the processor (RAPL, when it's readable)
    and a laptop's battery while it runs on it. None when nothing says."""
    def live():
        w = 0.0
        known = False
        code, o, _ = cmd(['nvidia-smi', '--query-gpu=power.draw', '--format=csv,noheader,nounits'], 5)
        if code == 0:
            try:
                w += sum(float(x) for x in o.split())
                known = True
            except ValueError:
                pass
        rapl = '/sys/class/powercap/intel-rapl:0/energy_uj'
        try:
            a = int(open(rapl).read())
            time.sleep(0.25)
            b = int(open(rapl).read())
            if b >= a:
                w += (b - a) / 1e6 / 0.25
                known = True
        except (OSError, ValueError):
            pass
        for bat in ('BAT0', 'BAT1'):
            try:
                if open('/sys/class/power_supply/%s/status' % bat).read().strip() == 'Discharging':
                    w = max(w, int(open('/sys/class/power_supply/%s/power_now' % bat).read()) / 1e6)
                    known = True
            except (OSError, ValueError):
                pass
        return round(w) if known else None
    return src('watts', live, None)


