def next_start(days, t):
    d = datetime.datetime.fromtimestamp(t)
    for i in range(8):
        dd = d + datetime.timedelta(days=i)
        v = days.get(DAYS[dd.weekday()]) if isinstance(days, dict) else None
        if isinstance(v, list) and len(v) == 2:
            start = dd.replace(hour=int(v[0][:2]), minute=int(v[0][3:]), second=0, microsecond=0)
            if start.timestamp() > t:
                return '%s %s' % (DAYS[dd.weekday()], hour_words(v[0]).replace(':00', ''))
    return ''


def week_bars(hist, t):
    """The last 7 days, 6 hours a bar (28 bars), Fri first as the board; and the busiest hour."""
    bars = []
    start = datetime.datetime.fromtimestamp(t).replace(minute=0, second=0, microsecond=0) - datetime.timedelta(days=7)
    best = (0, None)
    for i in range(28):
        n = 0
        for h in range(6):
            ts = start + datetime.timedelta(hours=i * 6 + h)
            v = int(hist.get(ts.strftime('%Y-%m-%dT%H')) or 0)
            n = max(n, v)
            if v > best[0]:
                best = (v, ts)
        bars.append(n)
    most = 'most: %s %s, %d players' % (best[1].strftime('%a'), hour_words(best[1].strftime('%H:00')), best[0]) if best[1] else 'nobody yet this week'
    return bars, most


