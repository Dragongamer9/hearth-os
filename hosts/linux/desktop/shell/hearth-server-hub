AI_UNITS = [('hearth-colibri.service', 'Colibri', 'AI'), ('hearth-ollama.service', 'Ollama', 'AI'), ('hearth-imagine.service', 'Imagine', 'AI'),
            ('hearth-kokoro.service', 'Kokoro', 'AI'), ('hearth-listen.service', 'Listen', 'AI')]
OUTBOX_SECS = 3600
FILE_CHUNK = 3 << 20


def outbox_add(path):
    """A world file another of your PCs may fetch once (by its token, for an hour): only Hearth's own world backups."""
    catalog()
    root_ = os.path.realpath(os.path.join(sa().DATA_ROOT, 'World backups'))
    if not os.path.realpath(path).startswith(root_ + os.sep):
        raise Fail('only world backups go to your other PCs')
    tok = os.urandom(12).hex()

    def change(d):
        ob = d.get('outbox') if isinstance(d.get('outbox'), dict) else {}
        ob = {k: v for k, v in ob.items() if now() - (v.get('at') or 0) < OUTBOX_SECS}
        ob[tok] = {'path': path, 'at': int(now())}
        d['outbox'] = ob
    seen_update(change)
    return {'token': tok, 'size': os.path.getsize(path), 'name': os.path.basename(path)}


def outbox_read(tok, off):
    import base64
    e = (seen().get('outbox') or {}).get(tok if re.fullmatch(r'[0-9a-f]{24}', tok or '') else '') or {}
    if not e or now() - (e.get('at') or 0) > OUTBOX_SECS:
        raise Fail('that file is gone')
    with open(e['path'], 'rb') as f:
        f.seek(int(off))
        b = f.read(FILE_CHUNK)
    return {'data': base64.b64encode(b).decode('ascii'), 'eof': len(b) < FILE_CHUNK}


def link_pull(peer, info, gid, why):
    """A world file from another PC into this PC's world backups for that game ("YYYY-MM-DD HHMM why.tar.gz"), then
    checked as any backup is before it's ever put back."""
    import base64
    catalog()
    d = sa().world_dir(gid)
    os.makedirs(d, exist_ok=True)
    name_ = time.strftime('%Y-%m-%d %H%M', time.localtime(now())) + ' ' + why + '.tar.gz'
    dest = os.path.join(d, name_)
    off, size = 0, int(info.get('size') or 0)
    with open(dest + '.part', 'wb') as f:
        while True:
            r = link_ask(peer, 'file', {'token': info['token'], 'offset': off}, 120)
            b = base64.b64decode(r.get('data') or '')
            f.write(b)
            off += len(b)
            if r.get('eof') or not b or off > size + FILE_CHUNK:
                break
    if off != size:
        os.unlink(dest + '.part')
        raise Fail("the world didn't arrive whole")
    os.replace(dest + '.part', dest)
    return name_


def link_answer(op, raw):
    """What this PC answers another of your own Hearth PCs (Hearth Link's server.ask; Hearth Link already checked the
    asker is one of your own paired devices). Only these; each checks its own arguments."""
    try:
        args = json.loads(raw) if raw else {}
    except ValueError:
        raise Fail('the question must be JSON')
    if not isinstance(args, dict):
        raise Fail('the question must be JSON')
    gid = args.get('game') or args.get('gid') or ''
    if gid and not ID_RE.fullmatch(gid):
        raise Fail('not a game')
    s = settings()
    if op == 'status':
        return dict(agent_status(), ok=True)
    if op == 'games':
        return {'ok': True, 'games': agent_status()['games']}
    if op == 'mods':
        return {'ok': True, 'mods': mods_manifest(gid)}
    if op == 'file':
        return dict(outbox_read(args.get('token') or '', int(args.get('offset') or 0)), ok=True)
    if op == 'history':
        return {'ok': True, 'segments': own_history()}
    if op == 'relay-wake':
        return {'ok': True, 'sent': send_wol(args.get('mac') or '')}
    if op in ('job-start', 'job-stop', 'job-world'):
        if not s['pcs'].get('helper'):
            raise Fail("this PC doesn't take jobs from your other PCs (PCs › Let this PC take jobs, on that PC)")
        catalog()
        if gid not in sa().CATALOG or gid not in sa().WORLDS:
            raise Fail('not a game server Hearth can move')
        m = sa()
        if op == 'job-start':
            if busy_here():
                raise Fail('this PC is busy')
            name_ = link_pull(args.get('from') or '', args, gid, 'moved here') if args.get('token') else ''
            if not m.installed(gid):
                m.install(gid)
                return {'ok': True, 'installing': True}
            if name_:
                m.world_restore(gid, name_)
            res = m.switch(gid, True)

            def change(d):
                d.setdefault('hosting', {})[gid] = {'from': args.get('from') or '', 'name': (args.get('name') or '')[:60], 'at': int(now())}
            seen_update(change)
            return dict(res, ok=True)
        if op == 'job-world':
            if int(players(gid).get('n') or 0) and not args.get('stop'):
                return {'ok': True, 'busy': True}        # never stopped with players on for a safety copy
            r = m.world_backup(gid, 'for another pc')
            if not r.get('file'):
                return {'ok': True, 'none': True}
            return dict(outbox_add(os.path.join(m.world_dir(gid), r['file'])), ok=True)
        # job-stop: saved and stopped here, its world handed back
        m.switch(gid, False)
        r = m.world_backup(gid, 'moved back')

        def change(d):
            (d.get('hosting') or {}).pop(gid, None)
        seen_update(change)
        if not r.get('file'):
            return {'ok': True, 'none': True}
        return dict(outbox_add(os.path.join(m.world_dir(gid), r['file'])), ok=True)
    if op == 'play-quality':
        return dict(moonlight_quality(args), ok=True)
    if op == 'play-open':
        return dict(moonlight_open(args.get('host') or '', args.get('app') or ''), ok=True)
    if op == 'play-report':
        return dict(moonlight_report(), ok=True)
    raise Fail('not something this PC answers')


def my_link_id():
    try:
        return (link_call('status', {}, 15).get('me') or {}).get('id') or ''
    except Fail:
        return ''


def job_host(exclude=''):
    """Which of your other PCs can take a game server now: online, takes jobs, not busy; mains power first."""
    best = None
    for d in link_devices():
        hs = d.get('hearthServer') if isinstance(d.get('hearthServer'), dict) else {}
        if not d.get('online', True) or not hs.get('canHost') or d.get('id') == exclude:
            continue
        bat = d.get('battery') or {}
        score = (0 if bat and not bat.get('charging') and not bat.get('pluggedIn') else 1, -float((d.get('cpu') or {}).get('use') or 0))
        if best is None or score > best[0]:
            best = (score, d)
    return best[1] if best else None


def record_move(what, frm, to, why):
    def change(d):
        mv = d.get('moved') if isinstance(d.get('moved'), list) else []
        mv.append({'at': int(now()), 'what': what, 'from': frm, 'to': to, 'why': why})
        d['moved'] = mv[-200:]
    seen_update(change)
    if settings()['pcs'].get('tell') and not faking():
        cmd(['notify-send', '-a', 'Hearth', 'Home server', '%s moved from %s to %s (%s)' % (what, frm, to, why)], 10)


def move_out(gid, why='this PC is busy'):
    """A game server to another of your PCs as a whole: its world saved here (stopped cleanly), sent over Hearth Link,
    started there; this PC keeps the copy. Players join the other PC's address."""
    host = job_host()
    if not host:
        raise Fail('none of your other PCs can take it now (each needs PCs › Let this PC take jobs, on that PC)')
    catalog()
    m = sa()
    r = m.world_backup(gid, 'moved out')
    m.switch(gid, False)
    info = outbox_add(os.path.join(m.world_dir(gid), r['file'])) if r.get('file') else {}
    res = link_ask(host['id'], 'job-start', dict(info, game=gid, **{'from': my_link_id(), 'name': socket.gethostname()}), 900)
    if not res.get('ok'):
        m.switch(gid, True)
        raise Fail("%s didn't take it" % host.get('name'))

    def change(d):
        d.setdefault('away', {})[gid] = {'peer': host['id'], 'name': host.get('name') or 'another PC', 'at': int(now()), 'why': why}
    seen_update(change)
    record_move(OWN[gid][0] if gid in OWN else m.CATALOG[gid]['name'], 'this PC', host.get('name') or 'another PC', why)
    return {'ok': True, 'to': host.get('name')}


def bring_back(gid, start=True):
    """A game server that moved to another PC comes home: stopped and saved there, its world back here, started."""
    w = (seen().get('away') or {}).get(gid)
    if not w:
        return {'ok': True}
    catalog()
    m = sa()
    res = link_ask(w['peer'], 'job-stop', {'game': gid}, 900)
    name_ = link_pull(w['peer'], res, gid, 'moved back') if res.get('token') else ''
    if name_:
        m.world_restore(gid, name_)
    if start:
        m.switch(gid, True)

    def change(d):
        (d.get('away') or {}).pop(gid, None)
    seen_update(change)
    record_move(m.CATALOG[gid]['name'], w.get('name') or 'another PC', 'this PC', 'back home')
    return {'ok': True}


def jobs_tick(s, st, did):
    """The 5-minute timer's part for your PCs: each PC's on and off for the week; a game server away on a PC that went
    off comes back here from its last copy (Move the work by itself); a safety copy of it every hour while nobody's on;
    home again when this PC isn't busy any more (by itself, or it asks, as you chose)."""
    t = now()
    devs = link_devices()
    on = {d.get('id'): bool(d.get('online')) for d in devs}
    week = st.get('pcsWeek') if isinstance(st.get('pcsWeek'), dict) else {}
    for d in devs:
        week.setdefault(d.get('name') or d.get('id') or '?', {})[str(int(t // 300 * 300))] = 1 if d.get('online') else 0
    week.setdefault(socket.gethostname(), {})[str(int(t // 300 * 300))] = 1
    for k in week:
        week[k] = {x: v for x, v in week[k].items() if t - int(x) <= 7 * 86400}
    st['pcsWeek'] = week
    catalog()
    m = sa()
    standins_tick(s, st, did, devs, on, m, t)
    for gid, w in list((st.get('away') or {}).items()):
        if not isinstance(w, dict):
            continue
        if not on.get(w.get('peer')):
            w['offTicks'] = int(w.get('offTicks') or 0) + 1
            if w['offTicks'] >= 2 and s['pcs'].get('autoMove'):
                copies = [b for b in m.world_list(gid)]
                if copies:
                    m.world_restore(gid, copies[0]['file'])
                m.switch(gid, True)
                st['away'].pop(gid, None)
                st.setdefault('moved', []).append({'at': int(t), 'what': m.CATALOG[gid]['name'], 'from': w.get('name'), 'to': 'this PC', 'why': '%s went off' % w.get('name')})
                did.append('%s came back here: %s went off' % (gid, w.get('name')))
            continue
        w['offTicks'] = 0
        if t - int(w.get('copied') or w.get('at') or 0) >= 3600:
            try:
                r = link_ask(w['peer'], 'job-world', {'game': gid}, 900)
                if r.get('token'):
                    link_pull(w['peer'], r, gid, 'away copy')
                    w['copied'] = int(t)
            except Fail:
                pass
        if not busy_here() and t - int(w.get('at') or 0) > 1800:
            if s['pcs'].get('moveBack') == 'always':
                try:
                    bring_back(gid)
                    fresh = seen()
                    st['away'], st['moved'] = fresh.get('away') or {}, fresh.get('moved') or []
                    did.append('%s moved back home' % gid)
                except Fail:
                    pass
            elif not w.get('asked'):
                w['asked'] = True
                cmd(['notify-send', '-a', 'Hearth', 'Home server', '%s is still on %s. Bring it back from Game servers when you like.' % (m.CATALOG[gid]['name'], w.get('name'))], 10)


def standins_tick(s, st, did, devs, on, m, t):
    """Your other PCs' own jobs: what each runs is remembered while it's on (and, for a game server with nobody on,
    a copy of its world every hour, where that PC lets this one take jobs); when it goes off, this PC stands in with
    each whole job it can run (the game from its last copy, an AI engine this PC has too), and hands them back when
    it's on again (by itself or after asking, as you chose)."""
    last = st.setdefault('lastJobs', {})
    copies = st.setdefault('copies', {})
    stand = st.setdefault('standin', {})
    for d in devs:
        pid = d.get('id') or ''
        hs = d.get('hearthServer') if isinstance(d.get('hearthServer'), dict) else None
        if not pid or d.get('relation') not in (None, 'mine'):
            continue
        if d.get('online') and hs is not None:
            last[pid] = {'name': d.get('name') or 'another PC', 'jobs': [j for j in hs.get('jobs') or [] if isinstance(j, dict) and j.get('moves')][:12],
                         'helper': bool(hs.get('helper')), 'at': int(t), 'off': 0}
            for j in last[pid]['jobs']:
                gid = j.get('id') or ''
                if j.get('kind') == 'games' and hs.get('helper') and gid in m.WORLDS and t - int((copies.get(pid) or {}).get(gid) or 0) >= 3600:
                    try:
                        r = link_ask(pid, 'job-world', {'game': gid}, 900)
                        if r.get('token'):
                            link_pull(pid, r, gid, 'copy from another pc')
                            copies.setdefault(pid, {})[gid] = int(t)
                    except Fail:
                        pass
            # It's back: what stood in for it goes home.
            for key, w in list(stand.items()):
                if w.get('for') != pid:
                    continue
                if s['pcs'].get('moveBack') == 'always' or w.get('backOk'):
                    try:
                        if w.get('kind') == 'games':
                            m.switch(key, False)
                            r = m.world_backup(key, 'moved back')
                            info = outbox_add(os.path.join(m.world_dir(key), r['file'])) if r.get('file') else {}
                            link_ask(pid, 'job-start', dict(info, game=key, **{'from': my_link_id(), 'name': socket.gethostname()}), 900)
                        else:
                            cmd(['systemctl', '--user', 'stop', key], 60)
                        stand.pop(key, None)
                        st.setdefault('moved', []).append({'at': int(t), 'what': w.get('what') or key, 'from': 'this PC', 'to': w.get('name'), 'why': 'it was on again'})
                        did.append('%s went back to %s' % (key, w.get('name')))
                    except Fail:
                        pass
                elif not w.get('asked'):
                    w['asked'] = True
                    cmd(['notify-send', '-a', 'Hearth', 'Home server', '%s is on again. Its %s runs here for now: move it back from PCs.' % (w.get('name'), w.get('what') or key)], 10)
        elif pid in last and not on.get(pid):
            last[pid]['off'] = int(last[pid].get('off') or 0) + 1
            if last[pid]['off'] < 2 or not s['pcs'].get('autoMove'):
                continue
            for j in last[pid]['jobs']:
                key = j.get('unit') or j.get('id') or ''
                if not key or key in stand:
                    continue
                try:
                    if j.get('kind') == 'games' and key in m.CATALOG:
                        mine_ = [b for b in m.world_list(key) if 'copy from another pc' in b['file'] or 'moved' in b['file']]
                        if not mine_:
                            continue                  # no copy of its world here: it waits for that PC
                        if not m.installed(key):
                            m.install(key)
                            continue                  # its image first; it starts on the next round
                        m.world_restore(key, mine_[0]['file'])
                        m.switch(key, True)
                    elif j.get('unit') and re.fullmatch(r'hearth-[a-z]+\.service', key) and cmd(['systemctl', '--user', 'cat', key], 10)[0] == 0:
                        cmd(['systemctl', '--user', 'start', '--no-block', key], 30)
                    else:
                        continue
                    stand[key] = {'for': pid, 'name': last[pid]['name'], 'what': j.get('name') or key, 'kind': j.get('kind'), 'at': int(t)}
                    st.setdefault('moved', []).append({'at': int(t), 'what': j.get('name') or key, 'from': last[pid]['name'], 'to': 'this PC', 'why': '%s went off' % last[pid]['name']})
                    did.append('%s runs here: %s went off' % (key, last[pid]['name']))
                except Fail:
                    pass


def own_history():
    """This PC's own on and off for the last 7 days, from its starts (journalctl --list-boots: each start's first and
    last moment). [{'on', 'w', 'why'}] as shares of the week."""
    t = now()
    week = 7 * 86400
    code, o, _ = cmd(['journalctl', '--list-boots', '--output=json', '--no-pager'], 20)
    try:
        boots = json.loads(o) if code == 0 else []
    except ValueError:
        boots = []
    spans = []
    for b in boots if isinstance(boots, list) else []:
        a_, z = (b.get('first_entry') or 0) / 1e6, (b.get('last_entry') or 0) / 1e6
        if z >= t - week:
            spans.append((max(a_, t - week), min(z, t)))
    spans.sort()
    out, cur = [], t - week
    for a_, z in spans:
        if a_ > cur + 600:
            out.append({'on': False, 'w': (a_ - cur) / week, 'why': short_day(cur)})
        out.append({'on': True, 'w': max(0.0, (z - max(a_, cur)) / week)})
        cur = max(cur, z)
    if t - cur > 600 and out:
        out.append({'on': False, 'w': (t - cur) / week})
    return out or [{'on': True, 'w': 1.0}]


def week_segments(samples, t):
    """Five-minute samples ({start: 1|0}) as the week's on and off stretches, with the day each off began."""
    if not samples:
        return []
    week = 7 * 86400
    out = []
    for k in sorted(samples, key=int):
        v = bool(samples[k])
        if out and out[-1]['on'] == v:
            out[-1]['w'] += 300 / week
        else:
            seg = {'on': v, 'w': 300 / week}
            if not v:
                seg['why'] = short_day(int(k))
            out.append(seg)
    return out


def found_on_network(paired_ids, paired_names):
    """Hearth PCs and game-streaming PCs on your network that aren't yours yet: Hearth Link hears Hearth devices
    announce themselves at home, Sunshine PCs announce themselves over mDNS (_nvstream._tcp, avahi-browse) and
    Tailscale lists the Linux machines on your tailnet."""
    def live():
        out = {}
        try:
            for n in (link_call('status', {}, 15).get('nearby') or []):
                if n.get('id') not in paired_ids and n.get('name'):
                    out[n['name']] = 'add' if n.get('kind') in ('desktop', 'laptop', '') else 'not a good server'
        except Fail:
            pass
        if have('avahi-browse'):
            code, o, _ = cmd(['avahi-browse', '-ptr', '_nvstream._tcp'], 8)
            for ln in o.splitlines():
                f = ln.split(';')
                if len(f) > 6 and f[0] == '=':
                    nm = f[3].replace('\\032', ' ')
                    if _norm(nm) not in {_norm(x) for x in paired_names} and nm != socket.gethostname():
                        out.setdefault(nm, 'streams games (Sunshine) · add Hearth Server on it')
        for p in ts_status().get('peers') or []:
            if p.get('os') == 'linux' and not p.get('shared') and p.get('name') and _norm(p['name']) not in {_norm(x) for x in paired_names}:
                out.setdefault(p['name'] + (' · away' if not p.get('online') else ''), 'add' if p.get('online') else 'not on now')
        return [[k, v] for k, v in sorted(out.items())][:6]
    return src('found', live, []) or []


