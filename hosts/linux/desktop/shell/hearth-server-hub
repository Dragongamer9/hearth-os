MOONLIGHT_CONFS = [os.path.join(HOME, '.var', 'app', 'com.moonlight_stream.Moonlight', 'config', 'Moonlight Game Streaming Project', 'Moonlight.conf'),
                   os.path.join(CONFIG_HOME, 'Moonlight Game Streaming Project', 'Moonlight.conf')]
MOONLIGHT_LOG = os.path.join(STATE_HOME, 'nimbus', 'moonlight-last.log')
SIZE_WH = {'4K': (3840, 2160), '1440p': (2560, 1440), '1080p': (1920, 1080), '900p': (1600, 900), '720p': (1280, 720)}


def moonlight_cmd():
    if have('moonlight'):
        return ['moonlight']
    if have('flatpak') and cmd(['flatpak', 'info', 'com.moonlight_stream.Moonlight'], 10)[0] == 0:
        return ['flatpak', 'run', 'com.moonlight_stream.Moonlight']
    return []


def ini_set(text, section, values):
    """Moonlight.conf (Qt's INI) with these keys set in [section]; every other line kept as it was."""
    lines = text.splitlines()
    out, cur, done = [], '', set()
    for ln in lines:
        m = re.match(r'^\[(.+)\]\s*$', ln)
        if m:
            if cur == section:
                out += ['%s=%s' % (k, v) for k, v in values.items() if k not in done]
                done |= set(values)
            cur = m.group(1)
        elif cur == section and '=' in ln and ln.split('=', 1)[0].strip() in values:
            k = ln.split('=', 1)[0].strip()
            out.append('%s=%s' % (k, values[k]))
            done.add(k)
            continue
        out.append(ln)
    if cur == section:
        out += ['%s=%s' % (k, v) for k, v in values.items() if k not in done]
        done |= set(values)
    if len(done) < len(values):
        out += ['', '[%s]' % section] + ['%s=%s' % (k, v) for k, v in values.items() if k not in done]
    return '\n'.join(out).strip('\n') + '\n'


def moonlight_quality(q):
    """The stream's size, frames and bit rate in this device's Moonlight (its own settings file, the keys it reads:
    width, height, fps, bitrate in kb/s). Only those keys change; a .bak of the file is kept; not while it streams."""
    size, fps, rate = q.get('size'), str(q.get('fps') or ''), str(q.get('bitrate') or '')
    if size not in SIZE_WH or fps not in PLAY_DEVICE['fps'] or rate not in PLAY_DEVICE['bitrate']:
        raise Fail('a size, frames and bit rate')
    if faking():
        return {'set': True}
    code, o, _ = cmd(['pgrep', '-x', 'moonlight'], 5)
    if code == 0:
        raise Fail('Moonlight is streaming on that device: it takes it next time')
    path = next((p for p in MOONLIGHT_CONFS if os.path.exists(p)), MOONLIGHT_CONFS[0] if os.path.isdir(os.path.dirname(os.path.dirname(MOONLIGHT_CONFS[0]))) else MOONLIGHT_CONFS[1])
    try:
        with open(path, encoding='utf-8') as f:
            text = f.read()
    except FileNotFoundError:
        text = ''
    w, h = SIZE_WH[size]
    os.makedirs(os.path.dirname(path), exist_ok=True)
    sio.write_text(path, ini_set(text, 'General', {'width': str(w), 'height': str(h), 'fps': fps, 'bitrate': str(int(rate) * 1000)}))
    return {'set': True}


def moonlight_open(host, app):
    """Moonlight streams `app` from `host` on this device (its own window, full screen); what it says when the stream
    ends is kept for the PC's page (frames on time, delay)."""
    if not re.fullmatch(r'[A-Za-z0-9.:-]{1,120}', host or '') or not NAME_RE.fullmatch(app or ''):
        raise Fail('a PC and a game')
    if faking():
        return {'started': True}
    ml = moonlight_cmd()
    if not ml:
        raise Fail("Moonlight isn't on this device (get it from the Hearth Store)")
    os.makedirs(os.path.dirname(MOONLIGHT_LOG), exist_ok=True)
    code, _, e = cmd(['systemd-run', '--user', '--collect', '--unit=hearth-moonlight-%d' % int(now()), '-p', 'StandardOutput=truncate:' + MOONLIGHT_LOG,
                      '-p', 'StandardError=append:' + MOONLIGHT_LOG] + ml + ['stream', host, app], 30)
    if code != 0:
        raise Fail("Moonlight didn't start")
    return {'started': True}


def moonlight_stats(text):
    """Moonlight's own numbers for a stream (its "Global video stats" when the stream ends): frames that came on time
    (all but those dropped by the network and by jitter) and its network delay."""
    out = {}
    m = re.findall(r'Frames dropped by your network connection:\s*([\d.]+)%', text)
    j = re.findall(r'Frames dropped due to network jitter:\s*([\d.]+)%', text)
    if m:
        out['ontime'] = round(100.0 - float(m[-1]) - (float(j[-1]) if j else 0.0), 1)
    d = re.findall(r'Average network latency:\s*(\d+)\s*ms', text)
    if d:
        out['delay'] = int(d[-1])
    return out


def moonlight_report():
    try:
        with open(MOONLIGHT_LOG, encoding='utf-8', errors='replace') as f:
            text = f.read()[-200000:]
        out = moonlight_stats(text)
        out['at'] = int(os.path.getmtime(MOONLIGHT_LOG))
        return out
    except OSError:
        return {}

