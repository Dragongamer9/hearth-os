def game_act(action, gid):
    catalog()
    if gid not in sa().CATALOG:
        raise Fail('no game called %s' % gid)
    if faking():
        return {'ok': True}
    m = sa()
    if action == 'install':
        return m.install(gid)
    if action == 'start':
        if not m.installed(gid):
            return m.install(gid)
        if gid in (seen().get('away') or {}):
            return bring_back(gid)
        if settings()['games'].get('otherPc') and busy_here():
            try:
                return move_out(gid)
            except Fail:
                pass
        games_slice_sync(gid)
        return m.switch(gid, True)
    if action == 'stop':
        if gid in (seen().get('away') or {}):
            return bring_back(gid, start=False)
        res = m.switch(gid, False)
        try:
            m.world_backup(gid, 'stopped')
        except Exception:
            pass
        return res
    if action == 'restart':
        games_slice_sync(gid)
        code, o, e = cmd(['systemctl', '--user', 'restart', '--no-block', m.unit(gid)], 30)
        return {'ok': code == 0}
    raise Fail('start, stop, restart or install')


