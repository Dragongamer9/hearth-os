        raise Fail("Remote play's helper is missing")
    entry = {'name': g['name'], 'output': '', 'cmd': '', 'exclude-global-prep-cmd': 'false', 'elevated': 'false', 'auto-detach': 'true',
             'wait-all': 'true', 'exit-timeout': '5', 'image-path': '', 'detached': ['steam steam://rungameid/%s' % m.group(1)] if m else []}
