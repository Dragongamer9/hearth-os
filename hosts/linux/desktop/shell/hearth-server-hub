def dns(args):
    """The game cache's engine as root: the one the Home server helper's Store part carries (server-part server-dns),
    so the cache updates through the Hearth Store; the helper falls back to the one built into Hearth OS."""
    if faking():
        return {'ok': True}
    code, o, e = cmd(['pkexec', os.path.join(LIBEXEC, 'hearth-home-server-helper'), 'server-part', 'server-dns'] + args, 120)
    if code != 0:
        last = [ln for ln in (o + '\n' + e).splitlines() if ln.strip()]
        raise Fail((last or ["Hearth's cache didn't answer"])[-1].replace('error: ', ''))
    return {'ok': True}


