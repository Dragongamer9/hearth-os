def tb_words(n_gb):
    return '%d TB' % round(n_gb / 1000) if n_gb >= 1000 else '%d GB' % round(n_gb)


def pc_card(p, main=False, limits=None):
    """One PC's card from its status (hearth-device-status protocol 1 and Hearth Server's jobs)."""
    gpu = p.get('gpu') or {}
    ram = p.get('ram') or {}
    cpu = p.get('cpu') or {}
    bat = p.get('battery') or None
    disk = sum(float(d.get('total') or 0) for d in p.get('drives') or [])
    spec = [x for x in [gpu.get('name') or p.get('cpuName') or '', ('%d GB' % round(ram.get('total') or 0)) if ram.get('total') else '', tb_words(disk) if disk else '', p.get('where') or ''] if x]
    online = p.get('online', True)
    bits = ['Healthy' if online and not p.get('problem') else (p.get('problem') or 'Off')]
    if online and cpu.get('temp'):
        bits.append('%d°' % round(cpu['temp']))
    if online and p.get('note'):
        bits.append(p['note'])
    elif online and p.get('uptime'):
        bits.append('up %d days' % (int(p['uptime']) // 86400) if p['uptime'] >= 86400 else 'up %s' % dur(p['uptime']))
    if main:
        tag = 'main'
    elif p.get('via') == 'tailscale':
        tag = 'over Tailscale'
    elif bat and bat.get('charging'):
        tag = 'plugged in'
    else:
        tag = 'at home'
    right = ('%d W' % round(p['watts'])) if p.get('watts') else ''
    if p.get('limited') and limits:
        right = 'gives %d%%' % int(limits.get('dadMax') or 40)
    bars = [['CPU', float(cpu.get('use') or 0)]]
    if gpu:
        bars.append(['GPU', float(gpu.get('use') or 0)])
    elif bat:
        bars.append(['Battery', float(bat.get('percent') or 0), 'UPS' if p.get('ups') else '%d%%' % round(bat.get('percent') or 0)])
    jobs = [{'name': j.get('name', ''), 'kind': j.get('kind', 'services'), 'on': j.get('on', True), 'share': j.get('share')} for j in (p.get('jobs') or [])]
    return {'id': p.get('id') or p.get('name', ''), 'name': p.get('name', ''), 'mark': (p.get('name') or '?')[:1].upper(), 'spec': ' · '.join(spec),
            'tag': tag, 'health': ' · '.join(bits), 'right': right, 'bars': bars, 'jobs': jobs, 'online': online, 'main': main,
            'disk': disk, 'mood': p.get('mood') or ('main' if main else 'blue' if p.get('via') == 'tailscale' else 'grey')}


def share_of(cards):
    """Each PC's share of each kind of work: [label, [[pc index, what, weight]]]. A job says what it counts as
    (its "share": {"AI": [...], "games": [...], "backups": [...], "services": [...]}, from Hearth Server on that PC);
    storage is each PC's drives."""
    rows = []
    for label, kind in SHARE_ROWS:
        cells = []
        for i, c in enumerate(cards):
            if kind == 'storage':
                if c['disk']:
                    d = c['disk']
                    cells.append([i, tb_words(d) if d >= 1500 else (str(round(d / 1000)) if d >= 1000 else tb_words(d)), d])
                continue
            names = []
            for j in c['jobs']:
                sh = j.get('share') if isinstance(j.get('share'), dict) else {j.get('kind'): [j.get('name', '').split(' (')[0]]}
                names += [x for x in sh.get(kind) or [] if x]
            if names:
                cells.append([i, ', '.join(dict.fromkeys(names)), len(names)])
        total = ''
        if kind == 'storage':
            total = ' · %s' % tb_words(sum(c['disk'] for c in cards))
        elif kind == 'games':
            total = ' · %d' % sum(len(x[1].split(', ')) for x in cells)
        elif kind == 'backups' and len(cells) > 1:
            total = ' · %d copies' % len(cells)
        rows.append([label + total, cells])
    return rows


def moves_if_off(cards, name, limits):
    """What moves if that PC goes off: each job it runs, where it goes and what waits. Whole jobs only: one AI model is
    never split over the internet."""
    src_ = next((c for c in cards if c['name'] == name), None)
    main = next((c for c in cards if c['main']), None)
    if not src_ or not main or src_ is main and len(cards) == 1:
        return []
    to = main if src_ is not main else next((c for c in cards if c is not main), main)
    out = []
    ai = [j['name'].split(' (')[0].replace(' small model and ', ' and ').replace(' for the family', '') for j in src_['jobs'] if j['kind'] == 'AI']
    if ai:
        out.append(['wait', '%s move%s to the %s' % (' and '.join(ai) if len(ai) < 3 else ai[0], '' if len(ai) == 1 and ' and ' not in ai[0] else '', to['name']),
                    'Colibri waits its turn' if to['main'] else 'the big model stays'])
    for j in src_['jobs']:
        if j['kind'] == 'games':
            out.append(['arrow', '%s moves to the %s' % (j['name'].split(' (')[0], to['name']), 'world saved first · 40 s'])
    if any(j['kind'] == 'storage' for j in src_['jobs']):
        out.append(['off', 'The second backup copy waits for it' if not src_['main'] else 'Backups wait for it', 'first copy safe at home' if not src_['main'] else 'nothing is lost'])
    out.append(['ok', "Nothing is lost · moves back when it's on again", 'asks first' if limits.get('moveBack') == 'ask' else 'by itself'])
    return out


