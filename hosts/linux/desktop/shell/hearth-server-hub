    if kind == 'tv' and show:
        sn = safe_name(show)
        name = '%s S%02dE%02d%s' % (sn, int(season or 1), int(episode or 1), ext)
        return os.path.join(MEDIA, SUB['tv'], sn, 'Season %02d' % int(season or 1), name)
    if kind == 'own':
        return os.path.join(MEDIA, SUB['own'], safe_name(title) + ext)
    n = safe_name(title)
    return os.path.join(MEDIA, SUB['movie'], n, n + ext)


def archive_pick(title, docs):
    """The Internet Archive film that is this one and is public domain (its licence says so): the best title match."""
    want = _norm(re.sub(r'\(\d{4}\)', '', title))
    best = None
    for d in docs:
        lic = (d.get('licenseurl') or '').lower()
        if 'publicdomain' not in lic:
            continue
        got = _norm(d.get('title') or '')
        score = 2 if got == want else 1 if want and want in got else 0
        if score and (best is None or score > best[0]):
            best = (score, d)
    return best[1] if best else None


def archive_file(ident):
    """The film's best video file on the Internet Archive (its own metadata): an h.264 / MPEG4 one, the biggest."""
    url = 'https://archive.org/metadata/' + urllib.parse.quote(ident)
    with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'Hearth'}), timeout=20) as r:
        meta = json.loads(r.read(8 << 20).decode('utf-8'))
    files = [f for f in meta.get('files') or [] if (f.get('format') or '') in ('h.264', 'h.264 IA', 'MPEG4', '512Kb MPEG4', 'Matroska')
             and f.get('name', '').lower().endswith(('.mp4', '.mkv', '.m4v'))]
    files.sort(key=lambda f: -int(f.get('size') or 0))
    if not files:
        return None
    f = files[0]
    md = meta.get('metadata') or {}
    year = (re.search(r'(1[89]\d\d|20\d\d)', str(md.get('year') or md.get('date') or '')) or [None])[0]
    return {'url': 'https://archive.org/download/%s/%s' % (urllib.parse.quote(ident), urllib.parse.quote(f['name'])), 'size': int(f.get('size') or 0),
            'ext': os.path.splitext(f['name'])[1].lower(), 'title': md.get('title') or ident, 'year': year}


def run_job_unit(jid, args):
    """A long step (download, recording's ad cut, rip, join) as its own low-priority user unit; it reports back here."""
    if faking():
        return
    cmd(['systemd-run', '--user', '--collect', '--unit=hearth-media-%s' % jid, '--nice=12', '-p', 'IOSchedulingClass=idle',
         '/usr/bin/python3', os.path.realpath(__file__), 'media-run', jid] + args, 30)


def job_running(jid):
    return cmd(['systemctl', '--user', 'is-active', '--quiet', 'hearth-media-%s.service' % jid], 5)[0] == 0


def disc_in():
    """A disc in the drive (udev says it has media) and its label."""
    if not os.path.exists('/dev/sr0'):
        return None
    code, o, _ = cmd(['udevadm', 'info', '--query=property', '--name=/dev/sr0'], 5)
    if 'ID_CDROM_MEDIA=1' not in o:
        return None
    m = re.search(r'^ID_FS_LABEL=(.+)$', o, re.M)
    return (m.group(1) if m else '').replace('_', ' ').strip().title()


def media_tick(s, did):
    """The media board, one step at a time (the 5-minute timer): each wish starts its job (a recording through
    Jellyfin's guide, a public-domain film from the Internet Archive, your disc when it's in, your clips joined), each
    finished job is named (asking when it isn't sure), its ads cut (comskip, recordings only) and then goes into
    Jellyfin. Only from the five places in Where it comes from; nothing else is ever searched for."""
    m = s['media']
    jobs = {x.get('wish'): x for x in media_jobs() if x.get('wish')}
    t = now()
    for w in m.get('wanted') or []:
        if not isinstance(w, dict) or w.get('id') in jobs or not m.get({'antenna': 'antenna', 'disc': 'discs', 'free': 'free', 'own': 'own', 'folder': 'folder'}.get(w.get('from'), ''), True):
            continue
        jid = 'm%x' % int(t * 1000 + len(did))
        base = {'id': jid, 'wish': w['id'], 'title': w.get('title', ''), 'kind': w.get('kind', 'movie'), 'from': w.get('from'), 'state': 'getting',
                'at': int(t), 'art': ARTS_MEDIA.get(w.get('from'), ARTS_MEDIA['own']), 'progress': 0}
        try:
            if w['from'] == 'free':
                docs = archive_search(w['title'])
                d = archive_pick(w['title'], docs)
                if not d:
                    continue                       # asked again next time; nothing that isn't public domain
                f = archive_file(d['identifier'])
                if not f:
                    continue
                title = '%s (%s)' % (f['title'], f['year']) if f['year'] and f['year'] not in f['title'] else f['title']
                job_add(dict(base, line='public domain · Internet Archive', left='starting', src=f['url'], size=f['size'], ext=f['ext'], guess=title, step='get'))
                run_job_unit(jid, ['get'])
            elif w['from'] == 'antenna':
                progs = jf('/LiveTv/Programs?searchTerm=%s&limit=5&hasAired=false' % urllib.parse.quote(w['title'])).get('Items') or []
                if not progs:
                    continue
                prog = progs[0]
                defaults = jf('/LiveTv/Timers/Defaults?programId=%s' % urllib.parse.quote(prog['Id']))
                jf_post('/LiveTv/SeriesTimers', defaults)
                job_add(dict(base, line='records from %s' % (prog.get('ChannelName') or 'the antenna'), left='waits for it to air', step='record',
                             series=prog.get('SeriesId') or prog.get('Name'), show=prog.get('SeriesName') or prog.get('Name') or w['title']))
            elif w['from'] == 'disc':
                label = disc_in()
                if label is None:
                    continue                       # waits for the disc
                job_add(dict(base, line='ripping from the disc drive', left='starting', guess=w['title'], label=label, step='get'))
                run_job_unit(jid, ['rip'])
            elif w['from'] in ('own', 'folder'):
                folder = os.path.join(MEDIA, SUB['drop'], safe_name(w['title']))
                clips = sorted(os.path.join(folder, n) for n in os.listdir(folder) if n.lower().endswith(VIDEO_EXT)) if os.path.isdir(folder) else []
                if not clips:
                    continue                       # waits for the clips in Media/Drop/<title>
                job_add(dict(base, kind='own', line='your own video · %d clips' % len(clips), left='joining', guess=w['title'], clips=clips, step='get'))
                run_job_unit(jid, ['join'])
        except (Fail, OSError, ValueError, KeyError) as e:
            did.append('media %s: %s' % (w.get('title'), e))
    for j in media_jobs():
        jid = j['id']
        if j.get('step') == 'record':
            # Jellyfin records it; each finished recording of that show comes onto the board as its own job.
            try:
                recs = jf('/LiveTv/Recordings?seriesTimerId=&isInProgress=false').get('Items') or []
            except (Fail, OSError, ValueError):
                recs = []
            for r in recs:
                if (r.get('SeriesName') or r.get('Name')) == j.get('show') and r.get('Path') and not any(x.get('srcPath') == r['Path'] for x in media_jobs()):
                    rid = jid + '-' + hashlib_short(r['Path'])[:6]
                    job_add({'id': rid, 'title': '%s · s%s e%s' % (j['show'], r.get('ParentIndexNumber') or 1, r.get('IndexNumber') or 1), 'kind': 'tv',
                             'from': 'antenna', 'state': 'getting', 'line': 'recorded · cutting the ads' if have('comskip') else 'recorded',
                             'srcPath': r['Path'], 'file': r['Path'], 'show': j['show'], 'season': r.get('ParentIndexNumber') or 1,
                             'episode': r.get('IndexNumber') or 1, 'art': j.get('art'), 'step': 'cut', 'at': int(t), 'progress': 1})
                    if have('comskip'):
                        run_job_unit(rid, ['cut'])
                    else:
                        job_set(rid, step='name', line='recorded · ads kept (comskip isn\'t on this PC)')
            continue
        if j.get('step') == 'name' and not job_running(jid):
            media_name(j, m)
        elif j.get('step') == 'into' and t - int(j.get('readyAt') or 0) >= 120:
            media_into(jid)


def media_name(j, m):
    """Its name in the library: the title the source gave (the Internet Archive's, the guide's), or, from a disc, the
    disc's label: asked when it isn't the same as the wish (Ask me when it isn't sure), else going in by itself."""
    guess = j.get('guess') or j.get('title')
    sure = j.get('from') in ('free', 'antenna', 'own') or _norm(j.get('label') or '') == _norm(guess)
    if not m.get('autoName', True) or (m.get('ask', True) and not sure):
        job_set(j['id'], state='ready', step='ask', ask='is this "%s"?' % guess, guess=guess, line='named · waiting for you')
    else:
        job_set(j['id'], state='ready', step='into', readyAt=int(now()), line='named · art from Jellyfin', line2='going into Jellyfin in 2 min')


def media_into(jid, title=None):
    """Into Jellyfin: the file moved to its place in the library (Movies/Title (Year)/, TV/Show/Season NN/, Home
    videos/), then Jellyfin is asked to look (it finds the art itself)."""
    j = next((x for x in media_jobs() if x.get('id') == jid), None)
    if not j:
        raise Fail('nothing waiting by that id')
    f = j.get('file') or ''
    if not faking():
        if not os.path.isfile(f):
            raise Fail('the file is gone')
        ext = os.path.splitext(f)[1].lower()
        dest = library_path(j.get('kind'), title or j.get('guess') or j.get('title'), ext, j.get('season'), j.get('episode'), j.get('show'))
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        if os.path.exists(dest):
            raise Fail('there is already one by that name in the library')
        if j.get('from') == 'antenna':
            shutil.copy2(f, dest)              # Jellyfin keeps its own recording; the library gets the cut copy
        else:
            shutil.move(f, dest)
        try:
            jf_post('/Library/Refresh')
        except (Fail, OSError):
            pass
    job_set(jid, state='done', step='done', doneAt=int(now()))
    return {'ok': True}


def media_run(jid, what):
    """A long step of a job, in its own unit (run_job_unit): get (a download from the Internet Archive), rip (your
    disc, copied as it is), join (your clips into one video), cut (a recording's ads, found by comskip)."""
    j = next((x for x in media_jobs() if x.get('id') == jid), None)
    if not j:
        raise Fail('no job by that id')
    os.makedirs(os.path.join(MEDIA, SUB['getting']), exist_ok=True)
    out = os.path.join(MEDIA, SUB['getting'], '%s%s' % (jid, j.get('ext') or '.mkv'))
    try:
        if what == 'get':
            url = j.get('src') or ''
            if not url.startswith('https://archive.org/download/'):
                raise Fail('only the Internet Archive')
            p = subprocess.Popen(['curl', '-fsSL', '--proto', '=https', '--retry', '3', '-C', '-', '-o', out, url])
            while p.poll() is None:
                time.sleep(10)
                got = os.path.getsize(out) if os.path.exists(out) else 0
                size = int(j.get('size') or 0)
                job_set(jid, progress=min(1.0, got / size) if size else 0, left='%d%% · %s of %s' % (100 * got / size if size else 0, gb(got), gb(size)))
            if p.returncode != 0:
                raise Fail("the download didn't finish")
        elif what == 'rip':
            # As it is: ffmpeg through libbluray (or the DVD's files); a copy-protected disc isn't unlocked.
            code, o, e = cmd(['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'csv=p=0', 'bluray:/dev/sr0'], 120)
            total = float(o.strip() or 0) if code == 0 and re.fullmatch(r'[\d.]+', o.strip() or 'x') else 0
            prog = out + '.progress'
            p = subprocess.Popen(['ffmpeg', '-nostdin', '-y', '-loglevel', 'error', '-progress', prog, '-i', 'bluray:/dev/sr0', '-map', '0', '-c', 'copy', out])
            while p.poll() is None:
                time.sleep(10)
                try:
                    us = [int(x.split('=')[1]) for x in open(prog).read().splitlines() if x.startswith('out_time_us=') and x.split('=')[1].isdigit()]
                except OSError:
                    us = []
                if us and total:
                    done_ = min(1.0, us[-1] / 1e6 / total)
                    job_set(jid, progress=done_, left='%d%% · %s left' % (100 * done_, dur((total - us[-1] / 1e6) * 1.0)))
            if os.path.exists(prog):
                os.unlink(prog)
            if p.returncode != 0:
                raise Fail("the disc couldn't be copied as it is (a copy-protected disc isn't unlocked)")
        elif what == 'join':
            clips = [c for c in j.get('clips') or [] if os.path.isfile(c) and os.path.realpath(c).startswith(os.path.realpath(MEDIA) + os.sep)]
            if not clips:
                raise Fail('the clips are gone')
            lst = out + '.txt'
            with open(lst, 'w', encoding='utf-8') as f:
                for c in clips:
                    f.write("file '%s'\n" % c.replace("'", "'\\''"))
            codecs = set()
            for c in clips:
                code, o, _ = cmd(['ffprobe', '-v', 'error', '-select_streams', 'v:0', '-show_entries', 'stream=codec_name,width,height', '-of', 'csv=p=0', c], 60)
                codecs.add(o.strip())
            same = len(codecs) == 1
            out = os.path.splitext(out)[0] + '.mkv'
            args = ['ffmpeg', '-nostdin', '-y', '-loglevel', 'error', '-f', 'concat', '-safe', '0', '-i', lst]
            args += ['-c', 'copy', out] if same else ['-c:v', 'libx264', '-crf', '20', '-preset', 'medium', '-c:a', 'aac', '-b:a', '192k', out]
            code, o, e = cmd(args, 6 * 3600)
            os.unlink(lst)
            if code != 0:
                raise Fail("the clips couldn't be joined")
        elif what == 'cut':
            out = os.path.splitext(out)[0] + '.mkv'
            cut_ads(j['file'], out)
        else:
            raise Fail('get, rip, join or cut')
        job_set(jid, file=out, progress=1, step='name', left='done', line={'get': 'downloaded', 'rip': 'copied from your disc', 'join': '%d clips joined' % len(j.get('clips') or []),
                                                                            'cut': 'ads cut out'}.get(what, ''))
        media_name(dict(j, file=out), settings()['media'])
    except Fail as e:
        job_set(jid, state='ready', step='failed', line=str(e), left='')
        raise
    return {'ok': True}


def edl_keep(edl_text, total):
    """The parts to keep from comskip's .edl (each line: start end type; type 0 is an ad break)."""
    cuts = []
    for ln in edl_text.splitlines():
        f = ln.split()
        if len(f) >= 2:
            try:
                a_, b_ = float(f[0]), float(f[1])
            except ValueError:
                continue
            if b_ > a_:
                cuts.append((a_, b_))
    keep, cur = [], 0.0
    for a_, b_ in sorted(cuts):
        if a_ - cur > 1:
            keep.append((cur, a_))
        cur = max(cur, b_)
    if total - cur > 1:
        keep.append((cur, total))
    return keep


def cut_ads(src_, out):
    """A recording without its ad breaks: comskip finds them (an .edl), ffmpeg keeps the rest, joined as one file.
    Jellyfin's own recording is left as it was."""
    work = out + '.parts'
    os.makedirs(work, exist_ok=True)
    try:
        code, o, e = cmd(['comskip', '--output=' + work, '--quiet', src_], 6 * 3600)
        edl = [os.path.join(work, n) for n in os.listdir(work) if n.endswith('.edl')]
        code2, d, _ = cmd(['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'csv=p=0', src_], 60)
        total = float(d.strip()) if code2 == 0 and re.fullmatch(r'[\d.]+', d.strip() or 'x') else 0
        keep = edl_keep(open(edl[0]).read(), total) if edl and total else [(0.0, total)]
        lst = os.path.join(work, 'list.txt')
        with open(lst, 'w', encoding='utf-8') as f:
            for i, (a_, b_) in enumerate(keep):
                part = os.path.join(work, 'part%03d.ts' % i)
                c, _, _ = cmd(['ffmpeg', '-nostdin', '-y', '-loglevel', 'error', '-ss', '%.2f' % a_, '-to', '%.2f' % b_, '-i', src_, '-map', '0', '-c', 'copy', part], 3600)
                if c == 0:
                    f.write("file '%s'\n" % part)
        c, _, _ = cmd(['ffmpeg', '-nostdin', '-y', '-loglevel', 'error', '-f', 'concat', '-safe', '0', '-i', lst, '-map', '0', '-c', 'copy', out], 3600)
        if c != 0:
            raise Fail("the ads couldn't be cut")
    finally:
        shutil.rmtree(work, ignore_errors=True)


