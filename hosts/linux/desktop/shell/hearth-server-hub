def bedrock_names(lines):
    """Who's on a Bedrock server now, from its log ("Player connected: NAME, xuid: …" / "Player disconnected: …")."""
    on = []
    for ln in lines:
        m = re.search(r'Player (connected|disconnected): ([^,]{1,40}),', ln)
        if m:
            nm = m.group(2).strip()
            on = [x for x in on if x != nm] + ([nm] if m.group(1) == 'connected' else [])
    return on


def minecraft_addrs(lines):
    """{name: address} from a Java server's log ("Sam[/100.101.102.103:51234] logged in with entity id …")."""
    out = {}
    for ln in lines:
        m = re.search(r'([A-Za-z0-9_]{2,16})\[/\[?([0-9a-fA-F.:]+?)\]?:\d+\] logged in', ln)
        if m:
            out[m.group(1)] = m.group(2)
    return out


def _hex_ip(h):
    b = bytes.fromhex(h)
    if len(b) == 4:
        return socket.inet_ntop(socket.AF_INET, b[::-1])
    words = b''.join(b[i:i + 4][::-1] for i in range(0, 16, 4))
    ip = socket.inet_ntop(socket.AF_INET6, words)
    return ip[7:] if ip.startswith('::ffff:') else ip


def proc_net_peers(text, ports):
    """Remote addresses connected to these local ports, from /proc/net/{tcp,udp}[6] text (TCP: established only;
    UDP: connected sockets only)."""
    out = set()
    for ln in text.splitlines():
        f = ln.split()
        if len(f) < 4 or ':' not in f[1] or ':' not in f[2]:
            continue
        try:
            lport = int(f[1].split(':')[1], 16)
            rip, rport = f[2].split(':')
            rport = int(rport, 16)
        except ValueError:
            continue
        if lport in ports and rport and f[3] in ('01', '07'):
            ip = _hex_ip(rip)
            if ip not in ('0.0.0.0', '::', '127.0.0.1', '::1'):
                out.add(ip)
    return out


def ss_peers(text, ports):
    out = set()
    for ln in text.splitlines():
        f = ln.split()
        loc = [x for x in f if re.search(r':\d+$', x)]
        if len(loc) < 2:
            continue
        try:
            lport = int(loc[0].rsplit(':', 1)[1])
        except ValueError:
            continue
        rip = loc[1].rsplit(':', 1)[0].strip('[]')
        if lport in ports and rip not in ('*', '0.0.0.0', '::', '127.0.0.1', '::1') and not rip.startswith('127.'):
            out.add(rip.split('%')[0])
    return out


