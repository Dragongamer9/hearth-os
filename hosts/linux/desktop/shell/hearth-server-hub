VALHEIM_DAY_SECS = 1800       # EnvMan.m_dayLengthSec: one in-game day is 30 minutes


def valheim_day(db_head):
    """The in-game day from the top of a Valheim world's .db: its version (int32), then (version 4 and later) the
    world's time in seconds (a double, what ZNet saves); the day is that over the day's length (EnvMan.GetDay)."""
    if len(db_head) < 12:
        return None
    ver = struct.unpack_from('<i', db_head, 0)[0]
    if ver < 4 or ver > 1000:
        return None
    t = struct.unpack_from('<d', db_head, 4)[0]
    if not (0 <= t < 1e12):
        return None
    return int(t // VALHEIM_DAY_SECS)


def world_info(gid, opts):
    """Valheim's world: its seed (from the .fwl file) and its day (from the .db, as of the server's last save)."""
    def live():
        catalog()
        d = sa().data_dir(gid, 'config')
        w = opts.get('worldName') or 'Hearth'
        p = os.path.join(d, 'worlds_local', w + '.fwl')
        with open(p, 'rb') as f:
            b = f.read(4096)
        i = 8

        def s7(i):
            n, shift = 0, 0
            while True:
                c = b[i]
                i += 1
                n |= (c & 0x7f) << shift
                shift += 7
                if not c & 0x80:
                    return b[i:i + n].decode('utf-8', 'replace'), i + n
        _, i = s7(i)
        seed, i = s7(i)
        out = {'seed': seed}
        try:
            with open(os.path.join(d, 'worlds_local', w + '.db'), 'rb') as f:
                day = valheim_day(f.read(12))
            if day is not None:
                out['day'] = day
        except OSError:
            pass
        return out
    return src('world.' + gid, live, {}) or {}


