def root(args, stdin=None):
    """The Home server helper as root (pkexec; it asks for the admin password where its polkit rule says so)."""
    if faking():
        return {'ok': True}
    code, out, err = cmd(['pkexec', os.path.join(LIBEXEC, 'hearth-home-server-helper')] + args, 900, stdin)
    try:
        res = json.loads(out.strip().splitlines()[-1])
    except (ValueError, IndexError):
        raise Fail((err.strip().splitlines() or ["the Home server helper didn't answer"])[-1])
    if not res.get('ok'):
        raise Fail(res.get('error') or "the Home server helper said no")
    return res


