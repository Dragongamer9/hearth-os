#!/usr/bin/env python3
"""System stats for Mantel's dashboard and the Gaming look's performance island (Mantel 2026).

  hearth-stats            one JSON line now
  hearth-stats --watch N  a JSON line every N seconds (Mantel runs this only while the island or the dashboard shows)

{"cpu": 23, "cpuTemp": 58, "gpu": 41, "gpuTemp": 61, "ram": 5.1, "ramTotal": 16.0, "fps": 144, "gpuWatts": 18.2,
 "cpuWatts": 9.5, "batteryWatts": 14.1}
Watts (Firehold's performance overlay): the GPU's from its hwmon power1_average / power1_input (amdgpu, i915/xe) or
nvidia-smi's power.draw; the CPU's from RAPL's energy counter between two readings (when this user may read it); the
battery's power_now while it's running on battery. Each only when there's a real source.
A value that can't be read is left out (the shell then hides it). Only reads /proc and /sys, never writes anything.

FPS: a desktop shell can't measure another program's frame rate on labwc, so it's only shown when MangoHud is
logging (its CSV log in MangoHud's output_folder, written in the last few seconds); otherwise "fps" is left out.
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys
import time

FPS_FRESH = 5.0     # seconds: an older MangoHud log means the game isn't running any more


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ''


def cpu_times(stat_text):
    """(busy, total) jiffies from the first line of /proc/stat."""
    for line in stat_text.splitlines():
        if line.startswith('cpu '):
            v = [int(x) for x in line.split()[1:] if x.isdigit()]
            if len(v) < 4:
                return None
            idle = v[3] + (v[4] if len(v) > 4 else 0)
            return sum(v) - idle, sum(v)
    return None


def cpu_percent(a, b):
    if not a or not b or b[1] <= a[1]:
        return None
    return max(0, min(100, round(100.0 * (b[0] - a[0]) / (b[1] - a[1]))))


def memory(meminfo_text):
    """(used GB, total GB) from /proc/meminfo."""
    kb = {}
    for line in meminfo_text.splitlines():
        m = re.match(r'(\w+):\s+(\d+)', line)
        if m:
            kb[m.group(1)] = int(m.group(2))
    if 'MemTotal' not in kb or 'MemFree' not in kb:
        return None
    gb = 1024.0 * 1024.0
    # In use as Windows counts it: total − free − cache (1.11; total − MemAvailable read 100% with gigabytes free).
    cache = kb.get('Cached', 0) + kb.get('Buffers', 0) + kb.get('SReclaimable', 0) - kb.get('Shmem', 0)
    used = max(0, kb['MemTotal'] - kb['MemFree'] - max(0, cache))
    return round(used / gb, 1), round(kb['MemTotal'] / gb, 1)


def gpu_busy(root='/sys/class/drm'):
    """amdgpu's (and i915/xe's where present) busy percent."""
    for p in sorted(glob.glob(os.path.join(root, 'card*/device/gpu_busy_percent'))):
        t = read(p).strip()
        if t.isdigit():
            return max(0, min(100, int(t)))
    return None


def hwmon_temps(root='/sys/class/hwmon'):
    """{'cpu': °C, 'gpu': °C} from hwmon sensors by name (k10temp/zenpower/coretemp for the CPU, amdgpu/nouveau for the GPU)."""
    cpu_names = ('k10temp', 'zenpower', 'coretemp', 'cpu_thermal')
    gpu_names = ('amdgpu', 'nouveau', 'radeon', 'xe', 'i915')
    out, weak = {}, {}
    for d in sorted(glob.glob(os.path.join(root, 'hwmon*'))):
        name = read(os.path.join(d, 'name')).strip()
        t = read(os.path.join(d, 'temp1_input')).strip()
        if not t.lstrip('-').isdigit():
            continue
        c = round(int(t) / 1000)
        if name in cpu_names and 'cpu' not in out:
            out['cpu'] = c
        elif name in gpu_names and 'gpu' not in out:
            out['gpu'] = c
        elif name == 'acpitz':
            weak.setdefault('cpu', c)          # the board's sensor: only when there's no CPU sensor
    for k, v in weak.items():
        out.setdefault(k, v)
    return out


def mangohud_folders(home):
    folders = []
    conf = read(os.path.join(home, '.config', 'MangoHud', 'MangoHud.conf'))
    for line in conf.splitlines():
        m = re.match(r'\s*output_folder\s*=\s*(.+?)\s*$', line)
        if m:
            folders.append(os.path.expanduser(m.group(1)))
    env = os.environ.get('MANGOHUD_CONFIG', '')
    m = re.search(r'output_folder=([^,]+)', env)
    if m:
        folders.append(os.path.expanduser(m.group(1)))
    folders.append(os.path.join(home, '.local', 'share', 'MangoHud'))
    return folders


def last_fps(csv_text):
    """The frame rate on the last line of a MangoHud CSV log (its first column is fps)."""
    lines = [l for l in csv_text.strip().splitlines() if l.strip()]
    for line in reversed(lines[-3:]):
        first = line.split(',')[0].strip()
        try:
            v = float(first)
        except ValueError:
            continue
        if 0 < v < 2000:
            return round(v)
    return None


def fps(home, now=None):
    now = time.time() if now is None else now
    newest, newest_t = None, 0
    for folder in mangohud_folders(home):
        for p in glob.glob(os.path.join(folder, '*.csv')):
            try:
                t = os.path.getmtime(p)
            except OSError:
                continue
            if t > newest_t:
                newest, newest_t = p, t
    if not newest or now - newest_t > FPS_FRESH:
        return None
    try:
        with open(newest, 'rb') as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 4096))
            return last_fps(f.read().decode('utf-8', 'replace'))
    except OSError:
        return None


def gpu_watts(root='/sys/class/hwmon'):
    """The GPU's power draw in watts: hwmon (amdgpu, radeon, xe, i915, nouveau), else nvidia-smi; None without one."""
    for d in sorted(glob.glob(os.path.join(root, 'hwmon*'))):
        if read(os.path.join(d, 'name')).strip() not in ('amdgpu', 'radeon', 'xe', 'i915', 'nouveau'):
            continue
        for f in ('power1_average', 'power1_input'):
            v = read(os.path.join(d, f)).strip()
            if v.isdigit() and int(v) > 0:
                return round(int(v) / 1e6, 1)
    nv = shutil.which('nvidia-smi')
    if nv:
        try:
            r = subprocess.run([nv, '--query-gpu=power.draw', '--format=csv,noheader,nounits'], capture_output=True,
                               text=True, timeout=2, check=False)
            v = float(r.stdout.strip().splitlines()[0])
            if v > 0:
                return round(v, 1)
        except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
            pass
    return None


RAPL = {}


def cpu_watts(root='/sys/class/powercap', now=None):
    """The CPU package's power from RAPL's energy counter (µJ) since the last call; None the first time, or when the
    counter can't be read (often root's only), or it wrapped."""
    f = None
    for d in sorted(glob.glob(os.path.join(root, '*rapl:0'))):
        if os.path.isfile(os.path.join(d, 'energy_uj')):
            f = os.path.join(d, 'energy_uj')
            break
    if not f:
        return None
    v = read(f).strip()
    if not v.isdigit():
        return None
    now = time.monotonic() if now is None else now
    prev = RAPL.get(f)
    RAPL[f] = (int(v), now)
    if not prev or now <= prev[1] or int(v) < prev[0]:
        return None
    return round((int(v) - prev[0]) / 1e6 / (now - prev[1]), 1)


def battery_watts(root='/sys/class/power_supply'):
    """What the whole device draws while it's on battery (power_now, µW; or current_now × voltage_now)."""
    for d in sorted(glob.glob(os.path.join(root, 'BAT*'))):
        if read(os.path.join(d, 'status')).strip() != 'Discharging':
            continue
        p = read(os.path.join(d, 'power_now')).strip()
        if p.isdigit() and int(p) > 0:
            return round(int(p) / 1e6, 1)
        c, u = read(os.path.join(d, 'current_now')).strip(), read(os.path.join(d, 'voltage_now')).strip()
        if c.isdigit() and u.isdigit() and int(c) > 0:
            return round(int(c) * int(u) / 1e12, 1)
    return None


def snapshot(prev_cpu, home):
    now_cpu = cpu_times(read('/proc/stat'))
    out = {}
    c = cpu_percent(prev_cpu, now_cpu)
    if c is not None:
        out['cpu'] = c
    m = memory(read('/proc/meminfo'))
    if m:
        out['ram'], out['ramTotal'] = m
    g = gpu_busy()
    if g is not None:
        out['gpu'] = g
    t = hwmon_temps()
    if 'cpu' in t:
        out['cpuTemp'] = t['cpu']
    if 'gpu' in t:
        out['gpuTemp'] = t['gpu']
    f = fps(home)
    if f is not None:
        out['fps'] = f
    for k, fn in (('gpuWatts', gpu_watts), ('cpuWatts', cpu_watts), ('batteryWatts', battery_watts)):
        w = fn()
        if w is not None:
            out[k] = w
    return out, now_cpu


def main(argv):
    home = os.path.expanduser('~')
    every = 0.0
    if len(argv) > 2 and argv[1] == '--watch':
        try:
            every = max(1.0, float(argv[2]))
        except ValueError:
            every = 2.0
    prev = cpu_times(read('/proc/stat'))
    time.sleep(0.5)
    while True:
        out, prev = snapshot(prev, home)
        sys.stdout.write(json.dumps(out) + '\n')
        sys.stdout.flush()
        if not every:
            return 0
        time.sleep(every)


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv))
    except (KeyboardInterrupt, BrokenPipeError):
        sys.exit(0)
