#!/bin/sh
# hearth-overlay: Hearth's Quick Access as Handheld Daemon's overlay app. The HHD editions of Hearth OS (Anatase,
# Ubuntu, CachyOS, Peppermint) install it as /usr/bin/hhd-ui and point HHD_OVERLAY at it, so HHD starts it the way it
# starts its own hhd-ui (hhd/plugins/overlay/overlay.py). The Bazzite build doesn't: it keeps Hearth's own overlay.
#   Game Mode (gamescope, STEAM_OVERLAY=1): Hearth's Quick Access page in Chromium (Hearth Browser's Electron,
#     `nimbus --hhd-overlay`, hosts/linux/src/overlay), talking to the running Hearth app.
#   Desktop Mode (HHD_MANAGED=1): no window of its own: HHD's QAM button opens Mantel's Quick Access. It ends by
#     itself when Desktop Mode does (see below), so HHD goes back to the Game Mode way.
#   --version: the version HHD shows for its overlay (HHD runs this as root when it starts: nothing else happens).
# HHD starts it with only HOME, DISPLAY, PATH and STEAM_OVERLAY or HHD_MANAGED (and XAUTHORITY): Game Mode fills in
# the session's language, runtime folder and bus, and gives Chromium a fontconfig setup it can read (fonts_setup).
APP="${HEARTH_OVERLAY_ELECTRON:-/usr/lib/hearth-browser/nimbus}"
SHARE="${NIMBUS_SHARE:-/usr/share/nimbus}"

case "${1:-}" in
  --version|-v)
    v=$(cat "$SHARE/version" 2>/dev/null || true)
    echo "Hearth Quick Access ${v:-0.0.0}"
    exit 0 ;;
esac

uid=$(id -u)
if [ "$uid" = 0 ]; then
  echo "hearth-overlay: runs as the signed-in user, not root" >&2
  exit 1
fi
# The user's runtime folder: where Hearth's overlay socket is (and what Chromium expects).
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$uid" ]; then
  XDG_RUNTIME_DIR="/run/user/$uid"
  export XDG_RUNTIME_DIR
fi

# HHD passes no session bus either ("Failed to connect to the bus: Could not parse server address" over and over):
# the user's bus is in the runtime folder.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
  DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
  export DBUS_SESSION_BUS_ADDRESS
fi

# Which mode Hearth's session is in: nimbus-session writes it to $XDG_RUNTIME_DIR/nimbus-mode-now (game or desktop).
# Game Mode is that file saying game (or, outside Hearth's session, no file) with gamescope running for this user:
# a game run in gamescope inside Desktop Mode isn't Game Mode, and a file left over from a crash isn't either.
X11_DIR="${HEARTH_X11_DIR:-/tmp/.X11-unix}"
gamescope_up() { pgrep -u "$uid" -x gamescope-wl >/dev/null 2>&1 || pgrep -u "$uid" -x gamescope >/dev/null 2>&1; }
in_game_mode() {
  case "$(cat "${XDG_RUNTIME_DIR:-/run/user/$uid}/nimbus-mode-now" 2>/dev/null)" in
    desktop) return 1 ;;
    *) gamescope_up ;;
  esac
}
# The X display HHD gave us (DISPLAY=:0) is gone: Desktop Mode (labwc and its Xwayland) has ended.
display_gone() {
  d="${DISPLAY#*:}"; d="${d%%.*}"
  [ -n "$d" ] && [ ! -e "$X11_DIR/X$d" ]
}

if [ -z "${STEAM_OVERLAY:-}" ] && [ -n "${HHD_MANAGED:-}" ]; then
  # Desktop Mode. HHD writes "cmd:..." lines; the first press of a double press (open_qam_if_closed) is left out so
  # a double press doesn't open and close it again.
  #
  # HHD keeps using the overlay app it started for Desktop Mode until that app ends (hhd/plugins/overlay/base.py:
  # OverlayService.update and launch_overlay return early while `started` is set, and only loop_manage_desktop
  # seeing the process end clears it). So once Desktop Mode is over (back in Game Mode, or signed out), this has to
  # end by itself: otherwise every QAM press and every request of Hearth's to start the overlay lands here, Mantel
  # isn't running to answer, and Quick Access never opens over a game again until HHD restarts. Ending (code 1)
  # makes HHD start the overlay app again the Game Mode way, in gamescope, within a few seconds.
  if in_game_mode; then
    echo "hearth-overlay: Handheld Daemon started me for Desktop Mode (DISPLAY=${DISPLAY:-none}), but Hearth's Game Mode (gamescope) is running; ending so HHD starts me in gamescope" >&2
    exit 1
  fi
  left_desktop() {
    if in_game_mode; then why="Game Mode (gamescope) is running again"; return 0; fi
    if display_gone; then why="Desktop Mode's display ($DISPLAY) is gone"; return 0; fi
    return 1
  }
  # Watches for Desktop Mode ending while HHD has nothing to say (no press for hours is normal).
  me=$$
  (
    while sleep "${HEARTH_OVERLAY_POLL:-2}"; do
      kill -0 "$me" 2>/dev/null || exit 0
      if left_desktop; then
        echo "hearth-overlay: $why; ending so Handheld Daemon starts Quick Access in gamescope" >&2
        kill -TERM "$me" 2>/dev/null
        exit 0
      fi
    done
  ) </dev/null >/dev/null &
  watcher=$!
  # Ending by itself, the watcher goes too (it can't tell by itself: an ended process HHD hasn't reaped yet still
  # answers kill -0).
  while IFS= read -r line; do
    case "$line" in
      cmd:open_qam|cmd:open_expanded|cmd:open_overlay)
        if left_desktop; then
          echo "hearth-overlay: $why; ending so Handheld Daemon starts Quick Access in gamescope" >&2
          kill "$watcher" 2>/dev/null
          exit 1
        fi
        if ! err=$(quickshell ipc -p "$SHARE/desktop/shell" call quick toggle 2>&1 >/dev/null); then
          err=$(printf '%s' "$err" | tr '\n' ' ' | cut -c1-200)
          echo "hearth-overlay: Mantel's Quick Access didn't answer${err:+ ($err)}" >&2
        fi ;;
    esac
  done
  kill "$watcher" 2>/dev/null
  exit 0
fi

if [ ! -x "$APP" ]; then
  echo "hearth-overlay: $APP is missing (Hearth Browser's Electron)" >&2
  exit 1
fi
# Game Mode: HHD found gamescope's display and passes it as DISPLAY. Without one there's nothing to draw on: end
# with a clear message (HHD logs it and tries again) rather than start a window that can't show.
if [ -z "${DISPLAY:-}" ]; then
  echo "hearth-overlay: no DISPLAY from Handheld Daemon (gamescope's); not starting" >&2
  exit 1
fi

# ---- What HHD leaves out (it starts us with only HOME, DISPLAY, PATH and STEAM_OVERLAY): the session's language and
# data folders, from the user's systemd environment (what Hearth's own window gets), else /etc/locale.conf. Only these
# few: WAYLAND_DISPLAY and the like would send Chromium off gamescope's X display.
LOG="${XDG_RUNTIME_DIR:-/tmp}/hearth-overlay.log"
note() { echo "hearth-overlay: $*" >&2; echo "hearth-overlay: $*" >> "$LOG" 2>/dev/null || true; }
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG" 2>/dev/null || echo 0)" -gt 262144 ]; then tail -c 131072 "$LOG" > "$LOG.new" 2>/dev/null && mv "$LOG.new" "$LOG"; fi
echo "--- $(date '+%Y-%m-%d %H:%M:%S') Quick Access started by Handheld Daemon in Game Mode (DISPLAY=$DISPLAY)" >> "$LOG" 2>/dev/null || true
if [ -z "${HEARTH_OVERLAY_NO_SESSION_ENV:-}" ]; then
  senv=$(timeout 3 systemctl --user show-environment 2>/dev/null || true)
  for v in LANG LANGUAGE LC_ALL LC_CTYPE LC_MESSAGES XDG_DATA_DIRS XDG_CONFIG_DIRS XDG_DATA_HOME XDG_CONFIG_HOME XDG_CACHE_HOME; do
    eval "cur=\${$v:-}"
    [ -z "$cur" ] || continue
    line=$(printf '%s\n' "$senv" | grep -E "^$v=[A-Za-z0-9_.:@/,+-]+\$" | head -1)
    [ -n "$line" ] && export "$line"
  done
  if [ -z "${LANG:-}" ] && [ -r /etc/locale.conf ]; then
    line=$(grep -E '^LANG=[A-Za-z0-9_.@-]+$' /etc/locale.conf | head -1)
    [ -n "$line" ] && export "$line"
  fi
fi

# ---- Fonts. Chromium (Electron) has its own copy of fontconfig, older than the system's. On Anatase (Fedora 45,
# fontconfig 2.17) the system's /etc/fonts/conf.d has files that copy can't read (48-guessfamily.conf, 48-spacing.conf,
# 49-sansserif.conf: "invalid constant used : sans-serif", "invalid attribute 'xsi:nil'"), and Quick Access over games
# came up with no text at all on the Nvidia PC ("Could not find any font: Sans, sans" in HHD's log). So the overlay
# gets a fonts.conf of its own: the system's font folders and every conf.d file its fontconfig can read, the plain
# generic-family rules those three files replaced, and a font cache of its own that's made again whenever the image's
# fonts change (ostree keeps every folder's time the same across updates, so fontconfig can't tell by itself; an old
# cache names font files that are gone, and Chromium then finds none). HEARTH_OVERLAY_SYSTEM_FONTS=1 turns it off.
# Every file is copied, not included in place: a conf.d file can itself <include> one of those three by its own path
# (Fedora 45's pulled /usr/share/fontconfig/conf.avail/48-guessfamily.conf back in: 45 warnings), so the files a
# copy includes are followed the same way (fc_take) and the copies have no <include> of their own.
#
# fc_take <file or folder>: the file (or the folder's *.conf files) copied into $dir/conf, an <include> line for each
# copy on stdout, then the same for what it includes; left out (named in $left) when Chromium's fontconfig can't read it.
fc_take() {
  local real incf inc attrs body path k
  real=$(readlink -f "$1" 2>/dev/null) || return 0
  [ -n "$real" ] || return 0
  if [ -d "$real" ]; then
    for k in "$real"/*.conf; do [ -e "$k" ] && fc_take "$k"; done
    return 0
  fi
  [ -f "$real" ] && [ -r "$real" ] || return 0
  case " $seen " in *" $real "*) return 0 ;; esac
  seen="$seen $real"
  if grep -Eq "$newsyntax" "$real" 2>/dev/null; then left="$left ${real##*/}"; return 0; fi
  n=$((n + 1))
  k="$dir/conf/$(printf '%03d' "$n")-${real##*/}"
  # (-z: an <include> written over several lines, as Fedora 45's are, is one match too.)
  sed -z -e 's#<include[^>]*/>##g' -e 's#<include[^>]*>[^<]*</include>##g' "$real" > "$k" 2>/dev/null || return 0
  echo "  <include ignore_missing=\"yes\">$k</include>"
  incf="$dir/conf/.inc-$n"
  tr '\n\t' '  ' < "$real" | grep -o '<include[^>]*>[^<]*</include>' > "$incf" 2>/dev/null || return 0
  while IFS= read -r inc; do
    attrs=${inc%%>*}; body=${inc#*>}; body=${body%%</include>*}
    body=$(printf '%s' "$body" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
    [ -n "$body" ] || continue
    case "$attrs" in
      *'prefix="xdg"'*) path="${XDG_CONFIG_HOME:-$HOME/.config}/$body" ;;
      *) case "$body" in
           /*) path=$body ;;
           '~/'*) path="$HOME/${body#??}" ;;
           *) if [ -e "${real%/*}/$body" ]; then path="${real%/*}/$body"; else path="$etc/$body"; fi ;;
         esac ;;
    esac
    fc_take "$path"
  done < "$incf"
}
fonts_setup() {
  [ -z "${HEARTH_OVERLAY_SYSTEM_FONTS:-}" ] || { note "fonts: the system's fontconfig setup (HEARTH_OVERLAY_SYSTEM_FONTS)"; return 0; }
  [ -z "${FONTCONFIG_FILE:-}" ] || { note "fonts: FONTCONFIG_FILE=$FONTCONFIG_FILE is already set"; return 0; }
  etc="${HEARTH_FONTS_ETC:-/etc/fonts}"
  [ -f "$etc/fonts.conf" ] || { note "fonts: no $etc/fonts.conf; Chromium's defaults"; return 0; }
  dir="${XDG_RUNTIME_DIR:-/tmp}/hearth-overlay-fonts"
  [ -n "${XDG_RUNTIME_DIR:-}" ] || dir="/tmp/hearth-overlay-fonts-$uid"
  mkdir -p "$dir" 2>/dev/null || { note "fonts: can't make $dir; the system's setup"; return 0; }
  fontdirs="${HEARTH_FONT_DIRS:-/usr/share/fonts /usr/local/share/fonts}"
  # shellcheck disable=SC2086
  key=$(find $fontdirs -type f -printf '%p %s\n' 2>/dev/null | sort | cksum | cut -d' ' -f1)
  croot="${XDG_CACHE_HOME:-$HOME/.cache}/hearth-overlay"
  cache="$croot/fontconfig-$key"
  if mkdir -p "$cache" 2>/dev/null; then
    for old in "$croot"/fontconfig-*; do [ "$old" = "$cache" ] || rm -rf "$old" 2>/dev/null; done
  else
    cache="$dir/cache"
  fi
  # fontconfig 2.17's new syntax: xsi:nil, and the generic families (or nothing) as constants.
  newsyntax='xsi:nil|<const>[[:space:]]*(sans-serif|serif|monospace|emoji|math|system-ui|cursive|fantasy|fangsong|ui-[a-z-]+)?[[:space:]]*</const>'
  left=""; n=0; seen=""
  rm -rf "$dir/conf" 2>/dev/null; mkdir -p "$dir/conf" 2>/dev/null || { note "fonts: can't make $dir/conf; the system's setup"; return 0; }
  {
    echo '<?xml version="1.0"?>'
    echo '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">'
    echo "<!-- Made by hearth-overlay for Quick Access over games (Chromium's own fontconfig); remade each start. -->"
    echo '<fontconfig>'
    grep -o '<dir[^>]*>[^<]*</dir>' "$etc/fonts.conf"
    echo '  <dir>/usr/share/fonts</dir>'
    echo '  <dir prefix="xdg">fonts</dir>'
    echo "  <cachedir>$cache</cachedir>"
    for f in "$etc"/conf.d/*.conf; do
      [ -e "$f" ] && fc_take "$f"
    done
    cat <<'XML'
  <!-- What 49-sansserif.conf did before fontconfig 2.17: a font asked for by name gets sans-serif behind it. -->
  <match target="pattern">
    <test qual="all" name="family" compare="not_eq"><string>sans-serif</string></test>
    <test qual="all" name="family" compare="not_eq"><string>serif</string></test>
    <test qual="all" name="family" compare="not_eq"><string>monospace</string></test>
    <edit name="family" mode="append_last"><string>sans-serif</string></edit>
  </match>
  <alias><family>Sans</family><prefer><family>sans-serif</family></prefer></alias>
  <alias><family>system-ui</family><prefer><family>sans-serif</family></prefer></alias>
  <alias><family>sans-serif</family><prefer><family>Noto Sans</family><family>Adwaita Sans</family><family>Cantarell</family><family>DejaVu Sans</family><family>Liberation Sans</family></prefer></alias>
  <alias><family>serif</family><prefer><family>Noto Serif</family><family>DejaVu Serif</family><family>Liberation Serif</family></prefer></alias>
  <alias><family>monospace</family><prefer><family>Noto Sans Mono</family><family>Adwaita Mono</family><family>DejaVu Sans Mono</family><family>Liberation Mono</family></prefer></alias>
  <alias><family>emoji</family><prefer><family>Noto Color Emoji</family></prefer></alias>
</fontconfig>
XML
  } > "$dir/fonts.conf.new" 2>/dev/null && mv -f "$dir/fonts.conf.new" "$dir/fonts.conf" || { note "fonts: couldn't write $dir/fonts.conf; the system's setup"; return 0; }
  FONTCONFIG_FILE="$dir/fonts.conf"
  export FONTCONFIG_FILE
  note "fonts: Hearth's setup for Chromium's fontconfig ($FONTCONFIG_FILE: $n of the system's fontconfig files, copied to $dir/conf; cache $cache)${left:+; left out (fontconfig 2.17 only):$left}"
}
fonts_setup
note "LANG=${LANG:-unset}; system fontconfig: $(fc-match sans-serif 2>/dev/null | head -1 || echo 'fc-match missing'), $(fc-list 2>/dev/null | wc -l) fonts"

exec "$APP" --hhd-overlay "$@"
