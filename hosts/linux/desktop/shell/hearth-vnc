def peer_name(ip):
    if not shutil.which('tailscale'):
        return ''
    code, so, _e = run(['tailscale', 'whois', '--json', ip], 4)
    if code != 0:
        return ''
    try:
        n = json.loads(so).get('Node') or {}
        return (n.get('ComputedName') or n.get('Name') or '').split('.')[0]
    except Exception:
        return ''


class Client:
    def __init__(self, server, sock, ip, via):
        self.srv = server
        self.sock = sock
        self.ip = ip
        self.via = via
        self.name = ''
        self.id = 0
        self.since = int(time.time())
        self.authed = False
        self.view_only = True
        self.pf = PixelFormat()
        self.encodings = [ENC_RAW]
        self.send_lock = threading.Lock()
        self.want = threading.Condition()
        self.request = None             # (incremental, x, y, w, h) waiting for an answer
        self.closed = False
        self.sent = None                # the frame this viewer has now
        self.sent_size = None
        self.mask = 0
        self.z = zlib.compressobj(1)

    def close(self):
        if self.closed:
            return
        self.closed = True
        with self.want:
            self.want.notify_all()
        try:
            self.sock.shutdown(socket.SHUT_RDWR)
        except OSError:
            pass
        try:
            self.sock.close()
        except OSError:
            pass

    def send(self, data):
        with self.send_lock:
            self.sock.sendall(data)

    def refuse(self, reason):
        self.send(p32(1) + p32(len(reason)) + reason.encode())
        raise ConnectionError(reason)

    def serve(self):
        s = self.sock
        s.settimeout(30)
        s.sendall(b'RFB 003.008\n')
        ver = recv_exact(s, 12)
        if not ver.startswith(b'RFB 003.'):
            raise ConnectionError('not VNC')
        minor = int(ver[8:11] or b'0')
        if minor < 7:
            # RFB 3.3 can't do VeNCrypt: a reason and goodbye
            msg = b'This PC needs a VNC app with VeNCrypt (TLS), like TigerVNC or Remmina'
            s.sendall(p32(0) + p32(len(msg)) + msg)
            raise ConnectionError('old viewer')
        if self.srv.locked_out(self.ip):
            msg = b'Too many wrong passwords from this address: try again in a few minutes'
            s.sendall(p8(0) + p32(len(msg)) + msg)
            raise ConnectionError('locked out')
        s.sendall(p8(1) + p8(SEC_VENCRYPT))
        if recv_exact(s, 1)[0] != SEC_VENCRYPT:
            raise ConnectionError('no VeNCrypt')
        # VeNCrypt 0.2
        s.sendall(b'\x00\x02')
        if recv_exact(s, 2) != b'\x00\x02':
            s.sendall(b'\x01')
            raise ConnectionError('VeNCrypt version')
        s.sendall(b'\x00')
        subs = [VENC_X509PLAIN] if self.srv.ctx_x509 else []
        if self.via in ('tailscale', 'local'):
            subs.append(VENC_TLSPLAIN)       # anonymous TLS only inside Tailscale's own tunnel (or this PC)
        if not subs:
            raise ConnectionError('no certificate')
        s.sendall(p8(len(subs)) + b''.join(p32(x) for x in subs))
        pick = struct.unpack('!I', recv_exact(s, 4))[0]
        if pick not in subs:
            s.sendall(b'\x00')
            raise ConnectionError('subtype')
        s.sendall(b'\x01')
        ctx = self.srv.ctx_x509 if pick == VENC_X509PLAIN else self.srv.ctx_anon
        self.sock = s = ctx.wrap_socket(s, server_side=True)
        ulen, plen = struct.unpack('!II', recv_exact(s, 8))
        if ulen > 1024 or plen > 1024:
            raise ConnectionError('too long')
        recv_exact(s, ulen)                  # the user name: any (the password is what counts)
        given = recv_exact(s, plen)
        want, why = self.srv.password()
        if not want:
            self.refuse('Remote desktop has no password yet: set one in Settings on this PC' if not why else
                        'This PC can\'t check passwords right now (%s)' % why)
        if not hmac_eq(given, want.encode()):
            n = self.srv.failed(self.ip)
            pause(min(3, n))
            self.refuse('Wrong password')
        self.srv.fails.pop(self.ip, None)
        s.sendall(p32(0))
        recv_exact(s, 1)                     # ClientInit's shared flag: everyone shares
        cap = self.srv.ensure_capture()
        frame, serial = cap.wait(-1, 5)
        w, h = cap.size
        name = ('Hearth · ' + (socket.gethostname() or 'PC')).encode()
        s.sendall(p16(w) + p16(h) + SERVER_PF + p32(len(name)) + name)
        s.settimeout(None)
        with self.srv.lock:
            self.id = self.srv.next_id
            self.srv.next_id += 1
            self.authed = True
            self.view_only = bool(self.srv.settings.get('viewOnly')) or self.srv.input == 'none'
            self.srv.clients[self.id] = self
            self.srv.publish()
        threading.Thread(target=self._name, daemon=True).start()
        threading.Thread(target=self.writer, args=(cap,), daemon=True, name='writer').start()
        self.reader(cap)

    def _name(self):
        if self.via == 'tailscale':
            self.name = peer_name(self.ip)
        notify('Someone is using this PC', '%s is connected to this PC with remote desktop%s' % (
            self.name or self.ip, ' (view only)' if self.view_only else ''))
        with self.srv.lock:
            self.srv.publish()

    def reader(self, cap):
        s = self.sock
        while not self.closed:
            t = recv_exact(s, 1)[0]
            if t == 0:                                   # SetPixelFormat
                raw = recv_exact(s, 19)[3:]
                pf = PixelFormat(raw)
                if pf.true:
                    self.pf = pf
                    self.sent = None
            elif t == 2:                                 # SetEncodings
                n = struct.unpack('!xH', recv_exact(s, 3))[0]
                self.encodings = list(struct.unpack('!%di' % n, recv_exact(s, 4 * n)))
                self.z = zlib.compressobj(1)
            elif t == 3:                                 # FramebufferUpdateRequest
                inc, x, y, w, h = struct.unpack('!BHHHH', recv_exact(s, 9))
                with self.want:
                    if self.request is None or not inc:
                        self.request = (inc, x, y, w, h)
                    self.want.notify_all()
            elif t == 4:                                 # KeyEvent
                down, key = struct.unpack('!B2xI', recv_exact(s, 7))
                if not self.view_only:
                    self.key(key, down)
            elif t == 5:                                 # PointerEvent
                mask, x, y = struct.unpack('!BHH', recv_exact(s, 5))
                if not self.view_only:
                    self.pointer(self.srv.capture or cap, mask, x, y)
            elif t == 6:                                 # ClientCutText (the clipboard isn't shared)
                n = struct.unpack('!3xI', recv_exact(s, 7))[0]
                if n > 1 << 20:
                    raise ConnectionError('clipboard too big')
                recv_exact(s, n)
            else:
                raise ConnectionError('unknown message %d' % t)

    def key(self, keysym, down):
        b = self.srv.backend
        if self.srv.input == 'portal' and self.srv.sess:
            self.srv.sess.key(keysym, down)
        elif b:
            b.key(keysym, down)

    def pointer(self, cap, mask, x, y):
        sess, b = self.srv.sess, self.srv.backend
        if self.srv.input == 'portal' and sess:
            fw, fh = cap.size
            sw, sh = sess.size()
            if sw and sh and fw and fh:
                sess.pointer_abs(x * sw / fw, y * sh / fh)
            else:
                sess.pointer_abs(x, y)
            press = sess.button
            wheel = sess.scroll
        elif b:
            b.pointer(x, y)
            press = b.button
            wheel = b.scroll
        else:
            return
        changed = mask ^ self.mask
        for bit, code in ((1, BTN_LEFT), (2, BTN_MIDDLE), (4, BTN_RIGHT)):
            if changed & bit:
                press(code, bool(mask & bit))
        for bit, axis, steps in ((8, 0, -1), (16, 0, 1), (32, 1, -1), (64, 1, 1)):
            if mask & bit and not self.mask & bit:
                wheel(axis, steps)
        self.mask = mask

    def writer(self, cap):
        serial = -1
        try:
            while not self.closed:
                with self.want:
                    while self.request is None and not self.closed:
                        self.want.wait(1)
                    if self.closed:
                        return
                    req = self.request
                inc = req[0]
                frame, new_serial = cap.wait(serial if inc else -2, 1.0)
                if frame is None or (cap.stopped and not getattr(cap, 'fake', False)):
                    if getattr(cap, 'restart_wanted', False) or cap.stopped:
                        try:
                            cap = self.srv.ensure_capture()
                        except Exception:
                            self.close()
                            return
                    continue
                w, h = cap.size
                rects = []
                if self.sent_size != (w, h):
                    if self.sent_size is not None:
                        if ENC_DESKTOPSIZE not in self.encodings:
                            self.close()           # this viewer can't follow a new resolution: it connects again
                            return
                        rects.append(p16(0) + p16(0) + p16(w) + p16(h) + struct.pack('!i', ENC_DESKTOPSIZE))
                    self.sent = None
                    self.sent_size = (w, h)
                if inc and self.sent is not None and new_serial == serial:
                    continue
                tiles = dirty_tiles(self.sent if inc else None, frame, w, h, req[1:])
                serial = new_serial
                if not tiles and not rects:
                    self.sent = frame
                    continue
                with self.want:
                    self.request = None
                use_zrle = ENC_ZRLE in self.encodings
                body = []
                for (x, y, rw, rh) in runs(tiles):
                    if use_zrle:
                        body.append(p16(x) + p16(y) + p16(rw) + p16(rh) + struct.pack('!i', ENC_ZRLE) +
                                    zrle_rect(self.z, self.pf, frame, w, x, y, rw, rh))
                    else:
                        body.append(p16(x) + p16(y) + p16(rw) + p16(rh) + struct.pack('!i', ENC_RAW) +
                                    bytes(self.pf.convert(region(frame, w, x, y, rw, rh))))
                allr = rects + body
                self.send(p8(0) + b'\x00' + p16(len(allr)) + b''.join(allr))
                self.sent = frame
        except (OSError, ssl.SSLError, ConnectionError):
            self.close()


def pause(seconds):
    time.sleep(seconds)


def hmac_eq(a, b):
    import hmac
    return hmac.compare_digest(a, b)


def cmd_serve():
    s = load()
    if not s.get('on'):
        return fail("remote desktop is off (Settings › Remote desktop)")
    ensure_cert()
    srv = Server()
    try:
        srv.listen()
    except OSError as e:
        return fail("couldn't listen on port %d (%s): is another VNC server running?" % (PORT, e.strerror or e))
    import signal

    def bye(*_a):
        srv.stopping = True
        srv.kick('all')
        try:
            srv.sock.close()
        except OSError:
            pass
        try:
            os.unlink(CLIENTS)
        except OSError:
            pass
        os._exit(0)
    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGINT, bye)
    srv.publish()
    threading.Thread(target=srv.control_server, daemon=True, name='control').start()
    srv.accept_forever()
    return 0


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print(__doc__)
        return 0
    c = argv[0]
    try:
        if c == 'status':
            return cmd_status()
        if c == 'set' and len(argv) == 3:
            return cmd_set(argv[1], argv[2])
        if c == 'password':
            return cmd_password()
        if c == 'forget-password':
            return cmd_forget()
        if c == 'disconnect' and len(argv) == 2:
            return cmd_disconnect(argv[1])
        if c == 'session':
            return cmd_session()
        if c == 'serve':
            return cmd_serve()
    except Exception as e:
        return fail(str(e) or e.__class__.__name__)
    return fail('unknown command (see hearth-vnc --help)')


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
