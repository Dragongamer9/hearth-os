def opened(page):
    """One more opening of PAGE (Home's "You use these most"): a state file, not a setting; hearth_settings_io's
    atomic write under its lock. Only page ids (letters, digits, dashes)."""
    if not re.fullmatch(r'[a-z0-9-]{1,40}', page or ''):
        return {'ok': False, 'error': 'not a page'}
    sys.path.insert(0, str(HERE))
    try:
        import hearth_settings_io as sio
        os.makedirs(opens_path().parent, exist_ok=True)

        def bump(d):
            pages = d.get('pages') if isinstance(d.get('pages'), dict) else {}
            pages[page] = int(pages.get(page, 0) or 0) + 1
            # Kept small: the 60 most opened.
            if len(pages) > 60:
                pages = dict(sorted(pages.items(), key=lambda x: -x[1])[:60])
            d['pages'] = pages
        sio.update_json(str(opens_path()), bump)
        return {'ok': True}
    except Exception as e:
        return {'ok': False, 'error': str(e)[:200]}


