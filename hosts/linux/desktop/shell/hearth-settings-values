    j = helper('hearth-notify', 'get')
    sc = session_conf()
    dnd = sc.get('HEARTH_DND', '')
    put(notifications='do not disturb' if dnd == '1' else 'on')
    try:
        st = json.loads((HOME / '.config/nimbus/power.json').read_text())
        m = st.get('screenOff')
        if m:
            put(power='off after %s min' % m)
    except Exception:
        pass


def r_devices():
    if has('setxkbmap') or True:
        lay = os.environ.get('XKB_DEFAULT_LAYOUT', '')
        if not lay:
            try:
                for l in Path('/etc/default/keyboard').read_text().splitlines():
                    if l.startswith('XKBLAYOUT='):
                        lay = l.split('=', 1)[1].strip('"')
            except OSError:
                pass
        put(kbd_layout=lay.upper()[:12])
    if has('lpstat'):
        rc, o, _ = run(['lpstat', '-p'])
        n = len([l for l in o.splitlines() if l.startswith('printer ')])
        names = [l.split()[1] for l in o.splitlines() if l.startswith('printer ')]
        if n:
            put(printers='%d ready' % n, printer=' + '.join(names[:2])[:30])
    j = helper('hearth-thunderbolt', 'status')
    if isinstance(j, dict):
        put(thunderbolt='%d' % len(j.get('devices') or []) if j.get('devices') else ('none' if j.get('available') else 'not on this PC'))
    if has('kdeconnect-cli'):
        rc, o, _ = run(['kdeconnect-cli', '-a', '--name-only'])
        if o.strip():
            put(phone=o.splitlines()[0][:20], phone_line='linked')
    tablets = [d for d in Path('/dev/input/by-id').glob('*') if re.search(r'wacom|tablet|pen', d.name, re.I)] if Path('/dev/input/by-id').exists() else []
    put(tablet='%d' % len(tablets) if tablets else 'none')
    put(g15='connected' if any('G15' in d.name for d in Path('/dev/input/by-id').glob('*')) else 'not plugged in') if Path('/dev/input/by-id').exists() else None
    put(usb='ask')


