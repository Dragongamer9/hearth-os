def r_privacy_more():
    j = helper('hearth-vaults', 'list')
    if isinstance(j, dict):
        vs = j.get('vaults') or []
        locked = [v for v in vs if not v.get('open')]
        put(vaults=str(len(vs)), vaults_locked='%d locked' % len(locked) if locked else ('none' if not vs else 'all open'), vault_names=', '.join(v.get('name', '') for v in locked[:2]))
    put(keyring='unlocked' if os.environ.get('GNOME_KEYRING_CONTROL') or Path('/run/user/%d/keyring' % os.getuid()).exists() else 'locked')
    rec = HOME / '.local/share/recently-used.xbel'
    put(recent='on' if rec.exists() else 'off')
    if has('fwupdmgr'):
        rc, o, _ = run(['fwupdmgr', 'get-updates', '--json'], 6)
        try:
            n = sum(len(d.get('Releases') or []) for d in json.loads(o).get('Devices') or [])
            put(firmware='%d update%s' % (n, '' if n == 1 else 's') if n else 'up to date')
        except Exception:
            pass


def r_updates():
