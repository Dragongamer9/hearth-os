    j = helper('hearth-vnc', 'status')
    if isinstance(j, dict):
        put(vnc='on' if j.get('on') else 'off')
    j = helper('hearth-search', 'status')
    if isinstance(j, dict):
        put(search='paused' if j.get('paused') else ('indexing done' if j.get('files') else 'on'))
    clip = HOME / '.local/share/nimbus/clipboard.json'
