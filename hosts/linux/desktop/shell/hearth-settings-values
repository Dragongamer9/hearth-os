def read(section):
    if has('systemsettings') or has('kwin_wayland'):
        put(kde='yes')
    # The live USB (Install Hearth shows only there): the same signs Settings › System uses.
    try:
        cmd = Path('/proc/cmdline').read_text()
    except OSError:
        cmd = ''
    if Path('/run/hearth-live').exists() or Path('/etc/hearth-live').exists() or 'rd.live.image' in cmd or 'boot=live' in cmd:
        put(live='yes')
    ts = [threading.Thread(target=f, daemon=True) for f in READERS.get(section, [])]
    for t in ts:
        t.start()
    for t in ts:
        t.join(9)
    with LOCK:
        return dict(OUT)


SWITCHES = {
    'wifi': lambda on: ['nmcli', 'radio', 'wifi', 'on' if on else 'off'],
    'bt': lambda on: ['bluetoothctl', 'power', 'on' if on else 'off'],
}


def set_switch(key, on):
    if key in SWITCHES:
        rc, o, e = run(SWITCHES[key](on), 10)
        return {'ok': rc == 0, 'error': '' if rc == 0 else (e or o).strip()[:200]}
    if key == 'zoom':
        r = helper('hearth-access', 'magnifier', 'in' if on else 'off', timeout=6)
        return {'ok': r is not None, 'error': '' if r is not None else 'The magnifier didn\'t start.'}
    if key == 'reduce_motion':
        sys.path.insert(0, str(HERE))
        try:
            import hearth_settings_io as sio
            sio.merge_json(str(HOME / '.local/share/nimbus/desktop.json'), {'reduceMotion': on}, who='you')
            return {'ok': True, 'error': ''}
        except Exception as e:
            return {'ok': False, 'error': str(e)[:200]}
    if key in ('metered', 'private_net'):
        rc, o, _ = run(['nmcli', '-t', '-f', 'NAME,DEVICE', 'connection', 'show', '--active'])
        name = next((l.split(':')[0] for l in o.splitlines() if l and not l.endswith(':lo')), '')
        if not name:
            return {'ok': False, 'error': 'Not connected.'}
        if key == 'metered':
            cmd = ['nmcli', 'connection', 'modify', name, 'connection.metered', 'yes' if on else 'no']
        else:
            cmd = ['nmcli', 'connection', 'modify', name, 'connection.zone', 'home' if on else 'public']
        rc, o, e = run(cmd, 10)
        return {'ok': rc == 0, 'error': '' if rc == 0 else (e or o).strip()[:200]}
    if key == 'player_count':
        sys.path.insert(0, str(HERE))
        try:
            import hearth_settings_io as sio
            sio.merge_json(str(HOME / '.local/share/nimbus/desktop.json'), {'countMe': on}, who='you')
            return {'ok': True, 'error': ''}
        except Exception as e:
            return {'ok': False, 'error': str(e)[:200]}
    if key in ('test_versions', 'parts_auto'):
        # The Hearth Store's own settings file (prefs.rs reads the same keys), merged: only that key changes.
        sys.path.insert(0, str(HERE))
        try:
            import hearth_settings_io as sio
            path = store_prefs_path()
            if path.exists():
                try:
                    if not isinstance(json.loads(path.read_text()), dict):
                        raise ValueError
                except Exception:
                    return {'ok': False, 'error': 'The Store\'s settings file couldn\'t be read, so nothing was written over it.'}
            os.makedirs(path.parent, exist_ok=True)
            sio.merge_json(str(path), {'testVersions' if key == 'test_versions' else 'autoInstall': on}, who='you')
            return {'ok': True, 'error': ''}
        except Exception as e:
            return {'ok': False, 'error': str(e)[:200]}
    if key == 'os_auto':
        rc, o, e = run(['pkexec', '/usr/libexec/nimbus/hearth-admin', 'auto-update', 'on' if on else 'off'], 30)
        return {'ok': rc == 0, 'error': '' if rc == 0 else (e or o).strip()[:200] or 'That didn\'t change.'}
    if key == 'link_clipboard':
        r = helper('hearth-link-settings', 'set', 'clipboard', 'on' if on else 'off', timeout=8)
        return {'ok': r is not None, 'error': '' if r is not None else 'Hearth Link didn\'t take it.'}
    if key.startswith('access.'):
        r = helper('hearth-access', 'set', json.dumps({key.split('.', 1)[1]: on}), timeout=10)
        return {'ok': r is not None, 'error': '' if r is not None else 'Accessibility didn\'t take the change.'}
    return {'ok': False, 'error': 'That switch isn\'t one Settings can change here.'}


def main(argv):
    if len(argv) == 3 and argv[1] == 'opened':
        print(json.dumps(opened(argv[2])))
        return 0
    if len(argv) >= 4 and argv[1] == 'set':
        print(json.dumps(set_switch(argv[2], argv[3] == 'on')))
        return 0
    section = argv[1] if len(argv) > 1 else 'home'
    print(json.dumps(read(section)))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
