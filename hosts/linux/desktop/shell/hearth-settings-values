def xdg(var, rest):
    v = os.environ.get(var)
    return Path(v) if v else HOME / rest


def store_prefs_path():
    """The Hearth Store's own settings (hosts/hearth-ui/apps/store prefs.rs): testVersions, autoInstall."""
    return xdg('XDG_CONFIG_HOME', '.config') / 'nimbus' / 'hearth-store.json'


def version_key(v):
    out = []
    for p in re.split(r'[.\-+]', str(v).lstrip('vV')):
        m = re.match(r'\d+', p)
        out.append(int(m.group(0)) if m else 0)
    return out


def newer(a, b):
    x, y = version_key(a), version_key(b)
    n = max(len(x), len(y))
    return x + [0] * (n - len(x)) > y + [0] * (n - len(y))


def r_parts():
    """Hearth parts with an update the Hearth Store has seen (its last look, ~/.cache/hearth/hearth-store/releases.json),
    next to the version it installed (~/.local/share/hearth/store/apps/<id>/store.json). Read only."""
    try:
        seen = json.loads((xdg('XDG_CACHE_HOME', '.cache') / 'hearth/hearth-store/releases.json').read_text()).get('apps') or {}
    except Exception:
        return
    names = {}
    try:
        for e in json.loads(Path(os.environ.get('HEARTH_STORE_CATALOG', '/usr/share/hearth/store/catalog.json')).read_text()).get('apps') or []:
            if isinstance(e, dict):
                names[e.get('id')] = e.get('name') or e.get('id')
    except Exception:
        pass
    ready = []
    apps = xdg('XDG_DATA_HOME', '.local/share') / 'hearth/store/apps'
    for app_id, rel in seen.items():
        try:
            have = json.loads((apps / app_id / 'store.json').read_text()).get('version', '')
        except Exception:
            continue
        v = (rel or {}).get('version', '') if isinstance(rel, dict) else ''
        if v and have and newer(v, have):
            ready.append('%s %s' % (names.get(app_id, app_id), v))
    put(parts_ready='%d ready' % len(ready) if ready else 'up to date', parts_list=ready)


def r_os_update():
    """Hearth OS's own update state (hearth-admin update-status: bootc's view; through pkexec, which Hearth's polkit
    rule lets the person at the PC use without a prompt). Left out when it can't be asked."""
    admin = '/usr/libexec/nimbus/hearth-admin'
    if not (Path(admin).exists() and has('pkexec')):
        return
    rc, o, _ = run(['pkexec', admin, 'update-status'], 8)
    try:
        j = json.loads(o) if rc == 0 else None
    except Exception:
        j = None
    if not isinstance(j, dict):
        return
    def ver(k):
        x = j.get(k)
        return (x.get('version') or 'a new version') if isinstance(x, dict) else ''
    staged, avail, back = ver('staged'), ver('available'), ver('rollback')
    if staged:
        put(os_state='restart to finish', os_ready=staged, os_staged='on')
    elif avail:
        put(os_state='%s ready' % avail, os_ready=avail)
    else:
        put(os_state='up to date')
    if back:
        put(os_previous=back)


