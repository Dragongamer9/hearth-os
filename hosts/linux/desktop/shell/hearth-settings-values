def r_games_size():
    """Games' size on this PC (Steam's own numbers in its appmanifests; nothing walks the drives)."""
    total = 0
    for lib in (HOME / '.local/share/Steam/steamapps', HOME / '.steam/steam/steamapps'):
        if not lib.exists():
            continue
        for m in lib.glob('appmanifest_*.acf'):
            try:
                x = re.search(r'"SizeOnDisk"\s+"(\d+)"', m.read_text(errors='replace'))
                total += int(x.group(1)) if x else 0
            except OSError:
                pass
        break
    if total:
        put(games_size='games ' + human(total))


