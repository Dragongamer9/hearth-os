def r_accounts():
    import pwd
    try:
        pw = pwd.getpwuid(os.getuid())
        real = pw.pw_gecos.split(',')[0] or pw.pw_name
        groups = subprocess.run(['id', '-nG'], capture_output=True, text=True).stdout.split()
        admin = 'sudo' in groups or 'wheel' in groups
        others = [p.pw_gecos.split(',')[0] or p.pw_name for p in pwd.getpwall() if 1000 <= p.pw_uid < 60000 and p.pw_uid != os.getuid()]
        j = helper('hearth-loginscreen', 'status')
        auto = isinstance(j, dict) and j.get('autologin')
        put(real=real, account_line='%s · %s · %s' % (pw.pw_name, 'administrator' if admin else 'standard account', 'signs in automatically' if auto else 'signs in with a password'),
            others=', '.join(others[:2]) if others else 'none', signin='automatic' if auto else 'password')
        if isinstance(j, dict) and j.get('background'):
            put(login_pic=Path(j['background']).stem.replace('-', ' ').title()[:20])
    except Exception:
        pass
    j = helper('hearth-fingerprint', 'status')
    if isinstance(j, dict):
        put(fingerprint=('%d set' % len(j.get('fingers') or [])) if j.get('fingers') else ('not set' if j.get('reader') else 'no reader'))
    accs = []
    goa = HOME / '.config/goa-1.0/accounts.conf'
    try:
        cur = None
        for l in goa.read_text().splitlines():
            if l.startswith('[Account '):
                cur = {}
                accs.append(cur)
            elif cur is not None and '=' in l:
                k, v = l.split('=', 1)
                if k == 'Provider':
                    cur['name'] = v.capitalize()
                elif k == 'Identity':
                    cur['line'] = v
    except OSError:
        pass
    put(online=[a for a in accs if a.get('name')][:4])


