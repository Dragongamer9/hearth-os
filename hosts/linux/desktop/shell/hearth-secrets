#!/usr/bin/python3
"""hearth-secrets: Settings › Passwords (like KDE Wallet Manager) on top of the system's password store, the
freedesktop Secret Service (org.freedesktop.secrets): GNOME Keyring on Hearth OS (gnome-keyring + libpam-gnome-keyring
in the image; nimbus-session starts it in every session, Mantel on KWin too). Apps that keep sign-ins there (browsers,
Discord, Xodus Nexus, network shares) use it directly; this only shows what's kept and lets you remove it.

It never reads a password: only each saved item's name, the app it belongs to, and when it was saved (the Secret
Service's Label, Attributes, Created and Modified). Nothing is written to a file or a log. Removing, locking,
unlocking and protecting go through the Secret Service itself, which asks with its own window when it must.

  hearth-secrets status            JSON: the provider, whether it's running, its keyrings (locked, protected with a
                                   password or not, how many items), the default one, a prompter for passwords
  hearth-secrets list              JSON: [{id, label, app, account, where, keyring, created, modified}] (no secrets)
  hearth-secrets remove ITEM_ID    remove one saved item (the store may ask first)
  hearth-secrets lock [KEYRING]    lock a keyring (all of them without one)
  hearth-secrets unlock [KEYRING]  unlock it (its own window asks for the password)
  hearth-secrets protect [KEYRING] give a keyring a password (GNOME Keyring's window asks for the new one); an
                                   unprotected keyring's items are kept unencrypted on the drive
Failures print "error: ..." and exit 1. Uses busctl (systemd) for D-Bus; HEARTH_BUSCTL overrides it (tests).
"""
import json
import os
import re
import shutil
import subprocess
import sys

SVC = 'org.freedesktop.secrets'
ROOT = '/org/freedesktop/secrets'
S = 'org.freedesktop.Secret.'
HOME = os.path.expanduser('~')
DATA = os.environ.get('XDG_DATA_HOME') or os.path.join(HOME, '.local', 'share')
KEYRINGS = os.path.join(DATA, 'keyrings')
PATH_RE = re.compile(r'^/org/freedesktop/secrets/(collection|aliases)/[A-Za-z0-9_]+(/[A-Za-z0-9_]+)?$')


class Fail(Exception):
    pass


def busctl(*args, timeout=10):
    exe = os.environ.get('HEARTH_BUSCTL') or shutil.which('busctl')
    if not exe:
        raise Fail("busctl isn't installed")
    try:
        r = subprocess.run([exe, '--user', '--json=short'] + list(args), capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise Fail("The password store didn't answer")
    except OSError as e:
        raise Fail(str(e))
    if r.returncode != 0:
        msg = (r.stderr or '').strip().splitlines()
        raise Fail(msg[-1] if msg else 'The password store said no')
    try:
        return json.loads(r.stdout) if r.stdout.strip() else None
    except ValueError:
        raise Fail("The password store's answer couldn't be read")


def prop(path, iface, name):
    r = busctl('get-property', SVC, path, iface, name)
    return r.get('data') if isinstance(r, dict) else None


def call(path, iface, method, sig='', *args):
    r = busctl('call', SVC, path, iface, method, *([sig] + [str(a) for a in args] if sig else []))
    return r.get('data') if isinstance(r, dict) else None


def check_path(p, kind='item'):
    if not isinstance(p, str) or not PATH_RE.match(p):
        raise Fail('That is not one of the password store\'s ' + kind + 's')
    if kind == 'item' and p.count('/') < 6:
        raise Fail('That is a keyring, not a saved item')
    return p


def provider():
    """(name, running): who owns org.freedesktop.secrets on the session bus."""
    try:
        pid = busctl('call', 'org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus',
                     'GetConnectionUnixProcessID', 's', SVC)
        pid = pid['data'][0]
    except (Fail, KeyError, TypeError, IndexError):
        return None, False
    try:
        with open('/proc/%d/comm' % int(pid)) as f:
            comm = f.read().strip()
    except (OSError, ValueError):
        comm = ''
    names = {'gnome-keyring-d': 'GNOME Keyring', 'gnome-keyring-daemon': 'GNOME Keyring', 'kwalletd6': 'KDE Wallet',
             'kwalletd5': 'KDE Wallet', 'ksecretd': 'KDE Wallet', 'keepassxc': 'KeePassXC', 'oo7-daemon': 'oo7'}
    return names.get(comm, comm or 'Another app'), True


def keyring_file(coll_path):
    """GNOME Keyring's file for a keyring, and whether a password protects it (an encrypted file starts with
    'GnomeKeyring\\n\\r\\0\\n'; an unprotected one is plain text '[keyring]')."""
    name = coll_path.rsplit('/', 1)[-1]
    for f in (name + '.keyring', name.replace('_', ' ') + '.keyring'):
        p = os.path.join(KEYRINGS, f)
        try:
            with open(p, 'rb') as fh:
                head = fh.read(16)
            return p, head.startswith(b'GnomeKeyring')
        except OSError:
            continue
    return None, None


def prompter():
    for p in ('gcr4-prompter', 'gcr-prompter'):
        for d in ('/usr/libexec', '/usr/lib/gcr', '/usr/lib/x86_64-linux-gnu', '/usr/lib/aarch64-linux-gnu'):
            if os.path.exists(os.path.join(d, p)):
                return True
        if shutil.which(p):
            return True
    return False


def collections():
    out = []
    default = ''
    try:
        d = call(ROOT, S + 'Service', 'ReadAlias', 's', 'default')
        default = d[0] if d and d[0] != '/' else ''
    except Fail:
        pass
    for c in prop(ROOT, S + 'Service', 'Collections') or []:
        if not PATH_RE.match(c):
            continue
        label = prop(c, S + 'Collection', 'Label') or c.rsplit('/', 1)[-1]
        locked = bool(prop(c, S + 'Collection', 'Locked'))
        items = prop(c, S + 'Collection', 'Items') or []
        f, protected = keyring_file(c)
        out.append({'id': c, 'label': label, 'locked': locked, 'count': len(items), 'default': c == default,
                    'protected': protected, 'session': c.endswith('/session')})
    return out, default


def status():
    who, running = provider()
    res = {'provider': who, 'running': running, 'keyrings': [], 'default': '', 'prompter': prompter(),
           'pam': pam_lines()}
    if running:
        try:
            res['keyrings'], res['default'] = collections()
        except Fail as e:
            res['error'] = str(e)
    return res


def pam_lines(path='/etc/pam.d/sddm'):
    """Whether signing in at the login screen unlocks GNOME Keyring (pam_gnome_keyring in the login screen's PAM)."""
    try:
        with open(path) as f:
            t = f.read()
    except OSError:
        return {'auth': False, 'session': False}
    lines = [l.strip() for l in t.splitlines() if not l.strip().startswith('#')]
    return {'auth': any(re.match(r'-?auth\s+\S+\s+pam_gnome_keyring\.so', l) for l in lines),
            'session': any(re.match(r'-?session\s+\S+\s+pam_gnome_keyring\.so', l) for l in lines)}


# Which app an item belongs to, from the attributes apps set (libsecret's xdg:schema, Chromium's, Firefox's, etc).
def describe(attrs, label):
    a = attrs or {}
    schema = a.get('xdg:schema', '')
    app = a.get('application') or a.get('app_id') or ''
    if not app and schema:
        app = {'chrome_libsecret_os_crypt_password_v2': 'Chromium-based browser', 'org.gnome.keyring.NetworkPassword': 'Network share',
               'org.freedesktop.Secret.Generic': '', 'org.gnome.keyring.Note': 'Note'}.get(schema, schema.split('.')[-1] if '.' in schema else schema)
    if not app:
        app = a.get('service') or ''
    account = a.get('username') or a.get('user') or a.get('account') or a.get('login') or ''
    where = a.get('server') or a.get('domain') or a.get('origin_url') or a.get('signon_realm') or a.get('url') or ''
    return {'app': app or (label.split(':')[0] if ':' in label else 'App'), 'account': account, 'where': where}


def items():
    out = []
    cols, _ = collections()
    for c in cols:
        if c['locked']:
            continue
        for it in prop(c['id'], S + 'Collection', 'Items') or []:
            if not PATH_RE.match(it):
                continue
            try:
                label = prop(it, S + 'Item', 'Label') or ''
                attrs = prop(it, S + 'Item', 'Attributes') or {}
                created = prop(it, S + 'Item', 'Created') or 0
                modified = prop(it, S + 'Item', 'Modified') or 0
            except Fail:
                continue
            d = {'id': it, 'label': label, 'keyring': c['label'], 'created': int(created) * 1000, 'modified': int(modified) * 1000}
            d.update(describe(attrs, label))
            out.append(d)
    out.sort(key=lambda x: (x['app'].lower(), x['label'].lower()))
    return {'items': out, 'lockedKeyrings': [c['label'] for c in cols if c['locked']]}


def prompt_if_needed(path, done_msg):
    """A prompt path from the store ('/' means done): show it (the store's own window) and say so."""
    if path and path != '/':
        call(path, S + 'Prompt', 'Prompt', 's', '')
        return {'ok': True, 'prompted': True, 'message': 'Answer the password store\'s window to finish.'}
    return {'ok': True, 'prompted': False, 'message': done_msg}


def remove(item):
    check_path(item)
    r = call(item, S + 'Item', 'Delete')
    return prompt_if_needed(r[0] if r else '/', 'Removed.')


def targets(keyring):
    if keyring:
        return [check_path(keyring, 'keyring')]
    return [c for c in prop(ROOT, S + 'Service', 'Collections') or [] if PATH_RE.match(c)]


def lock(keyring=None):
    t = targets(keyring)
    r = call(ROOT, S + 'Service', 'Lock', 'ao', len(t), *t)
    return prompt_if_needed(r[1] if r and len(r) > 1 else '/', 'Locked.')


def unlock(keyring=None):
    t = targets(keyring)
    r = call(ROOT, S + 'Service', 'Unlock', 'ao', len(t), *t)
    return prompt_if_needed(r[1] if r and len(r) > 1 else '/', 'Unlocked.')


def protect(keyring=None):
    who, running = provider()
    if who != 'GNOME Keyring':
        raise Fail('Only GNOME Keyring can be given a password from here')
    if not prompter():
        raise Fail("GNOME Keyring's password window (gcr-prompter) isn't installed")
    t = targets(keyring)[:1] or ['/org/freedesktop/secrets/aliases/default']
    r = busctl('call', SVC, ROOT, 'org.gnome.keyring.InternalUnsupportedGuiltRiddenInterface',
               'ChangeWithPrompt', 'o', t[0])
    p = r.get('data', ['/'])[0] if isinstance(r, dict) else '/'
    return prompt_if_needed(p, 'Done.')


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    cmd, rest = argv[0], argv[1:]
    try:
        if cmd == 'status':
            out = status()
        elif cmd == 'list':
            out = items()
        elif cmd == 'remove' and len(rest) == 1:
            out = remove(rest[0])
        elif cmd == 'lock' and len(rest) <= 1:
            out = lock(rest[0] if rest else None)
        elif cmd == 'unlock' and len(rest) <= 1:
            out = unlock(rest[0] if rest else None)
        elif cmd == 'protect' and len(rest) <= 1:
            out = protect(rest[0] if rest else None)
        else:
            raise Fail('Unknown command')
    except Fail as e:
        print('error: ' + str(e))
        return 1
    print(json.dumps(out, ensure_ascii=False))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
