if HERE not in sys.path:
    sys.path.insert(0, HERE)
import hearth_settings_io as sio  # noqa: E402

STATE = '.briefcase.json'
VAULT = '.briefcase-vault'
VAULT_NEW = '.briefcase-vault.new'
STAGING = '.briefcase-unlocking'
REPLACED = '.briefcase-replaced'
BUSY = '.briefcase-busy'
TMP_MARK = '.briefcase-tmp-'
HASH_NOW = 64 * 1024 * 1024          # bigger files are hashed only when their time changed but not their size
CHUNK = 1024 * 1024
ICONS = ('briefcase', 'satchel', 'suitcase', 'backpack', 'box')
COLORS = ('accent', 'ember', 'red', 'green', 'blue', 'purple', 'gold', 'slate')
VIEWS = ('', 'large', 'grid', 'small', 'tiles', 'compact', 'details')
SORTS = ('', 'name', 'date', 'size', 'type', 'status')
AUTOLOCK_DEFAULT = {'minutes': 15, 'onSleep': True, 'onEject': True}
LOOK_DEFAULT = {'name': '', 'color': 'accent', 'icon': 'briefcase', 'badge': '', 'note': '', 'view': '', 'sort': '',
                'showInNav': True, 'autosync': {'mode': 'instant', 'minutes': 15}}
AUTOSYNC_MODES = ('instant', 'interval', 'onlock', 'off')
AUTO_KINDS = ('new-b', 'newer-b', 'new-o', 'newer-o')
