def autosync_one(bc, t=None, wait_settle=True):
    """One automatic sync of a Briefcase. Only one-sided changes and new files are copied; a file changed in both
    places or deleted on one side waits for you (and you're told once); an original that's away waits quietly; a
    locked Briefcase waits until it's unlocked. Replaced versions go to the Trash as with Update All."""
    t = t or now()
    res = {'synced': 0, 'needs': 0, 'away': 0, 'waiting': 0, 'locked': False}
    if bc.locked and not bc.unlocked:
        res['locked'] = True
        return res
    if bc.damaged:
        return res
    items = bc.items()
    inner, damaged = bc.items_state()
    if damaged:
        return res
    for name in sorted(items):
        ev = evaluate(bc, name, items[name], connect=False)
        if ev['status'] == 'away':
            res['away'] += 1
            continue
        if ev['status'] in ('orphan', 'gone'):
            continue
        rows = []
        for r in ev['rows']:
            if r['kind'] in ('same', 'gone'):
                rows.append(r)
            elif r['kind'] in AUTO_KINDS:
                changed = os.path.join(ev['path'] if r['kind'].endswith('-b') else ev['originPath'], r['rel']) \
                    if r['rel'] else (ev['path'] if r['kind'].endswith('-b') else ev['originPath'])
                if wait_settle and not settled(changed, t):
                    res['waiting'] += 1
                    continue
                rows.append(r)
            elif not r.get('quiet'):
                res['needs'] += 1
        if not rows:
            continue
        set_sync(bc.outer, syncing=True)
        rate = NET_RATE if ev.get('originKind') == 'share' else None
        out = apply(bc.outer, json.dumps({'rows': [{'id': r['id'], 'action': r['action'], 'bsig': r['bsig'],
                                                    'osig': r['osig'], 'size': r['size']} for r in rows]}),
                    rate=rate, connect=False)
        res['synced'] += len([d for d in out.get('done', [])])
        if out.get('done'):
            log('auto-sync “%s”: %d file(s) of %s' % (bc.name, len(out['done']), name))
    prev = sync_state().get(bc.outer) or {}
    kv = {'syncing': False, 'needs': res['needs'], 'away': res['away'], 'waiting': res['waiting'], 'checked': t}
    if res['synced'] or not (res['waiting'] or res['needs'] or res['away']):
        kv['last'] = t
    if res['needs'] and res['needs'] != prev.get('notified'):
        notify_needs(bc, res['needs'])
        kv['notified'] = res['needs']
    elif not res['needs']:
        kv['notified'] = 0
    set_sync(bc.outer, **kv)
    return res


def autosync_briefcases():
    out = []
    for b in list_known()['briefcases']:
        if b.get('missing'):
            continue
        if autosync_of(b.get('look'))['mode'] != 'off':
            with contextlib.suppress(Fail, OSError):
                out.append(open_bc(b['path'], recover_ok=False))
    return out


def autosync_needed():
    return bool(autosync_briefcases())


def game_running():
    """Pause auto-sync while a game runs (gamescope, or Hearth's hearth-playing file, as the home server uses)."""
    if os.path.exists(os.path.join(runtime_dir(), 'hearth-playing')):
        return True
    with contextlib.suppress(OSError):
        for pid in os.listdir('/proc'):
            if pid.isdigit():
                with contextlib.suppress(OSError):
                    with open('/proc/%s/comm' % pid) as f:
                        if f.read().strip() in ('gamescope', 'gamescope-wl'):
                            return True
    return False


def autosync_due(bc, t, st):
    """Should this Briefcase be checked now? Right away: when something changed (or every minute, for shared
    folders gvfs can't watch); Every N minutes: when N minutes passed; When I lock it / Off: never here."""
    a = autosync_of(bc.look)
    last = (st or {}).get('checked', 0)
    if a['mode'] == 'instant':
        return True
    if a['mode'] == 'interval':
        return t - last >= int(a.get('minutes') or 15) * 60
    return False


class Watcher:
    """inotify (through libc) on the Briefcases and their originals on this PC: a change wakes auto-sync at once.
    Without it (or for shared folders), auto-sync looks every minute."""
    MASK = 0x2 | 0x8 | 0x40 | 0x80 | 0x100 | 0x200

    def __init__(self):
        import ctypes
        self.ok = False
        self.wds = 0
        try:
            self.libc = ctypes.CDLL(None, use_errno=True)
            self.fd = self.libc.inotify_init1(os.O_NONBLOCK | 0o2000000)
            self.ok = self.fd >= 0
        except (OSError, AttributeError):
            self.ok = False

    def watch(self, roots):
        if not self.ok:
            return
        for r in roots:
            for dp, dns, _ in os.walk(r):
                dns[:] = [d for d in dns if not special(d)]
                if self.wds > 4000:
                    return
                if self.libc.inotify_add_watch(self.fd, dp.encode('utf-8', 'surrogateescape'), self.MASK) >= 0:
                    self.wds += 1

    def wait(self, timeout):
        import select
        if not self.ok:
            time.sleep(timeout)
            return False
        r, _, _ = select.select([self.fd], [], [], timeout)
        if not r:
            return False
        with contextlib.suppress(OSError):
            while os.read(self.fd, 65536):
                pass
        return True

    def close(self):
        if self.ok:
            os.close(self.fd)


def watch_roots(bcs):
    roots = []
    for bc in bcs:
        if not bc.content:
            continue
        roots.append(bc.content)
        for rec in bc.items().values():
            o = rec.get('origin') or {}
            if o.get('kind') == 'share' or rec.get('split'):
                continue
            p, _ = resolve(o)
            if p:
                roots.append(p if rec.get('type') == 'folder' else os.path.dirname(p))
    return [r for r in roots if os.path.isdir(r)]


def world_signature():
    """Drives plugged in and shared folders open: when this changes, originals that were away may be back."""
    g = []
    with contextlib.suppress(OSError):
        g = sorted(os.listdir(gvfs_root()))
    return json.dumps([sorted(drives()), g])


def autosync_daemon(max_loops=None):
    lf = os.open(os.path.join(our_runtime(), 'autosync.lock'), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return {'ok': True, 'running': True}
    log('auto-sync started')
    watcher, roots_key, world, loops, last_full = None, None, None, 0, 0
    try:
        while max_loops is None or loops < max_loops:
            loops += 1
            bcs = autosync_briefcases()
            if not bcs:
                log('auto-sync stopped: no Briefcase has auto-sync on')
                break
            if game_running():
                time.sleep(30)
                continue
            t = now()
            roots = watch_roots(bcs)
            key = json.dumps(sorted(roots))
            if key != roots_key:
                if watcher:
                    watcher.close()
                watcher = Watcher()
                watcher.watch(roots)
                roots_key = key
            w = world_signature()
            force = w != world or t - last_full >= 60
            world = w
            if force:
                last_full = t
            st = sync_state()
            pending = False
            for bc in bcs:
                s = st.get(bc.outer) or {}
                mode = autosync_of(bc.look)['mode']
                if mode == 'instant' and not (force or s.get('waiting') or s.get('dirty')):
                    continue
                if not autosync_due(bc, t, s):
                    continue
                try:
                    r = autosync_one(bc, t)
                    set_sync(bc.outer, dirty=False)
                    pending = pending or bool(r['waiting'])
                except (Fail, OSError) as ex:
                    log('auto-sync “%s” failed: %s' % (bc.name, ex))
                    set_sync(bc.outer, syncing=False, error=str(ex))
            changed = watcher.wait(SETTLE if pending else 20) if watcher else time.sleep(20)
            if changed:
                time.sleep(SETTLE)
                for bc in bcs:
                    if autosync_of(bc.look)['mode'] == 'instant':
                        set_sync(bc.outer, dirty=True)
    finally:
        if watcher:
            watcher.close()
        os.close(lf)
    return {'ok': True}


# ---------------------------------------------------------------------- main
def main(argv):
    a = argv[1:]
    if not a:
        print(__doc__)
        return 2
    c, rest = a[0], a[1:]
    flags = [x for x in rest if x.startswith('--')]
    args = [x for x in rest if not x.startswith('--')]
    if c == 'new' and 1 <= len(args) <= 2:
        out = new(args[0], args[1] if len(args) > 1 else None, '--ensure' in flags)
    elif c == 'list':
        out = list_known()
    elif c == 'status' and len(args) == 1:
        out = status(args[0])
    elif c == 'add' and len(args) >= 2:
        out = add(args[0], args[1:])
    elif c == 'plan' and args:
        out = plan(args[0], args[1:] or None)
    elif c == 'apply' and len(args) == 2:
        out = apply(args[0], args[1])
    elif c == 'send' and len(args) == 2:
        out = send(args[0], args[1])
    elif c == 'transfer' and len(args) >= 3 and ('--copy' in flags) != ('--move' in flags):
        out = transfer(args[0], args[1], args[2:], '--move' in flags)
    elif c == 'swap' and len(args) == 4:
        out = swap(*args)
    elif c == 'split' and len(args) >= 2:
        out = split(args[0], args[1:])
    elif c == 'find' and len(args) == 2:
        out = find(args[0], args[1])
    elif c == 'customize' and len(args) == 2:
        out = customize(args[0], args[1])
    elif c == 'reset-list' and len(args) == 1:
        out = reset_list(args[0])
    elif c == 'touch' and len(args) == 1:
        out = touch(args[0])
    elif c == 'lock-setup' and len(args) == 1:
        out = lock_setup(args[0], '--remember' in flags)
    elif c == 'unlock' and len(args) == 1:
        out = unlock(args[0], '--remember' in flags, '--keyring' in flags)
    elif c == 'lock' and len(args) == 1:
        out = lock(args[0])
    elif c == 'lock-remove' and len(args) == 1:
        out = lock_remove(args[0])
    elif c == 'passwd' and len(args) == 1:
        out = passwd(args[0])
    elif c == 'forget' and len(args) == 1:
        out = forget(args[0])
    elif c == 'lock-all':
        under_p, reason = None, ''
        for i, x in enumerate(rest):
            if x == '--under' and i + 1 < len(rest):
                under_p = rest[i + 1]
            if x == '--reason' and i + 1 < len(rest):
                reason = rest[i + 1]
        out = lock_all(under_p, reason)
    elif c == 'guard':
        out = guard()
    elif c == 'autosync':
        out = autosync_daemon()
    elif c == 'autosync-needed':
        # systemd's ExecCondition: 0 = start the service, 1 = no Briefcase wants auto-sync (not an error)
        return 0 if autosync_needed() else 1
    elif c == 'sync-now' and len(args) == 1:
        out = dict(autosync_one(open_bc(args[0]), wait_settle=False), ok=True)
    else:
        print(__doc__)
        return 2
    print(json.dumps(out), flush=True)
    return 0


def run(argv):
    signal.signal(signal.SIGTERM, lambda *_: CANCEL.set())
    with contextlib.suppress(AttributeError, ValueError):
        signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    try:
        return main(argv)
    except Fail as e:
        print(json.dumps(dict({'ok': False, 'error': str(e), 'code': e.code}, **e.extra)), flush=True)
        return 1
    except Cancelled:
        print(json.dumps({'ok': False, 'error': 'Stopped', 'code': 'cancelled'}), flush=True)
        return 1
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        print(json.dumps({'ok': False, 'error': str(e), 'code': 'error'}), flush=True)
        return 1


if __name__ == '__main__':
    sys.exit(run(sys.argv))
