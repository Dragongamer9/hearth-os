def open_for_writing(path):
    """Is PATH open for writing in some app (an editor still saving)? /proc/PID/fdinfo's flags."""
    rp = os.path.realpath(path)
    with contextlib.suppress(OSError):
        for pid in os.listdir('/proc'):
            if not pid.isdigit() or pid == str(os.getpid()):
                continue
            try:
                fds = os.listdir('/proc/%s/fd' % pid)
            except OSError:
                continue
            for fd in fds:
                try:
                    if os.readlink('/proc/%s/fd/%s' % (pid, fd)) != rp:
                        continue
                    with open('/proc/%s/fdinfo/%s' % (pid, fd)) as f:
                        m = re.search(r'flags:\s*([0-7]+)', f.read())
                    if m and int(m.group(1), 8) & (os.O_WRONLY | os.O_RDWR):
                        return True
                except OSError:
                    continue
    return False


def settled(p, t, settle=SETTLE):
    """Left alone long enough to copy: unchanged for SETTLE seconds and not open for writing."""
    try:
        st = os.stat(p)
    except OSError:
        return True
    return t - st.st_mtime >= settle and not open_for_writing(p)


def needs_text(n, name):
    return '%d file%s in “%s” need%s you' % (n, '' if n == 1 else 's', name, 's' if n == 1 else '')


def notify_needs(bc, n):
    if os.environ.get('HEARTH_BRIEFCASE_NO_NOTIFY') == '1' or not shutil.which('notify-send'):
        return

    def run():
