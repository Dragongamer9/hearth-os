class Fail(Exception):
    pass


class Cancelled(Exception):
    pass


class Paused(Exception):
    pass


def now():
    return int(time.time())


def run(cmd, timeout=600, inp=None, env=None, cwd=None):
    """A command with no shell. (code, stdout bytes, stderr text)."""
    try:
        p = subprocess.run(cmd, input=inp, capture_output=True, timeout=timeout, env=env, cwd=cwd)
        return p.returncode, p.stdout, p.stderr.decode('utf-8', 'replace')
    except (OSError, subprocess.SubprocessError) as e:
        return 127, b'', str(e)


def have(name):
    return shutil.which(name) is not None


# ------------------------------------------------------------------ settings (hearth_settings_io)

def load():
    return sio.with_defaults(sio.load_json(SETTINGS, {}), DEFAULTS)


def set_key(key, raw):
    """One setting, saved only when it's different from what you have now."""
    if key == 'language':
        if raw not in LANG_CODES:
            raise Fail('a language code (or auto)')
        v = raw
    elif key == 'voice':
        if raw and not re.fullmatch(r'[a-z0-9:_\-]{1,64}', raw):
            raise Fail('a voice id')
        v = raw
    elif key == 'translateModel':
        if raw and not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.:/\-]{0,120}', raw):
            raise Fail('an Ollama model name')
        v = raw
    elif key == 'speakerLabels':
        if raw not in ('on', 'off'):
            raise Fail('on or off')
        v = raw == 'on'
    else:
        raise Fail('Unknown setting')
    if load().get(key) == v:
        return False
    sio.merge_json(SETTINGS, {key: v})
    return True


# ------------------------------------------------------------------ the PIN, sign-ins and the API key (state, 0600)

def secret_read(path=None):
    path = path or WEB_STATE
    v = sio.load_json(path, {}, repair=False) if os.path.exists(path) else {}
    return v if isinstance(v, dict) else {}


def secret_write(data):
    d = os.path.dirname(WEB_STATE)
    try:
        os.makedirs(d, mode=0o700, exist_ok=True)
        text = json.dumps(data, indent=2, ensure_ascii=False) + '\n'
        sio.write_bytes(WEB_STATE, text.encode('utf-8'), lambda b: sio._valid_json_object(b), mode=0o600)
    except OSError as e:
        raise Fail('Couldn\'t save it: %s isn\'t writable (%s). It should belong to you: in a terminal run '
                   '"sudo chown -R $USER: %s", then try again' % (WEB_STATE.replace(HOME, '~', 1), e.strerror or e, d.replace(HOME, '~', 1)))


def pin_clean(pin):
    """What was typed, as a PIN (spaces dropped, other digit forms read as 0-9), or ''."""
    if not isinstance(pin, (str, int)) or isinstance(pin, bool):
        return ''
    t = unicodedata.normalize('NFKC', str(pin)).strip()
    t = ''.join(str(unicodedata.decimal(c)) if unicodedata.decimal(c, None) is not None else c for c in t)
    return t if PIN_RE.match(t) else ''


def pin_hash(pin, salt=None, n=200000):
    salt = salt or secrets.token_hex(16)
    return 'pbkdf2-sha256$%d$%s$%s' % (n, salt, hashlib.pbkdf2_hmac('sha256', pin.encode(), bytes.fromhex(salt), n).hex())


def pin_check(pin, h):
    try:
        kind, n, salt, want = (h or '').split('$')
        pin = pin_clean(pin)
        if kind != 'pbkdf2-sha256' or not pin:
            return False
        return hmac.compare_digest(hashlib.pbkdf2_hmac('sha256', pin.encode(), bytes.fromhex(salt), int(n)).hex(), want)
    except (ValueError, TypeError):
        return False


def pin_hashes():
    """The PINs that open the page: Voice Studio's own, or (with none of its own) Server mode's. (hash, where)."""
    own = secret_read().get('pin')
    if own:
        return [(own, 'own')]
    sm = secret_read(SERVER_MODE_WEB).get('pin')
    return [(sm, 'server')] if sm else []


def pin_set(pin):
    p = pin_clean(pin)
    if not p:
        raise Fail('The PIN is 4 to 12 digits (numbers only)')
    st = secret_read()
    st['pin'] = pin_hash(p)
    st['sessions'] = {}           # a new PIN signs every device out
    secret_write(st)
    return {'pin': True}


def pin_clear():
    st = secret_read()
    st.pop('pin', None)
    st['sessions'] = {}
    secret_write(st)
    return {'pin': False, 'serverPin': bool(secret_read(SERVER_MODE_WEB).get('pin'))}


def token_key(tok):
    return hashlib.sha256(tok.encode()).hexdigest()


def session_new(name):
    st = secret_read()
    tok = secrets.token_urlsafe(32)
    t = now()
    sess = {k: v for k, v in (st.get('sessions') or {}).items() if isinstance(v, dict) and v.get('exp', 0) > t}
    sess[token_key(tok)] = {'exp': t + SESSION_DAYS * 86400, 'name': (name or '')[:60], 'pin': pin_hashes()[0][1] if pin_hashes() else ''}
    for k in sorted(sess, key=lambda k: sess[k]['exp'])[:max(0, len(sess) - 20)]:
        sess.pop(k)
    st['sessions'] = sess
    secret_write(st)
    return tok


def session_ok(tok):
    if not tok or not re.fullmatch(r'[A-Za-z0-9_\-]{20,64}', tok):
        return False
    s = (secret_read().get('sessions') or {}).get(token_key(tok))
    if not isinstance(s, dict) or s.get('exp', 0) <= time.time():
        return False
    # Signed in with Server mode's PIN: only while that's still the PIN that opens the page.
    hs = pin_hashes()
    return bool(hs) and s.get('pin', hs[0][1]) == hs[0][1]


def session_end(tok):
    st = secret_read()
    if (st.get('sessions') or {}).pop(token_key(tok or 'x'), None) is not None:
        secret_write(st)


def api_key(make=True):
    st = secret_read()
    k = st.get('key')
    if not k and make:
        k = 'hvs-' + secrets.token_urlsafe(24)
        st['key'] = k
        secret_write(st)
    return k or ''


def api_key_new():
    st = secret_read()
    st['key'] = 'hvs-' + secrets.token_urlsafe(24)
    secret_write(st)
    return st['key']


def key_ok(header):
    k = secret_read().get('key')
    m = re.fullmatch(r'Bearer\s+(\S{8,200})', (header or '').strip())
    return bool(k and m and hmac.compare_digest(m.group(1).encode(), k.encode()))


# ------------------------------------------------------------------ who may reach the page

def peer_allowed(ip):
    """Only this PC and Tailscale (the page also listens only on 127.0.0.1 and this PC's Tailscale address, and the home
    server's nftables rule drops the port everywhere else)."""
    try:
        a = ipaddress.ip_address(ip.split('%')[0])
    except ValueError:
        return False
    if a.version == 6 and a.ipv4_mapped:
        a = a.ipv4_mapped
    return a.is_loopback or any(a in n for n in TS_NETS)


def write_allowed(headers):
    """A write from this page, not another site: Hearth's X-Hearth header (a form can't send it; another site's script
    would need CORS, which this server never answers), then Sec-Fetch-Site (same-origin only) or a real Origin."""
    if headers.get('X-Hearth') != '1':
        return False
    site = (headers.get('Sec-Fetch-Site') or '').strip().lower()
    if site:
        return site == 'same-origin'
    o = (headers.get('Origin') or '').strip().lower()
    if o in ('', 'null'):
        return True
    host = (headers.get('Host') or '').strip().lower()
    return bool(host) and o in ('http://' + host, 'https://' + host)


def ts_ip4():
    if not have('tailscale'):
        return ''
    code, out, _ = run(['tailscale', 'ip', '-4'], 8)
    ip = out.decode().strip().splitlines()[0].strip() if code == 0 and out.strip() else ''
    return ip if re.fullmatch(r'100\.\d{1,3}\.\d{1,3}\.\d{1,3}', ip) else ''


def ts_name():
    if not have('tailscale'):
        return ''
    code, out, _ = run(['tailscale', 'status', '--json'], 8)
    try:
        return str((json.loads(out).get('Self') or {}).get('DNSName') or '').rstrip('.') if code == 0 else ''
    except ValueError:
        return ''


def listen_addresses():
    ip = ts_ip4()
    return ['127.0.0.1'] + ([ip] if ip else [])


# ------------------------------------------------------------------ audio helpers (standard library; ffmpeg when there)

def wav_bytes(pcm, sr=SR, ch=1):
    b = io.BytesIO()
    with wave.open(b, 'wb') as w:
        w.setnchannels(ch)
        w.setsampwidth(2)
        w.setframerate(sr)
        w.writeframes(pcm)
    return b.getvalue()


def write_wav(path, pcm, sr=SR, ch=1):
    tmp = path + '.part'
    with open(tmp, 'wb') as f:
        f.write(wav_bytes(pcm, sr, ch))
    os.replace(tmp, path)


def read_wav(path):
    """(pcm16 bytes, rate, channels) of a 16-bit WAV."""
    with wave.open(path, 'rb') as w:
        if w.getsampwidth() != 2:
            raise Fail('not a 16-bit WAV')
        return w.readframes(w.getnframes()), w.getframerate(), w.getnchannels()


def secs(pcm, sr=SR, ch=1):
    return len(pcm) / (2.0 * sr * ch)


def silence(sec, sr=SR):
    return b'\0\0' * max(0, int(sec * sr))


def to_wav(src, dst, sr=SR, ch=1, start=None, dur=None):
    """Any audio or video to a 16-bit WAV with ffmpeg (or a WAV copied as it is when there's no ffmpeg)."""
    if not have('ffmpeg'):
        try:
            pcm, r, c = read_wav(src)
        except (wave.Error, EOFError, Fail, OSError):
            raise Fail('This PC needs ffmpeg to read that kind of file')
        if (r, c) != (sr, ch):
            pcm = convert_pcm(pcm, r, c, sr, ch)
        if start is not None or dur is not None:
            a = int((start or 0) * sr) * 2 * ch
            b = a + int(dur * sr) * 2 * ch if dur else len(pcm)
            pcm = pcm[a:b]
        write_wav(dst, pcm, sr, ch)
        return dst
    cmd = ['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'error', '-y']
    if start is not None:
        cmd += ['-ss', '%.3f' % start]
    cmd += ['-i', src]
    if dur is not None:
        cmd += ['-t', '%.3f' % dur]
    cmd += ['-vn', '-ac', str(ch), '-ar', str(sr), '-c:a', 'pcm_s16le', '-f', 'wav', dst + '.part']
    code, _, err = run(cmd, 3600)
    if code != 0:
        raise Fail('That file couldn\'t be read as audio: %s' % (err.strip().splitlines() or ['no reason given'])[-1][:200])
    os.replace(dst + '.part', dst)
    return dst


def convert_pcm(pcm, rate, ch, to_rate, to_ch):
    """16-bit PCM to another rate and channel count without ffmpeg (channels averaged, linear resampling). Only used
    when ffmpeg isn't there (Hearth OS has it); slow for long files but always right."""
    import array
    a = array.array('h')
    a.frombytes(pcm[:len(pcm) // (2 * ch) * 2 * ch])
    mono = [sum(a[i:i + ch]) // ch for i in range(0, len(a), ch)] if ch > 1 else list(a)
    if rate != to_rate and mono:
        n = int(len(mono) * to_rate / rate)
        step = rate / to_rate
        last = len(mono) - 1
        out = []
        for i in range(n):
            x = i * step
            k = int(x)
            f = x - k
            out.append(int(mono[k] * (1 - f) + mono[min(k + 1, last)] * f))
        mono = out
    if to_ch > 1:
        mono = [v for v in mono for _ in range(to_ch)]
    return array.array('h', mono).tobytes()


def encode(wav, fmt):
    """WAV bytes as FMT (mp3, opus, flac, aac, pcm, wav). Without ffmpeg only wav and pcm."""
    if fmt == 'wav':
        return wav
    if fmt == 'pcm':
        with wave.open(io.BytesIO(wav), 'rb') as w:
            return w.readframes(w.getnframes())
    if not have('ffmpeg'):
        raise Fail('This PC needs ffmpeg for %s: ask for wav instead' % fmt)
    args = {'mp3': ['-c:a', 'libmp3lame', '-q:a', '3', '-f', 'mp3'], 'opus': ['-c:a', 'libopus', '-b:a', '64k', '-f', 'ogg'],
            'flac': ['-c:a', 'flac', '-f', 'flac'], 'aac': ['-c:a', 'aac', '-b:a', '128k', '-f', 'adts']}[fmt]
    code, out, err = run(['ffmpeg', '-nostdin', '-hide_banner', '-loglevel', 'error', '-f', 'wav', '-i', 'pipe:0'] + args + ['pipe:1'], 900, inp=wav)
    if code != 0 or not out:
        raise Fail('Couldn\'t make %s: %s' % (fmt, err.strip()[-200:]))
    return out


def media_secs(path):
    if have('ffprobe'):
        code, out, _ = run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'default=nw=1:nk=1', path], 60)
        try:
            return float(out.decode().strip()) if code == 0 else 0.0
        except ValueError:
            pass
    try:
        pcm, r, c = read_wav(path)
        return secs(pcm, r, c)
    except Exception:  # noqa: BLE001 - not a WAV: unknown
        return 0.0


def fit(pcm, sr, slot, tmpdir):
    """Speech made to fit SLOT seconds: sped up (up to 1.5x, ffmpeg's atempo keeps the pitch) when it runs over, then
    cut with a short fade if it still does. Never slowed down (silence after it instead)."""
    have_s = secs(pcm, sr)
    if slot <= 0 or have_s <= slot + 0.02:
        return pcm
    rate = min(1.5, have_s / slot)
    if have('ffmpeg') and rate > 1.02:
        src = os.path.join(tmpdir, 'fit-in.wav')
        dst = os.path.join(tmpdir, 'fit-out.wav')
        write_wav(src, pcm, sr)
        code, _, _ = run(['ffmpeg', '-nostdin', '-loglevel', 'error', '-y', '-i', src, '-filter:a', 'atempo=%.3f' % rate,
                          '-ar', str(sr), '-ac', '1', '-c:a', 'pcm_s16le', dst], 300)
        if code == 0:
            try:
                pcm = read_wav(dst)[0]
            except (wave.Error, EOFError, Fail, OSError):
                pass
    n = int(slot * sr) * 2
    if len(pcm) > n:
        pcm = fade_out(pcm[:n], sr)
    return pcm


def fade_out(pcm, sr, sec=0.08):
    import array
    a = array.array('h')
    a.frombytes(pcm[:len(pcm) // 2 * 2])
    n = min(len(a), int(sec * sr))
    for i in range(n):
        a[len(a) - n + i] = int(a[len(a) - n + i] * (n - i) / n)
    return a.tobytes()


def place(track, pcm, at, sr=SR):
    """PCM put into TRACK (a bytearray of 16-bit mono) starting at AT seconds, growing it when needed."""
    a = int(at * sr) * 2
    if len(track) < a + len(pcm):
        track.extend(b'\0' * (a + len(pcm) - len(track)))
    track[a:a + len(pcm)] = pcm
    return track


# ------------------------------------------------------------------ text helpers

SENT_RE = re.compile(r'(?<=[.!?…。！？])\s+|(?<=[。！？])|\n{2,}')


def chunks(text, limit=280):
    """Text in pieces the engine speaks well: whole sentences, at most LIMIT characters (long ones split at commas)."""
    out, cur = [], ''
    for s in (x.strip() for x in SENT_RE.split(text or '')):
        if not s:
            continue
        s = re.sub(r'\s+', ' ', s)
        parts = [s]
        if len(s) > limit:
            parts, piece = [], ''
            for w in re.split(r'(?<=[,;:，、])\s*|\s+', s):
                if not w:
                    continue
                if piece and len(piece) + len(w) + 1 > limit:
                    parts.append(piece)
                    piece = w
                else:
                    piece = (piece + ' ' + w).strip()
            if piece:
                parts.append(piece)
        for p in parts:
            if cur and len(cur) + len(p) + 1 > limit:
                out.append(cur)
                cur = p
            else:
                cur = (cur + ' ' + p).strip()
    if cur:
        out.append(cur)
    return out


HEAD_RE = re.compile(r'^[ \t]*(?:#{1,3}[ \t]+\S.{0,100}|(?:chapter|kapitel|chapitre|cap[ií]tulo|capitolo|hoofdstuk|rozdzia[łl]|глава|'
                     r'part|book|prologue|epilogue|prolog|epilog)\b[^\n]{0,100})[ \t]*$', re.I | re.M)


def split_chapters(text, title=''):
    """Chapters from plain text: at headings ("Chapter 3", "# Title", "Prologue"...) when there are at least two, else
    one chapter, or parts of about 15,000 characters at paragraph breaks for a long text with no headings."""
    text = (text or '').replace('\r\n', '\n').replace('\r', '\n')
    heads = list(HEAD_RE.finditer(text))
    out = []
    if len(heads) >= 2:
        pre = text[:heads[0].start()].strip()
        if len(pre) > 200:
            out.append({'title': title or 'Opening', 'text': pre})
        for i, m in enumerate(heads):
            body = text[m.end():heads[i + 1].start() if i + 1 < len(heads) else len(text)].strip()
            name = m.group(0).strip().lstrip('#').strip()[:100]
            if body:
                out.append({'title': name, 'text': body})
    elif len(text) <= 20000:
        if text.strip():
            out.append({'title': title or 'Chapter 1', 'text': text.strip()})
    else:
        cur = ''
        for para in re.split(r'\n\s*\n', text):
            if cur and len(cur) + len(para) > 15000:
                out.append({'title': 'Part %d' % (len(out) + 1), 'text': cur.strip()})
                cur = ''
            cur += para + '\n\n'
        if cur.strip():
            out.append({'title': 'Part %d' % (len(out) + 1), 'text': cur.strip()})
    return [{'title': c['title'], 'text': c['text'][:400000]} for c in out[:400]]


def epub_chapters(path):
    """Chapters from an .epub: its reading order (the OPF spine), each document's text, its first heading as the title.
    Covers, tables of contents and other tiny pages are left out. Sizes are capped (a zip can claim anything)."""
    import xml.etree.ElementTree as ET
    from html.parser import HTMLParser

    class Text(HTMLParser):
        def __init__(self):
            super().__init__(convert_charrefs=True)
            self.parts, self.head, self.in_head, self.skip = [], '', False, 0

        def handle_starttag(self, tag, attrs):
            if tag in ('script', 'style', 'head'):
                self.skip += 1
            if tag in ('h1', 'h2', 'h3') and not self.head:
                self.in_head = True
            if tag in ('p', 'div', 'br', 'h1', 'h2', 'h3', 'h4', 'li', 'section', 'blockquote'):
                self.parts.append('\n\n')

        def handle_endtag(self, tag):
            if tag in ('script', 'style', 'head'):
                self.skip = max(0, self.skip - 1)
            if tag in ('h1', 'h2', 'h3'):
                self.in_head = False

        def handle_data(self, d):
            if self.skip:
                return
            if self.in_head:
                self.head = (self.head + ' ' + d).strip()[:100]
            self.parts.append(d)

    def read(z, name, limit=8 << 20):
        info = z.getinfo(name)
        if info.file_size > limit:
            raise Fail('That book has a part bigger than Hearth reads (%s)' % name[:60])
        return z.read(name)

    try:
        z = zipfile.ZipFile(path)
    except (zipfile.BadZipFile, OSError):
        raise Fail('That isn\'t an .epub book (it couldn\'t be opened)')
    with z:
        if sum(i.file_size for i in z.infolist()) > 400 << 20:
            raise Fail('That book is too big for Hearth to read')
        try:
            cont = ET.fromstring(read(z, 'META-INF/container.xml'))
            opf_path = next(e.get('full-path') for e in cont.iter() if e.tag.endswith('rootfile'))
            opf = ET.fromstring(read(z, opf_path))
        except (KeyError, StopIteration, ET.ParseError):
            raise Fail('That .epub book has no table of contents Hearth can read')
        base = os.path.dirname(opf_path)
        items = {}
        for e in opf.iter():
            if e.tag.endswith('}item') or e.tag == 'item':
                items[e.get('id')] = (e.get('href') or '', e.get('media-type') or '', e.get('properties') or '')
        book_title = next((e.text for e in opf.iter() if e.tag.endswith('}title') and e.text), '') or ''
        out = []
        for e in opf.iter():
            if not (e.tag.endswith('}itemref') or e.tag == 'itemref'):
                continue
            href, mt, props = items.get(e.get('idref'), ('', '', ''))
            if not href or 'nav' in props.split() or 'html' not in mt:
                continue
            name = os.path.normpath(os.path.join(base, urllib.parse.unquote(href))).replace(os.sep, '/')
            try:
                raw = read(z, name).decode('utf-8', 'replace')
            except KeyError:
                continue
            p = Text()
            try:
                p.feed(raw)
            except Exception:  # noqa: BLE001 - a broken page is left out
                continue
            body = re.sub(r'[ \t]+', ' ', ''.join(p.parts))
            body = re.sub(r'\n\s*\n\s*(\n\s*)+', '\n\n', body).strip()
            if len(body) < 300:
                continue
            out.append({'title': p.head or 'Chapter %d' % (len(out) + 1), 'text': body[:400000]})
            if len(out) >= 400:
                break
        if not out:
            raise Fail('That book has no chapters with text in them')
        return book_title.strip()[:120], out


def srt_time(t, sep=','):
    t = max(0.0, float(t))
    h, rem = divmod(int(round(t * 1000)), 3600000)
    m, rem = divmod(rem, 60000)
    s, ms = divmod(rem, 1000)
    return '%02d:%02d:%02d%s%03d' % (h, m, s, sep, ms)


def to_srt(segs):
    lines = []
    for i, s in enumerate(segs, 1):
        who = ('[%s] ' % s['speaker']) if s.get('speaker') else ''
        lines.append('%d\n%s --> %s\n%s%s\n' % (i, srt_time(s['start']), srt_time(s['end']), who, s['text'].strip()))
    return '\n'.join(lines)


def to_vtt(segs):
    out = ['WEBVTT', '']
    for s in segs:
        who = ('<v %s>' % s['speaker']) if s.get('speaker') else ''
        out.append('%s --> %s\n%s%s\n' % (srt_time(s['start'], '.'), srt_time(s['end'], '.'), who, s['text'].strip()))
    return '\n'.join(out)


def to_text(segs):
    out, last = [], None
    for s in segs:
        if s.get('speaker') and s['speaker'] != last:
            out.append('\n%s: %s' % (s['speaker'], s['text'].strip()))
            last = s['speaker']
        else:
            out.append(s['text'].strip())
    return ' '.join(out).strip() + '\n'


def describe_to_instruct(text):
    """A description in your own words ("a grumpy old pirate with a deep voice") as the attributes OmniVoice's voice
    design understands ("male, elderly, low pitch"): at most one per kind, the first word that matches wins."""
    t = (text or '').lower()
    got = {}
    # Attributes written as OmniVoice's own words are taken as they are (the longest first: "very high pitch").
    for kind, words in DESIGN.items():
        for w in sorted(words, key=len, reverse=True):
            if kind not in got and re.search(r'(^|[ ,])%s($|[ ,])' % re.escape(w), t):
                got[kind] = w
    for pat, kind, attr in DESIGN_WORDS:
        if kind not in got and re.search(pat, t):
            got[kind] = attr
    order = ('gender', 'age', 'pitch', 'style', 'accent')
    return ', '.join(got[k] for k in order if k in got)


def cluster(vectors, threshold=0.55, most=8):
    """Speaker labels from voice fingerprints (unit vectors): each one joins the closest speaker so far when it's similar
    enough, else becomes a new speaker (at most MOST). Returns a label index per vector."""
    cents, counts, out = [], [], []
    for v in vectors:
        v = [float(x) for x in v]
        best, bi = -2.0, -1
        for i, c in enumerate(cents):
            n = sum(x * x for x in c) ** 0.5 or 1.0
            sim = sum(a * b for a, b in zip(v, c)) / n
            if sim > best:
                best, bi = sim, i
        if bi >= 0 and (best >= threshold or len(cents) >= most):
            k = counts[bi]
            cents[bi] = [(c * k + x) / (k + 1) for c, x in zip(cents[bi], v)]
            counts[bi] += 1
            out.append(bi)
        else:
            cents.append(v)
            counts.append(1)
            out.append(len(cents) - 1)
    return out


# ------------------------------------------------------------------ Ollama (the home server's own AI service)

def ollama(method, path, body=None, timeout=10):
    req = urllib.request.Request(OLLAMA + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read(8 << 20).decode('utf-8', 'replace'))
    except Exception:  # noqa: BLE001 - not answering is just that
        return None


def ollama_models():
    tags = ollama('GET', '/api/tags', timeout=3)
    return [m.get('name') for m in (tags or {}).get('models') or [] if isinstance(m, dict) and m.get('name')]


def translate(lines, target, model='', ask=None):
    """Lines translated into TARGET by the home server's AI service (Ollama), 25 at a time, kept in the same order and
    count. A batch that comes back wrong is asked again line by line."""
    ask = ask or ollama
    if not model:
        models = ollama_models() if ask is ollama else ['test']
        if not models:
            raise Fail('Translating needs the AI service (Settings › Home server › AI chat) with a model downloaded')
        prefer = [m for m in models if m.split(':')[0] in ('qwen3', 'gpt-oss', 'llama3.1', 'llama3.2', 'gemma3', 'mistral')]
        model = (prefer or models)[0]
    lang = LANG_NAMES.get(target, target)
    out = []

    def one(batch):
        prompt = ('Translate each line into %s. Keep the meaning, tone and names; keep each line about as long when spoken. '
                  'Answer only with JSON: {"lines": [...]} with exactly %d strings, in the same order.\n\n%s'
                  % (lang, len(batch), json.dumps(batch, ensure_ascii=False)))
        r = ask('POST', '/api/chat', {'model': model, 'stream': False, 'think': False, 'format': 'json', 'options': {'temperature': 0.2},
                                      'messages': [{'role': 'system', 'content': 'You are a careful subtitle translator.'},
                                                   {'role': 'user', 'content': prompt}]}, timeout=600)
        try:
            got = json.loads(((r or {}).get('message') or {}).get('content') or '{}').get('lines')
        except (ValueError, AttributeError):
            got = None
        if isinstance(got, list) and len(got) == len(batch) and all(isinstance(x, str) for x in got):
            return [x.strip() for x in got]
        return None

    for i in range(0, len(lines), 25):
        batch = lines[i:i + 25]
        got = one(batch)
        if got is None:
            got = []
            for line in batch:
                g = one([line])
                if g is None:
                    raise Fail('The AI service (%s) didn\'t give a translation back. Try another model in Voice Studio\'s settings' % model)
                got += g
        out += got
    return out, model


# ------------------------------------------------------------------ engines

class Engines:
    """The voice engines, loaded the first time they're needed and let go after ten idle minutes (the graphics card is
    shared with games, AI chat and AI pictures). One at a time on the card (self.lock)."""
    IDLE = 600

    def __init__(self, data=DATA):
        self.data = data
        self.lock = threading.RLock()
        self.omni = self.whisper = self.labeler = self.demucs = None
        self.used = time.time()
        self.caps_cache = None

    # ---- what's there
    def caps(self):
        if self.caps_cache is None:
            import importlib.util as u
            has = lambda m: u.find_spec(m) is not None  # noqa: E731
            self.caps_cache = {'speak': has('omnivoice'), 'clone': has('omnivoice'), 'design': has('omnivoice'),
                               'transcribe': has('faster_whisper'), 'labels': has('speechbrain'), 'separate': has('demucs'),
                               'gpu': self._gpu()}
        c = dict(self.caps_cache)
        c['kokoro'] = bool(kokoro_voices())
        c['ffmpeg'] = have('ffmpeg')
        return c

    def _gpu(self):
        try:
            import torch
            return torch.cuda.get_device_name(0) if torch.cuda.is_available() else ''
        except Exception:  # noqa: BLE001
            return ''

    def idle_check(self):
        if time.time() - self.used > self.IDLE and (self.omni or self.whisper or self.labeler or self.demucs):
            with self.lock:
                self.omni = self.whisper = self.labeler = self.demucs = None
                try:
                    import gc
                    import torch
                    gc.collect()
                    torch.cuda.empty_cache()
                except Exception:  # noqa: BLE001
                    pass

    def _device(self):
        import torch
        return 'cuda:0' if torch.cuda.is_available() else 'cpu'

    # ---- speech
    def _omnivoice(self):
        if self.omni is None:
            import torch
            from omnivoice import OmniVoice
            dev = self._device()
            self.omni = OmniVoice.from_pretrained(OMNI_MODEL, device_map=dev, dtype=torch.float16 if dev != 'cpu' else torch.float32)
        return self.omni

    def speak(self, text, ref=None, ref_text=None, instruct=None, language=None, speed=1.0, duration=None):
        """One piece of speech: (pcm16 bytes, rate)."""
        import numpy as np
        with self.lock:
            self.used = time.time()
            m = self._omnivoice()
            kw = {'text': text}
            if language and language != 'auto':
                kw['language'] = language
            if ref:
                kw['ref_audio'] = ref
                if ref_text:
                    kw['ref_text'] = ref_text
            elif instruct:
                kw['instruct'] = instruct
            if duration:
                kw['duration'] = float(duration)
            elif speed and abs(speed - 1.0) > 0.01:
                kw['speed'] = float(speed)
            out = m.generate(**kw)
            a = out[0] if isinstance(out, (list, tuple)) else out
            if hasattr(a, 'detach'):
                a = a.detach().float().cpu().numpy()
            a = np.clip(np.asarray(a, dtype=np.float32).reshape(-1), -1.0, 1.0)
            sr = int(getattr(m, 'sampling_rate', None) or SR)
            self.used = time.time()
            return (a * 32767).astype('<i2').tobytes(), sr

    # ---- transcription
    def _whisper_model(self):
        if self.whisper is None:
            from faster_whisper import WhisperModel
            try:
                self.whisper = WhisperModel(WHISPER_MODEL, device='cuda', compute_type='float16', download_root=os.path.join(MODELS, 'whisper'))
            except Exception:  # noqa: BLE001 - no CUDA libraries: the processor (slower)
                self.whisper = WhisperModel(WHISPER_MODEL, device='cpu', compute_type='int8', download_root=os.path.join(MODELS, 'whisper'))
        return self.whisper

    def transcribe(self, path, language=None, task='transcribe', labels=False, progress=None):
        with self.lock:
            self.used = time.time()
            m = self._whisper_model()
            segs, info = m.transcribe(path, language=None if language in (None, '', 'auto') else language, task=task, vad_filter=True, beam_size=5)
            out = []
            total = float(getattr(info, 'duration', 0) or 0)
            for s in segs:
                t = (s.text or '').strip()
                if t:
                    out.append({'start': round(float(s.start), 2), 'end': round(float(s.end), 2), 'text': t})
                if progress and total:
                    progress(min(1.0, float(s.end) / total))
            if labels and len(out) > 1 and self.caps().get('labels'):
                try:
                    self._label(path, out)
                except Exception as e:  # noqa: BLE001 - labels are a bonus: the words stand without them
                    print('hearth-voice-studio: speaker labels skipped (%s)' % e, file=sys.stderr, flush=True)
            self.used = time.time()
            return {'language': getattr(info, 'language', '') or '', 'duration': total, 'segments': out}

    def _label(self, path, segs):
        import numpy as np
        import torch
        try:
            from speechbrain.inference.speaker import EncoderClassifier
        except ImportError:
            from speechbrain.pretrained import EncoderClassifier
        if self.labeler is None:
            self.labeler = EncoderClassifier.from_hparams(source=LABEL_MODEL, savedir=os.path.join(MODELS, 'speechbrain-ecapa'),
                                                          run_opts={'device': self._device()})
        code, raw, err = run(['ffmpeg', '-nostdin', '-loglevel', 'error', '-i', path, '-vn', '-ac', '1', '-ar', '16000', '-f', 'f32le', 'pipe:1'], 3600)
        if code != 0:
            raise Fail(err[-200:])
        pcm = np.frombuffer(raw, dtype=np.float32)
        vecs, idx = [], []
        for i, s in enumerate(segs):
            a = pcm[int(s['start'] * 16000):int(s['end'] * 16000)]
            if len(a) < 12000:
                continue
            e = self.labeler.encode_batch(torch.from_numpy(a.copy())[None]).squeeze().detach().cpu().numpy()
            vecs.append((e / (np.linalg.norm(e) or 1.0)).tolist())
            idx.append(i)
        labs = cluster(vecs)
        names = {}
        for i, lab in zip(idx, labs):
            segs[i]['speaker'] = names.setdefault(lab, 'Speaker %d' % (len(names) + 1))
        last = None
        for s in segs:                      # pieces too short to tell: the speaker around them
            if s.get('speaker'):
                last = s['speaker']
            elif last:
                s['speaker'] = last
        if len(names) < 2:
            for s in segs:
                s.pop('speaker', None)

    # ---- vocals and background
    def separate(self, wav, vocals, background):
        """WAV (44.1 kHz stereo) split into the voices and everything else (Demucs htdemucs)."""
        import numpy as np
        import torch
        from demucs.apply import apply_model
        from demucs.pretrained import get_model
        with self.lock:
            self.used = time.time()
            if self.demucs is None:
                os.environ.setdefault('TORCH_HOME', os.path.join(MODELS, 'torch'))
                self.demucs = get_model('htdemucs')
                self.demucs.eval()
            pcm, sr, ch = read_wav(wav)
            a = np.frombuffer(pcm, dtype='<i2').astype(np.float32).reshape(-1, ch).T / 32768.0
            x = torch.from_numpy(a.copy())
            ref = x.mean(0)
            mean, std = ref.mean(), ref.std() or 1.0
            dev = self._device()
            with torch.no_grad():
                src = apply_model(self.demucs, ((x - mean) / std)[None], device=dev, split=True, overlap=0.25, progress=False)[0]
            src = src * std + mean
            vi = list(self.demucs.sources).index('vocals')
            voc = src[vi]
            bg = src.sum(0) - voc
            for t, path in ((voc, vocals), (bg, background)):
                arr = (np.clip(t.cpu().numpy().T, -1, 1) * 32767).astype('<i2')
                write_wav(path, arr.tobytes(), sr, ch)
            self.used = time.time()


class MockEngines(Engines):
    """Stand-in engines for tests and CI screenshots: tones instead of speech, made-up words instead of a transcript."""

    def __init__(self, data=DATA):
