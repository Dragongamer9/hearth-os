def installed():
    v = sio.load_json(INSTALLED, {}, repair=False) if os.path.exists(INSTALLED) else {}
    return v if isinstance(v, dict) and os.path.isfile(os.path.join(VENV, 'bin', 'python')) and v.get('rev') else {}


def venv_env():
    """The engines' environment: models in Voice Studio's own folder, and the CUDA libraries pip put in the venv."""
    env = dict(os.environ, HF_HOME=os.path.join(MODELS, 'hf'), TORCH_HOME=os.path.join(MODELS, 'torch'), HF_HUB_DISABLE_TELEMETRY='1',
               PYTHONNOUSERSITE='1')
    libs = []
    for sp in sorted(__import__('glob').glob(os.path.join(VENV, 'lib', 'python3*', 'site-packages', 'nvidia', '*', 'lib'))):
        libs.append(sp)
    if libs:
        env['LD_LIBRARY_PATH'] = ':'.join(libs + [x for x in (os.environ.get('LD_LIBRARY_PATH') or '').split(':') if x])
    return env


def free_gb(path):
    try:
        st = os.statvfs(path)
        return st.f_bavail * st.f_frsize / (1 << 30)
    except OSError:
        return 0


def install(step=lambda text, pct: None, runner=run):
    """The engines into ~/.local/share/nimbus/voice-studio/venv (only when you ask; a few GB). PyTorch from its own CUDA
    index, the rest from PyPI; then the main models downloaded so the first use doesn't wait. A part that fails to install
    (Demucs, speaker labels) is noted and the rest still works. Your voices and finished work are never touched."""
    os.makedirs(DATA, mode=0o700, exist_ok=True)
    if free_gb(DATA) < 14:
        raise Fail('Not enough free space in your Home: Voice Studio with PyTorch and its models needs about 14 GB')
    py = os.path.join(VENV, 'bin', 'python')
    pip = [py, '-m', 'pip', '--disable-pip-version-check', '--no-input', '--no-cache-dir', '--progress-bar', 'off']
    env = venv_env()
    if not os.path.isfile(py):
        step('making its Python environment', 5)
        code, _, err = runner(['/usr/bin/python3', '-m', 'venv', VENV], 600)
        if code != 0:
            raise Fail('Couldn\'t make its Python environment: ' + err.strip()[-200:])
    step('downloading PyTorch for CUDA 12.8 (a few GB)', 10)
    code, _, err = runner(pip + ['install', '--index-url', TORCH_INDEX, 'torch', 'torchaudio'], 3 * 3600, env=env)
    if code != 0:
        raise Fail('PyTorch didn\'t install: ' + err.strip()[-200:])
    step('installing the voice engines (OmniVoice, faster-whisper)', 40)
    code, _, err = runner(pip + ['install', '--extra-index-url', TORCH_INDEX] + PIP_MAIN, 3600, env=env)
    if code != 0:
        raise Fail('The voice engines didn\'t install: ' + err.strip()[-200:])
    notes = []
    step('installing vocal separation for dubbing (Demucs)', 55)
    if runner(pip + ['install', '--no-deps'] + PIP_DEMUCS, 1800, env=env)[0] != 0 or runner(pip + ['install'] + PIP_DEMUCS_DEPS, 1800, env=env)[0] != 0:
        notes.append('Vocal separation (Demucs) didn\'t install: dubbing keeps the original sound quietly underneath')
    runner(pip + ['install', 'lameenc'], 600, env=env)          # Demucs's own MP3 writer; not needed by Hearth
    step('installing speaker labels (SpeechBrain)', 62)
    if runner(pip + ['install'] + PIP_LABELS, 1800, env=env)[0] != 0:
        notes.append('Speaker labels (SpeechBrain) didn\'t install: transcripts come without "Speaker 1, Speaker 2"')
    step('downloading the voice model (OmniVoice, about 3 GB)', 70)
    code, _, err = runner([py, '-c', 'from huggingface_hub import snapshot_download; snapshot_download(%r)' % OMNI_MODEL], 3 * 3600, env=env)
    if code != 0:
        notes.append('The voice model will download the first time you use it (%s)' % err.strip()[-120:])
    step('downloading the transcription model (Whisper large-v3 turbo)', 85)
    code, _, err = runner([py, '-c', 'from faster_whisper import download_model; download_model(%r, cache_dir=%r)'
                           % (WHISPER_MODEL, os.path.join(MODELS, 'whisper'))], 3 * 3600, env=env)
    if code != 0:
        notes.append('The transcription model will download the first time you use it')
    step('checking PyTorch sees the graphics card', 95)
    code, out, _ = runner([py, '-c', 'import json, torch; c = torch.cuda.is_available(); print(json.dumps({"torch": torch.__version__, '
                           '"cuda": c, "gpu": torch.cuda.get_device_name(0) if c else ""}))'], 300, env=env)
    info = {}
    try:
        info = json.loads(out.decode().strip().splitlines()[-1]) if code == 0 else {}
    except (ValueError, IndexError):
        pass
    rec = {'rev': INSTALL_REV, 'at': now(), 'torch': str(info.get('torch', ''))[:40], 'cuda': info.get('cuda') is True,
           'gpu': str(info.get('gpu', ''))[:80], 'notes': notes}
    sio.write_json(INSTALLED, rec)
    return rec


def remove(voices=False):
    """The engines and their models go. Your voices, your finished audiobooks, dubs and transcripts stay unless you
    confirmed twice (voices sure). Nothing outside Voice Studio's folder is touched; links are never followed."""
    gone = []
    for name in ('venv', 'models', 'presets', 'uploads', 'installed.json'):
        p = os.path.join(DATA, name)
        if os.path.islink(p):
            os.remove(p)
        elif os.path.isdir(p):
            shutil.rmtree(p, ignore_errors=True)
        elif os.path.exists(p):
            os.remove(p)
        else:
            continue
        gone.append(name)
    if voices:
        for name in ('voices', 'jobs'):
            p = os.path.join(DATA, name)
            if os.path.isdir(p) and not os.path.islink(p):
                shutil.rmtree(p, ignore_errors=True)
                gone.append(name)
    left = [n for n in ('voices', 'jobs') if os.path.isdir(os.path.join(DATA, n))]
    return {'removed': gone, 'kept': left}


def status():
    inst = installed()
    st = secret_read()
    ts = ts_name()
    nvoices = len([d for d in os.listdir(os.path.join(DATA, 'voices'))]) if os.path.isdir(os.path.join(DATA, 'voices')) else 0
    njobs = 0
    if os.path.isdir(os.path.join(DATA, 'jobs')):
        for jid in os.listdir(os.path.join(DATA, 'jobs')):
            p = os.path.join(DATA, 'jobs', jid, 'job.json')
            j = sio.load_json(p, {}, repair=False) if os.path.exists(p) else {}
            njobs += isinstance(j, dict) and j.get('state') in ('queued', 'running')
    return {'installed': bool(inst), 'install': inst, 'dir': DATA, 'pin': bool(st.get('pin')),
            'serverPin': bool(secret_read(SERVER_MODE_WEB).get('pin')), 'keySet': bool(st.get('key')), 'settings': load(),
            'port': PORT, 'url': 'http://%s:%d' % (ts, PORT) if ts else '', 'local': 'http://localhost:%d' % PORT,
            'api': ('http://%s:%d/v1' % (ts, PORT)) if ts else 'http://localhost:%d/v1' % PORT, 'voices': nvoices, 'queue': njobs}


def main(argv):
    a = argv[1:]
    stdin = os.environ.get('HEARTH_INPUT', '')
    try:
        if a == ['serve']:
            return serve()
        if a[:1] == ['mock-serve']:
            return serve(mock=True, port=int(a[1]) if len(a) > 1 else PORT)
        if a == ['status']:
            res = status()
        elif len(a) == 3 and a[0] == 'set':
            res = {'changed': set_key(a[1], a[2])}
        elif a == ['pin-set']:
            res = pin_set(stdin.split('\n')[0])
        elif a == ['pin-clear']:
            res = pin_clear()
        elif a == ['key-show']:
            res = {'key': api_key()}
        elif a == ['key-new']:
            res = {'key': api_key_new()}
        elif a == ['install-job']:
            res = install(lambda t, p: print(json.dumps({'step': t, 'progress': p}), flush=True))
        elif a == ['remove']:
            res = remove(False)
        elif a == ['remove', 'voices', 'sure']:
            res = remove(True)
        else:
            raise Fail('Unknown command')
        print(json.dumps(res))
        return 0
    except Fail as e:
        print('error: %s' % e)
        return 1
    except (OSError, ValueError) as e:
        print('error: %s' % e)
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
