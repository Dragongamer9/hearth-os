                'gpu': 'NVIDIA GeForce RTX 5070 (stand-in)', 'kokoro': bool(kokoro_voices()), 'ffmpeg': have('ffmpeg')}

    def idle_check(self):
        pass

    def speak(self, text, ref=None, ref_text=None, instruct=None, language=None, speed=1.0, duration=None):
        import array
        import math
        self.calls.append(('speak', text, ref, instruct, language, duration))
        sec = duration or max(0.4, min(30.0, len(text) * 0.055 / (speed or 1.0)))
        n = int(sec * SR)
        f = 180 + (sum(map(ord, (ref or '') + (instruct or ''))) % 200)
        a = array.array('h', (int(6000 * math.sin(2 * math.pi * f * i / SR) * (0.5 + 0.5 * math.sin(i / 2400.0))) for i in range(n)))
        return a.tobytes(), SR

    def transcribe(self, path, language=None, task='transcribe', labels=False, progress=None):
        self.calls.append(('transcribe', path, language, task, labels))
        total = media_secs(path) or 6.0
        words = ['Welcome to the castle.', 'The gate opens at dawn.', 'Bring the map and the lantern.', 'We leave before the snow comes.']
        segs, t, i = [], 0.0, 0
        while t < total - 0.3 and i < 200:
            end = min(total, t + 2.5)
            segs.append({'start': round(t, 2), 'end': round(end, 2), 'text': words[i % len(words)]})
            if labels:
                segs[-1]['speaker'] = 'Speaker %d' % (i % 2 + 1)
            t, i = end + 0.2, i + 1
            if progress:
                progress(min(1.0, t / total))
        return {'language': language if language not in (None, '', 'auto') else 'en', 'duration': total, 'segments': segs}

    def separate(self, wav, vocals, background):
        self.calls.append(('separate', wav))
        shutil.copyfile(wav, vocals)
        shutil.copyfile(wav, background)


# ------------------------------------------------------------------ Kokoro (Hearth's AI voices, when it's on)

_KOKORO = {'at': 0, 'voices': []}


def kokoro_voices():
    """Kokoro's voices when Hearth's AI voices answers on this PC (looked up at most once a minute)."""
    if time.time() - _KOKORO['at'] < 60:
        return _KOKORO['voices']
    v = []
    try:
        with urllib.request.urlopen(KOKORO + '/v1/audio/voices', timeout=2) as r:
            j = json.loads(r.read(1 << 20))
        v = [x if isinstance(x, str) else str((x or {}).get('id') or (x or {}).get('name') or '') for x in (j.get('voices') or [])]
        v = [x for x in v if re.fullmatch(r'[A-Za-z0-9_\-]{1,40}', x)][:200]
    except Exception:  # noqa: BLE001 - off or not installed
        v = []
    _KOKORO.update(at=time.time(), voices=v)
    return v


def kokoro_speak(voice, text, speed=1.0):
    body = {'model': 'kokoro', 'input': text, 'voice': voice, 'response_format': 'wav', 'speed': speed}
    req = urllib.request.Request(KOKORO + '/v1/audio/speech', data=json.dumps(body).encode(), method='POST',
                                 headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(req, timeout=180) as r:
            data = r.read(200 << 20)
    except Exception as e:  # noqa: BLE001
        raise Fail('AI voices (Kokoro) didn\'t answer: %s' % e)
    try:
        with wave.open(io.BytesIO(data), 'rb') as w:
            pcm, sr, ch = w.readframes(w.getnframes()), w.getframerate(), w.getnchannels()
    except (wave.Error, EOFError):
        raise Fail('AI voices (Kokoro) sent something that isn\'t audio')
    if ch == 2:
        import array
        a = array.array('h')
        a.frombytes(pcm[:len(pcm) // 4 * 4])
        pcm = array.array('h', ((a[i] + a[i + 1]) // 2 for i in range(0, len(a), 2))).tobytes()
    return pcm, sr


# ------------------------------------------------------------------ the studio: voices, speech, jobs

def new_id():
    return secrets.token_hex(6)


def clean_name(s, fallback='Voice'):
    s = re.sub(r'[\x00-\x1f<>]', ' ', unicodedata.normalize('NFC', str(s or ''))).strip()
    return re.sub(r'\s+', ' ', s)[:60] or fallback


class Studio:
    def __init__(self, data=DATA, engines=None):
        self.data = data
        self.engines = engines or Engines(data)
        self.vdir = os.path.join(data, 'voices')
        self.jdir = os.path.join(data, 'jobs')
        self.pdir = os.path.join(data, 'presets')
        self.updir = os.path.join(data, 'uploads')
        for d in (self.vdir, self.jdir, self.pdir, self.updir):
            os.makedirs(d, mode=0o700, exist_ok=True)
        self.jlock = threading.RLock()
        self.wake = threading.Event()
        self.stop = threading.Event()
        self.cancel = set()
        self.current = None

    # ---- voices
    def voices(self):
        out = []
        for vid in sorted(os.listdir(self.vdir)):
            v = self.voice(vid)
            if v:
                out.append(v)
        return sorted(out, key=lambda v: -v.get('created', 0))

    def voice(self, vid):
        if not ID_RE.fullmatch(vid or ''):
            return None
        p = os.path.join(self.vdir, vid, 'voice.json')
        v = sio.load_json(p, {}, repair=False) if os.path.exists(p) else {}
        return v if isinstance(v, dict) and v.get('id') == vid else None

    def voice_save(self, v):
        d = os.path.join(self.vdir, v['id'])
        os.makedirs(d, mode=0o700, exist_ok=True)
        sio.write_json(os.path.join(d, 'voice.json'), v)
        return v

    def clone(self, clip, name, language='auto', ref_text='', consent=False, by=''):
        """A voice from a recording (any format ffmpeg reads): the clearest 3 to 20 seconds kept as its sample, the words
        said in it written down (when transcription is installed and you didn't type them)."""
        if not consent:
            raise Fail('Tick the box to confirm this is your voice, or you have the person\'s permission to copy it')
        vid = new_id()
        d = os.path.join(self.vdir, vid)
        os.makedirs(d, mode=0o700, exist_ok=True)
        try:
            ref = os.path.join(d, 'ref.wav')
            to_wav(clip, ref, SR, 1, dur=20.0)
            pcm, sr, _ = read_wav(ref)
            if secs(pcm, sr) < 2.5:
                raise Fail('That recording is too short: 5 to 15 seconds of one person talking works best')
            text = (ref_text or '').strip()[:500]
            if not text and self.engines.caps().get('transcribe'):
                try:
                    text = ' '.join(s['text'] for s in self.engines.transcribe(ref, language)['segments'])[:500]
                except Exception as e:  # noqa: BLE001 - the voice still works without the words
                    print('hearth-voice-studio: no transcript for the clip (%s)' % e, file=sys.stderr, flush=True)
            v = {'id': vid, 'name': clean_name(name), 'kind': 'clone', 'language': language if language in LANG_CODES else 'auto',
                 'refText': text, 'secs': round(secs(pcm, sr), 1), 'created': now(),
                 'consent': {'at': now(), 'by': (by or '')[:60], 'text': 'This is my voice, or I have permission to copy it'}}
            return self.voice_save(v)
        except BaseException:
            shutil.rmtree(d, ignore_errors=True)
            raise

    def design_preview(self, description, language='auto', text=''):
        parts = [x.strip() for x in str(description or '').lower().split(',') if x.strip()]
        known = [w for ws in DESIGN.values() for w in ws]
        # OmniVoice's own words (from the chips) as they are; anything else read as a description.
        instruct = ', '.join(parts) if parts and all(x in known for x in parts) else describe_to_instruct(description)
        if not instruct:
            raise Fail('Describe the voice with a few words: man or woman, how old, deep or high, an accent (for example "an old man with a deep British voice")')
        pcm, sr = self.engines.speak(text.strip()[:500] or SAMPLE_TEXT, instruct=instruct, language=language)
        return instruct, pcm, sr

    def design_save(self, name, description, language='auto', text=''):
        """A designed voice: one sample made from the description, kept so the voice stays the same person every time."""
        instruct, pcm, sr = self.design_preview(description, language, text)
        vid = new_id()
        d = os.path.join(self.vdir, vid)
        os.makedirs(d, mode=0o700, exist_ok=True)
        write_wav(os.path.join(d, 'ref.wav'), pcm, sr)
        return self.voice_save({'id': vid, 'name': clean_name(name, 'Designed voice'), 'kind': 'design', 'instruct': instruct,
                                'description': re.sub(r'[\x00-\x1f<>]', ' ', str(description or ''))[:200].strip(), 'language': language if language in LANG_CODES else 'auto',
                                'refText': (text.strip()[:500] or SAMPLE_TEXT), 'secs': round(secs(pcm, sr), 1), 'created': now()})

    def rename(self, vid, name):
        v = self.voice(vid)
        if not v:
            raise Fail('That voice isn\'t in your library')
        v['name'] = clean_name(name, v['name'])
        return self.voice_save(v)

    def delete_voice(self, vid):
        if not self.voice(vid):
            raise Fail('That voice isn\'t in your library')
        shutil.rmtree(os.path.join(self.vdir, vid), ignore_errors=True)
        # Your default voice is never changed here: if it was this one, speech uses the ready-made voice and the page says so.
        return {'deleted': vid, 'wasDefault': load().get('voice') == vid}

    def all_voices(self):
        """Every voice the studio and the API can use: yours, the ready-made ones, Kokoro's when it's on."""
        out = [{'id': v['id'], 'name': v['name'], 'kind': v['kind'], 'language': v.get('language', 'auto')} for v in self.voices()]
        out += [{'id': p['id'], 'name': p['name'], 'kind': 'preset', 'note': p['note']} for p in PRESETS]
        out += [{'id': 'kokoro:' + k, 'name': k + ' (Kokoro)', 'kind': 'kokoro'} for k in kokoro_voices()]
        return out

    def resolve(self, name, allow_auto=True):
        """A voice by its id or name (yours first), a ready-made voice, an OpenAI voice name, or a Kokoro voice."""
        n = str(name or '').strip()
        if not n or n.lower() in ('auto', 'default'):
            n = load().get('voice') or ''
            try:
                if n:
                    return self.resolve(n, allow_auto)
            except Fail:
                pass                    # your default voice was deleted: the ready-made one (the page says so)
            return {'kind': 'auto'} if allow_auto else self.resolve('narrator')
        if ID_RE.fullmatch(n) and self.voice(n):
            v = self.voice(n)
            v['ref'] = os.path.join(self.vdir, n, 'ref.wav')
            return v
        for v in self.voices():
            if v['name'].lower() == n.lower():
                v['ref'] = os.path.join(self.vdir, v['id'], 'ref.wav')
                return v
        low = n.lower()
        low = OPENAI_VOICES.get(low, low)
        for p in PRESETS:
            if p['id'] == low or p['name'].lower() == low:
                return dict(p, kind='preset')
        k = n[7:] if n.startswith('kokoro:') else n
        if k in kokoro_voices():
            return {'kind': 'kokoro', 'id': 'kokoro:' + k, 'voice': k}
        raise Fail('There\'s no voice called "%s" (GET /v1/audio/voices lists them)' % n[:60])

    def preset_ref(self, p, language='auto'):
        """A ready-made voice's sample, made once the first time it's used."""
        path = os.path.join(self.pdir, p['id'] + '.wav')
        if not os.path.exists(path):
            pcm, sr = self.engines.speak(SAMPLE_TEXT, instruct=p['instruct'], language='en')
            write_wav(path, pcm, sr)
        return path

    def say(self, text, voice, language='auto', speed=1.0, duration=None, instruct=None):
        """One piece of speech in VOICE (resolved): (pcm, rate)."""
        lang = language if language in LANG_CODES else 'auto'
        if voice['kind'] == 'kokoro':
            return kokoro_speak(voice['voice'], text, speed)
        if voice['kind'] == 'auto':
            return self.engines.speak(text, instruct=instruct, language=lang, speed=speed, duration=duration)
        if voice['kind'] == 'preset':
            if instruct:
                return self.engines.speak(text, instruct=instruct, language=lang, speed=speed, duration=duration)
            return self.engines.speak(text, ref=self.preset_ref(voice), ref_text=SAMPLE_TEXT, language=lang, speed=speed, duration=duration)
        if lang == 'auto' and voice.get('language') not in (None, 'auto'):
            lang = voice['language']
        return self.engines.speak(text, ref=voice['ref'], ref_text=voice.get('refText') or None, language=lang, speed=speed, duration=duration)

    def speak(self, text, voice='', language='auto', speed=1.0, fmt='wav', instruct=None):
        text = (text or '').strip()
        if not text:
            raise Fail('Type something to say first')
        if len(text) > MAX_SPEAK:
            raise Fail('That\'s a lot of text (%d characters): make it an audiobook instead, it narrates in the background' % len(text))
        if fmt not in FORMATS:
            raise Fail('response_format: one of ' + ', '.join(FORMATS))
        try:
            speed = min(2.0, max(0.5, float(speed or 1.0)))
        except (TypeError, ValueError):
            speed = 1.0
        v = self.resolve(voice)
        pcm, rate = bytearray(), SR
        pieces = chunks(text, 400 if v['kind'] == 'kokoro' else 280)
        for i, piece in enumerate(pieces):
            p, rate = self.say(piece, v, language, speed, instruct=instruct)
            pcm += p
            if i + 1 < len(pieces):
                pcm += silence(0.25, rate)
        return encode(wav_bytes(bytes(pcm), rate), fmt), FORMATS[fmt]

    def voice_preview(self, vid):
        """A voice's own sample (yours: what it learned from; ready-made: made once)."""
        if vid in PRESET_IDS:
            p = next(x for x in PRESETS if x['id'] == vid)
            return open(self.preset_ref(p), 'rb').read()
        v = self.voice(vid)
        if not v:
            raise Fail('That voice isn\'t in your library')
        return open(os.path.join(self.vdir, vid, 'ref.wav'), 'rb').read()

    # ---- jobs (audiobooks, dubbing, transcripts): a queue on disk
    def jpath(self, jid, *more):
        return os.path.join(self.jdir, jid, *more)

    def job(self, jid):
        if not ID_RE.fullmatch(jid or ''):
            return None
        p = self.jpath(jid, 'job.json')
        j = sio.load_json(p, {}, repair=False) if os.path.exists(p) else {}
        return j if isinstance(j, dict) and j.get('id') == jid else None

    def job_save(self, j):
        with self.jlock:
            j['updated'] = now()
            sio.write_json(self.jpath(j['id'], 'job.json'), j)
        return j

    def job_update(self, jid, **kw):
        with self.jlock:
            j = self.job(jid)
            if not j:
                return None
            j.update(kw)
            return self.job_save(j)

    def jobs(self):
        out = []
        for jid in os.listdir(self.jdir):
            j = self.job(jid)
            if j:
                out.append(self.job_view(j))
        return sorted(out, key=lambda j: -j.get('created', 0))

    def job_view(self, j):
        return {k: j.get(k) for k in ('id', 'kind', 'title', 'state', 'progress', 'step', 'created', 'updated', 'error', 'outputs', 'note',
                                      'summary')}

    def job_new(self, kind, title, params, prepare=None):
        jid = new_id()
        os.makedirs(self.jpath(jid), mode=0o700)
        j = {'id': jid, 'kind': kind, 'title': clean_name(title, kind.title()), 'state': 'queued', 'progress': 0, 'step': 'waiting its turn',
             'created': now(), 'params': params, 'outputs': [], 'error': ''}
        try:
            if prepare:
                prepare(self.jpath(jid), j)
            self.job_save(j)
        except BaseException:
            shutil.rmtree(self.jpath(jid), ignore_errors=True)
            raise
        self.wake.set()
        return self.job_view(j)

    def job_cancel(self, jid):
        j = self.job(jid)
        if not j:
            raise Fail('That job isn\'t there')
        if j['state'] in ('queued', 'running'):
            self.cancel.add(jid)
            if j['state'] == 'queued':
                self.job_update(jid, state='cancelled', step='cancelled')
        return {'cancelled': jid}

    def job_delete(self, jid):
        j = self.job(jid)
        if not j:
            raise Fail('That job isn\'t there')
        if j['state'] == 'running':
            raise Fail('Cancel it first (it\'s working right now)')
        shutil.rmtree(self.jpath(jid), ignore_errors=True)
        return {'deleted': jid}

    def job_retry(self, jid):
        j = self.job(jid)
        if not j or j['state'] not in ('failed', 'cancelled'):
            raise Fail('Only a job that failed or was cancelled can be tried again')
        self.cancel.discard(jid)
        self.job_update(jid, state='queued', step='waiting its turn', error='')
        self.wake.set()
        return {'queued': jid}

    def recover(self):
        """After a restart (Light mode stopped it for a game, the PC restarted): work that was running carries on."""
        n = 0
        for jid in os.listdir(self.jdir):
            j = self.job(jid)
            if j and j.get('state') == 'running':
                self.job_update(jid, state='queued', step='carrying on where it stopped', note='Carried on after Voice Studio restarted')
                n += 1
        return n

    def next_job(self):
        q = [j for j in (self.job(x) for x in os.listdir(self.jdir)) if j and j.get('state') == 'queued']
        return min(q, key=lambda j: j['created']) if q else None

    def work_once(self):
        """Run the oldest waiting job (one at a time). True when one ran."""
        j = self.next_job()
        if not j:
            return False
        jid = j['id']
        self.current = jid
        self.job_update(jid, state='running', step='starting', error='')

        def progress(pct, step=None):
            if self.stop.is_set():
                raise Paused()
            if jid in self.cancel:
                raise Cancelled()
            kw = {'progress': max(0, min(100, int(pct)))}
            if step is not None:
                kw['step'] = step
            self.job_update(jid, **kw)
        try:
            handler = {'audiobook': self.run_audiobook, 'dub': self.run_dub, 'transcribe': self.run_transcribe}[j['kind']]
            handler(self.job(jid), progress)
            self.job_update(jid, state='done', progress=100, step='done')
        except Cancelled:
            self.job_update(jid, state='cancelled', step='cancelled')
        except Paused:
            self.job_update(jid, state='queued', step='paused: carries on when Voice Studio is back')
        except Fail as e:
            self.job_update(jid, state='failed', error=str(e)[:400], step='stopped')
        except Exception as e:  # noqa: BLE001 - an engine's own error, in words
            print('hearth-voice-studio: job %s failed: %r' % (jid, e), file=sys.stderr, flush=True)
            self.job_update(jid, state='failed', error=('%s: %s' % (type(e).__name__, e))[:400], step='stopped')
        finally:
            self.cancel.discard(jid)
            self.current = None
        return True

    def worker(self):
        while not self.stop.is_set():
            try:
                ran = self.work_once()
            except Exception as e:  # noqa: BLE001 - the worker itself never dies
                print('hearth-voice-studio: worker: %r' % e, file=sys.stderr, flush=True)
                ran = False
            if not ran:
                self.engines.idle_check()
                self.wake.wait(5)
                self.wake.clear()

    def add_output(self, j, name, label, kind):
        outs = [o for o in j.get('outputs') or [] if o.get('file') != name]
        outs.append({'file': name, 'label': label, 'kind': kind, 'size': os.path.getsize(self.jpath(j['id'], name))})
        j['outputs'] = outs
        self.job_update(j['id'], outputs=outs)

    # ---- transcribe
    def new_transcribe(self, src, filename, language='auto', labels=None, task='transcribe'):
        labels = load()['speakerLabels'] if labels is None else labels

        def prep(d, j):
            ext = (filename.rsplit('.', 1)[-1].lower() if '.' in filename else 'bin')
            ext = ext if ext in AUDIO_EXT else 'bin'
            os.replace(src, os.path.join(d, 'input.' + ext))
            j['params']['input'] = 'input.' + ext
        return self.job_new('transcribe', filename.rsplit('.', 1)[0] or 'Recording', {'language': language, 'labels': bool(labels), 'task': task}, prep)

    def run_transcribe(self, j, progress):
        p = j['params']
        d = self.jpath(j['id'])
        if not self.engines.caps().get('transcribe'):
            raise Fail('Transcribing isn\'t installed (Settings › Home server › Voice Studio › Install)')
        progress(3, 'reading the audio')
        wav = os.path.join(d, 'audio.wav')
        if not os.path.exists(wav):
            to_wav(os.path.join(d, p['input']), wav, 16000, 1)
        progress(8, 'writing down what\'s said')
        r = self.engines.transcribe(wav, p.get('language'), p.get('task', 'transcribe'), p.get('labels'),
                                    lambda f: progress(8 + 88 * f, 'writing down what\'s said'))
        segs = r['segments']
        base = re.sub(r'[^\w\- ]+', '', j['title'])[:60].strip() or 'transcript'
        for ext, text in (('txt', to_text(segs)), ('srt', to_srt(segs)), ('vtt', to_vtt(segs)),
                          ('json', json.dumps(r, ensure_ascii=False, indent=1))):
            name = '%s.%s' % (base, ext)
            with open(os.path.join(d, name), 'w', encoding='utf-8') as f:
                f.write(text)
            self.add_output(self.job(j['id']), name, {'txt': 'Text', 'srt': 'Subtitles (SRT)', 'vtt': 'Subtitles (VTT)', 'json': 'Everything (JSON)'}[ext], ext)
        speakers = sorted({s['speaker'] for s in segs if s.get('speaker')})
        self.job_update(j['id'], summary={'language': r.get('language', ''), 'secs': round(r.get('duration') or 0), 'speakers': len(speakers),
                                          'preview': to_text(segs)[:600]})
        try:
            os.remove(wav)
        except OSError:
            pass

    # ---- audiobooks
    def new_audiobook(self, title, chapters, voice, language='auto', speed=1.0):
        if not chapters:
            raise Fail('There\'s no text to narrate')
        v = self.resolve(voice, allow_auto=False)
        vid = v.get('id') or 'narrator'

        def prep(d, j):
            with open(os.path.join(d, 'chapters.json'), 'w', encoding='utf-8') as f:
                json.dump(chapters, f, ensure_ascii=False)
            j['chapters'] = [{'title': c['title'], 'done': False, 'secs': 0} for c in chapters]
        words = sum(len(c['text'].split()) for c in chapters)
        return self.job_new('audiobook', title or chapters[0]['title'],
                            {'voice': vid, 'language': language, 'speed': speed, 'chapters': len(chapters), 'words': words}, prep)

    def run_audiobook(self, j, progress):
        p = j['params']
        d = self.jpath(j['id'])
        chapters = json.load(open(os.path.join(d, 'chapters.json'), encoding='utf-8'))
        state = j.get('chapters') or [{'title': c['title'], 'done': False, 'secs': 0} for c in chapters]
        voice = self.resolve(p['voice'], allow_auto=False)
        total = sum(len(c['text']) for c in chapters) or 1
        done_chars = sum(len(c['text']) for c, s in zip(chapters, state) if s.get('done'))
        mp3 = have('ffmpeg')
        tmp = os.path.join(d, 'tmp')
        os.makedirs(tmp, exist_ok=True)
        for i, (c, s) in enumerate(zip(chapters, state)):
            name = 'ch%03d.%s' % (i + 1, 'mp3' if mp3 else 'wav')
            if s.get('done') and os.path.exists(os.path.join(d, name)):
                continue
            pcm, rate = bytearray(), SR
            pieces = chunks(c['text'])
            for k, piece in enumerate(pieces):
                progress(2 + 88 * (done_chars + sum(len(x) for x in pieces[:k])) / total, 'chapter %d of %d: %s' % (i + 1, len(chapters), c['title'][:40]))
                part, rate = self.say(piece, voice, p.get('language', 'auto'), p.get('speed', 1.0))
                pcm += part + silence(0.3, rate)
            pcm = silence(0.6, rate) + bytes(pcm) + silence(1.2, rate)
            wav = os.path.join(tmp, 'ch.wav')
            write_wav(wav, pcm, rate)
            if mp3:
                code, _, err = run(['ffmpeg', '-nostdin', '-loglevel', 'error', '-y', '-i', wav, '-c:a', 'libmp3lame', '-q:a', '4',
                                    '-metadata', 'title=' + c['title'], '-metadata', 'album=' + j['title'], '-metadata', 'track=%d' % (i + 1),
                                    os.path.join(d, name + '.part.mp3')], 1800)
                if code != 0:
                    raise Fail('Couldn\'t make chapter %d\'s MP3: %s' % (i + 1, err.strip()[-200:]))
                os.replace(os.path.join(d, name + '.part.mp3'), os.path.join(d, name))
            else:
                os.replace(wav, os.path.join(d, name))
            s.update(done=True, secs=round(secs(pcm, rate), 2), file=name)
            done_chars += len(c['text'])
            self.job_update(j['id'], chapters=state)
            self.add_output(self.job(j['id']), name, '%d. %s' % (i + 1, c['title'][:60]), 'chapter')
        progress(92, 'putting the book together')
        base = re.sub(r'[^\w\- ]+', '', j['title'])[:60].strip() or 'audiobook'
        files = [s['file'] for s in state]
        zname = base + ' (chapters).zip'
        with zipfile.ZipFile(os.path.join(d, zname + '.part'), 'w', zipfile.ZIP_STORED) as z:
            for i, f in enumerate(files):
                z.write(os.path.join(d, f), '%03d - %s.%s' % (i + 1, re.sub(r'[^\w\- ]+', '', state[i]['title'])[:50].strip() or 'Chapter', f.rsplit('.', 1)[1]))
        os.replace(os.path.join(d, zname + '.part'), os.path.join(d, zname))
        self.add_output(self.job(j['id']), zname, 'Every chapter (zip)', 'zip')
        if mp3:
            meta = [';FFMETADATA1', 'title=' + j['title'].replace('=', '\\=').replace(';', '\\;'), 'genre=Audiobook']
            t = 0
            for s in state:
                ms = int(s['secs'] * 1000)
                meta += ['[CHAPTER]', 'TIMEBASE=1/1000', 'START=%d' % t, 'END=%d' % (t + ms), 'title=' + s['title'].replace('=', '\\=').replace(';', '\\;')]
                t += ms
            with open(os.path.join(tmp, 'meta.txt'), 'w', encoding='utf-8') as f:
                f.write('\n'.join(meta) + '\n')
            with open(os.path.join(tmp, 'list.txt'), 'w', encoding='utf-8') as f:
                f.write(''.join("file '%s'\n" % os.path.join(d, x).replace("'", "'\\''") for x in files))
            bname = base + '.m4b'
            code, _, err = run(['ffmpeg', '-nostdin', '-loglevel', 'error', '-y', '-f', 'concat', '-safe', '0', '-i', os.path.join(tmp, 'list.txt'),
                                '-i', os.path.join(tmp, 'meta.txt'), '-map_metadata', '1', '-map', '0:a', '-c:a', 'aac', '-b:a', '64k',
                                '-f', 'mp4', os.path.join(d, bname + '.part')], 7200)
            if code == 0:
                os.replace(os.path.join(d, bname + '.part'), os.path.join(d, bname))
                self.add_output(self.job(j['id']), bname, 'The whole book (m4b, with chapters)', 'book')
            else:
                print('hearth-voice-studio: m4b: %s' % err[-300:], file=sys.stderr, flush=True)
        shutil.rmtree(tmp, ignore_errors=True)
        self.job_update(j['id'], summary={'chapters': len(state), 'secs': round(sum(s['secs'] for s in state))})

    # ---- video dubbing
    def new_dub(self, src, filename, target, voice='clone', source='auto', keep_background=True, model=''):
        if target not in LANG_CODES or target == 'auto':
            raise Fail('Pick the language to dub into')
        if voice not in ('clone', ''):
            self.resolve(voice, allow_auto=False)
        ext = filename.rsplit('.', 1)[-1].lower() if '.' in filename else ''
        if ext not in VIDEO_EXT + AUDIO_EXT:
            raise Fail('That isn\'t a video Hearth can dub (mp4, mkv, mov, webm, avi)')

        def prep(d, j):
            os.replace(src, os.path.join(d, 'input.' + ext))
            j['params']['input'] = 'input.' + ext
        return self.job_new('dub', '%s (%s)' % (filename.rsplit('.', 1)[0] or 'Video', LANG_NAMES.get(target, target)),
                            {'target': target, 'source': source, 'voice': voice or 'clone', 'keepBackground': bool(keep_background),
                             'model': model or load().get('translateModel') or '', 'video': ext in VIDEO_EXT}, prep)

    def run_dub(self, j, progress):
        p = j['params']
        d = self.jpath(j['id'])
        f = lambda n: os.path.join(d, n)  # noqa: E731
        caps = self.engines.caps()
        if not caps.get('ffmpeg'):
            raise Fail('Dubbing needs ffmpeg on this PC')
        if not caps.get('transcribe') or not caps.get('speak'):
            raise Fail('Dubbing needs Voice Studio\'s engines (Settings › Home server › Voice Studio › Install)')
        src = f(p['input'])
        total = media_secs(src)
        if not os.path.exists(f('audio.wav')):
            progress(2, 'taking the sound out of the video')
            to_wav(src, f('audio.wav'), 44100, 2)
        bg = None
        if p.get('keepBackground') and caps.get('separate'):
            if not (os.path.exists(f('vocals.wav')) and os.path.exists(f('background.wav'))):
                progress(5, 'separating the voices from the music and sounds')
                self.engines.separate(f('audio.wav'), f('vocals.wav.tmp.wav'), f('background.wav.tmp.wav'))
                os.replace(f('background.wav.tmp.wav'), f('background.wav'))
                os.replace(f('vocals.wav.tmp.wav'), f('vocals.wav'))
            bg = f('background.wav')
        voices_src = f('vocals.wav') if os.path.exists(f('vocals.wav')) else f('audio.wav')
        if not os.path.exists(f('speech16.wav')):
            to_wav(voices_src, f('speech16.wav'), 16000, 1)
        if not os.path.exists(f('segments.json')):
            progress(15, 'writing down what\'s said')
            r = self.engines.transcribe(f('speech16.wav'), p.get('source'), 'transcribe', True,
                                        lambda x: progress(15 + 15 * x, 'writing down what\'s said'))
            with open(f('segments.json'), 'w', encoding='utf-8') as fh:
                json.dump(r, fh, ensure_ascii=False)
        r = json.load(open(f('segments.json'), encoding='utf-8'))
        segs = r['segments']
        if not segs:
            raise Fail('Nobody speaks in that video (no words were found to dub)')
        with open(f('original.srt'), 'w', encoding='utf-8') as fh:
            fh.write(to_srt(segs))
        if not os.path.exists(f('lines.json')):
            if (r.get('language') or '')[:2] == p['target']:
                texts, model = [s['text'] for s in segs], ''
            else:
                progress(31, 'translating into %s' % LANG_NAMES.get(p['target'], p['target']))
                texts, model = translate([s['text'] for s in segs], p['target'], p.get('model') or '')
            lines = [dict(s, src=s['text'], text=t) for s, t in zip(segs, texts)]
            with open(f('lines.json'), 'w', encoding='utf-8') as fh:
                json.dump({'lines': lines, 'model': model}, fh, ensure_ascii=False)
        lines = json.load(open(f('lines.json'), encoding='utf-8'))['lines']
        base = re.sub(r'[^\w\- ]+', '', j['title'])[:60].strip() or 'dubbed'
        with open(f(base + '.srt'), 'w', encoding='utf-8') as fh:
            fh.write(to_srt(lines))
        # The voice for each speaker: their own, learned from their clearest 6 to 14 seconds in the video, or the one you picked.
        refs, voice = {}, None
        if p.get('voice', 'clone') == 'clone':
            progress(36, 'learning each speaker\'s voice')
            by = {}
            for s in segs:
                by.setdefault(s.get('speaker') or 'Speaker 1', []).append(s)
            for who, ss in by.items():
                key = re.sub(r'\W+', '', who) or 'S1'
                ref = f('ref-%s.wav' % key)
                picked, got = [], 0.0
                for s in sorted(ss, key=lambda s: -(s['end'] - s['start'])):
                    if got >= 14:
                        break
                    picked.append(s)
                    got += s['end'] - s['start']
                picked.sort(key=lambda s: s['start'])
                if not os.path.exists(ref):
                    pcm = bytearray()
                    for s in picked:
                        piece = f('ref-piece.wav')
                        to_wav(voices_src, piece, SR, 1, start=s['start'], dur=min(14.0, s['end'] - s['start']))
                        pcm += read_wav(piece)[0] + silence(0.15)
                    write_wav(ref, bytes(pcm)[:int(15 * SR) * 2])
                refs[who] = {'kind': 'clone', 'ref': ref, 'refText': ' '.join(s['text'] for s in picked)[:500], 'language': r.get('language') or 'auto'}
        else:
            voice = self.resolve(p['voice'], allow_auto=False)
        os.makedirs(f('lines'), exist_ok=True)
        track = bytearray()
        tmp = f('tmp')
        os.makedirs(tmp, exist_ok=True)
        for i, ln in enumerate(lines):
            out = f('lines/%04d.wav' % i)
            nxt = lines[i + 1]['start'] if i + 1 < len(lines) else (total or ln['end'] + 2)
            slot = max(0.3, min(nxt - 0.05, ln['end'] + 0.6) - ln['start'])
            if not os.path.exists(out):
                progress(40 + 48 * i / len(lines), 'speaking line %d of %d' % (i + 1, len(lines)))
                v = refs.get(ln.get('speaker') or 'Speaker 1') or (next(iter(refs.values())) if refs else voice)
                pcm, rate = self.say(ln['text'], v, p['target'], duration=max(0.4, ln['end'] - ln['start']))
                if rate != SR:
                    write_wav(f('tmp/r.wav'), pcm, rate)
                    to_wav(f('tmp/r.wav'), f('tmp/r2.wav'), SR, 1)
                    pcm = read_wav(f('tmp/r2.wav'))[0]
                write_wav(out, fit(pcm, SR, slot, tmp))
            place(track, read_wav(out)[0], ln['start'])
        if total:
            n = int(total * SR) * 2
            track = track[:n] + b'\0' * max(0, n - len(track))
        write_wav(f('voice.wav'), bytes(track))
        progress(90, 'putting the video back together')
        video = p.get('video', True)
        outname = base + ('.mp4' if video else '.m4a')
        under = bg or f('audio.wav')
        vol = '1.0' if bg else '0.12'          # no separated background: the original quietly underneath
        cmd = ['ffmpeg', '-nostdin', '-loglevel', 'error', '-y', '-i', src, '-i', under, '-i', f('voice.wav'), '-filter_complex',
               '[1:a]volume=%s[b];[2:a]aresample=44100,volume=1.0[v];[b][v]amix=inputs=2:duration=first:normalize=0[a]' % vol]
        if video:
            cmd += ['-map', '0:v:0', '-map', '[a]', '-c:v', 'copy', '-c:a', 'aac', '-b:a', '160k', '-metadata:s:a:0', 'language=' + p['target'],
                    '-movflags', '+faststart', '-f', 'mp4', f(outname + '.part')]
        else:
            cmd += ['-map', '[a]', '-c:a', 'aac', '-b:a', '160k', '-f', 'mp4', f(outname + '.part')]
        code, _, err = run(cmd, 7200)
        if code != 0:
            raise Fail('Couldn\'t put the dubbed video together: %s' % err.strip()[-240:])
        os.replace(f(outname + '.part'), f(outname))
        jj = self.job(j['id'])
        self.add_output(jj, outname, 'Dubbed video' if video else 'Dubbed audio', 'video' if video else 'audio')
        self.add_output(self.job(j['id']), base + '.srt', 'Subtitles in %s (SRT)' % LANG_NAMES.get(p['target'], p['target']), 'srt')
        self.add_output(self.job(j['id']), 'original.srt', 'Original subtitles (SRT)', 'srt')
        self.job_update(j['id'], summary={'lines': len(lines), 'speakers': len(refs) or 1, 'from': r.get('language', ''), 'to': p['target'],
                                          'background': bool(bg)})
        # Done: the big in-between files go (the video you sent, the results and the subtitles stay).
        for n in ('audio.wav', 'speech16.wav', 'voice.wav', 'ref-piece.wav', 'vocals.wav', 'background.wav'):
            try:
                os.remove(f(n))
            except OSError:
                pass
        shutil.rmtree(tmp, ignore_errors=True)
        shutil.rmtree(f('lines'), ignore_errors=True)

    def state(self):
        s = load()
        caps = self.engines.caps()
        return {'caps': caps, 'voices': self.all_voices(), 'library': self.voices(), 'presets': PRESETS, 'languages': LANGS,
                'design': DESIGN, 'jobs': self.jobs(), 'settings': s, 'host': socket.gethostname().split('.')[0],
                'models': ollama_models(), 'port': PORT}


