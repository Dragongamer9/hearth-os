FAILS = {}
FAIL_LOCK = threading.Lock()


def too_many(ip, t=None):
    t = time.time() if t is None else t
    with FAIL_LOCK:
        f = [x for x in FAILS.get(ip, []) if t - x < 300]
        FAILS[ip] = f
        return len(f) >= 5


def failed(ip):
    with FAIL_LOCK:
        FAILS.setdefault(ip, []).append(time.time())


def multipart(body, ctype):
    """multipart/form-data (what OpenAI's clients send for transcriptions): {name: (filename or None, bytes)}."""
    from email.parser import BytesParser
    from email.policy import HTTP
    msg = BytesParser(policy=HTTP).parsebytes(b'Content-Type: ' + ctype.encode('latin-1') + b'\r\nMIME-Version: 1.0\r\n\r\n' + body)
    out = {}
    if not msg.is_multipart():
        return out
    for part in msg.iter_parts():
        name = part.get_param('name', header='content-disposition')
        if name:
            out[name] = (part.get_filename(), part.get_payload(decode=True) or b'')
    return out


def page_html(embed=None):
    p = os.path.join(HERE, 'voice-studio-web.html')
    try:
        text = open(p, encoding='utf-8').read()
    except OSError:
        text = '<!doctype html><title>Voice Studio</title><p>The page is missing.'
    data = json.dumps(embed).replace('</', '<\\/') if embed is not None else 'null'
    return text.replace('/*HEARTH_DATA*/null', data).replace('{{HOST}}', html.escape(socket.gethostname().split('.')[0]))


def make_handler(studio, mock=False):
    from http.server import BaseHTTPRequestHandler

    class H(BaseHTTPRequestHandler):
        server_version = 'Hearth'
        sys_version = ''

        def log_message(self, fmt, *args):  # noqa: D401
            pass

        def send(self, code, body, ctype='application/json', extra=()):
            data = body if isinstance(body, bytes) else (json.dumps(body) if ctype == 'application/json' else body).encode()
            self.send_response(code)
            self.send_header('Content-Type', ctype + ('; charset=utf-8' if ctype.startswith(('text/', 'application/json')) else ''))
            self.send_header('Content-Length', str(len(data)))
            self.send_header('Cache-Control', 'no-store')
            self.send_header('X-Frame-Options', 'DENY')
            self.send_header('X-Content-Type-Options', 'nosniff')
            # same-origin, never no-referrer: with no-referrer browsers send "Origin: null" on every POST (Server mode 1.6).
            self.send_header('Referrer-Policy', 'same-origin')
            self.send_header('Permissions-Policy', 'microphone=(self), camera=()')
            self.send_header('Content-Security-Policy', "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
                             "img-src data:; media-src 'self' blob:; connect-src 'self'; form-action 'none'; frame-ancestors 'none'")
            for k, v in extra:
                self.send_header(k, v)
            self.end_headers()
            if self.command != 'HEAD':
                self.wfile.write(data)

        def err(self, code, text, **more):
            return self.send(code, dict({'error': {'message': text, 'type': 'hearth'}} if self.path.startswith('/v1/') else {'error': text}, **more))

        def ip(self):
            return self.client_address[0]

        def cookie(self):
            for part in (self.headers.get('Cookie') or '').split(';'):
                k, _, v = part.strip().partition('=')
                if k == 'hvs':
                    return v
            return ''

        def length(self):
            try:
                return int(self.headers.get('Content-Length') or 0)
            except ValueError:
                return -1

        def body_json(self):
            n = self.length()
            if n <= 0 or n > MAX_JSON:
                return None
            try:
                v = json.loads(self.rfile.read(n).decode('utf-8'))
                return v if isinstance(v, dict) else None
            except (ValueError, UnicodeDecodeError):
                return None

        def body_bytes(self, limit):
            n = self.length()
            if n <= 0:
                raise Fail('Nothing was sent')
            if n > limit:
                self.close_connection = True
                raise Fail('That file is too big (up to %d MB)' % (limit >> 20))
            return self.rfile.read(n)

        def body_file(self, limit):
            """The request's body streamed into a file of its own (videos can be gigabytes)."""
            n = self.length()
            if n <= 0:
                raise Fail('Nothing was sent')
            if n > limit:
                self.close_connection = True
                raise Fail('That file is too big (up to %d GB)' % max(1, limit >> 30))
            fd, path = tempfile.mkstemp(dir=studio.updir)
            try:
                with os.fdopen(fd, 'wb') as fh:
                    left = n
                    while left > 0:
                        b = self.rfile.read(min(1 << 20, left))
                        if not b:
                            raise Fail('The upload stopped part way')
                        fh.write(b)
                        left -= len(b)
                return path
            except BaseException:
                try:
                    os.remove(path)
                except OSError:
                    pass
                raise

        def query(self):
            q = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
            return {k: v[0] for k, v in q.items()}

        def guard(self):
            if not peer_allowed(self.ip()):
                self.send(403, {'error': 'Only on this PC and over Tailscale'})
                return False
            return True

        def access(self, write):
            """Who's asking: the page (signed in with the PIN; writes only from the page itself) or an app (the API key)."""
            if key_ok(self.headers.get('Authorization')):
                return True
            if session_ok(self.cookie()):
                if write and not write_allowed(self.headers):
                    self.err(403, 'Your browser didn\'t send this from the page itself, so the PC refused it. Reload the page and try again')
                    return False
                return True
            if self.headers.get('Authorization'):
                self.err(401, 'That API key isn\'t right: copy it again from Settings › Home server › Voice Studio')
            elif self.path.startswith('/v1/'):
                self.err(401, 'This needs Voice Studio\'s API key (Authorization: Bearer ...): it\'s in Settings › Home server › Voice Studio')
            else:
                self.err(401, 'Type the PIN' if pin_hashes() else 'No PIN is set yet: set one in Settings › Home server › Voice Studio (or Server mode)',
                         pin=bool(pin_hashes()))
            return False

        def do_HEAD(self):  # noqa: N802
            self.do_GET()

        def do_GET(self):  # noqa: N802
            if not self.guard():
                return
            path = urllib.parse.urlsplit(self.path).path
            try:
                if path == '/':
                    return self.send(200, page_html(), 'text/html')
                if path in ('/health', '/v1/health'):
                    return self.send(200, {'status': 'ok', 'engines': studio.engines.caps()})
                if not self.access(False):
                    return
                if path == '/api/state':
                    return self.send(200, studio.state())
                if path == '/api/jobs':
                    return self.send(200, {'jobs': studio.jobs()})
                m = re.fullmatch(r'/api/jobs/([a-f0-9]{12})', path)
                if m:
                    j = studio.job(m.group(1))
                    return self.send(200, studio.job_view(j)) if j else self.err(404, 'That job isn\'t there')
                m = re.fullmatch(r'/api/jobs/([a-f0-9]{12})/files/([^/]{1,200})', path)
                if m:
                    j = studio.job(m.group(1))
                    name = urllib.parse.unquote(m.group(2))
                    if not j or name not in [o['file'] for o in j.get('outputs') or []]:
                        return self.err(404, 'That file isn\'t there')
                    data = open(studio.jpath(j['id'], name), 'rb').read()
                    ext = name.rsplit('.', 1)[-1].lower()
                    ctype = {'mp3': 'audio/mpeg', 'wav': 'audio/wav', 'm4b': 'audio/mp4', 'm4a': 'audio/mp4', 'mp4': 'video/mp4', 'zip': 'application/zip',
                             'srt': 'text/plain', 'vtt': 'text/vtt', 'txt': 'text/plain', 'json': 'application/octet-stream'}.get(ext, 'application/octet-stream')
                    disp = 'inline' if self.query().get('play') == '1' else 'attachment'
                    return self.send(200, data, ctype, [('Content-Disposition', "%s; filename*=UTF-8''%s" % (disp, urllib.parse.quote(name)))])
                m = re.fullmatch(r'/api/voices/([a-z0-9]{1,16})/preview', path)
                if m:
                    return self.send(200, studio.voice_preview(m.group(1)), 'audio/wav')
                if path == '/v1/models':
                    ids = ['hearth-voice-studio', 'tts-1', 'tts-1-hd', 'gpt-4o-mini-tts', 'whisper-1', 'omnivoice']
                    return self.send(200, {'object': 'list', 'data': [{'id': i, 'object': 'model', 'created': 0, 'owned_by': 'hearth'} for i in ids]})
                if path in ('/v1/audio/voices', '/v1/voices'):
                    return self.send(200, {'voices': [{'id': v['id'], 'name': v['name'], 'kind': v['kind'], 'language': v.get('language', '')}
                                                      for v in studio.all_voices()]})
                return self.err(404, 'Not here')
            except Fail as e:
                return self.err(400, str(e))

        def do_POST(self):  # noqa: N802
            if not self.guard():
                return
            path = urllib.parse.urlsplit(self.path).path
            ip = self.ip()
            try:
                if path == '/api/login':
                    if not write_allowed(self.headers):
                        return self.err(403, 'Reload the page and type the PIN again')
                    if too_many(ip):
                        return self.err(429, 'Five wrong PINs in a row: wait 5 minutes, then try again')
                    b = self.body_json()
                    hs = pin_hashes()
                    if not hs:
                        return self.err(403, 'No PIN is set yet: set one in Settings › Home server › Voice Studio (or Server mode)', pin=False)
                    if not isinstance(b, dict) or not pin_clean(b.get('pin')):
                        return self.err(400, 'The PIN is 4 to 12 digits')
                    if not pin_check(b.get('pin'), hs[0][0]):
                        failed(ip)
                        print('hearth-voice-studio: a wrong PIN from %s' % ip, file=sys.stderr, flush=True)
                        return self.err(401, 'That PIN isn\'t right' + (' (it\'s Server mode\'s PIN)' if hs[0][1] == 'server' else ''))
                    tok = session_new('This PC' if ip.startswith('127.') else ip)
                    return self.send(200, {'ok': True}, extra=[('Set-Cookie', 'hvs=%s; Path=/; Max-Age=%d; HttpOnly; SameSite=Strict' % (tok, SESSION_DAYS * 86400))])
                if not self.access(True):
                    return
                if path == '/api/logout':
                    session_end(self.cookie())
                    return self.send(200, {'ok': True}, extra=[('Set-Cookie', 'hvs=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict')])
                # ---- speak, design
                if path in ('/api/speak', '/v1/audio/speech'):
                    b = self.body_json()
                    if b is None:
                        return self.err(400, 'Send JSON: {"input": "...", "voice": "..."}')
                    text = b.get('input') if 'input' in b else b.get('text')
                    fmt = str(b.get('response_format') or b.get('format') or ('mp3' if path.startswith('/v1/') else 'wav')).lower()
                    instruct = describe_to_instruct(b.get('instructions')) if b.get('instructions') else None
                    data, ctype = studio.speak(text, b.get('voice') or '', b.get('language') or 'auto', b.get('speed') or 1.0, fmt, instruct or None)
                    return self.send(200, data, ctype)
                if path == '/api/design/preview':
                    b = self.body_json() or {}
                    instruct, pcm, sr = studio.design_preview(b.get('description'), b.get('language') or 'auto', b.get('text') or '')
                    return self.send(200, wav_bytes(pcm, sr), 'audio/wav', [('X-Instruct', instruct)])
                if path == '/api/voices/design':
                    b = self.body_json() or {}
                    return self.send(200, studio.design_save(b.get('name'), b.get('description'), b.get('language') or 'auto', b.get('text') or ''))
                if path == '/api/voices/clone':
                    q = self.query()
                    clip = self.body_file(MAX_CLIP)
                    try:
                        v = studio.clone(clip, q.get('name'), q.get('language') or 'auto', q.get('text') or '', q.get('consent') == '1',
                                         'This PC' if ip.startswith('127.') else ip)
                    finally:
                        try:
                            os.remove(clip)
                        except OSError:
                            pass
                    return self.send(200, v)
                m = re.fullmatch(r'/api/voices/([a-f0-9]{12})/(rename|delete)', path)
                if m:
                    if m.group(2) == 'delete':
                        return self.send(200, studio.delete_voice(m.group(1)))
                    b = self.body_json() or {}
                    return self.send(200, studio.rename(m.group(1), b.get('name')))
                if path == '/api/settings':
                    b = self.body_json() or {}
                    changed = {}
                    for k, v in b.items():
                        raw = ('on' if v else 'off') if isinstance(v, bool) else str(v)
                        changed[k] = set_key(k, raw)
                    return self.send(200, {'changed': changed, 'settings': load()})
                # ---- the queue
                if path == '/api/jobs/transcribe':
                    q = self.query()
                    src = self.body_file(MAX_AUDIO)
                    labels = None if 'labels' not in q else q.get('labels') == '1'
                    return self.send(202, studio.new_transcribe(src, q.get('name') or 'recording', q.get('language') or 'auto', labels))
                if path == '/api/jobs/audiobook':
                    q = self.query()
                    ctype = (self.headers.get('Content-Type') or '').split(';')[0].strip().lower()
                    if ctype == 'application/json':
                        b = self.body_json() or {}
                        title = clean_name(b.get('title'), '')
                        chs = split_chapters(str(b.get('text') or ''), title)
                        q = dict(q, **{k: str(b.get(k)) for k in ('voice', 'language', 'speed') if b.get(k) is not None})
                    else:
                        name = q.get('name') or 'book.txt'
                        raw = self.body_bytes(MAX_BOOK)
                        title = clean_name(q.get('title') or name.rsplit('.', 1)[0], 'Audiobook')
                        if name.lower().endswith('.epub'):
                            fd, tmpp = tempfile.mkstemp(dir=studio.updir)
                            with os.fdopen(fd, 'wb') as fh:
                                fh.write(raw)
                            try:
                                bt, chs = epub_chapters(tmpp)
                            finally:
                                os.remove(tmpp)
                            title = clean_name(q.get('title') or bt or title, 'Audiobook')
                        else:
                            chs = split_chapters(raw.decode('utf-8', 'replace'), title)
                    try:
                        speed = min(2.0, max(0.5, float(q.get('speed') or 1.0)))
                    except ValueError:
                        speed = 1.0
                    return self.send(202, studio.new_audiobook(title, chs, q.get('voice') or '', q.get('language') or 'auto', speed))
                if path == '/api/jobs/dub':
                    q = self.query()
                    src = self.body_file(MAX_VIDEO)
                    try:
                        j = studio.new_dub(src, q.get('name') or 'video.mp4', q.get('target') or '', q.get('voice') or 'clone', q.get('source') or 'auto',
                                           q.get('keepBackground', '1') == '1', q.get('model') or '')
                    except BaseException:
                        if os.path.exists(src):
                            os.remove(src)
                        raise
                    return self.send(202, j)
                m = re.fullmatch(r'/api/jobs/([a-f0-9]{12})/(cancel|delete|retry)', path)
                if m:
                    return self.send(200, {'cancel': studio.job_cancel, 'delete': studio.job_delete, 'retry': studio.job_retry}[m.group(2)](m.group(1)))
                # ---- OpenAI-compatible transcription
                if path in ('/v1/audio/transcriptions', '/v1/audio/translations'):
                    ctype = self.headers.get('Content-Type') or ''
                    if not ctype.lower().startswith('multipart/form-data'):
                        return self.err(400, 'Send multipart/form-data with a "file"')
                    form = multipart(self.body_bytes(200 << 20), ctype)
                    fname, data = form.get('file', (None, b''))
                    if not data:
                        return self.err(400, 'No "file" in the form')
                    if not studio.engines.caps().get('transcribe'):
                        return self.err(503, 'Transcribing isn\'t installed (Settings › Home server › Voice Studio)')
                    get = lambda k, d='': (form.get(k, (None, b''))[1] or d.encode()).decode('utf-8', 'replace').strip()  # noqa: E731
                    rf = get('response_format', 'json')
                    with tempfile.TemporaryDirectory(dir=studio.updir) as td:
                        src = os.path.join(td, 'in.' + ((fname or 'a.bin').rsplit('.', 1)[-1].lower()[:5] or 'bin'))
                        with open(src, 'wb') as fh:
                            fh.write(data)
                        wav = to_wav(src, os.path.join(td, 'a.wav'), 16000, 1)
                        r = studio.engines.transcribe(wav, get('language') or None, 'translate' if path.endswith('translations') else 'transcribe',
                                                      get('speaker_labels') in ('1', 'true'))
                    segs = r['segments']
                    text = ' '.join(s['text'] for s in segs).strip()
                    if rf == 'text':
                        return self.send(200, text + '\n', 'text/plain')
                    if rf == 'srt':
                        return self.send(200, to_srt(segs), 'text/plain')
                    if rf == 'vtt':
                        return self.send(200, to_vtt(segs), 'text/vtt')
                    if rf == 'verbose_json':
                        return self.send(200, {'task': 'translate' if path.endswith('translations') else 'transcribe', 'language': r['language'],
                                               'duration': r['duration'], 'text': text,
                                               'segments': [dict(s, id=i) for i, s in enumerate(segs)]})
                    return self.send(200, {'text': text})
                return self.err(404, 'Not here')
            except Fail as e:
                return self.err(400, str(e))

    return H


def make_servers(studio, addrs, port, mock=False):
    from http.server import ThreadingHTTPServer
    handler = make_handler(studio, mock)
    servers = []
    for a in addrs:
        try:
            srv = ThreadingHTTPServer((a, port), handler)
        except OSError as e:
            print('hearth-voice-studio: can\'t listen on %s:%d (%s)' % (a, port, e), file=sys.stderr, flush=True)
            continue
        srv.daemon_threads = True
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        servers.append(srv)
    return servers


def serve(mock=False, port=None, addrs=None):
    studio = Studio(DATA, MockEngines(DATA) if mock else Engines(DATA))
    n = studio.recover()
    if n:
        print('hearth-voice-studio: carrying on with %d job(s)' % n, file=sys.stderr, flush=True)
    api_key()                       # made the first time, so Settings can show it
    addrs = addrs or (['127.0.0.1'] if mock else listen_addresses())
    servers = make_servers(studio, addrs, port or PORT, mock)
    if not servers:
        return 1
    w = threading.Thread(target=studio.worker, daemon=True)
    w.start()

    def stop(signum, frame):
        # Light mode (a game started) or Settings: the job running now is put back in the queue, carried on next time.
        studio.stop.set()
        studio.wake.set()
        w.join(25)
        for s in servers:
            s.shutdown()
        sys.exit(0)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    print('hearth-voice-studio: on %s, port %d' % (', '.join(addrs), port or PORT), file=sys.stderr, flush=True)
    while True:
        time.sleep(60)
        if not mock and len(addrs) == 1 and len(listen_addresses()) > 1:
            studio.stop.set()
            w.join(25)
            return 75           # Tailscale came up after we started: systemd starts us again, now on its address too


