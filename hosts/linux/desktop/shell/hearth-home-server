LINK_DAYS = (1, 7, 30, 0)


def links_secrets():
    v = sio.load_json(LINKS_STATE, {}, repair=False) if os.path.exists(LINKS_STATE) else {}
    return v if isinstance(v, dict) else {}


def links_change(fn):
    out = {}

    def change(d):
        cur = d.get('links') if isinstance(d.get('links'), list) else []
        new = fn([dict(x) for x in cur if isinstance(x, dict)])
        if new is not None:
            d['links'] = new
            out['links'] = new
    sio.update_json(SETTINGS, change)
    return out.get('links')


def in_a_share(path, data=None):
    """The share a path is in (a share that's on), or None. Links and searches only ever reach inside your shares."""
    data = load() if data is None else data
    real = os.path.realpath(path or '')
    for s in data['shares']:
        if s.get('on', True) is False or not s.get('path'):
            continue
        base = os.path.realpath(s['path'])
        if real == base or real.startswith(base + os.sep):
            rel = os.path.relpath(real, base)
            if rel != '.' and any(p.startswith('.') for p in rel.split(os.sep)):
                return None
            return s
    return None


def link_add(req):
    """A share link to a file or folder inside one of your shares: for whom (a note), how long (1, 7 or 30 days, or until
    you stop it), an optional password, an optional most downloads. The link's secret part and the password's hash are
    kept in a 0600 state file, never in home-server.json."""
    if not isinstance(req, dict):
        raise Fail('The request must be a JSON object')
    data = load()
    path = os.path.realpath(req.get('path') or '')
    if not os.path.exists(path) or not in_a_share(path, data):
        raise Fail('Pick a file or folder inside one of your shared folders')
    days = req.get('days', 7)
    if days not in LINK_DAYS:
        raise Fail('1, 7 or 30 days, or 0 for until you stop it')
    mx = req.get('max', 0)
    if not isinstance(mx, int) or not 0 <= mx <= 1000:
        raise Fail('Most downloads: 0 (no limit) to 1000')
    who = re.sub(r'[\x00-\x1f<>"\\]', '', str(req.get('for') or ''))[:40]
    pw = req.get('password') or ''
    if pw and len(pw) < 6:
        raise Fail('A link\'s password needs at least 6 characters')
    lid = secrets.token_hex(6)
    token = secrets.token_urlsafe(18)
    now = int(time.time() * 1000)
    item = {'id': lid, 'path': path, 'label': os.path.basename(path) or path, 'for': who, 'at': now,
            'expires': now + days * DAY_MS if days else 0, 'pw': bool(pw), 'max': mx, 'on': True}
    sec = links_secrets()
    sec[lid] = {'token': token, 'hash': pw_hash(pw) if pw else '', 'count': 0}
    secret_write(LINKS_STATE, sec)
    links_change(lambda links: links + [item])
    res = dict(item, token=token)
    res.update(web_apply())
    return res


def link_remove(lid):
    gone = {}

    def fn(links):
        keep = [x for x in links if x.get('id') != lid]
        if len(keep) == len(links):
            return None
        gone.update(next(x for x in links if x.get('id') == lid))
        return keep
    links_change(fn)
    if not gone:
        raise Fail('That link isn\'t there anymore')
    sec = links_secrets()
    if sec.pop(lid, None) is not None:
        secret_write(LINKS_STATE, sec)
    res = {'removed': gone.get('label'), 'filesKept': True}
    res.update(web_apply())
    return res


