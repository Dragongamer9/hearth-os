def listening():
    """What listens on this PC and where: every address, this PC only, or the Tailscale address."""
    out = []
    try:
        p = subprocess.run(['ss', '-Htlnu'], capture_output=True, text=True, timeout=5)
        lines = (p.stdout or '').splitlines()
    except (OSError, subprocess.SubprocessError):
        lines = []
    seen = set()
    for line in lines:
        cols = line.split()
        if len(cols) < 5:
            continue
        proto = cols[0]
        addr, _, port = cols[4].rpartition(':')
        addr = addr.strip('[]').split('%')[0]
        if not port.isdigit():
            continue
        port = int(port)
        where = 'local' if addr in ('127.0.0.1', '::1') or addr.startswith('127.') else \
                'tailscale' if addr.startswith('100.') or addr.lower().startswith('fd7a:115c:a1e0') else 'all'
        key = (port, where)
        if key in seen or port in (53, 5355) and where == 'local':
            continue
        seen.add(key)
        if port in KNOWN_PORTS or where != 'local':
            out.append({'port': port, 'proto': 'udp' if proto.startswith('udp') else 'tcp', 'where': where,
                        'what': KNOWN_PORTS.get(port, 'Something else')})
    out.sort(key=lambda x: (x['where'] == 'local', x['port']))
    return out


def smb_hardened():
    """Samba's own config: SMB3 or newer and no guests (the image's and Hearth's)."""
    def live(path):
        with open(path) as f:
            return '\n'.join(re.sub(r'\s+', ' ', l.strip().lower()) for l in f if l.strip() and not l.lstrip().startswith(('#', ';')))
    try:
        text = live('/etc/samba/smb.conf')
    except OSError:
        return {'known': False}
    ours = ''
    try:
        ours = live('/etc/samba/hearth-home-server.conf')
    except OSError:
        pass
    both = text + '\n' + ours
    return {'known': True, 'smb3': 'server min protocol = smb3' in both, 'noGuests': 'map to guest = never' in both and 'guest ok = yes' not in both}


