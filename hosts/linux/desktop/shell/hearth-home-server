def ai_run(kind):
    """hearth-comfyui.service / hearth-kokoro.service: becomes ComfyUI or Kokoro's container (exec), on 127.0.0.1 and
    the Tailscale address only. Where it listens is noted in your runtime folder for the page."""
    if kind not in AI_UNITS:
        raise Fail('comfyui or kokoro')
    addrs = ai_listen()
    rt = os.path.join(os.environ.get('XDG_RUNTIME_DIR') or tempfile.gettempdir(), 'hearth-home-server')
    try:
        os.makedirs(rt, mode=0o700, exist_ok=True)
        sio.merge_json(os.path.join(rt, 'home-ai-run.json'), {kind: {'listen': addrs, 'at': int(time.time())}})
    except OSError:
        pass
    if kind == 'comfyui':
        d = comfy_dir()
        if not comfy_installed(d):
            raise Fail('ComfyUI isn\'t installed in ~/ComfyUI')
        argv = [os.path.join(d, 'venv', 'bin', 'python'), os.path.join(d, 'main.py'), '--listen', ','.join(addrs), '--port', str(COMFY_PORT)]
        os.chdir(d)
        os.execv(argv[0], argv)
        return {}
    ref = kokoro_ref()
    if not ref:
        raise Fail('Kokoro\'s image isn\'t pinned in this Hearth version')
    argv = ['podman', 'run', '--rm', '--replace', '--name', KOKORO_NAME, '--pull=never', '--cap-drop=all',
            '--security-opt', 'no-new-privileges']
    for a in addrs:
        argv += ['-p', '%s:%d:%d' % (a, KOKORO_PORT, KOKORO_PORT)]
    argv.append(ref)
    os.execvp('podman', argv)
    return {}


def user_app_switch(name, on):
    """Your own service on or off now (and its timer, which starts it a minute after you sign in). Off deletes nothing."""
    unit, timer = AI_UNITS[name], AI_TIMERS[name]
    if on:
        installed = comfy_installed() if name == 'comfyui' else kokoro_installed()
        if not installed:
            return 'not installed'
        cmd(['systemctl', '--user', 'enable', timer], 30)
        cmd(['systemctl', '--user', 'restart', unit], 30)
        return 'on'
    cmd(['systemctl', '--user', 'disable', timer], 30)
    cmd(['systemctl', '--user', 'stop', unit], 60)
    return 'off'


