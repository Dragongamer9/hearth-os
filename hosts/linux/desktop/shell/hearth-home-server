    host = socket.gethostname().split('.')[0]
    try:
        tss = ts_status()
    except Fail:
        tss = {'installed': False}
    ts_name = tss.get('dns') if tss.get('state') == 'Running' else ''
    shares = []
    try:
        mod = root_mod()
    except Fail:
        mod = None
    for s in data['shares']:
        s = dict(s)
        s.setdefault('on', True)
        s.setdefault('reach', 'home')
        s.setdefault('recycle', True)
        s['there'] = os.path.isdir(s.get('path', ''))
        snap = mod.snap_info(s['path']) if mod and s['there'] else {'ok': False, 'why': 'The folder isn\'t there (is its drive plugged in?)'}
        s['snapOk'] = snap['ok']
        s['snapWhy'] = snap.get('why', '')
        s['how'] = how_to_open(host, s, ts_name)
        shares.append(s)
    tools = {k: bool(shutil.which(b) or os.path.exists(p)) for k, b, p in (
        ('samba', 'smbd', '/usr/sbin/smbd'), ('tailscale', 'tailscale', '/usr/bin/tailscale'), ('smartctl', 'smartctl', '/usr/sbin/smartctl'),
        ('btrfs', 'btrfs', '/usr/bin/btrfs'), ('qrencode', 'qrencode', '/usr/bin/qrencode'), ('nft', 'nft', '/usr/sbin/nft'),
        ('restic', 'restic', '/usr/bin/restic'), ('rclone', 'rclone', '/usr/bin/rclone'), ('syncthing', 'syncthing', '/usr/bin/syncthing'),
        ('hdparm', 'hdparm', '/usr/sbin/hdparm'), ('nut', 'upsmon', '/usr/sbin/upsmon'))}
    # A UPS plugged in shows its items (hide-until-seen); seeing one is state, never a setting.
    ups = ups_found()
    last_ups = (sio.load_json(SEEN, {}, repair=False).get('ups') or {}) if os.path.exists(SEEN) else {}
    if ups and (not isinstance(last_ups, dict) or time.time() * 1000 - last_ups.get('at', 0) > 3600000):
        try:
            mark_seen('ups', ups)
        except (Fail, OSError):
            pass
    items = [{'id': 'ai', 'needs': 'commandCenter'}, {'id': 'cameras', 'needs': 'camera'}, {'id': 'ups', 'needs': 'ups'}]
    _, hidden_count = visible_items(items, data)
    alerts = sio.load_json(ALERT_STATE, {}, repair=False) if os.path.exists(ALERT_STATE) else {}
    power = sio.load_json(POWER_STATE, {}, repair=False) if os.path.exists(POWER_STATE) else {}
    return {'settings': data, 'file': SETTINGS, 'user': user, 'host': host, 'shares': shares, 'tools': tools,
            'usage': fs_usage([s['path'] for s in shares if s['there'] and s['on']]),
            'applied': sio.load_json(APPLIED, {}, repair=False), 'tailscale': tss, 'seen': seen_state(data), 'hiddenCount': hidden_count,
            'playing': bool(mod and mod.game_running()), 'wired': wired_cards(), 'helper': os.path.exists(ROOT_HELPER),
            'people': accounts_state(data['people']), 'backups': backups_state(data), 'alerts': alerts, 'power': power,
            'ups': ups, 'resumed': resumed()}


