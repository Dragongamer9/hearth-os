WSD_PROBE = ('<?xml version="1.0" encoding="UTF-8"?><e:Envelope xmlns:e="http://www.w3.org/2003/05/soap-envelope" '
             'xmlns:w="http://schemas.xmlsoap.org/ws/2004/08/addressing" xmlns:d="http://schemas.xmlsoap.org/ws/2005/04/discovery" '
             'xmlns:dn="http://www.onvif.org/ver10/network/wsdl"><e:Header><w:MessageID>uuid:%s</w:MessageID>'
             '<w:To e:mustUnderstand="true">urn:schemas-xmlsoap-org:ws:2005:04:discovery</w:To>'
             '<w:Action e:mustUnderstand="true">http://schemas.xmlsoap.org/ws/2005/04/discovery/Probe</w:Action></e:Header>'
             '<e:Body><d:Probe><d:Types>dn:NetworkVideoTransmitter</d:Types></d:Probe></e:Body></e:Envelope>')


def parse_wsd(xml):
    """A camera's answer to the probe: its web addresses (XAddrs) and the name it gives (ONVIF scopes)."""
    addrs = re.findall(r'<[^>]*XAddrs>([^<]+)<', xml or '')
    urls = [u for a in addrs for u in a.split() if re.fullmatch(r'https?://[A-Za-z0-9.\-\[\]:]+(/[^\s<>"]*)?', u)]
    scopes = ' '.join(re.findall(r'<[^>]*Scopes>([^<]+)<', xml or ''))
    name = ''
    for key in ('name', 'hardware'):
        m = re.search(r'onvif://www\.onvif\.org/%s/(\S+)' % key, scopes)
        if m:
            import urllib.parse
            name = urllib.parse.unquote(m.group(1)).replace('_', ' ')[:60]
            break
    return {'urls': urls, 'name': name}


def cameras_scan(wait=3.0):
    """Look for cameras on your home network (ONVIF's WS-Discovery: one question, the cameras answer). A camera found
    shows the camera items (hide-until-seen); it turns nothing on."""
    import uuid
    found = {}
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 1)
        s.settimeout(0.5)
        s.sendto((WSD_PROBE % uuid.uuid4()).encode(), ('239.255.255.250', 3702))
        end = time.time() + wait
        while time.time() < end:
            try:
                data, addr = s.recvfrom(65535)
            except socket.timeout:
                continue
            v = parse_wsd(data.decode('utf-8', 'replace'))
            if v['urls']:
                found[addr[0]] = {'ip': addr[0], 'name': v['name'] or 'Camera at ' + addr[0], 'url': 'http://%s/' % addr[0]}
        s.close()
    except OSError:
        pass
    cams = sorted(found.values(), key=lambda c: c['ip'])
    sio.write_json(CAMERAS, {'at': int(time.time() * 1000), 'cameras': cams})
    if cams:
        mark_seen('camera', cams[0]['name'])
    return {'cameras': cams}


