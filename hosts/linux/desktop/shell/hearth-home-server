        print(json.dumps(res))
        return 0
    except Fail as e:
        print('error: %s' % e)
        return 1
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        print('error: %s' % e)
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
