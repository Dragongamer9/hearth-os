                '--no-cache-dir', '--progress-bar', 'off'] + args, timeout, cwd=d)


def comfy_job(update=False):
    """The install (or update) itself, in its own unit. Anything wrong: you're told why, and an existing ComfyUI keeps
    working (a new clone goes beside it first; an update never touches files you changed)."""
    name = 'comfyui'
    d = comfy_dir()
    step = lambda s, pct: ai_state_set(name, step=s, progress=pct)
    try:
        if not have('git'):
            raise Fail('git isn\'t on this PC (it comes with the next Hearth OS update)')
        if cmd(['/usr/bin/python3', '-c', 'import ensurepip, venv'], 20)[0] != 0:
            raise Fail('Python\'s venv isn\'t on this PC (python3-venv; it comes with the next Hearth OS update)')
        if os.path.islink(d):
            raise Fail('~/ComfyUI is a link: Hearth leaves it alone')
        if os.path.exists(d) and not is_comfy(d):
            raise Fail('~/ComfyUI is there but isn\'t ComfyUI: Hearth leaves it alone')
        if not update and free_gb(me()[1]) < 15:
            raise Fail('Not enough free space in your Home: ComfyUI with PyTorch needs about 15 GB')
        was_on = unit_active(AI_UNITS[name], user=True)
        if not os.path.exists(d):
            step('getting ComfyUI ' + COMFY_TAG, 5)
            new = d + '.hearth-new'
            if os.path.isdir(new) and not os.path.islink(new):
                shutil.rmtree(new)
            code, out = cmd(['git', 'clone', '--depth', '1', '--branch', COMFY_TAG, '--single-branch', COMFY_REPO, new], 1800)
            if code != 0:
                raise Fail('Couldn\'t get ComfyUI: ' + out.strip()[-200:])
            code, head = cmd(['git', '-C', new, 'rev-parse', 'HEAD'], 20)
            if head.strip() != COMFY_COMMIT:
                shutil.rmtree(new, ignore_errors=True)
                raise Fail('ComfyUI %s isn\'t the release Hearth expects (its commit is different): not installed' % COMFY_TAG)
            os.rename(new, d)
            ai_state_set(name, hearthMade=True)
        if update:
            if not os.path.isdir(os.path.join(d, '.git')):
                raise Fail('This ComfyUI wasn\'t installed with git, so Hearth can\'t update it')
            step('getting ComfyUI ' + COMFY_TAG, 10)
            code, out = cmd(['git', '-C', d, 'status', '--porcelain', '--untracked-files=no'], 60)
            if code != 0 or out.strip():
                raise Fail('ComfyUI\'s own files were changed here: Hearth won\'t write over them')
            code, out = cmd(['git', '-C', d, 'fetch', '--depth', '1', '--no-tags', COMFY_REPO,
                             'refs/tags/%s:refs/tags/%s' % (COMFY_TAG, COMFY_TAG)], 1800)
            if code != 0:
                raise Fail('Couldn\'t get ComfyUI %s: %s' % (COMFY_TAG, out.strip()[-200:]))
            code, tag = cmd(['git', '-C', d, 'rev-parse', COMFY_TAG + '^{commit}'], 20)
            if tag.strip() != COMFY_COMMIT:
                raise Fail('ComfyUI %s isn\'t the release Hearth expects (its commit is different): not updated' % COMFY_TAG)
            newer = cmd(['git', '-C', d, 'merge-base', '--is-ancestor', COMFY_COMMIT, 'HEAD'], 20)[0] == 0
            if not newer:
                if was_on:
                    cmd(['systemctl', '--user', 'stop', AI_UNITS[name]], 60)
                code, out = cmd(['git', '-C', d, 'checkout', '--detach', COMFY_COMMIT], 300)
                if code != 0:
                    raise Fail('Couldn\'t switch ComfyUI to %s: %s' % (COMFY_TAG, out.strip()[-200:]))
        if not os.path.isfile(os.path.join(d, 'venv', 'bin', 'python')):
            step('making its Python environment', 15)
            code, out = cmd(['/usr/bin/python3', '-m', 'venv', os.path.join(d, 'venv')], 600)
            if code != 0:
                raise Fail('Couldn\'t make its Python environment: ' + out.strip()[-200:])
        if pip(d, ['show', 'torch'], 120)[0] != 0:
            step('downloading PyTorch for CUDA 12.8 (a few GB)', 20)
            code, out = pip(d, ['install', '--index-url', TORCH_INDEX, 'torch', 'torchvision', 'torchaudio'], 3 * 3600)
            if code != 0:
                raise Fail('PyTorch didn\'t install: ' + out.strip()[-200:])
        step('installing what ComfyUI needs', 70)
        code, out = pip(d, ['install', '-r', 'requirements.txt'], 3600)
        if code != 0:
            raise Fail('ComfyUI\'s requirements didn\'t install: ' + out.strip()[-200:])
        step('checking PyTorch sees the graphics card', 95)
        code, out = cmd([os.path.join(d, 'venv', 'bin', 'python'), '-c',
                         'import json, torch; c = torch.cuda.is_available(); '
                         'print(json.dumps({"torch": torch.__version__, "cuda": c, "gpu": torch.cuda.get_device_name(0) if c else ""}))'], 300, cwd=d)
        info = {}
        try:
            info = json.loads(out.strip().splitlines()[-1]) if code == 0 else {}
        except (ValueError, IndexError):
            pass
        code, ver = cmd(['git', '-C', d, 'describe', '--tags', '--always'], 20)
        ai_state_set(name, installing=False, progress=100, step='', error='', version=ver.strip()[:40] if code == 0 else COMFY_TAG,
                     torch=str(info.get('torch', ''))[:40], cuda=info.get('cuda') is True, gpu=str(info.get('gpu', ''))[:80], at=int(time.time()))
        if was_on or value('picturesOn'):
            cmd(['systemctl', '--user', 'restart', AI_UNITS[name]], 30)
        return {'installed': True}
    except Fail as e:
        ai_state_set(name, installing=False, error=str(e)[:300])
        raise


def comfy_remove(models=False):
    """ComfyUI's code and its Python environment go. Your models stay unless you confirmed twice; your pictures
    (output), inputs and workflows (user) always stay. Nothing outside ~/ComfyUI is touched; links are never followed."""
    o = owner_comfy()
    if o['active'] or o['enabled']:
        raise Fail('Your own comfyui.service still uses ~/ComfyUI: take it over first (or remove it yourself)')
    user_app_switch('comfyui', False)
    d = comfy_dir()
    if os.path.islink(d) or not os.path.isdir(d):
        raise Fail('ComfyUI isn\'t in ~/ComfyUI')
    if not is_comfy(d):
        raise Fail('~/ComfyUI isn\'t ComfyUI: Hearth leaves it alone')
    keep = set(COMFY_KEEP) - ({'models'} if models else set())
    for n in os.listdir(d):
        if n in keep:
            continue
        p = os.path.join(d, n)
        if os.path.islink(p) or not os.path.isdir(p):
            os.unlink(p)
        else:
            shutil.rmtree(p)
    if models:
        m = os.path.join(d, 'models')
        if os.path.islink(m):
            os.unlink(m)              # a link to another drive: the link goes, never what it points to
        elif os.path.isdir(m):
            shutil.rmtree(m)
    left = sorted(os.listdir(d))
    if not left:
        os.rmdir(d)
    st = ai_state()
    st.pop('comfyui', None)
    sio.write_json(HOME_AI_STATE, st)
    out = {'removed': 'comfyui', 'kept': left}
    if set_key('picturesOn', 'off'):      # you removed it: its switch goes off with it
        out['turnedOff'] = 'picturesOn'
        try:
            apply_now()
        except Fail:
            pass
    return out


