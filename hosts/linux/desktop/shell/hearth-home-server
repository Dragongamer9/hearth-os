def is_comfy(d):
    """A ComfyUI checkout (a real folder, not a link): its main.py and comfy package, and a git origin that's ComfyUI's."""
    if os.path.islink(d) or not os.path.isfile(os.path.join(d, 'main.py')) or not os.path.isdir(os.path.join(d, 'comfy')):
