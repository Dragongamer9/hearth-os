FIX_STEPS = {
    'ts-only': [('tsOnly', 'on')],
    'guard': [('guardOn', 'on')],
    'media-ts': [('mediaReach', 'tailscale')],
}


def fix_apply(fid):
    """A fix from Safety: what it changed is remembered so "Undo" puts back exactly what was there."""
    data = load()
    steps = []
    if fid == 'snapshots':
        can = [s for s in status()['shares'] if s.get('snapOk') and not s.get('snapshots') and s.get('on', True) is not False]
        if not can and not any(s.get('snapshots') for s in data['shares']):
            raise Fail('None of your shares is on a drive that can take snapshots (btrfs)')
        if not data['snapshots']:
            steps.append(['set', 'snapshots', 'on', 'off'])
        steps += [['share-set', s['id'], 'snapshots', 'on', 'off'] for s in can]
    elif fid in FIX_STEPS:
        for key, v in FIX_STEPS[fid]:
            old = value(key, data)
            old = ('on' if old else 'off') if isinstance(old, bool) else str(old)
            if old != v:
                steps.append(['set', key, v, old])
    else:
        raise Fail('Unknown fix')
    if not steps:
        return {'changed': False}
    for st in steps:
        if st[0] == 'set':
            if set_key(st[1], st[2]):
                side_effect(st[1], st[2] == 'on')
        else:
            if share_set(st[1], st[2], st[3]):
                apply_now()
    rec = sio.load_json(FIXES, {}, repair=False) if os.path.exists(FIXES) else {}
    done = [x for x in rec.get('done') or [] if isinstance(x, dict) and x.get('id') != fid]
    done.append({'id': fid, 'steps': steps, 'at': int(time.time() * 1000)})
    sio.write_json(FIXES, {'done': done[-20:]})
    return {'changed': True, 'steps': len(steps)}


def fix_undo(fid):
    rec = sio.load_json(FIXES, {}, repair=False) if os.path.exists(FIXES) else {}
    done = [x for x in rec.get('done') or [] if isinstance(x, dict)]
    item = next((x for x in done if x.get('id') == fid), None)
    if not item:
        raise Fail('Nothing to undo')
    for st in reversed(item.get('steps') or []):
        if st[0] == 'set' and len(st) == 4:
            if set_key(st[1], st[3]):
                side_effect(st[1], st[3] == 'on')
        elif st[0] == 'share-set' and len(st) == 5:
            try:
                if share_set(st[1], st[2], st[4]):
                    apply_now()
            except Fail:
                pass
    sio.write_json(FIXES, {'done': [x for x in done if x.get('id') != fid]})
    return {'undone': fid}


