def free_gb(path):
    try:
        st = os.statvfs(path)
        return st.f_bavail * st.f_frsize / (1 << 30)
    except OSError:
        return 0


def start_job(name, args):
    """A long job (an install or update) in its own transient unit of yours, at low priority. Only when you ask."""
    st = ai_state().get(name) or {}
    if st.get('installing') and time.time() - (st.get('started') or 0) < 4 * 3600:
        return {'started': False, 'note': 'already working on it'}
    ai_state_set(name, installing=True, progress=0, step='starting', error='', started=int(time.time()))
    code, out = cmd(['systemd-run', '--user', '--unit=hearth-%s-install-%d' % (name, int(time.time())), '--collect',
                     '--property=Nice=10', '--property=IOSchedulingClass=idle', '--property=RuntimeMaxSec=4h',
                     sys.executable, os.path.realpath(__file__)] + args, 30)
    if code != 0:
        ai_state_set(name, installing=False, error='couldn\'t start: ' + out.strip()[-160:])
        raise Fail('Couldn\'t start it: %s' % out.strip()[-200:])
    return {'started': True}


def pip(d, args, timeout):
    """pip in ComfyUI's own venv. pip checks every file against the hash its index lists (download.pytorch.org,
    pypi.org), over https."""
