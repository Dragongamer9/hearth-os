    cc = cc_local_seen(data, now_ms)
    last_cc = (sio.load_json(SEEN, {}, repair=False).get('commandCenter') or {}) if os.path.exists(SEEN) else {}
    if cc and (not isinstance(last_cc, dict) or cc - last_cc.get('at', 0) > 3600000):
        try:
            sio.merge_json(SEEN, {'commandCenter': {'at': cc, 'device': host}})
        except OSError:
            pass
    items = [{'id': 'ai', 'needs': 'commandCenter'}, {'id': 'cameras', 'needs': 'camera'}, {'id': 'ups', 'needs': 'ups'}]
    _, hidden_count = visible_items(items, data)
    guard = sio.load_json(GUARD_STATE, {}, repair=False) if os.path.exists(GUARD_STATE) else {}
    svc = {'media': {'on': data['media']['on'], 'active': unit_active('hearth-jellyfin.service')},
           'ai': {'on': data['ai']['on'], 'active': unit_active('hearth-ollama.service')},
           'web': {'on': web_needed(data), 'active': unit_active(WEB_UNIT, user=True)},
           'links': len([l for l in data['links'] if isinstance(l, dict)]), 'guardTripped': guard.get('tripped', 0),
           'pictures': {'on': data['pictures']['on'], 'active': unit_active(AI_UNITS['comfyui'], user=True)},
           'voices': {'on': data['voices']['on'], 'active': unit_active(AI_UNITS['kokoro'], user=True)}}
    alerts = sio.load_json(ALERT_STATE, {}, repair=False) if os.path.exists(ALERT_STATE) else {}
    power = sio.load_json(POWER_STATE, {}, repair=False) if os.path.exists(POWER_STATE) else {}
    return {'settings': data, 'file': SETTINGS, 'user': user, 'host': host, 'shares': shares, 'tools': tools,
            'usage': fs_usage([s['path'] for s in shares if s['there'] and s['on']]),
            'applied': sio.load_json(APPLIED, {}, repair=False), 'tailscale': tss, 'seen': seen_state(data), 'hiddenCount': hidden_count,
            'playing': bool(mod and mod.game_running()), 'wired': wired_cards(), 'helper': os.path.exists(ROOT_HELPER),
            'people': accounts_state(data['people']), 'backups': backups_state(data), 'alerts': alerts, 'power': power,
            'ups': ups, 'resumed': resumed(), 'services': svc}


