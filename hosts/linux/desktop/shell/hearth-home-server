def pw_hash(pw, salt=None, n=200000):
    salt = salt or secrets.token_hex(16)
    import hashlib
    return 'pbkdf2-sha256$%d$%s$%s' % (n, salt, hashlib.pbkdf2_hmac('sha256', pw.encode(), bytes.fromhex(salt), n).hex())


def pw_check(pw, h):
    import hashlib
    import hmac
    try:
        kind, n, salt, want = (h or '').split('$')
        if kind != 'pbkdf2-sha256':
            return False
        got = hashlib.pbkdf2_hmac('sha256', (pw or '').encode(), bytes.fromhex(salt), int(n)).hex()
        return hmac.compare_digest(got, want)
    except (ValueError, TypeError):
        return False


