def ai_pull(model):
    """Download one of the ready-made models (Ollama checks every part's SHA-256 as it downloads). Only when you pick one."""
    if model not in MODEL_IDS:
        raise Fail('Pick one of the models listed')
    if not unit_active('hearth-ollama.service'):
        raise Fail('Turn the AI service on first')
    os.makedirs(os.path.dirname(pull_file()), mode=0o700, exist_ok=True)
    sio.write_json(pull_file(), {'model': model, 'pct': 0, 'status': 'starting', 'done': False})
    subprocess.Popen([sys.executable, os.path.realpath(__file__), 'ai-pull-run', model], start_new_session=True,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return {'pulling': model}


def ai_pull_run(model):
    import urllib.request
    if model not in MODEL_IDS:
        return {'error': 'not a listed model'}
    req = urllib.request.Request(OLLAMA + '/api/pull', method='POST', data=json.dumps({'model': model, 'stream': True}).encode(),
                                 headers={'Content-Type': 'application/json'})
    last = 0
    try:
        with urllib.request.urlopen(req, timeout=60) as r:
            for line in r:
                try:
                    v = json.loads(line)
                except ValueError:
                    continue
                if v.get('error'):
                    raise OSError(v['error'])
                pct = round(100 * v['completed'] / v['total']) if v.get('total') and v.get('completed') else None
                if time.time() - last > 1 or v.get('status') == 'success':
                    last = time.time()
                    sio.write_json(pull_file(), {'model': model, 'pct': pct if pct is not None else 0, 'status': str(v.get('status', ''))[:80],
                                                 'done': v.get('status') == 'success'})
    except OSError as e:
        sio.write_json(pull_file(), {'model': model, 'done': True, 'error': str(e)[:200]})
        return {'error': str(e)}
    sio.write_json(pull_file(), {'model': model, 'pct': 100, 'status': 'success', 'done': True})
    return {'pulled': model}


