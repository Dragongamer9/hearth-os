def files_search(q, data=None, budget=4.0, n=100):
    """Files and folders whose names have every word you typed, in every share that's on (hidden ones never)."""
    data = load() if data is None else data
    words = [w for w in re.split(r'\s+', (q or '').lower().strip()) if w][:6]
    if not words:
        raise Fail('Type part of a name')
    deadline = time.time() + budget
    out = []
    for s in data['shares']:
        if s.get('on', True) is False or not os.path.isdir(s.get('path', '')):
            continue
        base = os.path.realpath(s['path'])
        stack = [base]
        while stack and len(out) < n and time.time() < deadline:
            d = stack.pop()
            try:
                entries = list(os.scandir(d))
            except OSError:
                continue
            for e in entries:
                if e.name.startswith('.'):
                    continue
                isdir = e.is_dir(follow_symlinks=False)
                if isdir:
                    stack.append(e.path)
                low = e.name.lower()
                if all(w in low for w in words):
                    try:
                        st = e.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    out.append({'path': e.path, 'name': e.name, 'dir': isdir, 'size': 0 if isdir else st.st_size,
                                'mtime': int(st.st_mtime), 'share': s.get('name')})
                    if len(out) >= n:
                        break
    return {'results': out, 'partial': time.time() >= deadline}


def files_recycle(paths):
    """Clean up: files go to their share's recycle bin (.hearth-recycle, kept 30 days), never deleted; "Put back" undoes
    the last clean up."""
    data = load()
    if not isinstance(paths, list) or not paths or len(paths) > 500:
        raise Fail('Pick the files to clean up')
    moved = []
    for p in paths:
        real = os.path.realpath(p) if isinstance(p, str) else ''
        s = in_a_share(real, data)
        if not s or not os.path.isfile(real) or os.path.islink(p):
            continue
        base = os.path.realpath(s['path'])
        rel = os.path.relpath(real, base)
        dest = os.path.join(base, '.hearth-recycle', rel)
        i = 2
        while os.path.exists(dest):
            root_, ext = os.path.splitext(os.path.join(base, '.hearth-recycle', rel))
            dest = '%s (%d)%s' % (root_, i, ext)
            i += 1
        try:
            os.makedirs(os.path.dirname(dest), mode=0o700, exist_ok=True)
            os.rename(real, dest)
            os.utime(dest)        # the recycle bin's 30 days start now
        except OSError:
            continue
        moved.append({'from': real, 'to': dest})
    if moved:
        sio.write_json(RECYCLED, {'last': moved, 'at': int(time.time() * 1000)})
    return {'moved': len(moved), 'bin': True}


def files_putback():
    rec = sio.load_json(RECYCLED, {}, repair=False) if os.path.exists(RECYCLED) else {}
    back = 0
    for m in rec.get('last') or []:
        if os.path.exists(m.get('to', '')) and not os.path.exists(m.get('from', '')) and '/.hearth-recycle/' in m['to']:
            try:
                os.makedirs(os.path.dirname(m['from']), exist_ok=True)
                os.rename(m['to'], m['from'])
                back += 1
            except OSError:
                pass
    sio.write_json(RECYCLED, {'last': [], 'at': int(time.time() * 1000)})
    return {'putBack': back}


