def person_add(name, pw):
    """A person who can open the shares you pick: a Samba-only account (no login, no home), their password straight to
    smbpasswd. Their access starts at "no access" for every share."""
    if not PERSON_RE.fullmatch(name or ''):
        raise Fail('A name is 2 to 24 small letters, digits, - or _, starting with a letter (like sam or mia-k)')
    if name == me()[0]:
        raise Fail('That\'s you')
    if any(p.get('name') == name for p in load()['people']) and any(p.get('account') for p in accounts_state(load()['people']) if p.get('name') == name):
        raise Fail('%s is already here' % name)
    if len(pw) < 8:
        raise Fail('Use at least 8 characters')
    root(['person-add'], json.dumps({'name': name, 'password': pw}))

    def fn(people):
        for p in people:
            if p.get('name') == name:
                p['pwSet'] = int(time.time() * 1000)   # set up again (after a reinstall): their access stays
                return people
        return people + [{'name': name, 'pwSet': int(time.time() * 1000), 'folder': '', 'quotaGb': 0}]
    people_change(fn)
    return {'person': name}


def person_password(name, pw):
    person_of(name)
    if len(pw) < 8:
        raise Fail('Use at least 8 characters')
    root(['person-password'], json.dumps({'name': name, 'password': pw}))

    def fn(people):
        for p in people:
            if p.get('name') == name:
                p['pwSet'] = int(time.time() * 1000)
                return people
        return None
    people_change(fn)
    return {'set': True}


def person_remove(name):
    """They can't open anything anymore; their folder and everything they saved stay where they are."""
    p = person_of(name)
    root(['person-remove', name])

    def change(d):
        d['people'] = [x for x in (d.get('people') or []) if isinstance(x, dict) and x.get('name') != name]
        for s in d.get('shares') or []:
            if isinstance(s, dict) and isinstance(s.get('people'), dict):
                s['people'].pop(name, None)
    sio.update_json(SETTINGS, change)
    return {'removed': name, 'filesKept': True, 'folder': p.get('folder') or ''}


def person_access(name, sid, acc):
    """What one person may do with one share: no access, read, or read & write (only on a read & write share)."""
    person_of(name)
    if acc not in ACCESS:
        raise Fail('none, read or write')
    s = share_by_id(sid)
    if acc == 'write' and not s.get('write'):
        raise Fail('"%s" is read only: make it read & write first (Shared folders)' % s['name'])
    done = {'changed': False}

    def fn(shares):
        for x in shares:
            if x.get('id') == sid:
                ppl = dict(x.get('people')) if isinstance(x.get('people'), dict) else {}
                if ppl.get(name, 'none') == acc:
                    return None
                if acc == 'none':
                    ppl.pop(name, None)
                else:
                    ppl[name] = acc
                x['people'] = ppl
                done['changed'] = True
                return shares
        return None
    shares_change(fn)
    return done['changed']


def person_folder(name, on, base=None, gb=None):
    """Their own folder: Home › People › NAME, or on a drive (People › NAME there), shared with only them and you.
    Off: not shared anymore; the folder and its files stay."""
    p = person_of(name)
    if on:
        req = {'name': name, 'quotaGb': p.get('quotaGb', 0) if gb is None else gb}
        if base:
            req['base'] = base
        r = root(['person-folder'], json.dumps(req))
        folder = r.get('folder') or ''
    else:
        r, folder = {}, ''

    def fn(people):
        for x in people:
            if x.get('name') == name:
                if x.get('folder', '') == folder and (gb is None or x.get('quotaGb', 0) == gb):
                    return None
                x['folder'] = folder
                if gb is not None:
                    x['quotaGb'] = gb
                return people
        return None
    people_change(fn)
    return {'folder': folder, 'quota': r.get('quota', ''), 'note': r.get('note', '')}


def person_quota(name, raw):
    if not re.fullmatch(r'\d{1,6}', raw or '') or int(raw) > 100000:
        raise Fail('A number of GB (0 for no limit)')
    p = person_of(name)
    gb = int(raw)
    if not p.get('folder'):
        def fn(people):
            for x in people:
                if x.get('name') == name and x.get('quotaGb', 0) != gb:
                    x['quotaGb'] = gb
                    return people
            return None
        people_change(fn)
        return {'quotaGb': gb, 'note': 'Saved: it applies when their own folder is on'}
    return person_folder(name, True, os.path.dirname(os.path.dirname(p['folder'])), gb)


def accounts_state(people):
    """Whether each person's account is on this PC (after a reinstall it isn't: set their password again)."""
    import pwd as _pwd
    out = []
    for p in people:
        q = dict(p)
        try:
            pw = _pwd.getpwnam(p.get('name', ''))
            q['account'] = pw.pw_gecos == 'Hearth home server person (sharing only)'
        except KeyError:
            q['account'] = False
        out.append(q)
    return out


