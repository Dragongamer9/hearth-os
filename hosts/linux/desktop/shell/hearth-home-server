def lan_ip():
    """This PC's address on the home network (no traffic is sent)."""
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            s.connect(('192.168.1.1', 9))
            ip = s.getsockname()[0]
        finally:
            s.close()
        return '' if ip.startswith('127.') or ip.startswith('100.') else ip
    except OSError:
        return ''


def http_json(method, url, body=None, timeout=5):
    """One call to a service on this PC. Tests replace this."""
    import urllib.request
    req = urllib.request.Request(url, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            raw = r.read(8 << 20)
        return json.loads(raw) if raw else {}
    except (OSError, ValueError):
        return None


