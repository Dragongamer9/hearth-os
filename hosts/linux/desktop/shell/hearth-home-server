            if res['changed']:
                res['applied'] = apply_now()
        elif len(a) == 2 and a[0] == 'backup-password':
            job_of(a[1])
            pw = stdin.split('\n')[0]
            if len(pw) < 8:
                raise Fail('Use at least 8 characters')
            root(['backup-secret', a[1]], json.dumps({'password': pw}))
            res = {'set': True}
        elif len(a) == 2 and a[0] == 'backup-remove':
            res = backup_remove(a[1])
            res['applied'] = apply_now()
