def clean_target(t):
    """Where a backup goes, without anything secret: a folder on a drive, one of your Hearth devices, or the cloud."""
    if not isinstance(t, dict):
        raise Fail('Pick where it goes')
    kind = t.get('kind')
    if kind == 'drive':
        user, home = me()
        real, why = root_mod().target_problem(t.get('path'), user, home)
        if not real:
            raise Fail(why[0].upper() + why[1:])
        return {'kind': 'drive', 'path': real}
    if kind == 'hearth':
        peer = t.get('peer') or ''
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9.\-]{0,252}', peer):
            raise Fail('Pick one of your Hearth devices on Tailscale')
        return {'kind': 'hearth', 'peer': peer, 'user': t.get('user') or ''}
    if kind == 'cloud':
        path = t.get('path') or ''
        if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._/\-]{0,199}', path) or '..' in path:
            raise Fail('The bucket and folder are letters, digits, . _ - and / (like my-bucket/hearth)')
        out = {'kind': 'cloud', 'path': path, 'provider': t.get('provider') if t.get('provider') in ('b2', 's3', 'custom') else 's3'}
        if t.get('remote'):
            if not re.fullmatch(r'[A-Za-z0-9_\-]{1,40}', t['remote']):
                raise Fail('An rclone remote\'s name is letters, digits, - and _')
            out['remote'] = t['remote']
        return out
    raise Fail('Back up to a drive, another Hearth device or the cloud')


def backup_add(req):
    """A new backup: its shares, where it goes, how often. The password (restic's key: you need it to restore anywhere
    else) and any code or cloud key go straight to the root helper's 0600 files, never into home-server.json."""
    if not isinstance(req, dict):
        raise Fail('The request must be a JSON object')
    data = load()
    name = (req.get('name') or 'Backup').strip()[:40]
    if root_mod().name_problem(name):
        raise Fail('A backup\'s name is letters, digits, spaces, - or _')
    ids = {s.get('id') for s in data['shares']}
    shares = [i for i in req.get('shares') or [] if i in ids]
    if not shares:
        raise Fail('Pick at least one shared folder to back up')
    target = clean_target(req.get('target'))
    every = req.get('every', 'daily')
    if every not in EVERY:
        raise Fail('Hourly, daily or weekly')
    at = req.get('at', '03:00')
    if not re.fullmatch(r'([01]\d|2[0-3]):[0-5]\d', at or ''):
        raise Fail('A time like 03:00')
    pw = req.get('password') or ''
    if len(pw) < 8:
        raise Fail('The backup password needs at least 8 characters (keep it somewhere safe: restoring on another PC needs it)')
    jid = secrets.token_hex(6)
    secret = {'password': pw}
    if target['kind'] == 'hearth':
        code = (req.get('code') or '').strip()
        m = re.fullmatch(r'([a-z0-9][a-z0-9\-]{2,39}):([A-Za-z0-9\-]{8,64})', code)
        if not m:
            raise Fail('Type the backup code the other device shows (it looks like ally-3f9a:ABCD-EFGH-JKLM-NPQR)')
        target['user'] = m.group(1)
        secret['rest'] = {'user': m.group(1), 'password': m.group(2)}
    if target['kind'] == 'cloud' and not target.get('remote'):
        cloud = req.get('cloud') if isinstance(req.get('cloud'), dict) else {}
        secret['cloud'] = {'kind': target['provider'], 'access': cloud.get('access') or '', 'secret': cloud.get('secret') or '',
                           'endpoint': cloud.get('endpoint') or '', 'region': cloud.get('region') or ''}
    root(['backup-secret', jid], json.dumps(secret))
    job = {'id': jid, 'name': name, 'shares': shares, 'target': target, 'every': every, 'at': at, 'day': 6,
           'keep': {'daily': 7, 'weekly': 4, 'monthly': 6}, 'on': True, 'pwSet': int(time.time() * 1000)}
    backups_change(lambda jobs: jobs + [job])
    return job


def backup_set(jid, key, raw):
    job_of(jid)
    if key == 'on':
        if raw not in ('on', 'off'):
            raise Fail('on or off')
        v = raw == 'on'
    elif key == 'every':
        if raw not in EVERY:
            raise Fail('hourly, daily or weekly')
        v = raw
    elif key == 'at':
        if not re.fullmatch(r'([01]\d|2[0-3]):[0-5]\d', raw or ''):
            raise Fail('a time like 03:00')
        v = raw
    elif key == 'day':
        if not re.fullmatch(r'[0-6]', raw or ''):
            raise Fail('0 (Monday) to 6 (Sunday)')
        v = int(raw)
    elif key == 'name':
        if root_mod().name_problem(raw):
            raise Fail('letters, digits, spaces, - or _')
        v = raw
    elif key in BACKUP_KEEP:
        k, mx = BACKUP_KEEP[key]
        if not re.fullmatch(r'\d{1,3}', raw or '') or int(raw) > mx:
            raise Fail('a number from 0 to %d' % mx)
        v = int(raw)
    else:
        raise Fail('Unknown backup setting')
    done = {'changed': False}

    def fn(jobs):
        for j in jobs:
            if j.get('id') == jid:
                if key in BACKUP_KEEP:
                    keep = dict(j.get('keep') or {})
                    if keep.get(BACKUP_KEEP[key][0]) == v:
                        return None
                    keep[BACKUP_KEEP[key][0]] = v
                    j['keep'] = keep
                else:
                    if j.get(key, {'on': True, 'day': 6}.get(key)) == v:
                        return None
                    j[key] = v
                done['changed'] = True
                return jobs
        return None
    backups_change(fn)
    return done['changed']


def backup_share(jid, sid, on):
    job_of(jid)
    share_by_id(sid)
    done = {'changed': False}

    def fn(jobs):
        for j in jobs:
            if j.get('id') == jid:
                cur = list(j.get('shares') or [])
                if (sid in cur) == on:
                    return None
                if not on and len(cur) <= 1:
                    raise Fail('A backup needs at least one folder (or remove the backup)')
                j['shares'] = cur + [sid] if on else [x for x in cur if x != sid]
                done['changed'] = True
                return jobs
        return None
    backups_change(fn)
    return done['changed']


