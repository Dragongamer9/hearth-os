UPS_VENDORS = {'051d': 'APC', '0764': 'CyberPower', '0463': 'Eaton', '09ae': 'Tripp Lite', '06da': 'Phoenixtec', '0d9f': 'Powercom',
               '0665': 'UPS', '10af': 'Liebert'}


def ups_found():
    """A UPS plugged in by USB (by its maker's id), or ''. Seeing one only shows its items; it turns nothing on."""
    try:
        for d in os.listdir('/sys/bus/usb/devices'):
            try:
                v = open('/sys/bus/usb/devices/%s/idVendor' % d).read().strip().lower()
            except OSError:
                continue
            if v in UPS_VENDORS:
                try:
                    prod = open('/sys/bus/usb/devices/%s/product' % d).read().strip()
                except OSError:
                    prod = ''
                return (UPS_VENDORS[v] + ' ' + prod).strip()[:60]
    except OSError:
        pass
    return ''


def alert_peer(name, on):
    if not re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9.\-]{0,252}', name or ''):
        raise Fail('That isn\'t one of your devices')
    done = {'changed': False}

    def change(d):
        a = dict(d.get('alerts')) if isinstance(d.get('alerts'), dict) else {}
        peers = [p for p in a.get('peers') or [] if isinstance(p, str)]
        if (name in peers) == on:
            return
        a['peers'] = peers + [name] if on else [p for p in peers if p != name]
        d['alerts'] = a
        done['changed'] = True
    if (name in load()['alerts'].get('peers', [])) != on:
        sio.update_json(SETTINGS, change)
    return done['changed']


def resume_flag():
    return os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/run/user/%d' % os.getuid(), 'hearth-home-server-resume')


def resume(on):
    """Let big jobs paused for your game run now (for up to 4 hours), or pause them again. A flag in your runtime
    folder: it changes no setting and is gone after a restart."""
    f = resume_flag()
    if on:
        with open(f, 'w') as fh:
            fh.write(str(int(time.time())) + '\n')
    else:
        try:
            os.remove(f)
        except OSError:
            pass
    return {'resumed': on}


def resumed():
    try:
        return time.time() - os.lstat(resume_flag()).st_mtime < 4 * 3600
    except OSError:
        return False


def quick():
    """Home server in short, for Game Mode's Quick Access (Hearth Link's Decky panel): quick, no root, no network."""
    data = load()
    mod = None
    try:
        mod = root_mod()
    except Fail:
        pass
    shares = [s for s in data['shares'] if s.get('on', True) is not False]
    jobs = backups_state(data) if data['backups'] else []
    waiting = [j['name'] for j in jobs if (j.get('state') or {}).get('waiting')]
    failed = [j['name'] for j in jobs if ((j.get('state') or {}).get('last') or {}).get('ok') is False]
    last_ok = max([(j.get('state') or {}).get('lastOk') or 0 for j in jobs] or [0])
    alerts = sio.load_json(ALERT_STATE, {}, repair=False).get('active', []) if os.path.exists(ALERT_STATE) else []
    playing = bool(mod and mod.game_running())
    paused = []
    if data['lightMode'] and playing and not resumed():
        if data['snapshots'] or any(s.get('recycle', True) and s.get('write') for s in shares):
            paused.append('snapshots')
        if any(j.get('on', True) for j in data['backups']):
            paused.append('backups')
    return {'available': True, 'host': socket.gethostname().split('.')[0], 'lightMode': data['lightMode'] is not False,
            'playing': playing, 'resumed': resumed(), 'paused': paused, 'shares': len(shares), 'people': len(data['people']),
            'usage': fs_usage([s['path'] for s in shares if os.path.isdir(s.get('path', ''))]),
            'backups': {'count': len(jobs), 'lastOk': int(last_ok * 1000) if last_ok else 0, 'waiting': waiting, 'failed': failed,
                        'running': any((j.get('state') or {}).get('running') for j in jobs)},
            'alerts': [a.get('text', '') for a in alerts if isinstance(a, dict)][:3], 'setupDone': bool(data['setupDone'])}


