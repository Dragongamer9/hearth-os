def walk_share(base, deadline, limit=400000):
    """Every regular file in a share (not hidden, no links followed): (path, size, mtime, atime)."""
    n = 0
    stack = [base]
    while stack:
        d = stack.pop()
        try:
            it = os.scandir(d)
        except OSError:
            continue
        with it:
            for e in it:
                if e.name.startswith('.'):
                    continue
                try:
                    if e.is_dir(follow_symlinks=False):
                        stack.append(e.path)
                    elif e.is_file(follow_symlinks=False):
                        st = e.stat(follow_symlinks=False)
                        n += 1
                        yield e.path, st.st_size, st.st_mtime, st.st_atime
                except OSError:
                    continue
                if n >= limit or time.time() > deadline:
                    return


def file_head_hash(path, size):
    import hashlib
    h = hashlib.sha256()
    try:
        with open(path, 'rb') as f:
            h.update(f.read(65536))
            if size > 131072:
                f.seek(size - 65536)
                h.update(f.read(65536))
    except OSError:
        return ''
    return h.hexdigest()


SHOT_RE = re.compile(r'(screenshot|screen shot|bildschirmfoto|captura|scr_|snap)', re.I)
PIC_EXT = ('.png', '.jpg', '.jpeg', '.webp', '.avif', '.heic')


def scan_shares(data, now=None, budget=900):
    """The smart folders, recent changes and space per share, from one walk over your shares: recent screenshots (the last
    30 days), big files (4 GB and up), duplicates (same size and the same first and last 64 KB, then the whole file
    hashed), not changed in a year, and what changed in the last 7 days."""
    now = time.time() if now is None else now
    deadline = time.time() + budget
    shots, big, old, recent, sizes = [], [], [], [], {}
    by_size = {}
    for s in data['shares']:
        if s.get('on', True) is False or not os.path.isdir(s.get('path', '')):
            continue
        total = 0
        for p, size, mt, at in walk_share(os.path.realpath(s['path']), deadline):
            total += size
            item = {'path': p, 'size': size, 'mtime': int(mt), 'share': s.get('name')}
            low = os.path.basename(p).lower()
            if low.endswith(PIC_EXT) and (SHOT_RE.search(low) or '/screenshots/' in p.lower()) and now - mt < 30 * 86400:
                shots.append(item)
            if size >= 4 << 30:
                big.append(item)
            if now - mt > 365 * 86400:
                old.append(item)
            if now - mt < 7 * 86400:
                recent.append(item)
            if size >= 1 << 20:
                by_size.setdefault(size, []).append(item)
        sizes[s.get('id')] = total
    dups = []
    for size, items in by_size.items():
        if len(items) < 2:
            continue
        heads = {}
        for it in items:
            heads.setdefault(file_head_hash(it['path'], size), []).append(it)
        for hh_, group in heads.items():
            if hh_ and len(group) > 1:
                group.sort(key=lambda x: x['mtime'])
                dups.append({'size': size, 'keep': group[0]['path'], 'copies': group[1:]})

    def pack(items, key, n=200):
        items.sort(key=key)
        return {'count': len(items), 'bytes': sum(i['size'] for i in items), 'items': items[:n]}
    dup_items = [c for g in dups for c in g['copies']]
    return {'at': int(now), 'screenshots': pack(shots, lambda i: -i['mtime']), 'big': pack(big, lambda i: -i['size']),
            'duplicates': dict(pack(dup_items, lambda i: -i['size']), groups=len(dups)), 'old': pack(old, lambda i: i['mtime']),
            'recent': pack(recent, lambda i: -i['mtime'], 60), 'sizes': sizes}


