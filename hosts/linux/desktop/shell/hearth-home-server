def main(argv):
    a = argv[1:]
    stdin = os.environ.get('HEARTH_INPUT', '')
    try:
        if a == ['status']:
            res = status()
        elif len(a) == 3 and a[0] == 'set':
            user_app_precheck(a[1], a[2])
            changed = set_key(a[1], a[2])
            res = {'changed': changed}
            if changed:
                res['applied'] = side_effect(a[1], a[2] == 'on')
        elif a == ['candidates']:
            res = candidates()
        elif a == ['pick-folder']:
            res = pick_folder()
        elif len(a) in (2, 3) and a[0] == 'share-add':
            res = {'share': share_add(a[1], a[2] if len(a) == 3 else None)}
            res['applied'] = apply_now()
        elif len(a) == 4 and a[0] == 'share-set':
            res = {'changed': share_set(a[1], a[2], a[3])}
            if res['changed']:
                res['applied'] = apply_now()
        elif len(a) == 2 and a[0] == 'share-remove':
            res = {'removed': share_remove(a[1]), 'filesKept': True}
            res['applied'] = apply_now()
        elif a == ['smb-password']:
            pw = stdin.split('\n')[0]
            if len(pw) < 8:
                raise Fail('Use at least 8 characters')
            root(['smb-password'], pw + '\n')
            sio.merge_json(SETTINGS, {'smbPasswordSet': int(time.time() * 1000)})
            res = {'set': True}
        elif a == ['apply']:
            res = apply_now()
        elif a == ['drives']:
            res = root(['drives'])
        elif len(a) == 2 and a[0] == 'format-plan':
            res = root(['format-plan', a[1]])
        elif a == ['format']:
            res = root(['format'], stdin)
        elif len(a) == 2 and a[0] == 'snapshots':
            res = snapshots(a[1])
        elif len(a) == 3 and a[0] == 'restore':
            res = restore(a[1], a[2])
        elif len(a) == 3 and a[0] == 'restore-copy':
            res = restore_copy(a[1], a[2])
        elif a == ['ts-status']:
            res = ts_status()
        elif a == ['ts-start']:
            res = root(['tailscale', 'start'])
        elif a == ['ts-login']:
            res = ts_login()
        elif a == ['ts-logout']:
            code, out, err = ts(['logout'], 20)
            res = {'signedOut': code == 0}
        elif a == ['ts-ping']:
            res = ts_ping()
        elif len(a) in (2, 3) and a[0] == 'ts-send':
            res = ts_send(a[1], a[2] if len(a) == 3 else None)
        elif len(a) in (2, 3) and a[0] == 'seen':
            res = mark_seen(a[1], a[2] if len(a) == 3 else '')
        # ---- stage 2: people
        elif len(a) == 2 and a[0] == 'person-add':
            res = person_add(a[1], stdin.split('\n')[0])
            res['applied'] = apply_now()
        elif len(a) == 2 and a[0] == 'person-password':
            res = person_password(a[1], stdin.split('\n')[0])
        elif len(a) == 2 and a[0] == 'person-remove':
            res = person_remove(a[1])
            res['applied'] = apply_now()
        elif len(a) == 4 and a[0] == 'person-access':
            res = {'changed': person_access(a[1], a[2], a[3])}
            if res['changed']:
                res['applied'] = apply_now()
        elif len(a) in (3, 4) and a[0] == 'person-folder' and a[2] in ('on', 'off'):
            res = person_folder(a[1], a[2] == 'on', a[3] if len(a) == 4 else None)
            res['applied'] = apply_now()
        elif len(a) == 3 and a[0] == 'person-quota':
            res = person_quota(a[1], a[2])
        # ---- stage 2: backups & sync
        elif a == ['backup-add']:
            res = {'backup': backup_add(json.loads(stdin or '{}'))}
            res['applied'] = apply_now()
        elif len(a) == 4 and a[0] == 'backup-set':
            res = {'changed': backup_set(a[1], a[2], a[3])}
            if res['changed']:
                res['applied'] = apply_now()
        elif len(a) == 4 and a[0] == 'backup-share' and a[3] in ('on', 'off'):
