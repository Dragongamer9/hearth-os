        elif len(a) == 2 and a[0] == 'folder-share' and a[1] in ('games', 'family'):
            res = folder_share(a[1])
            res['applied'] = apply_now()
        elif a == ['gaming']:
            res = gaming_view()
        elif a == ['family']:
            res = family_view()
        elif a == ['cameras-scan']:
            res = cameras_scan()
        elif a == ['safety']:
