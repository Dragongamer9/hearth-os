def size_gb(path, limit=200000):
    """How big a folder is (links not followed), in GB; quick and rough."""
    total, n = 0, 0
    for root_, dirs, files in os.walk(path):
        for f in files:
            try:
                total += os.lstat(os.path.join(root_, f)).st_size
            except OSError:
                pass
            n += 1
            if n > limit:
                return round(total / (1 << 30), 1)
    return round(total / (1 << 30), 1)


