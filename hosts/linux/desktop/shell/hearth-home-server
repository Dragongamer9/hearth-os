    receive_change(fn)
    return True


def receive_add(name):
    name = re.sub(r'[^a-z0-9\-]+', '-', (name or '').lower()).strip('-')[:30] or 'device'
    r = root(['receive-add', name])

    def fn(rc):
        rc['devices'] = list(rc.get('devices') or []) + [{'user': r['user'], 'name': name, 'at': int(time.time() * 1000)}]
        return rc
    receive_change(fn)
    return {'user': r['user'], 'code': r['code']}


def receive_remove(u):
    root(['receive-remove', u])

    def fn(rc):
        devs = [d for d in rc.get('devices') or [] if isinstance(d, dict) and d.get('user') != u]
        if len(devs) == len(rc.get('devices') or []):
            return None
        rc['devices'] = devs
        return rc
    receive_change(fn)
    return {'removed': u, 'filesKept': True}


# ================================================================== stage 2: folder sync (Syncthing)

ST_ID_RE = re.compile(r'^[A-Z0-9]{7}(-[A-Z0-9]{7}){7}$')


def st_config_path():
    for p in (os.path.join(STATE_HOME, 'syncthing', 'config.xml'), os.path.join(CONFIG_HOME, 'syncthing', 'config.xml')):
        if os.path.exists(p):
            return p
    return ''


def st_api_info():
    """Syncthing's address and API key from its own config (never copied anywhere)."""
    import xml.etree.ElementTree as ET
    p = st_config_path()
    if not p:
        return None
    try:
        root_ = ET.parse(p).getroot()
    except (ET.ParseError, OSError):
        return None
    gui = root_.find('gui')
    if gui is None:
        return None
    key = (gui.findtext('apikey') or '').strip()
    addr = (gui.findtext('address') or '127.0.0.1:8384').strip()
    if not key or not re.fullmatch(r'(127\.0\.0\.1|localhost|\[::1\]):\d{2,5}', addr):
        return None
    return {'url': ('https://' if gui.get('tls') == 'true' else 'http://') + addr, 'key': key}


def st(method, path, body=None, timeout=8):
    """One call to your Syncthing (on this PC only)."""
    import urllib.request
    import ssl
    info = st_api_info()
    if not info:
        raise Fail('Folder sync isn\'t running yet')
    req = urllib.request.Request(info['url'] + path, method=method, data=json.dumps(body).encode() if body is not None else None,
                                 headers={'X-API-Key': info['key'], 'Content-Type': 'application/json'})
    ctx = ssl._create_unverified_context() if info['url'].startswith('https') else None
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=ctx) as r:
            raw = r.read()
    except OSError as e:
        raise Fail('Folder sync didn\'t answer (%s)' % e)
    try:
        return json.loads(raw) if raw else {}
    except ValueError:
        return {}


def st_start():
    """Your own Syncthing (a user service, off until you sync a folder), set up to talk only over Tailscale: no global
    discovery, no relays, no usage reports."""
    if not shutil.which('syncthing'):
        raise Fail('Syncthing (folder sync) isn\'t installed on this PC')
    subprocess.run(['systemctl', '--user', 'enable', '--now', 'syncthing.service'], capture_output=True, timeout=30)
    for _ in range(40):
        if st_api_info():
            try:
                st('GET', '/rest/system/ping', timeout=2)
                break
            except Fail:
                pass
        time.sleep(0.5)
    ip = ''
    try:
        ip = next((x for x in ts_status().get('ips', []) if x.startswith('100.')), '')
    except Fail:
        pass
    opts = {'globalAnnounceEnabled': False, 'relaysEnabled': False, 'natEnabled': False, 'localAnnounceEnabled': False,
            'urAccepted': -1, 'crashReportingEnabled': False, 'startBrowser': False}
    if ip:
        opts['listenAddresses'] = ['tcp://%s:22000' % ip]
    st('PATCH', '/rest/config/options', opts)
    return st('GET', '/rest/system/status').get('myID', '')


def peer_ip(peer):
    for p in ts_status().get('peers', []):
        if peer in (p['name'], p['dns']) and p['ips']:
            return next((x for x in p['ips'] if x.startswith('100.')), p['ips'][0])
    raise Fail('That isn\'t one of your devices on Tailscale')


def sync_add(path, peer, device):
    """Keep a folder the same on this PC and another Hearth device (Syncthing, over Tailscale). Deleted or changed files
    go to the folder's .stversions for 30 days first."""
    user, home = me()
    real, why = root_mod().path_problem(path, user, home)
    if not real:
        raise Fail(why[0].upper() + why[1:])
    device = (device or '').strip().upper()
    if not ST_ID_RE.fullmatch(device):
        raise Fail('Type the other device\'s sync ID (Settings › Home server › Backups & sync there): 8 groups of 7 letters and digits')
    ip = peer_ip(peer)
    my = st_start()
    if device == my:
        raise Fail('That\'s this PC\'s own sync ID')
    sid = secrets.token_hex(6)
    label = os.path.basename(real)
    st('PUT', '/rest/config/devices/' + device, {'deviceID': device, 'name': peer, 'addresses': ['tcp://%s:22000' % ip],
                                                 'autoAcceptFolders': False, 'introducer': False})
    st('PUT', '/rest/config/folders/hearth-' + sid, {'id': 'hearth-' + sid, 'label': label, 'path': real, 'type': 'sendreceive',
                                                     'devices': [{'deviceID': my}, {'deviceID': device}],
                                                     'versioning': {'type': 'trashcan', 'params': {'cleanoutDays': '30'}}})
    item = {'id': sid, 'label': label, 'path': real, 'peer': peer, 'device': device}

    def change(d):
        d['syncs'] = list(d.get('syncs') or []) + [item]
    sio.update_json(SETTINGS, change)
    return item


def sync_accept(fid, device, path=None):
    """A folder another of your Hearth devices offered: kept in Home › Synced › NAME (or the folder you pick)."""
    if not re.fullmatch(r'hearth-[0-9a-f]{6,32}', fid or '') or not ST_ID_RE.fullmatch(device or ''):
        raise Fail('That isn\'t an offered folder')
    pend = st('GET', '/rest/cluster/pending/folders')
    offer = ((pend.get(fid) or {}).get('offeredBy') or {}).get(device)
    if not offer:
        raise Fail('That folder isn\'t offered anymore')
    label = re.sub(r'[^\w .\-+@,()\']+', ' ', offer.get('label') or fid).strip() or fid
    user, home = me()
    dest = path or os.path.join(home, 'Synced', label)
    os.makedirs(dest, exist_ok=True)
    real, why = root_mod().path_problem(dest, user, home)
    if not real:
        raise Fail(why[0].upper() + why[1:])
    my = st('GET', '/rest/system/status').get('myID', '')
    cfg = st('GET', '/rest/config/devices')
    if not any(d.get('deviceID') == device for d in cfg if isinstance(d, dict)):
        st('PUT', '/rest/config/devices/' + device, {'deviceID': device, 'name': device[:7], 'autoAcceptFolders': False})
    st('PUT', '/rest/config/folders/' + fid, {'id': fid, 'label': label, 'path': real, 'type': 'sendreceive',
                                             'devices': [{'deviceID': my}, {'deviceID': device}],
                                             'versioning': {'type': 'trashcan', 'params': {'cleanoutDays': '30'}}})
    item = {'id': fid[7:], 'label': label, 'path': real, 'peer': '', 'device': device}

    def change(d):
        d['syncs'] = list(d.get('syncs') or []) + [item]
    sio.update_json(SETTINGS, change)
    return item


def sync_remove(sid):
    """Stop syncing a folder: its files stay on both devices."""
    data = load()
    item = next((x for x in data['syncs'] if x.get('id') == sid), None)
    if not item:
        raise Fail('That folder isn\'t synced anymore')
    try:
        st('DELETE', '/rest/config/folders/hearth-' + sid)
    except Fail:
        pass

    def change(d):
        d['syncs'] = [x for x in d.get('syncs') or [] if isinstance(x, dict) and x.get('id') != sid]
    sio.update_json(SETTINGS, change)
    if not load()['syncs']:
        subprocess.run(['systemctl', '--user', 'disable', '--now', 'syncthing.service'], capture_output=True, timeout=30)
    return {'removed': item.get('label'), 'filesKept': True}


def sync_status():
    data = load()
    out = {'installed': bool(shutil.which('syncthing')), 'running': False, 'id': '', 'folders': [], 'offers': []}
    if not out['installed'] or not st_api_info():
        out['folders'] = [dict(x, state='off') for x in data['syncs']]
        return out
    try:
        out['id'] = st('GET', '/rest/system/status', timeout=3).get('myID', '')
        out['running'] = True
        conns = st('GET', '/rest/system/connections', timeout=3).get('connections') or {}
        for x in data['syncs']:
            q = dict(x)
            try:
                c = st('GET', '/rest/db/completion?folder=hearth-%s' % x.get('id'), timeout=3)
                q['completion'] = round(c.get('completion', 0))
                q['need'] = c.get('needItems', 0)
            except Fail:
                q['completion'] = None
            q['connected'] = bool((conns.get(x.get('device')) or {}).get('connected'))
            out['folders'].append(q)
        pend = st('GET', '/rest/cluster/pending/folders', timeout=3)
        for fid, v in (pend or {}).items():
            if fid.startswith('hearth-'):
                for dev, o in ((v or {}).get('offeredBy') or {}).items():
                    out['offers'].append({'id': fid, 'device': dev, 'label': o.get('label') or fid})
    except Fail:
        out['folders'] = [dict(x, state='off') for x in data['syncs']]
    return out


