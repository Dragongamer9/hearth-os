#!/usr/bin/env python3
"""Hearth Desktop Mode on Firehold's own compositor (firehold-comp, HEARTH_WM=firehold): the window list bridge
between the compositor and Mantel, the same way hearth-kwin-bridge is on KWin, so WinList.qml works the same on both.

  hearth-firehold-bridge serve --stdio     what WinList.qml runs: the compositor's window IPC
                                           ($XDG_RUNTIME_DIR/firehold-wm-<WAYLAND_DISPLAY>.sock, docs/FIREHOLD.md)
                                           to stdout, Mantel's commands (one JSON line each) from stdin to it
  hearth-firehold-bridge do JSON           one command, its answer printed (checks)
  hearth-firehold-bridge list              the window list now

Lines it prints (serve --stdio): {"t": "windows", "windows": [...], "desktops": [...], "active": id, "stack": [...]},
{"t": "status", "connected": bool, "problem": "..."}, {"t": "reply", ...} and {"t": "shot", ...}. When the compositor
isn't there (or went away) it says so and tries again every 2 seconds; it ends when Mantel does (stdin closes).
"""
import json
import os
import selectors
import socket
import sys
import time


def socket_path():
    run = os.environ.get('XDG_RUNTIME_DIR', '/run/user/%d' % os.getuid())
    name = os.path.basename(os.environ.get('WAYLAND_DISPLAY', 'wayland-0'))
    return os.path.join(run, 'firehold-wm-%s.sock' % name)


def say(obj):
    try:
        sys.stdout.write(json.dumps(obj) + '\n')
        sys.stdout.flush()
    except (OSError, ValueError):
        sys.exit(0)


def connect():
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(2)
    s.connect(socket_path())
    s.sendall(b'{"op": "watch"}\n')
    s.setblocking(False)
    return s


def serve():
    sel = selectors.DefaultSelector()
    stdin = sys.stdin.buffer.raw if hasattr(sys.stdin.buffer, 'raw') else sys.stdin.buffer
    os.set_blocking(stdin.fileno(), False)
    sel.register(stdin, selectors.EVENT_READ, 'stdin')
    sock, inbuf, outq, next_try, told = None, b'', [], 0.0, None
    while True:
        if sock is None and time.monotonic() >= next_try:
            try:
                sock = connect()
                sel.register(sock, selectors.EVENT_READ, 'sock')
                inbuf = b''
                say({'t': 'status', 'connected': True, 'problem': ''})
                told = None
                for line in outq:
                    sock.setblocking(True)
                    sock.sendall(line)
                    sock.setblocking(False)
                outq = []
            except OSError as e:
                sock = None
                why = "Firehold's window list isn't there (%s)" % (e.strerror or e)
                if told != why:
                    say({'t': 'status', 'connected': False, 'problem': why})
                    told = why
                next_try = time.monotonic() + 2
        for key, _ in sel.select(timeout=0.5 if sock is None else None):
            if key.data == 'stdin':
                try:
                    data = os.read(stdin.fileno(), 65536)
                except BlockingIOError:
                    continue
                if not data:
                    return 0
                for raw in data.splitlines(keepends=False):
                    raw = raw.strip()
                    if not raw:
                        continue
                    line = raw + b'\n'
                    if sock is None:
                        outq = (outq + [line])[-20:]
                        continue
                    try:
                        sock.setblocking(True)
                        sock.settimeout(1)
                        sock.sendall(line)
                        sock.setblocking(False)
                    except OSError:
                        outq.append(line)
            else:
                try:
                    data = sock.recv(1 << 20)
                except BlockingIOError:
                    continue
                except OSError:
                    data = b''
                if not data:
                    sel.unregister(sock)
                    sock.close()
                    sock = None
                    next_try = time.monotonic() + 1
                    say({'t': 'status', 'connected': False, 'problem': "Firehold's window list went away"})
                    told = None
                    continue
                inbuf += data
                while b'\n' in inbuf:
                    line, inbuf = inbuf.split(b'\n', 1)
                    if line.strip():
                        try:
                            say(json.loads(line))
                        except ValueError:
                            pass


def ask(line, want=1, timeout=5.0):
    """One command; the first `want` lines back."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    out, buf = [], b''
    try:
        s.connect(socket_path())
        s.sendall(line.encode() + b'\n')
        while len(out) < want:
            chunk = s.recv(1 << 20)
            if not chunk:
                break
            buf += chunk
            while b'\n' in buf and len(out) < want:
                l, buf = buf.split(b'\n', 1)
                out.append(json.loads(l))
    finally:
        s.close()
    return out


def main(argv):
    what = argv[1] if len(argv) > 1 else ''
    if what == 'serve':
        return serve()
    try:
        if what == 'list':
            print(json.dumps(ask('windows')[0]))
            return 0
        if what == 'do' and len(argv) > 2:
            cmd = json.loads(argv[2])
            got = ask(json.dumps(cmd), want=2 if cmd.get('op') == 'shot' else 1)
            for g in got:
                print(json.dumps(g))
            return 0 if got and all(g.get('ok', True) for g in got) else 1
    except (OSError, ValueError, IndexError) as e:
        print('error: %s' % e)
        return 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv))
