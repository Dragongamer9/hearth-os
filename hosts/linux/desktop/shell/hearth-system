def key_words(key):
    parts = key.split('-')
    mods, last = parts[:-1], parts[-1]
    if not last and len(parts) > 1:      # "C--" is Ctrl and minus
        mods, last = parts[:-2], '-'
    words = [KEY_WORDS.get(m, m) for m in mods]
    if last in KEYSYM_WORDS:
        name = KEYSYM_WORDS[last]
    elif len(last) == 1:
        name = last.upper()
    else:
        name = re.sub(r'^XF86', '', last)
    return '+'.join(words + [name])


def action_words(action):
    name = action.get('name', '')
    if name == 'Execute':
        cmd = action.get('command') or ''
        for pat, words in COMMAND_WORDS:
            m = re.search(pat, cmd)
            if m:
                return words + (' ' + m.group(1) if m.groups() else '')
        word = (cmd.split() or [''])[0]
        return 'Run ' + os.path.basename(word) if word else 'Run a command'
    if name == 'SnapToEdge':
        return 'Snap the window to the %s' % {'left': 'left half', 'right': 'right half', 'up': 'top', 'down': 'bottom'}.get(action.get('direction', ''), 'edge')
    if name == 'MoveToOutput':
        return 'Move the window to the screen on the %s' % action.get('direction', 'other side')
    if name == 'MoveToEdge':
        return 'Move the window to the %s edge' % action.get('direction', '')
    if name == 'GoToDesktop':
        return 'Go to desktop %s' % {'left': 'on the left', 'right': 'on the right'}.get(action.get('to', ''), action.get('to', ''))
    if name == 'SendToDesktop':
        return 'Move the window to desktop %s' % {'left': 'on the left', 'right': 'on the right'}.get(action.get('to', ''), action.get('to', ''))
    return ACTION_WORDS.get(name, re.sub(r'(?<!^)([A-Z])', r' \1', name).capitalize())


def parse_keybinds(text):
    """labwc rc.xml -> [{key, keys (plain words), action (plain words)}] in file order, plus labwc's defaults."""
    try:
        root = ET.fromstring(text)
    except ET.ParseError:
        return []
    kb = root.find('keyboard')
    if kb is None:
        return []
    out, seen = [], set()
    for bind in kb.findall('keybind'):
        key = bind.get('key') or ''
        actions = []
        for a in bind.findall('action'):
            d = dict(a.attrib)
            for child in a:      # <action name="Execute"><command>...</command></action> is allowed too
                if child.text and child.tag not in d:
                    d[child.tag] = child.text.strip()
            actions.append(d)
        if not key or not actions:
            continue
        seen.add(key)
        out.append({'key': key, 'keys': key_words(key), 'action': ', then '.join(action_words(a) for a in actions)})
    if kb.find('default') is not None:
        out += [{'key': k, 'keys': key_words(k), 'action': w} for k, w in LABWC_DEFAULTS if k not in seen]
    return out


def shortcuts():
    path = os.path.join(runtime_dir(), 'rc.xml')
    if not os.path.exists(path):
        path = os.path.join(LABWC_DIR, 'rc.xml')
    return {'shortcuts': parse_keybinds(read(path)), 'file': path}


