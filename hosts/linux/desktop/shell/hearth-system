# ---- reading and writing mimeapps.list: every line is kept as it was (comments, blank lines, other sections and
# types), only the lines for the types being changed are.
def ml_parse(text):
    """[[section header or None, [lines]]]: everything, in order."""
    secs = [[None, []]]
    for line in text.splitlines():
        s = line.strip()
        if s.startswith('[') and s.endswith(']'):
            secs.append([s, []])
        else:
            secs[-1][1].append(line)
    return secs


def ml_text(secs):
    out = []
    for head, lines in secs:
        if head is None and not lines:
            continue
        if head is not None:
            # A blank line before a section, unless a comment is right above it (it's about the section).
            if out and out[-1].strip() and not out[-1].lstrip().startswith('#'):
                out.append('')
            out.append(head)
        out += lines
    while out and not out[-1].strip():
        out.pop()
    while out and not out[0].strip():
        out.pop(0)
    return '\n'.join(out) + '\n' if out else ''


def ml_key(line):
    s = line.strip()
    if not s or s.startswith('#') or '=' not in s:
        return None
    return s.split('=', 1)[0].strip()


def ml_ids(line):
    return [x.strip() for x in line.split('=', 1)[1].split(';') if x.strip()]


def ml_section(secs, head):
    for s in secs:
        if s[0] == head:
            return s
    # A new section goes before trailing blank lines' worth of nothing: at the end.
    s = [head, []]
    secs.append(s)
    return s


def ml_put(lines, key, value):
    """Sets key=value in a section's lines: the first line for key is replaced, any others dropped; a new key goes
    after the section's last entry."""
    out, done = [], False
    for line in lines:
        if ml_key(line) == key:
            if not done:
                out.append(key + '=' + value)
                done = True
            continue
        out.append(line)
    if not done:
        i = len(out)
        while i and not out[i - 1].strip():
            i -= 1
        out.insert(i, key + '=' + value)
    return out


def ml_read(text, mime, head=DEFAULTS):
    ids = []
    for h, lines in ml_parse(text):
        if h == head:
            for line in lines:
                if ml_key(line) == mime:
                    ids += ml_ids(line)
    return ids


def mimeapps_with(text, mimes, app_id):
    """mimeapps.list text with app_id as the default for each mime (and first in its added associations, and no
    longer a removed one)."""
    secs = ml_parse(text)
    d = ml_section(secs, DEFAULTS)
    for m in mimes:
        d[1] = ml_put(d[1], m, app_id + ';')
    a = ml_section(secs, ADDED)
    for m in mimes:
        have = []
        for line in a[1]:
            if ml_key(line) == m:
                have += [x for x in ml_ids(line) if x != app_id and x not in have]
        a[1] = ml_put(a[1], m, ';'.join([app_id] + have) + ';')
    for s in secs:
        if s[0] != REMOVED:
            continue
        out = []
        for line in s[1]:
            if ml_key(line) in mimes:
                ids = [x for x in ml_ids(line) if x != app_id]
                if ids:
                    out.append(ml_key(line) + '=' + ';'.join(ids) + ';')
                continue
            out.append(line)
        s[1] = out
    return ml_text(secs)


def mimeapps_without(text, mimes, heads=(DEFAULTS,)):
    """mimeapps.list text with no lines for these mimes in these sections."""
    secs = ml_parse(text)
    for s in secs:
        if s[0] in heads:
            s[1] = [line for line in s[1] if ml_key(line) not in mimes]
    return ml_text(secs)


def mimeapps_tidy(text, installed, ours=('hearth-', 'nimbus-')):
    """Takes Hearth's apps (ids starting with `ours`) that aren't installed out of the defaults and added
    associations; a type left with no app loses its line. Other apps' lines are never touched."""
    secs = ml_parse(text)
    for s in secs:
        if s[0] not in (DEFAULTS, ADDED):
            continue
        out = []
        for line in s[1]:
            k = ml_key(line)
            if k is None:
                out.append(line)
                continue
            ids = ml_ids(line)
            keep = [x for x in ids if x in installed or not x.startswith(ours)]
            if keep == ids:
                out.append(line)
            elif keep:
                out.append(k + '=' + ';'.join(keep) + ';')
        s[1] = out
    return ml_text(secs)


def mimeapps_merge(text, table, installed=None):
    """A system list with table ({mime: id}) as its defaults: those types' lines replaced, everything else kept (a
    Hearth app that isn't in the image taken out when installed is given), table's lines in order."""
    if installed is not None:
        text = mimeapps_tidy(text, installed)
    secs = ml_parse(text)
    d = ml_section(secs, DEFAULTS)
    d[1] = [line for line in d[1] if ml_key(line) not in table]
    while d[1] and not d[1][-1].strip():
        d[1].pop()
    d[1] += ['%s=%s;' % (m, table[m]) for m in table]
    if not any(SYSTEM_LIST_NOTE.splitlines()[0] in line for line in secs[0][1]):
        secs[0][1] = SYSTEM_LIST_NOTE.splitlines() + secs[0][1]
    return ml_text(secs)


# ---- Hearth's own defaults (the system lists)
def mime_list(fields):
    return [t.strip() for t in fields.get('MimeType', '').split(';') if t.strip() and '*' not in t]


def hearth_rank(did):
    return (HEARTH_RANK.index(did), '') if did in HEARTH_RANK else (len(HEARTH_RANK), did)


def only_for_some_desktops(fields):
    return bool(fields.get('OnlyShowIn', '').strip(';') or fields.get('NotShowIn', '').strip(';'))


def category_order():
    order = {}
    for c in CATEGORIES:
        for m in c['mimes']:
            order.setdefault(m, len(order))
    return order


def system_defaults(apps):
    """apps: {id: fields} of Hearth's own apps. -> (Desktop Mode's table, every desktop's table): {mime: id}, the
    first app in HEARTH_RANK that opens a type; every desktop's leaves out apps only for some desktops
    (OnlyShowIn=Nimbus: Hearth Files), but for folders (EVERY_DESKTOP_TOO)."""
    order = category_order()

    def table(ids, also=()):
        out = {}
        for did in sorted(ids, key=hearth_rank):
            for m in mime_list(apps[did]):
                out.setdefault(m, did)
        for did in sorted(apps, key=hearth_rank):
            for m in mime_list(apps[did]):
                if m in also:
                    out.setdefault(m, did)
        return {m: out[m] for m in sorted(out, key=lambda m: (order.get(m, len(order)), m))}
    return table(list(apps)), table([d for d in apps if not only_for_some_desktops(apps[d])], EVERY_DESKTOP_TOO)


def hearth_apps(apps_dir, hf):
    """Hearth's own apps in an applications folder: {id: fields}, the ones that can start."""
    out = {}
    try:
        names = sorted(os.listdir(apps_dir))
    except OSError:
        return out
    for name in names:
        if not (name.startswith('hearth-') and name.endswith('.desktop')):
            continue
        fields = hf.parse_desktop(os.path.join(apps_dir, name))
        if fields and hf.usable(fields):
            out[name] = fields
    return out


def defaults_system(root='/', hf=None):
    """Writes Hearth's defaults into the image's lists (run by os-bases/*/build.sh once every app is in)."""
    hf = hf or load_files_helper()
    apps_dir = os.path.join(root, 'usr/share/applications')
    apps = hearth_apps(apps_dir, hf)
    nimbus, generic = system_defaults(apps)
    installed = set(os.listdir(apps_dir)) if os.path.isdir(apps_dir) else set()
    nimbus_list = os.path.join(root, 'etc/xdg/nimbus-mimeapps.list')
    generic_list = os.path.join(apps_dir, 'mimeapps.list')
    write_atomic(nimbus_list, mimeapps_merge(read(nimbus_list), nimbus, installed))
    write_atomic(generic_list, mimeapps_merge(read(generic_list), generic, installed))
    per_app = {}
    for m, did in nimbus.items():
        per_app.setdefault(did, []).append(m)
    return {'ok': True, 'apps': sorted(apps), 'types': len(nimbus), 'everyDesktop': len(generic),
            'byApp': {d: len(v) for d, v in sorted(per_app.items())}, 'files': [nimbus_list, generic_list]}


# ---- Settings › Default apps
def entry_name(did, fields):
    return fields.get('Name') or did[:-8]


def app_option(did, fields, hearth):
    return {'id': did, 'name': entry_name(did, fields), 'icon': fields.get('Icon', ''), 'hearth': did == hearth}


def terminal_list_files(hf):
    """xdg-terminal-exec's lists, yours first: (yours to write, all of them in order)."""
    cfg = config_dir()
    dirs = [cfg] + [d for d in (os.environ.get('XDG_CONFIG_DIRS') or '/etc/xdg').split(':') if d]
    files = []
    for d in dirs:
        for desk in hf.desktops():
            files.append(os.path.join(d, desk + '-xdg-terminals.list'))
        files.append(os.path.join(d, 'xdg-terminals.list'))
    mine = os.path.join(cfg, (hf.desktops() or ['nimbus'])[0] + '-xdg-terminals.list')
    return mine, ([mine] if mine not in files else []) + files


def terminal_ids(text):
    return [l.strip() for l in text.splitlines() if l.strip().endswith('.desktop') and not l.strip().startswith('#')]


def category_current(c, hf, entries):
    """(the app it opens in now, whether that's your own choice)."""
    ok = lambda d: d in entries and hf.usable(entries[d][1])
    if c.get('terminal'):
        mine, files = terminal_list_files(hf)
        for f in files:
            for did in terminal_ids(read(f)):
                if ok(did):
                    return did, f == mine
    for f in user_lists(hf):
        text = read(f)
        if not text:
            continue
        for m in [c['primary']] + c['mimes']:
            did = next((d for d in ml_read(text, m) if ok(d)), None)
            if did:
                return did, True
    dflt, _, _ = hf.mimeapps(c['primary'])
    return next((d for d in dflt if ok(d)), None), False


def category_options(c, hf, entries, current):
    opts = []
    majors = {m.split('/')[0] + '/*' for m in c['mimes'] if m.split('/')[0] in ('image', 'video', 'audio')}
    for did, (_, fields) in entries.items():
        if not hf.usable(fields):
            continue
        cats = [x for x in fields.get('Categories', '').split(';') if x]
        if c.get('terminal'):
            hit = 'TerminalEmulator' in cats
        else:
            types = [t for t in fields.get('MimeType', '').split(';') if t]
            hit = any(m in types for m in c['mimes']) or any(m in types for m in majors)
        hidden = fields.get('NoDisplay', '').lower() == 'true'
        if hit and (not hidden or did in (current, c['hearth'])):
            opts.append(app_option(did, fields, c['hearth']))
    if current and not any(o['id'] == current for o in opts):
        opts.append(app_option(current, entries[current][1], c['hearth']))
    # Hearth's own first, then by name.
    opts.sort(key=lambda o: (not o['hearth'], o['name'].lower()))
    return opts


def defaults(hf=None):
    hf = hf or load_files_helper()
    entries = hf.desktop_entries()
    out = []
    for c in CATEGORIES:
        current, mine = category_current(c, hf, entries)
        opts = category_options(c, hf, entries, current)
        hearth_ok = bool(c['hearth'] and c['hearth'] in entries and hf.usable(entries[c['hearth']][1]))
        cur_name = entry_name(current, entries[current][1]) if current else ''
        out.append({'kind': c['kind'], 'label': c['label'], 'current': current, 'currentName': cur_name,
                    'yours': mine, 'hearth': c['hearth'] if hearth_ok else None,
                    'hearthName': entry_name(c['hearth'], entries[c['hearth']][1]) if hearth_ok else '',
                    'isHearth': bool(hearth_ok and current == c['hearth']), 'options': opts})
    return {'kinds': out}


def category(kind):
    c = next((c for c in CATEGORIES if c['kind'] == kind), None)
    if not c:
        raise Fail('unknown kind of app')
    return c


def types_for(c, fields):
    """The types picking this app sets: all of them for a category where they're all alike, else those it says it
    opens (an image viewer without HEIC keeps HEIC in the one that has it)."""
    if c.get('every'):
        return list(c['mimes'])
    types = [t for t in fields.get('MimeType', '').split(';') if t]
    majors = {t for t in types if t.endswith('/*')}
    got = [m for m in c['mimes'] if m in types or m.split('/')[0] + '/*' in majors]
    return got or [c['primary']]


def strip_desktop_lists(hf, mimes):
    """~/.config/<desktop>-mimeapps.list comes before ~/.config/mimeapps.list: these types are taken out of it."""
    cfg = config_dir()
    for desk in hf.desktops():
        p = os.path.join(cfg, desk + '-mimeapps.list')
        if os.path.exists(p):
            text = read(p)
            new = mimeapps_without(text, mimes)
            if new != text:
                write_atomic(p, new)


def default_set(kind, app_id, hf=None):
    c = category(kind)
    if not re.fullmatch(r'[A-Za-z0-9_.+-]{1,200}\.desktop', app_id or ''):
        raise Fail('not an app id')
    hf = hf or load_files_helper()
    entries = hf.desktop_entries()
    if app_id not in entries or not hf.usable(entries[app_id][1]):
        raise Fail('that app isn\'t installed')
    fields = entries[app_id][1]
    mimes = types_for(c, fields)
    path = os.path.join(config_dir(), 'mimeapps.list')
    write_atomic(path, mimeapps_with(read(path), mimes, app_id))
    strip_desktop_lists(hf, mimes)
    if c.get('terminal'):
        mine, _ = terminal_list_files(hf)
        rest = [d for d in terminal_ids(read(mine)) if d != app_id]
        write_atomic(mine, '\n'.join([app_id] + rest) + '\n')
    if kind == 'browser' and shutil.which('xdg-settings'):
        run(['xdg-settings', 'set', 'default-web-browser', app_id], timeout=15)
    return {'ok': True, 'kind': kind, 'current': app_id, 'name': entry_name(app_id, fields), 'types': mimes}


def default_reset(kind=None, hf=None):
    """Takes your own choice out (one kind, or every one), so Hearth's default applies again."""
    hf = hf or load_files_helper()
    cats = [category(kind)] if kind else CATEGORIES
    mimes = sorted({m for c in cats for m in c['mimes']})
    changed = []
    for p in user_lists(hf):
        if os.path.exists(p):
            text = read(p)
            new = mimeapps_without(text, mimes)
            if new != text:
                write_atomic(p, new)
                changed.append(p)
    if any(c.get('terminal') for c in cats):
        mine, _ = terminal_list_files(hf)
        if os.path.exists(mine):
            os.unlink(mine)
            changed.append(mine)
    return {'ok': True, 'kind': kind or 'all', 'changed': changed}


def defaults_tidy(hf=None):
    """Each sign-in: Hearth apps that aren't installed any more come out of your own lists."""
    hf = hf or load_files_helper()
    entries = hf.desktop_entries()
    installed = {d for d, (_, f) in entries.items() if hf.usable(f)}
    changed = []
    for p in user_lists(hf):
        if os.path.exists(p):
            text = read(p)
            new = mimeapps_tidy(text, installed)
            if new != text:
                write_atomic(p, new)
                changed.append(p)
    mine, _ = terminal_list_files(hf)
    if os.path.exists(mine):
        ids = terminal_ids(read(mine))
        keep = [d for d in ids if d in installed or not d.startswith(('hearth-', 'nimbus-'))]
        if keep != ids:
            if keep:
                write_atomic(mine, '\n'.join(keep) + '\n')
            else:
                os.unlink(mine)
            changed.append(mine)
    return {'ok': True, 'changed': changed}


def terminal_open(hf=None):
    """Opens your terminal (Settings › Default apps › Terminal; Mantel's Super+Enter through open.sh)."""
    hf = hf or load_files_helper()
    entries = hf.desktop_entries()
    did, _ = category_current(category('terminal'), hf, entries)
    if not did:
        raise Fail('no terminal is installed')
    full, fields = entries[did]
    try:
        words = shlex.split(fields['Exec'])
    except ValueError:
        words = fields['Exec'].split()
    # Nothing to open: the field codes (%u, %F, %i...) go.
    argv = [w.replace('%%', '%') for w in words if not re.fullmatch(r'%[a-zA-Z]', w)]
    hf.spawn(argv, cwd=os.environ.get('HOME') or HOME)
    return {'ok': True, 'app': did}


# ---------------------------------------------------------------------- accounts
def parse_people(passwd_text, group_text):
    admins = set()
    for line in group_text.splitlines():
        f = line.split(':')
        if len(f) >= 4 and f[0] in ('wheel', 'sudo', 'admin'):
            admins.update(x for x in f[3].split(',') if x)
    out = []
    for line in passwd_text.splitlines():
        f = line.split(':')
        if len(f) < 7 or not f[2].isdigit() or not 1000 <= int(f[2]) <= 59999 or f[6].endswith(('nologin', '/false')):
            continue
        out.append({'name': f[0], 'uid': int(f[2]), 'fullname': f[4].split(',')[0], 'home': f[5],
                    'admin': f[0] in admins, 'player': bool(re.match(r'^hearth-p[2-4]$', f[0]))})
    return out


def users():
    me = pwd.getpwuid(os.getuid()).pw_name
    out = parse_people(read('/etc/passwd'), read('/etc/group'))
    for u in out:
        u['me'] = u['name'] == me
        pic = ''
        for p in ([os.path.join(HOME, '.face')] if u['me'] else []) + ['/var/lib/AccountsService/icons/' + u['name']]:
            if os.path.isfile(p) and os.access(p, os.R_OK):
                pic = p
                break
        u['picture'] = pic
    out.sort(key=lambda u: (not u['me'], u['player'], u['name']))
    meinfo = next((u for u in out if u['me']), None)
    return {'users': out, 'me': me, 'admin': bool(meinfo and meinfo['admin']), 'canAdmin': os.access(ADMIN, os.X_OK)}


def picture_kind(data):
    if data.startswith(b'\x89PNG\r\n\x1a\n'):
        return 'png'
    if data.startswith(b'\xff\xd8\xff'):
        return 'jpeg'
    return None


def pictures():
    found = []
    for base in (os.path.join(HOME, 'Pictures'), '/usr/share/pixmaps/faces', '/usr/share/sddm/faces'):
        for root, dirs, files in os.walk(base):
            # Pictures and the folders right inside it (not deeper: a big photo library would take long).
            dirs[:] = sorted(d for d in dirs if not d.startswith('.'))[:20] if root == base else []
            for f in sorted(files):
                if f.lower().endswith(('.png', '.jpg', '.jpeg')) and not f.startswith('.'):
                    p = os.path.join(root, f)
                    try:
                        if os.path.getsize(p) <= 5 * 1024 * 1024:
                            found.append(p)
                    except OSError:
                        pass
                if len(found) >= 48:
                    return {'pictures': found}
    return {'pictures': found}


def picture_set(path):
    face = os.path.join(HOME, '.face')
    data = b''
    if path:
        try:
            with open(path, 'rb') as f:
                data = f.read(5 * 1024 * 1024 + 1)
        except OSError as e:
            raise Fail('couldn\'t read the picture (%s)' % (e.strerror or e))
        if len(data) > 5 * 1024 * 1024:
            raise Fail('the picture is too big (up to 5 MB)')
        if not picture_kind(data):
            raise Fail('use a PNG or JPEG picture')
        tmp = face + '.hearth-tmp'
        with open(tmp, 'wb') as f:
            f.write(data)
        os.chmod(tmp, 0o644)
        os.replace(tmp, face)
        try:
            shutil.copyfile(face, face + '.icon')
        except OSError:
            pass
    else:
        for p in (face, face + '.icon'):
            try:
                os.remove(p)
            except OSError:
                pass
    login = False
    if os.access(ADMIN, os.X_OK) and shutil.which('pkexec'):
        try:
            r = subprocess.run(['pkexec', ADMIN, 'user-picture'], input=data, capture_output=True, timeout=60)
            login = r.returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            pass
    return {'ok': True, 'picture': face if path else '', 'loginScreen': login}


# ---------------------------------------------------------------------- printers
def parse_lpstat(v_text, d_text, p_text):
    """lpstat -v, lpstat -d and lpstat -l -p (C locale) -> [{name, uri, default, state, enabled, reason, info,
    location}]."""
    printers, order = {}, []
    for line in v_text.splitlines():
        m = re.match(r'^device for ([^:]+):\s*(\S+)', line)
        if m:
            printers[m.group(1)] = {'name': m.group(1), 'uri': m.group(2), 'default': False, 'state': 'idle',
                                    'enabled': True, 'reason': '', 'info': '', 'location': ''}
            order.append(m.group(1))
    m = re.search(r'system default destination:\s*(\S+)', d_text)
    dflt = m.group(1) if m else None
    cur, first = None, False
    for line in p_text.splitlines():
        m = re.match(r'^printer (\S+) (?:is )?(idle|now printing|disabled)', line)
        if m:
            cur = printers.setdefault(m.group(1), {'name': m.group(1), 'uri': '', 'default': False, 'state': 'idle',
                                                   'enabled': True, 'reason': '', 'info': '', 'location': ''})
            if m.group(1) not in order:
                order.append(m.group(1))
            st = m.group(2)
            cur['state'] = 'printing' if st == 'now printing' else 'disabled' if st == 'disabled' else 'idle'
            cur['enabled'] = st != 'disabled'
            first = True
            continue
        if cur is None:
            continue
        s = line.strip()
        # The line right after "printer X ..." without a "Name:" is the printer's message ("Paused", "Filter failed").
        if first and s and ':' not in s:
            cur['reason'] = s
        first = False
        if s.startswith('Description:'):
            cur['info'] = s.split(':', 1)[1].strip()
        elif s.startswith('Location:'):
            cur['location'] = s.split(':', 1)[1].strip()
    for n in order:
        printers[n]['default'] = n == dflt
    return [printers[n] for n in order]


def printers():
    have = bool(shutil.which('lpstat'))
    if not have:
        return {'cups': False, 'printers': [], 'configTool': bool(shutil.which('system-config-printer')),
                'canAdmin': os.access(ADMIN, os.X_OK)}
    cv, v = run(['lpstat', '-v'])
    cd, d = run(['lpstat', '-d'])
    cp, p = run(['lpstat', '-l', '-p'])
    running = not re.search(r'(?i)scheduler is not running|unable to connect|connection refused', v + d + p)
    return {'cups': running, 'printers': parse_lpstat(v, d, p) if running else [],
            'configTool': bool(shutil.which('system-config-printer')), 'canAdmin': os.access(ADMIN, os.X_OK)}


TESTPAGE = ['/usr/share/cups/data/testprint', '/usr/share/cups/data/default-testpage.pdf', '/usr/share/cups/data/testprint.ps']


def printer_test(name):
    if not PRINTER_NAME_RE.fullmatch(name or ''):
        raise Fail('not a printer name')
    page = next((p for p in TESTPAGE if os.path.exists(p)), None)
    if page:
        code, out = run(['lp', '-d', name, '-t', 'Hearth test page', page], timeout=60)
    else:
        text = 'Hearth test page\n\nIf you can read this, %s works.\n' % name
        code, out = run(['lp', '-d', name, '-t', 'Hearth test page'], timeout=60, input=text)
    if code != 0:
        raise Fail('couldn\'t print (%s)' % ((out.strip().splitlines() or ['lp failed'])[-1]))
    m = re.search(r'request id is (\S+)', out)
    return {'ok': True, 'job': m.group(1) if m else ''}


# ---------------------------------------------------------------------- command line
def main(argv):
    c = argv[1] if len(argv) > 1 else ''
    a = argv[2:]
    if c == 'time' and not a:
        out = time_status()
    elif c == 'timezones' and not a:
        out = timezones()
    elif c == 'keyboard' and not a:
        out = keyboard_status()
    elif c == 'keyboard-layouts' and not a:
        out = keyboard_layouts()
    elif c == 'keyboard-set' and not a:
        out = keyboard_set(sys.stdin.read())
    elif c == 'pointer' and not a:
        out = pointer_status()
    elif c == 'pointer-set' and not a:
        out = pointer_set(sys.stdin.read())
    elif c == 'labwc-config' and not a:
        print(labwc_config())
        return
    elif c == 'shortcuts' and not a:
        out = shortcuts()
    elif c == 'defaults' and not a:
        out = defaults()
    elif c == 'default-set' and len(a) == 2:
        out = default_set(a[0], a[1])
    elif c == 'default-reset' and len(a) <= 1:
        out = default_reset(a[0] if a else None)
    elif c == 'defaults-tidy' and not a:
        out = defaults_tidy()
    elif c == 'defaults-system' and len(a) <= 1:
        out = defaults_system(a[0] if a else '/')
    elif c == 'terminal-open' and not a:
        out = terminal_open()
    elif c == 'users' and not a:
        out = users()
    elif c == 'pictures' and not a:
        out = pictures()
    elif c == 'picture-set' and len(a) == 1:
        out = picture_set(a[0])
    elif c == 'printers' and not a:
        out = printers()
    elif c == 'printer-test' and len(a) == 1:
        out = printer_test(a[0])
    else:
        print('usage: hearth-system time | timezones | keyboard | keyboard-layouts | keyboard-set | pointer | pointer-set | labwc-config | '
              'shortcuts | defaults | default-set KIND APP_ID | default-reset [KIND] | defaults-tidy | defaults-system [ROOT] | '
              'terminal-open | users | pictures | picture-set PATH | printers | '
              'printer-test NAME')
        sys.exit(2)
    print(json.dumps(out), flush=True)


if __name__ == '__main__':
    try:
        main(sys.argv)
    except Fail as e:
        print('error: ' + str(e), flush=True)
        sys.exit(1)
    except OSError as e:
        print('error: ' + (e.strerror or str(e)), flush=True)
        sys.exit(1)
