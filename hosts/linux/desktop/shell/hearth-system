              'leftHanded': ('bool', 'leftHanded'), 'accel': (('adaptive', 'flat'), 'accelProfile')},
    'touchpad': {'speed': ('speed', 'pointerSpeed'), 'natural': ('bool', 'naturalScroll'), 'tap': ('bool', 'tap'),
                 'dwt': ('bool', 'disableWhileTyping'), 'scroll': (('twofinger', 'edge'), 'scrollMethod'),
