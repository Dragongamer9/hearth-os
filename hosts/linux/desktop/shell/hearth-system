class Fail(Exception):
    pass


def run(cmd, timeout=30, input=None):
    """(code, stdout) with C-locale output; (127, '') when the command isn't there."""
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, input=input,
                           env=dict(os.environ, LC_ALL='C'))
        return r.returncode, r.stdout + (r.stderr if r.returncode else '')
    except (OSError, subprocess.TimeoutExpired):
        return 127, ''


def write_atomic(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + '.hearth-tmp'
    with open(tmp, 'w') as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def read(path, default=''):
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            return f.read()
    except OSError:
        return default


# ---------------------------------------------------------------------- date and time
def parse_timedatectl(text):
    """`timedatectl show` (Key=value lines) -> {timezone, ntp, synced, canNtp}."""
    kv = {}
    for line in text.splitlines():
        if '=' in line:
            k, v = line.split('=', 1)
            kv[k.strip()] = v.strip()
    return {'timezone': kv.get('Timezone', ''), 'ntp': kv.get('NTP') == 'yes',
            'synced': kv.get('NTPSynchronized') == 'yes', 'canNtp': kv.get('CanNTP', 'yes') == 'yes'}


def time_status():
    code, out = run(['timedatectl', 'show'])
    st = parse_timedatectl(out) if code == 0 else {'timezone': '', 'ntp': False, 'synced': False, 'canNtp': False}
    if not st['timezone']:
        link = os.path.realpath('/etc/localtime')
        st['timezone'] = link.split('/zoneinfo/', 1)[1] if '/zoneinfo/' in link else 'UTC'
    st['available'] = code == 0
    st['now'] = datetime.datetime.now().astimezone().isoformat(timespec='seconds')
    st['admin'] = os.access(ADMIN, os.X_OK)
    return st


def utc_offset(zone, when=None):
    """'+05:30' / '-08:00' for a zone now (or '' if the zone can't be read)."""
    try:
        from zoneinfo import ZoneInfo
        off = (when or datetime.datetime.now(datetime.timezone.utc)).astimezone(ZoneInfo(zone)).utcoffset()
    except Exception:
        return ''
    mins = int(off.total_seconds() // 60)
    sign = '+' if mins >= 0 else '-'
    return '%s%02d:%02d' % (sign, abs(mins) // 60, abs(mins) % 60)


def zone_entry(zone, when=None):
    parts = zone.split('/')
    region = parts[0] if len(parts) > 1 else 'Other'
    city = ' / '.join(p.replace('_', ' ') for p in parts[1:]) if len(parts) > 1 else zone.replace('_', ' ')
    return {'zone': zone, 'region': region.replace('_', ' '), 'city': city, 'offset': utc_offset(zone, when)}


def parse_timezones(text, when=None):
    """timedatectl list-timezones -> [{zone, region, city, offset}], sorted by region then city."""
    zones = [z.strip() for z in text.splitlines() if re.fullmatch(r'[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}', z.strip())]
    out = [zone_entry(z, when) for z in dict.fromkeys(zones)]
    return sorted(out, key=lambda z: (z['region'] == 'Other', z['region'], z['city']))


def timezones():
    code, out = run(['timedatectl', 'list-timezones'])
    if code != 0 or not out.strip():
        names = []
        for region in ('Africa', 'America', 'Antarctica', 'Arctic', 'Asia', 'Atlantic', 'Australia', 'Europe',
                       'Indian', 'Pacific'):
            for root, _, files in os.walk(os.path.join(ZONEINFO, region)):
                names += [os.path.relpath(os.path.join(root, f), ZONEINFO) for f in files]
        out = '\n'.join(sorted(names) + ['UTC'])
    return {'zones': parse_timezones(out)}


# ---------------------------------------------------------------------- keyboard
def parse_xkb_lst(text):
    """evdev.lst -> [{layout, variant, name}] (layouts, then each layout's variants)."""
    section, layouts, variants = None, [], []
    for line in text.splitlines():
        if line.startswith('!'):
            section = line[1:].strip()
            continue
        m = re.match(r'^\s+(\S+)\s+(.*\S)\s*$', line)
        if not m:
            continue
        if section == 'layout':
            layouts.append({'layout': m.group(1), 'variant': '', 'name': m.group(2)})
        elif section == 'variant':
            lay, _, desc = m.group(2).partition(':')
            if desc:
                variants.append({'layout': lay.strip(), 'variant': m.group(1), 'name': desc.strip()})
    out = []
    for l in sorted(layouts, key=lambda l: l['name'].lower()):
        out.append(l)
        out += sorted((v for v in variants if v['layout'] == l['layout']), key=lambda v: v['name'].lower())
    return out


def keyboard_layouts():
    for f in XKB_RULES:
        text = read(f)
        if text:
            return {'layouts': parse_xkb_lst(text)}
    return {'layouts': [{'layout': 'us', 'variant': '', 'name': 'English (US)'}]}


def parse_env(text):
    """labwc's environment file -> {KEY: value} (comments and blank lines skipped)."""
    out = {}
    for line in text.splitlines():
        s = line.strip()
        if not s or s.startswith('#') or '=' not in s:
            continue
        k, v = s.split('=', 1)
        out[k.strip()] = v.strip().strip('"\'')
    return out


def layouts_from_env(env):
    lays = [x.strip() for x in env.get('XKB_DEFAULT_LAYOUT', '').split(',')]
    vars_ = [x.strip() for x in env.get('XKB_DEFAULT_VARIANT', '').split(',')]
    out = []
    for i, l in enumerate(lays):
        if l:
            out.append({'layout': l, 'variant': vars_[i] if i < len(vars_) else ''})
    return out


def keyboard_status():
    env = parse_env(read(LABWC_ENV))
    if not env.get('XKB_DEFAULT_LAYOUT'):
        # Not set here yet: what the session started with (labwc's own environment file or the system's).
        env = dict(parse_env(read(os.path.join(LABWC_DIR, 'environment'))), **{k: v for k, v in env.items() if v})
    lays = layouts_from_env(env) or [{'layout': os.environ.get('XKB_DEFAULT_LAYOUT', 'us').split(',')[0] or 'us', 'variant': ''}]
    opts = [o for o in env.get('XKB_DEFAULT_OPTIONS', '').split(',') if o]
    switch = next((o for o in opts if o.startswith('grp:')), '')
    try:
        saved = json.loads(read(KEYBOARD_JSON, '{}'))
    except ValueError:
        saved = {}
    names = {(l['layout'], l['variant']): l['name'] for l in keyboard_layouts()['layouts']}
    for l in lays:
        l['name'] = names.get((l['layout'], l['variant'])) or names.get((l['layout'], '')) or l['layout']
    return {'layouts': lays, 'switch': switch, 'switchOptions': SWITCH_OPTIONS,
            'delay': int(saved.get('delay') or REPEAT_DEFAULT['delay']), 'rate': int(saved.get('rate') or REPEAT_DEFAULT['rate']),
            'live': bool(os.environ.get('LABWC_PID')), 'configDir': runtime_dir() if os.path.isdir(runtime_dir()) else ''}


def keyboard_request(req, known):
    """Checks keyboard-set's request; returns (layouts, switch, delay, rate) or raises Fail."""
    if not isinstance(req, dict):
        raise Fail('expected a JSON object')
    lays = req.get('layouts')
    if not isinstance(lays, list) or not 1 <= len(lays) <= 4:
        raise Fail('choose 1 to 4 layouts')
    out = []
    for l in lays:
        if not isinstance(l, dict):
            raise Fail('bad layout')
        lay, var = l.get('layout'), l.get('variant') or ''
        if not isinstance(lay, str) or not LAYOUT_RE.fullmatch(lay) or not isinstance(var, str) or not VARIANT_RE.fullmatch(var):
            raise Fail('bad layout name')
        if known is not None and (lay, var) not in known:
            raise Fail('unknown layout %s%s' % (lay, ('(' + var + ')') if var else ''))
        if (lay, var) in [(o['layout'], o['variant']) for o in out]:
            continue
        out.append({'layout': lay, 'variant': var})
    switch = req.get('switch') or ''
    if switch not in SWITCH_OPTIONS:
        raise Fail('unknown switch shortcut')
    try:
        delay = int(req.get('delay', REPEAT_DEFAULT['delay']))
        rate = int(req.get('rate', REPEAT_DEFAULT['rate']))
    except (TypeError, ValueError):
        raise Fail('delay and rate must be numbers')
    if not 150 <= delay <= 2000 or not 1 <= rate <= 80:
        raise Fail('the repeat delay is 150–2000 ms and the rate 1–80 per second')
    return out, switch, delay, rate


def env_text(old, values):
    """old environment file text with these keys set (each once, in place, or added at the end)."""
    lines, done = [], set()
    for line in old.splitlines():
        s = line.strip()
        k = s.split('=', 1)[0].strip() if '=' in s and not s.startswith('#') else None
        if k in values:
            if k not in done:
                lines.append('%s=%s' % (k, values[k]))
                done.add(k)
            continue
        lines.append(line)
    missing = [k for k in values if k not in done]
    if missing:
        if lines and lines[-1].strip():
            lines.append('')
        lines.append('# Keyboard (Hearth Settings › Keyboard)')
        lines += ['%s=%s' % (k, values[k]) for k in missing]
    return '\n'.join(lines) + '\n'


def xkb_values(lays, switch, old_options):
    opts = [o for o in old_options.split(',') if o and not o.startswith('grp:')]
    if switch and len(lays) > 1:
        opts.append(switch)
    return {'XKB_DEFAULT_LAYOUT': ','.join(l['layout'] for l in lays),
            'XKB_DEFAULT_VARIANT': ','.join(l['variant'] for l in lays) if any(l['variant'] for l in lays) else '',
            'XKB_DEFAULT_OPTIONS': ','.join(opts)}


def rc_with_repeat(text, delay, rate):
    """labwc rc.xml text with <repeatRate>/<repeatDelay> in <keyboard> (replaced, or added after <keyboard>)."""
    if not re.search(r'<keyboard\s*>', text):
        if re.search(r'<keyboard\s*/>', text):
            text = re.sub(r'<keyboard\s*/>', '<keyboard></keyboard>', text, count=1)
        else:
            text = re.sub(r'</labwc_config>', '  <keyboard></keyboard>\n</labwc_config>', text, count=1)
    for tag, val in (('repeatRate', rate), ('repeatDelay', delay)):
        if re.search(r'<%s>\s*\d+\s*</%s>' % (tag, tag), text):
            text = re.sub(r'<%s>\s*\d+\s*</%s>' % (tag, tag), '<%s>%d</%s>' % (tag, val, tag), text)
        else:
            text = re.sub(r'(<keyboard\s*>)', r'\1\n    <%s>%d</%s>' % (tag, val, tag), text, count=1)
    return text


def runtime_dir():
    return os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'hearth-labwc')


def keyboard_saved():
    try:
        saved = json.loads(read(KEYBOARD_JSON, '{}'))
        return int(saved.get('delay') or REPEAT_DEFAULT['delay']), int(saved.get('rate') or REPEAT_DEFAULT['rate'])
    except (ValueError, TypeError, AttributeError):
        return REPEAT_DEFAULT['delay'], REPEAT_DEFAULT['rate']


# ---------------------------------------------------------------------- mouse and touchpad
def pointer_clean(raw):
    """Mouse and touchpad settings with anything odd dropped (defaults for what's missing)."""
    out = {k: dict(v) for k, v in POINTER_DEFAULT.items()}
    if not isinstance(raw, dict):
        return out
    for dev, keys in POINTER_KEYS.items():
        got = raw.get(dev)
        if not isinstance(got, dict):
            continue
        for k, (kind, _) in keys.items():
            v = got.get(k)
            if kind == 'speed' and isinstance(v, (int, float)) and not isinstance(v, bool):
                out[dev][k] = round(max(-1.0, min(1.0, float(v))), 2)
            elif kind == 'bool' and isinstance(v, bool):
                out[dev][k] = v
            elif isinstance(kind, tuple) and v in kind:
                out[dev][k] = v
    return out


def pointer_saved():
    try:
        return pointer_clean(json.loads(read(POINTER_JSON, '{}')))
    except ValueError:
        return pointer_clean(None)


def has_touchpad(devices_text=None):
    """A touchpad is connected (from /proc/bus/input/devices: a device named ...Touchpad / Trackpad, or one
    libinput would treat as a touchpad: absolute X/Y with finger-count buttons)."""
    text = devices_text if devices_text is not None else read('/proc/bus/input/devices')
    for block in text.split('\n\n'):
        name = re.search(r'^N: Name="(.*)"', block, re.M)
        if name and re.search(r'touch ?pad|trackpad|glidepoint|clickpad', name.group(1), re.I):
            return True
    return False


def pointer_status():
    return dict(pointer_saved(), hasTouchpad=has_touchpad())


def libinput_xml(settings):
    """labwc's <libinput> block for these settings (one <device> per kind)."""
    lines = ['  <!-- Your mouse and touchpad (Hearth Settings › Mouse & touchpad) -->', '  <libinput>']
    for dev in ('mouse', 'touchpad'):
        lines.append('    <device category="%s">' % LABWC_CATEGORY[dev])
        for k, (kind, tag) in POINTER_KEYS[dev].items():
            v = settings[dev][k]
            text = ('%.2f' % v) if kind == 'speed' else ('yes' if v else 'no') if kind == 'bool' else v
            lines.append('      <%s>%s</%s>' % (tag, text, tag))
        lines.append('    </device>')
    lines.append('  </libinput>')
    return '\n'.join(lines) + '\n'


def rc_with_pointer(text, settings):
    """rc.xml text with its <libinput> block replaced by (or given) one for these settings."""
    block = libinput_xml(settings)
    if re.search(r'<libinput\b', text):
        text = re.sub(r'[ \t]*(<!--[^>]*Mouse & touchpad[^>]*-->\s*)?<libinput\b.*?</libinput>\s*\n?', '', text, count=1, flags=re.S)
    return re.sub(r'</labwc_config>', block.replace('\\', '\\\\') + '</labwc_config>', text, count=1)


def pointer_set(raw):
    try:
        req = json.loads(raw or 'null')
    except ValueError:
        raise Fail('expected JSON on stdin')
    if not isinstance(req, dict):
        raise Fail('expected {"mouse": {...}, "touchpad": {...}}')
    merged = pointer_saved()
    for dev in POINTER_KEYS:
        if isinstance(req.get(dev), dict):
            merged[dev].update(req[dev])
    settings = pointer_clean(merged)
    write_atomic(POINTER_JSON, json.dumps(settings, indent=2) + '\n')
    live = False
    if os.path.isdir(runtime_dir()):
        labwc_config()
        live = True
    reloaded = False
    if os.environ.get('LABWC_PID') and shutil.which('labwc'):
        reloaded = run(['labwc', '--reconfigure'])[0] == 0
    return dict(settings, ok=True, reloaded=reloaded and live, hasTouchpad=has_touchpad())


def labwc_config(src=None, dest=None):
    """Desktop Mode's labwc folder with your keyboard and mouse settings: Hearth's own files (linked), its
    environment file with your ~/.config/labwc/environment keyboard lines after it, and its rc.xml with your key
    repeat and your mouse and touchpad settings."""
    src = src or LABWC_DIR
    dest = dest or runtime_dir()
    os.makedirs(dest, mode=0o700, exist_ok=True)
    for name in os.listdir(src):
        if name in ('environment', 'rc.xml'):
            continue
        link = os.path.join(dest, name)
        if os.path.islink(link) or os.path.exists(link):
            if os.path.islink(link) and os.readlink(link) == os.path.join(src, name):
                continue
            os.remove(link)
        os.symlink(os.path.join(src, name), link)
    user = parse_env(read(LABWC_ENV))
    mine = {k: v for k, v in user.items() if k.startswith('XKB_DEFAULT_')}
    env = read(os.path.join(src, 'environment'))
    if mine:
        env = env.rstrip('\n') + '\n\n# Your keyboard (Hearth Settings › Keyboard, ~/.config/labwc/environment)\n' + \
            ''.join('%s=%s\n' % kv for kv in sorted(mine.items()))
    # ---- Accessibility (hearth-access, Settings › Accessibility): text size, high contrast, pointer, screen reader
    access = load_access_helper()
    if access:
        env = env.rstrip('\n') + '\n' + access.env_lines()
    # ---- end Accessibility
    write_atomic(os.path.join(dest, 'environment'), env)
    delay, rate = keyboard_saved()
    rc = rc_with_repeat(read(os.path.join(src, 'rc.xml')), delay, rate)
    if os.path.exists(POINTER_JSON):
        rc = rc_with_pointer(rc, pointer_saved())
    # ---- Accessibility: the magnifier's size and steps, window titles at your text size
    if access:
        rc = access.rc_with_access(rc)
    # ---- end Accessibility
    write_atomic(os.path.join(dest, 'rc.xml'), rc)
    return dest


# ---- Accessibility (hearth-access, next to this file)
def load_access_helper():
    """hearth-access as a module, or None (an older shell folder without it, or a broken one: never stops Desktop Mode)."""
    path = os.path.join(HERE, 'hearth-access')
    if not os.path.exists(path):
        return None
    try:
        loader = importlib.machinery.SourceFileLoader('hearth_access', path)
        spec = importlib.util.spec_from_loader('hearth_access', loader)
        mod = importlib.util.module_from_spec(spec)
        loader.exec_module(mod)
        return mod
    except Exception:
        return None
# ---- end Accessibility


def keyboard_set(raw):
    try:
        req = json.loads(raw or 'null')
    except ValueError:
        raise Fail('expected JSON on stdin')
    known = {(l['layout'], l['variant']) for l in keyboard_layouts()['layouts']}
    lays, switch, delay, rate = keyboard_request(req, known if len(known) > 1 else None)
    old = read(LABWC_ENV)
    values = xkb_values(lays, switch, parse_env(old).get('XKB_DEFAULT_OPTIONS', ''))
    write_atomic(LABWC_ENV, env_text(old, values))
    write_atomic(KEYBOARD_JSON, json.dumps({'layouts': lays, 'switch': switch, 'delay': delay, 'rate': rate}, indent=2) + '\n')
    live = False
    if os.path.isdir(runtime_dir()):
        labwc_config()
        live = True
    reloaded = False
    if os.environ.get('LABWC_PID') and shutil.which('labwc'):
        reloaded = run(['labwc', '--reconfigure'])[0] == 0
    return {'ok': True, 'reloaded': reloaded and live, 'needsSignIn': not (reloaded and live)}


