#!/usr/bin/env python3
"""hearth-kbd-lights: the keyboard's RGB lights follow Hearth's accent colour (Settings › Look › Appearance,
"Keyboard lights follow the accent"; KDE Plasma 6.1's feature, written for Hearth). Off unless you turn it on.

  hearth-kbd-lights status          one JSON line: which way would colour the keyboard here (only reads)
  hearth-kbd-lights apply '#rrggbb' colour the keyboard (only when the switch is on in desktop.json)

Which way:
  * OpenRGB, when it's installed (`openrgb` on PATH): every device it lists as a Keyboard is set to that colour
    (static), and nothing else (your mouse, fans and the rest stay as they are).
  * Otherwise the kernel's multicolour LED class: /sys/class/leds/*::kbd_backlight* with a multi_intensity file (many
    laptops; 70-hearth-backlight.rules lets the video group write it). Only the colour changes: how bright the
    keyboard is (its brightness file, the keyboard light keys) is left alone, so a light that's off stays off.

Safe by design: with the switch off (or desktop.json unreadable) `apply` writes nothing at all and says so; anything
that fails prints "error: ..." and exits 1 (Mantel only logs it: nothing else depends on it).
"""
import glob
import json
import os
import re
import shutil
import subprocess
import sys

LEDS = os.environ.get('HEARTH_LEDS_DIR', '/sys/class/leds')
OPENRGB_TIMEOUT = 25


def settings_file():
    """Mantel's settings (Settings.qml reads the same file: ~/.local/share/nimbus/desktop.json)."""
    return os.path.join(os.environ.get('HOME', '/'), '.local', 'share', 'nimbus', 'desktop.json')


def switched_on():
    """The switch, read straight from desktop.json (read only): anything but a readable true is off."""
    try:
        with open(settings_file(), encoding='utf-8') as f:
            o = json.load(f)
        return isinstance(o, dict) and o.get('kbdLights') is True
    except (OSError, ValueError):
        return False


def kernel_leds():
    """The multicolour keyboard lights: [{name, path, index: ['red', 'green', 'blue'], max, writable}]."""
    out = []
    for d in sorted(glob.glob(os.path.join(LEDS, '*kbd_backlight*'))):
        mi = os.path.join(d, 'multi_intensity')
        if not os.path.isfile(mi):
            continue
        try:
            with open(os.path.join(d, 'multi_index')) as f:
                index = f.read().split()
        except OSError:
            index = ['red', 'green', 'blue']
        try:
            with open(os.path.join(d, 'max_brightness')) as f:
                mx = int(f.read().strip() or 255)
        except (OSError, ValueError):
            mx = 255
        out.append({'name': os.path.basename(d), 'path': mi, 'index': index, 'max': max(1, mx), 'writable': os.access(mi, os.W_OK)})
    return out


def openrgb_keyboards(text):
    """Device numbers OpenRGB's --list-devices calls a Keyboard ("0: Name" then "  Type: Keyboard")."""
    found, cur = [], None
    for line in text.splitlines():
        m = re.match(r'^(\d+):\s', line)
        if m:
            cur = int(m.group(1))
            continue
        m = re.match(r'^\s+Type:\s*(.+?)\s*$', line)
        if m and cur is not None and m.group(1).lower() == 'keyboard' and cur not in found:
            found.append(cur)
    return found


def intensities(rgb, index, mx):
    """multi_intensity's numbers for '#rrggbb', in the order multi_index names the colours (others 0)."""
    r, g, b = int(rgb[1:3], 16), int(rgb[3:5], 16), int(rgb[5:7], 16)
    by = {'red': r, 'green': g, 'blue': b}
    return [round(by.get(c, 0) * mx / 255) for c in index]


def status():
    leds = kernel_leds()
    rgb = shutil.which('openrgb')
    way = 'openrgb' if rgb else 'kernel' if leds else 'none'
    return {'on': switched_on(), 'way': way, 'openrgb': bool(rgb),
            'leds': [{'name': l['name'], 'writable': l['writable']} for l in leds]}


def apply(color):
    if not re.fullmatch(r'#[0-9a-fA-F]{6}', color or ''):
        raise SystemExit('error: a colour looks like #1a9fff')
    if not switched_on():
        print(json.dumps({'ok': True, 'skipped': 'off', 'wrote': 0}))
        return
    color = color.lower()
    rgb = shutil.which('openrgb')
    if rgb:
        try:
            listed = subprocess.run([rgb, '--list-devices'], capture_output=True, text=True, timeout=OPENRGB_TIMEOUT).stdout
        except (OSError, subprocess.SubprocessError) as e:
            raise SystemExit('error: OpenRGB did not answer (%s)' % e)
        kbs = openrgb_keyboards(listed)
        done = 0
        for n in kbs:
            try:
                r = subprocess.run([rgb, '--device', str(n), '--mode', 'static', '--color', color[1:]],
                                   capture_output=True, text=True, timeout=OPENRGB_TIMEOUT)
                done += r.returncode == 0
            except (OSError, subprocess.SubprocessError):
                pass
        if kbs:
            print(json.dumps({'ok': done > 0, 'way': 'openrgb', 'wrote': done}))
            return
    leds = kernel_leds()
    if not leds:
        raise SystemExit('error: no keyboard with coloured lights was found (OpenRGB or the kernel\'s multicolour LEDs)')
    wrote = 0
    for l in leds:
        try:
            with open(l['path'], 'w') as f:
                f.write(' '.join(str(v) for v in intensities(color, l['index'], l['max'])) + '\n')
            wrote += 1
        except OSError:
            pass
    if not wrote:
        raise SystemExit('error: the keyboard\'s lights can\'t be changed by this account (multi_intensity)')
    print(json.dumps({'ok': True, 'way': 'kernel', 'wrote': wrote}))


def main(argv):
    if argv[:1] == ['status']:
        print(json.dumps(status()))
        return 0
    if argv[:1] == ['apply'] and len(argv) == 2:
        apply(argv[1])
        return 0
    print(__doc__.strip(), file=sys.stderr)
    return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
