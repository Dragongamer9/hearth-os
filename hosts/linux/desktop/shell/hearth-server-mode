# ------------------------------------------------------------------ settings (only what you change is written)

def load():
    return sio.with_defaults(sio.load_json(SETTINGS, {}), DEFAULTS)


def peek():
    """Your choices without repairing anything (the agent, the web server, the session: read only)."""
    raw = sio.load_json(SETTINGS, {}, repair=False) if os.path.exists(SETTINGS) else {}
    return sio.with_defaults(raw if isinstance(raw, dict) else {}, DEFAULTS)


def get_path(d, path):
    for k in path:
        d = d.get(k) if isinstance(d, dict) else None
    return d


def set_key(key, raw):
    if key in BOOL:
        if raw not in ('on', 'off'):
            raise Fail('on or off')
        v, path = raw == 'on', BOOL[key]
    elif key in CHOICE:
        if not re.fullmatch(r'\d{1,3}', raw or '') or int(raw) not in CHOICE[key]:
            raise Fail('one of ' + ', '.join(str(x) for x in CHOICE[key]))
        v, path = int(raw), (key,)
    else:
        raise Fail('Unknown setting')
    if get_path(load(), path) == v:
        return False

    def change(d):
        node = d
        for k in path[:-1]:
            nxt = node.get(k)
            node[k] = dict(nxt) if isinstance(nxt, dict) else {}
            node = node[k]
        node[path[-1]] = v
    sio.update_json(SETTINGS, change)
    return True


def clean_changes(items):
    if not isinstance(items, list) or not 1 <= len(items) <= 8:
        raise Fail('1 to 8 changes a day')
    seen, outl = set(), []
    for it in items:
        if not isinstance(it, dict) or not TIME_RE.match(str(it.get('at', ''))) or it.get('mode') not in MODES:
            raise Fail('each change needs a time like 18:00 and a mode (server, game or desktop)')
        if it['at'] in seen:
            raise Fail('two changes at %s' % it['at'])
        seen.add(it['at'])
        outl.append({'at': it['at'], 'mode': it['mode']})
    return sorted(outl, key=lambda x: x['at'])


def schedule_set(text):
    try:
        req = json.loads(text or '')
    except ValueError:
        raise Fail('the schedule must be JSON')
    if not isinstance(req, dict):
        raise Fail('the schedule must be a JSON object')
    new = {'weekday': clean_changes(req.get('weekday')), 'weekend': clean_changes(req.get('weekend'))}
    cur = load()['schedule']
    if cur.get('weekday') == new['weekday'] and cur.get('weekend') == new['weekend']:
        return False

    def change(d):
        s = dict(d.get('schedule')) if isinstance(d.get('schedule'), dict) else {}
        s.update(new)
        d['schedule'] = s
    sio.update_json(SETTINGS, change)
    return True


def schedule_mode(sched, now=None):
    """The mode the schedule says for NOW (a time.struct_time), or '' when it's off or unusable."""
    if not isinstance(sched, dict) or sched.get('on') is not True:
        return ''
    t = time.localtime() if now is None else now
    day = 'weekend' if t.tm_wday >= 5 else 'weekday'
    try:
        items = clean_changes(sched.get(day))
    except Fail:
        return ''
    hm = '%02d:%02d' % (t.tm_hour, t.tm_min)
    mode = items[-1]['mode']           # before the first change of the day: the last one's (it runs past midnight)
    for it in items:
        if it['at'] <= hm:
            mode = it['mode']
    return mode


def start_in(mode=None):
    """session.conf's NIMBUS_START_MODE: printed, or set (only that line; atomic, .bak, under the lock)."""
    if mode is None:
        try:
            text = open(SESSION_CONF, encoding='utf-8', errors='replace').read()
        except OSError:
            text = ''
        found = re.findall(r'''^[ \t]*(?:export[ \t]+)?NIMBUS_START_MODE=["']?([a-z]*)''', text, re.M)
        m = found[-1] if found else ''
        return m if m in MODES else 'game'
    if mode not in MODES:
        raise Fail('game, desktop or server')
    if mode == start_in():
        return mode
    os.makedirs(os.path.dirname(SESSION_CONF), exist_ok=True)
    sio.update_text(SESSION_CONF, lambda t: sio.conf_set_text(t, 'NIMBUS_START_MODE', mode))
    return mode


def start_mode(conf_mode):
    """What the session starts in: the schedule's mode when it's on (and Server mode is on), else CONF_MODE. Server mode
    asked for while it's off is Game Mode."""
    s = peek()
    conf_mode = conf_mode if conf_mode in MODES else 'game'
    if s['on'] is True:
        m = schedule_mode(s.get('schedule'))
        if m:
            return m
    if conf_mode == 'server' and s['on'] is not True:
        return 'game'
    return conf_mode


# ------------------------------------------------------------------ the web page's PIN (only its hash)

def secret_read():
    v = sio.load_json(WEB_STATE, {}, repair=False) if os.path.exists(WEB_STATE) else {}
    return v if isinstance(v, dict) else {}


def secret_write(data):
    os.makedirs(os.path.dirname(WEB_STATE), exist_ok=True)
    sio.write_json(WEB_STATE, data)
    try:
        os.chmod(WEB_STATE, 0o600)
    except OSError:
        pass


def pin_hash(pin, salt=None, n=200000):
    salt = salt or secrets.token_hex(16)
    return 'pbkdf2-sha256$%d$%s$%s' % (n, salt, hashlib.pbkdf2_hmac('sha256', pin.encode(), bytes.fromhex(salt), n).hex())


def pin_check(pin, h):
    try:
        kind, n, salt, want = (h or '').split('$')
        if kind != 'pbkdf2-sha256' or not PIN_RE.match(pin or ''):
            return False
        got = hashlib.pbkdf2_hmac('sha256', pin.encode(), bytes.fromhex(salt), int(n)).hex()
        return hmac.compare_digest(got, want)
    except (ValueError, TypeError):
        return False


def pin_set(pin):
    pin = (pin or '').strip()
    if not PIN_RE.match(pin):
        raise Fail('The PIN must be 4 to 12 digits')
    st = secret_read()
    st['pin'] = pin_hash(pin)
    st['sessions'] = {}            # a new PIN signs every device out
    secret_write(st)
    return {'pin': True}


def pin_clear():
    st = secret_read()
    st.pop('pin', None)
    st['sessions'] = {}
    secret_write(st)
    return {'pin': False}


def token_key(tok):
    return hashlib.sha256(tok.encode()).hexdigest()


def session_new(peer_name):
    st = secret_read()
    tok = secrets.token_urlsafe(32)
    now = int(time.time())
    sess = {k: v for k, v in (st.get('sessions') or {}).items() if isinstance(v, dict) and v.get('exp', 0) > now}
    sess[token_key(tok)] = {'exp': now + SESSION_DAYS * 86400, 'name': (peer_name or '')[:60]}
    if len(sess) > 20:
        for k in sorted(sess, key=lambda k: sess[k]['exp'])[:len(sess) - 20]:
            sess.pop(k)
    st['sessions'] = sess
    secret_write(st)
    return tok


def session_ok(tok):
    if not tok or not re.fullmatch(r'[A-Za-z0-9_\-]{20,64}', tok):
        return False
    s = (secret_read().get('sessions') or {}).get(token_key(tok))
    return isinstance(s, dict) and s.get('exp', 0) > time.time()


def session_end(tok):
    st = secret_read()
    if (st.get('sessions') or {}).pop(token_key(tok or 'x'), None) is not None:
        secret_write(st)


def event_add(text, level='info'):
    try:
        ev = sio.load_json(EVENTS, [], repair=False) if os.path.exists(EVENTS) else []
        ev = ev if isinstance(ev, list) else []
        ev.append({'at': int(time.time()), 'text': text[:160], 'level': level})
        os.makedirs(os.path.dirname(EVENTS), exist_ok=True)
        sio.write_atomic(EVENTS, json.dumps(ev[-20:]))
    except (OSError, ValueError):
        pass


# ------------------------------------------------------------------ small system readers (never fatal)

def run(cmd, timeout=10, env=None, inp=None):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, env=env, input=inp)
        return p.returncode, p.stdout or '', p.stderr or ''
    except (OSError, subprocess.SubprocessError) as e:
        return 127, '', str(e)


def read(path, limit=65536):
    try:
        with open(path, errors='replace') as f:
            return f.read(limit)
    except OSError:
        return ''


def rjson(path, default=None):
    try:
        v = json.loads(read(path) or 'null')
    except ValueError:
        v = None
    return default if v is None else v


def wjson(path, obj):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = '%s.%d.tmp' % (path, os.getpid())
    with open(tmp, 'w') as f:
        json.dump(obj, f)
    os.replace(tmp, path)


def http_json(url, body=None, timeout=1.5):
    try:
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(url, data=data, headers={'Content-Type': 'application/json'} if data else {})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read(4 << 20).decode('utf-8', 'replace'))
    except Exception:  # noqa: BLE001 - a service that doesn't answer is just "not answering"
        return None


def unit_active(unit, user=False):
    return run(['systemctl'] + (['--user'] if user else []) + ['is-active', '--quiet', unit], 5)[0] == 0


def meminfo():
    m = {}
    for line in read('/proc/meminfo').splitlines():
        k, _, v = line.partition(':')
        try:
            m[k] = int(v.split()[0]) * 1024
        except (ValueError, IndexError):
            pass
    return m.get('MemTotal', 0), m.get('MemTotal', 0) - m.get('MemAvailable', 0)


def cpu_sample():
    try:
        f = read('/proc/stat').splitlines()[0].split()[1:]
        v = [int(x) for x in f]
        return sum(v), v[3] + (v[4] if len(v) > 4 else 0)
    except (IndexError, ValueError):
        return 0, 0


def net_sample():
    rx = tx = 0
    for line in read('/proc/net/dev').splitlines()[2:]:
        name, _, rest = line.partition(':')
        if name.strip() in ('lo',):
            continue
        f = rest.split()
        if len(f) >= 9:
            rx += int(f[0])
            tx += int(f[8])
    return rx, tx


def rates():
    """Processor use and network speed since the last look (kept in the runtime folder)."""
    now = time.time()
    tot, idle = cpu_sample()
    rx, tx = net_sample()
    last = rjson(SAMPLE, {})
    res = {'cpu': None, 'rx': None, 'tx': None}
    try:
        dt = now - float(last.get('at', 0))
        if 0.5 < dt < 600:
            dtot = tot - last['tot']
            if dtot > 0:
                res['cpu'] = max(0, min(100, round(100 * (1 - (idle - last['idle']) / dtot))))
            res['rx'] = max(0, (rx - last['rx']) / dt)
            res['tx'] = max(0, (tx - last['tx']) / dt)
    except (KeyError, TypeError, ValueError):
        pass
    try:
        wjson(SAMPLE, {'at': now, 'tot': tot, 'idle': idle, 'rx': rx, 'tx': tx})
    except OSError:
        pass
    return res


def cpu_temp():
    base = '/sys/class/hwmon'
    try:
        names = os.listdir(base)
    except OSError:
        return None
    for want in ('k10temp', 'zenpower', 'coretemp', 'cpu_thermal'):
        for h in names:
            if read(os.path.join(base, h, 'name')).strip() == want:
                try:
                    return round(int(read(os.path.join(base, h, 'temp1_input')).strip()) / 1000)
                except ValueError:
                    pass
    return None


def gpu_info():
    """The graphics card: name, memory, temperature, use and power (Nvidia through nvidia-smi; AMD from sysfs)."""
    if shutil.which('nvidia-smi'):
        code, o, _ = run(['nvidia-smi', '--query-gpu=name,memory.used,memory.total,temperature.gpu,utilization.gpu,power.draw',
                          '--format=csv,noheader,nounits'], 4)
        if code == 0 and o.strip():
            f = [x.strip() for x in o.splitlines()[0].split(',')]

            def num(x):
                try:
                    return float(x)
                except ValueError:
                    return None
            g = {'name': f[0].replace('NVIDIA GeForce ', ''), 'memUsed': num(f[1]), 'memTotal': num(f[2]), 'temp': num(f[3]),
                 'busy': num(f[4]), 'power': num(f[5]), 'apps': []}
            code, o, _ = run(['nvidia-smi', '--query-compute-apps=pid,used_memory', '--format=csv,noheader,nounits'], 4)
            for line in o.splitlines() if code == 0 else []:
                try:
                    pid, mem = [x.strip() for x in line.split(',')]
                    g['apps'].append({'who': owner_of(pid), 'mb': float(mem)})
                except ValueError:
                    pass
            return g
    for card in sorted(os.listdir('/sys/class/drm')) if os.path.isdir('/sys/class/drm') else []:
        d = '/sys/class/drm/%s/device' % card
        used, total = read(d + '/mem_info_vram_used').strip(), read(d + '/mem_info_vram_total').strip()
        if used.isdigit() and total.isdigit():
            busy = read(d + '/gpu_busy_percent').strip()
            return {'name': 'Graphics card', 'memUsed': int(used) / 1048576, 'memTotal': int(total) / 1048576, 'temp': None,
                    'busy': float(busy) if busy.isdigit() else None, 'power': None, 'apps': []}
    return None


def owner_of(pid):
    """Which of the home server's services a process belongs to (its systemd unit)."""
    cg = read('/proc/%s/cgroup' % pid if str(pid).isdigit() else '/nonexistent')
    for unit, who in (('hearth-ollama', 'ai'), ('hearth-comfyui', 'pictures'), ('hearth-kokoro', 'voices'), ('hearth-jellyfin', 'media')):
        if unit in cg:
            return who
    return 'other'


def ts_status():
    if not shutil.which('tailscale'):
        return {}
    code, o, _ = run(['tailscale', 'status', '--json'], 5)
    try:
        j = json.loads(o) if code == 0 else {}
    except ValueError:
        j = {}
    return j if isinstance(j, dict) else {}


def ts_ip4(st=None):
    st = ts_status() if st is None else st
    return next((x for x in (st.get('Self') or {}).get('TailscaleIPs') or [] if re.fullmatch(r'100\.\d+\.\d+\.\d+', x)), '')


PORT_NAMES = {445: 'Shared folders', 139: 'Shared folders', 8096: 'Media', 11434: 'AI chat', 8188: 'Pictures', 8880: 'Voices',
              8189: 'AI sharing', 8097: 'Files on the web', 8460: 'Web page', 47984: 'Remote desktop', 47989: 'Remote desktop',
              47990: 'Remote desktop', 48010: 'Remote desktop', 8384: 'Folder sync', 22000: 'Folder sync'}


def connections():
    """Remote addresses connected to this PC's service ports right now: {ip: set(service names)}."""
    code, o, _ = run(['ss', '-Htn', 'state', 'established'], 5)
    res = {}
    for line in o.splitlines() if code == 0 else []:
        cols = line.split()
        if len(cols) < 4:
            continue
        local, peer = cols[-2], cols[-1]
        try:
            lport = int(local.rsplit(':', 1)[1])
        except (ValueError, IndexError):
            continue
        ip = peer.rsplit(':', 1)[0].strip('[]')
        if lport in PORT_NAMES and not ip.startswith('127.') and ip != '::1':
            res.setdefault(ip, set()).add(PORT_NAMES[lport])
    return res


