def fmt_tb(b):
    return ('%.1f TB' % (b / 1e12)) if b >= 1e12 else ('%d GB' % round(b / 1e9))


def ago(ts, now=None):
    now = time.time() if now is None else now
    d = max(0, int(now - ts))
    return 'just now' if d < 60 else '%d min ago' % (d // 60) if d < 3600 else '%d h ago' % (d // 3600) if d < 172800 else '%d days ago' % (d // 86400)


def clock(ts):
    return time.strftime('%-I:%M %p', time.localtime(ts))


