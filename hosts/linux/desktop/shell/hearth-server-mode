def back():
    """Once after Game Mode (the session moved its mark here): how long you played. The mark goes."""
    try:
        t = os.stat(BACK).st_mtime
    except OSError:
        return {'back': False}
    try:
        os.remove(BACK)
    except OSError:
        pass
    try:
        if os.stat(STEAM_FAILED).st_mtime >= t:
            return {'back': False, 'steamFailed': True}      # Steam Game Mode didn't start: the alert says so instead
    except OSError:
        pass
    return {'back': True, 'played': max(0, int(time.time() - t)), 'pauses': pauses_view()}


# ------------------------------------------------------------------ switching, countdowns, requests

def go(mode, wait_nudge=True):
    """Switch now (the dashboard after its 5-second countdown, or the agent after the web page's 10 seconds). Power
    limits go back to normal first; Light mode is asked to act right away. nimbus-mode does the switch itself."""
    if mode not in GO_MODES:
        raise Fail('game, desktop, server or logout')
    try:
        idle_power(False)
    except Fail:
        pass
    env = dict(os.environ)
    if env.get('HEARTH_SERVER_MODE') != '1':
        env.pop('LABWC_PID', None)      # not the dashboard's own labwc: nimbus-mode finds the mode that's up itself
    code, o, e = run([NIMBUS_MODE, mode], 20, env)
    if code != 0:
        raise Fail('The switch didn\'t start (%s)' % (e.strip() or o.strip() or code)[:120])
    if mode in ('game', 'server') and wait_nudge:
        spawn(['nudge', '--wait-game'] if mode == 'game' else ['nudge'])
    return {'switching': mode}


def spawn(args):
    """This helper again, on its own (never waited on)."""
    try:
        subprocess.Popen([sys.executable, os.path.realpath(__file__)] + args, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError:
        pass


def nudge(wait_game=False):
    """The services timer's run now (Light mode: pause for the game, or resume after it), not up to a minute later. Only
    when the home server is set up; through the root helper's polkit rule (the person at the device). Never fatal."""
    if not os.path.exists(PLAN) or not os.path.exists(ROOT_HELPER) or not shutil.which('pkexec'):
        return {'nudged': False}
    if wait_game:
        for _ in range(40):
            if game_mode_up():
                break
            time.sleep(1)
    code, _, _ = run(['pkexec', ROOT_HELPER, 'services', 'run'], 150)
    return {'nudged': code == 0}


def game_mode_up():
    try:
        for pid in os.listdir('/proc'):
            if pid.isdigit() and read('/proc/%s/comm' % pid).strip() in ('gamescope', 'gamescope-wl'):
                return True
    except OSError:
        pass
    return False


def game_running():
    """A game is running in Game Mode (Steam's or Hearth's mark on a process of yours). Nothing switches then."""
    me = os.getuid()
    try:
        pids = [p for p in os.listdir('/proc') if p.isdigit()]
    except OSError:
        return False
    for p in pids:
        try:
            if os.stat('/proc/' + p).st_uid != me:
                continue
            env = open('/proc/%s/environ' % p, 'rb').read(65536)
        except OSError:
            continue
        if re.search(rb'(?:^|\x00)(?:SteamGameId|SteamAppId|HEARTH_GAME_ID)=[1-9]', env):
            return True
    return False


def countdown_view():
    c = rjson(COUNTDOWN, None)
    if not isinstance(c, dict) or c.get('action') is None:
        return None
    left = c.get('deadline', 0) - time.time()
    return {'to': c.get('to', ''), 'what': c.get('what', 'mode'), 'from': c.get('from', ''), 'by': c.get('by', ''),
            'left': max(0, round(left)), 'total': c.get('total', COUNTDOWN_WEB)}


def countdown_start(action, secs, origin, by=''):
    wjson(COUNTDOWN, {'action': action, 'to': action.get('to') or action.get('what'), 'what': action['kind'],
                      'deadline': time.time() + secs, 'total': secs, 'from': origin, 'by': by[:60]})


def countdown_clear():
    """No countdown: the file stays, holding {} (the dashboard watches it every second without logging a missing file)."""
    try:
        wjson(COUNTDOWN, {})
    except OSError:
        pass


def cancel():
    c = rjson(COUNTDOWN, None)
    if isinstance(c, dict) and c.get('action') is not None:
        countdown_clear()
        result_add('Cancelled on the home screen')
        return {'cancelled': True}
    return {'cancelled': False}


def result_add(text, ok=True):
    try:
        r = rjson(RESULTS, [])
        r = r if isinstance(r, list) else []
        r.append({'at': int(time.time()), 'text': text[:200], 'ok': ok})
        wjson(RESULTS, r[-10:])
    except OSError:
        pass


def clean_request(req):
    """A request from the web page (or anyone): only these shapes, checked again before anything happens."""
    if not isinstance(req, dict):
        raise Fail('a JSON object')
    k = req.get('kind')
    if k == 'mode' and req.get('to') in MODES:
        return {'kind': 'mode', 'to': req['to']}
    if k == 'power' and req.get('what') in ('sleep', 'restart'):
        return {'kind': 'power', 'what': req['what']}
    if k == 'service' and req.get('name') in SERVICES and req.get('action') in SERVICE_ACTIONS:
        return {'kind': 'service', 'name': req['name'], 'action': req['action']}
    raise Fail('Not something the web page can ask for')


def request_add(req, origin='web', by=''):
    r = clean_request(req)
    r['from'] = origin if origin in ('web', 'schedule', 'link') else 'web'
    r['by'] = (by or '')[:60]
    os.makedirs(REQUESTS, mode=0o700, exist_ok=True)
    name = '%d-%s.json' % (int(time.time() * 1000), secrets.token_hex(4))
    tmp = os.path.join(REQUESTS, '.' + name)
    with open(tmp, 'w') as f:
        json.dump(r, f)
    os.replace(tmp, os.path.join(REQUESTS, name))
    return {'sent': True}


def dashboard_up():
    try:
        pid = int(read(PID).strip() or '0')
        os.kill(pid, 0)
    except (ValueError, OSError):
        return False
    return os.path.exists(DASH_UP) and mode_now() == 'server'


def handle(req, now=None):
    """One request, in the agent: services at once; a switch or sleep counts down 10 s on the home screen when the
    dashboard is up, never while a game runs, and never away from Desktop Mode (someone may be working there)."""
    r = clean_request(req)
    origin = req.get('from') or 'web'
    by = req.get('by') or ''
    if r['kind'] == 'service':
        try:
            service(r['action'], r['name'])
            result_add('%s: %s' % (r['name'], r['action']))
        except Fail as e:
            result_add(str(e), False)
        return 'done'
    cur = mode_now()
    if r['kind'] == 'mode' and (cur == r['to'] or (r['to'] == 'game' and cur in ('steam', 'game'))):
        return 'already'
    if cur == 'server' and dashboard_up():
        countdown_start(r, COUNTDOWN_WEB, origin, by)
        return 'countdown'
    if cur == 'desktop':
        result_add('Desktop Mode is open on the PC: switch there', False)
        return 'refused'
    if game_running():
        result_add('A game is running on the PC: nothing switches until it ends', False)
        return 'wait'
    execute(r)
    return 'done'


def execute(r):
    try:
        if r['kind'] == 'mode':
            go(r['to'])
            result_add('Switching to ' + {'game': 'Game Mode', 'desktop': 'Desktop Mode', 'server': 'Server mode'}[r['to']])
        elif r['kind'] == 'power':
            power(r['what'])
            result_add('The PC goes to ' + ('sleep' if r['what'] == 'sleep' else 'restart'))
    except Fail as e:
        result_add(str(e), False)


def schedule_step(s, last, now=None):
    """The schedule, once: at a change (the mode it says differs from the last look) ask for that mode; a change that
    has to wait (a game is running) is tried again at the next look. Returns what to remember as the last look."""
    want = schedule_mode(s.get('schedule'), now) if s.get('on') is True else ''
    if not want:
        return None
    if last is None or want == last:
        return want
    res = handle({'kind': 'mode', 'to': want, 'from': 'schedule', 'by': 'Schedule'})
    return last if res == 'wait' else want


def agent():
    """The session's helper (one at a time): runs the web page's requests and the countdown's deadline, and follows the
    schedule at its changes only (so a switch you make yourself is never undone). Ends when Server mode and the web
    page are both off."""
    os.makedirs(RT, mode=0o700, exist_ok=True)
    lockf = open(os.path.join(RT, 'agent.lock'), 'w')
    try:
        fcntl.flock(lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return {'agent': 'already running'}
    last_sched, tick = None, 0
    while True:
        names = agent_step()
        if tick % 30 == 0:
            s = peek()
            if s['on'] is not True and s['web']['on'] is not True and not names:
                return {'agent': 'ended'}
            last_sched = schedule_step(s, last_sched)
        tick += 1
        time.sleep(1)


def agent_step(now=None):
    """One look: the requests waiting (oldest first), then the countdown's deadline. Returns the requests handled."""
    now = time.time() if now is None else now
    try:
        names = sorted(n for n in os.listdir(REQUESTS) if n.endswith('.json') and not n.startswith('.'))
    except OSError:
        names = []
    for n in names:
        p = os.path.join(REQUESTS, n)
        try:
            req = rjson(p, {})
            os.remove(p)
            handle(req)
        except (Fail, OSError) as e:
            result_add(str(e), False)
    c = rjson(COUNTDOWN, None)
    if isinstance(c, dict) and isinstance(c.get('action'), dict) and now >= c.get('deadline', 0):
        countdown_clear()
        execute(c['action'])
    return names


# ------------------------------------------------------------------ services, power

def service(action, name):
    """Restart, pause or resume one service. Your own user services directly; the system's (AI chat, media) through the
    root helper's polkit rule. A pause you make is remembered until you resume it (runtime state, not a setting)."""
    if action not in SERVICE_ACTIONS or name not in SERVICES:
        raise Fail('Unknown service or action')
    sysd = {'ai': 'ollama', 'media': 'jellyfin'}
    user = {'pictures': 'hearth-comfyui.service', 'voices': 'hearth-kokoro.service', 'aishare': 'hearth-ai-share.service'}
    verb = {'restart': 'restart', 'pause': 'stop', 'resume': 'start'}[action]
    if name in sysd:
        if not shutil.which('pkexec'):
            raise Fail('pkexec is missing')
        code, o, _ = run(['pkexec', ROOT_HELPER, 'svc', verb, sysd[name]], 60)
        try:
            v = json.loads(o.strip().splitlines()[-1]) if o.strip() else {}
        except ValueError:
            v = {}
        if code != 0 or not v.get('ok'):
            raise Fail(v.get('error') or 'That didn\'t work')
    elif name in user:
        code, _, e = run(['systemctl', '--user', verb, user[name]], 60)
        if code != 0:
            raise Fail('That didn\'t work (%s)' % e.strip()[:100])
    elif name == 'remote':
        if action != 'restart':
            raise Fail('Remote desktop can only be restarted here')
        for u in ('app-dev.lizardbyte.app.Sunshine.service', 'sunshine.service'):
            if run(['systemctl', '--user', 'is-active', '--quiet', u], 5)[0] == 0:
                run(['systemctl', '--user', 'restart', u], 60)
                break
    mine = user_paused()
    if action == 'pause' and name not in mine:
        mine.append(name)
    elif action == 'resume' and name in mine:
        mine.remove(name)
    try:
        wjson(USER_PAUSED, mine)
    except OSError:
        pass
    return {'ok': True, 'service': name, 'action': action}


def power(what):
    if what not in ('sleep', 'restart', 'off'):
        raise Fail('sleep, restart or off')
    try:
        idle_power(False)
    except Fail:
        pass
    code, _, e = run(['systemctl', {'sleep': 'suspend', 'restart': 'reboot', 'off': 'poweroff'}[what]], 30)
    if code != 0:
        raise Fail('That didn\'t work (%s)' % e.strip()[:100])
    return {'ok': True}


HEARTH_POWER = os.path.join(HERE, 'hearth-power')


def idle_power(on):
    """Lower power limits while nothing is busy (the dashboard decides when), or exactly back to how they were. What was
    changed is kept in the runtime folder, so "back" never guesses and never touches a limit Hearth didn't change."""
    st = rjson(IDLE_STATE, {})
    st = st if isinstance(st, dict) else {}
    s = peek()
    if on:
        if st.get('on') or s['idlePower'] is not True:
            return {'idlePower': bool(st.get('on'))}
        new = {'on': True, 'at': int(time.time())}
        if os.path.exists(HEARTH_POWER):
            code, o, _ = run([sys.executable, HEARTH_POWER, 'status'], 15)
            try:
                cur = ((json.loads(o) if code == 0 else {}).get('mode') or {}).get('current')
            except ValueError:
                cur = None
            if cur in ('balanced', 'performance'):
                if run([sys.executable, HEARTH_POWER, 'mode', 'power-saver'], 15)[0] == 0:
                    new['mode'] = cur
        if shutil.which('nvidia-smi') and shutil.which('pkexec') and os.path.exists(ROOT_HELPER):
            if run(['pkexec', ROOT_HELPER, 'gpu-limit', str(s['gpuWatts'])], 30)[0] == 0:
                new['gpu'] = True
        wjson(IDLE_STATE, new)
        return {'idlePower': True}
    if not st.get('on'):
        return {'idlePower': False}
    if st.get('mode') in ('balanced', 'performance') and os.path.exists(HEARTH_POWER):
        run([sys.executable, HEARTH_POWER, 'mode', st['mode']], 15)
    if st.get('gpu') and shutil.which('pkexec'):
        run(['pkexec', ROOT_HELPER, 'gpu-limit', 'reset'], 30)
    try:
        os.remove(IDLE_STATE)
    except OSError:
        pass
    return {'idlePower': False}


def leaving():
    """The session, after Server mode ended (however it ended): power limits back, the screen on."""
    res = {}
    try:
        res.update(idle_power(False))
    except Fail:
        pass
    try:
        os.remove(DASH_UP)
    except OSError:
        pass
    countdown_clear()
    if shutil.which('wlopm'):
        run(['wlopm', '--on', '*'], 5)
    return res


def web_apply():
    """The web page's user service on or off to match (on only with Server mode's web page on and a PIN set), and the
    home server's firewall rule for its port (Tailscale and this PC only) made again."""
    s = load()
    on = s['web']['on'] is True and bool(secret_read().get('pin'))
    run(['systemctl', '--user', 'enable' if on else 'disable', '--now', WEB_UNIT], 30)
    if on:
        run(['systemctl', '--user', 'restart', WEB_UNIT], 30)
    if os.path.exists(PLAN):
        run([sys.executable, os.path.join(HERE, 'hearth-home-server'), 'apply'], 120)
    if on or s['on'] is True:
        spawn(['agent'])
    return {'web': 'on' if on else 'off'}


# ------------------------------------------------------------------ the web page (port 8460, Tailscale and this PC only)

TS_NETS = (ipaddress.ip_network('100.64.0.0/10'), ipaddress.ip_network('fd7a:115c:a1e0::/48'))
FAILS = {}
LOCK = threading.Lock()


def peer_allowed(ip):
    """Only this PC and Tailscale: the page also listens only on 127.0.0.1 and this PC's Tailscale address, and the home
    server's nftables rule drops the port on every other interface."""
    try:
        a = ipaddress.ip_address(ip.split('%')[0])
    except ValueError:
        return False
    if a.version == 6 and a.ipv4_mapped:
        a = a.ipv4_mapped
    return a.is_loopback or any(a in n for n in TS_NETS)


def too_many(ip, now=None):
    now = time.time() if now is None else now
    with LOCK:
        f = [t for t in FAILS.get(ip, []) if now - t < 300]
        FAILS[ip] = f
        return len(f) >= 5


def failed(ip):
    with LOCK:
        FAILS.setdefault(ip, []).append(time.time())


def peer_name(ip, ts=None):
    if ip.startswith('127.') or ip == '::1':
        return 'This PC'
    ts = ts_status() if ts is None else ts
    for p in (ts.get('Peer') or {}).values():
        if ip in (p.get('TailscaleIPs') or []):
            return p.get('HostName') or ip
    return ip


def make_handler():
    from http.server import BaseHTTPRequestHandler

    class H(BaseHTTPRequestHandler):
        server_version = 'Hearth'
        sys_version = ''

        def log_message(self, fmt, *args):  # noqa: D401 - nothing per request in the journal
            pass

        def ip(self):
            return self.client_address[0]

        def send(self, code, body, ctype='application/json', extra=()):
            data = body if isinstance(body, bytes) else (json.dumps(body) if ctype == 'application/json' else body).encode()
            self.send_response(code)
            self.send_header('Content-Type', ctype + '; charset=utf-8')
            self.send_header('Content-Length', str(len(data)))
            self.send_header('Cache-Control', 'no-store')
            self.send_header('X-Frame-Options', 'DENY')
            self.send_header('X-Content-Type-Options', 'nosniff')
            self.send_header('Referrer-Policy', 'no-referrer')
            self.send_header('Content-Security-Policy', "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; connect-src 'self'; form-action 'none'; frame-ancestors 'none'")
            for k, v in extra:
                self.send_header(k, v)
            self.end_headers()
            self.wfile.write(data)

        def token(self):
            for part in (self.headers.get('Cookie') or '').split(';'):
                k, _, v = part.strip().partition('=')
                if k == 'hs':
                    return v
            return ''

        def authed(self):
            return session_ok(self.token())

        def body(self):
            try:
                n = int(self.headers.get('Content-Length') or 0)
            except ValueError:
                n = 0
            if n <= 0 or n > 4096:
                return None
            try:
                return json.loads(self.rfile.read(n).decode('utf-8'))
            except (ValueError, UnicodeDecodeError):
                return None

        def same_origin(self):
            # Writes need Hearth's own header (a form or another site can't send it) and, when the browser says, this page's origin.
            if self.headers.get('X-Hearth') != '1':
                return False
            o = self.headers.get('Origin')
            return o is None or o == 'http://' + (self.headers.get('Host') or '')

        def guard(self):
            if not peer_allowed(self.ip()):
                self.send(403, {'error': 'Only over Tailscale'})
                return False
            return True

        def do_GET(self):  # noqa: N802
            if not self.guard():
                return
            path = self.path.split('?', 1)[0]
            if path == '/':
                return self.send(200, page_html(), 'text/html')
            if path == '/api/summary':
                s = peek()
                if not (self.authed() or s['web']['perms']['devices'] is True):
                    return self.send(401, {'error': 'Type the PIN'})
                return self.send(200, summary())
            if path == '/api/status':
                if not self.authed():
                    return self.send(401, {'error': 'Type the PIN', 'pin': bool(secret_read().get('pin'))})
                d = summary()
                s = peek()
                d['perms'] = s['web']['perms']
                d['results'] = rjson(RESULTS, [])[-3:]
                d['modeNow'] = mode_now()
                d['gameRunning'] = game_running()
                return self.send(200, d)
            self.send(404, {'error': 'Not here'})

        def do_POST(self):  # noqa: N802
            if not self.guard():
                return
            if not self.same_origin():
                return self.send(403, {'error': 'Not from this page'})
            path = self.path.split('?', 1)[0]
            ip = self.ip()
            if path == '/api/login':
                if too_many(ip):
                    return self.send(429, {'error': 'Too many tries: wait 5 minutes'})
                b = self.body() or {}
                h = secret_read().get('pin')
                if not h:
                    return self.send(403, {'error': 'Set a PIN in Settings › Home server › Server mode first'})
                if not pin_check(str(b.get('pin', '')), h):
                    failed(ip)
                    return self.send(401, {'error': 'That PIN isn\'t right'})
                name = peer_name(ip)
                tok = session_new(name)
                event_add('%s opened the web page' % name)
                return self.send(200, {'ok': True}, extra=[('Set-Cookie', 'hs=%s; Path=/; Max-Age=%d; HttpOnly; SameSite=Strict' % (tok, SESSION_DAYS * 86400))])
            if not self.authed():
                return self.send(401, {'error': 'Type the PIN'})
            if path == '/api/logout':
                session_end(self.token())
                return self.send(200, {'ok': True}, extra=[('Set-Cookie', 'hs=; Path=/; Max-Age=0; HttpOnly; SameSite=Strict')])
            if path == '/api/action':
                b = self.body()
                try:
                    r = clean_request(b)
                except Fail as e:
                    return self.send(400, {'error': str(e)})
                perms = peek()['web']['perms']
                need = {'service': 'services', 'mode': 'modes', 'power': 'power'}[r['kind']]
                if perms.get(need) is not True:
                    return self.send(403, {'error': 'Turned off in Settings › Home server › Server mode'})
                request_add(r, 'web', peer_name(ip))
                spawn(['agent'])
                return self.send(202, {'ok': True, 'sent': True})
            self.send(404, {'error': 'Not here'})

    return H


def listen_addresses():
    out_ = ['127.0.0.1']
    ip = ts_ip4()
    if ip:
        out_.append(ip)
    return out_


def serve():
    from http.server import ThreadingHTTPServer
    s = peek()
    if s['web']['on'] is not True:
        print('hearth-server-mode: the web page is off', file=sys.stderr)
        return 0
    handler = make_handler()
    addrs = listen_addresses()
    servers = []
    for a in addrs:
        try:
            srv = ThreadingHTTPServer((a, PORT), handler)
        except OSError as e:
            print('hearth-server-mode: can\'t listen on %s:%d (%s)' % (a, PORT, e), file=sys.stderr)
            continue
        srv.daemon_threads = True
        threading.Thread(target=srv.serve_forever, daemon=True).start()
        servers.append(srv)
    if not servers:
        return 1
    while True:
        time.sleep(60)
        if peek()['web']['on'] is not True:
            return 0
        if len(addrs) == 1 and len(listen_addresses()) > 1:
            return 75      # Tailscale came up after we started: systemd starts us again, now on its address too


def page_html(data=None):
    """The web page: one file, phone and laptop layouts. DATA embedded (tests and CI screenshots) shows it without the
    PIN and without asking the PC."""
    p = os.path.join(HERE, 'server-mode-web.html')
    text = read(p, 400000) or '<!doctype html><title>Hearth</title><p>The web page is missing.'
    embed = json.dumps(data).replace('</', '<\\/') if data is not None else 'null'
    return text.replace('/*HEARTH_DATA*/null', embed).replace('{{HOST}}', html.escape(socket.gethostname().split('.')[0]))


# ------------------------------------------------------------------ main

def main(argv):
    a = argv[1:]
    stdin_text = os.environ.get('HEARTH_INPUT')
    try:
        if a == ['status']:
            out(status())
        elif len(a) == 3 and a[0] == 'set':
            out({'changed': set_key(a[1], a[2])})
        elif a == ['schedule-set']:
            out({'changed': schedule_set(stdin_text if stdin_text is not None else sys.stdin.read(8192))})
        elif a == ['pin-set']:
            out(pin_set(stdin_text if stdin_text is not None else sys.stdin.readline()))
        elif a == ['pin-clear']:
            out(pin_clear())
        elif a == ['start-in']:
            print(start_in())
        elif len(a) == 2 and a[0] == 'start-in':
            out({'startIn': start_in(a[1])})
        elif a == ['session-check']:
            print('on' if peek()['on'] is True else 'off')
        elif a == ['sleep-idle']:
            # Sleep after idle chosen (Settings › Home server › Server mode › Sleep, Light mode's power.sleepIdle): the
            # session then doesn't hold sleep off while Server mode runs.
            print('on' if ((hs_settings().get('power') or {}).get('sleepIdle') or 0) > 0 else 'off')
        elif a == ['ai-unload']:
            code, o, _ = run([sys.executable, os.path.join(HERE, 'hearth-home-server'), 'ai-unload'], 60)
            if code != 0:
                raise Fail(o.strip()[7:] if o.strip().startswith('error: ') else 'That didn\'t work')
            out({'unloaded': True})
        elif len(a) == 2 and a[0] == 'start-mode':
            print(start_mode(a[1]))
        elif a == ['dash']:
            out(dash())
        elif a == ['summary']:
            out(summary())
        elif a == ['back']:
            out(back())
        elif len(a) == 2 and a[0] == 'go':
            out(go(a[1]))
        elif a == ['request']:
            try:
                req = json.loads(stdin_text if stdin_text is not None else sys.stdin.read(4096))
            except ValueError:
                raise Fail('a JSON object')
            out(request_add(req, 'link'))
        elif a == ['countdown']:
            out({'countdown': countdown_view()})
        elif a == ['cancel']:
            out(cancel())
        elif len(a) == 3 and a[0] == 'service':
            out(service(a[1], a[2]))
        elif len(a) == 2 and a[0] == 'power':
            out(power(a[1]))
        elif len(a) == 2 and a[0] == 'idle-power' and a[1] in ('on', 'off'):
            out(idle_power(a[1] == 'on'))
        elif a == ['leaving']:
            out(leaving())
        elif a in (['nudge'], ['nudge', '--wait-game']):
            out(nudge(len(a) == 2))
        elif a == ['agent']:
            out(agent())
        elif a == ['serve']:
            return serve()
        elif a == ['web-apply']:
            out(web_apply())
        elif len(a) == 2 and a[0] == 'web-html':
            sys.stdout.write(page_html(rjson(a[1], {})))
        else:
            print(__doc__, file=sys.stderr)
            return 2
    except Fail as e:
        print('error: %s' % e)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
