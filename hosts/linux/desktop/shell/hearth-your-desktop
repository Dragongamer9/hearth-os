#!/usr/bin/env python3
"""hearth-your-desktop: Settings › System › Your desktop and Desktop Mode's one-time notice (DesktopNotice.qml).

  hearth-your-desktop status      JSON: the last notice (why Desktop Mode started the way it did) and what's running
  hearth-your-desktop notice      JSON: the notice Mantel hasn't shown yet ({} when there's none), marked as shown

The notices come from nimbus-session (desk_notice): ~/.local/state/hearth/desktop-notice, one line
"<what> <why> <when>". Shown once: it then moves to desktop-notice.shown (Settings still shows the last one), and for
1.13's retired KDE Plasma / GNOME choice desktop-retired-told keeps it from coming back. Nothing here changes a
setting: session.conf is only read.
"""
import json
import os
import sys
import time

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import hearth_settings_io as sio  # noqa: E402

E = os.environ.get
STATE_HOME = E('XDG_STATE_HOME') or os.path.expanduser('~/.local/state')
DESK_STATE = os.path.join(STATE_HOME, 'hearth')
NOTICE = os.path.join(DESK_STATE, 'desktop-notice')
SHOWN = NOTICE + '.shown'
RETIRED_TOLD = os.path.join(DESK_STATE, 'desktop-retired-told')
NAMES = {'kde': 'KDE Plasma', 'gnome': 'GNOME'}


def texts(what, why):
    """(title, sub) for a notice."""
    if why == 'retired':
        name = NAMES.get(what, 'KDE Plasma or GNOME')
        return ('KDE Plasma and GNOME were retired',
                'You had %s picked for Desktop Mode. Hearth 1.14 retired KDE Plasma and GNOME as desktops: Desktop '
                'Mode is Mantel, which now runs on KWin, KDE\'s own window manager. Your apps, files and settings are '
                'all still here.' % name)
    return ('', '')


def read_notice(path):
    try:
        with open(path, encoding='utf-8') as f:
            p = f.read().split()
        what, why, at = p[0], p[1], int(p[2])
    except (OSError, IndexError, ValueError):
        return None
    title, sub = texts(what, why)
    if not title:
        return None
    return {'what': what, 'kind': why, 'at': at, 'title': title, 'sub': sub, 'text': title}


def status():
    n = read_notice(NOTICE)
    shown = False
    if not n:
        n, shown = read_notice(SHOWN), True
    return {'notice': n, 'noticeShown': shown}


def cmd_notice():
    n = read_notice(NOTICE)
    if not n:
        return {}
    try:
        os.replace(NOTICE, SHOWN)
    except OSError:
        pass
    if n['kind'] == 'retired':
        try:
            sio.write_text(RETIRED_TOLD, 'told %d\n' % int(time.time()))
        except OSError:
            pass
    sio.log_event('desktop: notice shown (%s %s)' % (n['what'], n['kind']))
    return n


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    if cmd == 'status':
        out = status()
    elif cmd == 'notice':
        out = cmd_notice()
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    print(json.dumps(out), flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
