#!/usr/bin/env python3
"""hearth-your-desktop: Settings › System › Your desktop and Desktop Mode's one-time notice (DesktopNotice.qml).

  hearth-your-desktop status      JSON: the last notice (why Desktop Mode started the way it did), Mantel's window
                                  manager (picked, running now, KWin's failed starts) and what's here
  hearth-your-desktop notice      JSON: the notice Mantel hasn't shown yet ({} when there's none), marked as shown
  hearth-your-desktop kwin-overrides
                                  (nimbus-session, before KWin starts) which of your own KDE settings Hearth's fixed
                                  KWin keys override (LOCKED below); the first time one is, a notice says which and
                                  why. Reads your files, never writes them. JSON {overridden, told}
  hearth-your-desktop wm kwin|labwc
                                  Mantel's window manager from the next start of Desktop Mode (session.conf's
                                  HEARTH_DESKTOP_WM, only that line, through hearth_settings_io). Picking KWin also
                                  turns it back on after it didn't start twice (nimbus-session's safe start).

The notices come from nimbus-session (desk_notice): ~/.local/state/hearth/desktop-notice, a line
"<what> <why> <when>" each (one per what). Shown once, oldest first: a line then moves to desktop-notice.shown (Settings
still shows the last ones), and for
1.13's retired KDE Plasma / GNOME choice desktop-retired-told keeps it from coming back. Only `wm` changes a setting,
when the person picks one.
"""
import json
import os
import re
import shutil
import sys
import time

sys.dont_write_bytecode = True
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import hearth_settings_io as sio  # noqa: E402

E = os.environ.get
CONFIG_HOME = E('XDG_CONFIG_HOME') or os.path.expanduser('~/.config')
SESSION_CONF = os.path.join(CONFIG_HOME, 'nimbus', 'session.conf')
RUN = E('XDG_RUNTIME_DIR') or '/run/user/%d' % os.getuid()
STATE_HOME = E('XDG_STATE_HOME') or os.path.expanduser('~/.local/state')
DESK_STATE = os.path.join(STATE_HOME, 'hearth')
NOTICE = os.path.join(DESK_STATE, 'desktop-notice')
SHOWN = NOTICE + '.shown'
RETIRED_TOLD = os.path.join(DESK_STATE, 'desktop-retired-told')
FAILS = os.path.join(DESK_STATE, 'desktop-fails')
NAMES = {'kde': 'KDE Plasma', 'gnome': 'GNOME'}
MINE_TOLD = os.path.join(DESK_STATE, 'kwin-mine-told')
# Hearth's KWin keys that are fixed ([$i], KConfig's "immutable", in desktop/kwin/xdg and desktop/kwin/windows/xdg):
# your own ~/.config file can't change them under KWin, because Mantel can't work without them (red flag 2: KWin
# locking by itself skips hearth-lockcheck, a lockout on a handheld if its lock screen can't load). Only these;
# Night Light and tearing (Settings › Display, written to your kwinrc) are never fixed.
#   (id, file, group, key, Hearth's value, what it is in KDE, what decides it in Hearth; '' = not told: no effect alone)
LOCKED = [
    ('autolock', 'kscreenlockerrc', 'Daemon', 'Autolock', 'false', 'Lock the screen automatically',
     'Mantel locks when it\'s idle as Settings › Sign-in says'),
    ('lockonresume', 'kscreenlockerrc', 'Daemon', 'LockOnResume', 'false', 'Lock after waking from sleep',
     'Settings › Sign-in › Lock when waking decides it'),
    ('locktimeout', 'kscreenlockerrc', 'Daemon', 'Timeout', '0', '', ''),
    ('inputmethod', 'kwinrc', 'Wayland', 'InputMethod', '/usr/share/applications/hearth-kwin-im.desktop',
     'The virtual keyboard you picked in KDE', 'Hearth\'s on-screen keyboard types for you (Settings › Keyboard)'),
    ('superkey', 'kwinrc', 'ModifierOnlyShortcuts', 'Meta', 'org.hearth.Windows,/org/hearth/Windows,org.hearth.Windows,Launcher',
     'What the Super key opens on its own', 'it opens Mantel\'s app menu (Settings › Desktop › App menu picks which)'),
]
WMS = {'kwin': 'KWin', 'labwc': 'labwc'}


class Fail(Exception):
    pass


def texts(what, why):
    """(title, sub) for a notice."""
    if why == 'retired':
        name = NAMES.get(what, 'KDE Plasma or GNOME')
        return ('KDE Plasma and GNOME were retired',
                'You had %s picked for Desktop Mode. Hearth 1.14 retired KDE Plasma and GNOME as desktops: Desktop '
                'Mode is Mantel, which now runs on KWin, KDE\'s own window manager. Your apps, files and settings are '
                'all still here.' % name)
    if what == 'kwin':
        return {
            'missing': ('Mantel opened on labwc', 'KWin, the window manager Mantel runs on, isn\'t installed, so Mantel '
                        'opened on labwc, the one it used before 1.14. Everything works as before.'),
            'failed': ('KWin didn\'t start', 'Mantel opened on labwc instead, the window manager it used before 1.14, '
                       'for this sign-in. Next time Hearth tries KWin again.'),
            'twice': ('KWin didn\'t start twice in a row', 'Mantel uses labwc, the window manager it used before 1.14, '
                      'until you turn KWin back on. You can try it again here or in Settings › System › Your desktop.'),
        }.get(why, ('', ''))
    if what == 'kwin-lock':
        part = {'nopackage': "Hearth's lock screen for KWin (/usr/share/plasma/shells/org.hearth.mantel-lock) is missing",
                'nolocker': "KWin's screen locker (kscreenlocker_greet) isn't installed",
                'notloaded': "KWin's screen locker didn't show Hearth's lock screen loading when Hearth tested it"}.get(why)
        if not part:
            return ('', '')
        return ('The lock screen is off',
                "The lock screen is off because Hearth's lock screen isn't installed correctly: %s. So that you can "
                "never be locked out, Desktop Mode doesn't lock the screen (Lock says so too) until it's fixed. "
                "Restoring Hearth's system files or the next update puts it back. Details: session.log in "
                "~/.local/share/nimbus, and Send logs." % part)
    if what == 'kwin-mine':
        ids = [i for i in why.split('+') if i]
        rows = [x for x in LOCKED if x[0] in ids and x[5]]
        if not rows or len(rows) != len(ids):
            return ('', '')
        return ('Some of your KDE settings aren\'t used here',
                'Mantel on KWin needs these to work, so your own choices from KDE Plasma aren\'t used in Desktop Mode.\n'
                + ''.join('\n• %s: %s.' % (x[5], x[6][0].upper() + x[6][1:]) for x in rows)
                + '\n\nYour own files aren\'t changed: KDE would use them again.')
    return ('', '')


def ini_values(text):
    """{(group, key): value} of a KDE ini file (the last one wins, a key's [$e] / [$i] options dropped)."""
    out, group = {}, ''
    for raw in text.splitlines():
        s = raw.strip()
        if not s or s.startswith('#'):
            continue
        if s.startswith('['):
            s = re.sub(r'\[\$[a-z]*\]$', '', s)              # a group's own [$i]
            if s.startswith('[') and s.endswith(']'):
                group = s[1:-1].replace('][', '/')
            continue
        if '=' in s:
            k, v = s.split('=', 1)
            out[(group, re.sub(r'\[[^\]]*\]', '', k).strip())] = v.strip()
    return out


def overridden(config_home=None):
    """The ids in LOCKED whose key your own file sets to something other than Hearth's value."""
    config_home = config_home or CONFIG_HOME
    files, out = {}, []
    for lid, fname, group, key, value, _what, _how in LOCKED:
        if fname not in files:
            try:
                with open(os.path.join(config_home, fname), encoding='utf-8', errors='replace') as f:
                    files[fname] = ini_values(f.read())
            except OSError:
                files[fname] = {}
        mine = files[fname].get((group, key))
        if mine is not None and mine.lower() != value.lower():
            out.append(lid)
    return out


def cmd_kwin_overrides():
    """Queue the one-time notice for overridden keys not told yet. They're marked as told only after the notice is
    really in the notice file (read back under its lock); if queueing fails nothing is marked, so the next start
    tells again (red flag 9: the person is always told)."""
    ids = overridden()
    told = [i for i in (sio.load_json(MINE_TOLD, {}, repair=False).get('told') or []) if isinstance(i, str)] \
        if os.path.exists(MINE_TOLD) else []
    tell = [i for i in ids if i not in told and any(x[0] == i and x[5] for x in LOCKED)]
    if not tell:
        return {'overridden': ids, 'told': False}
    shown = [i for i in ids if any(x[0] == i and x[5] for x in LOCKED)]
    n = parse('kwin-mine %s %d' % ('+'.join(shown), int(time.time())))
    with sio.locked(NOTICE):
        rest = [x for x in read_notices(NOTICE) if x['what'] != 'kwin-mine']
        write_lines(NOTICE, rest + [n])
        queued = any(x['what'] == 'kwin-mine' and x['kind'] == n['kind'] for x in read_notices(NOTICE))
    if not queued:
        sio.log_event('desktop: the notice about your KDE settings couldn\'t be queued; told at the next start')
        return {'overridden': ids, 'told': False}
    sio.write_json(MINE_TOLD, {'told': sorted(set(told) | set(tell))})
    sio.log_event('desktop: your own KDE settings not used under KWin: %s' % ', '.join(shown))
    return {'overridden': ids, 'told': True}


def parse(line):
    p = line.split()
    try:
        what, why, at = p[0], p[1], int(p[2])
    except (IndexError, ValueError):
        return None
    title, sub = texts(what, why)
    if not title:
        return None
    return {'what': what, 'kind': why, 'at': at, 'title': title, 'sub': sub, 'text': title, 'line': line.strip()}


def read_notices(path):
    try:
        with open(path, encoding='utf-8') as f:
            return [n for n in (parse(l) for l in f) if n]
    except OSError:
        return []


def write_lines(path, notices):
    if notices:
        sio.write_text(path, ''.join(n['line'] + '\n' for n in notices))
    else:
        try:
            os.remove(path)
        except OSError:
            pass


def conf_value(key):
    try:
        with open(SESSION_CONF, encoding='utf-8') as f:
            text = f.read()
    except OSError:
        return ''
    found = re.findall(r'''^[ \t]*(?:export[ \t]+)?%s=["']?([a-z]*)''' % key, text, re.M)
    return found[-1] if found else ''


def kwin_fails():
    try:
        with open(FAILS, encoding='utf-8') as f:
            for line in f:
                p = line.split()
                if len(p) == 2 and p[0] == 'kwin':
                    return int(p[1])
    except (OSError, ValueError):
        pass
    return 0


def wm_now():
    """The window manager Desktop Mode is on right now ('' outside Desktop Mode)."""
    w = E('HEARTH_WM', '')
    if w in WMS and (E('HEARTH_DESKTOP_PID') or E('LABWC_PID')):
        return w
    try:
        with open(os.path.join(RUN, 'nimbus-mode-now'), encoding='utf-8') as f:
            if f.read().strip() != 'desktop':
                return ''
    except OSError:
        return ''
    try:
        with open(os.path.join(RUN, 'hearth-kwin.pid'), encoding='utf-8') as f:
            os.kill(int(f.read().strip()), 0)
        return 'kwin'
    except (OSError, ValueError):
        return 'labwc'


def status():
    pending, seen = read_notices(NOTICE), read_notices(SHOWN)
    n, shown = (pending[0], False) if pending else ((seen[-1], True) if seen else (None, False))
    picked = 'labwc' if conf_value('HEARTH_DESKTOP_WM') == 'labwc' else 'kwin'
    fails = kwin_fails()
    return {'notice': n, 'noticeShown': shown, 'notices': pending + seen, 'wm': picked, 'wmNow': wm_now(), 'kwinFails': fails,
            'kwinPaused': picked == 'kwin' and fails >= 2, 'kwinHere': bool(shutil.which('kwin_wayland')),
            'labwcHere': bool(shutil.which('labwc')),
            'safeGraphics': os.path.exists(E('HEARTH_SAFE_FLAG') or '/run/hearth/safe-graphics')}


def cmd_wm(w):
    if w not in WMS:
        raise Fail('kwin or labwc')
    sio.update_text(SESSION_CONF, lambda t: sio.conf_set_text(t, 'HEARTH_DESKTOP_WM', w))
    if w == 'kwin':
        # Turned back on: the safe start's count and its notice start over (nimbus-session's desk_fails kwin).
        try:
            with open(FAILS, encoding='utf-8') as f:
                rest = [l for l in f if not l.startswith('kwin ')]
            sio.write_text(FAILS, ''.join(rest)) if rest else os.remove(FAILS)
        except OSError:
            pass
        # ...and this sign-in too: "didn't start earlier this sign-in" is forgotten (nimbus-session's hearth-kwin-failed).
        try:
            os.remove(os.path.join(RUN, 'hearth-kwin-failed'))
        except OSError:
            pass
        with sio.locked(NOTICE):
            for p in (NOTICE, SHOWN):
                ns = read_notices(p)
                if any(n['what'] == 'kwin' for n in ns):
                    write_lines(p, [n for n in ns if n['what'] != 'kwin'])
    sio.log_event('desktop: Mantel on %s from the next start of Desktop Mode' % WMS[w])
    return status()


def cmd_notice():
    with sio.locked(NOTICE):          # the session's desk_notice takes the same lock
        pending = read_notices(NOTICE)
        if not pending:
            return {}
        n = pending[0]
        seen = [s for s in read_notices(SHOWN) if s['what'] != n['what']] + [n]
        write_lines(SHOWN, seen)
        write_lines(NOTICE, pending[1:])
    if n['kind'] == 'retired':
        try:
            sio.write_text(RETIRED_TOLD, 'told %d\n' % int(time.time()))
        except OSError:
            pass
    sio.log_event('desktop: notice shown (%s %s)' % (n['what'], n['kind']))
    n.pop('line', None)
    return n


def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    if cmd == 'status':
        out = status()
    elif cmd == 'notice':
        out = cmd_notice()
    elif cmd == 'kwin-overrides':
        out = cmd_kwin_overrides()
    elif cmd == 'wm' and len(argv) == 3:
        try:
            out = cmd_wm(argv[2])
        except Fail as e:
            print('error: %s' % e, flush=True)
            return 1
    else:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    print(json.dumps(out), flush=True)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv))
