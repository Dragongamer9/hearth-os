#!/usr/bin/python3
"""hearth-link-settings: Mantel's Settings › Hearth Link talking to the Hearth Link service (hosts/hearth-link),
through `hearth-link call` (its socket, only this user's).

  hearth-link-settings status                 JSON: this device, pairing code, paired and nearby devices, copies
  hearth-link-settings pair-open | pair-open-internet | pair-close
                                              (pair-open-internet: also a short code for a device somewhere else)
  hearth-link-settings join ID                the 6-digit code comes on stdin (HEARTH_INPUT), never on the command line
  hearth-link-settings join-code              a short code (K7M-4QX-92HC) on stdin: the device is looked up from it
  hearth-link-settings unpair ID
  hearth-link-settings set KEY VALUE          KEY: name, sync, alwaysAccept, relay, relayUrl
  hearth-link-settings sync
  hearth-link-settings pause|resume|cancel ID   a copy
  hearth-link-settings storage-set KEY on|off Hearth Storage (KEY: server, away, smb, archive, backups, media,
                                              backupSaves, backupShots, savesFollow)
  hearth-link-settings share-add PATH | share-remove ID   Hearth Storage's shared folders
  hearth-link-settings backup-now             back this device up to its Hearth Storage now
  hearth-link-settings devices                every paired device's health (asked of the Hearth Storage server)
  hearth-link-settings device-remove ID [backups] [archive]
                                              remove (unpair) a device you don't use anymore; with backups/archive,
                                              Hearth Storage deletes its backups / archived games too
Output: one JSON line; failures print "error: ..." and exit 1.
"""
import json
import os
import re
import subprocess
import sys

BIN = os.environ.get('HEARTH_LINK_BIN', '/usr/bin/hearth-link')
ID_RE = re.compile(r'^[0-9a-f]{16,64}(@\S{1,300})?$')
KEYS = {'name': str, 'sync': bool, 'alwaysAccept': bool, 'relay': str, 'relayUrl': str}
STORAGE_KEYS = ('server', 'away', 'smb', 'archive', 'backups', 'media', 'backupSaves', 'backupShots', 'savesFollow')
SHARE_RE = re.compile(r'^[0-9a-f]{4,32}$')
# Short codes (hosts/hearth-link shortcode.rs): no 0/O, 1/I/L; the weighted sum of the 10 (weights 1..10) is 0 mod 31.
ABC = '23456789ABCDEFGHJKMNPQRSTUVWXYZ'


def short_code(text):
    """A typed short code, checked: K7M-4QX-92HC, or Fail with why not (a typo is caught here, before the network)."""
    c = re.sub(r'[\s\-._]', '', text or '').upper()
    if re.search(r'[01OIL]', c):
        raise Fail("That code doesn't look right: codes never have 0, O, 1, I or L in them")
    if any(ch not in ABC for ch in c) or len(c) != 10:
        raise Fail("That code doesn't look right: it's 10 characters like K7M-4QX-92HC")
    if sum((i + 1) * ABC.index(ch) for i, ch in enumerate(c)) % 31:
        raise Fail("That code doesn't look right: one of the characters is off. Check it on the other device")
    return '%s-%s-%s' % (c[:3], c[3:6], c[6:])


class Fail(Exception):
    pass


def request(argv, stdin=''):
    """The service call for these arguments: (command, args)."""
    if not argv:
        raise Fail('usage: hearth-link-settings status|pair-open|pair-open-internet|pair-close|join ID|join-code|unpair ID|set KEY VALUE|sync|pause|resume|cancel ID')
    cmd, rest = argv[0], argv[1:]
    simple = {'status': 'status', 'pair-open': 'pair.open', 'pair-close': 'pair.close', 'sync': 'sync.now'}
    if cmd in simple and not rest:
        return simple[cmd], {}
    if cmd == 'pair-open-internet' and not rest:
        return 'pair.open', {'internet': True}
    if cmd == 'join-code' and not rest:
        return 'pair.join', {'code': short_code(stdin)}
    if cmd in ('join', 'unpair', 'pause', 'resume', 'cancel') and len(rest) == 1:
        target = rest[0].strip()
        if not ID_RE.match(target):
            raise Fail("That isn't a Hearth device or copy")
        if cmd == 'join':
            code = re.sub(r'[\s-]', '', stdin or '')
            if not re.fullmatch(r'\d{6}', code):
                raise Fail('The code is 6 digits')
            return 'pair.join', {'id': target, 'code': code}
        if cmd == 'unpair':
            return 'unpair', {'id': target}
        return 'transfer.' + cmd, {'id': target}
    if cmd == 'storage-set' and len(rest) == 2 and rest[0] in STORAGE_KEYS:
        if rest[1] not in ('on', 'off'):
            raise Fail('on or off')
        return 'storage.set', {rest[0]: rest[1] == 'on'}
    if cmd == 'share-add' and len(rest) == 1 and rest[0].startswith('/'):
        return 'storage.share.add', {'path': rest[0][:4096]}
    if cmd == 'share-remove' and len(rest) == 1:
        if not SHARE_RE.match(rest[0]):
            raise Fail("That isn't a shared folder")
        return 'storage.share.remove', {'id': rest[0]}
    if cmd == 'backup-now' and not rest:
        return 'storage.backup.now', {}
    if cmd == 'devices' and not rest:
        return 'storage.devices', {}
    if cmd == 'device-remove' and 1 <= len(rest) <= 3:
        if not re.fullmatch(r'[0-9a-f]{16,64}', rest[0]) or any(x not in ('backups', 'archive') for x in rest[1:]):
            raise Fail("That isn't a Hearth device")
        return 'storage.device.remove', {'id': rest[0], 'backups': 'backups' in rest[1:], 'archive': 'archive' in rest[1:]}
    if cmd == 'set' and len(rest) == 2 and rest[0] in KEYS:
        k, v = rest
        if KEYS[k] is bool:
            if v not in ('on', 'off'):
                raise Fail('on or off')
            return 'settings.set', {k: v == 'on'}
        return 'settings.set', {k: v[:300]}
    raise Fail('Unknown command')


def main(argv):
    try:
        cmd, args = request(argv[1:], os.environ.get('HEARTH_INPUT', ''))
        if not os.path.exists(BIN):
            raise Fail('Hearth Link comes with the next Hearth OS update')
        # Pairing from a short code looks it up, connects and checks the code: up to about 70 seconds.
        r = subprocess.run([BIN, 'call', cmd, json.dumps(args)], capture_output=True, text=True, timeout=120)
        lines = (r.stdout or '').strip().splitlines()
        v = json.loads(lines[-1]) if lines else {'error': 'Hearth Link didn\'t answer'}
        if r.returncode != 0 or (isinstance(v, dict) and set(v) == {'error'}):
            raise Fail(v.get('error') if isinstance(v, dict) else 'That didn\'t work')
        print(json.dumps(v if isinstance(v, dict) else {'value': v}))
        return 0
    except Fail as e:
        print('error: %s' % e)
        return 1
    except (OSError, ValueError, subprocess.SubprocessError) as e:
        print('error: %s' % e)
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv))
