#!/usr/bin/env python3
"""hearth-pad: use the whole Hearth desktop with a game controller.

Started by the Desktop Mode shell (Pad.qml), which reads what this prints and draws the menus.
It reads every connected controller from /dev/input and acts as a mouse and keyboard through
/dev/uinput:

  Right stick   move the pointer (R3: precise)      Left stick   scroll
  A / RT        click (hold to drag)                X / LT       right-click
  B             back (Esc)                          Y            on-screen keyboard
  D-pad         arrow keys                          LB / RB      switch windows
  Menu (☰)      apps                                Guide        Hearth menu (radial)
  View + D-pad  snap left/right, maximize, minimize View + B     close the window
  View (tap)    show these controls                 L3           middle-click
  Guide + X     on-screen keyboard (open / close), like Steam + X

Talks to the shell with one JSON object per line: events out on stdout, commands in on stdin.
Out: ready, error, radial {open, sel, pick}, osk {open} (Y: please open the on-screen keyboard), launcher, help,
     mouse {on}, toast {text}; while the keyboard is open: oskpad {b, down} (every button but Guide and RT) and
     oskaxes {lx, ly, rx, ry} (the left stick; the right one too with split sticks).
In:  pause {on} (a fullscreen app is in front), keys {on} (a menu with keyboard focus is open:
     A is Enter, B is Esc), osk {open, split} (the keyboard opened or closed: Hearth's shared keyboard,
     desktop/shell/Keyboard.qml, does the typing; split: both sticks are its), emit {text, mods} and key {key, n, mods}
     (typing through uinput when wtype isn't there; US layout, ASCII), rumble {strength, ms},
     mouse {on} (controller mouse on/off), radial {open}.
While the on-screen keyboard is open the right stick still moves the pointer and RT clicks (into another text field).
Exit codes: 2 python3-evdev missing, 3 no access to /dev/uinput (the shell doesn't restart those).

--osk: Hearth Plasma's on-screen keyboard (desktop/shell/osk-plasma.qml): only Guide + X, which asks for the keyboard
(osk {open}); while it's open the controller is the keyboard's alone (grabbed: apps don't see the presses) and typing goes
through this helper's uinput keyboard (KWin has no wtype). The rest of the time it does nothing.

--cosmic: Hearth COSMIC's controller (docs/COSMIC.md), started by desktop/shell/desk-cosmic.qml (which draws the Hearth
menu, the launcher, Quick Access and the keyboard, as Pad.qml does for Hearth Classic). The same desktop as above, but
keyboard-first in every window, with COSMIC's own shortcuts and per-app keys for COSMIC Files, Terminal and Edit (the
shell tells it which app is in front: app {id}): see CosmicPad.

--plasma: Hearth Plasma's controller (started by desktop/shell/osk-plasma.qml, which draws the Hearth menu, the
controls card and the keyboard over KDE Plasma). Everything Hearth Classic does, through KWin's own shortcuts instead
of labwc's, all typed through this helper's uinput keyboard (KWin has no wtype):
  Menu (☰)       Plasma's launcher (the host asks plasmashell)   View + B       close the window (Alt+F4)
  View + D-pad   tile left / right, maximize, minimize           View + A       the taskbar: D-pad along it, A opens
  View + X       Overview (every window: D-pad, A picks one)     View + Y       clipboard history (Meta+V)
  Guide          Hearth menu (Quick Access there opens Hearth's Quick Access widget, Meta+Alt+A)
A KWin script (/usr/share/kwin/scripts/hearthpad) says which window is in front over D-Bus (org.hearth.Pad, served
here with GLib's D-Bus when python3-gi is there): Plasma's popups (the launcher, the tray, Quick Access), the taskbar,
KRunner, Dolphin, System Settings and the lock screen get the keys (A Enter, B Esc, X the Menu key; RT / LT still
click), a fullscreen window pauses the controller as in Classic. A text field that KWin reports right after you used
the controller (KRunner, KDE apps) opens the on-screen keyboard. Without python3-gi it still works, A just clicks.

--game: Game Mode's controller mouse (started by Hearth, hearth-core padmouse.rs). Only the mouse: right stick,
A / RT click, X / LT right-click, L3 middle-click, left stick scroll, B Esc, D-pad arrows, R3 precise. Guide, Menu,
View, LB/RB and Y do nothing here (they're the game's and Hearth's). View + Menu together turns it off: it says
mouse {on: false} and exits. Hearth sends pause {on} while it or its Quick Access is in front.
"""
import json
import math
import os
import queue
import threading
import select
import socket
import sys
import time

RADIAL_ITEMS = 8
DEAD = 0.14
POINTER_SPEED = 1500.0      # px/s at full tilt
PRECISE = 0.3
SCROLL_SPEED = 16.0         # wheel notches/s at full tilt
ALT_HOLD = 0.9              # s the window switcher stays open after the last LB/RB
HELP_TAP = 0.45             # View shorter than this (and not used with the D-pad) shows the controls

# Shifted characters on a US keyboard (typing through uinput when wtype is missing).
OSK_SHIFTED = {'`': '~', '1': '!', '2': '@', '3': '#', '4': '$', '5': '%', '6': '^', '7': '&', '8': '*',
               '9': '(', '0': ')', '-': '_', '=': '+', '[': '{', ']': '}', '\\': '|', ';': ':', "'": '"',
               ',': '<', '.': '>', '/': '?'}
OSK_SPECIAL = {'space': 'KEY_SPACE', 'bksp': 'KEY_BACKSPACE', 'tab': 'KEY_TAB', 'enter': 'KEY_ENTER', 'esc': 'KEY_ESC',
               'up': 'KEY_UP', 'down': 'KEY_DOWN', 'left': 'KEY_LEFT', 'right': 'KEY_RIGHT', 'home': 'KEY_HOME', 'end': 'KEY_END'}
# What the on-screen keyboard gets while it's open (Guide stays the Hearth menu, RT the pointer's click).
OSK_BUTTONS = ('a', 'b', 'x', 'y', 'lb', 'rb', 'lt', 'view', 'menu', 'l3', 'r3', 'up', 'down', 'left', 'right')

# Characters the keyboard types → (key, needs Shift). US layout.
_BASE = {'`': 'KEY_GRAVE', '-': 'KEY_MINUS', '=': 'KEY_EQUAL', '[': 'KEY_LEFTBRACE', ']': 'KEY_RIGHTBRACE',
         '\\': 'KEY_BACKSLASH', ';': 'KEY_SEMICOLON', "'": 'KEY_APOSTROPHE', ',': 'KEY_COMMA', '.': 'KEY_DOT',
         '/': 'KEY_SLASH', ' ': 'KEY_SPACE'}
CHARS = {c: (k, False) for c, k in _BASE.items()}
for _c in 'abcdefghijklmnopqrstuvwxyz':
    CHARS[_c] = ('KEY_' + _c.upper(), False)
    CHARS[_c.upper()] = ('KEY_' + _c.upper(), True)
for _c in '0123456789':
    CHARS[_c] = ('KEY_' + _c, False)
for _plain, _shifted in OSK_SHIFTED.items():
    CHARS[_shifted] = (CHARS[_plain][0], True)

ARROWS = {'up': 'KEY_UP', 'down': 'KEY_DOWN', 'left': 'KEY_LEFT', 'right': 'KEY_RIGHT'}
SNAP = {'up': 'KEY_UP', 'down': 'KEY_DOWN', 'left': 'KEY_LEFT', 'right': 'KEY_RIGHT'}  # with Super

KEYS_USED = sorted({k for k, _ in CHARS.values()} | set(ARROWS.values()) |
                   set(OSK_SPECIAL.values()) |
                   {'KEY_LEFTSHIFT', 'KEY_LEFTCTRL', 'KEY_LEFTALT', 'KEY_LEFTMETA', 'KEY_TAB', 'KEY_ENTER', 'KEY_ESC',
                    'KEY_BACKSPACE', 'KEY_Q', 'KEY_COMPOSE', 'KEY_V', 'KEY_F4', 'KEY_PAGEUP', 'KEY_PAGEDOWN'})
MODS = {'ctrl': 'KEY_LEFTCTRL', 'alt': 'KEY_LEFTALT', 'shift': 'KEY_LEFTSHIFT'}


# ---- Hearth COSMIC (--cosmic): keys it sends besides the ones above.
COSMIC_KEYS = ['KEY_F', 'KEY_PAGEUP', 'KEY_PAGEDOWN', 'KEY_F10', 'KEY_G']
KEYS_USED = sorted(set(KEYS_USED) | set(COSMIC_KEYS))
# ---- end Hearth COSMIC

# ---- Hearth Plasma (--plasma): KWin's and Plasma's own shortcuts for what labwc's are in Hearth Classic.
PLASMA_SHORTCUTS = {
    'close': ('KEY_LEFTALT', 'KEY_F4'),
    'quick': ('KEY_LEFTMETA', 'KEY_LEFTALT', 'KEY_A'),        # Hearth Quick Access (org.hearth.quicksettings)
    'panel': ('KEY_LEFTMETA', 'KEY_LEFTALT', 'KEY_P'),        # keyboard focus on the taskbar
    'clipboard': ('KEY_LEFTMETA', 'KEY_V'),                   # Klipper's history
    'overview': ('KEY_LEFTMETA', 'KEY_W'),
    'maximize': ('KEY_LEFTMETA', 'KEY_PAGEUP'),
    'minimize': ('KEY_LEFTMETA', 'KEY_PAGEDOWN'),
    'tile-left': ('KEY_LEFTMETA', 'KEY_LEFT'),
    'tile-right': ('KEY_LEFTMETA', 'KEY_RIGHT'),
}
PLASMA_VIEW = {'up': 'maximize', 'down': 'minimize', 'left': 'tile-left', 'right': 'tile-right',
               'b': 'close', 'a': 'panel', 'x': 'overview', 'y': 'clipboard'}
# What opens something that takes the keys without a window of its own coming to the front (until one does, or B / A).
PLASMA_KEY_OVERLAYS = ('panel', 'overview', 'quick', 'clipboard')
PLASMA_SHELL = ('plasmashell', 'org.kde.plasmashell')
PLASMA_KEY_APPS = ('krunner', 'org.kde.krunner', 'dolphin', 'org.kde.dolphin', 'systemsettings',
                   'org.kde.systemsettings', 'kscreenlocker_greet', 'org.kde.kscreenlocker_greet')
PLASMA_SEARCH = ('krunner', 'org.kde.krunner', 'konsole', 'org.kde.konsole')   # open the keyboard when they come up
# Hearth Plasma's own apps (the KDE-based Hearth Files, Terminal, Text, Reader, Capture, Calculator), like Mantel's: D-pad
# moves, A opens, B back, X the context menu, Y search, LB / RB tabs, LT / RT scroll. Only what differs from that per
# app; None: the app does it itself (Hearth Files from Dolphin reads the controller for those: hearthgamepad.cpp),
# 'osk': the on-screen keyboard. The window class without "org.kde.".
PLASMA_APPS = {
    'dolphin': {'y': ('KEY_LEFTCTRL', 'KEY_I'), 'lb': None, 'rb': None, 'lt': None, 'rt': None, 'view': None},
    'konsole': {'y': 'osk', 'lb': ('KEY_LEFTSHIFT', 'KEY_LEFT'), 'rb': ('KEY_LEFTSHIFT', 'KEY_RIGHT'),
                'lt': ('KEY_LEFTSHIFT', 'KEY_PAGEUP'), 'rt': ('KEY_LEFTSHIFT', 'KEY_PAGEDOWN')},
    'kate': {'y': ('KEY_LEFTCTRL', 'KEY_F'), 'lb': ('KEY_LEFTCTRL', 'KEY_PAGEUP'), 'rb': ('KEY_LEFTCTRL', 'KEY_PAGEDOWN'),
             'lt': ('KEY_PAGEUP',), 'rt': ('KEY_PAGEDOWN',)},
    'okular': {'y': ('KEY_LEFTCTRL', 'KEY_F'), 'lb': ('KEY_LEFTCTRL', 'KEY_LEFTSHIFT', 'KEY_TAB'), 'rb': ('KEY_LEFTCTRL', 'KEY_TAB'),
               'lt': ('KEY_PAGEUP',), 'rt': ('KEY_PAGEDOWN',)},
    'spectacle': {'y': ('KEY_LEFTCTRL', 'KEY_N'), 'lt': ('KEY_PAGEUP',), 'rt': ('KEY_PAGEDOWN',)},
    'kcalc': {'y': 'osk'},
}


def plasma_app(cls):
    c = (cls or '').lower()
    return PLASMA_APPS.get(c[len('org.kde.'):] if c.startswith('org.kde.') else c)
PLASMA_OSK_RECENT = 8.0      # s: a text field opens the keyboard by itself only this soon after the controller was used


def plasma_keys_context(cls, kind):
    """Does the window in front take the controller as keys (D-pad arrows, A Enter)? Plasma's popups and its
    taskbar do (not the desktop itself: A clicks its icons), and the KDE apps built for the keyboard."""
    c = (cls or '').lower()
    if c in PLASMA_SHELL:
        return kind not in ('desktop', 'none', '')
    return c in PLASMA_KEY_APPS or plasma_app(c) is not None


def curve(v):
    """Stick value → speed factor: nothing inside the dead zone, then a smooth ramp."""
    m = abs(v)
    if m < DEAD:
        return 0.0
    f = (m - DEAD) / (1 - DEAD)
    return math.copysign(f * f, v)


class Pad:
    """What the controller does, without any device code (so it can be tested)."""

    def __init__(self, out, game=False, osk_only=False, plasma=False):
        self.out = out             # .move(dx, dy) .wheel(v, h) .press(name, down) .send(obj)
        self.game = game           # --game: Game Mode's controller mouse, nothing else
        self.osk_only = osk_only   # --osk: Hearth Plasma's keyboard only: Guide + X, and the keyboard while it's open
        self.plasma = plasma       # --plasma: Hearth Plasma's whole controller (plasma_* below)
        self.win = ('', '', False, '')   # --plasma: the window in front (class, title, fullscreen, kind), from KWin
        self.key_overlay = False   # --plasma: the taskbar / Overview / a popup has the keys until a window says otherwise
        self.textfield = False     # --plasma: KWin says a text field has the focus
        self.last_input = -1e9     # when a controller button last went down
        self.guide_from = None     # what was open when Guide went down (Guide + X closes the keyboard if it was)
        self.done = False          # --game: turned off with View + Menu
        self.mode = 'desk'         # desk | radial | osk
        self.fs_pause = False      # a fullscreen app (a game) is in front
        self.user_off = False      # turned off from the menu
        self.keys_ctx = False
        self.sticks = (0.0, 0.0, 0.0, 0.0)
        self.held = {}             # button → time pressed
        self.mouse_src = {'BTN_LEFT': set(), 'BTN_RIGHT': set(), 'BTN_MIDDLE': set()}
        self.keys_down = set()     # keys we hold for a held button (arrows)
        self.alt_until = 0.0
        self.view_used = False
        self.precise = False
        self.speed = 1.0           # pointer speed multiplier (Hearth Settings › Controller)
        self.sel = -1
        self.osk_split = False     # split sticks: the right stick is the keyboard's too (no pointer)
        self.osk_axes = (0.0, 0.0, 0.0, 0.0)
        self.osk_axes_at = 0.0
        self.repeat = {}           # nav direction → next repeat time (radial)
        self.acc = [0.0, 0.0, 0.0, 0.0]   # sub-pixel pointer x/y, wheel v/h (in 1/120 notches)

    # ------------------------------------------------------------------ helpers
    @property
    def paused(self):
        return self.fs_pause or self.user_off

    def tap(self, *keys):
        for k in keys:
            self.out.press(k, True)
        for k in reversed(keys):
            self.out.press(k, False)

    def mouse(self, btn, src, down):
        s = self.mouse_src[btn]
        was = bool(s)
        (s.add if down else s.discard)(src)
        if bool(s) != was:
            self.out.press(btn, bool(s))

    def release_all(self):
        for btn, s in self.mouse_src.items():
            if s:
                s.clear()
                self.out.press(btn, False)
        for k in list(self.keys_down):
            self.out.press(k, False)
        self.keys_down.clear()
        if self.alt_until:
            self.alt_until = 0.0
            self.out.press('KEY_LEFTALT', False)

    def set_mode(self, mode):
        if mode != self.mode:
            self.release_all()
            self.mode = mode
            self.repeat.clear()

    def want_osk(self):
        """Y: asks the shell for the on-screen keyboard (it answers osk {open: true})."""
        self.out.send({'t': 'osk', 'open': True})

    def open_osk(self, split=False):
        self.set_mode('osk')
        self.osk_split = bool(split)
        self.osk_axes = (0.0, 0.0, 0.0, 0.0)

    def close_osk(self):
        self.set_mode('desk')
        self.osk_split = False

    def open_radial(self):
        self.set_mode('radial')
        self.sel = -1
        self.out.send({'t': 'radial', 'open': True, 'sel': -1})

    def close_radial(self, pick=-1):
        self.set_mode('desk')
        self.out.send({'t': 'radial', 'open': False, 'pick': pick})

    def type_char(self, ch, mods=()):
        if ch not in CHARS:
            return False
        key, shift = CHARS[ch]
        self.tap(*(list(mods) + (['KEY_LEFTSHIFT'] if shift else []) + [key]))
        return True

    def emit_text(self, text, mods=()):
        """Typing for the on-screen keyboard when wtype isn't there: what a US keyboard can type (the rest is skipped)."""
        m = [MODS[x] for x in mods if x in MODS]
        skipped = 0
        for ch in str(text)[:500]:
            if ch == '\n':
                self.tap(*(m + ['KEY_ENTER']))
            elif not self.type_char(ch, m):
                skipped += 1
        return skipped

    def emit_key(self, name, n=1, mods=()):
        m = [MODS[x] for x in mods if x in MODS]
        if name == 'paste':
            return self.tap('KEY_LEFTCTRL', 'KEY_V')
        if name not in OSK_SPECIAL:
            return
        for _ in range(max(1, min(int(n or 1), 200))):
            self.tap(*(m + [OSK_SPECIAL[name]]))

    def radial_set(self, sel):
        if sel != self.sel:
            self.sel = sel
            self.out.send({'t': 'radial', 'open': True, 'sel': sel})

    # ------------------------------------------------------------------ input
    def button(self, name, down, now):
        if down:
            self.held[name] = now
            self.last_input = now
        else:
            self.held.pop(name, None)

        if self.game:
            return self.game_button(name, down, now)
        if name == 'guide':
            if down:
                self.guide_from = self.mode
                if not self.osk_only:
                    self.close_radial() if self.mode == 'radial' else self.open_radial()
            return
        if name == 'x' and down and 'guide' in self.held:
            return self.osk_chord()
        if self.osk_only and self.mode != 'osk':
            return

        if self.mode == 'radial':
            return self.radial_button(name, down, now)
        if self.mode == 'osk':
            return self.osk_button(name, down, now)
        if self.paused:
            return
        if self.plasma:
            return self.plasma_button(name, down, now)
        if self.keys_ctx:
            return self.keys_button(name, down)
        return self.desk_button(name, down, now)

    def osk_chord(self):
        """Guide + X: the on-screen keyboard, like Steam + X. The radial menu that Guide's press opened goes away again;
        the keyboard closes if it was open when Guide went down."""
        was_open = self.guide_from == 'osk' or self.mode == 'osk'
        if self.mode == 'radial':
            self.close_radial()
        self.out.send({'t': 'osk', 'open': not was_open})
        if was_open:
            self.close_osk()
        self.guide_from = None

    @property
    def wants_grab(self):
        """--osk / --plasma: the controller is the keyboard's alone while it's open."""
        return (self.osk_only or self.plasma) and self.mode == 'osk'

    def game_button(self, name, down, now):
        if down and name in ('view', 'menu') and 'view' in self.held and 'menu' in self.held:
            self.release_all()
            self.done = True
            self.out.send({'t': 'mouse', 'on': False})
            return
        if self.paused:
            return
        if name in ('a', 'rt'):
            return self.mouse('BTN_LEFT', name, down)
        if name in ('x', 'lt'):
            return self.mouse('BTN_RIGHT', name, down)
        if name == 'l3':
            return self.mouse('BTN_MIDDLE', name, down)
        if name in ARROWS:
            return self.hold_key(ARROWS[name], down)
        if not down:
            return
        if name == 'b':
            self.tap('KEY_ESC')
        elif name == 'r3':
            self.precise = not self.precise

    def radial_button(self, name, down, now):
        if not down:
            return
        if name == 'a' and self.sel >= 0:
            self.close_radial(self.sel)
        elif name == 'b':
            self.close_radial()
        elif name in ('up', 'right', 'down', 'left'):
            self.radial_set({'up': 0, 'right': 2, 'down': 4, 'left': 6}[name] * RADIAL_ITEMS // 8)
        elif name in ('lb', 'rb'):
            self.radial_set(((self.sel if self.sel >= 0 else 0) + (1 if name == 'rb' else -1)) % RADIAL_ITEMS)

    def osk_button(self, name, down, now):
        if name == 'rt' and not self.osk_split:   # click a field without closing the keyboard
            return self.mouse('BTN_LEFT', 'rt', down)
        if name in OSK_BUTTONS or (name == 'rt' and self.osk_split):
            self.out.send({'t': 'oskpad', 'b': name, 'down': bool(down)})

    def keys_button(self, name, down):
        if name in ARROWS:
            return self.hold_key(ARROWS[name], down)
        if not down:
            return
        if name == 'a':
            self.tap('KEY_ENTER')
        elif name == 'b':
            self.tap('KEY_ESC')
        elif name == 'x':
            self.tap('KEY_COMPOSE')          # the Menu key: the actions menu in Hearth Files
        elif name == 'y':
            self.want_osk()
        elif name == 'menu':
            self.out.send({'t': 'launcher'})

    def hold_key(self, key, down):
        if down and key not in self.keys_down:
            self.keys_down.add(key)
            self.out.press(key, True)
        elif not down and key in self.keys_down:
            self.keys_down.discard(key)
            self.out.press(key, False)

    def desk_button(self, name, down, now):
        view = 'view' in self.held
        if name in ('a', 'rt'):
            return self.mouse('BTN_LEFT', name, down)
        if name in ('x', 'lt'):
            return self.mouse('BTN_RIGHT', name, down)
        if name == 'l3':
            return self.mouse('BTN_MIDDLE', name, down)
        if name in ARROWS:
            if view:
                if down:
                    self.view_used = True
                    self.tap('KEY_LEFTMETA', SNAP[name])
                return
            return self.hold_key(ARROWS[name], down)
        if name == 'view':
            if down:
                self.view_used = False
                self.view_at = now
            elif not self.view_used and now - getattr(self, 'view_at', now) < HELP_TAP:
                self.out.send({'t': 'help'})
            return
        if not down:
            return
        if name == 'b':
            if view:
                self.view_used = True
                self.tap('KEY_LEFTMETA', 'KEY_Q')
            else:
                self.tap('KEY_ESC')
        elif name == 'y':
            self.want_osk()
        elif name == 'menu':
            self.out.send({'t': 'launcher'})
        elif name in ('lb', 'rb'):
            if not self.alt_until:
                self.out.press('KEY_LEFTALT', True)
            self.alt_until = now + ALT_HOLD
            self.tap(*(['KEY_TAB'] if name == 'rb' else ['KEY_LEFTSHIFT', 'KEY_TAB']))
        elif name == 'r3':
            self.precise = not self.precise
            self.out.send({'t': 'toast', 'text': 'Precise pointer ' + ('on' if self.precise else 'off')})

    def axes(self, lx, ly, rx, ry):
        self.sticks = (lx, ly, rx, ry)

    def tick(self, now, dt):
        lx, ly, rx, ry = self.sticks
        if self.alt_until and now >= self.alt_until:
            self.alt_until = 0.0
            self.out.press('KEY_LEFTALT', False)

        if self.mode == 'radial':
            # Point either stick at an item.
            for x, y in ((rx, ry), (lx, ly)):
                if math.hypot(x, y) > 0.55:
                    ang = math.atan2(x, -y) % (2 * math.pi)     # 0 = up, clockwise
                    self.radial_set(int(round(ang / (2 * math.pi / RADIAL_ITEMS))) % RADIAL_ITEMS)
                    break
            return

        if self.mode == 'osk':
            # The keyboard reads the left stick itself (moving, the Ember Wheel; both sticks with split sticks):
            # sent when it moves, at most every 30 ms.
            ax = (lx, ly, rx, ry) if self.osk_split else (lx, ly, 0.0, 0.0)
            if any(abs(a - b) > 0.04 for a, b in zip(ax, self.osk_axes)) and now - self.osk_axes_at >= 0.03:
                self.osk_axes = ax
                self.osk_axes_at = now
                self.out.send({'t': 'oskaxes', 'lx': round(ax[0], 3), 'ly': round(ax[1], 3), 'rx': round(ax[2], 3), 'ry': round(ax[3], 3)})
            if self.osk_split:
                return
        elif self.paused or self.osk_only:
            return

        # Pointer (right stick), in every mode but the radial menu.
        speed = POINTER_SPEED * self.speed * (PRECISE if self.precise else 1.0) * dt
        self.acc[0] += curve(rx) * speed
        self.acc[1] += curve(ry) * speed
        dx, dy = int(self.acc[0]), int(self.acc[1])
        self.acc[0] -= dx
        self.acc[1] -= dy
        if dx or dy:
            self.out.move(dx, dy)

        # Scroll (left stick), not while the keyboard uses it.
        if self.mode == 'desk':
            self.acc[2] += -curve(ly) * SCROLL_SPEED * 120 * dt
            self.acc[3] += curve(lx) * SCROLL_SPEED * 120 * dt
            v, h = int(self.acc[2]), int(self.acc[3])
            self.acc[2] -= v
            self.acc[3] -= h
            if v or h:
                self.out.wheel(v, h)

    # ------------------------------------------------------------------ from the shell
    def command(self, m):
        c = m.get('cmd')
        if c == 'pause':
            if bool(m.get('on')) != self.fs_pause:
                note('paused: a fullscreen window is in front' if m.get('on') else 'resumed')
            self.fs_pause = bool(m.get('on'))
            if self.paused and self.mode == 'desk':
                self.release_all()
        elif c == 'keys':
            self.release_all()
            self.keys_ctx = bool(m.get('on'))
        elif c == 'osk':
            self.open_osk(m.get('split')) if m.get('open') else (self.close_osk() if self.mode == 'osk' else None)
        elif c == 'emit':
            self.emit_text(m.get('text', ''), m.get('mods') or ())
        elif c == 'key':
            self.emit_key(str(m.get('key', '')), m.get('n', 1), m.get('mods') or ())
        elif c == 'rumble':
            self.out.rumble(m.get('strength', 0.3), m.get('ms', 20))
        elif c == 'mouse':
            self.user_off = not m.get('on', True)
            if self.user_off:
                self.release_all()
            self.out.send({'t': 'mouse', 'on': not self.user_off})
        elif c == 'speed':
            try:
                self.speed = max(0.2, min(3.0, float(m.get('value', 1.0))))
            except (TypeError, ValueError):
                pass
        elif c == 'radial':
            self.open_radial() if m.get('open') else (self.close_radial() if self.mode == 'radial' else None)
        elif c == 'plasma' and self.plasma:
            self.plasma_do(str(m.get('do', '')))
        elif c == 'window' and self.plasma:
            self.plasma_window(str(m.get('cls', '')), str(m.get('caption', '')), bool(m.get('fullscreen')),
                               str(m.get('kind', '')), m.get('now'))
        elif c == 'textfield' and self.plasma:
            self.plasma_textfield(bool(m.get('on')), m.get('now'))

    # ------------------------------------------------------------------ Hearth Plasma (--plasma)
    def plasma_keys(self):
        return plasma_keys_context(self.win[0], self.win[3]) or self.key_overlay

    def plasma_sync_keys(self):
        keys = self.plasma_keys()
        if keys != self.keys_ctx:
            self.release_all()
            self.keys_ctx = keys

    def plasma_do(self, action):
        """A Plasma shortcut by name (PLASMA_SHORTCUTS): from View + a button, or the host (the Hearth menu)."""
        keys = PLASMA_SHORTCUTS.get(action)
        if not keys:
            return
        self.tap(*keys)
        if action in PLASMA_KEY_OVERLAYS:
            self.key_overlay = True
            self.plasma_sync_keys()

    def plasma_button(self, name, down, now):
        if name != 'view' and name in PLASMA_VIEW and 'view' in self.held:
            if down:
                self.view_used = True
                self.plasma_do(PLASMA_VIEW[name])
            return
        if not self.keys_ctx:
            return self.desk_button(name, down, now)
        app = None if self.key_overlay else plasma_app(self.win[0])
        if app is not None and name in app:
            act = app[name]
            if act == 'osk':
                if down:
                    self.want_osk()
            elif act is not None and down:
                self.tap(*act)
            return
        # A menu, the taskbar or a keyboard app has the keys; the triggers still click where the pointer is,
        # LB / RB still switch windows and View still shows the controls.
        if name == 'rt':
            return self.mouse('BTN_LEFT', name, down)
        if name == 'lt':
            return self.mouse('BTN_RIGHT', name, down)
        if name in ('lb', 'rb', 'view', 'l3', 'r3'):
            return self.desk_button(name, down, now)
        self.keys_button(name, down)
        if down and name in ('a', 'b') and self.key_overlay:
            # Enter picked something, Esc closed it: back to what the window in front wants.
            self.key_overlay = False
            self.plasma_sync_keys()

    def plasma_window(self, cls, caption, fullscreen, kind, now=None):
        """KWin's script: this window is in front now (or none)."""
        now = time.monotonic() if now is None else now
        before = self.win
        self.win = (cls, caption, fullscreen, kind)
        self.key_overlay = False
        self.plasma_sync_keys()
        fs = fullscreen and kind not in ('desktop', 'dock') and cls.lower() not in PLASMA_SHELL
        if fs != self.fs_pause:
            self.fs_pause = fs
            if self.paused and self.mode == 'desk':
                self.release_all()
        if (before[0], before[3], before[2]) != (cls, kind, fullscreen):
            note('in front: %r (%s)%s%s' % (cls, kind or '?', ', fullscreen: paused' if fs else '', ', keys' if self.keys_ctx else ''))
        if cls.lower() in PLASMA_SEARCH and before[0].lower() not in PLASMA_SEARCH:
            self.plasma_auto_osk(now)

    def plasma_textfield(self, on, now=None):
        """KWin: a text field got (or lost) the focus. Like Hearth Classic's own text fields, the keyboard opens by
        itself when you got there with the controller (not in Plasma's launcher, whose list the D-pad works)."""
        now = time.monotonic() if now is None else now
        was = self.textfield
        self.textfield = on
        if on and not was and self.win[0].lower() not in PLASMA_SHELL:
            self.plasma_auto_osk(now)

    def plasma_auto_osk(self, now):
        if self.mode == 'desk' and not self.paused and now - self.last_input < PLASMA_OSK_RECENT:
            self.want_osk()


