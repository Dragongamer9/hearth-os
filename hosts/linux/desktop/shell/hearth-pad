SINK = [None]      # --socket: where events go instead of stdout (CosmicLink.send)


def emit(obj):
    if SINK[0]:
        return SINK[0](obj)
    sys.stdout.write(json.dumps(obj) + '\n')
    sys.stdout.flush()


class CosmicLink:
    """--socket PATH (Hearth COSMIC): the shell talks to hearth-pad over a Unix socket instead of stdin / stdout, so the
    controller keeps working (pointer, keys) while the shell (desk-cosmic.qml) is restarted; the menus come back
    with it. One shell at a time; only this user can open the socket."""

    def __init__(self, path):
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass
        self.srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        old = os.umask(0o177)
        try:
            self.srv.bind(path)
        finally:
            os.umask(old)
        self.srv.listen(2)
        self.cli = None
        self.buf = ''
        self.pending = []          # menus asked for while no shell was connected (sent when it comes back)
        SINK[0] = self.send

    def fds(self):
        return [self.srv.fileno()] + ([self.cli.fileno()] if self.cli else [])

    def send(self, obj):
        if not self.cli:
            # The launcher, the Hearth menu, the keyboard or the controls asked for while the shell restarts: shown as
            # soon as it's back (a second or two) instead of the press being lost.
            if obj.get('t') in ('launcher', 'help', 'osk') or (obj.get('t') == 'radial' and obj.get('open')):
                self.pending = [p for p in self.pending if p.get('t') != obj.get('t')][-3:] + [obj]
            elif obj.get('t') == 'radial':
                self.pending = [p for p in self.pending if p.get('t') != 'radial']
            return
        try:
            self.cli.sendall((json.dumps(obj) + '\n').encode())
        except OSError:
            self.drop()

    def drop(self):
        try:
            self.cli.close()
        except (OSError, AttributeError):
            pass
        self.cli = None
        self.buf = ''

    def read(self, fd, pad):
        """Lines from the shell; a new shell (or the shell gone) puts the controller back to the plain desktop."""
        if fd == self.srv.fileno():
            c, _ = self.srv.accept()
            c.settimeout(0.5)
            self.drop()
            self.cli = c
            pending, self.pending = self.pending, []
            if not any(p.get('t') == 'radial' for p in pending):
                pad.set_mode('desk')
            pad.keys_ctx = False
            note('shell connected')
            self.send({'t': 'ready'})
            for p in pending:
                self.send(p)
            return []
        if not self.cli or fd != self.cli.fileno():
            return []
        try:
            data = self.cli.recv(4096)
        except (BlockingIOError, socket.timeout):
            return []
        except OSError:
            data = b''
        if not data:
            note('shell went away; the controller keeps working')
            self.drop()
            if pad.mode != 'radial':
                pad.set_mode('desk')
            pad.keys_ctx = False
            return []
        self.buf += data.decode('utf-8', 'replace')
        lines = self.buf.split('\n')
        self.buf = lines.pop()
        return lines


class Output:
    """Virtual mouse and keyboard (uinput)."""

    def __init__(self, evdev):
        e = evdev.ecodes
        self.e = e
        rel = [e.REL_X, e.REL_Y, e.REL_WHEEL, e.REL_HWHEEL]
        self.hires = hasattr(e, 'REL_WHEEL_HI_RES')
        if self.hires:
            rel += [e.REL_WHEEL_HI_RES, e.REL_HWHEEL_HI_RES]
        self.ptr = evdev.UInput({e.EV_KEY: [e.BTN_LEFT, e.BTN_RIGHT, e.BTN_MIDDLE], e.EV_REL: rel},
                                name='Hearth controller pointer')
        self.kbd = evdev.UInput({e.EV_KEY: [getattr(e, k) for k in KEYS_USED]}, name='Hearth controller keyboard')
        self.wheel_acc = [0, 0]
        self.rumbler = None

    def move(self, dx, dy):
        e = self.e
        if dx:
            self.ptr.write(e.EV_REL, e.REL_X, dx)
        if dy:
            self.ptr.write(e.EV_REL, e.REL_Y, dy)
        self.ptr.syn()

    def wheel(self, v, h):
        e = self.e
        # v, h in 1/120 notches: hi-res for smooth scrolling, whole notches for apps that only read those.
        for i, (amount, lo, hi) in enumerate(((v, e.REL_WHEEL, getattr(e, 'REL_WHEEL_HI_RES', None)),
                                              (h, e.REL_HWHEEL, getattr(e, 'REL_HWHEEL_HI_RES', None)))):
            if not amount:
                continue
            if self.hires and hi is not None:
                self.ptr.write(e.EV_REL, hi, amount)
            self.wheel_acc[i] += amount
            notches = int(self.wheel_acc[i] / 120)
            if notches:
                self.wheel_acc[i] -= notches * 120
                self.ptr.write(e.EV_REL, lo, notches)
        self.ptr.syn()

    def press(self, name, down):
        dev = self.ptr if name.startswith('BTN_') else self.kbd
        dev.write(self.e.EV_KEY, getattr(self.e, name), 1 if down else 0)
        dev.syn()

    def send(self, obj):
        emit(obj)

    def rumble(self, strength, ms):
        """A short rumble on every controller that can (the on-screen keyboard's key presses)."""
        if self.rumbler:
            try:
                self.rumbler(float(strength), int(ms))
            except (TypeError, ValueError, OSError):
                pass


SONY = 0x054c


def button_map(e, vendor=0):
    """Event codes → button names. xpad's X/Y codes (X is BTN_NORTH); Sony pads (hid-playstation) swap them:
    Triangle (top, Y's place) is BTN_NORTH and Square (left, X's place) BTN_WEST, so Y and X were the wrong way round
    there (Y opened nothing, X typed a space on the keyboard). The d-pad also comes as BTN_TRIGGER_HAPPY1-4 (xpad's
    dpad_to_buttons, some wireless dongles), and the Xbox button of an Xbox controller over Bluetooth without xpadneo
    as KEY_HOMEPAGE: both did nothing before."""
    m = {e.BTN_SOUTH: 'a', e.BTN_EAST: 'b', e.BTN_NORTH: 'x', e.BTN_WEST: 'y',
         e.BTN_TL: 'lb', e.BTN_TR: 'rb', e.BTN_TL2: 'lt', e.BTN_TR2: 'rt',
         e.BTN_SELECT: 'view', e.BTN_START: 'menu', e.BTN_MODE: 'guide',
         e.BTN_THUMBL: 'l3', e.BTN_THUMBR: 'r3'}
    for code, name in (('BTN_DPAD_UP', 'up'), ('BTN_DPAD_DOWN', 'down'), ('BTN_DPAD_LEFT', 'left'),
                       ('BTN_DPAD_RIGHT', 'right'), ('BTN_TRIGGER_HAPPY1', 'left'), ('BTN_TRIGGER_HAPPY2', 'right'),
                       ('BTN_TRIGGER_HAPPY3', 'up'), ('BTN_TRIGGER_HAPPY4', 'down'), ('KEY_HOMEPAGE', 'guide')):
        if hasattr(e, code):
            m[getattr(e, code)] = name
    if vendor == SONY:
        m[e.BTN_NORTH], m[e.BTN_WEST] = 'y', 'x'
    return m


class Controller:
    def __init__(self, dev, e):
        self.dev = dev
        self.e = e
        self.btn = {}       # name → pressed (buttons, triggers, hat)
        self.bmap = None    # this controller's button codes (button_map: Sony pads swap X and Y)
        self.ff_id = None   # its uploaded rumble effect (the on-screen keyboard)
        self.ax = {'lx': 0.0, 'ly': 0.0, 'rx': 0.0, 'ry': 0.0}
        self.info = {}
        for code, info in dev.capabilities(absinfo=True).get(e.EV_ABS, []):
            self.info[code] = info
        # Most drivers (xpad, xpadneo, hid-playstation, Handheld Daemon) put the right stick on RX/RY and the triggers
        # on Z/RZ. An Xbox controller over Bluetooth without xpadneo (hid-generic), and 8BitDo or other pads in
        # DirectInput mode, have no RX/RY: the right stick is on Z/RZ and the triggers on BRAKE/GAS. Read the usual
        # way, the right stick (the pointer) never moved and counted as the triggers instead.
        if e.ABS_RX not in self.info and e.ABS_RY not in self.info and e.ABS_Z in self.info and e.ABS_RZ in self.info:
            self.sticks = {e.ABS_X: 'lx', e.ABS_Y: 'ly', e.ABS_Z: 'rx', e.ABS_RZ: 'ry'}
            self.triggers = {e.ABS_BRAKE: 'lt', e.ABS_GAS: 'rt'}
        else:
            self.sticks = {e.ABS_X: 'lx', e.ABS_Y: 'ly', e.ABS_RX: 'rx', e.ABS_RY: 'ry'}
            self.triggers = {e.ABS_Z: 'lt', e.ABS_BRAKE: 'lt', e.ABS_RZ: 'rt', e.ABS_GAS: 'rt'}

    def norm(self, code, value, centered=True):
        i = self.info.get(code)
        if not i or i.max == i.min:
            return 0.0
        if centered:
            mid = (i.max + i.min) / 2
            return max(-1.0, min(1.0, (value - mid) / ((i.max - i.min) / 2)))
        return max(0.0, min(1.0, (value - i.min) / (i.max - i.min)))

    def handle(self, ev, bmap):
        e = self.e
        if ev.type == e.EV_KEY and ev.code in bmap:
            self.btn[bmap[ev.code]] = ev.value != 0
        elif ev.type == e.EV_ABS:
            c = ev.code
            if c in self.sticks:
                self.ax[self.sticks[c]] = self.norm(c, ev.value)
            elif c in self.triggers:
                name = self.triggers[c]
                v = self.norm(c, ev.value, centered=False)
                was = self.btn.get(name + '_axis', False)
                self.btn[name + '_axis'] = v > (0.4 if was else 0.55)
            elif c == e.ABS_HAT0X:
                self.btn['left'], self.btn['right'] = ev.value < 0, ev.value > 0
            elif c == e.ABS_HAT0Y:
                self.btn['up'], self.btn['down'] = ev.value < 0, ev.value > 0


def gamepads(evdev, known):
    e = evdev.ecodes
    found = {}
    for path in evdev.list_devices():
        if path in known:
            found[path] = known[path]
            continue
        try:
            d = evdev.InputDevice(path)
        except OSError:
            continue
        try:
            # A device unplugged between opening and asking (a controller switching off) answers ENODEV: skip it
            # instead of the whole helper stopping (no more controller on the desktop).
            caps = d.capabilities()
            if d.name.startswith('Hearth ') or e.BTN_SOUTH not in caps.get(e.EV_KEY, []) or e.EV_ABS not in caps:
                d.close()
                continue
            found[path] = Controller(d, e)
            found[path].bmap = button_map(e, getattr(getattr(d, 'info', None), 'vendor', 0))
        except OSError:
            try:
                d.close()
            except OSError:
                pass
            continue
        # Is another program holding it for itself (EVIOCGRAB: Steam does with some controllers)? Then nothing it
        # sends reaches us. Asked by trying a grab and letting go at once.
        try:
            d.grab()
            d.ungrab()
        except OSError as err:
            note('%s %r is held by another program (%s): its buttons don\'t reach the desktop. Is Steam open?' % (path, d.name, err.strerror or err))
    for path, c in known.items():
        if path not in found:
            try:
                c.dev.close()
            except OSError:
                pass
    return found


PAD_LOG = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'), 'nimbus', 'pad.log')


def note(text):
    """A line in ~/.local/share/nimbus/pad.log (kept across sessions, in bug reports): what the controller helper
    sees and why it isn't working, which the desktop's own log (in /run) loses when Desktop Mode closes."""
    try:
        os.makedirs(os.path.dirname(PAD_LOG), exist_ok=True)
        if os.path.exists(PAD_LOG) and os.path.getsize(PAD_LOG) > 200_000:
            os.replace(PAD_LOG, PAD_LOG + '.old')
        with open(PAD_LOG, 'a') as f:
            f.write('%s %s\n' % (time.strftime('%Y-%m-%d %H:%M:%S'), text))
    except OSError:
        pass


def describe_inputs(evdev):
    """Every input device: name, whether it's readable, whether it looks like a controller."""
    e = evdev.ecodes
    out = []
    for path in sorted(os.listdir('/dev/input')) if os.path.isdir('/dev/input') else []:
        if not path.startswith('event'):
            continue
        full = os.path.join('/dev/input', path)
        try:
            d = evdev.InputDevice(full)
            caps = d.capabilities()
            pad = e.BTN_SOUTH in caps.get(e.EV_KEY, []) and e.EV_ABS in caps
            out.append('%s %r%s' % (path, d.name, ' (controller)' if pad else ''))
            d.close()
        except OSError as err:
            out.append('%s not readable (%s)' % (path, err.strerror or err))
    return out


# ---------------------------------------------------------------------- Hearth Plasma's D-Bus side (--plasma)

PLASMA_BUS = 'org.hearth.Pad'
PLASMA_PATH = '/org/hearth/Pad'
PLASMA_XML = """<node><interface name="org.hearth.Pad">
<method name="Window"><arg type="s" direction="in"/><arg type="s" direction="in"/><arg type="b" direction="in"/><arg type="s" direction="in"/></method>
<method name="Probe"><arg type="s" direction="in"/></method>
</interface></node>"""
# Run once at the start through KWin's scripting: says which window is in front already (hearthpad only says when it changes).
PLASMA_REPORT_JS = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), 'plasma', 'kwin-report.js')
# Hearth Quick Access gets Meta+Alt+A (the Hearth menu's Quick Access types it) where an older layout didn't give it one.
PLASMA_QUICK_SHORTCUT_JS = ('panels().forEach(function(p){p.widgets("org.hearth.quicksettings").forEach(function(w){'
                            'if(!w.globalShortcut)w.globalShortcut="Meta+Alt+A";});});')


def plasma_bus(inbox):
    """Serves org.hearth.Pad on the session bus for KWin's hearthpad script (the window in front) and listens for
    KWin's text fields (org.kde.kwin.VirtualKeyboard active), in a thread of its own with GLib's D-Bus. Everything
    goes to the main loop through inbox. Without python3-gi (or a session bus) it says so in pad.log and does nothing:
    the controller still works, just without knowing what's in front."""
    try:
        import gi
        gi.require_version('Gio', '2.0')
        from gi.repository import Gio, GLib
    except (ImportError, ValueError) as err:
        note('no python3-gi (%s): the controller can\'t tell which window is in front' % err)
        return False

    def call(bus, dest, path, iface, method, args=None, reply=None):
        return bus.call_sync(dest, path, iface, method, args, GLib.VariantType(reply) if reply else None,
                             Gio.DBusCallFlags.NONE, 3000, None)

    def run():
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            node = Gio.DBusNodeInfo.new_for_xml(PLASMA_XML)

            def on_call(conn, sender, path, iface, method, params, inv):
                a = params.unpack()
                if method == 'Window' and len(a) == 4:
                    inbox.put({'cmd': 'window', 'cls': a[0], 'caption': a[1], 'fullscreen': bool(a[2]), 'kind': a[3]})
                elif method == 'Probe' and a:
                    note('probe: ' + str(a[0])[:300])
                    inbox.put({'cmd': 'probe', 'text': str(a[0])[:2000]})
                inv.return_value(None)
            bus.register_object(PLASMA_PATH, node.interfaces[0], on_call, None, None)
            got = call(bus, 'org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus', 'RequestName',
                       GLib.Variant('(su)', (PLASMA_BUS, 4)), '(u)').unpack()[0]
            if got not in (1, 4):
                note('%s is taken (another hearth-pad?): not told which window is in front' % PLASMA_BUS)
                return

            def text_field(conn, sender, path, iface, signal, params):
                try:
                    on = call(bus, 'org.kde.KWin', '/VirtualKeyboard', 'org.freedesktop.DBus.Properties', 'Get',
                              GLib.Variant('(ss)', ('org.kde.kwin.VirtualKeyboard', 'active')), '(v)').unpack()[0]
                    inbox.put({'cmd': 'textfield', 'on': bool(on)})
                except GLib.Error:
                    pass
            bus.signal_subscribe('org.kde.KWin', 'org.kde.kwin.VirtualKeyboard', 'activeChanged', '/VirtualKeyboard',
                                 None, Gio.DBusSignalFlags.NONE, text_field)

            def first():
                try:
                    if os.path.isfile(PLASMA_REPORT_JS):
                        try:
                            call(bus, 'org.kde.KWin', '/Scripting', 'org.kde.kwin.Scripting', 'unloadScript',
                                 GLib.Variant('(s)', ('hearthpad-report',)))
                        except GLib.Error:
                            pass
                        sid = call(bus, 'org.kde.KWin', '/Scripting', 'org.kde.kwin.Scripting', 'loadScript',
                                   GLib.Variant('(ss)', (PLASMA_REPORT_JS, 'hearthpad-report')), '(i)').unpack()[0]
                        if sid >= 0:
                            call(bus, 'org.kde.KWin', '/Scripting/Script%d' % sid, 'org.kde.kwin.Script', 'run')
                except GLib.Error as err:
                    note('KWin scripting: %s' % err.message)
                try:
                    call(bus, 'org.kde.plasmashell', '/PlasmaShell', 'org.kde.PlasmaShell', 'evaluateScript',
                         GLib.Variant('(s)', (PLASMA_QUICK_SHORTCUT_JS,)), '(s)')
                except GLib.Error as err:
                    note('Quick Access shortcut: %s' % err.message)
                return False
            GLib.timeout_add(1500, first)
            note('serving %s for KWin' % PLASMA_BUS)
            GLib.MainLoop().run()
        except Exception as err:   # never take the controller down with it
            note('D-Bus side stopped: %r' % err)
    threading.Thread(target=run, daemon=True).start()
    return True


def main():
    try:
        import evdev
    except ImportError:
        note('python3-evdev is missing: no controller support')
        emit({'t': 'error', 'text': 'Controller support needs python3-evdev.'})
        return 2
    try:
        out = Output(evdev)
    except (OSError, evdev.UInputError) as err:
        note('no access to /dev/uinput: %s' % err)
        emit({'t': 'error', 'text': 'Controller support needs access to /dev/uinput (%s).' % err})
        return 3
    note('started; input devices: ' + '; '.join(describe_inputs(evdev)))
    e = evdev.ecodes
    bmap = button_map(e)
    game = '--game' in sys.argv[1:]
    plasma = '--plasma' in sys.argv[1:]
    osk_only = '--osk' in sys.argv[1:] and not plasma
    stats = {'events': 0, 'moved': 0, 'since': time.monotonic()}
    real_move = out.move

    def counted_move(dx, dy):
        stats['moved'] += abs(dx) + abs(dy)
        real_move(dx, dy)
    out.move = counted_move
    pad = CosmicPad(out) if '--cosmic' in sys.argv[1:] else Pad(out, game=game, osk_only=osk_only, plasma=plasma)
    if game:
        note('Game Mode controller mouse')
    inbox = queue.Queue()      # --plasma: what KWin says (plasma_bus's thread) for the main loop
    if plasma:
        note('Hearth Plasma controller')
        plasma_bus(inbox)
    pads = {}

    def rumble(strength, ms):
        """A short rumble (force feedback) on every controller that has it."""
        strength = max(0.0, min(1.0, strength))
        ms = max(5, min(200, ms))
        for c in pads.values():
            if e.EV_FF not in c.dev.capabilities():
                continue
            try:
                eff = evdev.ff.Effect(e.FF_RUMBLE, -1, 0, evdev.ff.Trigger(0, 0), evdev.ff.Replay(ms, 0),
                                      evdev.ff.EffectType(ff_rumble_effect=evdev.ff.Rumble(strong_magnitude=int(0x7fff * strength * 0.5),
                                                                                           weak_magnitude=int(0xffff * strength))))
                if c.ff_id is not None:
                    try:
                        c.dev.erase_effect(c.ff_id)
                    except OSError:
                        pass
                c.ff_id = c.dev.upload_effect(eff)
                c.dev.write(e.EV_FF, c.ff_id, 1)
                # Some pads (Handheld Daemon's virtual pad on the ROG Ally) ignore the replay length and rumble
                # until told to stop: stop it explicitly just after it should have ended.
                stop_rumble_later(c, c.ff_id, ms)
            except (OSError, AttributeError, TypeError):
                pass

    def stop_rumble_later(c, ff_id, ms):
        old = getattr(c, 'ff_stop', None)
        if old is not None:
            old.cancel()

        def stop():
            try:
                c.dev.write(e.EV_FF, ff_id, 0)
            except (OSError, AttributeError, TypeError):
                pass
        t = threading.Timer((ms + 40) / 1000.0, stop)
        t.daemon = True
        c.ff_stop = t
        t.start()
    out.rumbler = rumble
    pressed = set()
    names = ('a', 'b', 'x', 'y', 'lb', 'rb', 'lt', 'rt', 'view', 'menu', 'guide', 'l3', 'r3',
             'up', 'down', 'left', 'right')
    last = time.monotonic()
    next_scan = 0.0
    link = None
    if '--socket' in sys.argv[1:] and sys.argv.index('--socket') + 1 < len(sys.argv):
        link = CosmicLink(sys.argv[sys.argv.index('--socket') + 1])
    emit({'t': 'ready'})
    if not link:
        os.set_blocking(sys.stdin.fileno(), False)
    inbuf = ''
    while True:
        now = time.monotonic()
        if now >= next_scan:
            before = set(pads)
            pads = gamepads(evdev, pads)
            if set(pads) != before:
                note('controllers: ' + (', '.join('%s %r' % (p, c.dev.name) for p, c in pads.items()) or 'none'))
            next_scan = now + 3
        while plasma and not inbox.empty():
            m = inbox.get_nowait()
            if m.get('cmd') == 'probe':
                emit({'t': 'probe', 'text': m.get('text', '')})
            else:
                pad.command(m)
        if osk_only or plasma:
            # Hearth Plasma's keyboard: the controller is held while it's open, so apps don't also get the presses.
            for c in pads.values():
                if getattr(c, 'grabbed', False) != pad.wants_grab:
                    try:
                        c.dev.grab() if pad.wants_grab else c.dev.ungrab()
                    except OSError:
                        pass             # someone else holds it: don't keep trying
                    c.grabbed = pad.wants_grab
        fds = {c.dev.fd: (p, c) for p, c in pads.items()}
        try:
            link_fds = set(link.fds()) if link else set()
            ready, _, _ = select.select(list(fds) + (list(link_fds) if link else [sys.stdin.fileno()]), [], [], 0.008)
        except (OSError, ValueError):
            ready, link_fds = [], set()
        for fd in ready:
            if fd in link_fds:
                for line in link.read(fd, pad):
                    try:
                        pad.command(json.loads(line))
                    except (ValueError, AttributeError):
                        pass
                continue
            if not link and fd == sys.stdin.fileno():
                try:
                    chunk = os.read(fd, 4096).decode('utf-8', 'replace')
                except BlockingIOError:
                    continue
                if not chunk:
                    return 0        # the shell went away
                inbuf += chunk
                while '\n' in inbuf:
                    line, inbuf = inbuf.split('\n', 1)
                    try:
                        pad.command(json.loads(line))
                    except (ValueError, AttributeError):
                        pass
                continue
            path, c = fds[fd]
            try:
                for ev in c.dev.read():
                    stats['events'] += 1
                    c.handle(ev, c.bmap or bmap)
            except (BlockingIOError, InterruptedError):
                pass
            except OSError:          # unplugged
                pads.pop(path, None)
                try:
                    c.dev.close()
                except OSError:
                    pass
        now = time.monotonic()
        state = set()
        for c in pads.values():
            for n in names:
                if c.btn.get(n) or c.btn.get(n + '_axis'):
                    state.add(n)
        for n in names:
            if (n in state) != (n in pressed):
                pad.button(n, n in state, now)
        pressed = state
        clip = lambda v: max(-1.0, min(1.0, v))
        pad.axes(*(clip(sum(c.ax[k] for c in pads.values())) for k in ('lx', 'ly', 'rx', 'ry')))
        pad.tick(now, min(0.05, now - last))
        last = now
        # Every 30 s with input: what came in and what the pointer did (why "the mouse doesn't move" shows in logs).
        if now - stats['since'] >= 30:
            if stats['events']:
                note('last 30 s: %d controller events, pointer moved %d px%s%s' % (stats['events'], stats['moved'],
                     ', paused (a fullscreen window)' if pad.fs_pause else '', ', turned off' if pad.user_off else ''))
            stats.update(events=0, moved=0, since=now)
        if pad.done:
            return 0


if __name__ == '__main__':
    sys.exit(main())
