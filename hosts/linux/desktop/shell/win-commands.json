{
  "_about": "Windows commands for the Run box (Super+R) and the entries of the Super+X menu (WinTools.qml, run-map.js, docs/DEVICE-MANAGER.md). To add a command: one line in commands with its names (lower case, without .exe), what it opens (opens) and what to do (do). do.kind: tasks (page: processes, performance, startup...), devices, settings (page: an id from settings-pages.js), files (path, or hearth:apps / hearth:thispc), exec (argv), terminal, keyboard, screenshot, run, search, desktop, power. needs: a program that must be installed, or the entry is hidden.",
  "commands": [
    { "names": ["taskmgr"], "opens": "Task Manager", "do": { "kind": "tasks", "page": "" } },
    { "names": ["msconfig"], "opens": "Task Manager › Startup apps", "do": { "kind": "tasks", "page": "startup" } },
    { "names": ["resmon", "perfmon"], "opens": "Task Manager › Performance", "do": { "kind": "tasks", "page": "performance" } },
    { "names": ["perfmon /rel"], "opens": "Reliability history", "do": { "kind": "exec", "argv": ["hearth-reliability"] }, "needs": "hearth-reliability" },
    { "names": ["devmgmt.msc", "devmgmt", "hdwwiz.cpl"], "opens": "Device Manager", "do": { "kind": "devices" } },
    { "names": ["diskmgmt.msc", "diskmgmt"], "opens": "Disk Management (Hearth Disks)", "do": { "kind": "exec", "argv": ["hearth-disks"] }, "needs": "hearth-disks" },
    { "names": ["rstrui"], "opens": "System Restore", "do": { "kind": "exec", "argv": ["hearth-restore"] }, "needs": "hearth-restore" },
    { "names": ["control", "control panel", "ms-settings:"], "opens": "Settings", "do": { "kind": "settings", "page": "" } },
    { "names": ["appwiz.cpl"], "opens": "Installed apps in Files", "do": { "kind": "files", "path": "hearth:apps" } },
    { "names": ["notepad", "write", "wordpad"], "opens": "Text Editor", "do": { "kind": "exec", "argv": ["hearth-text"] }, "needs": "hearth-text" },
    { "names": ["cmd", "powershell", "pwsh", "wt", "terminal"], "opens": "Terminal", "do": { "kind": "terminal" } },
    { "names": ["explorer", "this pc"], "opens": "Files", "do": { "kind": "files", "path": "" } },
    { "names": ["calc"], "opens": "Calculator", "do": { "kind": "exec", "argv": ["hearth-calculator"] }, "needs": "hearth-calculator" },
    { "names": ["eventvwr", "eventvwr.msc"], "opens": "Logs", "do": { "kind": "exec", "argv": ["hearth-tools", "--app", "logs"] }, "needs": "hearth-tools" },
    { "names": ["msinfo32", "winver", "sysdm.cpl"], "opens": "Settings › About", "do": { "kind": "settings", "page": "about" } },
    { "names": ["ncpa.cpl"], "opens": "Settings › Wi-Fi", "do": { "kind": "settings", "page": "wifi" } },
    { "names": ["mmsys.cpl"], "opens": "Settings › Sound", "do": { "kind": "settings", "page": "sound" } },
    { "names": ["desk.cpl"], "opens": "Settings › Display", "do": { "kind": "settings", "page": "display" } },
    { "names": ["main.cpl"], "opens": "Settings › Mouse & touchpad", "do": { "kind": "settings", "page": "mouse" } },
    { "names": ["powercfg.cpl"], "opens": "Settings › Power & battery", "do": { "kind": "settings", "page": "power" } },
    { "names": ["timedate.cpl"], "opens": "Settings › Date & time", "do": { "kind": "settings", "page": "datetime" } },
    { "names": ["intl.cpl"], "opens": "Settings › Keyboard", "do": { "kind": "settings", "page": "keyboard" } },
    { "names": ["control printers"], "opens": "Settings › Printers", "do": { "kind": "settings", "page": "printers" } },
    { "names": ["osk"], "opens": "On-screen keyboard", "do": { "kind": "keyboard" } },
    { "names": ["snippingtool"], "opens": "Screenshot of an area", "do": { "kind": "screenshot" } }
  ],
  "vars": {
    "appdata": { "path": "~/.config", "opens": "AppData › Roaming (~/.config) in Files" },
    "localappdata": { "path": "~/.local/share", "opens": "AppData › Local (~/.local/share) in Files" },
    "temp": { "path": "~/.cache", "opens": "Temp (~/.cache) in Files" },
    "tmp": { "path": "~/.cache", "opens": "Temp (~/.cache) in Files" },
    "userprofile": { "path": "~", "opens": "Your home folder in Files" },
    "homepath": { "path": "~", "opens": "Your home folder in Files" }
  },
  "msSettings": {
    "display": "display", "sound": "sound", "bluetooth": "bluetooth", "devices": "bluetooth", "network": "wifi",
    "network-wifi": "wifi", "windowsupdate": "updates", "appsfeatures": "apps", "installed-apps": "apps",
    "defaultapps": "defaults", "about": "about", "personalization": "appearance", "colors": "appearance",
    "taskbar": "bar-dock", "powersleep": "power", "batterysaver": "power", "storagesense": "storage",
    "dateandtime": "datetime", "mousetouchpad": "mouse", "typing": "keyboard", "keyboard": "keyboard",
    "printers": "printers", "notifications": "notifications", "clipboard": "clipboard", "easeofaccess": "accessibility",
    "accounts": "users", "signinoptions": "signin", "gaming": "gaming", "startupapps": "startup"
  },
  "winx": [
    { "label": "Installed apps", "key": "P", "do": { "kind": "files", "path": "hearth:apps" } },
    { "label": "Power options", "key": "O", "do": { "kind": "settings", "page": "power" } },
    { "label": "Reliability history", "key": "L", "do": { "kind": "exec", "argv": ["hearth-reliability"] }, "needs": "hearth-reliability" },
    { "label": "System", "key": "Y", "do": { "kind": "settings", "page": "about" } },
    { "label": "Device Manager", "key": "M", "do": { "kind": "devices" } },
    { "label": "Network connections", "key": "W", "do": { "kind": "settings", "page": "wifi" } },
    { "label": "Disk Management", "key": "K", "do": { "kind": "exec", "argv": ["hearth-disks"] }, "needs": "hearth-disks" },
    { "sep": true },
    { "label": "Terminal", "key": "I", "do": { "kind": "terminal" } },
    { "label": "Task Manager", "key": "T", "do": { "kind": "tasks", "page": "" } },
    { "label": "Settings", "key": "N", "do": { "kind": "settings", "page": "" } },
    { "label": "Files", "key": "E", "do": { "kind": "files", "path": "" } },
    { "label": "Search", "key": "S", "do": { "kind": "search" } },
    { "label": "Run", "key": "R", "do": { "kind": "run" } },
    { "sep": true },
    { "label": "Shut down or sign out", "key": "U", "do": { "kind": "power" } },
    { "label": "Desktop", "key": "D", "do": { "kind": "desktop" } }
  ]
}
