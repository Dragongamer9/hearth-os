    if not argv:
        print(__doc__)
        return 2
    cmd, rest = argv[0], argv[1:]
    try:
        if cmd == 'status':
            r = status()
        elif cmd == 'vpn-import' and len(rest) == 1:
            r = vpn_import(rest[0])
