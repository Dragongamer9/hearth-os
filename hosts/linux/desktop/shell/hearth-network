            r = vpn_remove(rest[0])
        elif cmd == 'details' and len(rest) == 1:
            r = details(rest[0])
        elif cmd == 'details-set' and len(rest) == 1:
            r = details_set(rest[0], stdin_json())
        elif cmd == 'hotspot':
            r = hotspot()
        elif cmd == 'hotspot-on':
            r = hotspot_on(stdin_json())
        elif cmd == 'hotspot-off':
            r = hotspot_off()
        elif cmd == 'hotspot-password':
            r = hotspot_password()
        elif cmd == 'proxy':
            r = proxy_load()
        elif cmd == 'proxy-set':
            r = proxy_set(stdin_json())
        elif cmd == 'proxy-apply':
            r = proxy_apply()
        elif cmd == 'vpn-add':
            r = vpn_add(stdin_json())
        elif cmd == 'enterprise-set' and len(rest) == 1:
            r = enterprise_set(rest[0], stdin_json())
        elif cmd == 'wifi-enterprise-add':
            r = wifi_enterprise_add(stdin_json())
        elif cmd == 'wired-add':
            r = wired_add(stdin_json())
        elif cmd == 'mobile-add':
            r = mobile_add(stdin_json())
