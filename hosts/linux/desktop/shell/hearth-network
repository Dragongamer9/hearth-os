class Fail(Exception):
    pass


def run(cmd, input=None, timeout=60):
    # HEARTH_INPUT (SetJob's copy of stdin: maybe a VPN or hotspot password) never reaches nmcli's environment.
    env = {k: v for k, v in os.environ.items() if k != 'HEARTH_INPUT'}
    try:
        p = subprocess.run(cmd, input=input, capture_output=True, text=True, timeout=timeout, env=env)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, '', str(e)
    return p.returncode, p.stdout, p.stderr


def nmcli(args, input=None, timeout=60):
    code, out, err = run(['nmcli'] + args, input=input, timeout=timeout)
    if code != 0:
        msg = (err or out).strip().splitlines()
        # nmcli's own words, without anything after a secret could be named (it never echoes stdin, but be sure).
        raise Fail((msg[-1] if msg else 'NetworkManager said no')[:200])
    return out


def fields(line):
    """nmcli -t splits fields with ':' and escapes ':' and '\\' inside them."""
    out, cur, i = [], '', 0
    while i < len(line):
        c = line[i]
        if c == '\\' and i + 1 < len(line):
            cur += line[i + 1]; i += 2; continue
        if c == ':':
            out.append(cur); cur = ''
        else:
            cur += c
        i += 1
    out.append(cur)
    return out


def check_uuid(u):
    if not UUID_RE.match(u or ''):
        raise Fail('not a connection id')
    return u


KINDS = {'802-11-wireless': 'wifi', 'wifi': 'wifi', '802-3-ethernet': 'ethernet', 'ethernet': 'ethernet',
         'wireguard': 'vpn', 'vpn': 'vpn', 'gsm': 'mobile', 'cdma': 'mobile', 'bluetooth': 'bluetooth', 'bridge': 'other',
         'loopback': 'loopback', 'tun': 'other'}


def parse_connections(text):
    out = []
    for line in text.splitlines():
        f = fields(line)
        if len(f) < 6 or not f[1]:
            continue
        name, uuid, typ, device, active, auto = f[:6]
        kind = KINDS.get(typ, 'other')
        if kind == 'loopback':
            continue
        out.append({'name': name, 'uuid': uuid, 'type': typ, 'kind': kind, 'device': device if device != '--' else '',
                    'active': active == 'yes', 'autoconnect': auto == 'yes'})
    return out


# The VPN kinds typed in by hand (1.14): NetworkManager's plugin for each, the Debian package that has it, and the
# words on the page. IPsec is strongSwan's plugin, or Libreswan's when that's the one installed.
VPN_TYPES = [
    ('ipsec', 'IPsec (IKEv2)', ('strongswan', 'libreswan'), 'network-manager-strongswan'),
    ('l2tp', 'L2TP/IPsec', ('l2tp',), 'network-manager-l2tp'),
    ('pptp', 'PPTP', ('pptp',), 'network-manager-pptp'),
    ('openconnect', 'OpenConnect (Cisco AnyConnect, GlobalProtect, Pulse)', ('openconnect',), 'network-manager-openconnect'),
    ('sstp', 'SSTP', ('sstp',), 'network-manager-sstp'),
    ('fortisslvpn', 'Fortinet SSL VPN', ('fortisslvpn',), 'network-manager-fortisslvpn'),
]
PLUGIN_NAMES = ('openvpn', 'strongswan', 'libreswan', 'l2tp', 'pptp', 'openconnect', 'sstp', 'fortisslvpn')
SERVICE = 'org.freedesktop.NetworkManager.'


def plugins():
    """Which NetworkManager VPN plugins are installed: their nm-<name>-service.name files (service=...)."""
    have = {'wireguard': True}
    have.update({n: False for n in PLUGIN_NAMES})
    try:
        names = os.listdir(VPN_PLUGINS)
    except OSError:
        names = []
    for f in names:
        if not f.endswith('.name'):
            continue
        text = read(os.path.join(VPN_PLUGINS, f))
        m = re.search(r'^service=org\.freedesktop\.NetworkManager\.(\w+)\s*$', text, re.M)
        n = m.group(1) if m else ''
        for p in PLUGIN_NAMES:
            if n == p or (not n and 'nm-%s-service' % p in f):
                have[p] = True
    return have


def vpn_types(have=None):
    have = have or plugins()
    out = []
    for tid, label, names, pkg in VPN_TYPES:
        plug = next((n for n in names if have.get(n)), '')
        out.append({'id': tid, 'label': label, 'installed': bool(plug), 'plugin': plug, 'package': pkg})
    return out


def wifi_device(text):
    """The first Wi-Fi device from `nmcli -t -f DEVICE,TYPE,STATE device`."""
    for line in text.splitlines():
        f = fields(line)
        if len(f) >= 2 and f[1] == 'wifi':
            return f[0]
    return ''


def status():
    conns = parse_connections(nmcli(['-t', '-f', 'NAME,UUID,TYPE,DEVICE,ACTIVE,AUTOCONNECT', 'connection', 'show']))
    devtext = nmcli(['-t', '-f', 'DEVICE,TYPE,STATE', 'device'])
    dev = wifi_device(devtext)
    vpns = [c for c in conns if c['kind'] == 'vpn']
    for v in vpns:
        v['vpnType'] = 'WireGuard' if v['type'] == 'wireguard' else vpn_service(v['uuid'])
    have = plugins()
    devices = [{'device': f[0], 'type': f[1], 'state': f[2] if len(f) > 2 else ''}
               for f in (fields(line) for line in devtext.splitlines()) if len(f) >= 2 and f[1] in ('ethernet', 'gsm', 'wifi')]
    return {'connections': conns, 'vpns': vpns, 'wifiDevice': dev, 'plugins': have, 'vpnTypes': vpn_types(have),
            'devices': devices, 'hasModem': any(d['type'] == 'gsm' for d in devices),
            'hasEthernet': any(d['type'] == 'ethernet' for d in devices), 'qr': bool(shutil.which('qrencode'))}


SERVICE_LABELS = {'openvpn': 'OpenVPN', 'strongswan': 'IPsec', 'libreswan': 'IPsec', 'l2tp': 'L2TP/IPsec', 'pptp': 'PPTP',
                  'openconnect': 'OpenConnect', 'sstp': 'SSTP', 'fortisslvpn': 'Fortinet'}


def vpn_service(uuid):
    try:
        s = nmcli(['-g', 'vpn.service-type', 'connection', 'show', 'uuid', uuid]).strip()
    except Fail:
        return 'VPN'
    short = s.rsplit('.', 1)[-1]
    return SERVICE_LABELS.get(short, short or 'VPN')


def vpn_import(path):
    path = os.path.abspath(path or '')
    if not os.path.isfile(path):
        raise Fail("that file isn't there")
    if os.path.getsize(path) > 256 * 1024:
        raise Fail("that's too big to be a VPN file")
    ext = os.path.splitext(path)[1].lower()
    kind = {'.conf': 'wireguard', '.ovpn': 'openvpn'}.get(ext)
    if not kind:
        raise Fail('pick a WireGuard (.conf) or OpenVPN (.ovpn) file')
    if kind == 'openvpn' and not plugins()['openvpn']:
        raise Fail("OpenVPN isn't on this system (NetworkManager's OpenVPN plugin is missing)")
    if kind == 'wireguard':
        # NetworkManager names the connection after the file: it must be a valid interface name (15 characters).
        base = os.path.splitext(os.path.basename(path))[0]
        if not re.match(r'^[A-Za-z0-9_=+.-]{1,15}$', base):
            raise Fail('rename the file to a short name first (letters and numbers, up to 15), like home-vpn.conf')
    out = nmcli(['connection', 'import', 'type', kind, 'file', path])
    m = re.search(r'\(([0-9a-fA-F-]{36})\)', out)
    if not m:
        raise Fail('NetworkManager took the file but gave no connection back')
    uuid = m.group(1)
    # A VPN never starts by itself: you connect it here (or from the bar).
    try:
        nmcli(['connection', 'modify', 'uuid', uuid, 'connection.autoconnect', 'no'])
    except Fail:
        pass
    name = ''
    mm = re.search(r"'(.+)'", out)
    if mm:
        name = mm.group(1)
    return {'uuid': uuid, 'name': name or os.path.basename(path), 'kind': kind}


def secrets_text(req):
    """What nmcli's passwd-file reads: one `setting.property:value` line each. Values can't have line breaks."""
    lines = []
    user = str(req.get('user') or '')
    pw = str(req.get('password') or '')
    for v in (user, pw):
        if '\n' in v or '\r' in v or len(v) > 512:
            raise Fail("that can't be a user name or password")
    if pw:
        lines.append('vpn.secrets.password:' + pw)
    return '\n'.join(lines) + ('\n' if lines else ''), user


def vpn_up(uuid, req=None):
    check_uuid(uuid)
    req = req or {}
    text, user = secrets_text(req)
    if user:
        nmcli(['connection', 'modify', 'uuid', uuid, '+vpn.data', 'username=' + user])
    if text:
        # /dev/stdin: the secrets reach nmcli on its stdin and nowhere else.
        nmcli(['--wait', '45', 'connection', 'up', 'uuid', uuid, 'passwd-file', '/dev/stdin'], input=text, timeout=60)
    else:
        nmcli(['--wait', '45', 'connection', 'up', 'uuid', uuid], timeout=60)
    return {'ok': True}


def vpn_down(uuid):
    nmcli(['connection', 'down', 'uuid', check_uuid(uuid)])
    return {'ok': True}


def vpn_remove(uuid):
    check_uuid(uuid)
    typ = nmcli(['-g', 'connection.type', 'connection', 'show', 'uuid', uuid]).strip()
    if typ not in ('vpn', 'wireguard'):
        raise Fail('only VPNs are removed here')
    nmcli(['connection', 'delete', 'uuid', uuid])
    return {'ok': True}


DETAIL_KEYS = ['connection.id', 'connection.type', 'connection.interface-name', 'connection.autoconnect',
               'connection.metered', 'ipv4.method', 'ipv4.addresses', 'ipv4.gateway', 'ipv4.dns',
               'ipv4.ignore-auto-dns', 'ipv6.method', 'ipv6.dns', '802-11-wireless.cloned-mac-address',
               '802-3-ethernet.cloned-mac-address', 'GENERAL.DEVICES', 'IP4.ADDRESS', 'IP4.GATEWAY', 'IP4.DNS',
               'IP6.ADDRESS', 'IP6.DNS']


def parse_show(text):
    """`nmcli -t connection show UUID`: key:value lines (lists as key[1], key[2]...)."""
    out = {}
    for line in text.splitlines():
        i = line.find(':')
        if i <= 0:
            continue
        k = re.sub(r'\[\d+\]$', '', line[:i])
        v = line[i + 1:].replace('\\:', ':')
        if k in out and v:
            out[k] = out[k] + ',' + v if out[k] else v
        else:
            out[k] = v
    return out


def split_list(v):
    return [x.strip() for x in re.split(r'[,\s|]+', v or '') if x.strip() and x.strip() != '--']


def mac_choice(v):
    v = (v or '').strip()
    if v in ('', '--', 'default'):
        return 'default'
    return v if v in ('permanent', 'preserve', 'random', 'stable') else 'fixed'


def details(uuid):
    check_uuid(uuid)
    s = parse_show(nmcli(['-t', 'connection', 'show', 'uuid', uuid]))
    typ = s.get('connection.type', '')
    mac_key = '802-11-wireless.cloned-mac-address' if typ == '802-11-wireless' else '802-3-ethernet.cloned-mac-address'
    return {
        'uuid': uuid, 'name': s.get('connection.id', ''), 'type': typ, 'kind': KINDS.get(typ, 'other'),
        'autoconnect': s.get('connection.autoconnect') == 'yes',
        'metered': (s.get('connection.metered') or 'unknown').split(' ')[0],
        'ipv4': {'method': s.get('ipv4.method', 'auto'), 'address': (split_list(s.get('ipv4.addresses')) or [''])[0],
                 'gateway': '' if s.get('ipv4.gateway') in (None, '--') else s.get('ipv4.gateway')},
        'dns': split_list(s.get('ipv4.dns')) + split_list(s.get('ipv6.dns')),
        'autoDns': s.get('ipv4.ignore-auto-dns', 'no') != 'yes',
        'ipv6': s.get('ipv6.method', 'auto'),
        'mac': mac_choice(s.get(mac_key)) if typ in ('802-11-wireless', '802-3-ethernet') else '',
        'macFixed': s.get(mac_key, '') if mac_choice(s.get(mac_key)) == 'fixed' else '',
        'now': {'device': s.get('GENERAL.DEVICES', ''), 'address': (split_list(s.get('IP4.ADDRESS')) or [''])[0],
                'gateway': s.get('IP4.GATEWAY', ''), 'dns': split_list(s.get('IP4.DNS')) + split_list(s.get('IP6.DNS')),
                'address6': (split_list(s.get('IP6.ADDRESS')) or [''])[0]},
        # 1.14: the size of a packet (MTU, 0 = automatic), 802.1X, mobile broadband and the Wi-Fi's security.
        'mtu': mtu_of(s, typ),
        'enterprise': enterprise_of(s),
        'mobile': mobile_of(s) if typ in ('gsm', 'cdma') else None,
        'ssid': s.get('802-11-wireless.ssid', '') if typ == '802-11-wireless' else '',
        'security': wifi_security(s) if typ == '802-11-wireless' else '',
    }


def val(s, k):
    v = s.get(k, '')
    return '' if v in ('--', None) else v


def mtu_of(s, typ):
    key = {'802-11-wireless': '802-11-wireless.mtu', '802-3-ethernet': '802-3-ethernet.mtu'}.get(typ)
    v = val(s, key) if key else ''
    m = re.match(r'^(\d+)', v)
    return int(m.group(1)) if m else 0


def enterprise_of(s):
    """802.1X as the page shows it: never a password, only whether NetworkManager keeps one."""
    eap = split_list(val(s, '802-1x.eap'))
    if not eap:
        return None
    flags = val(s, '802-1x.password-flags')
    return {'eap': eap[0], 'identity': val(s, '802-1x.identity'), 'anonymous': val(s, '802-1x.anonymous-identity'),
            'caCert': val(s, '802-1x.ca-cert').replace('file://', ''), 'phase2': val(s, '802-1x.phase2-auth'),
            'domain': val(s, '802-1x.domain-suffix-match'), 'clientCert': val(s, '802-1x.client-cert').replace('file://', ''),
            'privateKey': val(s, '802-1x.private-key').replace('file://', ''),
            'asks': flags.startswith('2') or 'not-saved' in flags}


def mobile_of(s):
    return {'apn': val(s, 'gsm.apn'), 'user': val(s, 'gsm.username'), 'roaming': val(s, 'gsm.home-only') != 'yes',
            'number': val(s, 'gsm.number')}


def wifi_security(s):
    km = val(s, '802-11-wireless-security.key-mgmt')
    if km == 'wpa-eap' or km == 'wpa-eap-suite-b-192':
        return 'enterprise'
    if km == 'sae':
        return 'SAE'
    if km in ('wpa-psk', 'wpa-psk-sha256'):
        return 'WPA'
    if km == 'none' or val(s, '802-11-wireless-security.wep-key0'):
        return 'WEP'
    if km == 'owe':
        return 'nopass'
    return 'nopass' if not km else 'WPA'


def ip_ok(v, version=None):
    try:
        a = ipaddress.ip_address(v)
    except ValueError:
        return False
    return version is None or a.version == version


def details_args(req, typ):
    """The nmcli `connection modify` property/value pairs for a details-set request (checked)."""
    args = []
    if 'dns' in req:
        dns = req['dns'] if isinstance(req['dns'], list) else split_list(str(req['dns']))
        if len(dns) > 6 or not all(isinstance(d, str) and ip_ok(d) for d in dns):
            raise Fail('DNS servers are addresses like 1.1.1.1 or 2606:4700:4700::1111')
        args += ['ipv4.dns', ','.join(d for d in dns if ip_ok(d, 4)), 'ipv6.dns', ','.join(d for d in dns if ip_ok(d, 6))]
    if 'autoDns' in req:
        ign = 'no' if req['autoDns'] else 'yes'
        args += ['ipv4.ignore-auto-dns', ign, 'ipv6.ignore-auto-dns', ign]
    if 'metered' in req:
        if req['metered'] not in ('yes', 'no', 'unknown'):
            raise Fail('metered is yes, no or unknown')
        args += ['connection.metered', req['metered']]
    if 'autoconnect' in req:
        args += ['connection.autoconnect', 'yes' if req['autoconnect'] else 'no']
    if 'mac' in req:
        key = {'802-11-wireless': '802-11-wireless.cloned-mac-address',
               '802-3-ethernet': '802-3-ethernet.cloned-mac-address'}.get(typ)
        if not key:
            raise Fail('this connection has no MAC address setting')
        v = req['mac']
        if v not in ('default', 'permanent', 'preserve', 'random', 'stable'):
            raise Fail('MAC address is default, permanent, preserve, random or stable')
        args += [key, '' if v == 'default' else v]
    if 'ipv4' in req:
        v4 = req['ipv4'] or {}
        method = v4.get('method')
        if method == 'auto':
            args += ['ipv4.method', 'auto', 'ipv4.addresses', '', 'ipv4.gateway', '']
        elif method == 'manual':
            addr, gw = str(v4.get('address') or ''), str(v4.get('gateway') or '')
            try:
                iface = ipaddress.ip_interface(addr if '/' in addr else addr + '/24')
            except ValueError:
                raise Fail('the address is like 192.168.1.20/24')
            if iface.version != 4:
                raise Fail('the address is like 192.168.1.20/24')
            if gw and not ip_ok(gw, 4):
                raise Fail('the gateway is an address like 192.168.1.1')
            args += ['ipv4.method', 'manual', 'ipv4.addresses', str(iface), 'ipv4.gateway', gw]
        else:
            raise Fail('IPv4 is automatic or manual')
    if 'ipv6' in req:
        if req['ipv6'] not in ('auto', 'disabled', 'ignore'):
            raise Fail('IPv6 is auto, disabled or ignore')
        args += ['ipv6.method', req['ipv6']]
    if 'mtu' in req:
        key = {'802-11-wireless': '802-11-wireless.mtu', '802-3-ethernet': '802-3-ethernet.mtu'}.get(typ)
        if not key:
            raise Fail('this connection has no packet size (MTU) setting')
        try:
            m = int(req['mtu'])
        except (TypeError, ValueError):
            raise Fail('the packet size is a number from 576 to 9000, or 0 for automatic')
        if m != 0 and not 576 <= m <= 9000:
            raise Fail('the packet size is a number from 576 to 9000, or 0 for automatic')
        args += [key, str(m) if m else 'auto']
    return args


def details_set(uuid, req):
    check_uuid(uuid)
    typ = nmcli(['-g', 'connection.type', 'connection', 'show', 'uuid', uuid]).strip()
    args = details_args(req, typ)
    if not args:
        return details(uuid)
    nmcli(['connection', 'modify', 'uuid', uuid] + args)
    # Put the change to work on a connection that's up (reapply keeps the link; a full reconnect only if needed).
    dev = nmcli(['-g', 'GENERAL.DEVICES', 'connection', 'show', 'uuid', uuid]).strip()
    if dev:
        code, _, _ = run(['nmcli', 'device', 'reapply', dev])
        if code != 0:
            run(['nmcli', 'connection', 'up', 'uuid', uuid], timeout=60)
    return details(uuid)


# ------------------------------------------------------------------ 1.14: secrets, VPNs by hand, 802.1X, mobile, QR
NAME_RE = re.compile(r'^[^\x00-\x1f\x7f]{1,64}$')
HOST_RE = re.compile(r'^(https?://)?[A-Za-z0-9]([A-Za-z0-9.-]{0,251}[A-Za-z0-9])?(:[0-9]{1,5})?(/[A-Za-z0-9._~/-]{0,200})?$|^\[?[0-9A-Fa-f:.]{2,45}\]?$')


def text_of(req, key, limit=256, required=False, what=''):
    """A plain value from the page: one line, no control characters."""
    v = req.get(key)
    v = '' if v is None else str(v).strip()
    if any(ord(c) < 32 or ord(c) == 127 for c in v) or len(v) > limit:
        raise Fail("that can't be %s" % (what or key))
    if required and not v:
        raise Fail('type %s' % (what or key))
    return v


def secret_of(req, key, what='a password'):
    """A password from the page (it's only ever handed to NetworkManager on nmcli's stdin)."""
    v = req.get(key)
    if v is None or v == '':
        return None
    v = str(v)
    if '\n' in v or '\r' in v or '\x00' in v or len(v) > 512:
        raise Fail("that can't be %s" % what)
    if v != v.strip():
        raise Fail("%s can't start or end with a space" % (what[0].upper() + what[1:]))
    return v


def file_of(req, key, what):
    """A certificate or key file: it must be there (NetworkManager reads it when it connects)."""
    v = text_of(req, key, 1024, what=what)
    if not v:
        return ''
    v = os.path.abspath(os.path.expanduser(v))
    if not os.path.isfile(v):
        raise Fail("the %s isn't there (%s)" % (what, v))
    return v


def dict_text(d):
    """vpn.data / vpn.secrets for nmcli: "key = value, key = value", with ',' and '\\' escaped in values."""
    return ', '.join('%s = %s' % (k, str(v).replace('\\', '\\\\').replace(',', '\\,')) for k, v in d.items())


def edit_script(sets):
    """`nmcli connection edit` commands, read on its stdin: secrets never go on a command line."""
    lines = []
    for prop, value in sets:
        if '\n' in value or '\r' in value:
            raise Fail("that can't be a password")
        lines.append('set %s %s' % (prop, value))
    return '\n'.join(lines + ['save persistent', 'quit']) + '\n'


def save_secrets(uuid, sets):
    if sets:
        nmcli(['connection', 'edit', 'uuid', check_uuid(uuid)], input=edit_script(sets))


def new_uuid(out, what):
    m = re.findall(r'([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})', out)
    if not m:
        raise Fail('NetworkManager made no %s' % what)
    return m[-1]


def vpn_plan(req, have=None):
    """(service, data, secrets) for a VPN typed in by hand; checked. The plugin must be installed."""
    types = {t['id']: t for t in vpn_types(have)}
    tid = req.get('type')
    if tid not in types:
        raise Fail('pick a kind of VPN')
    t = types[tid]
    if not t['installed']:
        raise Fail("%s isn't on this system (NetworkManager's plugin, %s, is missing)" % (t['label'], t['package']))
    gw = text_of(req, 'gateway', 260, True, 'the server')
    if not HOST_RE.match(gw):
        raise Fail('the server is a name or address, like vpn.example.com')
    user = text_of(req, 'user', 256, what='a user name')
    pw = secret_of(req, 'password')
    psk = secret_of(req, 'psk', 'a pre-shared key')
    plug = t['plugin']
    data, sec = {}, {}
    if plug == 'strongswan':
        data = {'address': gw, 'virtual': 'yes', 'encap': 'yes', 'ipcomp': 'no', 'proposal': 'no'}
        if user:
            data.update({'method': 'eap', 'user': user, 'password-flags': '0'})
            if pw:
                sec['password'] = pw
        elif psk:
            data.update({'method': 'psk', 'password-flags': '0'})
            sec['password'] = psk
        else:
            raise Fail('IPsec needs a user name and password, or a pre-shared key')
    elif plug == 'libreswan':
        data = {'right': gw, 'pskvalue-flags': '0', 'xauthpassword-flags': '0'}
        group = text_of(req, 'group', 128, what='a group name')
        if group:
            data['leftid'] = group
        if user:
            data.update({'leftxauthusername': user, 'ikev2': 'no'})
            if pw:
                sec['xauthpassword'] = pw
        else:
            data['ikev2'] = 'insist'
        if psk:
            data['authby'] = 'secret'
            sec['pskvalue'] = psk
    elif plug == 'l2tp':
        data = {'gateway': gw, 'password-flags': '0'}
        if user:
            data['user'] = user
        if pw:
            sec['password'] = pw
        if psk:
            data.update({'ipsec-enabled': 'yes', 'ipsec-psk-flags': '0'})
            sec['ipsec-psk'] = psk
    elif plug == 'pptp':
        data = {'gateway': gw, 'password-flags': '0', 'require-mppe': 'yes'}
        if user:
            data['user'] = user
        dom = text_of(req, 'domain', 128, what='a domain')
        if dom:
            data['domain'] = dom
        if pw:
            sec['password'] = pw
    elif plug == 'sstp':
        data = {'gateway': gw, 'password-flags': '0'}
        if user:
            data['user'] = user
        if pw:
            sec['password'] = pw
    elif plug == 'fortisslvpn':
        data = {'gateway': gw, 'password-flags': '0'}
        if user:
            data['user'] = user
        realm = text_of(req, 'realm', 128, what='a realm')
        if realm:
            data['realm'] = realm
        if pw:
            sec['password'] = pw
    elif plug == 'openconnect':
        proto = req.get('protocol') or 'anyconnect'
        if proto not in ('anyconnect', 'gp', 'nc', 'pulse', 'f5', 'fortinet', 'array'):
            raise Fail('pick which kind of OpenConnect server it is')
        data = {'gateway': gw, 'protocol': proto, 'cookie-flags': '2', 'gateway-flags': '2', 'gwcert-flags': '2'}
        group = text_of(req, 'group', 128, what='a group name')
        if group:
            data['usergroup'] = group
        # OpenConnect signs in each time it connects (the server's own sign-in page): asked then, never kept.
        sec = {}
    return SERVICE + plug, data, sec


def vpn_add(req):
    name = text_of(req, 'name', 64, what='a name') or text_of(req, 'gateway', 64)
    if not NAME_RE.match(name or ''):
        raise Fail('give the VPN a name')
    service, data, sec = vpn_plan(req)
    out = nmcli(['connection', 'add', 'type', 'vpn', 'vpn-type', service, 'con-name', name,
                 'connection.autoconnect', 'no', 'vpn.data', dict_text(data)])
    uuid = new_uuid(out, 'VPN')
    if sec:
        try:
            save_secrets(uuid, [('vpn.secrets', dict_text(sec))])
        except Fail as e:
            # A VPN without its password still works (it's asked when connecting); say so instead of failing.
            return {'uuid': uuid, 'name': name, 'warning': "NetworkManager didn't keep the password (%s): it's asked when you connect" % e}
    return {'uuid': uuid, 'name': name}


EAPS = ('peap', 'ttls', 'tls', 'pwd')
PHASE2 = ('mschapv2', 'pap', 'gtc', 'mschap', 'chap', 'md5')


def enterprise_props(req):
    """(properties for `connection modify/add`, secrets for `connection edit`) for 802.1X; checked."""
    eap = req.get('eap')
    if eap not in EAPS:
        raise Fail('pick how it signs in: PEAP, TTLS, TLS (certificate) or PWD')
    ident = text_of(req, 'identity', 256, True, 'your user name (identity)')
    props = ['802-1x.eap', eap, '802-1x.identity', ident,
             '802-1x.anonymous-identity', text_of(req, 'anonymous', 256, what='an anonymous identity'),
             '802-1x.domain-suffix-match', text_of(req, 'domain', 256, what='a domain')]
    ca = file_of(req, 'caCert', 'CA certificate')
    props += ['802-1x.ca-cert', ca]
    sec = []
    if eap in ('peap', 'ttls'):
        p2 = req.get('phase2') or 'mschapv2'
        if p2 not in PHASE2:
            raise Fail('pick the inner sign-in (MSCHAPv2 is the usual one)')
        props += ['802-1x.phase2-auth', p2]
    if eap == 'tls':
        cert = file_of(req, 'clientCert', 'your certificate')
        key = file_of(req, 'privateKey', 'private key')
        if not cert or not key:
            raise Fail('TLS needs your certificate and its private key')
        props += ['802-1x.client-cert', cert, '802-1x.private-key', key, '802-1x.private-key-password-flags', '0']
        kp = secret_of(req, 'keyPassword', "the key's password")
        if kp is not None:
            sec.append(('802-1x.private-key-password', kp))
    else:
        pw = secret_of(req, 'password')
        ask = bool(req.get('askEachTime'))
        props += ['802-1x.password-flags', '2' if ask else '0']
        if pw is not None and not ask:
            sec.append(('802-1x.password', pw))
    return props, sec


def enterprise_set(uuid, req):
    check_uuid(uuid)
    typ = nmcli(['-g', 'connection.type', 'connection', 'show', 'uuid', uuid]).strip()
    if typ not in ('802-11-wireless', '802-3-ethernet'):
        raise Fail('802.1X is for Wi-Fi and wired connections')
    if req.get('off'):
        if typ != '802-3-ethernet':
            raise Fail("an enterprise Wi-Fi network always signs in: remove it from Wi-Fi instead")
        nmcli(['connection', 'modify', 'uuid', uuid, 'remove', '802-1x'])
        return details(uuid)
    props, sec = enterprise_props(req)
    if typ == '802-11-wireless':
        props = ['802-11-wireless-security.key-mgmt', 'wpa-eap'] + props
    nmcli(['connection', 'modify', 'uuid', uuid] + props)
    save_secrets(uuid, sec)
    return details(uuid)


def wifi_enterprise_add(req):
    ssid = text_of(req, 'ssid', 32, True, "the network's name")
    if len(ssid.encode()) > 32:
        raise Fail("the network's name is up to 32 letters")
    props, sec = enterprise_props(req)
    out = nmcli(['connection', 'add', 'type', 'wifi', 'con-name', ssid, 'ssid', ssid,
                 '802-11-wireless-security.key-mgmt', 'wpa-eap'] + props)
    uuid = new_uuid(out, 'Wi-Fi network')
    save_secrets(uuid, sec)
    return {'uuid': uuid, 'name': ssid}


def wired_add(req):
    name = text_of(req, 'name', 64, what='a name') or 'Wired connection'
    if not NAME_RE.match(name):
        raise Fail('give the connection a name')
    dev = text_of(req, 'device', 15, what='a device')
    if dev and not re.match(r'^[A-Za-z0-9_.-]{1,15}$', dev):
        raise Fail("that isn't a network device")
    out = nmcli(['connection', 'add', 'type', 'ethernet', 'con-name', name] + (['ifname', dev] if dev else []) +
                ['connection.autoconnect', 'no'])
    return {'uuid': new_uuid(out, 'wired connection'), 'name': name}


def mobile_props(req):
    props, sec = [], []
    if 'apn' in req:
        apn = text_of(req, 'apn', 64, what='an APN')
        if apn and not re.match(r'^[A-Za-z0-9._-]{1,64}$', apn):
            raise Fail('the APN is a name like internet or fast.t-mobile.com')
        props += ['gsm.apn', apn]
    if 'user' in req:
        props += ['gsm.username', text_of(req, 'user', 128, what='a user name')]
    if 'roaming' in req:
        props += ['gsm.home-only', 'no' if req['roaming'] else 'yes']
    pw = secret_of(req, 'password')
    if pw is not None:
        props += ['gsm.password-flags', '0']
        sec.append(('gsm.password', pw))
    pin = req.get('pin')
    if pin not in (None, ''):
        pin = str(pin)
        if not re.match(r'^[0-9]{4,8}$', pin):
            raise Fail('the SIM PIN is 4 to 8 numbers')
        props += ['gsm.pin-flags', '0']
        sec.append(('gsm.pin', pin))
    return props, sec


def mobile_add(req):
    name = text_of(req, 'name', 64, what='a name') or 'Mobile broadband'
    if not NAME_RE.match(name):
        raise Fail('give the connection a name')
    if not text_of(req, 'apn', 64):
        raise Fail("type the APN (your mobile provider's internet name, like internet)")
    props, sec = mobile_props(req)
    out = nmcli(['connection', 'add', 'type', 'gsm', 'ifname', '*', 'con-name', name] + props)
    uuid = new_uuid(out, 'mobile broadband connection')
    save_secrets(uuid, sec)
    return {'uuid': uuid, 'name': name}


def mobile_set(uuid, req):
    check_uuid(uuid)
    typ = nmcli(['-g', 'connection.type', 'connection', 'show', 'uuid', uuid]).strip()
    if typ != 'gsm':
        raise Fail('this is not a mobile broadband connection')
    props, sec = mobile_props(req)
    if props:
        nmcli(['connection', 'modify', 'uuid', uuid] + props)
    save_secrets(uuid, sec)
    return details(uuid)


def qr_escape(v):
    return re.sub(r'([\\;,:"])', r'\\\1', v)


def wifi_qr_text(ssid, security, password, hidden=False):
    """The text Wi-Fi QR codes hold (phones' cameras join from it): WIFI:T:WPA;S:name;P:password;;"""
    if security == 'enterprise':
        raise Fail("an enterprise network can't be shared with a code: each person signs in with their own account")
    t = 'nopass' if security == 'nopass' else security
    out = 'WIFI:T:%s;S:%s;' % (t, qr_escape(ssid))
    if t != 'nopass':
        out += 'P:%s;' % qr_escape(password or '')
    if hidden:
        out += 'H:true;'
    return out + ';'


def qr_rows(text):
    """qrencode's ASCII picture (two characters a square, '#' dark) as rows of "0"/"1". The text goes on its stdin."""
    if not shutil.which('qrencode'):
        raise Fail("qrencode isn't on this system, so there's no code to show")
    code, out, err = run(['qrencode', '-t', 'ASCII', '-m', '0', '-l', 'M', '-o', '-'], input=text, timeout=15)
    if code != 0 or not out.strip():
        raise Fail("couldn't make the code")
    rows = []
    for line in out.splitlines():
        if not line.strip():
            continue
        rows.append(''.join('1' if line[i:i + 2] == '##' else '0' for i in range(0, len(line), 2)))
    w = max(len(r) for r in rows)
    return [r.ljust(w, '0') for r in rows]


def wifi_qr(uuid):
    check_uuid(uuid)
    s = parse_show(nmcli(['-t', 'connection', 'show', 'uuid', uuid]))
    if s.get('connection.type') != '802-11-wireless':
        raise Fail('only Wi-Fi networks have a code')
    ssid = val(s, '802-11-wireless.ssid')
    sec = wifi_security(s)
    pw = ''
    if sec in ('WPA', 'SAE'):
        pw = nmcli(['-s', '-g', '802-11-wireless-security.psk', 'connection', 'show', 'uuid', uuid]).strip()
        if not pw:
            raise Fail("NetworkManager didn't give the password (your keyring keeps it): connect once from Hearth, then try again")
    elif sec == 'WEP':
        pw = nmcli(['-s', '-g', '802-11-wireless-security.wep-key0', 'connection', 'show', 'uuid', uuid]).strip()
    rows = qr_rows(wifi_qr_text(ssid, sec, pw, val(s, '802-11-wireless.hidden') == 'yes'))
    return {'ssid': ssid, 'security': sec, 'password': pw, 'size': len(rows), 'rows': rows}


def duplicate(uuid):
    check_uuid(uuid)
    conns = parse_connections(nmcli(['-t', '-f', 'NAME,UUID,TYPE,DEVICE,ACTIVE,AUTOCONNECT', 'connection', 'show']))
    me = next((c for c in conns if c['uuid'] == uuid), None)
    if not me:
        raise Fail("that connection isn't there any more")
    names = {c['name'] for c in conns}
    base = me['name'][:56] + ' (copy)'
    name, i = base, 2
    while name in names:
        name = '%s %d' % (base, i); i += 1
    out = nmcli(['connection', 'clone', 'uuid', uuid, name])
    new = new_uuid(out.replace(uuid, ''), 'copy')
    # The copy never connects by itself (two of the same fighting over the device): you pick it.
    try:
        nmcli(['connection', 'modify', 'uuid', new, 'connection.autoconnect', 'no'])
    except Fail:
        pass
    return {'uuid': new, 'name': name}


# ------------------------------------------------------------------ hotspot
def hotspot_conn():
    for c in parse_connections(nmcli(['-t', '-f', 'NAME,UUID,TYPE,DEVICE,ACTIVE,AUTOCONNECT', 'connection', 'show'])):
        if c['kind'] == 'wifi':
            mode = nmcli(['-g', '802-11-wireless.mode', 'connection', 'show', 'uuid', c['uuid']]).strip()
            if mode == 'ap' and (c['name'] == HOTSPOT_NAME or c['name'].startswith('Hotspot')):
                return c
    return None


def can_hotspot(dev):
    if not dev:
        return False
    try:
        v = nmcli(['-g', 'WIFI-PROPERTIES.AP', 'device', 'show', dev]).strip()
    except Fail:
        return True
    return v != 'no'


def hotspot():
    dev = wifi_device(nmcli(['-t', '-f', 'DEVICE,TYPE,STATE', 'device']))
    c = hotspot_conn()
    out = {'on': False, 'ssid': '', 'band': '', 'uuid': '', 'device': dev, 'canHotspot': can_hotspot(dev)}
    if c:
        s = parse_show(nmcli(['-t', 'connection', 'show', 'uuid', c['uuid']]))
        out.update({'on': c['active'], 'uuid': c['uuid'], 'ssid': s.get('802-11-wireless.ssid', ''),
                    'band': s.get('802-11-wireless.band', '') if s.get('802-11-wireless.band') != '--' else ''})
    return out


def hotspot_check(req):
    ssid = str(req.get('ssid') or '').strip()
    pw = str(req.get('password') or '')
    band = req.get('band') or ''
    if not ssid or len(ssid.encode()) > 32 or any(ord(ch) < 32 for ch in ssid):
        raise Fail('the name is 1 to 32 letters')
    if pw and (not 8 <= len(pw) <= 63 or not all(32 <= ord(ch) < 127 for ch in pw)):
        raise Fail('the password is 8 to 63 letters, numbers or symbols')
    if pw != pw.strip():
        raise Fail("the password can't start or end with a space")
    if band not in ('', 'bg', 'a'):
        raise Fail('the band is 2.4 GHz (bg) or 5 GHz (a)')
    return ssid, pw, band


def editor_script(pw):
    """Commands for `nmcli connection edit`, read on its stdin: the password never goes on a command line."""
    return 'set 802-11-wireless-security.psk %s\nsave persistent\nquit\n' % pw


def hotspot_on(req):
    ssid, pw, band = hotspot_check(req)
    dev = wifi_device(nmcli(['-t', '-f', 'DEVICE,TYPE,STATE', 'device']))
    if not dev:
        raise Fail('this PC has no Wi-Fi')
    c = hotspot_conn()
    props = ['802-11-wireless.ssid', ssid, '802-11-wireless.mode', 'ap', '802-11-wireless.band', band,
             'ipv4.method', 'shared', 'ipv6.method', 'ignore', 'connection.autoconnect', 'no',
             'wifi-sec.key-mgmt', 'wpa-psk', 'wifi-sec.proto', 'rsn', 'wifi-sec.pairwise', 'ccmp', 'wifi-sec.group', 'ccmp']
    if c:
        uuid = c['uuid']
        nmcli(['connection', 'modify', 'uuid', uuid, 'connection.interface-name', dev] + props)
    else:
        if not pw:
            raise Fail('choose a password for the hotspot (8 letters or more)')
        out = nmcli(['connection', 'add', 'type', 'wifi', 'ifname', dev, 'con-name', HOTSPOT_NAME] + props)
        m = re.search(r'\(([0-9a-fA-F-]{36})\)', out)
        if not m:
            raise Fail('NetworkManager made no hotspot')
        uuid = m.group(1)
    if pw:
        nmcli(['connection', 'edit', 'uuid', uuid], input=editor_script(pw))
    nmcli(['--wait', '30', 'connection', 'up', 'uuid', uuid], timeout=45)
    return hotspot()


def hotspot_off():
    c = hotspot_conn()
    if c and c['active']:
        nmcli(['connection', 'down', 'uuid', c['uuid']])
    return hotspot()


def hotspot_password():
    c = hotspot_conn()
    if not c:
        raise Fail('there is no hotspot yet')
    pw = nmcli(['-s', '-g', '802-11-wireless-security.psk', 'connection', 'show', 'uuid', c['uuid']]).strip()
    return {'password': pw}


# ------------------------------------------------------------------ proxy
def proxy_load():
    raw = {}
    if hsio:
        raw = hsio.load_json(PROXY_JSON, {})
    else:
        try:
            raw = json.load(open(PROXY_JSON))
        except (OSError, ValueError):
            raw = {}
    out = dict(PROXY_DEFAULT)
    out.update({k: v for k, v in (raw or {}).items() if k in PROXY_DEFAULT and isinstance(v, str)})
    return out


def proxy_clean(req):
    out = {}
    if 'mode' in req:
        if req['mode'] not in ('none', 'auto', 'manual'):
            raise Fail('the proxy is off, automatic or manual')
        out['mode'] = req['mode']
    if 'url' in req:
        u = str(req['url'] or '').strip()
        if u and not re.match(r'^(https?|file)://[^\s"\'\\]{1,2000}$', u):
            raise Fail('the setup address is like http://wpad.example/proxy.pac')
        out['url'] = u
    for k in ('http', 'https', 'socks'):
        if k in req:
            v = str(req[k] or '').strip()
            v = re.sub(r'^[a-z0-9]+://', '', v).rstrip('/')
            if v:
                m = HOSTPORT_RE.match(v)
                if not m or not 0 < int(m.group(3)) < 65536:
                    raise Fail('a proxy is like proxy.example.com:3128')
            out[k] = v
    if 'ignore' in req:
        v = str(req['ignore'] or '')
        items = [x for x in re.split(r'[,\s]+', v) if x]
        if len(items) > 64 or not all(re.match(r'^[A-Za-z0-9.*:/\[\]_-]{1,255}$', x) for x in items):
            raise Fail('no-proxy addresses are names or addresses, split with commas')
        out['ignore'] = ', '.join(items)
    return out


def split_hp(v):
    m = HOSTPORT_RE.match(v or '')
    return (m.group(1).strip('[]'), int(m.group(3))) if m else ('', 0)


def proxy_env_text(p):
    if p['mode'] != 'manual':
        return None
    lines = [MARK]
    for k, env in (('http', 'http_proxy'), ('https', 'https_proxy')):
        if p[k]:
            lines += ['%s=http://%s' % (env, p[k]), '%s=http://%s' % (env.upper(), p[k])]
    if p['socks']:
        lines += ['all_proxy=socks5://%s' % p['socks'], 'ALL_PROXY=socks5://%s' % p['socks']]
    if p['ignore']:
        no = p['ignore'].replace(' ', '')
        lines += ['no_proxy=' + no, 'NO_PROXY=' + no]
    return '\n'.join(lines) + '\n'


def ini_set(text, section, values):
    """Set keys in one [section] of an INI file's text, keeping every other line."""
    lines = text.splitlines()
    out, i, found, done = [], 0, False, set()
    in_sec = False
    for line in lines:
        s = line.strip()
        if s.startswith('[') and s.endswith(']'):
            if in_sec:
                out += ['%s=%s' % (k, v) for k, v in values.items() if k not in done]
                done.update(values)
            in_sec = s[1:-1] == section
            found = found or in_sec
            out.append(line)
            continue
        if in_sec and '=' in line and line.split('=', 1)[0].strip() in values:
            k = line.split('=', 1)[0].strip()
            out.append('%s=%s' % (k, values[k])); done.add(k)
            continue
        out.append(line)
    if in_sec:
        out += ['%s=%s' % (k, v) for k, v in values.items() if k not in done]
    elif not found:
        if out and out[-1].strip():
            out.append('')
        out.append('[%s]' % section)
        out += ['%s=%s' % (k, v) for k, v in values.items()]
    return '\n'.join(out) + '\n'


def kio_values(p):
    kind = {'none': 0, 'manual': 1, 'auto': 2}[p['mode']]
    def kv(v, scheme):
        h, port = split_hp(v)
        return '%s://%s %d' % (scheme, h, port) if h else ''
    return {'ProxyType': str(kind), 'Proxy Config Script': p['url'] if p['mode'] == 'auto' else '',
            'httpProxy': kv(p['http'], 'http'), 'httpsProxy': kv(p['https'], 'http'),
            'socksProxy': kv(p['socks'], 'socks'), 'NoProxyFor': p['ignore'].replace(' ', '')}


def gsettings_cmds(p):
    base = 'org.gnome.system.proxy'
    cmds = [[base, 'mode', p['mode']], [base, 'autoconfig-url', p['url'] if p['mode'] == 'auto' else '']]
    for k, schema in (('http', base + '.http'), ('https', base + '.https'), ('socks', base + '.socks')):
        h, port = split_hp(p[k])
        cmds += [[schema, 'host', h], [schema, 'port', str(port)]]
    hosts = [x for x in re.split(r'[,\s]+', p['ignore']) if x]
    cmds.append([base, 'ignore-hosts', '[' + ', '.join("'%s'" % h for h in hosts) + ']'])
    return cmds


def write_text(path, text):
    if hsio:
        hsio.write_text(path, text)
    else:
        plain_write(path, text)


def _plain_replace(path, data):
    d = os.path.dirname(os.path.abspath(path))
    os.makedirs(d, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.' + os.path.basename(path) + '.', suffix='.tmp', dir=d)
    try:
        with os.fdopen(fd, 'wb') as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def plain_write(path, text):
    """Only when hearth_settings_io can't be imported: still atomic (a temporary file, fsync, then moved in place) and
    still keeps FILE.bak (the current file, when it has something in it, goes there first)."""
    data = text.encode('utf-8', 'surrogateescape')
    try:
        with open(path, 'rb') as f:
            cur = f.read()
    except OSError:
        cur = None
    if cur == data:
        return
    if cur is not None and cur.strip():
        _plain_replace(path + '.bak', cur)
    _plain_replace(path, data)


def plain_load_json(path):
    """PATH's JSON object ({} when it isn't there). A file that doesn't read as one raises Fail: it's never saved over."""
    try:
        with open(path, encoding='utf-8') as f:
            raw = f.read()
    except FileNotFoundError:
        return {}
    except OSError as e:
        raise Fail('%s can\'t be read (%s); not saved over' % (path, e))
    try:
        v = json.loads(raw)
    except ValueError:
        v = None
    if not isinstance(v, dict):
        raise Fail('%s is damaged; not saved over (its .bak may have your last good settings)' % path)
    return v


def read(path):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return ''


def proxy_apply(p=None):
    """Hand the saved proxy on to apps. Writes only files that are Hearth's (the mark) or kioslaverc's proxy keys."""
    p = p or proxy_load()
    if shutil.which('gsettings'):
        for schema, key, val in gsettings_cmds(p):
            run(['gsettings', 'set', schema, key, val], timeout=10)
    cur = read(KIOSLAVERC)
    new = ini_set(cur, 'Proxy Settings', kio_values(p))
    if new != cur and (cur or p['mode'] != 'none'):
        write_text(KIOSLAVERC, new)
    env = proxy_env_text(p)
    old = read(PROXY_ENV)
    if env is None:
        if old.startswith(MARK):
            os.remove(PROXY_ENV)
    elif not old or old.startswith(MARK):
        if old != env:
            write_text(PROXY_ENV, env)
    return p


def proxy_set(req):
    changes = proxy_clean(req)
    would = proxy_load(); would.update(changes)
    if would['mode'] == 'auto' and not would['url']:
        raise Fail('type the setup script address, or pick Manual')
    if would['mode'] == 'manual' and not (would['http'] or would['https'] or would['socks']):
        raise Fail('type at least one proxy, like proxy.example.com:3128')
    if hsio:
        hsio.merge_json(PROXY_JSON, changes, who='you')
    else:
        cur = plain_load_json(PROXY_JSON)       # merged into what's on disk; a damaged file is never saved over
        cur.update(changes)
        write_text(PROXY_JSON, json.dumps(cur, indent=2) + '\n')
    p = proxy_load()
    proxy_apply(p)
    return p


def stdin_json():
    raw = os.environ.pop('HEARTH_INPUT', None)
    if raw is None:
        raw = '' if sys.stdin.isatty() else sys.stdin.read()
    if not raw.strip():
        return {}
    try:
        v = json.loads(raw)
    except ValueError:
        raise Fail('bad input')
    if not isinstance(v, dict):
        raise Fail('bad input')
    return v


