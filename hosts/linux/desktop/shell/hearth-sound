#!/usr/bin/python3
"""hearth-sound: the parts of Hearth Settings' Sound page Quickshell's PipeWire service doesn't give: each sound card's
profiles (which outputs and inputs it offers: stereo, surround, HDMI, a headset's high quality or its microphone), and
a microphone test (a few seconds recorded, how loud it was, and playing it back). As you, through pactl (PipeWire's
pulse server) and pw-record / pw-play, always with argument lists. PipeWire (WirePlumber) remembers a profile you pick
by itself; Hearth keeps no file for it. The test recording is in $XDG_RUNTIME_DIR (memory, gone at sign-out).

  hearth-sound cards               JSON: {cards: [{name, description, kind, active, profiles: [{name, description,
                                   available}]}]}
  hearth-sound profile CARD NAME   use this profile on that card
  hearth-sound mic-test [SECONDS]  record from the microphone in use (2-8 s, 4 by default); JSON {peak, rms, level,
                                   seconds, file}
  hearth-sound mic-play            play the last test recording back
  hearth-sound outputs             JSON: {outputs: [{name, description, default, channels: [{id, label, volume}],
                                   balance}]}: each output's speakers and their levels (1.14, Speakers & balance)
  hearth-sound balance SINK N      left/right balance -100 (all left) .. 100 (all right); the loudest channel keeps
                                   its level, centre and LFE are left alone (PipeWire remembers it itself)
  hearth-sound speaker-test SINK CHANNEL   a short tone from one speaker (CHANNEL as in outputs, e.g. front-left)
Output: one JSON line; failures print "error: ..." and exit 1.
"""
import array
import json
import math
import os
import re
import shutil
import subprocess
import sys
import wave

RUN = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
TEST = os.path.join(RUN, 'hearth-mic-test.wav')
NAME_RE = re.compile(r'^[A-Za-z0-9_.:@+-]{1,200}$')


class Fail(Exception):
    pass


def run(cmd, timeout=20):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, '', str(e)
    return p.returncode, p.stdout, p.stderr


def kind_of(card):
    props = card.get('properties') or {}
    bus = props.get('device.bus', '')
    form = props.get('device.form_factor', '')
    if bus == 'bluetooth':
        return 'bluetooth'
    if bus == 'usb':
        return 'usb'
    if 'hdmi' in (card.get('name', '') + props.get('device.description', '')).lower() or form == 'hdmi':
        return 'hdmi'
    return 'internal'


def parse_cards(js):
    out = []
    for c in js or []:
        props = c.get('properties') or {}
        profiles = []
        for name, p in (c.get('profiles') or {}).items():
            if name == 'off':
                continue
            profiles.append({'name': name, 'description': p.get('description') or name,
                             'available': p.get('available', True) not in (False, 'no'),
                             'priority': p.get('priority', 0)})
        profiles.sort(key=lambda p: (not p['available'], -int(p['priority'] or 0)))
        out.append({'name': c.get('name', ''), 'description': props.get('device.description') or c.get('name', ''),
                    'kind': kind_of(c), 'active': c.get('active_profile', ''), 'profiles': profiles})
    return [c for c in out if c['name'] and c['profiles']]


def cards():
    if not shutil.which('pactl'):
        raise Fail("pactl isn't on this system")
    code, out, err = run(['pactl', '--format=json', 'list', 'cards'])
    if code != 0:
        raise Fail("couldn't ask the sound server")
    try:
        js = json.loads(out or '[]')
    except ValueError:
        raise Fail('the sound server answered something unexpected')
    return {'cards': parse_cards(js)}


def profile(card, name):
    if not NAME_RE.match(card or '') or not NAME_RE.match(name or ''):
        raise Fail('not a sound card or profile')
    known = {c['name']: [p['name'] for p in c['profiles']] for c in cards()['cards']}
    if name not in known.get(card, []):
        raise Fail('that card has no such profile')
    code, out, err = run(['pactl', 'set-card-profile', card, name])
    if code != 0:
        raise Fail((err or out).strip()[:200] or 'the sound server said no')
    return {'ok': True, 'card': card, 'profile': name}


def levels(path):
    """Peak and RMS of a 16-bit WAV as 0..1, and a word for it."""
    with wave.open(path, 'rb') as w:
        if w.getsampwidth() != 2:
            raise Fail('unexpected recording format')
        frames = w.readframes(w.getnframes())
        secs = w.getnframes() / float(w.getframerate() or 1)
    a = array.array('h')
    a.frombytes(frames[:len(frames) - len(frames) % 2])
    if sys.byteorder == 'big':
        a.byteswap()
    if not a:
        return 0.0, 0.0, 'silent', secs
    peak = max(abs(x) for x in a) / 32768.0
    rms = math.sqrt(sum(x * x for x in a) / len(a)) / 32768.0
    level = 'silent' if peak < 0.01 else 'quiet' if peak < 0.12 else 'loud' if peak > 0.98 else 'good'
    return round(peak, 3), round(rms, 4), level, round(secs, 1)


def mic_test(seconds=4):
    seconds = int(seconds)
    if not 2 <= seconds <= 8:
        raise Fail('2 to 8 seconds')
    if not shutil.which('pw-record'):
        raise Fail("pw-record isn't on this system")
    try:
        os.remove(TEST)
    except OSError:
        pass
    try:
        subprocess.run(['pw-record', '--rate', '48000', '--channels', '1', '--format', 's16', TEST],
                       capture_output=True, timeout=seconds)
    except subprocess.TimeoutExpired:
        pass                       # the normal end: recorded for SECONDS
    except OSError as e:
        raise Fail(str(e))
    if not os.path.isfile(TEST) or os.path.getsize(TEST) < 100:
        raise Fail("nothing came from the microphone (is one plugged in and picked?)")
    peak, rms, level, secs = levels(TEST)
    return {'peak': peak, 'rms': rms, 'level': level, 'seconds': secs, 'file': TEST}


def mic_play():
    if not os.path.isfile(TEST):
        raise Fail('record a test first')
    if not shutil.which('pw-play'):
        raise Fail("pw-play isn't on this system")
    subprocess.Popen(['pw-play', TEST], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return {'ok': True}


# ------------------------------------------------------------------ 1.14: Speakers & balance
LEFT = ('front-left', 'rear-left', 'side-left', 'front-left-of-center', 'aux0')
RIGHT = ('front-right', 'rear-right', 'side-right', 'front-right-of-center', 'aux1')
CHANNEL_LABELS = {'mono': 'Mono', 'front-left': 'Front left', 'front-right': 'Front right', 'front-center': 'Centre',
                  'lfe': 'Subwoofer', 'rear-left': 'Rear left', 'rear-right': 'Rear right', 'rear-center': 'Rear centre',
                  'side-left': 'Side left', 'side-right': 'Side right', 'front-left-of-center': 'Front left of centre',
                  'front-right-of-center': 'Front right of centre'}
TONE = os.path.join(RUN, 'hearth-speaker-test.wav')


def vol_of(v):
    """pactl's per-channel volume ({"value": 65536, "value_percent": "100%"}) as 0..1.5."""
    try:
        return round(int(v.get('value', 0)) / 65536.0, 3)
    except (AttributeError, TypeError, ValueError):
        return 0.0


def balance_of(chans):
    """-100..100 from the channels' levels (left against right)."""
    l = max([c['volume'] for c in chans if c['id'] in LEFT] or [0])
    r = max([c['volume'] for c in chans if c['id'] in RIGHT] or [0])
    if l <= 0 and r <= 0 or abs(l - r) < 0.005:
        return 0
    return int(round((1 - l / r) * 100)) if r > l else -int(round((1 - r / l) * 100))


def parse_outputs(js, default=''):
    out = []
    for s in js or []:
        name = s.get('name', '')
        if not name or not NAME_RE.match(name):
            continue
        cmap = [c for c in str(s.get('channel_map', '')).split(',') if c]
        vols = s.get('volume') or {}
        chans = [{'id': c, 'label': CHANNEL_LABELS.get(c, c.replace('-', ' ').capitalize()), 'volume': vol_of(vols.get(c))} for c in cmap]
        props = s.get('properties') or {}
        out.append({'name': name, 'description': s.get('description') or props.get('device.description') or name,
                    'default': name == default, 'channels': chans, 'balance': balance_of(chans), 'muted': bool(s.get('mute'))})
    return out


def outputs():
    if not shutil.which('pactl'):
        raise Fail("pactl isn't on this system")
    code, out, err = run(['pactl', '--format=json', 'list', 'sinks'])
    if code != 0:
        raise Fail("couldn't ask the sound server")
    try:
        js = json.loads(out or '[]')
    except ValueError:
        raise Fail('the sound server answered something unexpected')
    code, dflt, _ = run(['pactl', 'get-default-sink'])
    return {'outputs': parse_outputs(js, dflt.strip() if code == 0 else '')}


def balance_levels(chans, value):
    """Each channel's new level (0..1.5) for a balance of VALUE: the loudest side keeps the top level."""
    value = max(-100, min(100, int(value)))
    top = max([c['volume'] for c in chans] or [0]) or 1.0
    new = []
    for c in chans:
        if c['id'] in LEFT:
            v = top * (1 - max(0, value) / 100.0)
        elif c['id'] in RIGHT:
            v = top * (1 + min(0, value) / 100.0)
        else:
            v = c['volume']
        new.append(round(max(0.0, min(1.5, v)), 4))
    return new


def balance(sink, value):
    if not NAME_RE.match(sink or ''):
        raise Fail('not a sound output')
    try:
        value = int(value)
    except ValueError:
        raise Fail('balance is -100 to 100')
    if not -100 <= value <= 100:
        raise Fail('balance is -100 to 100')
    o = next((x for x in outputs()['outputs'] if x['name'] == sink), None)
    if not o:
        raise Fail('no such output')
    if not any(c['id'] in LEFT for c in o['channels']) or not any(c['id'] in RIGHT for c in o['channels']):
        raise Fail('this output has no left and right')
    levels = balance_levels(o['channels'], value)
    code, out, err = run(['pactl', 'set-sink-volume', sink] + ['%d' % round(v * 65536) for v in levels])
    if code != 0:
        raise Fail((err or out).strip()[:200] or 'the sound server said no')
    return {'ok': True, 'sink': sink, 'balance': value}


def tone(path, channels, which, seconds=1.2, rate=48000):
    """A soft 440 Hz tone with a fade in and out in channel WHICH of CHANNELS (16-bit WAV)."""
    n = int(rate * seconds)
    frames = array.array('h')
    for i in range(n):
        env = min(1.0, i / 2400.0, (n - i) / 2400.0)
        v = int(9000 * env * math.sin(2 * math.pi * 440 * i / rate))
        for ch in range(channels):
            frames.append(v if ch == which else 0)
    if sys.byteorder == 'big':
        frames.byteswap()
    with wave.open(path, 'wb') as w:
        w.setnchannels(channels)
        w.setsampwidth(2)
        w.setframerate(rate)
        w.writeframes(frames.tobytes())


def speaker_test(sink, channel):
    if not NAME_RE.match(sink or '') or not re.match(r'^[a-z0-9-]{1,40}$', channel or ''):
        raise Fail('not a sound output or speaker')
    o = next((x for x in outputs()['outputs'] if x['name'] == sink), None)
    if not o:
        raise Fail('no such output')
    ids = [c['id'] for c in o['channels']]
    if channel not in ids:
        raise Fail('that output has no such speaker')
    if not shutil.which('pw-play'):
        raise Fail("pw-play isn't on this system")
    tone(TONE, len(ids), ids.index(channel))
    pwmap = {'front-left': 'FL', 'front-right': 'FR', 'front-center': 'FC', 'lfe': 'LFE', 'rear-left': 'RL',
             'rear-right': 'RR', 'rear-center': 'RC', 'side-left': 'SL', 'side-right': 'SR', 'mono': 'MONO',
             'front-left-of-center': 'FLC', 'front-right-of-center': 'FRC'}
    cm = ','.join(pwmap.get(c, 'AUX%d' % i) for i, c in enumerate(ids))
    subprocess.Popen(['pw-play', '--target', sink, '--channels', str(len(ids)), '--channel-map', cm, TONE],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    return {'ok': True, 'sink': sink, 'channel': channel}


def main(argv):
    try:
        if argv[:1] == ['cards']:
            r = cards()
        elif argv[:1] == ['profile'] and len(argv) == 3:
            r = profile(argv[1], argv[2])
        elif argv[:1] == ['mic-test'] and len(argv) in (1, 2):
            if len(argv) == 2 and not argv[1].isdigit():
                raise Fail('2 to 8 seconds')
            r = mic_test(int(argv[1]) if len(argv) == 2 else 4)
        elif argv[:1] == ['mic-play']:
            r = mic_play()
        elif argv[:1] == ['outputs']:
            r = outputs()
        elif argv[:1] == ['balance'] and len(argv) == 3:
            r = balance(argv[1], argv[2])
        elif argv[:1] == ['speaker-test'] and len(argv) == 3:
            r = speaker_test(argv[1], argv[2])
        else:
            print(__doc__)
            return 2
    except Fail as e:
        print('error: ' + str(e))
        return 1
    print(json.dumps(r))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
