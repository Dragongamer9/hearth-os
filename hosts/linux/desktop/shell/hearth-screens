def main(argv):
    cmd = argv[1] if len(argv) > 1 else ''
    arg = argv[2] if len(argv) > 2 else os.environ.get('HEARTH_INPUT', '')
    try:
        if cmd == 'get':
            print(json.dumps(read()))
        elif cmd == 'info':
            print(json.dumps(info()))
        elif cmd in ('apply', 'set'):
            ch = json.loads(arg or '{}')
            wmname = wm()
            live, problem = apply(ch, wmname)
            if cmd == 'set':
                if 'tearing' in ch:
                    if wmname != 'kwin':
                        raise Refused('Tearing: ' + NEEDS_KWIN)
                    tearing(bool(ch['tearing']))
                    save_entries({}, {'tearing': bool(ch['tearing'])})
                if not problem and ch.get('outputs'):
                    # A new main screen renumbers the others: every screen's is kept.
                    names = [o['name'] for o in live] if any('priority' in e for e in ch['outputs'].values()) else list(ch['outputs'])
                    keep(names, wmname, live)
                    if names != list(ch['outputs']) and wmname == 'kwin' and saved().get('desktopsMainOnly'):
                        try:
                            main_desktops(True, live)
                        except Exception as e:  # noqa: BLE001
                            io.log_event('Desktops on the new main screen: %s' % e)
            r = info(wmname, live)
            r['problem'] = problem
            print(json.dumps(r))
        elif cmd == 'keep':
            names = json.loads(arg or '[]')
            keep(names if isinstance(names, list) else [names])
            print(json.dumps(info()))
        elif cmd == 'restore':
            print(json.dumps(restore()))
        elif cmd == 'autoscale':
            print(json.dumps(autoscale()))
        elif cmd == 'night':
            print(json.dumps(night(json.loads(arg) if arg.strip() else None)))
        elif cmd == 'plan':
            wmname = wm()
            live = read(wmname)
            mode = arg or 'extend'
            ch = switch_plan(mode, live, wmname, info(wmname, live)['mirror']['why'])
            prev = {o['name']: entry_of(o) for o in live if o['name'] in ch}
            print(json.dumps({'mode': mode, 'changes': {'outputs': ch}, 'prev': {'outputs': prev}, 'names': sorted(ch)}))
        elif cmd == 'option':
            # Settings › Display's own switches that aren't a screen's: {"x11Scale": bool, "barrier": {px, corner},
            # "desktopsMainOnly": bool, "autoBrightness": bool, "autoBrightnessOffset": int}. screens.json keeps Hearth's, KDE's files KDE's.
            o = json.loads(arg or '{}')
            wmname = wm()
            extra = {}
            if 'x11Scale' in o or 'barrier' in o or 'desktopsMainOnly' in o:
                if wmname != 'kwin':
                    raise Refused(NEEDS_KWIN)
            if 'x11Scale' in o:
                x11_scale(bool(o['x11Scale']))
            if 'barrier' in o:
                barrier(o['barrier'] or {})
            if 'desktopsMainOnly' in o:
                main_desktops(bool(o['desktopsMainOnly']))
                extra['desktopsMainOnly'] = bool(o['desktopsMainOnly'])
            if 'autoBrightness' in o:
                if o['autoBrightness'] and not light_source()[1]:
                    raise Refused('This PC has no light sensor.')
                extra['autoBrightness'] = bool(o['autoBrightness'])
            if 'autoBrightnessOffset' in o:
                extra['autoBrightnessOffset'] = clamp_offset(o['autoBrightnessOffset'])
            if extra:
                save_entries({}, extra)
            print(json.dumps(info(wmname)))
        elif cmd == 'ddc':
            print(json.dumps(ddc_list()))
        elif cmd == 'ddc-set':
            print(json.dumps(ddc_set(argv[2], argv[3])))
        elif cmd == 'brightness':
            kwin_brightness(argv[2], argv[3])
            print(json.dumps({'name': argv[2], 'value': int(argv[3])}))
        elif cmd == 'light':
            name, src = light_source()
            print(json.dumps({'sensor': src is not None, 'source': name, 'lux': src.read() if src else None}))
        elif cmd == 'autobright':
            print(json.dumps(autobright()))
        elif cmd == 'shot':
            shot(argv[2:])
        elif cmd == 'grab':
            grab(argv[2:])
        else:
            sys.exit(__doc__)
    except NoWindow as e:
        print('error: %s' % e)
        sys.exit(3)
    except Refused as e:
        print('error: %s' % e)
        sys.exit(1)
    except ValueError as e:
        print('error: %s' % e)
        sys.exit(2)


if __name__ == '__main__':
    main(sys.argv)
