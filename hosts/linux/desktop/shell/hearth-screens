MAIN_DESKTOPS_JS = os.path.join(HERE, 'hearth-main-desktops.js')
MAIN_DESKTOPS_NAME = 'hearth-main-desktops'


def desktops_status(wmname, sv=None):
    sv = sv if sv is not None else saved()
    # KWin 6.3 (Debian 13) has one set of desktops for every screen; "each screen its own" needs a newer KWin.
    return {'capable': wmname == 'kwin', 'mode': 'main' if sv.get('desktopsMainOnly') else 'all', 'perScreen': False,
            'why': '' if wmname == 'kwin' else NEEDS_KWIN}


def main_desktops(on, live=None):
    """Desktops only on the main screen: Hearth's KWin script keeps the windows on the other screens on every desktop
    (as GNOME's "workspaces on the primary display only"); off puts back only the windows it changed. The script gets
    the main screen's name (a copy in $XDG_RUNTIME_DIR), so a new main screen loads it again."""
    if on:
        live = live if live is not None else read('kwin')
        main = next((o['name'] for o in live if o.get('priority') == 1), None) or next((o['name'] for o in live if o.get('enabled')), '')
        try:
            src = _text(MAIN_DESKTOPS_JS)
        except OSError:
            raise Refused("Hearth's desktops script is missing.")
        run_dir = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
        path = os.path.join(run_dir, 'hearth-main-desktops.js')
        io.write_text(path, src.replace('"HEARTH_MAIN"', json.dumps(main)), mode=0o600)
        kwin_call('unloadScript', '/Scripting', 'org.kde.kwin.Scripting', (MAIN_DESKTOPS_NAME,), '(s)')
        r = kwin_call('loadScript', '/Scripting', 'org.kde.kwin.Scripting', (path, MAIN_DESKTOPS_NAME), '(ss)')
        sid = r.unpack()[0] if r is not None else -1
        if sid is None or sid < 0:
            raise Refused("KWin didn't take Hearth's desktops script.")
        if kwin_call('run', '/Scripting/Script%d' % sid, 'org.kde.kwin.Script') is None:
            kwin_call('run', '/%d' % sid, 'org.kde.kwin.Script')
        return True
    # The running script puts its windows back when its own shortcut is called, then it's unloaded.
    kwin_call('invokeShortcut', '/component/kwin', 'org.kde.kglobalaccel.Component', ('Hearth main desktops off',), '(s)',
              dest='org.kde.kglobalaccel')
    time.sleep(0.3)
    kwin_call('unloadScript', '/Scripting', 'org.kde.kwin.Scripting', (MAIN_DESKTOPS_NAME,), '(s)')
    return False


# ------------------------------------------------------------------ brightness of external screens (DDC/CI)

def parse_ddc_detect(text):
    """`ddcutil detect --terse` → {connector name: i2c bus number}."""
    got, bus, valid = {}, None, False
    for line in text.splitlines():
        if re.match(r'^(Display|Invalid display|Phantom display)\b', line):
            bus, valid = None, line.startswith('Display')
            continue
        m = re.match(r'^\s*I2C bus:\s*/dev/i2c-(\d+)', line)
        if m:
            bus = int(m.group(1))
            continue
        m = re.match(r'^\s*DRM[_ ]connector:\s*card\d+-(\S+)', line)
        if m and bus is not None and valid:
            got[m.group(1)] = bus
    return got


def parse_vcp(text):
    """`ddcutil getvcp 10 --terse`: "VCP 10 C 50 100" → (50, 100)."""
    m = re.search(r'VCP\s+10\s+C\s+(\d+)\s+(\d+)', text)
    return (int(m.group(1)), int(m.group(2))) if m else None


def ddc_list():
    """External screens whose brightness Hearth can change over DDC/CI (ddcutil; Settings › Display uses KWin's own
    control instead for a screen a newer KWin controls itself). A screen that doesn't answer is left out."""
    if fixture('ddc.json') is not None:
        return json.loads(fixture('ddc.json'))
    if not have('ddcutil') or not glob.glob('/dev/i2c-*'):
        return {'available': False, 'why': 'ddcutil or the i2c-dev module is missing', 'screens': []}
    rc, out, err = RUN(['ddcutil', 'detect', '--terse'], timeout=15)
    if rc != 0:
        return {'available': False, 'why': (err or out).strip().splitlines()[-1][:160] if (err or out).strip() else 'ddcutil found no screens', 'screens': []}
    screens = []
    for name, bus in sorted(parse_ddc_detect(out).items()):
        rc, o, _ = RUN(['ddcutil', '--bus', str(bus), 'getvcp', '10', '--terse'], timeout=6)
        v = parse_vcp(o) if rc == 0 else None
        if v:
            screens.append({'name': name, 'bus': bus, 'value': v[0], 'max': v[1] or 100})
    return {'available': True, 'why': '' if screens else "No screen answered over DDC/CI (turn DDC/CI on in the screen's own menu)", 'screens': screens}


def ddc_set(name, pct):
    """Brightness of NAME (0–100 % of what the screen allows). The screen keeps it itself: nothing is saved here."""
    d = ddc_list()
    s = next((x for x in d['screens'] if x['name'] == name), None)
    if not s:
        raise Refused("%s doesn't answer over DDC/CI." % name)
    v = round(max(0, min(100, float(pct))) * s['max'] / 100)
    rc, out, err = RUN(['ddcutil', '--bus', str(s['bus']), 'setvcp', '10', str(v)], timeout=10)
    if rc != 0:
        raise Refused("The screen didn't take it: %s" % ((err or out).strip()[:160] or rc))
    return {'name': name, 'value': v, 'max': s['max']}


def kwin_brightness(name, pct):
    """A screen KWin controls itself (newer KWin: laptops and DDC/CI): kscreen-doctor's brightness."""
    rc, out, err = RUN(['kscreen-doctor', 'output.%s.brightness.%d' % (name, max(0, min(100, int(pct))))], timeout=10, env=kscreen_env())
    if rc != 0:
        raise Refused("KWin didn't take it: %s" % ((err or out).strip()[:160] or rc))


# ------------------------------------------------------------------ auto-brightness (an ambient light sensor)
# The sensor through iio-sensor-proxy (net.hadess.SensorProxy on the system bus: HasAmbientLight, ClaimLight,
# LightLevel, LightLevelUnit), as KDE and GNOME read it; the kernel's IIO files only where the proxy isn't running.
# HEARTH_SCREENS_SENSOR_BUS=session: a stand-in proxy on the session bus (the tests' fake sensor).

IIO = os.environ.get('HEARTH_SCREENS_IIO', '/sys/bus/iio/devices')
PROXY = ('net.hadess.SensorProxy', '/net/hadess/SensorProxy', 'net.hadess.SensorProxy')
OFFSET_MIN, OFFSET_MAX = -40, 40
STATUS = os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'hearth-autobright.json')


def light_sensor():
    """The kernel's ambient light sensor's lux file and scale, or None."""
    for d in sorted(glob.glob(os.path.join(IIO, 'iio:device*'))):
        for f in ('in_illuminance_input', 'in_illuminance_raw'):
            p = os.path.join(d, f)
            if os.path.exists(p):
                scale = 1.0
                try:
                    scale = float(_text(os.path.join(d, 'in_illuminance_scale')).strip()) if f.endswith('raw') else 1.0
                except (OSError, ValueError):
                    pass
                return p, scale
    return None


def sysfs_lux():
    s = light_sensor()
    if not s:
        return None
    try:
        return max(0.0, float(_text(s[0]).strip()) * s[1])
    except (OSError, ValueError):
        return None


class ProxyLight:
    """iio-sensor-proxy's light sensor. claim() holds it for as long as this connection lives (the proxy reads the
    sensor only while someone has claimed it); read() is the newest level in lux."""

    def __init__(self):
        self.bus = None
        self.claimed = False
        Gio, GLib = _gio()
        self.Gio, self.GLib = Gio, GLib
        if not Gio:
            return
        try:
            kind = Gio.BusType.SESSION if os.environ.get('HEARTH_SCREENS_SENSOR_BUS') == 'session' else Gio.BusType.SYSTEM
            self.bus = Gio.bus_get_sync(kind, None)
        except Exception as e:  # noqa: BLE001
            io.log_event('light sensor: no bus: %s' % e)

    def _call(self, iface, method, args=None, sig=None):
        if not self.bus:
            return None
        try:
            return self.bus.call_sync(PROXY[0], PROXY[1], iface, method, self.GLib.Variant(sig, args) if sig else None, None,
                                      self.Gio.DBusCallFlags.NO_AUTO_START, 2000, None)
        except Exception:  # noqa: BLE001 (not running: no sensor through the proxy)
            return None

    def prop(self, name):
        r = self._call('org.freedesktop.DBus.Properties', 'Get', (PROXY[2], name), '(ss)')
        return r.unpack()[0] if r is not None else None

    def present(self):
        return self.prop('HasAmbientLight') is True

    def claim(self):
        self.claimed = self._call(PROXY[2], 'ClaimLight') is not None
        return self.claimed

    def release(self):
        if self.claimed:
            self._call(PROXY[2], 'ReleaseLight')
            self.claimed = False

    def read(self):
        v = self.prop('LightLevel')
        if v is None:
            return None
        # "vendor" units have no fixed scale: read as lux (the "how bright" offset evens it out).
        return max(0.0, float(v))


class SysfsLight:
    def present(self):
        return light_sensor() is not None

    def claim(self):
        return True

    def release(self):
        pass

    def read(self):
        return sysfs_lux()


def light_source():
    """The light sensor to read ('proxy' first), or (None, None): no sensor and the rows stay hidden."""
    p = ProxyLight()
    if p.present():
        return 'iio-sensor-proxy', p
    s = SysfsLight()
    if s.present():
        return 'sysfs', s
    return None, None


def lux():
    _, src = light_source()
    return src.read() if src else None


def lux_to_pct(lx):
    """Dim rooms low, daylight full: 10 % at 0 lux, about 70 % at 300 lux (an office), 100 % from about 3000."""
    import math
    return int(max(5, min(100, round(10 + 22.5 * math.log10(1 + lx)))))


def clamp_offset(v):
    try:
        return max(OFFSET_MIN, min(OFFSET_MAX, int(round(float(v)))))
    except (TypeError, ValueError):
        return 0


class AutoBright:
    """Auto-brightness's thinking, one reading at a time (no I/O: the loop below and the tests feed it).

    The light is smoothed (an average that follows the room in about ten seconds, in log lux, so a hand over the
    sensor or a passing shadow doesn't flicker the screen), turned into a brightness, moved by the "how bright"
    offset, and the screen is moved there in small steps. A brightness someone set by hand (keys, Quick settings,
    the slider) pauses it until the room's light really changes."""
    ALPHA = 0.3          # how much of each new reading goes into the average
    STEP = 6             # at most this much per reading, so it fades
    DEADBAND = 3         # smaller changes than this are left alone
    HAND = 3             # the screen differs from what was set by more than this: someone changed it
    RESUME = 0.3         # log10(1 + lux) has moved this far since the pause (about twice or half the light)

    def __init__(self):
        self.smooth = None   # log10(1 + lux)
        self.last = None     # the brightness this set last
        self.paused = False
        self.paused_at = None

    def tick(self, lx, current, offset=0):
        """lx: the sensor's lux (None: no reading); current: the screen's brightness now (%, None: unknown).
        Returns the brightness to set, or None."""
        import math
        if lx is None:
            return None
        v = math.log10(1 + max(0.0, lx))
        self.smooth = v if self.smooth is None else self.smooth + self.ALPHA * (v - self.smooth)
        if current is not None and self.last is not None and not self.paused and abs(current - self.last) > self.HAND:
            self.paused, self.paused_at = True, self.smooth
            io.log_event('auto-brightness: paused (brightness set by hand to %d%%)' % current)
        if self.paused:
            if abs(self.smooth - self.paused_at) < self.RESUME:
                return None
            self.paused, self.paused_at = False, None
            self.last = current
            io.log_event('auto-brightness: the light changed, following the room again')
        target = max(1, min(100, lux_to_pct(10 ** self.smooth - 1) + clamp_offset(offset)))
        base = current if current is not None else self.last
        if base is None:
            self.last = target
            return target
        if abs(target - base) < self.DEADBAND:
            if current is not None:
                self.last = current
            return None
        want = base + max(-self.STEP, min(self.STEP, target - base))
        self.last = want
        return want


def backlight_pct():
    """The built-in screen's brightness now (brightnessctl's backlight class, the same path the slider and keys use)."""
    rc, out, _ = RUN(['brightnessctl', '-m', '-c', 'backlight'], timeout=5)
    try:
        return int(out.strip().splitlines()[0].split(',')[3].rstrip('%')) if rc == 0 else None
    except (IndexError, ValueError):
        return None


def _status(d):
    try:
        io.write_json(STATUS, d)    # $XDG_RUNTIME_DIR: what Settings shows (paused or following), not a setting
    except OSError:
        pass


def autobright(interval=2.0, rounds=None):
    """Runs while Settings › Display's Auto-brightness is on (the shell starts it; screens.json says so). Ends by
    itself when it's turned off, or there's no sensor or backlight (logged; nothing else depends on it)."""
    name, src = light_source()
    if not src or not have('brightnessctl') or backlight_pct() is None:
        why = 'no light sensor' if not src else 'no backlight Hearth can set'
        io.log_event('auto-brightness: not running: %s' % why)
        return {'running': False, 'why': why}
    if not src.claim():
        io.log_event("auto-brightness: the light sensor couldn't be claimed")
        return {'running': False, 'why': "the light sensor couldn't be claimed"}
    ab, n, was = AutoBright(), 0, None
    try:
        while True:
            sv = saved()
            if not sv.get('autoBrightness'):
                break
            lx = src.read()
            want = ab.tick(lx, backlight_pct(), sv.get('autoBrightnessOffset', 0))
            if want is not None:
                RUN(['brightnessctl', '-q', '-c', 'backlight', 'set', '%d%%' % want], timeout=5)
            now = {'paused': ab.paused, 'lux': None if lx is None else round(lx, 1), 'source': name}
            if now != was:
                _status(now)
                was = now
            n += 1
            if rounds is not None and n >= rounds:
                break
            time.sleep(interval)
    finally:
        src.release()
        _status({'paused': False, 'running': False})
    return {'running': False}


def autobright_status():
    try:
        d = json.loads(_text(STATUS))
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


# ------------------------------------------------------------------ Super+P: one screen, extend, mirror

def _logical(o):
    m = next((x for x in o.get('modes', []) if x.get('current')), None) or \
        next((x for x in o.get('modes', []) if x.get('preferred')), None) or (o.get('modes') or [{'width': 1920, 'height': 1080}])[0]
    turned = o.get('rotation') in ('left', 'right')
    sc = float(o.get('scale') or 1)
    return round((m['height'] if turned else m['width']) / sc), round((m['width'] if turned else m['height']) / sc)


def switch_plan(mode, live, wmname, mirror_why=''):
    """What Super+P's choice changes: {screen: entry}. MODE: main (only the main screen), other (only the other
    screen), extend (every screen, a screen that was off to the right of the others), mirror."""
    if mode == 'mirror':
        raise Refused(mirror_why or "Mirroring isn't possible here.")
    if not live:
        raise Refused('No screens are connected.')
    main = next((o for o in live if o.get('priority') == 1), None) or next((o for o in live if o.get('enabled')), live[0])
    others = [o for o in live if o['name'] != main['name']]
    if mode in ('other', 'extend') and not others:
        raise Refused('Only one screen is connected.')
    ch = {}
    if mode == 'main':
        if not main.get('enabled'):
            ch[main['name']] = {'enabled': True}
        for o in others:
            if o.get('enabled'):
                ch[o['name']] = {'enabled': False}
    elif mode == 'other':
        o = others[0]
        if not o.get('enabled'):
            ch[o['name']] = {'enabled': True, 'pos': {'x': 0, 'y': 0}}
        if main.get('enabled'):
            ch[main['name']] = {'enabled': False}
        for x in others[1:]:
            if x.get('enabled'):
                ch[x['name']] = {'enabled': False}
    elif mode == 'extend':
        on = [o for o in live if o.get('enabled')]
        right = max([(o.get('position') or {}).get('x', 0) + _logical(o)[0] for o in on] or [0])
        for o in live:
            if not o.get('enabled'):
                ch[o['name']] = {'enabled': True, 'pos': {'x': right, 'y': 0}}
                right += _logical(o)[0]
    else:
        raise Refused('Unknown choice %s' % mode)
    return ch


def switch_state(live):
    """Which of Super+P's choices is in use now."""
    on = [o for o in live if o.get('enabled')]
    if len(live) < 2 or len(on) == 1:
        main = next((o for o in live if o.get('priority') == 1), None) or (on[0] if on else None)
        return 'main' if (not on or not main or on[0]['name'] == main['name']) else 'other'
    return 'extend'


def icc_profiles():
    got = []
    for d in ICC_DIRS:
        for f in sorted(glob.glob(os.path.join(d, '*.ic[cm]'))):
            got.append({'path': f, 'label': os.path.splitext(os.path.basename(f))[0]})
    return got[:20]


def auto_status(sv):
    """Settings › Display's Auto-brightness rows: shown only with a light sensor."""
    name, _ = light_source()
    st = autobright_status() if sv['autoBrightness'] else {}
    return {'capable': name is not None, 'source': name, 'on': sv['autoBrightness'], 'offset': sv['autoBrightnessOffset'],
            'paused': bool(st.get('paused')), 'lux': st.get('lux')}


def info(wmname=None, live=None):
    wmname = wmname or wm()
    live = live if live is not None else read(wmname)
    sv = saved()
    try:
        rc = _text(KWINRC, 'replace')
    except OSError:
