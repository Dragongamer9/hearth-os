def kde_read(name, group, key, default):
    """What KWin sees (the system files under yours, hearth_kconfig.effective), or DEFAULT."""
    try:
        import hearth_kconfig as kc
        vals, _, _ = kc.effective(name)
        return vals.get(group, {}).get(key, default)
    except Exception:  # noqa: BLE001 (an unreadable file: what KWin would use by default)
        return default


KWIN_SETTINGS = os.path.join(HERE, 'hearth-kwin-settings')


def kde_set(name, changes):
    """Change keys in KDE's file NAME through hearth-kwin-settings set (its one writer for Settings: only these keys,
    KDE's own lock, [$i] respected, a file that can't be read left alone; then KWin is told)."""
    try:
        r = subprocess.run([sys.executable, KWIN_SETTINGS, 'set', name], input=json.dumps(changes), capture_output=True,
                           text=True, timeout=20)
    except (OSError, subprocess.SubprocessError) as e:
