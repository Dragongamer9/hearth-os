        'mirror': {'capable': False, 'why': "KWin 6.3 can't mirror screens yet" if wmname == 'kwin' else NEEDS_KWIN},
        'iccProfiles': icc_profiles() if wmname == 'kwin' else [],
        'x11Scale': x11_scale_status(wmname),
        'barrier': barrier_status(wmname),
        'desktops': desktops_status(wmname, sv),
        'autoBrightness': auto_status(sv),
        'switch': switch_state(live),
    }


# ------------------------------------------------------------------ at Desktop Mode's start

def auto_scale(o):
    """The comfortable scale for a small sharp screen (handhelds, high-DPI laptops): what labwc's autostart did."""
    m = next((x for x in o.get('modes', []) if x.get('current')), None)
    mm = (o.get('physical_size') or {}).get('width') or 0
    if not o.get('enabled') or not m or mm <= 0:
        return None
    w = m['width'] if o.get('rotation', 'normal') in ('normal', 'inverted') else m['height']
    dpi = w / (mm / 25.4)
    s = 1.5 if dpi > 250 else 1.25 if dpi > 175 else 1.0
    return s if s != 1.0 else None


def restore_plan(live, sv, wmname):
    """What restore changes, and what it had to leave out (each with why)."""
    changes, left_out = {}, []
    outs = sv.get('outputs') or {}
    for o in live:
        e = outs.get(o['name'])
        if not e:
            s = auto_scale(o)
            if s and abs((o.get('scale') or 1) - 1) < 0.01:
                changes[o['name']] = {'scale': s}
            continue
        c = {}
        if 'enabled' in e and bool(e['enabled']) != bool(o.get('enabled')):
            c['enabled'] = bool(e['enabled'])
        if e.get('enabled', True) is not False:
            cur = next((x for x in o['modes'] if x.get('current')), None)
            if e.get('mode'):
                m = _mode_of(o, e['mode'])
                if not m:
                    left_out.append('%s: %s × %s at %s Hz (the screen doesn\'t list it now)' % (o['name'], e['mode'].get('w'), e['mode'].get('h'), round(float(e['mode'].get('r') or 0))))
                elif not cur or cur.get('id', (cur['width'], cur['height'], cur['refresh'])) != m.get('id', (m['width'], m['height'], m['refresh'])) \
                        or cur['width'] != m['width'] or cur['height'] != m['height'] or round(cur['refresh']) != round(m['refresh']):
                    c['mode'] = {'w': m['width'], 'h': m['height'], 'r': m['refresh']}
            if e.get('scale') and abs(float(e['scale']) - float(o.get('scale') or 1)) > 0.001:
                c['scale'] = float(e['scale'])
            if e.get('pos') is not None and (e['pos'].get('x'), e['pos'].get('y')) != ((o.get('position') or {}).get('x'), (o.get('position') or {}).get('y')):
                c['pos'] = e['pos']
            if e.get('rotation') and e['rotation'] != o.get('rotation', 'normal'):
                c['rotation'] = e['rotation']
            if wmname == 'kwin':
                if 'hdr' in e and o['hdr']['capable'] and bool(e['hdr']) != o['hdr']['on']:
                    c['hdr'] = bool(e['hdr'])
                if e.get('sdrBrightness') and o['hdr']['capable'] and int(e['sdrBrightness']) != (o.get('sdrBrightness') or 0):
                    c['sdrBrightness'] = int(e['sdrBrightness'])
                if 'wcg' in e and o['wcg']['capable'] and bool(e['wcg']) != o['wcg']['on']:
                    c['wcg'] = bool(e['wcg'])
                if e.get('vrr') and o['vrr']['capable'] and e['vrr'] != o['vrr']['policy']:
                    c['vrr'] = e['vrr']
                if 'icc' in e and o['icc']['capable'] and (e['icc'] or '') != (o['icc'].get('path') or ''):
                    if e['icc'] and e['icc'] != 'EDID' and not os.path.isfile(e['icc']):
                        left_out.append('%s: the colour profile %s (it isn\'t there any more)' % (o['name'], e['icc']))
                    else:
                        c['icc'] = e['icc']
                if e.get('priority') == 1 and o.get('priority') != 1:
                    c['priority'] = 1
                for k in ('overscan', 'rgbRange', 'sdrGamut', 'colorPower'):
                    if k in e and o.get(k, {}).get('capable') and e[k] != o[k]['value']:
                        c[k] = e[k]
                    elif k == 'sdrGamut' and k in e and c.get('hdr'):
                        c[k] = e[k]             # HDR comes on in the same change: its colour intensity with it
                if e.get('edr') and o['edr']['capable'] and e['edr'] != o['edr']['policy']:
                    c['edr'] = e['edr']
                cal, live_cal = e.get('hdrCal'), o.get('hdrCal') or {}
                if isinstance(cal, dict) and c.get('hdr') and any(v is not None for v in cal.values()):
                    c['hdrCal'] = cal
                elif isinstance(cal, dict) and live_cal.get('capable') and \
                        (cal.get('peak'), cal.get('avg'), cal.get('min')) != (live_cal.get('peakSet'), live_cal.get('avgSet'), live_cal.get('minSet')):
                    c['hdrCal'] = cal
        if c:
            changes[o['name']] = c
    # Never every screen off: a screen turned off there, with the one left on unplugged now.
    on = {o['name'] for o in live if o.get('enabled')}
    for n, c in changes.items():
        if 'enabled' in c:
            (on.add if c['enabled'] else on.discard)(n)
    if live and not on:
        for n, c in changes.items():
            c.pop('enabled', None)
        first = next((o for o in live), None)
        if first and not first.get('enabled'):
            changes.setdefault(first['name'], {})['enabled'] = True
        left_out.append('turning every screen off (the one that was left on isn\'t connected now)')
    return {k: v for k, v in changes.items() if v}, left_out


def restore():
    wmname = wm()
    live = read(wmname)
    sv = saved()
    changes, left_out = restore_plan(live, sv, wmname)
    problem = ''
    if changes:
        try:
            _, problem = apply({'outputs': changes}, wmname, live)
        except Refused as e:
            problem = str(e)
        if problem:
            # Try again without the modes: a screen at its own mode is better than settings left half done.
            no_modes = {n: {k: v for k, v in c.items() if k != 'mode'} for n, c in changes.items()}
            no_modes = {n: c for n, c in no_modes.items() if c}
            try:
                apply({'outputs': no_modes}, wmname)
            except Refused:
                pass
            left_out.append(problem)
    if left_out:
        io.notice('screens:' + '|'.join(left_out)[:200], 'Hearth left out some of your screen settings this time: %s. '
                  'They are still saved; Settings › Display shows what the screen is using.' % '; '.join(left_out), 'Hearth screens')
        io.log_event('Screens at start left out: %s' % '; '.join(left_out))
    if wmname == 'kwin':
        try:
            night()
        except (OSError, ValueError) as e:
            io.log_event('Night Light at start: %s' % e)
        if sv.get('tearing') is not None:
            tearing(bool(sv['tearing']))
        if sv.get('desktopsMainOnly'):
            try:
                main_desktops(True)
            except Exception as e:  # noqa: BLE001 (never in the way of Desktop Mode's start)
                io.log_event('Desktops only on the main screen at start: %s' % e)
    return {'wm': wmname, 'changed': changes, 'leftOut': left_out}


def autoscale():
    wmname = wm()
    live = read(wmname)
    changes = {}
    for o in live:
        s = auto_scale(o)
        if s and abs((o.get('scale') or 1) - 1) < 0.01:
            changes[o['name']] = {'scale': s}
    if changes:
        apply({'outputs': changes}, wmname, live)
    return {'changed': changes}


# ------------------------------------------------------------------ screenshots

def png(width, height, rgb):
    """RGB bytes (width*height*3) as a PNG file."""
    row = width * 3
    raw = b''.join(b'\0' + rgb[y * row:(y + 1) * row] for y in range(height))

    def chunk(t, d):
        return struct.pack('>I', len(d)) + t + d + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)
    return b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0)) + \
        chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b'')


def raw_to_rgb(data, width, height, stride, fmt):
    """KWin's raw picture (a QImage::Format) as packed RGB."""
    bpp = {4: 4, 5: 4, 6: 4, 16: 4, 17: 4, 18: 4, 20: 4, 21: 4, 22: 4, 23: 4, 25: 8, 26: 8, 27: 8}.get(fmt)
    if not bpp:
        raise Refused('KWin sent a picture format Hearth can\'t read yet (%d).' % fmt)
    rows = b''.join(data[y * stride:y * stride + width * bpp] for y in range(height)) if stride != width * bpp else data[:width * height * bpp]
    n = width * height
    out = bytearray(n * 3)
    if fmt in (4, 5, 6):            # 0xAARRGGBB in little-endian memory: B G R A
        out[0::3], out[1::3], out[2::3] = rows[2::4], rows[1::4], rows[0::4]
    elif fmt in (16, 17, 18):       # R G B A
        out[0::3], out[1::3], out[2::3] = rows[0::4], rows[1::4], rows[2::4]
    elif fmt in (25, 26, 27):       # 16 bits a channel, R G B A, little-endian: the high bytes
        out[0::3], out[1::3], out[2::3] = rows[1::8], rows[3::8], rows[5::8]
    else:                           # 10 bits a channel (20/21: BGR30, 22/23: RGB30)
        import array
        px = array.array('I')
        px.frombytes(rows[:n * 4])
        if sys.byteorder != 'little':
            px.byteswap()
        rs, bs = (20, 0) if fmt in (22, 23) else (0, 20)     # RGB30: A R G B from the top; BGR30: A B G R
        for i, v in enumerate(px):
            out[i * 3] = (v >> (rs + 2)) & 255
            out[i * 3 + 1] = (v >> 12) & 255
            out[i * 3 + 2] = (v >> (bs + 2)) & 255
    return bytes(out)


def parse_shot_args(argv):
    o = {'geometry': None, 'output': None, 'cursor': False, 'file': None, 'windowId': None}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == '--window' and i + 1 < len(argv):
            # One window by KWin's id (WinList's wid): Firehold's Everything open shows its picture.
            if not re.match(r'^\{?[0-9A-Fa-f-]{36}\}?$', argv[i + 1]):
                raise Refused('Not a window id: %s' % argv[i + 1])
            o['windowId'] = argv[i + 1]
            i += 2
            continue
        if a == '-g' and i + 1 < len(argv):
            m = re.match(r'^\s*(-?\d+),(-?\d+)\s+(\d+)x(\d+)\s*$', argv[i + 1])
            if not m:
                raise Refused('Not an area: %s (it\'s "X,Y WIDTHxHEIGHT", as slurp gives it)' % argv[i + 1])
            o['geometry'] = tuple(int(x) for x in m.groups())
            i += 2
            continue
        if a == '-o' and i + 1 < len(argv):
            o['output'] = argv[i + 1]
            i += 2
            continue
        if a == '-c':
            o['cursor'] = True
        elif a in ('-t',) and i + 1 < len(argv):
            i += 1                  # grim's -t png: PNG is all this writes
        elif not a.startswith('-') or a == '-':
            o['file'] = a
        i += 1
    if not o['file']:
        raise Refused('Where should the screenshot go? (a file, or - for the output)')
    return o


KWIN_CAST = os.environ.get('HEARTH_KWIN_CAST') or '/usr/libexec/hearth/hearth-kwin-cast'


def kwin_cast_args(o):
    """hearth-kwin-cast shot's arguments for a screenshot asked for with parse_shot_args / grab: at the screen's own
    resolution, with the pointer when asked."""
    if o.get('windowId'):
        a = ['window', o['windowId']]            # one window by KWin's id (Firehold's Everything open)
    elif o.get('window'):
        a = ['active-window']
    elif o['geometry']:
        x, y, gw, gh = o['geometry']
        a = ['area', str(int(x)), str(int(y)), str(int(gw)), str(int(gh))]
    elif o.get('activeScreen'):
        a = ['active-screen']
    elif o['output']:
        a = ['screen', str(o['output'])]
    else:
        a = ['workspace']
    return ['shot'] + a + ['1' if o['cursor'] else '0', '1']


def parse_cast_shot(out):
    """hearth-kwin-cast shot's output: 'W H STRIDE FORMAT SCALE' then the raw pixels → (w, h, stride, fmt, data)."""
    nl = out.find(b'\n')
    if nl < 0:
        raise Refused('KWin sent no picture.')
    try:
        wd, ht, st, fmt = (int(x) for x in out[:nl].split()[:4])
    except ValueError:
        raise Refused('KWin sent no picture.')
    data = out[nl + 1:]
    if wd <= 0 or ht <= 0 or st < wd * 4 or len(data) < st * (ht - 1) + wd:
        raise Refused('KWin sent only part of the picture.')
    return wd, ht, st, fmt, data


def kwin_shot(o):
    """A screenshot from KWin's org.kde.KWin.ScreenShot2, through hearth-kwin-cast (KWin answers only programs whose
    .desktop file lists that interface: hearth-kwin-cast.desktop names that small program, not a Python)."""
    if not os.access(KWIN_CAST, os.X_OK):
        raise Refused("Screenshots under KWin need Hearth's hearth-kwin-cast, which isn't installed here.")
    try:
        p = subprocess.run([KWIN_CAST] + kwin_cast_args(o), stdin=subprocess.DEVNULL, capture_output=True, timeout=45)
    except subprocess.TimeoutExpired:
        raise Refused("KWin didn't answer in time.")
    except OSError as e:
        raise Refused("Couldn't start hearth-kwin-cast: %s" % e)
    why = (p.stderr or b'').decode('utf-8', 'replace').strip().splitlines()
    why = why[-1] if why else ''
    if p.returncode == 4:
        raise NoWindow('There is no window to take a picture of.')
    if p.returncode == 2:
        raise Refused("KWin didn't let Hearth take a screenshot (hearth-kwin-cast.desktop isn't installed?): %s" % why)
    if p.returncode == 3:
        raise Refused("hearth-kwin-cast takes screenshots only for Hearth's own hearth-screens (installed by root): %s" % why)
    if p.returncode != 0:
        raise Refused("KWin couldn't take the screenshot: %s" % (why or 'exit %d' % p.returncode))
    wd, ht, st, fmt, data = parse_cast_shot(p.stdout)
    return png(wd, ht, raw_to_rgb(data, wd, ht, st, fmt))


def _write(data, out):
    if out == '-':
        sys.stdout.buffer.write(data)
        sys.stdout.buffer.flush()
    else:
        with open(out, 'wb') as f:
            f.write(data)


def shot(argv):
    if wm() != 'kwin':
        os.execvp('grim', ['grim'] + argv)
    o = parse_shot_args(argv)
    _write(kwin_shot(o), o['file'])


def parse_grab_args(argv):
    """grab MODE [--screen N] [--geometry X,Y,W,H] [--pointer] --out FILE (Capture's way of asking)."""
    if not argv or argv[0] not in ('screen', 'all', 'window', 'area'):
        raise Refused('grab what? screen, all, window or area')
    o = {'mode': argv[0], 'screen': None, 'geometry': None, 'cursor': False, 'out': None}
    i = 1
    while i < len(argv):
        a = argv[i]
        v = argv[i + 1] if i + 1 < len(argv) else None
        if a == '--screen' and v is not None:
            o['screen'] = v
            i += 2
        elif a == '--geometry' and v is not None:
            m = re.match(r'^\s*(-?\d+)\s*,\s*(-?\d+)\s*,\s*(\d+)\s*,\s*(\d+)\s*$', v)
            if not m or int(m.group(3)) == 0 or int(m.group(4)) == 0:
                raise Refused('Not an area: %s (it\'s X,Y,WIDTH,HEIGHT)' % v)
            o['geometry'] = tuple(int(x) for x in m.groups())
            i += 2
        elif a == '--out' and v is not None:
            o['out'] = v
            i += 2
        elif a == '--pointer':
            o['cursor'] = True
            i += 1
        else:
            raise Refused('Unknown option %s' % a)
    if not o['out']:
        raise Refused('Where should the picture go? (--out FILE, or --out - for the output)')
    if o['mode'] == 'area' and not o['geometry']:
        raise Refused('An area needs --geometry X,Y,WIDTH,HEIGHT')
    return o


def screen_name(want, outs):
    """--screen: a screen's name, or its number among the screens that are on (1 = the first; 0 counts as the first too)."""
    on = [o['name'] for o in outs if o.get('enabled')]
    if want in on:
        return want
    try:
        n = int(want)
    except (TypeError, ValueError):
        raise Refused('There is no screen called %s.' % want)
    n = n - 1 if n >= 1 else 0
    if n >= len(on):
        raise Refused('There is no screen %s (there are %d).' % (want, len(on)))
    return on[n]


def grim_args(o, outs):
    """The grim command for a grab under labwc."""
    a = ['grim']
    if o['cursor']:
        a.append('-c')
    if o['mode'] == 'area' or (o['mode'] == 'window' and o['geometry']):
        x, y, w, h = o['geometry']
        a += ['-g', '%d,%d %dx%d' % (x, y, w, h)]
    elif o['mode'] == 'window':
        # labwc tells no program which window is active: Capture gives its place (--geometry) or gets exit 3.
        raise NoWindow("labwc can't say which window is active; give the window's place with --geometry.")
    elif o['mode'] == 'screen':
        name = screen_name(o['screen'], outs) if o['screen'] is not None else next((x['name'] for x in outs if x.get('enabled')), None)
        if name:
            a += ['-o', name]
    return a + [o['out']]


def grab(argv):
    o = parse_grab_args(argv)
    if wm() != 'kwin':
        cmd = grim_args(o, read('labwc') if o['mode'] == 'screen' else [])
        os.execvp(cmd[0], cmd)
    k = {'geometry': None, 'output': None, 'cursor': o['cursor'], 'file': o['out']}
    if o['mode'] == 'window':
        if o['geometry']:
            k['geometry'] = o['geometry']
        else:
            k['window'] = True
    elif o['mode'] == 'area':
        k['geometry'] = o['geometry']
    elif o['mode'] == 'screen':
        if o['screen'] is not None:
            k['output'] = screen_name(o['screen'], read('kwin'))
        else:
            k['activeScreen'] = True
    _write(kwin_shot(k), o['out'])


