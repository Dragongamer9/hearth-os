#!/usr/bin/python3
"""hearth-mime: Hearth Settings › Apps › File types (1.14, KDE's File Associations editor), as you (no root). Every kind
of file an installed app says it opens, with its name, its endings (*.png), the app it opens in and the others that
can; pick another app for one kind, put it back, or teach it a new ending. Reuses Default apps' readers and writers
(hearth-files' desktop entries and mimeapps.list, hearth-system's mimeapps_with / mimeapps_without: every other line of
your mimeapps.list kept as it was, atomic writes). Your own endings are in ~/.local/share/mime/packages/hearth-user.xml
(the shared MIME database's own place for them), made again with update-mime-database.

  hearth-mime types                 JSON: {types: [{mime, name, group, globs, current, yours, apps: [{id, name}]}]}
  hearth-mime set MIME APP_ID       open this kind in APP_ID (~/.config/mimeapps.list)
  hearth-mime reset MIME            your choice for this kind taken out (the system's default applies again)
  hearth-mime add-glob MIME PATTERN a new ending for this kind (like *.foo)
  hearth-mime remove-glob MIME PATTERN  one you added taken out
Output: one JSON line; failures print "error: ..." and exit 1.
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
from xml.sax.saxutils import escape, quoteattr

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
MIME_RE = re.compile(r'^[a-z0-9][a-z0-9.+-]{0,60}/[A-Za-z0-9][A-Za-z0-9.+_-]{0,120}$')
ID_RE = re.compile(r'^[A-Za-z0-9_.+-]{1,200}\.desktop$')
GLOB_RE = re.compile(r'^\*\.[A-Za-z0-9_+-][A-Za-z0-9_.+-]{0,30}$')
GROUPS = {'image': 'Pictures', 'video': 'Videos', 'audio': 'Music and sound', 'text': 'Text and code',
          'font': 'Fonts', 'inode': 'Folders', 'x-scheme-handler': 'Links', 'application': 'Documents and other files',
          'model': '3D models', 'message': 'Mail', 'multipart': 'Mail', 'chemical': 'Science'}


class Fail(Exception):
    pass


def load(name, file):
    loader = importlib.machinery.SourceFileLoader(name, os.path.join(HERE, file))
    spec = importlib.util.spec_from_loader(name, loader)
    m = importlib.util.module_from_spec(spec)
    loader.exec_module(m)
    return m


def helpers():
    hs = load('hearth_system', 'hearth-system')
    return hs, hs.load_files_helper()


def data_home():
    return os.environ.get('XDG_DATA_HOME') or os.path.join(os.path.expanduser('~'), '.local', 'share')


def user_xml():
    return os.path.join(data_home(), 'mime', 'packages', 'hearth-user.xml')


def read(path):
    try:
        with open(path, encoding='utf-8', errors='replace') as f:
            return f.read()
    except OSError:
        return ''


def globs(hf):
    """{mime: [patterns]} from every globs2 (yours first)."""
    out = {}
    for d in hf.data_dirs():
        for line in read(os.path.join(d, 'mime', 'globs2')).splitlines():
            if line.startswith('#'):
                continue
            f = line.split(':')
            if len(f) >= 3 and f[2] not in out.setdefault(f[1], []):
                out[f[1]].append(f[2])
    return out


def own_globs():
    """{mime: [patterns]} you added (hearth-user.xml)."""
    out = {}
    for m in re.finditer(r'<mime-type type="([^"]+)">(.*?)</mime-type>', read(user_xml()), re.S):
        out[m.group(1)] = re.findall(r'<glob pattern="([^"]+)"', m.group(2))
    return out


def name_of(fields):
    return fields.get('Name') or ''


def types(hs=None, hf=None):
    if hs is None:
        hs, hf = helpers()
    entries = hf.desktop_entries()
    ok = {d: f for d, (_, f) in entries.items() if hf.usable(f)}
    by_mime = {}
    for did, f in sorted(ok.items(), key=lambda x: name_of(x[1]).lower()):
        for m in [x.strip() for x in f.get('MimeType', '').split(';') if x.strip()]:
            if MIME_RE.match(m):
                by_mime.setdefault(m, []).append(did)
    mine = {}
    for p in hs.user_lists(hf):
        text = read(p)
        for m in by_mime:
            if m not in mine:
                ids = [d for d in hs.ml_read(text, m) if d in ok] if text else []
                if ids:
                    mine[m] = ids[0]
    gl, own = globs(hf), own_globs()
    out = []
    for m in sorted(by_mime):
        if m.startswith('x-scheme-handler/') or m.startswith('inode/'):
            continue                          # links and folders are on Default apps
        cur = mine.get(m)
        if not cur:
            dflt, added, removed = hf.mimeapps(m)
            cur = next((d for d in dflt + added if d in ok and d not in removed), None) or by_mime[m][0]
        apps = by_mime[m] if cur in by_mime[m] else [cur] + by_mime[m]
        out.append({'mime': m, 'name': hf.mime_comment(m) or m, 'group': GROUPS.get(m.split('/')[0], 'Other'),
                    'globs': gl.get(m, [])[:8], 'ownGlobs': own.get(m, []), 'current': cur,
                    'currentName': name_of(ok.get(cur, {})) or cur, 'yours': m in mine,
                    'apps': [{'id': d, 'name': name_of(ok.get(d, {})) or d} for d in apps if d in ok]})
    return {'types': out}


def check(mime, app=None):
    if not MIME_RE.match(mime or ''):
        raise Fail('not a kind of file')
    if app is not None and not ID_RE.match(app or ''):
        raise Fail('not an app')


def set_default(mime, app, hs=None, hf=None):
    check(mime, app)
    if hs is None:
        hs, hf = helpers()
    entries = hf.desktop_entries()
    if app not in entries or not hf.usable(entries[app][1]):
        raise Fail("that app isn't installed")
    path = os.path.join(hs.config_dir(), 'mimeapps.list')
    hs.write_atomic(path, hs.mimeapps_with(hs.read(path), [mime], app))
    return {'ok': True, 'mime': mime, 'current': app}


def reset(mime, hs=None, hf=None):
    check(mime)
    if hs is None:
        hs, hf = helpers()
    changed = []
    for p in hs.user_lists(hf):
        if os.path.exists(p):
            text = hs.read(p)
            new = hs.mimeapps_without(text, [mime])
            if new != text:
                hs.write_atomic(p, new)
                changed.append(p)
    return {'ok': True, 'changed': changed}


def xml_for(table):
    parts = ['<?xml version="1.0" encoding="UTF-8"?>',
             '<!-- Endings you added in Hearth Settings › Apps › File types. -->',
             '<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">']
    for m in sorted(table):
        if table[m]:
            parts.append('  <mime-type type=%s>' % quoteattr(m))
            parts += ['    <glob pattern=%s/>' % quoteattr(g) for g in table[m]]
            parts.append('  </mime-type>')
    parts.append('</mime-info>')
    return '\n'.join(parts) + '\n'


def write_globs(table):
    import hearth_settings_io as hsio
    path = user_xml()
    hsio.write_text(path, xml_for(table))
    if shutil.which('update-mime-database'):
        subprocess.run(['update-mime-database', os.path.join(data_home(), 'mime')], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=60)


def add_glob(mime, pattern):
    check(mime)
    if not GLOB_RE.match(pattern or ''):
        raise Fail('an ending looks like *.abc')
    t = own_globs()
    if pattern not in t.setdefault(mime, []):
        t[mime].append(pattern)
        write_globs(t)
    return {'ok': True}


def remove_glob(mime, pattern):
    check(mime)
    t = own_globs()
    if pattern not in t.get(mime, []):
        raise Fail("that ending isn't one you added")
    t[mime].remove(pattern)
    write_globs(t)
    return {'ok': True}


def main(argv):
    try:
        if argv[:1] == ['types']:
            r = types()
        elif argv[:1] == ['set'] and len(argv) == 3:
            r = set_default(argv[1], argv[2])
        elif argv[:1] == ['reset'] and len(argv) == 2:
            r = reset(argv[1])
        elif argv[:1] == ['add-glob'] and len(argv) == 3:
            r = add_glob(argv[1], argv[2])
        elif argv[:1] == ['remove-glob'] and len(argv) == 3:
            r = remove_glob(argv[1], argv[2])
        else:
            print(__doc__)
            return 2
    except Fail as e:
        print('error: ' + str(e))
        return 1
    print(json.dumps(r))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
