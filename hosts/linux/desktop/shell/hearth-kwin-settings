def get_all_files():
    files, mine, locked, bad = {}, {}, {}, {}
    for n in FILES:
        try:
            files[n], mine[n], locked[n] = kc.effective(n)
        except kc.BadFile as e:
            bad[n] = str(e)
            files[n], mine[n], locked[n] = {}, {}, {}
    return {'files': files, 'mine': mine, 'locked': locked, 'bad': bad}


NESTED = {'Tiling', 'ButtonRebinds'}     # groups whose subgroups the pages change ([Tiling][<screen>])


def allowed(name, group):
    if name not in ALLOWED:
        return False
    if '][' in group:
        return group.split('][')[0] in NESTED and group.split('][')[0] in ALLOWED[name]
    return group in ALLOWED[name]


def set_file(name, raw):
    try:
        changes = json.loads(raw or 'null')
    except ValueError:
        raise Fail('expected JSON on stdin')
    if name not in FILES or not isinstance(changes, dict):
        raise Fail('expected FILE (%s) and {group: {key: value}}' % ', '.join(FILES))
    for g in changes:
        if not allowed(name, g):
            raise Fail('[%s] in %s is not a setting Hearth changes' % (g, name))
    _, _, locked = kc.effective(name)
    for g, kv in changes.items():
        for k in kv:
            if k in locked.get(g, []):
                raise Fail('%s is locked by the system (%s [%s])' % (k, name, g))
    write_changes(name, changes)
    out = get_all_files()
    out['reloaded'] = reconfigure() if name in ('kwinrc', 'kwinrulesrc') else kwin_running()
    return out


def write_changes(name, changes, remove_groups=()):
    try:
        changed = kc.update(kc.user_path(name), changes, remove_groups)
    except kc.BadFile as e:
        hsio.notice('kwin-bad:%s' % name, "Your %s couldn't be read, so Hearth didn't change it (%s). Nothing was "
                    'lost: the file is as it was.' % (name, e))
        raise Fail("Your %s couldn't be read, so it wasn't changed: %s" % (name, e))
    if changed:
        notify_changed(name, changes)
    return changed


