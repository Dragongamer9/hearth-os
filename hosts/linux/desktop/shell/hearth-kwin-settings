def data_dirs():
    home = os.environ.get('XDG_DATA_HOME') or os.path.join(os.path.expanduser('~'), '.local', 'share')
    return [home] + [d for d in (os.environ.get('XDG_DATA_DIRS') or '/usr/local/share:/usr/share').split(':') if d]


def switchers():
    """Window switcher looks KWin can show (thumbnail_grid is built in; others are packages)."""
    out = {'thumbnail_grid': 'Thumbnail grid'}
    for d in data_dirs():
        for sub in ('kwin-wayland/tabbox', 'kwin/tabbox', 'plasma/look-and-feel'):
            for p in glob.glob(os.path.join(d, sub, '*')):
                n = os.path.basename(p)
                if sub.endswith('look-and-feel'):
                    continue
                if os.path.isdir(p) and n not in out:
                    out[n] = _package_name(p) or n
    return [{'id': k, 'label': v, 'hearth': k.startswith('org.hearth')} for k, v in out.items()]


def _package_name(p):
    try:
        with open(os.path.join(p, 'metadata.json')) as f:
            return (json.load(f).get('KPlugin') or {}).get('Name') or ''
    except (OSError, ValueError):
        return ''


