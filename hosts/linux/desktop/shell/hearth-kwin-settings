# ------------------------------------------------------------------ D-Bus (GLib's, python3-gi; gdbus as a fallback)
_BUS = []


def bus():
    if _BUS:
        return _BUS[0]
    conn = None
    try:
        from gi.repository import Gio
        conn = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    except Exception:
        conn = None
    _BUS.append(conn)
    return conn


def call(dest, path, iface, method, sig=None, args=(), reply=None, timeout=4000):
    """A D-Bus method call; the reply unpacked to Python, or raises Fail."""
    conn = bus()
    if conn is None:
        raise Fail('no session bus')
    from gi.repository import GLib, Gio
    try:
        params = GLib.Variant(sig, tuple(args)) if sig else None
        r = conn.call_sync(dest, path, iface, method, params,
                           GLib.VariantType(reply) if reply else None, Gio.DBusCallFlags.NONE, timeout, None)
    except Exception as e:
        raise Fail(str(e).split(':')[-1].strip() or 'D-Bus call failed')
    return r.unpack() if r is not None else None


def get_prop(dest, path, iface, name):
    return call(dest, path, 'org.freedesktop.DBus.Properties', 'Get', '(ss)', (iface, name))[0]


def get_all(dest, path, iface):
    return call(dest, path, 'org.freedesktop.DBus.Properties', 'GetAll', '(s)', (iface,))[0]


def set_prop(dest, path, iface, name, sig, value):
    from gi.repository import GLib
    conn = bus()
    if conn is None:
        raise Fail('no session bus')
    try:
        conn.call_sync(dest, path, 'org.freedesktop.DBus.Properties', 'Set',
                       GLib.Variant('(ssv)', (iface, name, GLib.Variant(sig, value))), None, 0, 4000, None)
    except Exception as e:
        raise Fail(str(e).split(':')[-1].strip() or 'D-Bus call failed')


def kwin_running():
    if fixture() is not None:
        return False
    try:
        return bool(call('org.freedesktop.DBus', '/org/freedesktop/DBus', 'org.freedesktop.DBus', 'NameHasOwner',
                         '(s)', ('org.kde.KWin',))[0])
    except Fail:
        return False


def on_kwin():
    """Mantel runs on KWin (the session exports HEARTH_WM=kwin), or the test preview."""
    return os.environ.get('HEARTH_WM') == 'kwin' or fixture() is not None


def notify_changed(name, changes):
    """KDE's "this config changed" signal (what kwriteconfig6 --notify sends): KWin's watchers (sticky keys, the bell,
    button rebinds, animation speed) take the new values at once."""
    conn = bus()
    if conn is None or not changes:
        return
    try:
        from gi.repository import GLib
        payload = {g.replace('][', '\x1d'): [k.encode() for k in kv] for g, kv in changes.items()}
        conn.emit_signal(None, '/' + name, 'org.kde.kconfig.notify', 'ConfigChanged',
                         GLib.Variant('(a{saay})', (payload,)))
        conn.flush_sync(None)
    except Exception as e:
        hsio.log_event('kwin: config-changed signal not sent: %s' % e)


def reconfigure():
    if not kwin_running():
        return False
    try:
        call('org.kde.KWin', '/KWin', 'org.kde.KWin', 'reconfigure')
        return True
    except Fail as e:
        hsio.log_event('kwin: reconfigure failed: %s' % e)
        return False


def kwin_version():
    if not shutil.which('kwin_wayland'):
        return ''
    try:
        out = subprocess.run(['kwin_wayland', '--version'], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ''
    m = re.search(r'(\d+\.\d+(\.\d+)?)', out or '')
    return m.group(1) if m else ''


