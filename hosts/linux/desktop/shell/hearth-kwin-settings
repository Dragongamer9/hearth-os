VDM = ('org.kde.KWin', '/VirtualDesktopManager', 'org.kde.KWin.VirtualDesktopManager')


def desktops():
    fx = fixture()
    if kwin_running():
        try:
            ds = get_prop(*VDM, 'desktops')
            rows = get_prop(*VDM, 'rows')
            cur = get_prop(*VDM, 'current')
            return {'desktops': [{'id': d[1], 'name': d[2]} for d in sorted(ds, key=lambda d: d[0])], 'rows': rows,
                    'current': cur, 'live': True}
        except Fail:
            pass
    vals, _, _ = kc.effective('kwinrc')
    g = vals.get('Desktops', {})
    try:
        n = max(1, int(g.get('Number', (fx or {}).get('desktops', 1))))
    except ValueError:
        n = 1
    out = []
    for i in range(1, n + 1):
        out.append({'id': g.get('Id_%d' % i, ''), 'name': g.get('Name_%d' % i, 'Desktop %d' % i)})
    try:
        rows = int(g.get('Rows', 2))
    except ValueError:
        rows = 2
    return {'desktops': out, 'rows': rows, 'current': out[0]['id'] if out else '', 'live': False}


def desktops_set(raw):
    try:
        req = json.loads(raw or 'null')
    except ValueError:
        raise Fail('expected JSON on stdin')
    if not isinstance(req, dict):
        raise Fail('expected {"count": n, "names": {...}, "rows": n}')
    cur = desktops()
    count = req.get('count')
    if count is not None and (not isinstance(count, int) or not 1 <= count <= 20):
        raise Fail('1 to 20 desktops')
    rows = req.get('rows')
    if rows is not None and (not isinstance(rows, int) or not 1 <= rows <= 4):
        raise Fail('1 to 4 rows')
    names = req.get('names') or {}
    if not isinstance(names, dict) or any(not isinstance(v, str) or len(v) > 60 or '\n' in v for v in names.values()):
        raise Fail('names: {id or position: name}')
    if cur['live']:
        ds = cur['desktops']
        if count is not None:
            while len(ds) < count:
                call(*VDM, 'createDesktop', '(us)', (len(ds), 'Desktop %d' % (len(ds) + 1)))
                ds = desktops()['desktops']
            while len(ds) > count:
                call(*VDM, 'removeDesktop', '(s)', (ds[-1]['id'],))
                ds = desktops()['desktops']
        for k, v in names.items():
            d = next((d for d in ds if d['id'] == k), None) or (ds[int(k) - 1] if k.isdigit() and 0 < int(k) <= len(ds) else None)
            if d:
                call(*VDM, 'setDesktopName', '(ss)', (d['id'], v.strip() or d['name']))
        if rows is not None:
            set_prop(*VDM, 'rows', 'u', rows)
        return desktops()
    # KWin isn't running: its file, the way KWin writes it (it reads Number, Name_N, Id_N and Rows at start).
    ch = {}
    n = len(cur['desktops'])
    if count is not None and count != n:
        ch['Number'] = count
        for i in range(n + 1, count + 1):
            ch['Id_%d' % i] = str(uuid.uuid4())
        for i in range(count + 1, n + 1):
            ch['Id_%d' % i] = None
            ch['Name_%d' % i] = None
    for k, v in names.items():
        pos = int(k) if k.isdigit() else next((i + 1 for i, d in enumerate(cur['desktops']) if d['id'] == k), 0)
        if pos:
            ch['Name_%d' % pos] = v.strip() or 'Desktop %d' % pos
    if rows is not None:
        ch['Rows'] = rows
    if ch:
        write_changes('kwinrc', {'Desktops': ch})
    return desktops()


# ------------------------------------------------------------------ screens and tile layouts
_KWIN_NS = uuid.uuid5(uuid.NAMESPACE_URL, 'https://kwin.kde.org/o/')


def output_uuid(name, eisa, model, serial):
    """KWin's id for a screen (core/output.cpp generateOutputId): its tile layout is kept under [Tiling][<this>]."""
    return str(uuid.uuid5(_KWIN_NS, ':'.join([name, eisa, model, serial])))


def edid_ids(edid):
    """(eisaId, model, serial) the way KWin reads them with libdisplay-info."""
    if len(edid) < 128 or edid[:8] != b'\x00\xff\xff\xff\xff\xff\xff\x00':
        return '', '', ''
    v = (edid[8] << 8) | edid[9]
    eisa = ''.join(chr(((v >> s) & 0x1f) + ord('A') - 1) for s in (10, 5, 0))
    product = edid[10] | (edid[11] << 8)
    serial_num = edid[12] | (edid[13] << 8) | (edid[14] << 16) | (edid[15] << 24)
    name = serial = ''
    for off in (54, 72, 90, 108):
        d = edid[off:off + 18]
        if d[0:3] == b'\x00\x00\x00':
            text = d[5:18].split(b'\n')[0].decode('latin-1').rstrip()
            if d[3] == 0xfc:
                name = text
            elif d[3] == 0xff:
                serial = text
    model = name or '0x%04X' % product
    if not serial and serial_num:
        serial = '0x%08X' % serial_num
    return eisa, model, serial


def outputs():
    fx = fixture()
    if fx is not None:
        return {'outputs': fx.get('outputs', [])}
    out = []
    for p in sorted(glob.glob('/sys/class/drm/card*-*')):
        try:
            with open(os.path.join(p, 'status')) as f:
                if f.read().strip() != 'connected':
                    continue
            with open(os.path.join(p, 'edid'), 'rb') as f:
                edid = f.read()
        except OSError:
            continue
        name = re.sub(r'^card\d+-', '', os.path.basename(p))
        eisa, model, serial = edid_ids(edid)
        out.append({'name': name, 'uuid': output_uuid(name, eisa, model, serial), 'model': model, 'maker': eisa})
    # Layouts KWin already keeps for screens that aren't here now.
    vals, _, _ = kc.effective('kwinrc')
    known = {o['uuid'] for o in out}
    for g in vals:
        if g.startswith('Tiling][') and g[8:] not in known:
            out.append({'name': '', 'uuid': g[8:], 'model': 'A screen that isn\'t connected', 'maker': '', 'away': True})
    return {'outputs': out}


def layout_to_kwin(layout):
    """Hearth's editor's columns (widths, each split into rows) as KWin's tiles JSON."""
    cols = layout.get('columns') if isinstance(layout, dict) else None
    if not isinstance(cols, list) or not 1 <= len(cols) <= 8:
        raise Fail('1 to 8 columns')
    widths = [float(c.get('width') or 0) for c in cols]
    if any(w <= 0.04 for w in widths):
        raise Fail('every column needs some width')
    total = sum(widths)
    tiles = []
    for c, w in zip(cols, widths):
        t = {'width': round(w / total, 4)}
        rows = c.get('rows') or []
        if not isinstance(rows, list) or len(rows) > 6:
            raise Fail('at most 6 rows in a column')
        if len(rows) > 1:
            hs = [float(h or 0) for h in rows]
            if any(h <= 0.04 for h in hs):
                raise Fail('every row needs some height')
            th = sum(hs)
            t['layoutDirection'] = 'vertical'
            t['tiles'] = [{'height': round(h / th, 4)} for h in hs]
        tiles.append(t)
    return {'layoutDirection': 'horizontal', 'tiles': tiles}


def kwin_to_layout(text):
    try:
        d = json.loads(text)
    except (ValueError, TypeError):
        return None
    if not isinstance(d, dict) or d.get('layoutDirection') != 'horizontal' or not isinstance(d.get('tiles'), list):
        return None
    cols = []
    for t in d['tiles']:
        if not isinstance(t, dict):
            return None
        rows = []
        if t.get('layoutDirection') == 'vertical' and isinstance(t.get('tiles'), list):
            rows = [float(x.get('height') or 0) for x in t['tiles'] if isinstance(x, dict)]
            if any(isinstance(x, dict) and x.get('tiles') for x in t['tiles']):
                return None     # deeper than Hearth's editor draws: shown as "made in KWin's editor"
        elif t.get('tiles'):
            return None
        cols.append({'width': float(t.get('width') or 0), 'rows': rows})
    return {'columns': cols}


TILE_SCRIPT = r'''
// Hearth Settings › Tiling: puts this layout on screen %(name)s now (KWin also reads it from kwinrc when it starts).
(function () {
    var layout = %(layout)s;
    var tm = workspace.tilingForScreen(%(name)s);
    if (!tm) return;
    var root = tm.rootTile;
    var kids = root.tiles.slice();
    for (var i = kids.length - 1; i >= 0; i--) kids[i].remove();
    var x = 0, cols = [];
    var first = root.split(1);           // two columns
    cols.push(first[0]);
    if (layout.tiles.length > 1) cols.push(first[1]); else first[1].remove();
    while (cols.length < layout.tiles.length) cols.push(cols[cols.length - 1].split(1)[1]);
    for (var c = 0; c < cols.length; c++) {
        var w = layout.tiles[c].width;
        cols[c].relativeGeometry = {x: x, y: 0, width: w, height: 1};
        x += w;
    }
    for (var c = 0; c < cols.length; c++) {
        var t = layout.tiles[c];
        if (!t.tiles || t.tiles.length < 2) continue;
        var rows = cols[c].split(2);
        var list = [rows[0], rows[1]];
        while (list.length < t.tiles.length) list.push(list[list.length - 1].split(2)[1]);
        var y = 0, g = cols[c].relativeGeometry;
        for (var r = 0; r < list.length; r++) {
            list[r].relativeGeometry = {x: g.x, y: y, width: g.width, height: t.tiles[r].height};
            y += t.tiles[r].height;
        }
    }
    if (%(padding)s >= 0) root.padding = %(padding)s;
})();
'''


def run_script(name, text):
    """Runs a small KWin script once (org.kde.KWin /Scripting), then unloads it."""
    d = os.path.join(runtime_dir(), 'hearth-kwin')
    os.makedirs(d, exist_ok=True)
    path = os.path.join(d, name + '.js')
    hsio.write_text(path, text)
    plugin = 'hearth-' + name
    try:
        try:
            call('org.kde.KWin', '/Scripting', 'org.kde.kwin.Scripting', 'unloadScript', '(s)', (plugin,))
        except Fail:
            pass
        sid = call('org.kde.KWin', '/Scripting', 'org.kde.kwin.Scripting', 'loadScript', '(ss)', (path, plugin))[0]
        if sid < 0:
            raise Fail('KWin didn\'t load the script')
        call('org.kde.KWin', '/Scripting/Script%d' % sid, 'org.kde.kwin.Script', 'run')
        return True
    finally:
        try:
            call('org.kde.KWin', '/Scripting', 'org.kde.kwin.Scripting', 'unloadScript', '(s)', (plugin,))
        except Fail:
            pass


def tiles_set(out_uuid, out_name, raw):
    try:
        req = json.loads(raw or 'null')
    except ValueError:
        raise Fail('expected JSON on stdin')
    if not re.match(r'^[0-9a-f-]{36}$', out_uuid or ''):
        raise Fail('a screen id')
    ch = {}
    group = {}
    if isinstance(req, dict) and 'columns' in req:
        kw = layout_to_kwin(req)
        ch['Tiling][' + out_uuid] = {'tiles': json.dumps(kw, separators=(',', ':'))}
    else:
        kw = None
    pad = req.get('padding') if isinstance(req, dict) else None
    if pad is not None:
        if not isinstance(pad, (int, float)) or not 0 <= pad <= 64:
            raise Fail('padding 0 to 64')
        group['padding'] = int(pad)
        ch['Tiling'] = group
    if not ch:
        raise Fail('nothing to change')
    write_changes('kwinrc', ch)
    live = False
    if kwin_running() and kw and out_name:
        try:
            run_script('tiles', TILE_SCRIPT % {'name': json.dumps(out_name), 'layout': json.dumps(kw),
                                               'padding': int(pad) if pad is not None else -1})
            live = True
        except (Fail, OSError) as e:
            hsio.log_event('kwin: tile layout not put on the screen now: %s' % e)
    return {'ok': True, 'live': live}


# ------------------------------------------------------------------ window rules
RULE_KEYS = {
    # key: kind
    'Description': 's', 'Enabled': 'b', 'wmclass': 's', 'wmclassmatch': 'i', 'wmclasscomplete': 'b', 'title': 's',
    'titlematch': 'i', 'types': 'i', 'position': 's', 'positionrule': 'i', 'size': 's', 'sizerule': 'i',
    'desktops': 's', 'desktopsrule': 'i', 'screen': 'i', 'screenrule': 'i', 'above': 'b', 'aboverule': 'i',
    'below': 'b', 'belowrule': 'i', 'noborder': 'b', 'noborderrule': 'i', 'minimize': 'b', 'minimizerule': 'i',
    'maximizehoriz': 'b', 'maximizehorizrule': 'i', 'maximizevert': 'b', 'maximizevertrule': 'i',
    'fullscreen': 'b', 'fullscreenrule': 'i', 'skiptaskbar': 'b', 'skiptaskbarrule': 'i', 'skipswitcher': 'b',
    'skipswitcherrule': 'i', 'opacityactive': 'i', 'opacityactiverule': 'i', 'opacityinactive': 'i',
    'opacityinactiverule': 'i', 'tearing': 'b', 'tearingrule': 'i', 'adaptivesync': 'b', 'adaptivesyncrule': 'i',
    'acceptfocus': 'b', 'acceptfocusrule': 'i', 'placement': 'i', 'placementrule': 'i', 'layer': 's',
    'layerrule': 'i', 'blockcompositing': 'b', 'blockcompositingrule': 'i', 'closeable': 'b', 'closeablerule': 'i',
}
RULE_ID = re.compile(r'^[0-9a-f-]{8,40}$')


def rules():
    vals, _, _ = kc.effective('kwinrulesrc')
    general = vals.get('General', {})
    ids = [x for x in (general.get('rules') or '').split(',') if x]
    if not ids:
        try:
            ids = [str(i) for i in range(1, int(general.get('count') or 0) + 1)]
        except ValueError:
            ids = []
    out = []
    for rid in ids:
        g = vals.get(rid)
        if g is None:
            continue
        out.append({'id': rid, 'values': {k: v for k, v in g.items() if k in RULE_KEYS},
                    'other': sorted(k for k in g if k not in RULE_KEYS)})
    return {'rules': out}


def _check_rule_value(k, v):
    if v is None:
        return None
    kind = RULE_KEYS.get(k)
    if kind is None:
        raise Fail('%s is not a rule Hearth edits' % k)
    if kind == 'b' and not isinstance(v, bool):
        raise Fail('%s: on or off' % k)
    if kind == 'i' and (not isinstance(v, int) or isinstance(v, bool) or not -1 <= v <= 1 << 20):
        raise Fail('%s: a number' % k)
    if kind == 's' and (not isinstance(v, str) or len(v) > 400 or '\n' in v):
        raise Fail('%s: text on one line' % k)
    if k in ('position', 'size') and v and not re.match(r'^-?\d{1,5},-?\d{1,5}$', v):
        raise Fail('%s: two numbers, "x,y"' % k)
    if k.endswith('rule') and not 0 <= v <= 6:
        raise Fail('%s: 0 to 6' % k)
    if k.endswith('match') and not 0 <= v <= 3:
        raise Fail('%s: 0 to 3' % k)
    return v


def rule_set(raw):
    try:
        req = json.loads(raw or 'null')
    except ValueError:
        raise Fail('expected JSON on stdin')
    if not isinstance(req, dict) or not isinstance(req.get('set'), dict):
        raise Fail('expected {"id": "...", "set": {key: value}}')
    rid = req.get('id') or ''
    sets = {k: _check_rule_value(k, v) for k, v in req['set'].items()}
    cur = rules()['rules']
    ids = [r['id'] for r in cur]
    ch = {}
    if not rid:
        rid = str(uuid.uuid4())
        ids.append(rid)
        sets.setdefault('Description', 'Window rule')
        ch['General'] = {'count': len(ids), 'rules': ','.join(ids)}
    elif not RULE_ID.match(rid) and not rid.isdigit():
        raise Fail('a rule id')
    elif rid not in ids:
        raise Fail('that rule is gone (changed somewhere else?)')
    ch[rid] = sets
    write_changes('kwinrulesrc', ch)
    reconfigure()
    return dict(rules(), id=rid)


def rule_delete(rid):
    cur = rules()['rules']
    ids = [r['id'] for r in cur]
    if rid not in ids:
        raise Fail('that rule is gone')
    ids.remove(rid)
    write_changes('kwinrulesrc', {'General': {'count': len(ids), 'rules': ','.join(ids)}}, remove_groups=(rid,))
    reconfigure()
    return rules()


def pick_window():
    if not kwin_running():
        raise Fail('KWin isn\'t running')
    try:
        info = call('org.kde.KWin', '/KWin', 'org.kde.KWin', 'queryWindowInfo', timeout=60000)[0]
    except Fail as e:
        raise Fail('No window picked (%s)' % e)
    return {'wmclass': info.get('resourceClass') or '', 'name': info.get('resourceName') or '',
            'title': info.get('caption') or '', 'desktopFile': info.get('desktopFile') or ''}


# ------------------------------------------------------------------ input devices
DEV_PATH = '/org/kde/KWin/InputDevice'


def input_devices():
    fx = fixture()
    if fx is not None:
        return {'devices': fx.get('devices', []), 'live': False}
    if not kwin_running():
        return {'devices': [], 'live': False}
    try:
        names = get_prop('org.kde.KWin', DEV_PATH, 'org.kde.KWin.InputDeviceManager', 'devicesSysNames')
    except Fail as e:
        raise Fail('KWin didn\'t list its input devices (%s)' % e)
    out = []
    for n in names:
        try:
            props = get_all('org.kde.KWin', DEV_PATH + '/' + n, 'org.kde.KWin.InputDevice')
        except Fail:
            continue
        d = {k: _plain(props[k]) for k in INPUT_READ if k in props}
        out.append(d)
    return {'devices': out, 'live': True}


def _plain(v):
    if isinstance(v, tuple):
        return list(v)
    return v


def _variant_value(kind, v):
    if kind == 'b':
        if not isinstance(v, bool):
            raise Fail('on or off')
        return 'b', v
    if kind == 'd':
        if not isinstance(v, (int, float)) or isinstance(v, bool):
            raise Fail('a number')
        return 'd', float(v)
    if kind == 'i':
        if not isinstance(v, int) or isinstance(v, bool):
            raise Fail('a whole number')
        return 'i', v
    if kind == 's':
        if not isinstance(v, str) or len(v) > 200 or '\n' in v:
            raise Fail('text')
        return 's', v
    if kind == 'rect':
        if not isinstance(v, list) or len(v) != 4 or not all(isinstance(x, (int, float)) for x in v):
            raise Fail('[x, y, width, height]')
        return '(dddd)', tuple(float(x) for x in v)
    raise Fail('unknown')


def input_set(sysname, raw):
    if not re.match(r'^[A-Za-z0-9_.-]{1,64}$', sysname or ''):
        raise Fail('a device')
    try:
        req = json.loads(raw or 'null')
    except ValueError:
        raise Fail('expected JSON on stdin')
    if not isinstance(req, dict):
        raise Fail('expected {property: value}')
    for k in req:
        if k not in INPUT_PROPS:
            raise Fail('%s is not a setting Hearth changes' % k)
    if fixture() is not None:
        return {'ok': True, 'preview': True}
    if not kwin_running():
        raise Fail('KWin isn\'t running')
    for k, v in req.items():
        sig, val = _variant_value(INPUT_PROPS[k], v)
        set_prop('org.kde.KWin', DEV_PATH + '/' + sysname, 'org.kde.KWin.InputDevice', k, sig, val)
    return {'ok': True}


def load_helper(name):
    import importlib.machinery
    import importlib.util
    loader = importlib.machinery.SourceFileLoader(name.replace('-', '_'), os.path.join(HERE, name))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def pointer_json():
    """Settings › Mouse & touchpad (pointer.json, the one home of these settings) with Hearth's defaults for what the
    person hasn't chosen, as hearth-system reads it for labwc."""
    try:
        return load_helper('hearth-system').pointer_saved()
    except Exception as e:
        hsio.log_event('kwin: pointer.json not read through hearth-system (%s)' % e)
        p = os.path.join(kc.config_home(), 'nimbus', 'pointer.json')
        d = hsio.load_json(p, {}) if os.path.exists(p) else {}
        return d if isinstance(d, dict) else {}


def pointer_props(kind, s):
    """pointer.json's settings for one kind ('mouse' / 'touchpad') as KWin InputDevice properties."""
    out = {}
    if isinstance(s.get('speed'), (int, float)) and not isinstance(s.get('speed'), bool):
        out['pointerAcceleration'] = max(-1.0, min(1.0, float(s['speed'])))
    if s.get('accel') in ('flat', 'adaptive'):
        out['pointerAccelerationProfileFlat'] = s['accel'] == 'flat'
        out['pointerAccelerationProfileAdaptive'] = s['accel'] == 'adaptive'
    for src, dst in (('natural', 'naturalScroll'), ('leftHanded', 'leftHanded'), ('tap', 'tapToClick'),
                     ('dwt', 'disableWhileTyping'), ('tapDrag', 'tapAndDrag'), ('middle', 'middleEmulation')):
        if isinstance(s.get(src), bool):
            out[dst] = s[src]
    if s.get('scroll') in ('twofinger', 'edge'):
        out['scrollTwoFinger'] = s['scroll'] == 'twofinger'
        out['scrollEdge'] = s['scroll'] == 'edge'
    if isinstance(s.get('scrollSpeed'), (int, float)) and not isinstance(s.get('scrollSpeed'), bool):
        out['scrollFactor'] = max(0.1, min(5.0, float(s['scrollSpeed'])))
    if s.get('click') in ('areas', 'fingers'):
        out['clickMethodAreas'] = s['click'] == 'areas'
        out['clickMethodClickfinger'] = s['click'] == 'fingers'
    return out


SUPPORT = {'pointerAcceleration': 'supportsPointerAcceleration', 'pointerAccelerationProfileFlat': 'supportsPointerAccelerationProfileFlat',
           'pointerAccelerationProfileAdaptive': 'supportsPointerAccelerationProfileFlat', 'naturalScroll': 'supportsNaturalScroll',
           'leftHanded': 'supportsLeftHanded', 'disableWhileTyping': 'supportsDisableWhileTyping',
           'middleEmulation': 'supportsMiddleEmulation', 'scrollTwoFinger': 'supportsScrollTwoFinger',
           'scrollEdge': 'supportsScrollEdge', 'clickMethodAreas': 'supportsClickMethodAreas',
           'clickMethodClickfinger': 'supportsClickMethodClickfinger'}


def pointer_plan(devices, settings):
    """[(sysName, property, value)] to put pointer.json on these devices: only what differs from the device now, and
    only what the device can do."""
    plan = []
    for d in devices:
        if d.get('touchpad'):
            kind = 'touchpad'
        elif d.get('pointer') and not d.get('touch') and not d.get('tabletTool') and not d.get('tabletPad'):
            kind = 'mouse'
        else:
            continue
        want = pointer_props(kind, settings.get(kind) or {})
        for k, v in want.items():
            sup = SUPPORT.get(k)
            if sup and not d.get(sup, False):
                continue
            if k in ('tapToClick', 'tapAndDrag') and not d.get('tapFingerCount'):
                continue
            if k not in d or d.get(k) == v or (isinstance(v, float) and isinstance(d.get(k), (int, float)) and abs(d[k] - v) < 1e-6):
                continue
            plan.append((d['sysName'], k, v))
    return plan


def pointer_apply():
    if not kwin_running():
        return {'ok': True, 'applied': 0, 'kwin': False}
    plan = pointer_plan(input_devices()['devices'], pointer_json())
    bad = []
    for sysname, k, v in plan:
        sig, val = _variant_value(INPUT_PROPS[k], v)
        try:
            set_prop('org.kde.KWin', DEV_PATH + '/' + sysname, 'org.kde.KWin.InputDevice', k, sig, val)
        except Fail as e:
            bad.append('%s %s: %s' % (sysname, k, e))
    if bad:
        hsio.log_event('kwin: mouse/touchpad settings not all taken: ' + '; '.join(bad))
    return {'ok': not bad, 'applied': len(plan) - len(bad), 'kwin': True}


def input_watch():
    """For the session: puts the mouse and touchpad settings on every device now and on each one plugged in later."""
    pointer_apply()
    conn = bus()
    if conn is None:
        return
    from gi.repository import GLib

    def added(*_a):
        GLib.timeout_add(300, lambda: (pointer_apply(), False)[1])
    conn.signal_subscribe('org.kde.KWin', 'org.kde.KWin.InputDeviceManager', 'deviceAdded', DEV_PATH, None, 0, added)
    GLib.MainLoop().run()


def rebind(tool, button, raw):
    if not tool or '\n' in tool or ']' in tool or '[' in tool or len(tool) > 120:
        raise Fail('a pen')
    if not re.match(r'^\d{1,4}$', button or ''):
        raise Fail('a button number')
    action = (raw or '').strip()
    if action and not re.match(r'^(Disabled|MouseButton,\d{1,3}(,\d{1,10})?|Key,[A-Za-z0-9+_ .,-]{1,40}|TabletToolButton,\d{1,4})$', action):
        raise Fail('an action: MouseButton,N, Key,Ctrl+Z, TabletToolButton,N or Disabled')
    write_changes('kcminputrc', {'ButtonRebinds][TabletTool][' + tool: {button: action or None}})
    return {'ok': True}


def shortcut(name):
    real = SHORTCUTS.get(name)
    if not real:
        raise Fail('one of: ' + ', '.join(SHORTCUTS))
    if not kwin_running():
        raise Fail('KWin isn\'t running')
    call('org.kde.kglobalaccel', '/component/kwin', 'org.kde.kglobalaccel.Component', 'invokeShortcut', '(s)', (real,))
    return {'ok': True}


def main(argv):
    c = argv[1] if len(argv) > 1 else ''
    a = argv[2:]
    if c == 'status' and not a:
        out = status()
    elif c == 'get' and not a:
        out = get_all_files()
    elif c == 'set' and len(a) == 1:
        out = set_file(a[0], sys.stdin.read())
    elif c == 'desktops' and not a:
        out = desktops()
    elif c == 'desktops-set' and not a:
        out = desktops_set(sys.stdin.read())
    elif c == 'outputs' and not a:
        out = outputs()
        vals, _, _ = kc.effective('kwinrc')
        for o in out['outputs']:
            o['layout'] = kwin_to_layout(vals.get('Tiling][' + o['uuid'], {}).get('tiles', ''))
            o['custom'] = 'tiles' in vals.get('Tiling][' + o['uuid'], {})
        out['padding'] = vals.get('Tiling', {}).get('padding', '4')
    elif c == 'tiles-set' and len(a) == 2:
        out = tiles_set(a[0], a[1], sys.stdin.read())
    elif c == 'rules' and not a:
        out = rules()
    elif c == 'rule-set' and not a:
        out = rule_set(sys.stdin.read())
    elif c == 'rule-delete' and len(a) == 1:
        out = rule_delete(a[0])
    elif c == 'pick-window' and not a:
        out = pick_window()
    elif c == 'input' and not a:
        out = input_devices()
    elif c == 'input-set' and len(a) == 1:
        out = input_set(a[0], sys.stdin.read())
    elif c == 'pointer-apply' and not a:
        out = pointer_apply()
    elif c == 'input-watch' and not a:
        input_watch()
        return
    elif c == 'rebind' and len(a) == 2:
        out = rebind(a[0], a[1], sys.stdin.read())
    elif c == 'shortcut' and len(a) == 1:
        out = shortcut(a[0])
    else:
        print(__doc__.strip(), file=sys.stderr)
        sys.exit(2)
    print(json.dumps(out, ensure_ascii=False), flush=True)


if __name__ == '__main__':
    try:
        main(sys.argv)
    except (Fail, kc.BadFile, ValueError, OSError) as e:
        print('error: ' + str(e), flush=True)
        sys.exit(1)
