#!/usr/bin/python3
"""hearth-power: power mode and power limit (TDP) for Hearth's Game Mode and Desktop Mode.

  hearth-power status          JSON: {"mode": {...}, "tdp": {...}}
  hearth-power mode NAME       power-saver | balanced | performance
  hearth-power tdp WATTS       set the power limit
  hearth-power restore         put back the last power limit you chose (after a restart; not when Handheld
                               Daemon manages the limit: it keeps its own)

It tries what the system offers, in this order, and says which one it used ("via"):
  power mode   SteamOS Manager  ->  power-profiles D-Bus (tuned-ppd on Bazzite, Handheld Daemon's
               hhd-power-profiles on Anatase)  ->  powerprofilesctl  ->  Handheld Daemon's own modes
  power limit  SteamOS Manager (what Steam's Game Mode uses on Bazzite)  ->  Handheld Daemon (Anatase: HHD
               owns the limit there; Anatase's SteamOS Manager passes changes on to it but can't say the current
               limit, so the limit is read from HHD and set through SteamOS Manager first, HHD's own event if
               that doesn't take)  ->  PowerStation  ->
               Hearth's own: hearth-admin through pkexec, which writes the limits itself (ASUS firmware
               attributes, the older asus-nb-wmi files, or ryzenadj on other AMD handhelds)
While Handheld Daemon runs with a power plugin (a tdp.<plugin>.tdp power mode in its state), the limit is its alone:
Hearth never falls back to writing it itself (ryzenadj, firmware files, PowerStation), which HHD would undo.
Output is one JSON line; failures print "error: ..." and exit 1.
"""
import json
import os
import shutil
import subprocess
import sys

PP = [('org.freedesktop.UPower.PowerProfiles', '/org/freedesktop/UPower/PowerProfiles', 'org.freedesktop.UPower.PowerProfiles'),
      ('net.hadess.PowerProfiles', '/net/hadess/PowerProfiles', 'net.hadess.PowerProfiles')]
SOM = ('com.steampowered.SteamOSManager1', '/com/steampowered/SteamOSManager1')
PS = 'org.shadowblip.PowerStation'
PS_IFACE = 'org.shadowblip.GPU.Card.TDP'
ADMIN = '/usr/libexec/nimbus/hearth-admin'
MODES = ['power-saver', 'balanced', 'performance']
# SteamOS Manager / platform_profile names → ours
SOM_NAMES = {'low-power': 'power-saver', 'quiet': 'power-saver', 'power-saver': 'power-saver',
             'balanced': 'balanced', 'performance': 'performance'}


class Fail(Exception):
    pass


_HHD = None
_HHD_UP = None


def hhd():
    """desktop/shell/hearth-hhd (Handheld Daemon's API), loaded on first use; None when it's not running."""
    global _HHD
    if _HHD is None:
        try:
            import importlib.machinery
            import importlib.util
            path = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'hearth-hhd')
            loader = importlib.machinery.SourceFileLoader('hearth_hhd', path)
            spec = importlib.util.spec_from_loader('hearth_hhd', loader)
            mod = importlib.util.module_from_spec(spec)
            loader.exec_module(mod)
            _HHD = mod
        except (OSError, ImportError, SyntaxError):
            _HHD = False
    # Asked once per run: each question can take seconds when HHD is slow, and status asks several times.
    global _HHD_UP
    if _HHD_UP is None:
        _HHD_UP = bool(_HHD and _HHD.available())
    return _HHD if _HHD_UP else None


def hhd_tdp():
    """Handheld Daemon's power limit, when it manages it here ({} otherwise)."""
    h = hhd()
    if not h:
        return {}
    try:
        info = h.tdp_info(h.state())
    except RuntimeError:
        return {}
    return info if info.get('enabled') else {}


def hhd_owns_tdp():
    """Handheld Daemon runs a power plugin here (it has a power mode), whether or not its limit is ready: then
    nothing else may write the limit (two writers fight)."""
    h = hhd()
    if not h:
        return False
    try:
        return bool(h.tdp_info(h.state()).get('driver'))
    except RuntimeError:
        return False


def busctl(bus, *args, timeout=6):
    if not shutil.which('busctl'):
        raise Fail('busctl is missing')
    r = subprocess.run(['busctl', '--' + bus, *args], capture_output=True, text=True, timeout=timeout)
    if r.returncode != 0:
        raise Fail((r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else 'busctl failed')
    return r.stdout


_NAMES = {}


def running(bus, name):
    """Does someone hold this D-Bus name now? (True when busctl can't say.) Asking a name nobody holds makes D-Bus
    start its service, and when that service can't start the call waits for its whole timeout: power-profiles-daemon
    is held back while Handheld Daemon runs (its drop-in's condition), so on a desktop PC, where HHD has no power
    plugin, each power-profiles question used to hang for seconds and status took over 15 s. So names that aren't
    running are skipped."""
    if bus not in _NAMES:
        try:
            out = busctl(bus, '--acquired', '--no-legend', 'list', timeout=4)
            _NAMES[bus] = {l.split()[0] for l in out.splitlines() if l.strip()}
        except (Fail, OSError, subprocess.TimeoutExpired):
            _NAMES[bus] = None
    return _NAMES[bus] is None or name in _NAMES[bus]


def getp(bus, svc, path, iface, name):
    return json.loads(busctl(bus, '--json=short', 'get-property', svc, path, iface, name))['data']


def state_file():
    base = os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'), '.local', 'state')
    return os.path.join(base, 'nimbus', 'tdp')


def remember(watts):
    try:
        os.makedirs(os.path.dirname(state_file()), exist_ok=True)
        with open(state_file(), 'w') as f:
            f.write(f'{int(watts)}\n')
    except OSError:
        pass


def remembered():
    try:
        with open(state_file()) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


# ---------------------------------------------------------------------- power mode
def som_mode():
    if not running('user', SOM[0]):
        raise Fail('SteamOS Manager is not running')
    iface = SOM[0] + '.PerformanceProfile1'
    active = getp('user', SOM[0], SOM[1], iface, 'PerformanceProfile')
    avail = getp('user', SOM[0], SOM[1], iface, 'AvailablePerformanceProfiles')
    mapped = sorted({SOM_NAMES[a] for a in avail if a in SOM_NAMES}, key=MODES.index)
    return {'supported': bool(mapped), 'active': SOM_NAMES.get(active, active), 'available': mapped, 'via': 'steamos-manager', 'raw': avail, 'rawActive': active}


def mode_status():
    # SteamOS Manager first: on Bazzite it owns the power profile (and the power limit only applies in its
    # "custom" profile), so changing it anywhere else gets undone.
    try:
        st = som_mode()
        if st['supported']:
            return st
    except (Fail, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        pass
    for svc, path, iface in PP:
        if not running('system', svc):
            continue
        try:
            active = getp('system', svc, path, iface, 'ActiveProfile')
            profiles = [p['Profile']['data'] for p in getp('system', svc, path, iface, 'Profiles')]
            return {'supported': True, 'active': active, 'available': [m for m in MODES if m in profiles] or profiles, 'via': 'power-profiles'}
        except (Fail, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
            continue
    # powerprofilesctl asks the same D-Bus service (and would hang the same way when nobody runs it).
    if shutil.which('powerprofilesctl') and any(running('system', svc) for svc, _, _ in PP):
        try:
            active = subprocess.run(['powerprofilesctl', 'get'], capture_output=True, text=True, timeout=5).stdout.strip()
            if active:
                return {'supported': True, 'active': active, 'available': MODES, 'via': 'powerprofilesctl'}
        except (OSError, subprocess.TimeoutExpired):
            pass
    h = hhd()
    if h:
        try:
            info = h.tdp_info(h.state(), h.settings())
            if info.get('driver'):
                avail = [m for m in MODES if any(x in info['modes'] for x in h.MODE_NAMES[m])] or MODES
                return {'supported': True, 'active': h.hearth_mode(info['mode']) or 'balanced', 'available': avail, 'via': 'hhd'}
        except RuntimeError:
            pass
    return {'supported': False, 'active': 'balanced', 'available': [], 'via': None}


def set_mode(name):
    if name not in MODES:
        raise Fail('unknown power mode ' + name)
    st = mode_status()
    if st['via'] == 'power-profiles':
        errors = []
        for svc, path, iface in PP:
            if not running('system', svc):
                continue
            try:
                busctl('system', 'set-property', svc, path, iface, 'ActiveProfile', 's', name)
                return
            except (Fail, subprocess.TimeoutExpired) as e:
                errors.append(str(e))
        raise Fail(errors[0] if errors else 'the power-profiles service stopped')
    if st['via'] == 'powerprofilesctl':
        r = subprocess.run(['powerprofilesctl', 'set', name], capture_output=True, text=True, timeout=10)
        if r.returncode != 0:
            raise Fail(r.stderr.strip() or 'powerprofilesctl failed')
        return
    if st['via'] == 'steamos-manager':
        raw = next((a for a in st.get('raw', []) if SOM_NAMES.get(a) == name), None)
        if not raw:
            raise Fail('this device has no ' + name + ' mode')
        busctl('user', 'set-property', SOM[0], SOM[1], SOM[0] + '.PerformanceProfile1', 'PerformanceProfile', 's', raw)
        return
    if st['via'] == 'hhd':
        try:
            hhd().set_mode(name)
        except (RuntimeError, AttributeError) as e:
            raise Fail(str(e))
        return
    raise Fail("power modes aren't available on this device")


# ---------------------------------------------------------------------- power limit
def ps_card():
    if not running('system', PS):
        raise Fail('PowerStation is not running')
    tree = busctl('system', '--list', 'tree', PS, timeout=4)
    for p in (l.strip() for l in tree.splitlines()):
        if p.startswith('/org/shadowblip/Performance/GPU/card') and p.rsplit('card', 1)[-1].isdigit():
            try:
                getp('system', PS, p, PS_IFACE, 'TDP')
                return p
            except (Fail, ValueError, KeyError):
                continue
    raise Fail('no PowerStation GPU')


def admin(*args):
    if not os.path.exists(ADMIN):
        raise Fail('hearth-admin is missing')
    r = subprocess.run(['pkexec', ADMIN, *args], capture_output=True, text=True, timeout=30)
    lines = [l for l in r.stdout.splitlines() if l.strip()]
    err = next((l[7:] for l in lines if l.startswith('error: ')), None)
    if err:
        raise Fail(err)
    if r.returncode != 0:
        raise Fail((r.stderr.strip().splitlines() or ['hearth-admin failed'])[-1])
    for l in reversed(lines):
        if l.startswith('{'):
            return json.loads(l)
    return {}


def clamp(w, lo, hi):
    """The limit to show, inside the device's range: a remembered limit can come from another device or edition
    (30 W on a handheld whose range ends at 20), and the slider can't show a value outside its range."""
    return max(lo, min(hi, int(w or 15)))


def tdp_status():
    iface = SOM[0] + '.TdpLimit1'
    try:
        if not running('user', SOM[0]):
            raise Fail('SteamOS Manager is not running')
        w = getp('user', SOM[0], SOM[1], iface, 'TdpLimit')
        lo = getp('user', SOM[0], SOM[1], iface, 'TdpLimitMin')
        hi = getp('user', SOM[0], SOM[1], iface, 'TdpLimitMax')
        if hi:
            return {'supported': True, 'watts': int(w), 'min': int(lo or 3), 'max': int(hi), 'via': 'steamos-manager'}
    except (Fail, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        pass
    # Handheld Daemon (Hearth OS on Anatase) owns the limit: anything else would be undone by it.
    h = hhd_tdp()
    if h:
        w = h.get('watts') or remembered() or h.get('default')
        lo, hi = int(h.get('min') or 3), int(h['max'])
        return {'supported': True, 'watts': clamp(w, lo, hi), 'min': lo, 'max': hi, 'via': 'hhd', 'mode': h.get('mode')}
    if hhd_owns_tdp():
        # HHD has a power plugin but its limit isn't on (or not ready yet): leave it to HHD.
        return {'supported': False, 'via': 'hhd', 'reason': "Handheld Daemon manages the power limit on this device"}
    # ASUS handhelds with the firmware-attributes driver (ROG Ally, ROG Xbox Ally): set directly, with the
    # device's real range. PowerStation's older ASUS path doesn't work on them (it fails without saying so).
    info = admin_tdp_info()
    if info.get('method') == 'firmware':
        w = info.get('watts') or remembered() or info.get('default')
        return {'supported': True, 'watts': clamp(w, int(info['min']), int(info['max'])), 'min': int(info['min']), 'max': int(info['max']), 'via': 'hearth:firmware'}
    try:
        card = ps_card()
        w = getp('system', PS, card, PS_IFACE, 'TDP')
        return {'supported': True, 'watts': round(float(w)), 'min': 5, 'max': 30, 'via': 'powerstation'}
    except (Fail, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        pass
    if info.get('method'):
        w = info.get('watts') or remembered() or info.get('default')
        return {'supported': True, 'watts': clamp(w, int(info['min']), int(info['max'])), 'min': int(info['min']), 'max': int(info['max']), 'via': 'hearth:' + info['method']}
    return {'supported': False, 'via': None}


def som_tdp_settable():
    """SteamOS Manager is running and has the power-limit interface (on Anatase it passes changes on to Handheld
    Daemon, though it can't say the current limit)."""
    if not running('user', SOM[0]):
        return False
    try:
        busctl('user', 'introspect', SOM[0], SOM[1], SOM[0] + '.TdpLimit1', timeout=4)
        return True
    except (Fail, OSError, subprocess.TimeoutExpired):
        return False


def admin_tdp_info():
    """hearth-admin's read-only answer: how this device's power limit can be set ({} when it can't say)."""
    if not os.path.exists(ADMIN):
        return {}
    try:
        r = subprocess.run([ADMIN, 'tdp-info'], capture_output=True, text=True, timeout=10)  # no root needed
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
        return {}


def set_tdp(watts):
    st = tdp_status()
    if not st['supported']:
        raise Fail("this device's power limit can't be changed here")
    w = max(st['min'], min(st['max'], int(round(float(watts)))))
    errors = []
    # Each way in turn, until one takes: SteamOS Manager, PowerStation, then Hearth's own.
    if st['via'] == 'steamos-manager':
        try:
            iface = SOM[0] + '.PerformanceProfile1'
            # The power limit only applies in SteamOS Manager's "custom" profile (like Steam's Quick Access).
            avail = getp('user', SOM[0], SOM[1], iface, 'AvailablePerformanceProfiles')
            if 'custom' in avail and getp('user', SOM[0], SOM[1], iface, 'PerformanceProfile') != 'custom':
                busctl('user', 'set-property', SOM[0], SOM[1], iface, 'PerformanceProfile', 's', 'custom')
            busctl('user', 'set-property', SOM[0], SOM[1], SOM[0] + '.TdpLimit1', 'TdpLimit', 'u', str(w))
            if int(getp('user', SOM[0], SOM[1], SOM[0] + '.TdpLimit1', 'TdpLimit')) == w:
                remember(w)
                return w
            errors.append('SteamOS Manager kept the old limit')
        except (Fail, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as e:
            errors.append('SteamOS Manager: ' + str(e))
    if st['via'] == 'hhd':
        h = hhd()
        if not h:
            raise Fail('Handheld Daemon stopped answering')
        # Anatase's SteamOS Manager passes a new limit on to Handheld Daemon (hhd.steamos steamos-tdp), the way
        # Steam sets it: that first, then HHD's own event. Either way HHD applies it in its next loop (switching
        # to its custom mode), so check what HHD has then.
        if som_tdp_settable():
            try:
                busctl('user', 'set-property', SOM[0], SOM[1], SOM[0] + '.TdpLimit1', 'TdpLimit', 'u', str(w))
                got = h.tdp_info(h.state(poll=True)).get('watts')
                if got is not None and abs(int(got) - w) <= 1:
                    remember(w)
                    return w
                errors.append('SteamOS Manager passed it on, but Handheld Daemon has %s W' % got)
            except (Fail, RuntimeError, ValueError, TypeError, subprocess.TimeoutExpired) as e:
                errors.append('SteamOS Manager: ' + str(e))
        try:
            got = h.set_tdp(w)
            if got is None or abs(int(got) - w) <= 1:
                remember(w)
                return w
            errors.append('Handheld Daemon kept %s W' % got)
        except (RuntimeError, ValueError) as e:
            errors.append('Handheld Daemon: ' + str(e))
        # Writing the limit any other way would fight Handheld Daemon (it puts its own back).
        raise Fail("couldn't set the power limit (" + '; '.join(errors) + ')')
    try:
        if st['via'] == 'hearth:firmware':
            raise Fail('skipped (set directly instead)')
        card = ps_card()
        busctl('system', 'set-property', PS, card, PS_IFACE, 'TDP', 'd', str(w))
        # PowerStation accepts the value even when it couldn't apply it: check it really changed.
        got = round(float(getp('system', PS, card, PS_IFACE, 'TDP')))
        if abs(got - w) > 1:
            raise Fail('kept %d W' % got)
        remember(w)
        return w
    except (Fail, ValueError, KeyError, TypeError, subprocess.TimeoutExpired) as e:
        errors.append('PowerStation: ' + str(e))
    try:
        admin('tdp', str(w))
        remember(w)
        return w
    except (Fail, OSError, subprocess.TimeoutExpired) as e:
        errors.append(str(e))
    raise Fail("couldn't set the power limit (" + '; '.join(errors) + ')')


SEAT_REASON = "Player 1 chooses this PC's power mode and power limit"


def cmd(argv):
    c = argv[1] if len(argv) > 1 else 'status'
    # Multi-seat: the power mode and limit are the whole PC's, so they're player 1's. An extra player's Quick Access
    # and a game of theirs with its own limit changed them for everyone (and player 1's own came back only later).
    seat = bool(os.environ.get('HEARTH_SEAT'))
    if seat and c in ('mode', 'tdp') and len(argv) == 3:
        raise Fail(SEAT_REASON)
    if seat and c in ('status', 'restore'):
        out = {'mode': {'supported': False, 'active': 'balanced', 'available': [], 'via': None},
               'tdp': {'supported': False, 'via': None, 'reason': SEAT_REASON}} if c == 'status' else {'tdp': None, 'skipped': SEAT_REASON}
    elif c == 'status':
        out = {'mode': mode_status(), 'tdp': tdp_status()}
    elif c == 'mode' and len(argv) == 3:
        set_mode(argv[2])
        out = {'mode': mode_status()}
    elif c == 'tdp' and len(argv) == 3:
        set_tdp(argv[2])
        out = {'tdp': tdp_status()}
    elif c == 'restore':
        w = remembered()
        if w and (hhd_tdp() or hhd_owns_tdp()):
            out = {'tdp': None, 'skipped': 'Handheld Daemon keeps its own power limit'}
        else:
            out = {'tdp': {'watts': set_tdp(w)} if w else None}
    else:
        print('usage: hearth-power status | mode power-saver|balanced|performance | tdp WATTS | restore')
        sys.exit(2)
    print(json.dumps(out))


if __name__ == '__main__':
    try:
        cmd(sys.argv)
    except (Fail, OSError, ValueError, subprocess.TimeoutExpired) as e:
        print('error: ' + str(e))
        sys.exit(1)
