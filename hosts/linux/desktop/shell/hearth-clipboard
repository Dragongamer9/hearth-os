#!/usr/bin/python3
"""hearth-clipboard: clipboard history for Desktop Mode (Clipboard.qml, Super+V).

History is OFF until you turn it on (the switch in the Super+V popup, or Settings › Clipboard). While it's on, the
shell runs `wl-paste --watch hearth-clipboard store`, so each copy reaches `store` on its standard input. Nothing
runs while it's off.

Kept in ~/.local/share/hearth/clipboard/ (a folder only you can read): index.json (the list, newest first, written
atomically with a .bak through hearth_settings_io) and one file per item (<id>.txt or <id>.png). About 25 items are
kept, plus the ones you pinned; Clear all keeps the pinned ones. Copies a password manager marks as secret
(the x-kde-passwordManagerHint type, or wl-paste's CLIPBOARD_STATE=sensitive) are never kept.

  hearth-clipboard status            JSON: is wl-clipboard installed
  hearth-clipboard list              JSON: the items, newest first (pinned ones first)
  hearth-clipboard store             (wl-paste --watch) keep what was just copied, from standard input
  hearth-clipboard paste ID          put the item back on the clipboard and paste it (Ctrl+V) into the app in front
  hearth-clipboard copy ID           only put it back on the clipboard
  hearth-clipboard pin ID | unpin ID
  hearth-clipboard delete ID         forget one item (pinned or not)
  hearth-clipboard clear             forget everything that isn't pinned ("wipe" is the same)
  hearth-clipboard store --primary [--keep] [--sync]
                                     (wl-paste --primary --watch) the selection (what you highlight; middle-click
                                     pastes it): kept with --keep (Selection history), and with --sync it's put on the
                                     clipboard too; `store --sync` puts a copied text on the selection too
  hearth-clipboard browsers          JSON: the web browsers here, for "Open in…" (the default one first)
  hearth-clipboard open ID APP       open the link in item ID in APP (a browser's .desktop id)
  hearth-clipboard qr ID             JSON {path}: a QR code picture of item ID's text (qrencode)
  hearth-clipboard get ID            JSON {text}: the whole text of item ID (for Edit)
  hearth-clipboard edit ID           the item's text replaced by standard input (the clipboard isn't changed)
Output: one JSON line; failures print "error: ..." and exit 1.
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import hearth_settings_io as hsio  # noqa: E402  (the safe writer, next to this file)
import hearth_desktop_apps as apps  # noqa: E402

LIMIT = 25                 # unpinned items kept
PIN_MAX = 25               # pinned items kept (pinning one more is refused with a message; nothing is unpinned)
MAX_BYTES = 16 * 1024 * 1024
PREVIEW = 400
ID_RE = re.compile(r'^[0-9]{1,20}$')
# Copies password managers mark as secret (KeePassXC, Bitwarden, KDE Wallet...).
SECRET_TYPES = ('x-kde-passwordManagerHint',)
IMAGE_EXT = {'image/png': 'png', 'image/jpeg': 'jpg', 'image/gif': 'gif', 'image/webp': 'webp', 'image/bmp': 'bmp'}


class Fail(Exception):
    pass


def data_dir():
    base = os.environ.get('XDG_DATA_HOME') or os.path.join(os.path.expanduser('~'), '.local', 'share')
    return os.path.join(base, 'hearth', 'clipboard')


def index_path():
    return os.path.join(data_dir(), 'index.json')


def runtime_app_file():
    rt = os.environ.get('XDG_RUNTIME_DIR') or '/tmp'
    return os.path.join(rt, 'hearth-clipboard-app')


def have():
    return bool(shutil.which('wl-copy')) and bool(shutil.which('wl-paste'))


def ensure_dir():
    d = data_dir()
    os.makedirs(d, mode=0o700, exist_ok=True)
    try:
        os.chmod(d, 0o700)
    except OSError:
        pass
    return d


# ------------------------------------------------------------------ the list
def clean_items(raw):
    """index.json's items, with anything odd dropped (a hand-edited or old file never breaks the popup)."""
    out, seen = [], set()
    for it in raw if isinstance(raw, list) else []:
        if not isinstance(it, dict):
            continue
        iid = str(it.get('id', ''))
        if not ID_RE.fullmatch(iid) or iid in seen or it.get('kind') not in ('text', 'image'):
            continue
        f = str(it.get('file', ''))
        if not re.fullmatch(r'[0-9]{1,20}\.(txt|png|jpg|gif|webp|bmp)', f):
            continue
        seen.add(iid)
        out.append({'id': iid, 'kind': it['kind'], 'file': f, 'text': str(it.get('text', ''))[:PREVIEW],
                    'app': str(it.get('app', ''))[:80], 'time': float(it.get('time', 0) or 0),
                    'pinned': it.get('pinned') is True, 'hash': str(it.get('hash', ''))[:64],
                    'size': int(it.get('size', 0) or 0), 'dims': str(it.get('dims', ''))[:20],
                    'sel': it.get('sel') is True})
    return out


def ordered(items):
    """Pinned first (in the order they were copied), then the rest, each newest first."""
    pins = sorted((i for i in items if i['pinned']), key=lambda i: -i['time'])
    rest = sorted((i for i in items if not i['pinned']), key=lambda i: -i['time'])
    return pins + rest


def trim(items):
    """Every pin (up to PIN_MAX) and the newest LIMIT others. Returns (kept, dropped)."""
    items = ordered(items)
    pins = [i for i in items if i['pinned']][:PIN_MAX]
    rest = [i for i in items if not i['pinned']]
    kept_rest, dropped = rest[:LIMIT], rest[LIMIT:]
    dropped += [i for i in items if i['pinned']][PIN_MAX:]
    return pins + kept_rest, dropped


def read_items():
    return clean_items(hsio.load_json(index_path(), {}).get('items'))


def update(change):
    """CHANGE(items) -> items, under the index's lock; files of items that left the list are removed."""
    ensure_dir()
    gone = []

    def apply(d):
        before = clean_items(d.get('items'))
        after = change(list(before))
        keep = {i['id'] for i in after}
        gone.extend(i for i in before if i['id'] not in keep)
        d['items'] = after
        d.setdefault('version', 1)
    hsio.update_json(index_path(), apply)
    for i in gone:
        remove_file(i['file'])


def remove_file(name):
    try:
        os.remove(os.path.join(data_dir(), name))
    except OSError:
        pass


# ------------------------------------------------------------------ keeping a copy
def mime_of(data):
    if data.startswith(b'\x89PNG'):
        return 'image/png'
    if data.startswith(b'\xff\xd8\xff'):
        return 'image/jpeg'
    if data.startswith(b'GIF8'):
        return 'image/gif'
    if data[:4] == b'RIFF' and data[8:12] == b'WEBP':
        return 'image/webp'
    if data.startswith(b'BM') and len(data) > 26:
        return 'image/bmp'
    return None


def png_size(data):
    if data.startswith(b'\x89PNG') and len(data) >= 24:
        return '%dx%d' % (int.from_bytes(data[16:20], 'big'), int.from_bytes(data[20:24], 'big'))
    return ''


def offered_types(primary=False):
    """The types the app that copied offers ($HEARTH_CLIP_TYPES for the tests: one per line)."""
    if 'HEARTH_CLIP_TYPES' in os.environ:
        return [t for t in os.environ['HEARTH_CLIP_TYPES'].splitlines() if t.strip()]
    try:
        r = subprocess.run(['wl-paste', '--list-types'] + (['--primary'] if primary else []), capture_output=True, text=True, timeout=3)
        return [t.strip() for t in r.stdout.splitlines() if t.strip()]
    except (OSError, subprocess.TimeoutExpired):
        return []


def is_secret(types, state=None):
    """A copy marked secret: wl-paste says CLIPBOARD_STATE=sensitive, or the app offers a password manager's hint."""
    if (state if state is not None else os.environ.get('CLIPBOARD_STATE', '')) == 'sensitive':
        return True
    return any(t.strip() in SECRET_TYPES for t in types)


def source_app():
    """The app that was in front when you copied (the shell writes its name while history is on)."""
    try:
        with open(runtime_app_file(), encoding='utf-8', errors='replace') as f:
            name = f.read().strip().splitlines()
        return name[0][:80] if name else ''
    except OSError:
        return ''


def new_id(items):
    n = time.time_ns() // 1000
    used = {i['id'] for i in items}
    while str(n) in used:
        n += 1
    return str(n)


SEL_JOIN = 15.0      # seconds: a selection that grows or shrinks (you're still dragging) replaces the last one


def store(data, types=None, app=None, now=None, state=None, primary=False):
    """Keep one copy (PRIMARY: from the selection). Returns {'stored': bool, 'why'?: str, 'id'?: str}."""
    types = offered_types(primary) if types is None else types
    if is_secret(types, state):
        return {'stored': False, 'why': 'secret'}
    if not data or len(data) > MAX_BYTES:
        return {'stored': False, 'why': 'empty' if not data else 'too big'}
    mime = mime_of(data)
    if mime and primary:
        return {'stored': False, 'why': 'not text'}     # the selection keeps text only
    if mime:
        kind, text, ext = 'image', '', IMAGE_EXT[mime]
    else:
        if b'\x00' in data[:4096]:
            return {'stored': False, 'why': 'not text'}
        text = data.decode('utf-8', errors='replace')
        if not text.strip():
            return {'stored': False, 'why': 'empty'}
        kind, ext = 'text', 'txt'
    digest = hashlib.sha256(data).hexdigest()
    app = source_app() if app is None else app
    now = time.time() if now is None else now
    out = {'stored': True}

    def change(items):
        same = next((i for i in items if i['hash'] == digest), None)
        if same:                                      # copied again (or pasted from the popup): back to the top,
            same['time'] = now                        # pin and the app it first came from kept
            if app and not same['app']:
                same['app'] = app
            out['id'] = same['id']
            return trim(items)[0]
        if primary:
            # Still dragging: the newest item is a selection from a moment ago that this one grows or shrinks.
            last = next((i for i in ordered(items) if not i['pinned']), None)
            if last and last.get('sel') and now - last['time'] < SEL_JOIN and last['kind'] == 'text':
                try:
                    with open(os.path.join(data_dir(), last['file']), encoding='utf-8', errors='replace') as f:
                        old = f.read()
                except OSError:
                    old = None
                if old is not None and old and (text.startswith(old) or old.startswith(text) or text.endswith(old) or old.endswith(text)):
                    items = [i for i in items if i['id'] != last['id']]     # its file goes with it (update)
        iid = new_id(items)
        name = '%s.%s' % (iid, ext)
        hsio._atomic_bytes(os.path.join(data_dir(), name), data, mode=0o600)
        items.insert(0, {'id': iid, 'kind': kind, 'file': name, 'text': text[:PREVIEW], 'app': app, 'time': now,
                         'pinned': False, 'hash': digest, 'size': len(data), 'dims': png_size(data), 'sel': bool(primary)})
        out['id'] = iid
        return trim(items)[0]
    ensure_dir()
    update(change)
    tidy()
    return out


def tidy():
    """Files no item points at (a crash between writing a file and the list) are removed."""
    try:
        keep = {i['file'] for i in read_items()}
        for f in os.listdir(data_dir()):
            if re.fullmatch(r'[0-9]{1,20}\.(txt|png|jpg|gif|webp|bmp)', f) and f not in keep:
                remove_file(f)
    except OSError:
        pass


# ------------------------------------------------------------------ the popup's actions
def list_items():
    items = ordered(read_items())
    d = data_dir()
    for i in items:
        i['path'] = os.path.join(d, i['file'])
        i.pop('hash', None)
        i['link'] = link_of(i['text']) if i['kind'] == 'text' else ''
    return {'available': have(), 'items': items}


def find(iid):
    if not ID_RE.fullmatch(iid or ''):
        raise Fail('not an item')
    it = next((i for i in read_items() if i['id'] == iid), None)
    if not it:
        raise Fail('that item isn\'t in the history any more')
    return it


def set_pin(iid, on):
    find(iid)
    res = {}

    def change(items):
        pins = [i for i in items if i['pinned']]
        for i in items:
            if i['id'] == iid:
                if on and not i['pinned'] and len(pins) >= PIN_MAX:
                    res['full'] = True
                    return items
                i['pinned'] = bool(on)
        return trim(items)[0]
    update(change)
    if res.get('full'):
        raise Fail('you can pin up to %d items: unpin one first' % PIN_MAX)
    return {'ok': True, 'id': iid, 'pinned': bool(on)}


def delete(iid):
    if not ID_RE.fullmatch(iid or ''):
        raise Fail('not an item')
    update(lambda items: [i for i in items if i['id'] != iid])
    return {'ok': True, 'id': iid}


def clear():
    """Clear all: pinned items stay."""
    if not os.path.exists(index_path()):
        return {'ok': True, 'kept': 0}
    kept = {}

    def change(items):
        pins = [i for i in items if i['pinned']]
        kept['n'] = len(pins)
        return pins
    update(change)
    tidy()
    return {'ok': True, 'kept': kept.get('n', 0)}


def copy(iid):
    it = find(iid)
    try:
        with open(os.path.join(data_dir(), it['file']), 'rb') as f:
            data = f.read()
    except OSError:
        raise Fail('that item\'s copy is missing')
    cmd = ['wl-copy']
    mime = mime_of(data)
    if mime:
        cmd += ['--type', mime]
    try:
        # wl-copy stays running in the background to serve the clipboard: don't wait on its output.
        p = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        p.stdin.write(data)
        p.stdin.close()
        p.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    except OSError as e:
        raise Fail('couldn\'t put it on the clipboard (%s)' % e)
    return {'ok': True, 'id': iid}


def press_ctrl_v():
    """Ctrl+V into the window in front: wtype (Wayland's virtual keyboard, what the on-screen keyboard types with),
    else a short-lived uinput keyboard (python3-evdev; Hearth's controller support already needs /dev/uinput).
    On KWin (no virtual-keyboard protocol for wtype): hearth-type, Hearth's typing helper (docs/KWIN-INPUT.md)."""
    if os.environ.get('HEARTH_WM') == 'kwin':
        ht = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'hearth-type')
        try:
            r = subprocess.run([sys.executable, ht, '-M', 'ctrl', '-k', 'v', '-m', 'ctrl'], capture_output=True, timeout=8)
            if r.returncode == 0:
                return True
        except (OSError, subprocess.SubprocessError):
            pass
    elif shutil.which('wtype'):
        r = subprocess.run(['wtype', '-M', 'ctrl', '-k', 'v', '-m', 'ctrl'], capture_output=True, timeout=5)
        if r.returncode == 0:
            return True
    try:
        from evdev import UInput, ecodes as e
        with UInput({e.EV_KEY: [e.KEY_LEFTCTRL, e.KEY_V]}, name='hearth-clipboard-paste') as ui:
            time.sleep(0.35)       # the compositor picks the new keyboard up
            for code, val in ((e.KEY_LEFTCTRL, 1), (e.KEY_V, 1), (e.KEY_V, 0), (e.KEY_LEFTCTRL, 0)):
                ui.write(e.EV_KEY, code, val)
                ui.syn()
                time.sleep(0.02)
            time.sleep(0.1)
        return True
    except Exception:
        return False


# ------------------------------------------------------------------ selection and clipboard in step
def current(primary):
    """What's on the clipboard (or the selection) now, as bytes; None when it can't be read."""
    if 'HEARTH_CLIP_NOW' in os.environ:            # the tests: a file standing in for both
        try:
            with open(os.environ['HEARTH_CLIP_NOW'] + ('.primary' if primary else ''), 'rb') as f:
                return f.read()
        except OSError:
            return b''
    try:
        r = subprocess.run(['wl-paste', '--no-newline'] + (['--primary'] if primary else []), capture_output=True, timeout=3)
        return r.stdout if r.returncode == 0 else b''
    except (OSError, subprocess.SubprocessError):
        return None


def put(data, primary):
    if 'HEARTH_CLIP_NOW' in os.environ:
        with open(os.environ['HEARTH_CLIP_NOW'] + ('.primary' if primary else ''), 'wb') as f:
            f.write(data)
        return True
    try:
        p = subprocess.Popen(['wl-copy'] + (['--primary'] if primary else []), stdin=subprocess.PIPE,
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        p.stdin.write(data)
        p.stdin.close()
        p.wait(timeout=5)
    except subprocess.TimeoutExpired:
        pass
    except OSError:
        return False
    return True


def sync(data, from_primary, types=None, state=None):
    """Clipboard and selection in step: text that reached one is put on the other, unless it's there already (so the
    two watchers never bounce a copy back and forth) or it's a secret. Pictures stay on the clipboard only."""
    types = offered_types(from_primary) if types is None else types
    if not data or is_secret(types, state) or mime_of(data) or b'\x00' in data[:4096] or len(data) > MAX_BYTES:
        return False
    other = current(not from_primary)
    if other is None or other == data or other.rstrip(b'\n') == data.rstrip(b'\n'):
        return False
    return put(data, not from_primary)


# ------------------------------------------------------------------ actions on an item
URL_RE = re.compile(r'^(https?://|www\.)[^\s]{2,2000}$', re.I)


def item_text(iid):
    it = find(iid)
    if it['kind'] != 'text':
        raise Fail('that item is a picture')
    try:
        with open(os.path.join(data_dir(), it['file']), encoding='utf-8', errors='replace') as f:
            return it, f.read()
    except OSError:
        raise Fail('that item\'s copy is missing')


def link_of(text):
    t = text.strip()
    if not URL_RE.match(t):
        return ''
    return t if '://' in t else 'https://' + t


def browsers():
    return {'browsers': apps.apps_for('x-scheme-handler/https')}


def open_in(iid, app_id):
    _, text = item_text(iid)
    url = link_of(text)
    if not url:
        raise Fail('that item isn\'t a web link')
    try:
        apps.launch(app_id, url)
    except (ValueError, OSError) as e:
        raise Fail(str(e))
    return {'ok': True, 'id': iid, 'app': app_id}


def tvs():
    """Hearth TVs paired with this PC (Send to TV, docs/HEARTH-TV.md): [] when there are none or Hearth Link is off."""
    tool = shutil.which('hearth-send-to-tv') or '/usr/bin/hearth-send-to-tv'
    try:
        r = subprocess.run([sys.executable, tool, '--list'], capture_output=True, text=True, timeout=15)
        return {'tvs': [t for t in json.loads(r.stdout or '{}').get('tvs', []) if t.get('id') and t.get('name')]}
    except (OSError, ValueError, subprocess.SubprocessError):
        return {'tvs': []}


def send_tv(iid, tv):
    """A copied link plays on a Hearth TV (it's saved in the TV's Theater too)."""
    _, text = item_text(iid)
    url = link_of(text)
    if not url:
        raise Fail('that item isn\'t a web link')
    tool = shutil.which('hearth-send-to-tv') or '/usr/bin/hearth-send-to-tv'
    try:
        r = subprocess.run([sys.executable, tool, '--json', '--tv', tv, url], capture_output=True, text=True, timeout=60)
        v = json.loads((r.stdout or '').strip().splitlines()[-1])
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        raise Fail('couldn\'t send it to the TV (is Hearth Link on?)')
    if v.get('error'):
        raise Fail(v['error'])
    return {'ok': True, 'id': iid, 'tv': v.get('tv', '')}


QR_MAX = 2900


def qr(iid):
    _, text = item_text(iid)
    data = text.encode('utf-8')
    if len(data) > QR_MAX:
        raise Fail('that\'s too long for a QR code (%d characters at most)' % QR_MAX)
    if not shutil.which('qrencode'):
        raise Fail('QR codes need qrencode, which isn\'t installed')
    rt = os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'hearth-clipboard-qr')
    os.makedirs(rt, mode=0o700, exist_ok=True)
    for f in os.listdir(rt):           # one at a time: the last one's picture goes
        try:
            os.remove(os.path.join(rt, f))
        except OSError:
            pass
    path = os.path.join(rt, '%s-%d.png' % (iid, int(time.time() * 1000)))
    r = subprocess.run(['qrencode', '-o', path, '-s', '8', '-m', '2', '-l', 'M', '-r', '/dev/stdin'], input=data,
                       capture_output=True, timeout=20)
    if r.returncode != 0 or not os.path.isfile(path):
        raise Fail('couldn\'t make the QR code (%s)' % (r.stderr.decode('utf-8', 'replace').strip()[:120] or 'qrencode'))
    return {'ok': True, 'id': iid, 'path': path}


def edit(iid, new):
    """The item's text becomes NEW (kept where it is, pin and all). Empty text is refused: forget it instead."""
    it, _ = item_text(iid)
    if b'\x00' in new[:4096]:
        raise Fail('that isn\'t text')
    if len(new) > MAX_BYTES:
        raise Fail('that\'s too big')
    text = new.decode('utf-8', errors='replace')
    if not text.strip():
        raise Fail('the text is empty: forget the item instead')
    digest = hashlib.sha256(new).hexdigest()
    ensure_dir()
    hsio._atomic_bytes(os.path.join(data_dir(), it['file']), new, mode=0o600)

    def change(items):
        items = [i for i in items if i['id'] == iid or i['hash'] != digest or i['pinned']]   # no second copy of it
        for i in items:
            if i['id'] == iid:
                i.update({'text': text[:PREVIEW], 'hash': digest, 'size': len(new)})
        return items
    update(change)
    return {'ok': True, 'id': iid}


def paste(iid):
    copy(iid)
    time.sleep(0.2)            # the popup has closed and the app in front has the keyboard again
    return {'ok': True, 'id': iid, 'pasted': press_ctrl_v()}


def main(argv):
    c = argv[1] if len(argv) > 1 else ''
    a = argv[2:]
    if c == 'status' and not a:
        out = {'available': have(), 'wtype': bool(shutil.which('wtype')), 'qrencode': bool(shutil.which('qrencode'))}
    elif c == 'list' and not a:
        out = list_items()
    elif c == 'store' and set(a) <= {'--primary', '--keep', '--sync'}:
        data = sys.stdin.buffer.read(MAX_BYTES + 1)
        primary = '--primary' in a
        if primary and '--keep' not in a:
            out = {'stored': False, 'why': 'selection history is off'}
        else:
            out = store(data, primary=primary)
        if '--sync' in a:
            out['synced'] = sync(data, primary)
    elif c == 'browsers' and not a:
        out = browsers()
    elif c == 'open' and len(a) == 2:
        out = open_in(a[0], a[1])
    elif c == 'tvs' and not a:
        out = tvs()
    elif c == 'send-tv' and len(a) == 2:
        out = send_tv(a[0], a[1])
    elif c == 'qr' and len(a) == 1:
        out = qr(a[0])
    elif c == 'get' and len(a) == 1:
        out = {'id': a[0], 'text': item_text(a[0])[1][:200000]}
    elif c == 'edit' and len(a) == 1:
        out = edit(a[0], sys.stdin.buffer.read(MAX_BYTES + 1))
    elif c == 'paste' and len(a) == 1:
        out = paste(a[0])
    elif c == 'copy' and len(a) == 1:
        out = copy(a[0])
    elif c in ('pin', 'unpin') and len(a) == 1:
        out = set_pin(a[0], c == 'pin')
    elif c == 'delete' and len(a) == 1:
        out = delete(a[0])
    elif c in ('clear', 'wipe') and not a:
        out = clear()
    else:
        print('usage: hearth-clipboard status | list | store [--primary] [--keep] [--sync] | paste ID | copy ID | pin ID | unpin ID | delete ID | clear | browsers | open ID APP | tvs | send-tv ID TV | qr ID | edit ID')
        sys.exit(2)
    print(json.dumps(out), flush=True)


if __name__ == '__main__':
    try:
        main(sys.argv)
    except Fail as e:
        print('error: ' + str(e), flush=True)
        sys.exit(1)
