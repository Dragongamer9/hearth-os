        pcis = re.findall(r'[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]', real)
        out.append({'id': e, 'bus': int(bus) if bus.isdigit() else 0, 'port': root, 'depth': chain.count('.'),
                    'speed': m.read(base + '/speed') or '', 'vid': vid, 'pid': pid, 'name': name or ('USB device %s:%s' % (vid, pid)),
                    'kind': kind, 'panel': panel, 'controller': pcis[-1] if pcis else None, 'internal': False})
    # Built into the device (Bluetooth on a Wi-Fi card, a handheld's controls, a laptop's camera): "hardwired" ports.
    for d in out:
        ct = m.read('/sys/bus/usb/devices/usb%d/%d-0:1.0/usb%d-port%s/connect_type' % (d['bus'], d['bus'], d['bus'], d['port'])) or ''
        d['internal'] = ct == 'hardwired' or (d['kind'] == 'bluetooth' and d['depth'] == 0)
    return out


def usb_ports(m):
    """Rear and front USB ports the firmware describes (ACPI's physical_location), else None. A USB 3 port is two
    ports to Linux (its USB 2 half and its USB 3 half, "peers"): counted once."""
    seen = {}
    for p in m.glob('/sys/bus/usb/devices/usb*/*-0:1.0/usb*-port*'):
        panel = m.read(p + '/physical_location/panel') or ''
        ct = m.read(p + '/connect_type') or ''
        if not panel or ct in ('not used', 'hardwired'):
            continue
        hub = p.split('/')[5]
        speed = m.read('/sys/bus/usb/devices/%s/speed' % hub) or '480'
        rp = m.realpath(p)
        peer = m.realpath(p + '/peer') if m.exists(p + '/peer') else ''
        key = tuple(sorted(x for x in (rp, peer) if x))
        e = seen.setdefault(key, {'panel': panel, 'usb3': False, 'port': re.sub(r'^.*-port', '', p),
                                  'ids': sorted({os.path.basename(x) for x in key})})
        e['usb3'] = e['usb3'] or speed not in ('480', '12', '1.5')
    return list(seen.values()) or None


def parse_edid_name(raw):
    """The monitor's name from its EDID (descriptor 0xFC), or ''."""
    if len(raw) < 128 or raw[:8] != b'\x00\xff\xff\xff\xff\xff\xff\x00':
        return ''
    for i in range(54, 126, 18):
        blk = raw[i:i + 18]
        if blk[0:3] == b'\0\0\0' and blk[3] == 0xFC:
            return blk[5:18].split(b'\n')[0].decode('ascii', 'replace').strip()
    return ''


def integrated_gpu(d):
    """Built into the processor: on the root bus (Intel's, older AMD APUs) or behind AMD's internal bridge (00:08.x)."""
    if not d['upstream']:
        return True
    if d['vendorId'] == '8086' and not d['linkWidth']:
        return True
    return d['vendorId'] == '1002' and int(d['upstream'][0].split(':')[2].split('.')[0], 16) == 8


def gpus_detect(m, pci, cpu=None):
    out = []
    smi = parse_smi_full(m.cmd('nvidia-smi', ['nvidia-smi', '--query-gpu=' + ','.join(SMI_FIELDS), '--format=csv,noheader,nounits']))
    for d in [x for x in pci if x['kind'] == 'gpu']:
        g = {'pci': d['addr'], 'vendor': VENDORS.get(d['vendorId'], d['vendor']), 'name': d['name'], 'driver': d['driver'],
             'via': d['via'], 'link': gen_text(d['linkGen'], d['linkWidth']), 'maxLink': gen_text(d['slotGen'], d['slotWidth']),
             'linkGen': d['linkGen'], 'linkWidth': d['linkWidth'], 'integrated': integrated_gpu(d),
             'vram': None, 'vbios': '', 'outputs': [], 'card': ''}
        for card in m.glob('/sys/bus/pci/devices/%s/drm/card[0-9]*' % d['addr']):
            g['card'] = os.path.basename(card)
            vt = m.read_int(card + '/device/mem_info_vram_total')
            if vt:
                g['vram'] = vt
            g['vbios'] = m.read(card + '/device/vbios_version') or ''
            for c in m.glob('/sys/class/drm/%s-*' % g['card']):
                st = m.read(c + '/status') or ''
                conn = os.path.basename(c)[len(g['card']) + 1:]
                out_name = re.sub(r'-\d+$', '', conn).replace('HDMI-A', 'HDMI').replace('DP', 'DisplayPort').replace('eDP', 'Built-in screen')
                g['outputs'].append({'port': out_name, 'connected': st == 'connected', 'monitor': parse_edid_name(m.readbytes(c + '/edid')) if st == 'connected' else ''})
        nv = next((s for s in smi if s.get('pci') and s['pci'].endswith(d['addr'][-7:])), None)
        if d['vendorId'] == '10de' and smi and not nv:
            nv = smi[0]
        if nv:
            g.update({'name': nv['name'], 'vram': nv['vramTotal'], 'vbios': nv['vbios'], 'driverVersion': nv['driver'],
                      'wattsMax': nv['wattsMax']})
        br = re.search(r'\[([^\]]*(Radeon|GeForce|Arc|Graphics|Quadro|RTX)[^\]]*)\]', g['name'])
        g['name'] = br.group(1) if br else re.sub(r'\s*\[.*?\]\s*', ' ', g['name']).strip()
        if g['integrated'] and not re.search(r'Radeon|Graphics|Arc|GeForce|Vega|Iris', g['name']):
            g['name'] = 'Radeon graphics' if g['vendor'] == 'AMD' else 'Intel graphics' if g['vendor'] == 'Intel' else g['name']
        if g['vendor'] in ('NVIDIA', 'AMD', 'Intel') and not g['name'].startswith(g['vendor']):
            g['name'] = g['vendor'] + ' ' + g['name']
        out.append(g)
    return out


SUPERIO = ('nct', 'it8', 'f718', 'w836', 'asus_ec_sensors', 'asus-ec-sensors', 'dell_smm', 'thinkpad', 'asus', 'nzxt', 'corsair')


def sensors_detect(m):
    chip, fans, volts, temps, cmos = '', [], [], [], None
    for h in m.glob('/sys/class/hwmon/hwmon*'):
        name = m.read(h + '/name') or ''
        if name.startswith(('nct', 'it8', 'f71', 'w83')) and not chip:
            chip = name
        for f in m.glob(h + '/fan*_input'):
            rpm = m.read_int(f)
            n = re.sub(r'\D', '', os.path.basename(f))
            label = m.read(f.replace('_input', '_label')) or ''
            fans.append({'sensor': name, 'index': int(n or 0), 'label': label, 'rpm': rpm if rpm is not None else 0, 'live': h.split('/')[-1] + '/fan' + n})
        for v in m.glob(h + '/in*_input'):
            mv = m.read_int(v)
            label = m.read(v.replace('_input', '_label')) or ''
            if mv is None:
                continue
            volts.append({'sensor': name, 'label': label or os.path.basename(v)[:-6], 'v': round(mv / 1000, 3)})
            if re.search(r'(?i)vbat|^bat|cmos', label):
                cmos = round(mv / 1000, 2)
        for t in m.glob(h + '/temp*_input'):
            c = m.read_int(t)
            if c is None or c <= -40000 or c >= 150000 or c == 0:
                continue
            temps.append({'sensor': name, 'label': m.read(t.replace('_input', '_label')) or name, 'c': round(c / 1000, 1)})
    fans = [f for f in fans if f['sensor'] not in ('amdgpu', 'nouveau', 'nvidia', 'radeon')]
    return {'chip': chip, 'fans': fans, 'volts': volts[:16], 'temps': temps[:24], 'cmos': cmos}


def battery_detect(m):
    for d in m.glob('/sys/class/power_supply/*'):
        if (m.read(d + '/type') or '') != 'Battery' or (m.read(d + '/scope') or '') == 'Device':
            continue
        def num(k):
            return m.read_int(d + '/' + k)
        full, design = num('energy_full') or num('charge_full'), num('energy_full_design') or num('charge_full_design')
        volt = num('voltage_min_design') or num('voltage_now')
        wh = lambda x: round((x / 1e6) * ((volt / 1e6) if num('charge_full') and volt else 1), 1) if x else None
        return {'percent': num('capacity'), 'status': m.read(d + '/status') or '', 'cycles': num('cycle_count'),
                'fullWh': wh(full), 'designWh': wh(design), 'health': round(100.0 * full / design) if full and design else None,
                'maker': m.read(d + '/manufacturer') or '', 'model': m.read(d + '/model_name') or '',
                'tech': m.read(d + '/technology') or '', 'limit': num('charge_control_end_threshold')}
    return None


def net_detect(m, pci_by):
    out = []
    for n in m.listdir('/sys/class/net'):
        base = '/sys/class/net/' + n
        if n == 'lo' or not m.exists(base + '/device'):
            continue
        real = m.realpath(base + '/device')
        pcis = re.findall(r'[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]', real)
        usb = '/usb' in real
        pd = pci_by.get(pcis[-1]) if pcis and not usb else None
        mac = m.read(base + '/address') or ''
        speed = m.read_int(base + '/speed')
        out.append({'name': n, 'kind': 'wifi' if m.exists(base + '/wireless') or m.exists(base + '/phy80211') or n.startswith('wl') else 'ethernet',
                    'driver': os.path.basename(m.realpath(base + '/device/driver')) if m.exists(base + '/device/driver') else '',
                    'pci': pd['addr'] if pd else None, 'chip': pd['name'] if pd else '', 'via': pd['via'] if pd else ('chipset' if usb else ''),
                    'usb': usb, 'up': (m.read(base + '/operstate') or '') == 'up', 'speed': speed if speed and speed > 0 else None,
                    'mac': ':'.join(mac.split(':')[:3] + ['xx', 'xx', 'xx']) if mac else ''})
    return out


def audio_detect(m):
    out = []
    for c in m.glob('/proc/asound/card[0-9]*/codec#[0-9]*'):
        first = (m.read(c) or '').splitlines()
        codec = next((l.split(':', 1)[1].strip() for l in first if l.startswith('Codec:')), '')
        if codec and not re.search(r'(?i)hdmi|nvidia|ati r|intel.*display|generic', codec):
            out.append(codec)
    return out


DDR_SPEED_NAME = {'DDR3': 'DDR3', 'DDR4': 'DDR4', 'DDR5': 'DDR5', 'LPDDR4': 'LPDDR4', 'LPDDR4X': 'LPDDR4X',
                  'LPDDR5': 'LPDDR5', 'LPDDR5X': 'LPDDR5X'}


def channel_of(locator, bank=''):
    """The memory channel from a slot's names ("DIMM_A2", "ChannelB-DIMM1", "A1_DIMM0", "BANK 2"), or ''."""
    for s in (locator or '', bank or ''):
        m = re.search(r'(?i)channel\s*([A-H])', s) or re.search(r'(?i)(?:dimm|ddr\d?)[_ -]?([A-H])\d', s) \
            or re.search(r'(?i)^([A-H])\d', s) or re.search(r'(?i)\bP\d_?Node\d_?Channel([A-H])', s) or re.search(r'(?i)CHANNEL ?([A-H])', s)
        if m:
            return m.group(1).upper()
    m = re.search(r'(?i)bank\s*(\d)', bank or '')
    if m:
        return 'AB'[int(m.group(1)) % 2]
    return ''


def memory_from(m, hw):
    """Memory slots: DMI type 17 (from the helper), else EDAC (no root), else sizes only."""
    slots, source = [], 'none'
    mem = (hw or {}).get('memory') or {}
    for i, dv in enumerate(mem.get('devices') or []):
        if not isinstance(dv, dict):
            continue
        size = dv.get('size') or 0
        slots.append({'locator': str(dv.get('locator') or 'Slot %d' % (i + 1))[:40], 'bank': str(dv.get('bank') or '')[:40],
                      'size': size, 'type': str(dv.get('type') or ''), 'formFactor': str(dv.get('formFactor') or ''),
                      'speed': dv.get('speed'), 'configured': dv.get('configuredSpeed'), 'maker': str(dv.get('manufacturer') or '')[:40],
                      'part': str(dv.get('partNumber') or '').strip()[:40], 'rank': dv.get('rank'), 'voltage': dv.get('configuredVoltage') or dv.get('voltage'),
                      'empty': not size, 'channel': channel_of(dv.get('locator'), dv.get('bank'))})
        source = 'dmi'
    if not slots:
        for d in m.glob('/sys/devices/system/edac/mc/mc*/dimm*'):
            size = (m.read_int(d + '/size') or 0) * 1048576
            label = m.read(d + '/dimm_label') or os.path.basename(d)
            slots.append({'locator': label, 'bank': '', 'size': size, 'type': m.read(d + '/dimm_mem_type') or '',
                          'formFactor': '', 'speed': None, 'configured': None, 'maker': '', 'part': '', 'rank': None,
                          'voltage': None, 'empty': not size, 'channel': channel_of(label)})
            source = 'edac'
    arrays = mem.get('arrays') or []
    max_cap = max((a.get('maxCapacity') or 0 for a in arrays if isinstance(a, dict)), default=0)
    mi = ht.parse_meminfo(m.read('/proc/meminfo', '') or '')
    soldered = any(re.search(r'(?i)LPDDR|row of chips|board|onboard|soldered', (s['type'] + ' ' + s['formFactor'] + ' ' + s['locator'])) for s in slots if not s['empty'])
    return {'slots': slots, 'source': source, 'maxCapacity': max_cap, 'total': mi.get('MemTotal', 0),
            'installed': sum(s['size'] for s in slots) or installed_memory(m.p('/sys')) or mi.get('MemTotal', 0),
            'soldered': soldered, 'type': next((s['type'] for s in slots if not s['empty'] and s['type']), '')}


def hwinfo_load(m, refresh=False, use_helper=True):
    """The memory and slot tables (DMI types 16, 17, 8, 9): the fixture's, the cache, or once from the root helper."""
    if m.hwinfo is not None:
        return m.hwinfo, 'fixture'
    if m.root:
        return {}, 'none'
    key = '|'.join([m.read('/sys/class/dmi/id/board_name') or '', m.read('/sys/class/dmi/id/product_name') or '',
                    m.read('/sys/class/dmi/id/bios_version') or '', str(installed_memory('/sys') or 0)])
    c = read_cache('resmon-hwinfo.json')
    if c and c.get('key') == key and not refresh:
        return c.get('data') or {}, 'cache'
    if not use_helper or not os.path.exists(HWINFO_HELPER) or not shutil.which('pkexec'):
        return (c or {}).get('data') or {}, 'none'
    try:
        r = subprocess.run(['pkexec', '--disable-internal-agent', HWINFO_HELPER], capture_output=True, text=True, timeout=20,
                           stdin=subprocess.DEVNULL)
        data = json.loads(r.stdout.strip().splitlines()[-1]) if r.returncode == 0 and r.stdout.strip() else None
    except (OSError, subprocess.TimeoutExpired, ValueError, IndexError):
        data = None
    if isinstance(data, dict) and data.get('ok'):
        data = {k: data[k] for k in ('memory', 'slots', 'ports') if k in data}
        write_cache('resmon-hwinfo.json', {'key': key, 't': int(time.time()), 'data': data})
        return data, 'helper'
    return (c or {}).get('data') or {}, 'none'


def detect(m, refresh=False, use_helper=True):
    """Everything "Your PC" knows about this machine. Every part is read on its own: one that fails is just missing."""
    out = {'v': 1}

    def safe(name, fn, default=None):
        try:
            out[name] = fn()
        except Exception as e:   # partial data is fine; never a broken picture
            out[name] = default
            out.setdefault('problems', []).append('%s: %s' % (name, str(e)[:120]))

    safe('dmi', lambda: dmi(m), {})
    fam, hid = family_of(out['dmi'] or {})
    out['family'], out['handheld'] = fam, hid
    safe('cpu', lambda: cpu_detect(m), {'name': '', 'vendor': ''})
    intel = (out['cpu'] or {}).get('vendor') == 'Intel'
    safe('pci', lambda: pci_detect(m, intel), [])
    pci_by = {d['addr']: d for d in out['pci'] or []}
    hw, src = hwinfo_load(m, refresh, use_helper)
    out['hwinfoSource'] = src
    safe('memory', lambda: memory_from(m, hw), {'slots': [], 'source': 'none'})
    out['dmiSlots'] = [s for s in (hw.get('slots') or []) if isinstance(s, dict)][:24]
    out['dmiPorts'] = [p for p in (hw.get('ports') or []) if isinstance(p, dict)][:48]
    safe('drives', lambda: drives_detect(m, pci_by), [])
    safe('sata', lambda: ata_ports(m), [])
    safe('optical', lambda: optical_detect(m), [])
    safe('usb', lambda: usb_detect(m), [])
    safe('usbPorts', lambda: usb_ports(m), None)
    safe('gpus', lambda: gpus_detect(m, out['pci'] or []), [])
    safe('sensors', lambda: sensors_detect(m), {'chip': '', 'fans': [], 'volts': [], 'temps': [], 'cmos': None})
    safe('battery', lambda: battery_detect(m), None)
    safe('net', lambda: net_detect(m, pci_by), [])
    safe('audio', lambda: audio_detect(m), [])
    d = out['dmi'] or {}
    lpc = next((x['name'] for x in out['pci'] or [] if x['kind'] == 'lpc'), '')
    out['chipset'] = chipset_of(d.get('board_name', ''), lpc) if fam == 'desktop' else ''
    long_slots = len([s for s in out['dmiSlots'] if (s.get('width') or 0) >= 8]) or len([g for g in out['gpus'] if not g['integrated']])
    out['formFactor'] = form_factor(d.get('board_name', ''), len(out['memory'].get('slots') or []), long_slots, fam) if fam == 'desktop' else ''
    return out


