def pci_detect(m, family_intel):
    names = pci_names(m)
    devs = []
    for addr in m.listdir('/sys/bus/pci/devices'):
        base = '/sys/bus/pci/devices/' + addr
        cls = (m.read(base + '/class') or '0x000000')[2:6]
        vendor = (m.read(base + '/vendor') or '')[2:]
        device = (m.read(base + '/device') or '')[2:]
        kind = PCI_CLASS.get(cls, 'other')
        real = m.realpath(base)
        chain = [x for x in real.split('/') if re.fullmatch(r'[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]', x)]
        upstream = chain[:-1]
        nm = names.get(addr)
        d = {'addr': addr, 'class': cls, 'kind': kind, 'vendorId': vendor, 'deviceId': device,
             'vendor': (nm[0] if nm else '') or VENDORS.get(vendor, vendor),
             'name': (nm[1] if nm else '') or ('%s %s:%s' % (VENDORS.get(vendor, 'Device'), vendor, device)),
             'subVendor': nm[2] if nm else '',
             'driver': os.path.basename(m.realpath(base + '/driver')) if m.exists(base + '/driver') else '',
             'linkGen': link_gen(m.read(base + '/current_link_speed')), 'linkWidth': m.read_int(base + '/current_link_width'),
             'maxGen': link_gen(m.read(base + '/max_link_speed')), 'maxWidth': m.read_int(base + '/max_link_width'),
             'upstream': upstream, 'root': upstream[0] if upstream else None}
        if d['linkWidth'] == 0:
            d['linkWidth'] = None
        devs.append(d)
    by = {d['addr']: d for d in devs}
    for d in devs:
        d['via'] = pci_via(d, by, family_intel)
        # The slot's own width: the port above it (a x16 slot wired x4 says so), else the device's max.
        up = by.get(d['upstream'][-1]) if d['upstream'] else None
        d['slotWidth'] = (up or {}).get('maxWidth') or d['maxWidth']
        d['slotGen'] = (up or {}).get('maxGen') or d['maxGen']
    return devs


def pci_via(d, by, intel):
    """'cpu' or 'chipset': which one the device hangs off."""
    addr = d['addr']
    if not d['upstream']:
        dev = int(addr.split(':')[2].split('.')[0], 16)
        if intel:
            return 'cpu' if dev in (0, 1, 2, 4, 6, 7, 8, 0x0a, 0x0d) else 'chipset'
        return 'chipset' if dev in (0x11, 0x12, 0x13, 0x14, 0x16) else 'cpu'
    for up in d['upstream']:
        u = by.get(up) or {}
        if u.get('vendorId') == '1022' and u.get('deviceId') in PROMONTORY:
            return 'chipset'
        if u.get('vendorId') == '1b21' and u.get('kind') == 'bridge':
            return 'chipset'
    root = d['upstream'][0]
    dev = int(root.split(':')[2].split('.')[0], 16)
    if intel:
        return 'chipset' if dev in (0x1b, 0x1c, 0x1d) else 'cpu'
    return 'chipset' if dev in (0x14, 0x15) else 'cpu'


def gen_text(gen, width):
    if not gen and not width:
        return ''
    return ('PCIe %d.0' % gen if gen else 'PCIe') + (' x%d' % width if width else '')


def drives_detect(m, pci_by, mounts_text=None):
    out = []
    if mounts_text is None:
        mounts_text = m.read('/proc/mounts', '') or ''
    letters = None if m.root else ht.read_drive_letters()
    try:
        layout = ht.disk_layout(m.p('/sys'), mounts_text=mounts_text, letters=letters)
    except Exception:
        layout = []
    for x in layout:
        name = x['name']
        real = m.realpath('/sys/block/' + name)
        pcis = re.findall(r'[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]', real)
        ata = re.search(r'/ata(\d+)/', real)
        usb = '/usb' in real
        kind = 'nvme' if name.startswith('nvme') else 'sd' if name.startswith('mmcblk') else 'usb' if usb else (
            'hdd' if m.read_int('/sys/block/%s/queue/rotational' % name) == 1 else 'ssd')
        model = (m.read('/sys/block/%s/device/model' % name) or '').strip()
        vendor = (m.read('/sys/block/%s/device/vendor' % name) or '').strip()
        if vendor and vendor.upper() not in ('ATA', '') and not model.lower().startswith(vendor.lower()):
            model = vendor + ' ' + model
        fw = m.read('/sys/block/%s/device/firmware_rev' % name) or m.read('/sys/block/%s/device/rev' % name) or ''
        pci = pcis[-1] if pcis else None
        pd = pci_by.get(pci) or {}
        out.append({'name': name, 'model': model, 'kind': kind, 'size': x['size'], 'system': x['system'],
                    'letters': x['letters'], 'mounts': x['mounts'][:4], 'pci': pci, 'ataPort': int(ata.group(1)) if ata else None,
                    'firmware': fw.strip(), 'via': pd.get('via') if kind == 'nvme' else ('chipset' if ata else pd.get('via')),
                    'link': gen_text(pd.get('linkGen'), pd.get('linkWidth')) if kind == 'nvme' else '',
                    'sataSpeed': (m.read('/sys/class/ata_link/link%s/sata_spd' % ata.group(1)) or '') if ata else '',
                    'removable': m.read_int('/sys/block/%s/removable' % name) == 1})
    return out


def optical_detect(m):
    """DVD and Blu-ray drives (disk_layout leaves them out: no size without a disc): [{name, model, ataPort, disc}]."""
    out = []
    for name in m.listdir('/sys/block'):
        if not name.startswith('sr'):
            continue
        real = m.realpath('/sys/block/' + name)
        ata = re.search(r'/ata(\d+)/', real)
        model = (m.read('/sys/block/%s/device/model' % name) or '').strip()
        size = (m.read_int('/sys/block/%s/size' % name) or 0) * 512
        out.append({'name': name, 'model': model or 'Optical drive', 'ataPort': int(ata.group(1)) if ata else None, 'disc': size > 0, 'size': size})
    return out


def ata_ports(m):
    """How many SATA ports the board's controllers have (ata1…ataN), and which are in use."""
    return sorted(int(re.sub(r'\D', '', x) or 0) for x in m.listdir('/sys/class/ata_port') if x.startswith('ata'))


