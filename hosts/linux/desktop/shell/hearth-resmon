def tips_for(pc):
    """Helpful tips, only when the data shows them true: [{id, part, text}]."""
    tips = []
    drives = pc.get('drives') or []
    sysd = next((d for d in drives if d['system']), None)
    if sysd and sysd['kind'] == 'hdd':
        tips.append({'id': 'hdd-system', 'part': 'drive:' + sysd['name'], 'text': 'Hearth runs from a hard drive. Moving it to an SSD (SATA or M.2) is the biggest speed-up this PC can get: start-up and loading get several times faster.'})
    m2 = [s for s in pc.get('dmiSlots') or [] if re.search(r'(?i)m\.?2', s.get('designation', '')) and not re.search(r'(?i)wifi|wlan|e[- ]?key', s.get('designation', ''))]
    if m2 and any(s.get('usage') == 'available' for s in m2):
        free = [s for s in m2 if s.get('usage') == 'available']
        tips.append({'id': 'm2-empty', 'part': 'm2:' + free[0].get('designation', ''), 'text': 'An M.2 slot is empty (%s): room for a fast NVMe drive, great for games.' % free[0].get('designation', 'M.2')})
    slots = (pc.get('memory') or {}).get('slots') or []
    full = [s for s in slots if not s['empty']]
    chans = {s['channel'] for s in slots if s['channel']}
    used = {s['channel'] for s in full if s['channel']}
    if len(full) >= 2 and len(chans) >= 2 and len(used) == 1:
        tips.append({'id': 'mem-channel', 'part': 'mem', 'text': 'All your memory sticks are on channel %s. Moving one to channel %s runs them in dual channel: faster for games, nothing to buy.' % (sorted(used)[0], sorted(chans - used)[0])})
    elif len(full) == 1 and len(chans) >= 2 and pc.get('family') == 'desktop':
        tips.append({'id': 'mem-single', 'part': 'mem', 'text': 'One memory stick runs in single channel. A second, matching stick in the other channel makes games noticeably smoother.'})
    cmos = (pc.get('sensors') or {}).get('cmos')
    if cmos and 1.0 < cmos < 2.95:
        tips.append({'id': 'cmos-low', 'part': 'batt', 'text': 'The CMOS battery reads %.2f V: getting low. When the clock starts losing time, replace it (a CR2032 coin cell).' % cmos})
    if not any(n['kind'] == 'wifi' for n in pc.get('net') or []) and pc.get('family') in ('desktop', 'laptop'):
        tips.append({'id': 'no-wifi', 'part': 'net', 'text': 'No Wi-Fi in this PC. Ethernet is best for games; a USB Wi-Fi adapter or a Wi-Fi card in a free PCIe x1 slot also works with Hearth.'})
    return tips


def build_view(pc):
    lay = layout_choice(pc)
    try:
        if lay['family'] == 'handheld':
            v = view_handheld(pc, lay)
        elif lay['family'] == 'laptop':
            v = view_laptop(pc, lay)
        else:
            v = view_desktop(pc, lay)
    except Exception as e:   # never a broken picture: the generic layout with what's known
        lay = dict(lay, template='generic', why='The drawing for this machine failed (%s): the generic one' % str(e)[:80])
        clean = dict(pc)
        for k in ('drives', 'gpus', 'net', 'usb', 'pci', 'optical', 'dmiSlots', 'dmiPorts'):
            clean[k] = [x for x in (pc.get(k) or []) if isinstance(x, dict)]
        for k in ('cpu', 'memory', 'dmi', 'sensors'):
            clean[k] = pc.get(k) if isinstance(pc.get(k), dict) else {}
        try:
            v = view_generic(clean, lay)
        except Exception:   # the last resort: the processor alone
            b = Board({}, {})
            b.add('cpu', 'Processor', 'cpu', 345, 242, 180, 180, 'cpu', None, 0, 'on', 'Processor', str((clean['cpu'] or {}).get('name') or 'Processor'), [], '', live='cpu')
            v = {'name': 'This PC', 'crumb': 'Your PC', 'sub': 'Generic layout', 'stage': 'board', 'w': 870, 'h': 664,
                 'shapes': [{'d': 'M0 0 H870 V664 H0 Z', 'fill': 'board', 'stroke': '#2a2f36', 'sw': 2}], 'caps': [], 'silk': [], 'hubs': {},
                 'hubNames': {}, 'parts': b.parts, 'def': 'cpu'}
        pc = clean
    v['layout'] = lay
    try:
        v['tips'] = tips_for(pc)
    except Exception:
        v['tips'] = []
    return v


