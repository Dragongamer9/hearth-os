def layout_choice(pc):
    """{family, template, why}: the drawing for this machine (docs/RESOURCE-MONITOR.md, "How the drawing is chosen")."""
    fam = pc.get('family') or 'desktop'
    if fam == 'handheld':
        hid = pc.get('handheld')
        if hid:
            return {'family': 'handheld', 'template': 'handheld:' + hid, 'why': 'Known handheld from its DMI name (%s)' % handheld_name(hid)}
        return {'family': 'handheld', 'template': 'handheld:generic', 'why': 'A handheld Hearth has no built-in drawing for: the generic handheld'}
    if fam == 'laptop':
        return {'family': 'laptop', 'template': 'laptop', 'why': 'The chassis says laptop'}
    ff = pc.get('formFactor') or 'ATX'
    known = bool((pc.get('dmi') or {}).get('board_name')) and bool(pc.get('pci'))
    t = {'ATX': 'atx', 'mATX': 'matx', 'ITX': 'itx'}.get(ff, 'atx')
    return {'family': 'desktop', 'template': t if known else 'generic', 'why': (
        '%s board, from its name and slots' % ff) if known else "The board didn't say enough: a generic desktop board"}


def gb(n):
    if not n:
        return '0 GB'
    g = n / 1073741824
    return ('%d GB' % round(g)) if g >= 10 or abs(g - round(g)) < 0.05 else ('%.1f GB' % g)


def size_text(n):
    if not n:
        return ''
    t = n / 1e12
    return ('%.0f TB' % t if t >= 1.95 or abs(t - round(t)) < 0.05 else '%.1f TB' % t) if t >= 1 else '%d GB' % round(n / 1e9)


def short(s, n=34):
    s = s or ''
    return s if len(s) <= n else s[:n - 1] + '…'


class Board:
    """Collects the drawing's parts (Resource Monitor draws them as they are). A part:
    {id, text, style, x, y, w, h, kind, hub, lanes, status, title, dev, specs, link, live, action, vertical}."""

    def __init__(self, hubs, hub_names):
        self.parts, self.hubs, self.hub_names, self.ids = [], hubs, hub_names, set()

    def add(self, pid, text, style, x, y, w, h, kind, hub, lanes, status, title, dev, specs, link, live=None, action=None, **extra):
        if pid in self.ids:
            return None
        self.ids.add(pid)
        part = {'id': pid, 'text': text, 'style': style, 'x': int(x), 'y': int(y), 'w': int(w), 'h': int(h), 'kind': kind,
                'hub': hub, 'lanes': int(lanes or 0), 'status': status, 'title': title, 'dev': dev,
                'specs': [[k, str(v)] for k, v in specs if v not in (None, '', [])], 'link': link, 'live': live,
                'action': action}
        part.update(extra)
        self.parts.append(part)
        return part


