class Machine:
    """Where to read from: the real / (default), or a fixture's folder (tests, CI pictures). Paths are absolute
    ("/sys/…"); cmds are command outputs a fixture gives instead of running them."""

    def __init__(self, root='/', cmds=None, hwinfo=None, run_cmds=True):
        self.root = root.rstrip('/') or ''
        self.cmds = cmds or {}
        self.hwinfo = hwinfo
        self.run_cmds = run_cmds and not self.root

    def p(self, path):
        return self.root + path

    def read(self, path, default=None):
        t = read(self.p(path), default)
        return t.strip() if isinstance(t, str) else t

    def read_int(self, path):
        return read_int(self.p(path))

    def exists(self, path):
        return os.path.exists(self.p(path))

    def listdir(self, path):
        try:
            return sorted(os.listdir(self.p(path)))
        except OSError:
            return []

    def glob(self, pattern):
        n = len(self.root)
        return sorted(x[n:] for x in glob.glob(self.p(pattern)))

    def realpath(self, path):
        r = os.path.realpath(self.p(path))
        return r[len(self.root):] if self.root and r.startswith(self.root) else r

    def readbytes(self, path):
        try:
            with open(self.p(path), 'rb') as f:
                return f.read(4096)
        except OSError:
            return b''

    def cmd(self, name, argv, timeout=4):
        if name in self.cmds:
            return self.cmds[name]
        if not self.run_cmds or not shutil.which(argv[0]):
            return ''
        try:
            r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
            return r.stdout if r.returncode == 0 else ''
        except (OSError, subprocess.TimeoutExpired):
            return ''


