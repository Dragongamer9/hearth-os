def cpu_detect(m):
    info = {'name': '', 'vendor': '', 'threads': 0, 'cores': 0, 'mhzMax': None, 'mhzBase': None, 'l3': None,
            'flags': [], 'igpu': None, 'socket': '', 'family': ''}
    phys = core = None
    cores = set()
    for line in (m.read('/proc/cpuinfo', '') or '').splitlines():
        k, _, v = line.partition(':')
        k, v = k.strip(), v.strip()
        if k == 'processor':
            info['threads'] += 1
        elif k == 'model name' and not info['name']:
            info['name'] = re.sub(r'\s+', ' ', v).replace('(R)', '').replace('(TM)', '').replace(' CPU', '').strip()
        elif k == 'vendor_id' and not info['vendor']:
            info['vendor'] = {'GenuineIntel': 'Intel', 'AuthenticAMD': 'AMD'}.get(v, v)
        elif k == 'physical id':
            phys = v
        elif k == 'core id':
            core = v
            cores.add((phys, core))
        elif k == 'flags' and not info['flags']:
            info['flags'] = [f for f in v.split() if f in ('avx2', 'avx512f', 'vmx', 'svm', 'sse4_2')]
    info['name'] = re.sub(r'\s*@.*$', '', info['name'])
    info['name'] = re.sub(r'\s+(\d+-Core|Quad-Core|Six-Core|Eight-Core) Processor$', '', info['name'])
    info['name'] = re.sub(r'\s+with Radeon.*$', '', info['name']).replace(' Processor', '').strip()
    info['cores'] = len(cores) or info['threads']
    mx = m.read_int('/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq')
    base = m.read_int('/sys/devices/system/cpu/cpu0/cpufreq/base_frequency')
    info['mhzMax'] = round(mx / 1000) if mx else None
    info['mhzBase'] = round(base / 1000) if base else None
    l3 = 0
    seen = set()
    for idx in m.glob('/sys/devices/system/cpu/cpu[0-9]*/cache/index3'):
        share = m.read(idx + '/shared_cpu_list') or ''
        size = m.read(idx + '/size') or ''
        if share in seen:
            continue
        seen.add(share)
        mm = re.match(r'(\d+)([KM]?)', size)
        if mm:
            l3 += int(mm.group(1)) * (1024 if mm.group(2) == 'K' else 1048576 if mm.group(2) == 'M' else 1)
    info['l3'] = l3 or None
    for rx, sock in SOCKETS:
        if re.search(rx, info['name']):
            info['socket'] = sock
            break
    for rx, fam in APU_NAMES:
        if re.search(rx, info['name']):
            info['family'] = fam
    # An Intel "F" model has no graphics; AMD APUs (A-series, G models, mobile) do.
    n = info['name']
    if info['vendor'] == 'Intel':
        info['igpu'] = not re.search(r'\d{4,5}K?F\b', n)
    elif re.search(r'(?i)\bA\d+-\d{4}|\d{4}G\b|\d{4}[HU]S?\b|Z1|Z2|Custom APU|\b\d{3}M\b|ryzen ai', n):
        info['igpu'] = True
    elif info['vendor'] == 'AMD':
        info['igpu'] = None
    return info


def chipset_of(board_name, lpc_name=''):
    """The chipset from the board's name ("PRO B760M-A" → B760, "FM2A88X Extreme6+" → A88X), else the LPC bridge's."""
    for src in (board_name or '', lpc_name or ''):
        t = src.upper().replace('_', ' ')
        m = re.search(r'(?:FM2\+?|AM[345])?([ABHXZQW][0-9]{2,3}[EX]?)(?=M\b|M[- ]|[-\s+]|$)', t)
        if m:
            return m.group(1)
    return ''


def form_factor(board_name, slots, pcie_long, family):
    """ATX, mATX or ITX: from the board's name, else from its slots."""
    n = (board_name or '').upper()
    if re.search(r'ITX|-I\b|[0-9]I\b', n):
        return 'ITX'
    if re.search(r'M-?ATX|MICRO|[0-9]M\b|[0-9]M[- ]|[0-9]M$', n):
        return 'mATX'
    if re.search(r'\bE-?ATX\b|\bATX\b', n):
        return 'ATX'
    if slots and slots <= 2 and pcie_long <= 1:
        return 'ITX'
    if slots and slots >= 4 and pcie_long >= 2:
        return 'ATX'
    if pcie_long >= 3:
        return 'ATX'
    return 'mATX' if slots and slots <= 2 else 'ATX'


