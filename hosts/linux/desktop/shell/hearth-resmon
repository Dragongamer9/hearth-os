def serve(fd_in=0, out=None, max_samples=None):
    """Like hearth-tasks serve: JSON lines in ({"interval": 1, "want": [...]}, {"now": true}), samples out, until stdin
    closes (the window closed)."""
    import select
    out = out or sys.stdout
    s = ResSampler()
    interval, want = 1.0, []
    buf, due, sent = b'', 0.0, 0
    while True:
        timeout = None if due is None else max(0.0, due - time.monotonic())
        r, _, _ = select.select([fd_in], [], [], timeout)
        if r:
            chunk = os.read(fd_in, 65536)
            if not chunk:
                return sent
            buf += chunk
            while b'\n' in buf:
                line, buf = buf.split(b'\n', 1)
                try:
                    msg = json.loads(line.decode('utf-8') or '{}')
                except ValueError:
                    continue
                if not isinstance(msg, dict):
                    continue
                if 'interval' in msg:
                    try:
                        interval = max(0.0, min(10.0, float(msg['interval'])))
                    except (TypeError, ValueError):
                        pass
                if isinstance(msg.get('want'), list):
                    want = [str(w) for w in msg['want']][:8]
                if msg.get('now') or 'interval' in msg or 'want' in msg:
                    due = 0.0
            continue
        try:
            sample = s.sample(want)
        except Fail as e:
            sample = {'error': str(e)}
        out.write(json.dumps(sample, separators=(',', ':')) + '\n')
        out.flush()
        sent += 1
        if max_samples and sent >= max_samples:
            return sent
        due = time.monotonic() + interval if interval > 0 else None


