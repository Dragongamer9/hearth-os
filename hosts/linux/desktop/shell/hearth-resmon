def pc_command(args):
    refresh = '--refresh' in args
    use_helper = '--no-helper' not in args
    fixture = None
    if '--fixture' in args:
        i = args.index('--fixture')
        if i + 1 >= len(args):
            raise Fail('--fixture needs a file')
        fixture = args[i + 1]
    if fixture:
        with open(fixture) as f:
            fx = json.load(f)
        with tempfile.TemporaryDirectory(prefix='hearth-resmon-') as root:
            materialize(fx, root)
            m = Machine(root, cmds=fx.get('cmds') or {}, hwinfo=fx.get('hwinfo') or {})
            pc = detect(m, refresh, False)
            pc['fixture'] = fx.get('name') or os.path.basename(fixture)
    else:
        pc = detect(Machine('/'), refresh, use_helper)
    return {'pc': pc, 'view': build_view(pc)}


def materialize(fx, root):
    """A fixture ({files: {path: text}, links: {path: target}}) as a folder tree (sysfs is files and relative links)."""
    import base64
    for path, text in (fx.get('files') or {}).items():
        p = os.path.join(root, path.lstrip('/'))
        os.makedirs(os.path.dirname(p), exist_ok=True)
        if text.startswith('base64:'):
            with open(p, 'wb') as f:
                f.write(base64.b64decode(text[7:]))
            continue
        with open(p, 'w') as f:
            f.write(text if text.endswith('\n') or text == '' else text + '\n')
    for path, target in (fx.get('links') or {}).items():
        p = os.path.join(root, path.lstrip('/'))
        os.makedirs(os.path.dirname(p), exist_ok=True)
        if target.startswith('/'):
            target = os.path.relpath(os.path.join(root, target.lstrip('/')), os.path.dirname(p))
        if not os.path.lexists(p):
            os.symlink(target, p)
    for path in fx.get('dirs') or []:
        os.makedirs(os.path.join(root, path.lstrip('/')), exist_ok=True)


# ====================================================================== Game Mode: pause downloads and backups
def home_server(args, timeout=10):
    helper = os.path.join(HERE, 'hearth-home-server')
    if not os.path.exists(helper):
        return None
    try:
        r = subprocess.run([sys.executable, helper] + args, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        line = (r.stdout.strip().splitlines() or [''])[-1]
        return json.loads(line) if line.startswith('{') else None
    except (OSError, subprocess.TimeoutExpired, ValueError):
        return None


def pause(action, hs=home_server):
    """Only Hearth's existing pauses (docs/RESOURCE-MONITOR.md): the home server's big jobs (backups, snapshots, AI) wait
    while you play when Light mode is on, and its runtime flag lets them through for now. on/off change only that
    runtime flag (gone after a restart: session-only); light-on is the one setting, and only when the person pressed it.
    Downloads are paused by Game Mode itself (Steam's own pause, Hearth's downloads.pauseAll)."""
    if action not in ('status', 'on', 'off', 'light-on'):
        raise Fail('unknown pause action ' + action)
    if action == 'on':
        hs(['resume', 'off'])
    elif action == 'off':
        hs(['resume', 'on'])
    elif action == 'light-on':
        hs(['quick-set', 'lightMode', 'on'])
    q = hs(['quick']) or {}
    has = bool(q.get('available')) and (bool(q.get('setupDone')) or (q.get('backups') or {}).get('count', 0) > 0)
    light = q.get('lightMode') is not False if q else None
    return {'backups': {'available': has, 'count': (q.get('backups') or {}).get('count', 0), 'lightMode': light,
                        'resumed': bool(q.get('resumed')), 'paused': q.get('paused') or [],
                        'waiting': light is True and not q.get('resumed')},
            'needsOption': has and light is False}


# ====================================================================== main
def open_window(tab=''):
    shell = os.environ.get('NIMBUS_SHARE', '/usr/share/nimbus') + '/desktop/shell'
    if not os.path.isdir(shell):
        shell = HERE
    args = ['quickshell', 'ipc', '-p', shell, 'call', 'resmon'] + (['tab', tab] if tab else ['open'])
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=10)
        if r.returncode == 0:
            return {'opened': tab or 'pc'}
    except (OSError, subprocess.TimeoutExpired):
        pass
    raise Fail("Hearth's desktop (Mantel) isn't running; open Resource Monitor from Desktop Mode")


def cmd(argv):
    c = argv[1] if len(argv) > 1 else 'open'
    rest = argv[2:]
    if c == 'open':
        out = open_window(rest[0] if rest else '')
    elif c == 'serve' and not rest:
        serve()
        return
    elif c == 'sample':
        s = ResSampler()
        if rest == ['brief']:
            s.sample(['procs', 'gpu', 'temps'])
            time.sleep(0.4)
            out = brief(s)
        else:
            s.sample(rest)
            time.sleep(0.5)
            out = s.sample(rest)
    elif c == 'pc':
        out = pc_command(rest)
    elif c == 'pause' and len(rest) == 1:
        out = pause(rest[0])
    elif c in ('end', 'kill', 'eco', 'end-pid', 'kill-pid'):
        ht.cmd(['hearth-tasks', c] + rest)
        return
    else:
        print(__doc__.strip().split('\n\n')[0])
        sys.exit(2)
    print(json.dumps(out, separators=(',', ':')))


if __name__ == '__main__':
    try:
        cmd(sys.argv)
    except (Fail, OSError, ValueError, subprocess.TimeoutExpired) as e:
        print('error: ' + str(e))
        sys.exit(1)
