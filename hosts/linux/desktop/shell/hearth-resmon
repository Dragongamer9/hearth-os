#!/usr/bin/python3
"""hearth-resmon: what Hearth Resource Monitor shows (ResourceMonitor.qml, docs/RESOURCE-MONITOR.md).

  hearth-resmon [open [TAB]]         open the Resource Monitor window in Mantel (TAB: pc overview cpu memory disk
                                     network gpu); the Run box, Super+X and the app menu call this name
  hearth-resmon serve                the sampler the window reads while it's open (one JSON line per sample on stdout;
                                     told on stdin how often and what the tab on show needs, like hearth-tasks serve)
  hearth-resmon sample [WANT…]       one sample as serve gives it (WANT: procs mem disk net gpu temps), for checks
  hearth-resmon sample brief         Game Mode's Resources panel in short: the meters, the game, what else runs
  hearth-resmon pc [--refresh] [--fixture FILE.json] [--no-helper]
                                     "Your PC": what this machine really has (board, processor, memory slots, PCIe
                                     lanes, drives and their ports, USB, graphics, sensors, battery, network), the
                                     drawing chosen for it (desktop board, laptop or handheld) and tips that are true
                                     from the data. Read-only. The memory and slot tables need root: they come from
                                     ~/.cache/hearth/resmon-hwinfo.json, or once from /usr/libexec/nimbus/hearth-hwinfo
                                     through pkexec (49-hearth-hwinfo.rules: no password for the person at the device)
  hearth-resmon pause status|on|off|light-on
                                     Game Mode's "Pause downloads and backups while I play": only Hearth's existing
                                     pauses. on = the home server's paused jobs wait again (Light mode's runtime flag),
                                     off = they may run now; neither changes a setting. light-on turns Light mode on, and
                                     only because the person pressed that option
  hearth-resmon end|kill|eco …       passed on to hearth-tasks (the same checks: yours only, never a part of Hearth)

Everything is read from /proc and /sys (and nvidia-smi when it's there). No setting is written by anything here: the
only files are caches under ~/.cache/hearth/. Output is one JSON line; failures print "error: ..." and exit 1.
"""
import glob
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.realpath(__file__))


def _load_tasks():
    """Task Manager's helper (hearth-tasks, next to this file): its sampler, process grouping and actions."""
    path = os.path.join(HERE, 'hearth-tasks')
    loader = importlib.machinery.SourceFileLoader('hearth_tasks', path)
    spec = importlib.util.spec_from_loader('hearth_tasks', loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


ht = _load_tasks()
read, read_int, Fail = ht.read, ht.read_int, ht.Fail

HWINFO_HELPER = '/usr/libexec/nimbus/hearth-hwinfo'


def cache_dir():
    base = os.environ.get('XDG_CACHE_HOME') or os.path.join(os.path.expanduser('~'), '.cache')
    return os.path.join(base, 'hearth')


def write_cache(name, obj):
    """A cache file (never a setting): atomic, so a reader never sees half of one."""
    try:
        d = cache_dir()
        os.makedirs(d, exist_ok=True)
        fd, tmp = tempfile.mkstemp(prefix='.' + name + '.', dir=d)
        with os.fdopen(fd, 'w') as f:
            json.dump(obj, f, separators=(',', ':'))
        os.replace(tmp, os.path.join(d, name))
    except OSError:
        pass


def read_cache(name):
    try:
        with open(os.path.join(cache_dir(), name)) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else None
    except (OSError, ValueError):
        return None


# ====================================================================== tags (what Task Manager already knows)
HOME_SERVER = {'ollama', 'jellyfin', 'comfyui', 'kokoro', 'syncthing', 'restic', 'rclone', 'hearth-home-server',
               'hearth-ai-share', 'voicestudio', 'immich', 'open-webui', 'jellyfin-ffmpeg'}
STEAM_NAMES = {'steam', 'steamwebhelper', 'steam.sh', 'steam-runtime-launcher-service', 'pressure-vessel-wrap',
               'srt-bwrap', 'steam-runtime-supervisor'}
HEARTH_WHY = ('Hearth', 'Mantel', 'Game Mode screen', 'Desktop windows', 'Performance overlay', 'Hearth controller')
TAG_COLOR = {'Game · Proton': 'game', 'Game': 'game', 'Windows app': 'game', 'Steam': 'steam', 'Hearth': 'hearth',
             'Home server': 'home', 'System': 'sys', '': 'app'}


def group_names(g, procs):
    out = set()
    for pid in g['pids'][:40]:
        p = procs.get(pid)
        if p and pid != os.getpid():
            out.update(n.lower() for n in ht.names_of(p))
    out.add((g.get('name') or '').lower())
    return out


def is_proton(g, procs):
    for pid in g['pids'][:60]:
        p = procs.get(pid)
        if not p:
            continue
        joined = ' '.join(p.cmd[:12]).lower()[:600]
        if 'proton' in joined or 'wine' in (p.comm or '').lower() or ht.windows_exe(p) or '.exe' in joined:
            return True
    return False


def tag_of(g, procs):
    """The tag a program gets in Resource Monitor's tables: Game · Proton, Game, Steam, Hearth, Home server, System."""
    names = group_names(g, procs)
    if g.get('kind') == 'game':
        return 'Game · Proton' if is_proton(g, procs) or g.get('tag') == 'Windows app' else 'Game'
    if names & STEAM_NAMES:
        return 'Steam'
    if g.get('protected'):
        why = g.get('why') or ''
        return 'Hearth' if any(why.startswith(w) for w in HEARTH_WHY) else 'System'
    if any(n.startswith(('hearth-', 'nimbus')) or n == 'hearth' for n in names):
        return 'Hearth'
    if names & HOME_SERVER:
        return 'Home server'
    if g.get('tag') == 'Windows app':
        return 'Windows app'
    return ''


# ====================================================================== the sampler (Task Manager's, plus more)
def parse_status_extra(text):
    """/proc/PID/status: shared (RssShmem + RssFile) and swapped (VmSwap), bytes."""
    out = {'shared': 0, 'swap': 0}
    for line in (text or '').splitlines():
        k, _, v = line.partition(':')
        v = v.split()
        if not v or not v[0].isdigit():
            continue
        if k in ('RssShmem', 'RssFile'):
            out['shared'] += int(v[0]) * 1024
        elif k == 'VmSwap':
            out['swap'] = int(v[0]) * 1024
    return out


def parse_proc_io_split(text):
    """/proc/PID/io: (read_bytes, write_bytes) from storage."""
    r = w = 0
    for line in (text or '').splitlines():
        k, _, v = line.partition(':')
        try:
            if k == 'read_bytes':
                r = int(v)
            elif k == 'write_bytes':
                w = int(v)
        except ValueError:
            pass
    return r, w


def parse_drm_memory(text):
    """A DRM file's fdinfo: video memory it holds (bytes): drm-memory-vram / drm-resident-vram (amdgpu, xe…)."""
    vram = 0
    for line in (text or '').splitlines():
        k, _, v = line.partition(':')
        k = k.strip()
        if k in ('drm-memory-vram', 'drm-resident-vram', 'drm-resident-local0', 'drm-memory-local0'):
            f = v.split()
            try:
                n = int(f[0])
                unit = f[1] if len(f) > 1 else ''
                n *= {'KiB': 1024, 'MiB': 1048576, 'GiB': 1073741824}.get(unit, 1)
                vram = max(vram, n)
            except (ValueError, IndexError):
                pass
    return vram


def parse_net_table(text):
    """/proc/net/tcp(6)/udp(6): {inode: (state, remote ip:port)}."""
    out = {}
    for line in (text or '').splitlines()[1:]:
        f = line.split()
        if len(f) < 10:
            continue
        out[f[9]] = (f[3], f[2])
    return out


def hex_addr(s):
    """'0100007F:0050' → '127.0.0.1:80' (IPv4) or a short IPv6 form."""
    try:
        ip, port = s.split(':')
        port = int(port, 16)
        if len(ip) == 8:
            b = bytes.fromhex(ip)[::-1]
            return '%d.%d.%d.%d:%d' % (b[0], b[1], b[2], b[3], port)
        words = [ip[i:i + 8] for i in range(0, 32, 8)]
        raw = b''.join(bytes.fromhex(w)[::-1] for w in words)
        if raw[:12] == b'\0' * 10 + b'\xff\xff':
            return '%d.%d.%d.%d:%d' % (raw[12], raw[13], raw[14], raw[15], port)
        import ipaddress
        return '[%s]:%d' % (ipaddress.IPv6Address(raw).compressed, port)
    except (ValueError, IndexError):
        return ''


def parse_pmon(text):
    """`nvidia-smi pmon -c 1 -s um`: {pid: {gpu: sm %, vram: bytes, type}} (columns found from its header)."""
    out, cols = {}, []
    for line in (text or '').splitlines():
        if line.startswith('#'):
            if not cols:
                cols = line.lstrip('#').split()
            continue
        f = line.split()
        if not cols or len(f) < 3:
            continue
        row = dict(zip(cols, f))
        try:
            pid = int(row.get('pid', '-'))
        except ValueError:
            continue

        def num(k):
            try:
                return float(row.get(k, '-'))
            except ValueError:
                return None
        sm, fb = num('sm'), num('fb')
        cur = out.setdefault(pid, {'gpu': 0.0, 'vram': 0, 'type': row.get('type', '')})
        cur['gpu'] = round(cur['gpu'] + (sm or 0.0), 1)
        cur['vram'] += int((fb or 0) * 1048576)
    return out


SMI_FIELDS = ['index', 'name', 'utilization.gpu', 'memory.used', 'memory.total', 'temperature.gpu', 'power.draw',
              'power.limit', 'clocks.gr', 'clocks.mem', 'fan.speed', 'driver_version', 'pcie.link.gen.current',
              'pcie.link.width.current', 'pci.bus_id', 'vbios_version']


def parse_smi_full(text):
    """`nvidia-smi --query-gpu=<SMI_FIELDS>`: one dict per card in Resource Monitor's names."""
    out = []
    for line in (text or '').splitlines():
        f = [x.strip() for x in line.split(',')]
        if len(f) < len(SMI_FIELDS):
            continue
        d = dict(zip(SMI_FIELDS, f))

        def num(k):
            try:
                return float(d[k])
            except (ValueError, KeyError):
                return None
        used, total = num('memory.used'), num('memory.total')
        out.append({'vendor': 'NVIDIA', 'name': d['name'], 'busy': num('utilization.gpu'),
                    'vramUsed': int(used * 1048576) if used is not None else None,
                    'vramTotal': int(total * 1048576) if total is not None else None,
                    'temp': num('temperature.gpu'), 'watts': num('power.draw'), 'wattsMax': num('power.limit'),
                    'mhz': num('clocks.gr'), 'memMhz': num('clocks.mem'), 'fan': num('fan.speed'), 'fanRpm': None,
                    'driver': d['driver_version'], 'linkGen': num('pcie.link.gen.current'),
                    'linkWidth': num('pcie.link.width.current'), 'pci': d['pci.bus_id'].lower()[-12:],
                    'vbios': d['vbios_version'], 'gttUsed': None, 'gttTotal': None})
    return out


def amd_extra(dev, sys_root='/sys'):
    """amdgpu's hwmon: power (W), its limit, fan (rpm and %), memory clock; for one card's device folder."""
    out = {'watts': None, 'wattsMax': None, 'fan': None, 'fanRpm': None, 'memMhz': None}
    for h in glob.glob(os.path.join(dev, 'hwmon', 'hwmon*')):
        p = read_int(os.path.join(h, 'power1_average')) or read_int(os.path.join(h, 'power1_input'))
        if p:
            out['watts'] = round(p / 1e6, 1)
        cap = read_int(os.path.join(h, 'power1_cap'))
        if cap:
            out['wattsMax'] = round(cap / 1e6)
        rpm = read_int(os.path.join(h, 'fan1_input'))
        if rpm is not None:
            out['fanRpm'] = rpm
        pwm, pmax = read_int(os.path.join(h, 'pwm1')), read_int(os.path.join(h, 'pwm1_max')) or 255
        if pwm is not None and pmax:
            out['fan'] = round(100.0 * pwm / pmax)
    out['memMhz'] = ht.amd_clock(read(os.path.join(dev, 'pp_dpm_mclk')))
    return out


def meminfo_breakdown(mi, installed=None):
    """The Memory view's bar from /proc/meminfo (bytes): reserved, in use, being saved, cache, free. They add up to
    what's installed (or to MemTotal when that isn't known)."""
    total = mi.get('MemTotal', 0)
    # In use as Windows counts it: total − free − cache (not − MemAvailable, which also takes off the kernel's
    # reserve: "0 free" with Keep memory free set high). 1.11.
    free = mi.get('MemFree', 0)
    cache = max(0, mi.get('Cached', 0) + mi.get('Buffers', 0) + mi.get('SReclaimable', 0) - mi.get('Shmem', 0))
    in_use = max(0, total - free - cache)
    saving = min(cache, mi.get('Dirty', 0) + mi.get('Writeback', 0))
    reserved = max(0, (installed or total) - total)
    return {'installed': installed or total, 'total': total, 'reserved': reserved, 'inUse': in_use, 'saving': saving,
            'cache': cache - saving, 'free': free, 'committed': mi.get('Committed_AS', 0),
            'swapTotal': mi.get('SwapTotal', 0), 'swapUsed': max(0, mi.get('SwapTotal', 0) - mi.get('SwapFree', 0))}


def installed_memory(sys_root='/sys'):
    """Memory the system sees as blocks (online memory sections): close to what's installed, without root."""
    bs = read(os.path.join(sys_root, 'devices/system/memory/block_size_bytes'))
    try:
        size = int(bs.strip(), 16)
    except (AttributeError, ValueError):
        return None
    n = 0
    for b in glob.glob(os.path.join(sys_root, 'devices/system/memory/memory[0-9]*')):
        if (read(os.path.join(b, 'online')) or '1').strip() == '1':
            n += 1
    return n * size if n else None


def fans_by_id(sys_root='/sys'):
    """{"hwmon3/fan2": rpm} for every fan the sensors report (Your PC's fan headers light up by these)."""
    out = {}
    for f in glob.glob(os.path.join(sys_root, 'class/hwmon/hwmon*/fan*_input')):
        rpm = read_int(f)
        if rpm is not None:
            parts = f.split('/')
            out[parts[-2] + '/' + parts[-1][:-6]] = rpm
    return out


class ResSampler(ht.Sampler):
    """Task Manager's sampler, plus what Resource Monitor's tabs show: tags, threads, a 60-second average, shared and
    swapped memory, reads and writes apart, network connections, per-program graphics and video memory, and each
    card's power, clock and fan. The extra parts are read only when the tab on show needs them."""

    def __init__(self, root='/proc', sys_root='/sys'):
        super().__init__(root, sys_root)
        self.want = set()
        self.cpu_hist = {}
        self.io2 = {}
        self.conn = {}
        self.conn_t = 0
        self.pmon = {}
        self.pmon_t = 0
        self.smi_full = []
        self.smi_full_t = 0
        self.installed = None
        self.procs_last = {}

    def sample(self, want=()):
        self.want = set(want or ())
        base = set(self.want)
        if self.want & {'procs', 'mem', 'disk', 'net', 'gpuprocs'}:
            base.add('procs')
        out = super().sample(sorted(base))
        mi = ht.parse_meminfo(read(os.path.join(self.root, 'meminfo'), '') or '')
        if self.installed is None:
            self.installed = installed_memory(self.sys) or 0
        out['memBar'] = meminfo_breakdown(mi, self.installed or None)
        # Compressed memory and the swaps (1.11, the Memory tab): zram's own numbers, and each swap's use.
        zb = os.path.join(self.sys, 'block', 'zram0')
        mm = (read(os.path.join(zb, 'mm_stat'), '') or '').split()
        if mm and mm[0].isdigit():
            out['zram'] = {'orig': int(mm[0]), 'compr': int(mm[1]), 'mem': int(mm[2]), 'size': int((read(os.path.join(zb, 'disksize'), '0') or '0').strip() or 0)}
        sw = []
        for line in (read(os.path.join(self.root, 'swaps'), '') or '').splitlines()[1:]:
            f = line.split()
            if len(f) >= 4 and f[2].isdigit():
                sw.append({'path': f[0], 'size': int(f[2]) * 1024, 'used': int(f[3]) * 1024})
        out['swaps'] = sw
        # Memory pressure (1.11, Overview's chip): the share of the last 10 s programs waited for memory.
        pm = re.search(r'some avg10=([\d.]+)', read(os.path.join(self.root, 'pressure', 'memory'), '') or '')
        out['pressure'] = float(pm.group(1)) if pm else None
        if 'gpu' in self.want:
            self.gpu_extra(out.get('gpus') or [])
        if 'temps' in self.want:
            out['fans'] = fans_by_id(self.sys)
        return out

    def gpu_extra(self, gl):
        has_nv = any(g.get('vendor') == 'NVIDIA' for g in gl)
        if has_nv and shutil.which('nvidia-smi'):
            now = time.monotonic()
            if now - self.smi_full_t >= 1.9:
                self.smi_full_t = now
                try:
                    r = subprocess.run(['nvidia-smi', '--query-gpu=' + ','.join(SMI_FIELDS), '--format=csv,noheader,nounits'],
                                       capture_output=True, text=True, timeout=3)
                    self.smi_full = parse_smi_full(r.stdout) if r.returncode == 0 else []
                except (OSError, subprocess.TimeoutExpired):
                    self.smi_full = []
            nv = iter(self.smi_full)
            for g in gl:
                if g.get('vendor') == 'NVIDIA':
                    full = next(nv, None)
                    if full:
                        idx = g.get('index')
                        g.update({k: v for k, v in full.items() if v is not None})
                        g['index'] = idx
        for g in gl:
            if g.get('vendor') in ('AMD', 'Intel') and g.get('card'):
                dev = os.path.join(self.sys, 'class/drm', g['card'], 'device')
                g.update(amd_extra(dev, self.sys))
                g['linkWidth'] = read_int(os.path.join(dev, 'current_link_width'))
                g['linkGen'] = link_gen(read(os.path.join(dev, 'current_link_speed')))

    def groups(self, procs, cpu_of, dt, mem_total):
        groups = super().groups(procs, cpu_of, dt, mem_total)
        self.procs_last = procs
        want = self.want
        if 'net' in want:
            self.connections(procs)
        gpu_mem = self.drm_vram(procs) if 'gpuprocs' in want else {}
        if 'gpuprocs' in want:
            self.nvidia_procs()
        io_now = {}
        seen = set()
        for g in groups:
            seen.add(g['id'])
            g['tag'] = tag_of(g, procs)
            g['color'] = TAG_COLOR.get(g['tag'], 'app')
            g['threads'] = sum(procs[p].threads or 0 for p in g['pids'] if p in procs)
            h = self.cpu_hist.setdefault(g['id'], [])
            h.append(g['cpu'])
            del h[:-60]
            g['avg'] = round(sum(h) / len(h), 1) if h else 0.0
            if 'mem' in want:
                sh = sw = 0
                for pid in g['pids']:
                    x = parse_status_extra(read(os.path.join(self.root, str(pid), 'status')))
                    sh += x['shared']
                    sw += x['swap']
                g['shared'], g['swap'] = sh, sw
            if 'disk' in want:
                rd = wr = 0
                for pid in g['pids']:
                    p = procs[pid]
                    r, w = parse_proc_io_split(read(os.path.join(self.root, str(pid), 'io')))
                    io_now[p.key] = (r, w)
                    pr = self.io2.get(p.key)
                    if pr and dt > 0:
                        rd += max(0, r - pr[0]) / dt
                        wr += max(0, w - pr[1]) / dt
                g['read'], g['write'] = int(rd), int(wr)
            if 'net' in want:
                c = [self.conn[p] for p in g['pids'] if p in self.conn]
                g['conns'] = sum(x[0] for x in c)
                g['remote'] = next((x[1] for x in c if x[1]), '')
            if 'gpuprocs' in want:
                g['vram'] = sum(gpu_mem.get(p, 0) for p in g['pids'])
                nv = [self.pmon[p] for p in g['pids'] if p in self.pmon]
                if nv:
                    g['gpu'] = round(min(100.0, max(g.get('gpu') or 0, sum(x['gpu'] for x in nv))), 1)
                    g['vram'] = max(g['vram'], sum(x['vram'] for x in nv))
                    g['gpuUse'] = '3D' if any('G' in x['type'] for x in nv) else 'Compute'
                else:
                    g['gpuUse'] = '3D' if (g.get('gpu') or 0) > 0 or g['vram'] else ''
        if 'disk' in want:
            self.io2 = io_now
        for k in [k for k in self.cpu_hist if k not in seen]:
            del self.cpu_hist[k]
        return groups

    def connections(self, procs):
        """{pid: (sockets, a remote address)} for your processes, every 3 seconds (it reads every open file)."""
        now = time.monotonic()
        if now - self.conn_t < 3:
            return
        self.conn_t = now
        table = {}
        for name in ('tcp', 'tcp6', 'udp', 'udp6'):
            table.update(parse_net_table(read(os.path.join(self.root, 'net', name))))
        out = {}
        for pid, p in procs.items():
            if p.uid != self.uid or p.kthread:
                continue
            fdd = os.path.join(self.root, str(pid), 'fd')
            try:
                fds = os.listdir(fdd)
            except OSError:
                continue
            n, remote = 0, ''
            for fd in fds:
                try:
                    t = os.readlink(os.path.join(fdd, fd))
                except OSError:
                    continue
                if not t.startswith('socket:['):
                    continue
                e = table.get(t[8:-1])
                if not e:
                    continue
                n += 1
                if not remote and e[0] == '01':   # an established TCP connection
                    a = hex_addr(e[1])
                    if a and not a.startswith(('127.', '[::1]', '0.0.0.0')):
                        remote = a
            if n:
                out[pid] = (n, remote)
        self.conn = out

    def drm_vram(self, procs):
        out = {}
        for pid, fds in self.drm_fds.items():
            if pid not in procs:
                continue
            best = 0
            for fd in fds:
                best = max(best, parse_drm_memory(read(os.path.join(self.root, str(pid), 'fdinfo', fd))))
            if best:
                out[pid] = best
        return out

    def nvidia_procs(self):
        if not shutil.which('nvidia-smi'):
            self.pmon = {}
            return
        now = time.monotonic()
        if now - self.pmon_t < 2.9:
            return
        self.pmon_t = now
        try:
            r = subprocess.run(['nvidia-smi', 'pmon', '-c', '1', '-s', 'um'], capture_output=True, text=True, timeout=4)
            self.pmon = parse_pmon(r.stdout) if r.returncode == 0 else {}
        except (OSError, subprocess.TimeoutExpired):
            self.pmon = {}


def brief(s, samples=None):
    """Game Mode's Resources panel: graphics, processor, memory and network meters with temperatures, the game and
    what else runs (from one ResSampler; two samples apart when it's new)."""
    want = ['procs', 'gpu', 'temps']
    d = samples or s.sample(want)
    gpus = d.get('gpus') or []
    g = max(gpus, key=lambda x: (x.get('vramTotal') or 0, x.get('busy') or 0), default=None)
    groups = d.get('procs') or []
    game = next((x for x in groups if x.get('kind') == 'game'), None)
    others = [x for x in groups if x is not game and x.get('tag') not in ('System',)]
    others.sort(key=lambda x: (-(x.get('cpu') or 0) * 50 - (x.get('mem') or 0) / 1048576))
    nets = [n for n in d.get('nets') or [] if n.get('up')]
    mb = d.get('memBar') or {}
    return {
