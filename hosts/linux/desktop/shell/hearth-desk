USAGE = ('usage: hearth-desk state | pin ID | unpin ID | pins-order ID... | set desktopIcons|dnd|autoArrange on|off | '
         'set-sort name|type|size|date | icons COLS ROWS | place NAME COL ROW COLS ROWS | '
         'place-many COLS ROWS NAME COL ROW... | same-device DEST PATH... | arrange COLS ROWS [SORT] | '
         'new-folder [NAME] | templates | new-file [TEMPLATE] | launch PATH | clip-copy [--cut] PATH... | clipboard | '
         'pasted | paste-image | desktop-shortcut ID | recent ID | mute-app NAME on|off')


def num(v):
    try:
        n = int(v)
    except ValueError:
        raise Fail('Not a number: ' + v)
    if not 0 <= n < 1000:
        raise Fail('Out of range: ' + v)
    return n


def cmd(argv):
    a = argv[1:]
    c, rest = (a[0] if a else ''), a[1:]
    if c == 'state' and not rest:
        out = public(load())
    elif c == 'pin' and len(rest) == 1:
        out = pin(rest[0])
    elif c == 'unpin' and len(rest) == 1:
        out = unpin(rest[0])
    elif c == 'set' and len(rest) == 2:
        out = set_switch(rest[0], rest[1])
    elif c == 'icons' and len(rest) == 2:
        out = icons(num(rest[0]), num(rest[1]))
    elif c == 'place' and len(rest) == 5:
        out = place(rest[0], num(rest[1]), num(rest[2]), num(rest[3]), num(rest[4]))
    elif c == 'place-many' and len(rest) >= 5 and (len(rest) - 2) % 3 == 0:
        moves = [(rest[i], num(rest[i + 1]), num(rest[i + 2])) for i in range(2, len(rest), 3)]
        out = place_many(moves, num(rest[0]), num(rest[1]))
    elif c == 'same-device' and len(rest) >= 2:
        out = same_device(rest[0], rest[1:])
    elif c == 'arrange' and len(rest) in (2, 3):
        out = arrange(num(rest[0]), num(rest[1]), rest[2] if len(rest) == 3 else None)
    elif c == 'pins-order':
        out = pins_order(rest)
    elif c == 'set-sort' and len(rest) == 1:
        out = set_sort(rest[0])
    elif c == 'templates' and not rest:
        out = templates()
    elif c == 'new-file' and len(rest) <= 1:
        out = new_file(rest[0] if rest else '')
    elif c == 'clip-copy' and rest:
        cut = rest[0] == '--cut'
        paths = rest[1:] if cut else rest
        if not paths:
            print(USAGE)
            sys.exit(2)
        out = clip_copy(paths, cut)
    elif c == 'clipboard' and not rest:
        out = clipboard()
    elif c == 'pasted' and not rest:
        pasted(rest)
        out = {'ok': True}
    elif c == 'paste-image' and not rest:
        out = paste_image()
    elif c == 'desktop-shortcut' and len(rest) == 1:
        out = desktop_shortcut(rest[0])
    elif c == 'recent' and len(rest) == 1:
        out = note_recent(rest[0])
    elif c == 'mute-app' and len(rest) == 2:
        out = mute_app(rest[0], rest[1])
    elif c == 'new-folder' and len(rest) <= 1:
        out = new_folder(rest[0] if rest else '')
    elif c == 'launch' and len(rest) == 1:
        out = launch(rest[0])
    else:
        print(USAGE)
        sys.exit(2)
    print(json.dumps(out), flush=True)


if __name__ == '__main__':
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    try:
        cmd(sys.argv)
    except Fail as e:
        print('error: ' + str(e), flush=True)
        sys.exit(1)
    except Exception as e:                      # hearth-files' own Fail, OSError, ...
        print('error: ' + str(e), flush=True)
        sys.exit(1)
