#!/usr/bin/python3
"""hearth-desk: what Desktop Mode's taskbar and desktop remember (Bar.qml, Desktop.qml, DeskState.qml).

  hearth-desk state                         the saved settings (pins, desktop icons on/off, Do Not Disturb)
  hearth-desk pin ID                        keep an app on the taskbar (ID: its .desktop id, e.g. firefox)
  hearth-desk unpin ID                      take it off again
  hearth-desk set KEY on|off                desktopIcons | dnd
  hearth-desk icons COLS ROWS               what's in your Desktop folder, each with its place on a COLS x ROWS grid
  hearth-desk place NAME COL ROW COLS ROWS  move one desktop icon to a place (swaps with an icon already there)
  hearth-desk place-many COLS ROWS NAME COL ROW [NAME COL ROW...]
                                            move several icons at once (icons in the way take the places left)
  hearth-desk same-device DEST PATH...      {move: true} when every PATH is on DEST's drive (a drop there moves)
  hearth-desk arrange COLS ROWS             line the desktop icons up by name
  hearth-desk new-folder [NAME]             a new folder on the desktop ("New folder", "New folder 2", ...)
  hearth-desk launch PATH                   start the app a .desktop launcher on the desktop points to
  hearth-desk pins-order ID...              put the pinned apps in this order (dragged on the taskbar)
  hearth-desk set-sort name|type|size|date  how the icons are sorted when they're lined up
  hearth-desk templates                     the files in your Templates folder (the desktop's "New document")
  hearth-desk new-file [TEMPLATE]           a new empty text file on the desktop, or a copy of a template
  hearth-desk clip-copy [--cut] PATH...     put files on the clipboard (text/uri-list, so file managers paste them)
  hearth-desk clipboard                     what's on the clipboard: files ({paths, cut}) or a picture ({image})
  hearth-desk paste-image                   save the picture on the clipboard to the desktop
  hearth-desk desktop-shortcut ID           put an app (its .desktop id) on the desktop
  hearth-desk recent ID                     an app was opened from the app menu (its Recent row, newest first)
  hearth-desk mute-app NAME on|off          no pop-ups from this app (its notifications still go to the history)

Kept in $XDG_CONFIG_HOME/nimbus/desk.json (~/.config/nimbus/desk.json). Output is one JSON line; failures
print "error: ..." and exit 1. File work (rename, Trash, details) goes through hearth-files.
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
import urllib.parse

HERE = os.path.dirname(os.path.realpath(__file__))
MAX_PINS = 40
DEFAULTS = {'pins': [], 'desktopIcons': True, 'dnd': False, 'icons': {}, 'autoArrange': False, 'sortBy': 'name',
            'muted': [], 'recent': [], 'pinnedOnce': []}
SWITCHES = ('desktopIcons', 'dnd', 'autoArrange')
SORTS = ('name', 'type', 'size', 'date')
MAX_MUTED = 100
MAX_RECENT = 8


class Fail(Exception):
    pass


def files_module():
    """hearth-files (next to this file), for the Desktop folder's place, file types and .desktop parsing."""
    path = os.path.join(HERE, 'hearth-files')
    loader = importlib.machinery.SourceFileLoader('hearth_files', path)
    spec = importlib.util.spec_from_loader('hearth_files', loader)
    m = importlib.util.module_from_spec(spec)
    loader.exec_module(m)
    return m


HF = None


def hf():
    global HF
    if HF is None:
        HF = files_module()
    return HF


# ---------------------------------------------------------------------- the settings file
def home():
    return os.path.abspath(os.path.expanduser('~'))


def config_path():
    cfg = os.environ.get('XDG_CONFIG_HOME') or os.path.join(home(), '.config')
    return os.path.join(cfg, 'nimbus', 'desk.json')


def clean(raw):
    """The saved settings with anything odd dropped (hand-edited or from an older Hearth)."""
    out = {k: (list(v) if isinstance(v, list) else dict(v) if isinstance(v, dict) else v) for k, v in DEFAULTS.items()}
    if not isinstance(raw, dict):
        return out
    pins = []
    for p in raw.get('pins') or []:
        if isinstance(p, str) and valid_id(p) and p not in pins:
            pins.append(p)
    out['pins'] = pins[:MAX_PINS]
    for k in SWITCHES:
        if isinstance(raw.get(k), bool):
            out[k] = raw[k]
    icons = {}
    saved = raw.get('icons') if isinstance(raw.get('icons'), dict) else {}
    for name, cell in saved.items():
        if isinstance(name, str) and isinstance(cell, list) and len(cell) == 2 and all(isinstance(c, int) and 0 <= c < 1000 for c in cell):
            icons[name] = [cell[0], cell[1]]
    out['icons'] = icons
    if raw.get('sortBy') in SORTS:
        out['sortBy'] = raw['sortBy']
    muted = []
    for m in raw.get('muted') or []:
        if isinstance(m, str) and m.strip() and len(m) <= 200 and m not in muted:
            muted.append(m)
    out['muted'] = muted[:MAX_MUTED]
    recent = []
    for r in raw.get('recent') or []:
        if isinstance(r, str) and valid_id(r) and r not in recent:
            recent.append(r)
    out['recent'] = recent[:MAX_RECENT]
    once = []
    for r in raw.get('pinnedOnce') or []:
        if isinstance(r, str) and valid_id(r) and r not in once:
            once.append(r)
    out['pinnedOnce'] = once[:MAX_PINS]
    return out


# Bazaar, Hearth OS's app store (Flathub; hearth-flatpak-setup installs it for everyone). Hearth's own store (Apps,
# hearth-apps.desktop) is archived: a pin of it becomes Bazaar.
BAZAAR = 'io.github.kolunmi.Bazaar'
OLD_STORE = 'hearth-apps'
# Xodus Nexus (Xbox PC games): Hearth OS ships it like Beacon (os-bases/*/build.sh, xodus-nexus.desktop).
XODUS = 'xodus-nexus'
# Apps on a new user's taskbar, when they're installed: Beacon (BFME and friends; Hearth OS ships it), Xodus Nexus
# and Bazaar.
DEFAULT_PINS = ('beacon', XODUS, BAZAAR)
# Pinned once for everyone, also on a taskbar that's already set up, the first time they're installed (Bazaar comes a
# few minutes after the first online start; Xodus Nexus with the image update that adds it); unpinning it then is
# yours to keep (pinnedOnce remembers).
PIN_ONCE = (XODUS, BAZAAR)
SYSTEM_EXPORTS = '/var/lib/flatpak/exports/share'


def data_dirs():
    """Where .desktop files live: $XDG_DATA_HOME, then $XDG_DATA_DIRS (the spec's defaults when unset)."""
    first = os.environ.get('XDG_DATA_HOME') or os.path.join(home(), '.local', 'share')
    rest = [d for d in (os.environ.get('XDG_DATA_DIRS') or '/usr/local/share:/usr/share').split(':') if d]
    return [first] + rest


def app_installed(app_id):
    """Whether an app has a .desktop file: the data folders, and Flatpak's exports (yours and the system's) in case
    the session's XDG_DATA_DIRS doesn't list them."""
    dirs = data_dirs() + [os.path.join(home(), '.local', 'share', 'flatpak', 'exports', 'share'), SYSTEM_EXPORTS]
    return any(os.path.isfile(os.path.join(d, 'applications', app_id + '.desktop')) for d in dirs)


def default_pins():
    """The DEFAULT_PINS that are installed (have a .desktop file), for a taskbar nobody has changed yet."""
    return [p for p in DEFAULT_PINS if app_installed(p)]


def migrate(state):
    """An existing taskbar: the archived store's pin becomes Bazaar's; PIN_ONCE apps pinned the first time they're
    installed. Returns whether anything changed."""
    changed = False
    if OLD_STORE in state['pins']:
        i = state['pins'].index(OLD_STORE)
        if BAZAAR in state['pins']:
            state['pins'].pop(i)
        else:
            state['pins'][i] = BAZAAR
        if BAZAAR not in state['pinnedOnce']:
            state['pinnedOnce'].append(BAZAAR)
        changed = True
    for app_id in PIN_ONCE:
        if app_id in state['pinnedOnce'] or not app_installed(app_id):
            continue
        state['pinnedOnce'].append(app_id)
        if app_id not in state['pins'] and len(state['pins']) < MAX_PINS:
            state['pins'].append(app_id)
        changed = True
    return changed


def load():
    try:
        with open(config_path(), encoding='utf-8') as f:
            state = clean(json.load(f))
    except FileNotFoundError:
        # A new user: the default pins (only ever here; once the taskbar is saved, your pins are yours).
        state = clean(None)
        state['pins'] = default_pins()
        state['pinnedOnce'] = [p for p in PIN_ONCE if p in state['pins']]
        return state
    except (OSError, ValueError):
        return clean(None)
    if migrate(state):
        try:
            save(state)
        except OSError:
            pass
    return state


def save(state):
    path = config_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.desk-', suffix='.json', dir=os.path.dirname(path))
    try:
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            json.dump(clean(state), f, indent=2, ensure_ascii=False)
            f.write('\n')
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def public(state):
    return {'pins': state['pins'], 'desktopIcons': state['desktopIcons'], 'dnd': state['dnd'],
            'autoArrange': state['autoArrange'], 'sortBy': state['sortBy'], 'muted': state['muted'],
            'recent': state['recent']}


# ---------------------------------------------------------------------- taskbar pins
def valid_id(app_id):
    return bool(app_id) and len(app_id) <= 255 and '/' not in app_id and '\0' not in app_id and app_id.strip() == app_id


def pin(app_id):
    if not valid_id(app_id):
        raise Fail("That app can't be pinned")
    s = load()
    if app_id not in s['pins']:
        if len(s['pins']) >= MAX_PINS:
            raise Fail('The taskbar is full. Unpin an app first')
        s['pins'].append(app_id)
        save(s)
    return public(s)


def unpin(app_id):
    s = load()
    if app_id in s['pins']:
        s['pins'].remove(app_id)
        save(s)
    return public(s)


def pins_order(ids):
    """The pinned apps in the order given (ids that aren't pinned are ignored; pins not named keep their order
    after the named ones), for dragging them around on the taskbar."""
    s = load()
    named = []
    for i in ids:
        if i in s['pins'] and i not in named:
            named.append(i)
    s['pins'] = named + [p for p in s['pins'] if p not in named]
    save(s)
    return public(s)


def set_sort(key):
    if key not in SORTS:
        raise Fail('Sort by name, type, size or date')
    s = load()
    s['sortBy'] = key
    save(s)
    return public(s)


def note_recent(app_id):
    if not valid_id(app_id):
        raise Fail('Not an app id')
    s = load()
    s['recent'] = ([app_id] + [r for r in s['recent'] if r != app_id])[:MAX_RECENT]
    save(s)
    return public(s)


def mute_app(name, value):
    name = (name or '').strip()
    if not name or len(name) > 200:
        raise Fail("That app can't be muted")
    s = load()
    on = value.lower() in ('on', 'true', 'yes', '1')
    if on and name not in s['muted']:
        if len(s['muted']) >= MAX_MUTED:
            raise Fail('Too many muted apps. Unmute one first')
        s['muted'].append(name)
    elif not on and name in s['muted']:
        s['muted'].remove(name)
    save(s)
    return public(s)


def set_switch(key, value):
    if key not in SWITCHES:
        raise Fail('Unknown setting: ' + key)
    v = value.lower()
    if v not in ('on', 'off', 'true', 'false', 'yes', 'no', '1', '0'):
        raise Fail('Use on or off')
    s = load()
    s[key] = v in ('on', 'true', 'yes', '1')
    save(s)
    return public(s)


# ---------------------------------------------------------------------- desktop icons
def desktop_dir():
    """Your Desktop folder (XDG_DESKTOP_DIR, else ~/Desktop). None when it's set to your home folder itself,
    so the desktop never fills up with everything in Home."""
    d = hf().user_dirs().get('DESKTOP') or os.path.join(home(), 'Desktop')
    d = os.path.normpath(d)
    if os.path.realpath(d) == os.path.realpath(home()):
        return None
    return d


def sort_key(by):
    """Sorting for desktop entries: folders always first, then by name, type (extension), size or date."""
    def name(e):
        return (e.get('label', e['name']).casefold(), e['name'])

    def key(e):
        if by == 'type':
            ext = '' if e['dir'] else os.path.splitext(e['name'])[1].casefold()
            return (not e['dir'], ext, name(e))
        if by == 'size':
            return (not e['dir'], -(e.get('size') or 0), name(e))
        if by == 'date':
            return (not e['dir'], -(e.get('mtime') or 0), name(e))
        return (not e['dir'], name(e))
    return key


def desktop_items(d, by='name'):
    """Desktop folder entries (no hidden ones): folders first, then by name (or by = type, size, date)."""
    try:
        names = os.listdir(d)
    except OSError:
        return []
    out = []
    for name in names:
        if name.startswith('.'):
            continue
        e = hf().entry(os.path.join(d, name), name)
        if not e:
            continue
        if name.endswith('.desktop') and not e['dir']:
            fields = hf().parse_desktop(e['path']) or {}
            if fields.get('Type', 'Application') in ('Application', 'Link'):
                e['label'] = fields.get('Name') or name[:-8]
                e['icon'] = fields.get('Icon', '')
                e['launcher'] = True
        out.append(e)
    out.sort(key=sort_key(by))
    return out


def cells(cols, rows):
    """Grid places in reading order for a desktop: down the first column, then the next (top-left first)."""
    return [(c, r) for c in range(cols) for r in range(rows)]


def layout(names, saved, cols, rows):
    """Place every name on the grid. Saved places inside the grid are kept (the first name wins a clash);
    the rest take the first free places. Returns ({name: (col, row)}, names that got a new place)."""
    cols, rows = max(1, cols), max(1, rows)
    taken, placed, fresh = set(), {}, []
    for n in names:
        cell = saved.get(n)
        if cell and 0 <= cell[0] < cols and 0 <= cell[1] < rows and tuple(cell) not in taken:
            placed[n] = (cell[0], cell[1])
            taken.add(placed[n])
    free = [c for c in cells(cols, rows) if c not in taken]
    overflow = 0
    for n in names:
        if n in placed:
            continue
        if free:
            placed[n] = free.pop(0)
        else:                                   # more icons than places: stack past the last column
            placed[n] = (cols + overflow // rows, overflow % rows)
            overflow += 1
        if n not in saved:
            fresh.append(n)
    return placed, fresh


def icons(cols, rows):
    d = desktop_dir()
    if not d or not os.path.isdir(d):
        return {'dir': d, 'exists': False, 'entries': []}
    s = load()
    items = desktop_items(d, s['sortBy'])
    names = [e['name'] for e in items]
    if s['autoArrange']:
        # Kept lined up: every icon in sorted order, the saved places are left alone for when it's turned off.
        placed, _ = layout(names, {}, cols, rows)
        for e in items:
            e['col'], e['row'] = placed[e['name']]
        return {'dir': d, 'exists': True, 'entries': items}
    placed, fresh = layout(names, s['icons'], cols, rows)
    # Remember new icons' places (so the next new file doesn't shuffle them) and forget removed files.
    # A saved place outside today's grid (a smaller screen) is kept for when the screen is big again.
    gone = [n for n in s['icons'] if n not in placed]
    if fresh or gone:
        for n in gone:
            del s['icons'][n]
        for n in fresh:
            s['icons'][n] = list(placed[n])
        save(s)
    for e in items:
        e['col'], e['row'] = placed[e['name']]
    return {'dir': d, 'exists': True, 'entries': items}


def place(name, col, row, cols, rows):
    return place_many([(name, col, row)], cols, rows)


def place_many(moves, cols, rows):
    """Move icons to new places together (dragging a selection). Icons already at a new place move to the places
    the moved ones left (one icon: a swap), else to the first free place."""
    d = desktop_dir()
    if not d or not os.path.isdir(d):
        raise Fail("There's no Desktop folder")
    names = [e['name'] for e in desktop_items(d)]
    cols, rows = max(1, cols), max(1, rows)
    want = {}
    for name, col, row in moves:
        if name not in names:
            raise Fail('“' + name + "” isn't on the desktop any more")
        cell = (max(0, min(cols - 1, col)), max(0, min(rows - 1, row)))
        if cell not in want.values():
            want[name] = cell
    s = load()
    placed, _ = layout(names, s['icons'], cols, rows)
    new = dict(placed)
    for n, cell in want.items():
        new[n] = cell
    targets = set(want.values())
    displaced = [n for n in names if n not in want and placed[n] in targets]
    freed = [placed[n] for n in want if placed[n] not in targets]
    taken = {cell for n, cell in new.items() if n not in displaced}
    spare = [c for c in freed if c not in taken] + [c for c in cells(cols, rows) if c not in taken and c not in freed]
    for n in displaced:
        new[n] = spare.pop(0) if spare else placed[n]
    for n in names:
        s['icons'][n] = list(new[n])
    save(s)
    return icons(cols, rows)


def same_device(dest, paths):
    """Would a drop of these on DEST move them (all on DEST's drive, like file managers do) or copy them."""
    try:
        dev = os.stat(dest).st_dev
        return {'move': bool(paths) and all(os.lstat(p).st_dev == dev for p in paths)}
    except OSError:
        return {'move': False}


def arrange(cols, rows, by=None):
    s = load()
    if by is not None:
        if by not in SORTS:
            raise Fail('Sort by name, type, size or date')
        s['sortBy'] = by
    s['icons'] = {}
    save(s)
    return icons(cols, rows)


# ---------------------------------------------------------------------- new files
def templates_dir():
    d = hf().user_dirs().get('TEMPLATES') or os.path.join(home(), 'Templates')
    d = os.path.normpath(d)
    return None if os.path.realpath(d) == os.path.realpath(home()) else d


def templates():
    """Files in your Templates folder (not folders, not hidden), by name: what "New document" offers."""
    d = templates_dir()
    out = []
    if d and os.path.isdir(d):
        for name in sorted(os.listdir(d), key=str.casefold):
            p = os.path.join(d, name)
            if name.startswith('.') or not os.path.isfile(p):
                continue
            out.append({'name': os.path.splitext(name)[0] or name, 'path': p, 'file': name})
    return {'dir': d, 'templates': out[:50]}


def unique_path(d, base, ext=''):
    target = os.path.join(d, base + ext)
    n = 1
    while hf().lexists(target):
        n += 1
        target = os.path.join(d, '%s %d%s' % (base, n, ext))
    return target


def new_file(template=''):
    d = desktop_dir()
    if not d:
        raise Fail("Your Desktop folder is set to your home folder, so Hearth doesn't add things there")
    os.makedirs(d, exist_ok=True)
    if template:
        src = os.path.abspath(os.path.expanduser(template))
        tdir = templates_dir()
        if not tdir or os.path.dirname(src) != os.path.normpath(tdir) or not os.path.isfile(src):
            raise Fail("That template isn't in your Templates folder")
        base, ext = os.path.splitext(os.path.basename(src))
        target = unique_path(d, 'New ' + base if not base.lower().startswith('new ') else base, ext)
        with open(src, 'rb') as fi:
            data = fi.read(64 * 1024 * 1024)
    else:
        target = unique_path(d, 'New text file', '.txt')
        data = b''
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    with os.fdopen(fd, 'wb') as f:
        f.write(data)
    return {'ok': True, 'path': target, 'name': os.path.basename(target)}


def find_app(app_id):
    """The .desktop file for an app id ("firefox" or "firefox.desktop"), the first in the XDG data folders."""
    if not valid_id(app_id):
        return None
    name = app_id if app_id.endswith('.desktop') else app_id + '.desktop'
    for d in data_dirs():
        p = os.path.join(d, 'applications', name)
        if os.path.isfile(p):
            return p
        # Ids with dashes may live in subfolders (kde4-foo.desktop is kde4/foo.desktop).
        if '-' in name:
            p = os.path.join(d, 'applications', *name.split('-', 1))
            if os.path.isfile(p):
                return p
    return None


def desktop_shortcut(app_id):
    d = desktop_dir()
    if not d:
        raise Fail("Your Desktop folder is set to your home folder, so Hearth doesn't add things there")
    src = find_app(app_id)
    if not src:
        raise Fail("That app's launcher couldn't be found")
    os.makedirs(d, exist_ok=True)
    base = os.path.basename(src)[:-8]
    target = unique_path(d, base, '.desktop')
    with open(src, 'rb') as f:
        data = f.read(1024 * 1024)
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o755)
    with os.fdopen(fd, 'wb') as f:
        f.write(data)
    return {'ok': True, 'path': target, 'name': os.path.basename(target)}


# ---------------------------------------------------------------------- the clipboard (files and pictures)
# Files go on the clipboard as text/uri-list (wl-copy), which Dolphin, Nautilus, Thunar, browsers and Hearth Files
# all paste. A cut is remembered here ($XDG_RUNTIME_DIR/hearth-cut): pasting the same files on the desktop moves
# them; another app pasting them copies (it can't know they were cut).
def cut_file():
    return os.path.join(os.environ.get('XDG_RUNTIME_DIR') or '/tmp', 'hearth-cut.json')


def file_uri(p):
    return 'file://' + urllib.parse.quote(os.path.abspath(p))


def uri_paths(text):
    """Local paths in a text/uri-list (or a plain list of paths), comments and other schemes skipped."""
    out = []
    for line in (text or '').replace('\r', '').split('\n'):
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        if line.startswith('file://'):
            rest = line[7:]
            if not rest.startswith('/'):           # file://host/path: only this computer's
                host, _, rest = rest.partition('/')
                if host not in ('', 'localhost'):
                    continue
                rest = '/' + rest
            p = urllib.parse.unquote(rest)
        elif line.startswith('/'):
            p = line
        else:
            continue
        if p not in out:
            out.append(p)
    return out


def clip_copy(paths, cut=False):
    paths = [os.path.abspath(os.path.expanduser(p)) for p in paths]
    paths = [p for p in paths if hf().lexists(p)]
    if not paths:
        raise Fail('Nothing to copy')
    if not shutil.which('wl-copy'):
        raise Fail('Copying files needs wl-clipboard, which isn\'t installed')
    text = '\r\n'.join(file_uri(p) for p in paths) + '\r\n'
    try:
        r = subprocess.run(['wl-copy', '--type', 'text/uri-list'], input=text.encode(), timeout=10,
                           stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise Fail("Couldn't use the clipboard: " + str(e))
    if r.returncode != 0:
        raise Fail("Couldn't use the clipboard")
    try:
        if cut:
            with open(cut_file(), 'w', encoding='utf-8') as f:
                json.dump({'paths': paths}, f)
        elif os.path.exists(cut_file()):
            os.remove(cut_file())
    except OSError:
        pass
    return {'ok': True, 'count': len(paths), 'cut': bool(cut)}


def wl_paste(*args):
    try:
        r = subprocess.run(['wl-paste', '--no-newline'] + list(args), stdout=subprocess.PIPE,
                           stderr=subprocess.DEVNULL, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout if r.returncode == 0 else None


def clipboard():
    """What pasting on the desktop would do: {paths, cut} for files, {image: true} for a picture, else {}."""
    if not shutil.which('wl-paste'):
        return {'paths': [], 'cut': False, 'image': False}
    types = (wl_paste('--list-types') or b'').decode('utf-8', 'replace').split()
    paths, cut = [], False
    if 'text/uri-list' in types:
        paths = uri_paths((wl_paste('--type', 'text/uri-list') or b'').decode('utf-8', 'replace'))
    elif 'x-special/gnome-copied-files' in types:
        text = (wl_paste('--type', 'x-special/gnome-copied-files') or b'').decode('utf-8', 'replace')
        first, _, rest = text.partition('\n')
        cut = first.strip() == 'cut'
        paths = uri_paths(rest)
    paths = [p for p in paths if hf().lexists(p)]
    if paths and not cut:
        try:
            with open(cut_file(), encoding='utf-8') as f:
                cut = sorted(json.load(f).get('paths') or []) == sorted(paths)
        except (OSError, ValueError, AttributeError):
            pass
    image = not paths and any(t in types for t in ('image/png', 'image/jpeg'))
    return {'paths': paths, 'cut': cut, 'image': image}


def pasted(paths):
    """Files were pasted (moved, after a cut): forget the cut."""
    try:
        os.remove(cut_file())
    except OSError:
        pass


def paste_image():
    d = desktop_dir()
    if not d:
        raise Fail("Your Desktop folder is set to your home folder, so Hearth doesn't add things there")
    types = (wl_paste('--list-types') or b'').decode('utf-8', 'replace').split()
    kind = 'image/png' if 'image/png' in types else 'image/jpeg' if 'image/jpeg' in types else None
    if not kind:
        raise Fail("There's no picture on the clipboard")
    data = wl_paste('--type', kind)
    if not data:
        raise Fail("Couldn't read the picture on the clipboard")
    os.makedirs(d, exist_ok=True)
    target = unique_path(d, 'Pasted picture', '.png' if kind == 'image/png' else '.jpg')
    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    with os.fdopen(fd, 'wb') as f:
        f.write(data)
    return {'ok': True, 'path': target, 'name': os.path.basename(target)}


def new_folder(name=''):
    d = desktop_dir()
    if not d:
        raise Fail("Your Desktop folder is set to your home folder, so Hearth doesn't add things there")
    os.makedirs(d, exist_ok=True)
    base = (name or 'New folder').strip()
    hf().valid_name(base)
    target = os.path.join(d, base)
    n = 1
    while hf().lexists(target):
        n += 1
        target = os.path.join(d, '%s %d' % (base, n))
    try:
        hf().mkdir(target)
    except hf().Fail as e:
        raise Fail(str(e))
    return {'ok': True, 'path': target, 'name': os.path.basename(target)}


FIELD_CODES = re.compile(r'%[fFuUdDnNickvm%]')


def launch_argv(fields):
    """argv for a launcher's Exec line with no file to open (field codes dropped, %% kept as %)."""
    ex = fields.get('Exec', '')
    if not ex:
        raise Fail("This launcher doesn't say what to start")
    try:
        words = shlex.split(ex)
    except ValueError:
        raise Fail("This launcher's command can't be read")
    out = []
    for w in words:
        if w in ('%i',) and fields.get('Icon'):
            out += ['--icon', fields['Icon']]
            continue
        w = FIELD_CODES.sub(lambda m: '%' if m.group(0) == '%%' else '', w)   # one pass: "100%%foo" is "100%foo"
        if w:
            out.append(w)
    if not out:
        raise Fail("This launcher doesn't say what to start")
    return out


def launch(path):
    p = os.path.abspath(os.path.expanduser(path))
    fields = hf().parse_desktop(p)
    if fields is None:
        raise Fail('“' + os.path.basename(p) + "” isn't there any more")
    if fields.get('Type') == 'Link' and fields.get('URL'):
        return hf().open_path(fields['URL']) if os.path.exists(fields['URL']) else _spawn(['xdg-open', fields['URL']])
    return _spawn(launch_argv(fields), fields.get('Path') or home())


def _spawn(argv, cwd=None):
    try:
        subprocess.Popen(argv, cwd=cwd if cwd and os.path.isdir(cwd) else home(), stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as e:
        raise Fail("Couldn't start " + os.path.basename(argv[0]) + ': ' + (e.strerror or str(e)))
    return {'ok': True}


