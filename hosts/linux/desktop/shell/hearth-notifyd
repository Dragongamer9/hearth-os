def test_job(title, secs, v1=False):
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)

    def call(path, iface, method, sig=None, args=None, reply=None):
        return bus.call_sync(JOB_NAME, path, iface, method, GLib.Variant(sig, args) if sig else None,
                             GLib.VariantType(reply) if reply else None, Gio.DBusCallFlags.NONE, 5000, None)
    total = 734003200
    if v1:
        path = call(JOB_PATH, 'org.kde.JobViewServer', 'requestView', '(ssi)', ('Dolphin', 'system-file-manager', 3), '(o)').unpack()[0]
        call(path, 'org.kde.JobViewV2', 'setInfoMessage', '(s)', (title,))
        call(path, 'org.kde.JobViewV2', 'setDescriptionField', '(uss)', (0, 'Source', '~/Videos/holiday.mkv'), '(b)')
        call(path, 'org.kde.JobViewV2', 'setDescriptionField', '(uss)', (1, 'Destination', '/media/USB STICK'), '(b)')
        call(path, 'org.kde.JobViewV2', 'setTotalAmount', '(ts)', (total, 'bytes'))
    else:
        path = call(JOB_PATH, 'org.kde.JobViewServerV2', 'requestView', '(sia{sv})',
                    ('org.kde.dolphin', 3, {'title': GLib.Variant('s', title)}), '(o)').unpack()[0]
        call(path, 'org.kde.JobViewV3', 'update', '(a{sv})', ({'descriptionLabel1': GLib.Variant('s', 'Source'),
                                                               'descriptionValue1': GLib.Variant('s', '~/Pictures (214 files)'),
                                                               'descriptionLabel2': GLib.Variant('s', 'Destination'),
                                                               'descriptionValue2': GLib.Variant('s', '/media/Backup'),
                                                               'totalBytes': GLib.Variant('t', total), 'totalFiles': GLib.Variant('t', 214)},))
    start = time.time()
    while time.time() - start < secs:
        f = min(0.97, 0.25 + (time.time() - start) / max(1, secs) * 0.6)
        if v1:
            call(path, 'org.kde.JobViewV2', 'setProcessedAmount', '(ts)', (int(total * f), 'bytes'))
            call(path, 'org.kde.JobViewV2', 'setPercent', '(u)', (int(f * 100),))
            call(path, 'org.kde.JobViewV2', 'setSpeed', '(t)', (48 * 1024 * 1024,))
        else:
            call(path, 'org.kde.JobViewV3', 'update', '(a{sv})', ({'processedBytes': GLib.Variant('t', int(total * f)),
                                                                   'processedFiles': GLib.Variant('t', int(214 * f)),
                                                                   'percent': GLib.Variant('u', int(f * 100)),
                                                                   'speed': GLib.Variant('t', 61 * 1024 * 1024)},))
        time.sleep(1)
    if v1:
        call(path, 'org.kde.JobViewV2', 'terminate', '(s)', ('',))
    else:
        call(path, 'org.kde.JobViewV3', 'terminate', '(usa{sv})', (0, '', {}))
    return 0


def test_badge(app, count, progress):
    import gi
    gi.require_version('Gio', '2.0')
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
    props = {'count': GLib.Variant('x', int(count)), 'count-visible': GLib.Variant('b', int(count) > 0)}
    if progress is not None:
        props['progress'] = GLib.Variant('d', float(progress))
        props['progress-visible'] = GLib.Variant('b', True)
    bus.emit_signal(None, '/com/canonical/unity/launcherentry/hearth', 'com.canonical.Unity.LauncherEntry', 'Update',
                    GLib.Variant('(sa{sv})', ('application://%s.desktop' % app, props)))
    bus.flush_sync(None)
    return 0


def main(argv):
    if argv[:2] == ['serve', '--stdio']:
        return serve()
    if argv[:1] in (['test-job'], ['test-job-v1']) and len(argv) >= 2:
        return test_job(argv[1], float(argv[2]) if len(argv) > 2 else 30, v1=argv[0] == 'test-job-v1')
    if argv[:1] == ['test-badge'] and len(argv) >= 3:
        return test_badge(argv[1], argv[2], argv[3] if len(argv) > 3 else None)
    if argv[:1] == ['parse-lsblk'] and len(argv) == 2:
        print(json.dumps(parse_lsblk(open(argv[1]).read())))
        return 0
    if argv[:1] == ['parse-lpstat'] and len(argv) == 2:
        print(json.dumps(parse_lpstat(open(argv[1]).read())))
        return 0
    print(__doc__)
    return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
