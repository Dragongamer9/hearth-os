def head_bytes(p, n=8192):
    try:
        with open(p, 'rb') as f:
            return f.read(n)
    except OSError:
        return b''


def looks_text(p, head=None):
    """No NUL byte in the first 8 KB (or a UTF-16 byte-order mark): text. An empty file counts as text."""
    head = head_bytes(p) if head is None else head
    return head[:2] in (b'\xff\xfe', b'\xfe\xff') or b'\0' not in head


def is_elf(head):
    return head[:4] == b'\x7fELF'


def is_appimage(p, head):
    return (is_elf(head) and head[8:10] == b'AI') or p.lower().endswith('.appimage')


def text_editor():
    """argv start for opening text: Hearth Text, else the default app for plain text."""
    if shutil.which('hearth-text'):
        return ['hearth-text']
    return None


def open_text(path, readonly=False):
    p = os.path.abspath(os.path.expanduser(path))
    if not os.path.isfile(p):
        raise Fail('“' + os.path.basename(p) + "” isn't there any more")
    ed = text_editor()
    if ed:
        spawn(ed + (['--readonly'] if readonly else []) + ['--', p], cwd=os.path.dirname(p))
        return {'ok': True, 'app': 'hearth-text.desktop'}
    d = default_app('text/plain')
    if d:
        full, fields = desktop_entries()[d['id']]
        spawn(expand_exec(fields['Exec'], p, fields, full), cwd=os.path.dirname(p))
        return {'ok': True, 'app': d['id']}
    raise Fail('No text editor is installed')


def open_unknown(p):
    """No app opens this type: text opens in Hearth Text, anything else asks for "Open with…"."""
    if os.path.isfile(p) and looks_text(p) and (text_editor() or default_app('text/plain')):
        return open_text(p)
    raise Fail('No app is set up to open this kind of file. Try “Open with…”')


def desktop_info(p):
    f = parse_desktop(p)
    if f is None:
        raise Fail("Couldn't read “" + os.path.basename(p) + '”')
    kind = f.get('Type', 'Application')
    return {'name': f.get('Name') or os.path.basename(p), 'comment': f.get('Comment', ''), 'type': kind,
            'exec': f.get('Exec', ''), 'url': f.get('URL', ''), 'terminal': f.get('Terminal', '').lower() == 'true',
            'icon': f.get('Icon', ''), 'path': f.get('Path', ''),
            'runnable': (kind == 'Application' and bool(f.get('Exec'))) or (kind == 'Link' and bool(f.get('URL')))}


def choices():
    c = prefs_get().get('openChoices')
    return c if isinstance(c, dict) else {}


def remembered(p):
    """The choice made for this file before, if the file hasn't changed since."""
    try:
        st = os.stat(p)
    except OSError:
        return None
    c = choices().get(os.path.realpath(p))
    if isinstance(c, list) and len(c) == 3 and c[0] in RUN_CHOICES and c[1] == int(st.st_mtime) and c[2] == st.st_size:
        return c[0]
    return None


def open_choice(path, choice=None):
    p = os.path.realpath(os.path.abspath(os.path.expanduser(path)))
    c = choices()
    c.pop(p, None)
    if choice:
        if choice not in RUN_CHOICES:
            raise Fail('That isn\'t a choice')
        st = os.stat(p)
        c[p] = [choice, int(st.st_mtime), st.st_size]
        c = dict(list(c.items())[-300:])
    prefs_set(json.dumps({'openChoices': c}))
    return {'ok': True, 'choice': choice}


def open_plan(path):
    p = os.path.abspath(os.path.expanduser(path))
    if not lexists(p):
        raise Fail('“' + os.path.basename(p) + "” isn't there any more")
    out = {'path': p, 'name': os.path.basename(p), 'kind': 'default', 'executable': os.access(p, os.X_OK),
           'text': False, 'editor': bool(text_editor()), 'canChmod': False, 'remembered': None}
    if os.path.isdir(p):
        return out
    head = head_bytes(p)
    out['text'] = looks_text(p, head)
    out['canChmod'] = allowed(p) and os.access(p, os.W_OK) and not out['executable']
    ext = os.path.splitext(p)[1].lower()
    if ext == '.desktop':
        out['kind'] = 'desktop'
        out['desktop'] = desktop_info(p)
        out['trusted'] = under(norm(p), os.path.realpath('/usr/share/applications')) or under(norm(p), os.path.realpath(os.path.join(home(), '.local/share/applications')))
        return out
    if is_appimage(p, head) or ext in ('.deb', '.rpm', '.exe', '.msi', '.flatpakref', '.flatpakrepo'):
        return out                     # their own handling (Files, open_path, or the app for the type)
    if is_elf(head):
        out['kind'] = 'program'
    elif ext in SCRIPT_EXT or (head[:2] == b'#!' and out['text']):
        out['kind'] = 'script'
        first = head.split(b'\n', 1)[0].decode('utf-8', 'replace') if head[:2] == b'#!' else ''
        out['shebang'] = first[2:].strip()
        out['interpreter'] = os.path.basename(first[2:].split()[0]) if first[2:].split() else INTERPRETERS.get(ext, '')
        if out['interpreter'] == 'env' and len(first[2:].split()) > 1:
            out['interpreter'] = first[2:].split()[-1]
    if out['kind'] in ('program', 'script'):
        out['remembered'] = remembered(p)
        return out
    mime = sniff_mime(p)
    out['mime'] = mime
    app = default_app(mime)
    # Archives whose app is Hearth Files itself (Hearth's default for them), or none: Files offers to unpack it.
    if is_archive(p) and mime in ARCHIVE_TYPES and (not app or app['id'] == 'hearth-files.desktop'):
        out['kind'] = 'archive'
        return out
    if app:
        return out
    out['kind'] = 'text' if out['text'] else 'binary'
    return out


def make_runnable(path):
    p = check_writable(path, allow_root=True)
    if not os.path.isfile(p):
        raise Fail('Only files can be made runnable')
    try:
        if os.statvfs(p).f_flag & getattr(os, 'ST_NOEXEC', 8):
            raise Fail("Programs can't run from this drive. Copy it to your home folder first.")
    except OSError:
        pass
    st = os.stat(p)
    mode = st.st_mode | stat.S_IXUSR | (stat.S_IXGRP if st.st_mode & stat.S_IRGRP else 0) | (stat.S_IXOTH if st.st_mode & stat.S_IROTH else 0)
    try:
        os.chmod(p, stat.S_IMODE(mode))
    except OSError as e:
        raise Fail("Couldn't make it runnable: " + friendly(e, p))
    if not os.access(p, os.X_OK):
        raise Fail("This drive can't mark files as runnable. Copy it to your home folder first.")
    return {'ok': True, 'mode': stat.S_IMODE(os.stat(p).st_mode)}


def run_argv(p):
    """How to run a script or program: by itself when it's a program or starts with #!, else through the
    interpreter its extension names."""
    head = head_bytes(p, 256)
    if is_elf(head) or head[:2] == b'#!':
        return [p]
    it = INTERPRETERS.get(os.path.splitext(p)[1].lower())
    if it and shutil.which(it):
        return [it, p]
    if it == 'bash' and shutil.which('sh'):
        return ['sh', p]
    return [p]


HOLD = ('name=$1; shift; "$@"; s=$?; printf "\\n\\033[1m%s finished (exit code %s).\\033[0m Press Enter to close this window.\\n" '
        '"$name" "$s"; read -r _')


def terminal_argv(argv, cwd, hold=True, title=''):
    """argv that runs argv in a terminal window (which waits for Enter at the end when hold)."""
    inner = ['sh', '-c', HOLD, 'hearth-run', title or os.path.basename(argv[-1])] + argv if hold else argv
    for term, pre in (('hearth-terminal', ['--cwd', cwd, '-e']), ('foot', ['-D', cwd]), ('konsole', ['--workdir', cwd, '-e']),
                      ('gnome-terminal', ['--working-directory=' + cwd, '--']), ('xfce4-terminal', ['--working-directory', cwd, '-x']),
                      ('alacritty', ['--working-directory', cwd, '-e']), ('kitty', ['-d', cwd]), ('wezterm', ['start', '--cwd', cwd, '--']),
                      ('xterm', ['-e'])):
        if shutil.which(term):
            return [term] + pre + inner
    raise Fail('No terminal app is installed')


def run_file(path, in_terminal=False):
    p = os.path.abspath(os.path.expanduser(path))
    if not os.path.isfile(p):
        raise Fail('“' + os.path.basename(p) + "” isn't there any more")
    if not os.access(p, os.X_OK):
        raise Fail('confirm: “' + os.path.basename(p) + '” isn\'t marked as runnable yet')
    cwd = os.path.dirname(p)
    argv = run_argv(p)
    spawn(terminal_argv(argv, cwd, title=os.path.basename(p)) if in_terminal else argv, cwd=cwd)
    return {'ok': True, 'terminal': in_terminal}


def desktop_launch(path):
    p = os.path.abspath(os.path.expanduser(path))
    d = desktop_info(p)
    if d['type'] == 'Link' and d['url']:
        spawn(['xdg-open', d['url']] if shutil.which('xdg-open') else ['gio', 'open', d['url']])
        return {'ok': True}
    if d['type'] != 'Application' or not d['exec']:
        raise Fail('“' + d['name'] + '” doesn\'t start anything')
    f = parse_desktop(p) or {}
    te = f.get('TryExec')
    if te and not (shutil.which(te) or os.path.exists(te)):
        raise Fail('What “' + d['name'] + '” starts (' + te + ') isn\'t installed')
    try:
        words = shlex.split(d['exec'])
    except ValueError:
        raise Fail('“' + d['name'] + '” has a broken Exec line')
    argv = []
    for w in words:
        if re.fullmatch(r'%[fFuUdDnNickvm]', w):
            if w == '%i' and d['icon']:
                argv += ['--icon', d['icon']]
            elif w == '%c':
                argv.append(d['name'])
            elif w == '%k':
                argv.append(p)
            continue
        argv.append(re.sub(r'%(.)', lambda m: '%' if m.group(1) == '%' else '', w))
    if not argv:
        raise Fail('“' + d['name'] + '” has an empty Exec line')
    cwd = d['path'] if d['path'] and os.path.isdir(d['path']) else home()
    spawn(terminal_argv(argv, cwd, hold=False) if d['terminal'] else argv, cwd=cwd)
    return {'ok': True, 'name': d['name']}


# ---------------------------------------------------------------------- AppImages
APPIMAGE_NAME = re.compile(r'\.appimage$', re.I)
MENU_KEY = 'X-Hearth-AppImage'
# Copied from the AppImage's own .desktop file into the menu entry (never its Exec, TryExec or Actions).
COPY_KEYS = ('Name', 'GenericName', 'Comment', 'Categories', 'Keywords', 'MimeType', 'StartupWMClass', 'Terminal',
             'StartupNotify')


def applications_dir():
    return os.path.join(home(), 'Applications')


def menu_dir():
    return os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.join(home(), '.local', 'share'), 'applications')


def appimage_icons_dir():
    return os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.join(home(), '.local', 'share'), 'icons', 'hearth-appimages')


def appimage_type(path):
    """2 for a type-2 AppImage (ELF with "AI\x02" at byte 8), 1 for type 1, 0 if it isn't one (by its bytes; the
    name alone isn't trusted)."""
    try:
        with open(path, 'rb') as f:
            head = f.read(11)
    except OSError:
        return 0
    if len(head) < 11 or head[:4] != b'\x7fELF' or head[8:10] != b'AI':
        return 0
    return head[10] if head[10] in (1, 2) else 0


def fuse2_available():
    """libfuse.so.2 (classic AppImage runtimes load it) and a fusermount to mount with."""
    lib = any(os.path.exists(os.path.join(d, 'libfuse.so.2')) for d in
              ('/usr/lib64', '/usr/lib/x86_64-linux-gnu', '/usr/lib', '/lib/x86_64-linux-gnu', '/usr/lib/aarch64-linux-gnu'))
    return lib and bool(shutil.which('fusermount') or shutil.which('fusermount3')) and os.path.exists('/dev/fuse')


def appimage_menu_entries():
    """{AppImage's real path: menu entry file} for the menu entries Hearth made."""
    out = {}
    d = menu_dir()
    try:
        names = os.listdir(d)
    except OSError:
        return out
    for n in names:
        if not n.startswith('appimage-') or not n.endswith('.desktop'):
            continue
        f = parse_desktop(os.path.join(d, n)) or {}
        target = f.get(MENU_KEY)
        if target:
            out[os.path.realpath(target)] = os.path.join(d, n)
    return out


def appimage_id(path):
    """A menu entry id for an AppImage: its name without the extension (and a version-looking tail), plus a short
    hash of where it is (two AppImages with the same name in different folders get their own entries)."""
    import hashlib
    stem = APPIMAGE_NAME.sub('', os.path.basename(path))
    stem = re.sub(r'[-_. ]?(x86_64|amd64|aarch64|arm64|x64)$', '', stem, flags=re.I)
    stem = re.sub(r'[^A-Za-z0-9._-]+', '-', stem).strip('-.') or 'app'
    return 'appimage-%s-%s' % (stem[:60], hashlib.sha1(os.path.realpath(path).encode('utf-8', 'surrogateescape')).hexdigest()[:8])


def exec_quote(arg):
    """One argument for a .desktop Exec line (the Desktop Entry spec: quoted when it has reserved characters, with
    " ` $ \\ escaped inside the quotes, then the value's own escaping of backslashes; % doubled)."""
    if re.search(r'[\s"\'\\><~|&;$*?#()`=%]', arg):
        arg = '"' + re.sub(r'(["`$\\])', r'\\\1', arg) + '"'
    return arg.replace('\\', '\\\\').replace('%', '%%')


def desktop_value(v):
    """A value written on one line of a .desktop file."""
    return re.sub(r'[\r\n]+', ' ', v or '').strip()


def build_appimage_entry(app_path, fields=None, icon='', fuse_ok=True):
    """The text of the menu entry for an AppImage at app_path. fields: its own .desktop file's [Desktop Entry]."""
    fields = fields or {}
    name = desktop_value(fields.get('Name')) or APPIMAGE_NAME.sub('', os.path.basename(app_path))
    code = ''
    m = re.search(r'%[fFuU]', fields.get('Exec', ''))
    if m:
        code = ' ' + m.group(0)
    cmd = exec_quote(app_path) + code
    if not fuse_ok:
        cmd = 'env APPIMAGE_EXTRACT_AND_RUN=1 ' + cmd
    lines = ['[Desktop Entry]', 'Type=Application', 'Name=' + name]
    for k in COPY_KEYS[1:]:
        v = desktop_value(fields.get(k))
        if v:
            lines.append('%s=%s' % (k, v))
    lines += ['Exec=' + cmd, 'TryExec=' + app_path.replace('\\', '\\\\'), 'Icon=' + (icon or 'application-x-executable'),
              MENU_KEY + '=' + app_path, 'X-Hearth-Note=Added by Hearth Files; remove it with right-click › Remove from app menu']
    return '\n'.join(lines) + '\n'


def make_executable(p):
    st = os.stat(p)
    if st.st_mode & stat.S_IXUSR:
        return False
    try:
        if os.statvfs(p).f_flag & getattr(os, 'ST_NOEXEC', 8):
            raise Fail('Apps can\'t run from this drive. Copy the AppImage to your home folder first.')
    except OSError:
        pass
    mode = st.st_mode | stat.S_IXUSR | (stat.S_IXGRP if st.st_mode & stat.S_IRGRP else 0) | (stat.S_IXOTH if st.st_mode & stat.S_IROTH else 0)
    try:
        os.chmod(p, stat.S_IMODE(mode))
    except OSError as e:
        raise Fail("Couldn't make it runnable: " + friendly(e, p))
    if not os.stat(p).st_mode & stat.S_IXUSR:
        raise Fail('This drive can\'t mark files as runnable. Copy the AppImage to your home folder first.')
    return True


def appimage_check(path, trust):
    p = os.path.abspath(os.path.expanduser(path))
    if not os.path.isfile(p):
        raise Fail('“' + os.path.basename(p) + "” isn't there any more")
    if not appimage_type(p):
        raise Fail('“' + os.path.basename(p) + "” isn't an AppImage")
    if not os.access(p, os.X_OK):
        if not trust:
            raise Fail('confirm: “' + os.path.basename(p) + '” isn\'t marked as runnable yet')
        make_executable(p)
    return p


def appimage_info(path):
    p = os.path.abspath(os.path.expanduser(path))
    t = appimage_type(p)
    return {'path': p, 'appimage': bool(t), 'type': t, 'executable': os.access(p, os.X_OK),
            'inMenu': os.path.realpath(p) in appimage_menu_entries(), 'fuse': fuse2_available(),
            'folder': os.path.dirname(p)}


def appimage_run(path, trust=False, wait=3.0):
    """Starts it; if it stops at once because it can't mount itself (no FUSE), starts it again unpacked
    (APPIMAGE_EXTRACT_AND_RUN=1). {ok, fallback}."""
    import tempfile
    p = appimage_check(path, trust)
    env = dict(os.environ)
    fallback = not fuse2_available()
    if fallback:
        env['APPIMAGE_EXTRACT_AND_RUN'] = '1'

    def start(e):
        err = tempfile.TemporaryFile()
        proc = subprocess.Popen([p], cwd=os.path.dirname(p), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                stderr=err, start_new_session=True, env=e)
        return proc, err
    try:
        proc, err = start(env)
    except OSError as e:
        raise Fail("Couldn't start it: " + (e.strerror or str(e)))
    end = time.time() + wait
    while time.time() < end and proc.poll() is None:
        time.sleep(0.1)
    if proc.poll() not in (None, 0) and not fallback:
        err.seek(0)
        text = err.read(65536).decode('utf-8', 'replace')
        if re.search(r'(?i)fuse|dlopen|fusermount|squashfs|mount', text):
            env['APPIMAGE_EXTRACT_AND_RUN'] = '1'
            fallback = True
            proc, err = start(env)
            end = time.time() + wait
            while time.time() < end and proc.poll() is None:
                time.sleep(0.1)
    code = proc.poll()
    if code not in (None, 0):
        err.seek(0)
        lines = [l for l in err.read(65536).decode('utf-8', 'replace').splitlines() if l.strip()]
        raise Fail('It stopped straight away' + (': ' + lines[-1][:200] if lines else ' (exit code %d)' % code))
    return {'ok': True, 'fallback': fallback}


def inside(path, root):
    r = os.path.realpath(root)
    rp = os.path.realpath(path)
    return rp == r or rp.startswith(r.rstrip('/') + '/')


def extract_from(app, tmp, pattern):
    try:
        subprocess.run([app, '--appimage-extract', pattern], cwd=tmp, stdin=subprocess.DEVNULL, capture_output=True,
                       timeout=120, env=dict({k: v for k, v in os.environ.items() if k != 'APPIMAGE_EXTRACT_AND_RUN'}, LC_ALL='C'))
    except (OSError, subprocess.TimeoutExpired):
        pass


def icon_kind(path):
    try:
        with open(path, 'rb') as f:
            head = f.read(512)
    except OSError:
        return ''
    if head.startswith(b'\x89PNG'):
        return 'png'
    if b'<svg' in head or head.lstrip().startswith(b'<?xml'):
        return 'svg'
    return ''


def appimage_parts(app):
    """(fields of its .desktop file, path of its icon in a temporary folder, the folder) taken out of the AppImage
    with its own --appimage-extract (type 2). Only files inside the temporary folder are used (never a symlink
    pointing out of it)."""
    import tempfile
    tmp = tempfile.mkdtemp(prefix='hearth-appimage-')
    root = os.path.join(tmp, 'squashfs-root')
    fields, icon = {}, ''
    if appimage_type(app) != 2:
        return fields, icon, tmp
    extract_from(app, tmp, '*.desktop')
    desk = sorted(f for f in (os.listdir(root) if os.path.isdir(root) else []) if f.endswith('.desktop'))
    for f in desk:
        full = os.path.join(root, f)
        if os.path.isfile(full) and inside(full, tmp):
            fields = parse_desktop(full) or {}
            break
    name = re.sub(r'[^A-Za-z0-9._-]', '', fields.get('Icon', ''))[:120]
    candidates = []
    if name:
        candidates += [name + '.png', name + '.svg', 'usr/share/icons/hicolor/256x256/apps/' + name + '.png',
                       'usr/share/icons/hicolor/scalable/apps/' + name + '.svg']
    candidates.append('.DirIcon')
    for c in candidates:
        extract_from(app, tmp, c)
        full = os.path.join(root, c)
        if os.path.islink(full):
            target = os.readlink(full)
            if not os.path.isabs(target) and '..' not in target.split('/'):
                extract_from(app, tmp, os.path.normpath(os.path.join(os.path.dirname(c), target)))
        if os.path.isfile(full) and inside(full, tmp) and icon_kind(full):
            icon = os.path.realpath(full)
            break
    return fields, icon, tmp


def appimage_menu_add(path, trust=False):
    p = appimage_check(path, trust)
    # Moved into ~/Applications (copied when it can't be moved: a USB drive, somewhere you can't change).
    apps = applications_dir()
    moved, dest = False, p
    if not inside(p, apps):
        os.makedirs(apps, exist_ok=True)
        dest = unique(os.path.join(apps, os.path.basename(p)))
        removable = any(inside(p, b) for b in media_bases())
        if allowed(p) and not removable and os.access(os.path.dirname(p), os.W_OK):
            shutil.move(p, dest)
        else:
            shutil.copy2(p, dest)
        moved = True
        make_executable(dest)
    dest = os.path.realpath(dest)
    # An entry already there for it (or for where it was): replaced.
    entries = appimage_menu_entries()
    for old in {entries.get(os.path.realpath(p)), entries.get(dest)} - {None}:
        try:
            os.remove(old)
        except OSError:
            pass
    fields, icon_src, tmp = appimage_parts(dest)
    try:
        ident = appimage_id(dest)
        icon = ''
        if icon_src:
            d = appimage_icons_dir()
            os.makedirs(d, exist_ok=True)
            icon = os.path.join(d, ident + '.' + icon_kind(icon_src))
            shutil.copyfile(icon_src, icon)
        md = menu_dir()
        os.makedirs(md, exist_ok=True)
        entry_file = os.path.join(md, ident + '.desktop')
        with open(entry_file + '.tmp', 'w', encoding='utf-8') as f:
            f.write(build_appimage_entry(dest, fields, icon, fuse2_available()))
        os.replace(entry_file + '.tmp', entry_file)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    name = desktop_value(fields.get('Name')) or APPIMAGE_NAME.sub('', os.path.basename(dest))
    return {'ok': True, 'path': dest, 'moved': moved, 'from': p if moved else '', 'desktop': entry_file, 'name': name,
            'icon': icon}


def appimage_menu_remove(path):
    p = os.path.realpath(os.path.abspath(os.path.expanduser(path)))
    md, removed = menu_dir(), 0
    for target, f in appimage_menu_entries().items():
        if target != p:
            continue
        icon = (parse_desktop(f) or {}).get('Icon', '')
        try:
            os.remove(f)
            removed += 1
        except OSError as e:
            raise Fail("Couldn't take it out of the menu: " + friendly(e, f))
        if icon and inside(icon, appimage_icons_dir()):
            try:
                os.remove(icon)
            except OSError:
                pass
    if not removed:
        raise Fail("It isn't in the app menu")
    return {'ok': True, 'removed': removed}


# ---------------------------------------------------------------------- Hearth Storage (hearth://)
# Shared folders on a paired Hearth Storage device (hosts/hearth-link storage.rs), through Hearth Link's own
# connection: hearth://SERVER/SHARE/PATH. Read-only here: listing, copying to this device (Hearth Link copies in the
# background, verified, resumable) and opening (videos and music play straight from the server in Hearth Player;
# other files are copied to Downloads first).
LINK_BIN = os.environ.get('HEARTH_LINK_BIN', '/usr/bin/hearth-link')
PLAYER_BIN = '/usr/bin/hearth-player'
REMOTE_RE = re.compile(r'^hearth://([0-9a-f]{16,64})/([0-9a-f]{1,32})(?:/(.*))?$')
REMOTE_MEDIA = re.compile(r'\.(mp4|m4v|mkv|webm|avi|mov|ts|mp3|flac|ogg|oga|opus|m4a|wav|aac)$', re.I)


def is_remote(p):
    return isinstance(p, str) and p.startswith('hearth://')


def link_call(cmd, args, timeout=150):
    """One request to Hearth Link (`hearth-link call`); Fail with its words when it says no. Tests replace this."""
    if not os.path.exists(LINK_BIN):
        raise Fail('Hearth Storage comes with the next Hearth OS update')
    try:
        r = subprocess.run([LINK_BIN, 'call', cmd, json.dumps(args)], capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise Fail('Hearth Storage took too long to answer')
    lines = (r.stdout or '').strip().splitlines()
    try:
        v = json.loads(lines[-1]) if lines else None
    except ValueError:
        v = None
    if r.returncode != 0 or not isinstance(v, dict) or set(v) == {'error'}:
        raise Fail(v.get('error') if isinstance(v, dict) and v.get('error') else "Hearth Link didn't answer")
    return v


def parse_remote(p):
    """(server, share, path in the share) of a hearth:// address, checked: plain parts only, nothing hidden."""
    m = REMOTE_RE.match(p or '')
    if not m:
        raise Fail("That isn't a Hearth Storage folder")
    rel = (m.group(3) or '').strip('/')
    if rel and any(x in ('', '.', '..') or x.startswith('.') for x in rel.split('/')):
        raise Fail("That isn't a Hearth Storage folder")
    return m.group(1), m.group(2), rel


def remote_uri(server, share, rel):
    return 'hearth://%s/%s/%s' % (server, share, rel)


def storage_places():
    """The paired Hearth Storage devices' shared folders, as places (only what Hearth Link already knows: no waiting)."""
    if not os.path.exists(LINK_BIN):
        return []
    try:
        st = link_call('storage.status', {}, timeout=5)
    except (Fail, OSError):
        return []
    out = []
    for sv in st.get('servers') or []:
        for sh in sv.get('shares') or []:
            if not isinstance(sh, dict) or not sh.get('id'):
                continue
            out.append({'id': 'hstore:%s:%s' % (sv.get('id'), sh['id']), 'label': '%s on %s' % (sh.get('name') or 'Shared', sv.get('name') or 'Hearth Storage'),
                        'path': remote_uri(sv.get('id'), sh['id'], ''), 'kind': 'network', 'section': 'network'})
    return out


def remote_list(path):
    server, share, rel = parse_remote(path)
    r = link_call('storage.ls', {'server': server, 'share': share, 'path': rel})
    entries = []
    for e in r.get('entries') or []:
        name = e.get('name') or ''
        if not name or '/' in name or name.startswith('.'):
            continue
        isdir = bool(e.get('dir'))
        entries.append({'name': name, 'path': remote_uri(server, share, (rel + '/' + name) if rel else name), 'dir': isdir,
                        'size': 0 if isdir else int(e.get('size') or 0), 'mtime': int(e.get('mtime') or 0),
                        'mime': mime_of(name, isdir), 'isLink': False, 'hidden': False, 'remote': True})
    parent = remote_uri(server, share, rel.rsplit('/', 1)[0] if '/' in rel else '') if rel else None
    return {'path': remote_uri(server, share, rel), 'name': rel.rsplit('/', 1)[-1] if rel else (r.get('share') or 'Shared folder'),
            'parent': parent, 'writable': False, 'trash': False, 'entries': entries, 'free': None, 'total': None, 'remote': True}


def remote_copy(srcs, dest, move):
    """Files and folders from Hearth Storage into a folder here: Hearth Link copies them in the background."""
    if move:
        raise Fail('Files on Hearth Storage can only be copied from here')
    if is_remote(dest):
        raise Fail("Hearth Storage's shared folders can't be changed from here")
    d = norm(dest)
    if not os.path.isdir(d):
        raise Fail("That folder isn't there any more")
    started = []
    for s in srcs:
        server, share, rel = parse_remote(s)
        link_call('storage.get', {'server': server, 'share': share, 'path': rel, 'place': d})
        started.append(os.path.join(d, rel.rsplit('/', 1)[-1] if rel else ''))
    return {'ok': True, 'items': started, 'skipped': [], 'bytes': 0, 'seconds': 0, 'background': True,
            'note': 'Copying over Hearth Link: Settings › Hearth Link shows how it goes'}


def remote_open(path):
    server, share, rel = parse_remote(path)
    if not rel:
        raise Fail('Open the folder to see what is in it')
    if REMOTE_MEDIA.search(rel):
        r = link_call('storage.stream', {'server': server, 'share': share, 'path': rel})
        url = r.get('url') or ''
        if not url.startswith('http://127.0.0.1:'):
            raise Fail("Hearth Link gave a link that isn't on this device")
        spawn([PLAYER_BIN, url] if os.path.exists(PLAYER_BIN) else ['xdg-open', url], cwd=home())
        return {'ok': True, 'streaming': True}
    link_call('storage.get', {'server': server, 'share': share, 'path': rel})
    return {'ok': True, 'note': 'Copying it to Downloads first (Settings › Hearth Link shows how it goes)'}


def remote_cmd(c, rest):
    """A command about hearth:// addresses, or None when it isn't one."""
    if not any(is_remote(a) for a in rest):
        return None
    if c == 'list':
        return remote_list([a for a in rest if a != '--hidden'][0])
    if c in ('copy', 'move'):
        plain = [a for a in rest if not a.startswith('--')]
        return remote_copy(plain[:-1], plain[-1], c == 'move')
    if c == 'conflicts':
        return {'conflicts': [], 'dest': rest[-1]}
    if c == 'open':
        return remote_open(rest[0])
    if c == 'open-plan':
        return {'path': rest[0], 'name': rest[0].rstrip('/').rsplit('/', 1)[-1], 'kind': 'default', 'executable': False,
                'text': False, 'editor': False, 'canChmod': False, 'remembered': None}
    if c == 'thumbs':
        return thumbs([a for a in rest if not is_remote(a)]) if any(not is_remote(a) for a in rest) else {'ok': True, 'made': []}
    if c == 'clip-set':
        return None
    raise Fail("Hearth Storage's shared folders can't be changed from here: copy what you need to this device")


# ---------------------------------------------------------------------- command line
USAGE = ('usage: hearth-files list PATH [--hidden] | places | mkdir PATH | rename PATH NEWNAME | trash PATH... | '
         'restore PATH... | empty-trash | delete PATH... | copy SRC... DEST | move SRC... DEST | info PATH | '
         'apps PATH | open PATH [APP_ID] | eject PATH | mount DEVICE | unmount PATH | props PATH... | count PATH... | '
         'checksum ALGO PATH | chmod PATH MODE | set-default PATH APP_ID | conflicts SRC... DEST | new-file PATH | '
         'templates | from-template TEMPLATE FOLDER [NAME] | batch-rename PATTERN PATH... | '
         'compress FORMAT ARCHIVE SRC... | extract ARCHIVE DEST|--here | search PATH QUERY [--hidden] | bookmarks | '
         'bookmark-add PATH [LABEL] | bookmark-remove PATH | prefs | prefs-set JSON | clip-set MODE PATH... | '
         'clip-get | peek PATH | thumbs PATH... | terminal PATH | open-plan PATH | run PATH [--terminal] | '
         'make-runnable PATH | open-text PATH [--readonly] | desktop-launch PATH | open-choice PATH [CHOICE] | appimage-info PATH | appimage-run PATH [--trust] | '
         'appimage-menu-add PATH [--trust] | appimage-menu-remove PATH')


def cmd(argv):
    args = argv[1:]
    c = args[0] if args else ''
    rest = args[1:]
    remote = remote_cmd(c, rest)
    if remote is not None:
        print(json.dumps(remote), flush=True)
        return
    if c == 'list' and rest:
        hidden = '--hidden' in rest
        paths = [a for a in rest if a != '--hidden']
        out = list_dir(paths[0] if paths else '', hidden)
    elif c == 'list':
        out = list_dir('', False)
    elif c == 'places':
        out = places()
    elif c == 'mkdir' and len(rest) == 1:
        out = mkdir(rest[0])
    elif c == 'rename' and len(rest) == 2:
        out = rename(rest[0], rest[1])
    elif c == 'trash' and rest:
        out = trash(rest)
    elif c == 'restore' and rest:
        out = restore(rest)
    elif c == 'empty-trash':
        out = empty_trash()
    elif c == 'delete' and rest:
        out = delete(rest)
    elif c in ('copy', 'move') and len(rest) >= 2:
        decide, default, plain = {}, 'rename', []
        i = 0
        while i < len(rest):
            if rest[i] == '--decide' and i + 1 < len(rest):
                try:
                    decide = json.loads(rest[i + 1])
                except ValueError:
                    raise Fail('--decide takes JSON')
                i += 2
            elif rest[i] == '--default' and i + 1 < len(rest) and rest[i + 1] in ('rename', 'replace', 'skip'):
                default = rest[i + 1]
                i += 2
            else:
                plain.append(rest[i])
                i += 1
        if len(plain) < 2:
            print(USAGE)
            sys.exit(2)
        out = transfer(plain[:-1], plain[-1], c == 'move', decide, default)
    elif c == 'info' and len(rest) == 1:
        out = info(rest[0])
    elif c == 'apps' and len(rest) in (1, 2):
        out = apps(rest[0], '--all' in rest[1:])
    elif c == 'open' and len(rest) in (1, 2):
        out = open_path(rest[0], rest[1] if len(rest) == 2 else None)
    elif c == 'eject' and len(rest) == 1:
        out = eject(rest[0])
    elif c == 'mount' and len(rest) == 1:
        out = mount(rest[0])
    elif c == 'unmount' and len(rest) == 1:
        out = unmount(rest[0])
    elif c == 'props' and rest:
        out = props(rest)
    elif c == 'count' and rest:
        out = count(rest)
    elif c == 'checksum' and len(rest) == 2:
        out = checksum(rest[0], rest[1])
    elif c == 'chmod' and len(rest) == 2:
        out = chmod(rest[0], rest[1])
    elif c == 'set-default' and len(rest) == 2:
        out = set_default(rest[0], rest[1])
    elif c == 'conflicts' and len(rest) >= 2:
        out = conflicts(rest[:-1], rest[-1])
    elif c == 'new-file' and len(rest) == 1:
        out = new_file(rest[0])
    elif c == 'templates':
        out = templates()
    elif c == 'from-template' and len(rest) in (2, 3):
        out = from_template(rest[0], rest[1], rest[2] if len(rest) == 3 else None)
    elif c == 'batch-rename' and len(rest) >= 2:
        out = batch_rename(rest[0], rest[1:])
    elif c == 'compress' and len(rest) >= 3:
        out = compress(rest[0], rest[1], rest[2:])
    elif c == 'extract' and len(rest) == 2:
        out = extract(rest[0], rest[1], here=rest[1] == '--here')
    elif c == 'search' and len(rest) >= 2:
        args = [a for a in rest if a != '--hidden']
        out = search(args[0], ' '.join(args[1:]), '--hidden' in rest)
    elif c == 'bookmarks':
        out = {'bookmarks': [{'path': p, 'label': l} for p, l in read_bookmarks()]}
    elif c == 'bookmark-add' and len(rest) in (1, 2):
        out = bookmark_add(rest[0], rest[1] if len(rest) == 2 else '')
    elif c == 'bookmark-remove' and len(rest) == 1:
        out = bookmark_remove(rest[0])
    elif c == 'prefs':
        out = prefs_get()
    elif c == 'prefs-set' and len(rest) == 1:
        out = prefs_set(rest[0])
    elif c == 'clip-set' and len(rest) >= 2 and rest[0] in ('copy', 'cut'):
        out = clip_set(rest[0], rest[1:])
    elif c == 'clip-get':
        out = clip_get()
    elif c == 'peek' and len(rest) == 1:
        out = peek(rest[0])
    elif c == 'thumbs' and rest:
        out = thumbs(rest)
    elif c == 'terminal' and len(rest) == 1:
        out = terminal(rest[0])
    elif c == 'appimage-info' and len(rest) == 1:
        out = appimage_info(rest[0])
    elif c == 'appimage-run' and len(rest) in (1, 2) and rest[1:] in ([], ['--trust']):
        out = appimage_run(rest[0], rest[1:] == ['--trust'])
    elif c == 'appimage-menu-add' and len(rest) in (1, 2) and rest[1:] in ([], ['--trust']):
        out = appimage_menu_add(rest[0], rest[1:] == ['--trust'])
    elif c == 'appimage-menu-remove' and len(rest) == 1:
        out = appimage_menu_remove(rest[0])
    elif c == 'open-plan' and len(rest) == 1:
        out = open_plan(rest[0])
    elif c == 'run' and len(rest) in (1, 2) and rest[1:] in ([], ['--terminal']):
        out = run_file(rest[0], rest[1:] == ['--terminal'])
    elif c == 'make-runnable' and len(rest) == 1:
        out = make_runnable(rest[0])
    elif c == 'open-text' and len(rest) in (1, 2) and rest[1:] in ([], ['--readonly']):
        out = open_text(rest[0], rest[1:] == ['--readonly'])
    elif c == 'desktop-launch' and len(rest) == 1:
        out = desktop_launch(rest[0])
    elif c == 'open-choice' and len(rest) in (1, 2):
        out = open_choice(rest[0], rest[1] if len(rest) == 2 else None)
    else:
        print(USAGE)
        sys.exit(2)
    print(json.dumps(out), flush=True)


if __name__ == '__main__':
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)
    try:
        cmd(sys.argv)
    except Fail as e:
        print('error: ' + str(e), flush=True)
        sys.exit(1)
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        print('error: ' + (friendly(e) if isinstance(e, OSError) else str(e)), flush=True)
        sys.exit(1)
