def batch_rename(pattern, paths):
    """Renames several at once: "Holiday #" → Holiday 1.jpg, Holiday 2.jpg… (### pads: 001). Extensions stay."""
    if '#' not in pattern:
        pattern = pattern + ' #'
    m = re.search(r'#+', pattern)
    width = len(m.group(0))
    plan = []
    for i, path in enumerate(paths, 1):
        p = check_writable(path)
        if not lexists(p):
            raise Fail('“' + os.path.basename(p) + "” isn't there any more")
        ext = '' if os.path.isdir(p) else os.path.splitext(os.path.basename(p))[1]
        new = valid_name(pattern[:m.start()] + str(i).zfill(width) + pattern[m.end():] + ext)
        plan.append((p, os.path.join(os.path.dirname(p), new)))
    olds = {p for p, _ in plan}
    for p, dest in plan:
        if lexists(dest) and dest not in olds:
            raise Fail("There's already something called “" + os.path.basename(dest) + '” there')
    # Through temporary names first, so "b → a, a → b" style swaps work.
    temps = []
    try:
        for n, (p, dest) in enumerate(plan):
            t = os.path.join(os.path.dirname(p), '.hearth-rename-%d-%d' % (os.getpid(), n))
            os.rename(p, t)
            temps.append((t, p, dest))
        for t, _, dest in temps:
            os.rename(t, dest)
    except OSError as e:
        for t, p, _ in temps:
            if lexists(t):
                try:
                    os.rename(t, p)
                except OSError:
                    pass
        raise Fail(friendly(e))
    return {'ok': True, 'paths': [d for _, d in plan]}


