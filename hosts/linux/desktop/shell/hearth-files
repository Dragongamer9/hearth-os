def mime_comment(mime):
    """The plain-words name of a type ("PNG image") from the shared MIME database, or ''."""
    if not mime or '/' not in mime:
        return ''
    for d in data_dirs():
        f = os.path.join(d, 'mime', mime + '.xml')
        try:
            with open(f, encoding='utf-8', errors='replace') as fh:
                text = fh.read()
        except OSError:
            continue
        m = re.search(r'<comment>([^<]*)</comment>', text)
        if m:
            return m.group(1).strip()
    return ''


GENERIC_ICONS = (('image/', 'image-x-generic'), ('video/', 'video-x-generic'), ('audio/', 'audio-x-generic'),
                 ('text/', 'text-x-generic'), ('font/', 'font-x-generic'))


def icon_names(mime, isdir=False):
    """(theme icon name, its generic fallback) for a type, the way file managers pick them."""
    if isdir:
        return 'folder', 'inode-directory'
    generic = next((g for pre, g in GENERIC_ICONS if mime.startswith(pre)), '')
    if not generic:
        if re.search(r'zip|x-7z|rar|x-tar|gzip|x-xz|zstd|bzip|compressed', mime):
            generic = 'package-x-generic'
        elif re.search(r'executable|x-msi|appimage|x-shellscript', mime):
            generic = 'application-x-executable'
        elif re.search(r'pdf|document|msword|opendocument|epub', mime):
            generic = 'x-office-document'
        else:
            generic = 'text-x-generic'
    return mime.replace('/', '-'), generic


def birth_time(p):
    """When the file was made, if the drive keeps that (statx through coreutils' stat), else None."""
    try:
        r = subprocess.run(['stat', '-c', '%W', '--', p], capture_output=True, text=True, timeout=3)
        v = int(r.stdout.strip() or 0)
        return v if v > 0 else None
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def image_size(p):
    """(width, height) read from a picture's header (PNG, GIF, JPEG, BMP, WebP), or None. Cheap: no decoding."""
    try:
        with open(p, 'rb') as f:
            head = f.read(64)
            if head[:8] == b'\x89PNG\r\n\x1a\n' and head[12:16] == b'IHDR':
                return int.from_bytes(head[16:20], 'big'), int.from_bytes(head[20:24], 'big')
            if head[:6] in (b'GIF87a', b'GIF89a'):
                return int.from_bytes(head[6:8], 'little'), int.from_bytes(head[8:10], 'little')
            if head[:2] == b'BM' and len(head) >= 26:
                return int.from_bytes(head[18:22], 'little', signed=True), abs(int.from_bytes(head[22:26], 'little', signed=True))
            if head[:4] == b'RIFF' and head[8:12] == b'WEBP':
                kind = head[12:16]
                if kind == b'VP8X':
                    return 1 + int.from_bytes(head[24:27], 'little'), 1 + int.from_bytes(head[27:30], 'little')
                if kind == b'VP8 ':
                    return int.from_bytes(head[26:28], 'little') & 0x3fff, int.from_bytes(head[28:30], 'little') & 0x3fff
                if kind == b'VP8L':
                    b = head[21:25]
                    return 1 + (((b[1] & 0x3f) << 8) | b[0]), 1 + (((b[3] & 0xf) << 10) | (b[2] << 2) | ((b[1] & 0xc0) >> 6))
                return None
            if head[:2] == b'\xff\xd8':
                f.seek(2)
                while True:
                    m = f.read(2)
                    if len(m) < 2 or m[0] != 0xff:
                        return None
                    marker = m[1]
                    if marker in (0xd8, 0x01) or 0xd0 <= marker <= 0xd7:
                        continue
                    ln = int.from_bytes(f.read(2), 'big')
                    if marker in (0xc0, 0xc1, 0xc2, 0xc3, 0xc5, 0xc6, 0xc7, 0xc9, 0xca, 0xcb, 0xcd, 0xce, 0xcf):
                        seg = f.read(5)
                        return int.from_bytes(seg[3:5], 'big'), int.from_bytes(seg[1:3], 'big')
                    if ln < 2:
                        return None
                    f.seek(ln - 2, 1)
    except OSError:
        pass
    return None


def media_duration(p):
    """Seconds of audio or video, if ffprobe is installed (and answers quickly), else None."""
    if not shutil.which('ffprobe'):
        return None
    try:
        r = subprocess.run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'csv=p=0', '--', p],
                           capture_output=True, text=True, timeout=4)
        v = float(r.stdout.strip().splitlines()[0])
        return round(v, 2) if v > 0 else None
    except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
        return None


def mount_info(p):
    """(mount point, device, filesystem type) of the drive p is on."""
    mp = mount_point(p)
    dev = fs = ''
    try:
        with open('/proc/mounts') as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 3 and re.sub(r'\\([0-7]{3})', lambda x: chr(int(x.group(1), 8)), parts[1]) == mp:
                    dev, fs = parts[0], parts[2]
    except OSError:
        pass
    return mp, dev, fs


def group_name(gid):
    try:
        import grp
        return grp.getgrgid(gid).gr_name
    except (KeyError, ImportError):
        return str(gid)


def default_app(mime):
    entries = desktop_entries()
    defaults, _, _ = mimeapps(mime)
    did = next((d for d in defaults if d in entries and usable(entries[d][1])), None)
    if not did and shutil.which('gio'):
        # No choice in mimeapps.list: what GLib would pick (its own rules, e.g. the type's parent).
        try:
            r = subprocess.run(['gio', 'mime', mime], capture_output=True, text=True, timeout=3)
            m = re.search(r"Default application for .*?:\s*(\S+\.desktop)", r.stdout)
            if m and m.group(1) in entries:
                did = m.group(1)
        except (OSError, subprocess.TimeoutExpired):
            pass
    if not did:
        return None
    f = entries[did][1]
    return {'id': did, 'name': f.get('Name') or did[:-8], 'icon': f.get('Icon', '')}


def props_one(path):
    p = os.path.abspath(os.path.expanduser(path))
    try:
        lst = os.lstat(p)
    except OSError as e:
        raise Fail(friendly(e, p))
    link = stat.S_ISLNK(lst.st_mode)
    broken = False
    st = lst
    if link:
        try:
            st = os.stat(p)
        except OSError:
            broken = True
    isdir = stat.S_ISDIR(st.st_mode)
    mime = 'inode/symlink' if broken else sniff_mime(p)
    icon, generic = icon_names(mime, isdir)
    try:
        owner = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        owner = str(st.st_uid)
    mp, dev, fs = mount_info(p if isdir else os.path.dirname(p))
    free, total = free_space(p if isdir else os.path.dirname(p))
    parent_ok = os.access(os.path.dirname(p) or '/', os.W_OK)
    out = {'name': os.path.basename(p) or '/', 'path': p, 'parent': os.path.dirname(p), 'dir': isdir,
           'isLink': link, 'broken': broken, 'mime': mime, 'desc': mime_comment(mime), 'icon': icon,
           'iconFallback': generic, 'size': 0 if isdir else st.st_size,
           'disk': 0 if isdir else getattr(lst, 'st_blocks', 0) * 512,
           'mtime': int(st.st_mtime), 'atime': int(st.st_atime), 'ctime': int(st.st_ctime), 'btime': birth_time(p),
           'owner': owner, 'group': group_name(st.st_gid), 'uid': st.st_uid, 'gid': st.st_gid,
           'mode': stat.S_IMODE(st.st_mode), 'modeText': stat.filemode(st.st_mode),
           'mine': os.getuid() in (0, st.st_uid) and allowed(p) and not link,
           'canRename': allowed(p) and parent_ok and p not in write_roots() and p != '/',
           'exec': bool(not isdir and stat.S_ISREG(st.st_mode) and st.st_mode & 0o111),
           'mount': isdir and not link and os.path.ismount(p), 'mountPoint': mp, 'device': dev, 'fs': fs,
           'free': free, 'total': total, 'trashed': in_trash(p)}
    if link:
        try:
            out['target'] = os.readlink(p)
        except OSError:
            out['target'] = ''
    if out['trashed']:
        out['origPath'], out['deleted'] = read_trash_info(*trash_info_for(p))
    if not isdir and not broken:
        if mime.startswith('image/'):
            wh = image_size(p)
            if wh:
                out['width'], out['height'] = wh
        if mime.startswith('audio/') or mime.startswith('video/'):
            out['duration'] = media_duration(p)
        try:
            out['app'] = default_app(mime)
        except OSError:
            out['app'] = None
    return out


def props(paths):
    """What the Properties window shows: everything about one item, or a summary of several."""
    if len(paths) == 1:
        return props_one(paths[0])
    items = []
    for path in paths:
        p = os.path.abspath(os.path.expanduser(path))
        e = entry(p, os.path.basename(p))
        if e:
            items.append({'name': e['name'], 'path': p, 'dir': e['dir'], 'mime': e['mime'], 'size': e['size']})
    if not items:
        raise Fail("These aren't there any more")
    parents = {os.path.dirname(i['path']) for i in items}
    mimes = {i['mime'] for i in items}
    mime = mimes.pop() if len(mimes) == 1 else ''
    out = {'multi': True, 'count': len(items), 'items': items, 'parent': parents.pop() if len(parents) == 1 else None,
           'files': sum(1 for i in items if not i['dir']), 'folders': sum(1 for i in items if i['dir']),
           'mime': mime, 'desc': mime_comment(mime) if mime else ''}
    free, total = free_space(items[0]['path'])
    out['free'], out['total'] = free, total
    return out


def count(paths):
    """Adds up folders in the background: "progress: {size, disk, files, folders}" lines, then the total."""
    totals = {'size': 0, 'disk': 0, 'files': 0, 'folders': 0, 'unreadable': 0}
    last = [time.monotonic()]

    def stop(*_):
        raise Cancelled()
    signal.signal(signal.SIGTERM, stop)

    def report(force=False):
        now = time.monotonic()
        if force or now - last[0] >= 0.2:
            last[0] = now
            print('progress: ' + json.dumps(totals), flush=True)

    def add(st):
        totals['size'] += st.st_size
        totals['disk'] += getattr(st, 'st_blocks', 0) * 512

    try:
        for path in paths:
            p = os.path.abspath(os.path.expanduser(path))
            try:
                st = os.lstat(p)
            except OSError:
                continue
            if not stat.S_ISDIR(st.st_mode):
                add(st)
                totals['files'] += 1
                continue
            stack = [p]
            while stack:
                d = stack.pop()
                try:
                    it = os.scandir(d)
                except OSError:
                    totals['unreadable'] += 1
                    continue
                with it:
                    for e in it:
                        try:
                            est = e.stat(follow_symlinks=False)
                        except OSError:
                            continue
                        if stat.S_ISDIR(est.st_mode):
                            totals['folders'] += 1
                            stack.append(e.path)
                        else:
                            totals['files'] += 1
                            add(est)
                report()
    except Cancelled:
        return dict(totals, cancelled=True)
    report(True)
    return dict(totals, ok=True)


def checksum(algo, path):
    """MD5, SHA-1 or SHA-256 of a file, with "progress: {done, total}" lines on the way."""
    import hashlib
    algo = algo.lower().replace('-', '')
    if algo not in ('md5', 'sha1', 'sha256', 'sha512'):
        raise Fail('Hearth Files knows MD5, SHA-1, SHA-256 and SHA-512')
    p = os.path.abspath(os.path.expanduser(path))
    if not os.path.isfile(p):
        raise Fail('Only files have checksums')

    def stop(*_):
        raise Cancelled()
    signal.signal(signal.SIGTERM, stop)
    h = hashlib.new(algo)
    total = os.path.getsize(p)
    done, last = 0, time.monotonic()
    try:
        with open(p, 'rb') as f:
            while True:
                buf = f.read(CHUNK)
                if not buf:
                    break
                h.update(buf)
                done += len(buf)
                if time.monotonic() - last >= 0.2:
                    last = time.monotonic()
                    print('progress: ' + json.dumps({'done': done, 'total': total}), flush=True)
    except Cancelled:
        return {'cancelled': True}
    except OSError as e:
        raise Fail(friendly(e, p))
    return {'ok': True, 'algo': algo, 'sum': h.hexdigest(), 'path': p}


def chmod(path, mode):
    """Set the read / write / run permissions (an octal number like 755)."""
    p = check_writable(path, allow_root=True)
    try:
        m = int(str(mode), 8)
    except ValueError:
        raise Fail("That isn't a permission number")
    if m < 0 or m > 0o7777:
        raise Fail("That isn't a permission number")
    if os.path.islink(p):
        raise Fail("A shortcut's permissions are the ones of what it points to")
    try:
        os.chmod(p, m)
    except OSError as e:
        raise Fail(friendly(e, p))
    return {'ok': True, 'mode': stat.S_IMODE(os.stat(p).st_mode)}


def set_default(path, app_id):
    """Makes app_id the app that opens this kind of file (your mimeapps.list, as every desktop reads it)."""
    p = os.path.abspath(os.path.expanduser(path))
    mime = sniff_mime(p)
    if app_id not in desktop_entries():
        raise Fail("That app isn't installed any more")
    cfg = os.environ.get('XDG_CONFIG_HOME') or os.path.join(home(), '.config')
    f = os.path.join(cfg, 'mimeapps.list')
    try:
        with open(f, encoding='utf-8', errors='surrogateescape') as fh:
            lines = fh.read().splitlines()
    except OSError:
        lines = []

    def put(section, value, front=True):
        nonlocal lines
        try:
            i = lines.index(section)
        except ValueError:
            if lines and lines[-1].strip():
                lines.append('')
            lines += [section]
            i = len(lines) - 1
        j = i + 1
        while j < len(lines) and not lines[j].startswith('['):
            k = lines[j].split('=', 1)[0].strip()
            if k == mime:
                old = [x for x in lines[j].split('=', 1)[1].strip().split(';') if x and x != value]
                lines[j] = mime + '=' + ';'.join(([value] + old) if front else [value]) + ';'
                return
            j += 1
        while j > i + 1 and not lines[j - 1].strip():
            j -= 1
        lines.insert(j, mime + '=' + value + ';')

    put('[Default Applications]', app_id, front=False)
    put('[Added Associations]', app_id)
    os.makedirs(cfg, exist_ok=True)
    tmp = f + '.hearth-tmp'
    with open(tmp, 'w', encoding='utf-8', errors='surrogateescape') as fh:
        fh.write('\n'.join(lines) + '\n')
    os.replace(tmp, f)
    return {'ok': True, 'mime': mime, 'app': app_id}


