def templates():
    """Your document templates (~/Templates): New document › …"""
    t = templates_dir()
    out = []
    if os.path.realpath(t) == os.path.realpath(home()):
        return {'dir': t, 'templates': out}
    for root, dirs, files in os.walk(t):
        dirs[:] = sorted(d for d in dirs if not d.startswith('.'))
        for name in sorted(files, key=str.lower):
            if name.startswith('.'):
                continue
            full = os.path.join(root, name)
            stem = os.path.splitext(name)[0] or name
            rel = os.path.relpath(root, t)
            out.append({'name': stem if rel == '.' else rel + ' › ' + stem, 'file': name, 'path': full,
                        'mime': mime_of(name)})
        if len(out) > 100:
