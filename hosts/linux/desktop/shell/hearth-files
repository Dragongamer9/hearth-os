ARCHIVE_EXT = ('.tar.gz', '.tgz', '.tar.xz', '.txz', '.tar.bz2', '.tbz2', '.tbz', '.tar.zst', '.tzst', '.tar',
               '.zip', '.7z', '.rar', '.gz', '.xz', '.bz2', '.zst', '.iso', '.cbz', '.cbr', '.jar', '.apk')


# The archive types Hearth Files opens (its .desktop file's MimeType: it's their default app on Hearth OS).
ARCHIVE_TYPES = ('application/zip', 'application/x-tar', 'application/x-compressed-tar', 'application/x-xz-compressed-tar',
                 'application/x-bzip2-compressed-tar', 'application/x-zstd-compressed-tar', 'application/gzip',
                 'application/x-gzip', 'application/x-xz', 'application/x-bzip2', 'application/zstd',
                 'application/x-7z-compressed', 'application/vnd.rar', 'application/x-rar')


def archive_stem(name):
    low = name.lower()
    for ext in ARCHIVE_EXT:
        if low.endswith(ext) and len(name) > len(ext):
            return name[:-len(ext)]
    return os.path.splitext(name)[0] or name


def is_archive(name):
    low = name.lower()
    return any(low.endswith(e) for e in ARCHIVE_EXT)


def compress(fmt, archive, srcs):
    """Packs srcs into archive (zip or tar.gz), with progress lines; stopping removes the half-made file."""
    import tarfile
    import zipfile
    fmt = fmt.lower()
    if fmt not in ('zip', 'tar.gz', 'tar.xz', 'tar', '7z'):
        raise Fail('Hearth Files makes .zip, .7z, .tar.gz, .tar.xz and .tar archives')
    seven = (shutil.which('7z') or shutil.which('7zz') or shutil.which('7za')) if fmt == '7z' else None
    if fmt == '7z' and not seven:
        raise Fail('making .7z archives needs 7-Zip')
    out = check_writable(archive)
    valid_name(os.path.basename(out))
    if lexists(out):
        raise Fail("There's already something called “" + os.path.basename(out) + '” here')
    items = []
    for s in srcs:
        p = norm(s)
        if not lexists(p):
            raise Fail('“' + os.path.basename(p) + "” isn't there any more")
        items.append(p)
    if os.path.realpath(out) in {os.path.realpath(i) for i in items}:
        raise Fail("An archive can't hold itself")
    files = []                         # (full path, name inside, is folder)
    for p in items:
        base = os.path.dirname(p)
        if os.path.isdir(p) and not os.path.islink(p):
            for root, dirs, fs in os.walk(p):
                dirs.sort()
                files.append((root, os.path.relpath(root, base), True))
                for n in sorted(fs):
                    full = os.path.join(root, n)
                    if os.path.realpath(full) != os.path.realpath(out):
                        files.append((full, os.path.relpath(full, base), False))
        else:
            files.append((p, os.path.basename(p), False))
    total = 0
    for f, _, isd in files:
        if not isd:
            try:
                total += os.lstat(f).st_size
            except OSError:
                pass
    prog = Progress(total, len(items))
    part = os.path.join(os.path.dirname(out), '.' + os.path.basename(out) + '.hearth-part')

    def stop(*_):
        raise Cancelled()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    prog.tick(0, force=True)
    try:
        if fmt == 'zip':
            with zipfile.ZipFile(part, 'w', zipfile.ZIP_DEFLATED, allowZip64=True) as z:
                for full, arc, isd in files:
                    prog.file = os.path.basename(full)
                    if isd:
                        z.write(full, arc + '/')
                    elif os.path.islink(full) and not os.path.exists(full):
                        continue
                    else:
                        zi = zipfile.ZipInfo.from_file(full, arc)
                        zi.compress_type = zipfile.ZIP_DEFLATED
                        with open(full, 'rb') as fi, z.open(zi, 'w', force_zip64=True) as fo:
                            while True:
                                buf = fi.read(CHUNK)
                                if not buf:
                                    break
                                fo.write(buf)
                                prog.tick(len(buf))
        elif fmt == '7z':
            # 7-Zip stores each item under its own name (a folder with what's in it), like the zip above.
            prog.file = os.path.basename(items[0]) if len(items) == 1 else ''
            r = subprocess.run([seven, 'a', '-t7z', '-y', '-bso0', '-bsp0', '--', part] + items,
                               capture_output=True, text=True)
            if r.returncode != 0:
                raise OSError(errno.EIO, (r.stderr or r.stdout or '7-Zip failed').strip().splitlines()[-1], part)
            prog.tick(total)
        else:
            mode = {'tar.gz': 'w:gz', 'tar.xz': 'w:xz', 'tar': 'w'}[fmt]
            with tarfile.open(part, mode) as t:
                for full, arc, isd in files:
                    prog.file = os.path.basename(full)
                    t.add(full, arc, recursive=False)
                    if not isd:
                        try:
                            prog.tick(os.lstat(full).st_size)
                        except OSError:
                            pass
        os.rename(part, out)
        prog.tick(0, force=True)
    except Cancelled:
        if lexists(part):
            os.unlink(part)
        return {'cancelled': True, 'items': []}
    except OSError as e:
        if lexists(part):
            os.unlink(part)
        raise Fail(friendly(e, e.filename))
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        signal.signal(signal.SIGINT, signal.SIG_DFL)
    return {'ok': True, 'items': [out], 'path': out, 'bytes': total}


def safe_member(name):
    """A member name that stays inside the folder it's unpacked into, or None."""
    n = name.replace('\\', '/')
    parts = [x for x in n.split('/') if x not in ('', '.')]
    if not parts or n.startswith('/') or '..' in parts:
        return None
    return '/'.join(parts)


def extract(archive, dest, here=False):
    """Unpacks archive. here: next to it, straight in if everything is in one folder already (else in a folder
    named after the archive); otherwise into the folder dest (made if needed). Progress lines as for copy."""
    import tarfile
    import zipfile
    a = os.path.abspath(os.path.expanduser(archive))
    if not os.path.isfile(a):
        raise Fail("That archive isn't there any more")
    low = a.lower()
    kind = 'zip' if zipfile.is_zipfile(a) else 'tar' if tarfile.is_tarfile(a) else 'other'
    if kind == 'other' and not (shutil.which('bsdtar') or shutil.which('7z') or shutil.which('7za')):
        raise Fail("Hearth Files can't open this kind of archive (install 7-Zip or bsdtar for .7z and .rar)")
    members = []                       # (name, size, is folder)
    if kind == 'zip':
        with zipfile.ZipFile(a) as z:
            for i in z.infolist():
                members.append((i.filename, i.file_size, i.is_dir()))
    elif kind == 'tar':
        with tarfile.open(a) as t:
            for i in t.getmembers():
                members.append((i.name, i.size, i.isdir()))
    if here:
        parent = check_writable(os.path.dirname(a), allow_root=True)
        tops = {safe_member(m[0]).split('/')[0] for m in members if safe_member(m[0])}
        single_dir = len(tops) == 1 and any((safe_member(m[0]) or '').count('/') > 0 or m[2] for m in members)
        if kind != 'other' and single_dir:
            top = tops.pop()
            target_root, rename_top = parent, None
            if lexists(os.path.join(parent, top)):
                rename_top = os.path.basename(unique(os.path.join(parent, top)))
        else:
            target_root, rename_top = unique(os.path.join(parent, archive_stem(os.path.basename(a)))), None
    else:
        target_root, rename_top = check_writable(dest, allow_root=True), None
    check_writable(target_root, allow_root=True)
    total = sum(m[1] for m in members if not m[2])
    prog = Progress(total, 1)
    made = []                          # what we created, removed if stopped

    def stop(*_):
        raise Cancelled()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    prog.tick(0, force=True)
    root_existed = os.path.isdir(target_root)
    try:
        os.makedirs(target_root, exist_ok=True)
        if not root_existed:
            made.append(target_root)

        def place(name):
            """Where a member goes (None: a name that would land outside); notes new top-level items."""
            m = safe_member(name)
            if not m:
                return None
            if rename_top:
                rest = m.partition('/')[2]
                m = rename_top + ('/' + rest if rest else '')
            top = os.path.join(target_root, m.split('/')[0])
            if root_existed and top not in made and not lexists(top):
                made.append(top)
            return os.path.join(target_root, m)

        if kind == 'zip':
            with zipfile.ZipFile(a) as z:
                for i in z.infolist():
                    full = place(i.filename)
                    if not full:
                        continue
                    prog.file = os.path.basename(i.filename.rstrip('/'))
                    if i.is_dir():
                        os.makedirs(full, exist_ok=True)
                        continue
                    os.makedirs(os.path.dirname(full), exist_ok=True)
                    with z.open(i) as fi, open(full, 'wb') as fo:
                        while True:
                            buf = fi.read(CHUNK)
                            if not buf:
                                break
                            fo.write(buf)
                            prog.tick(len(buf))
                    perm = (i.external_attr >> 16) & 0o777
                    if perm:
                        try:
                            os.chmod(full, perm | 0o600)
                        except OSError:
                            pass
                    try:
                        t = time.mktime(i.date_time + (0, 0, -1))
                        os.utime(full, (t, t))
                    except (OverflowError, ValueError, OSError):
                        pass
        elif kind == 'tar':
            with tarfile.open(a) as t:
                for i in t.getmembers():
                    full = place(i.name)
                    if not full or not (i.isfile() or i.isdir() or i.issym()):
                        continue
                    prog.file = os.path.basename(i.name.rstrip('/'))
                    if i.isdir():
                        os.makedirs(full, exist_ok=True)
                        continue
                    os.makedirs(os.path.dirname(full), exist_ok=True)
                    if i.issym():
                        # Only links that stay inside what's being unpacked.
                        tgt = os.path.normpath(os.path.join(os.path.dirname(full), i.linkname))
                        if not i.linkname.startswith('/') and under(tgt, target_root) and not lexists(full):
                            os.symlink(i.linkname, full)
                        continue
                    fi = t.extractfile(i)
                    if fi is None:
                        continue
                    with fi, open(full, 'wb') as fo:
                        while True:
                            buf = fi.read(CHUNK)
                            if not buf:
                                break
                            fo.write(buf)
                            prog.tick(len(buf))
                    try:
                        os.chmod(full, (i.mode & 0o777) | 0o600)
                        os.utime(full, (i.mtime, i.mtime))
                    except (OSError, OverflowError):
                        pass
        else:
            prog.file = os.path.basename(a)
            seven = shutil.which('7z') or shutil.which('7za')
            if seven and (low.endswith('.7z') or not shutil.which('bsdtar')):
                cmdline = [seven, 'x', '-y', '-o' + target_root, a]
            else:
                cmdline = ['bsdtar', '-xf', a, '-C', target_root]
            p = subprocess.Popen(cmdline, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
            try:
                _, err = p.communicate()
            except Cancelled:
                p.terminate()
                raise
            if p.returncode != 0:
                raise Fail("Couldn't unpack it" + (': ' + err.strip().splitlines()[-1] if err.strip() else ''))
        prog.tick(0, force=True)
    except Cancelled:
        for m in reversed(made):
            if lexists(m):
                try:
                    remove(m)
                except OSError:
                    pass
        return {'cancelled': True, 'items': []}
    except (OSError, zipfile.BadZipFile, tarfile.TarError, EOFError) as e:
        for m in reversed(made):
            if lexists(m):
                try:
                    remove(m)
                except OSError:
                    pass
        if isinstance(e, OSError):
            raise Fail(friendly(e, e.filename))
        raise Fail("The archive is damaged: " + str(e))
    finally:
        signal.signal(signal.SIGTERM, signal.SIG_DFL)
        signal.signal(signal.SIGINT, signal.SIG_DFL)
    result = target_root
    if here and target_root == os.path.dirname(a):
        top = rename_top or next(iter({safe_member(m[0]).split('/')[0] for m in members if safe_member(m[0])}), '')
        result = os.path.join(target_root, top)
    return {'ok': True, 'items': [result], 'path': result, 'bytes': total}


# ---------------------------------------------------------------------- search
def search(path, query, hidden=False, limit=5000):
    """Looks below path for names containing query (or matching it, with * and ?): a "found: {entry}" line
    for each, then {"ok": true, "count": n, "truncated": bool}. Stops on SIGTERM (the Stop button)."""
    import fnmatch
    root = os.path.abspath(os.path.expanduser(path))
    if not os.path.isdir(root):
        raise Fail("This folder isn't there any more")
    q = query.strip().lower()
    if not q:
        raise Fail('Type something to search for')
    glob = any(c in q for c in '*?[')

    def stop(*_):
        raise Cancelled()
    signal.signal(signal.SIGTERM, stop)
    n, truncated = 0, False
    try:
        for d, dirs, files in os.walk(root, followlinks=False):
            if not hidden:
                dirs[:] = [x for x in dirs if not x.startswith('.')]
            dirs.sort()
            for name in dirs + sorted(files):
                if not hidden and name.startswith('.'):
                    continue
                low = name.lower()
                if not (fnmatch.fnmatch(low, q) if glob else q in low):
                    continue
                e = entry(os.path.join(d, name), name)
                if not e:
                    continue
                e['where'] = os.path.relpath(d, root)
                print('found: ' + json.dumps(e), flush=True)
                n += 1
                if n >= limit:
                    truncated = True
                    raise StopIteration
    except StopIteration:
        pass
    except Cancelled:
        return {'cancelled': True, 'count': n}
    return {'ok': True, 'count': n, 'truncated': truncated}


# ---------------------------------------------------------------------- drives, bookmarks, settings
def unmounted_drives():
    """USB drives and SD cards that are plugged in but not mounted (lsblk), for the sidebar."""
    if not shutil.which('lsblk'):
        return []
    try:
        r = subprocess.run(['lsblk', '-J', '-b', '-o', 'NAME,PATH,LABEL,MOUNTPOINT,RM,HOTPLUG,FSTYPE,SIZE,TYPE'],
                           capture_output=True, text=True, timeout=4)
        tree = json.loads(r.stdout or '{}').get('blockdevices', [])
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return []
    out = []

    def walk(devs, removable):
        for d in devs:
            rm = removable or d.get('rm') in (True, '1', 1) or d.get('hotplug') in (True, '1', 1)
            fs = d.get('fstype') or ''
            if rm and fs and fs not in ('swap', 'crypto_LUKS', 'LVM2_member') and not d.get('mountpoint') \
                    and d.get('type') in ('part', 'disk'):
                path = d.get('path') or '/dev/' + d.get('name', '')
                kind, sub = drive_kind(path)
                size = int(d.get('size') or 0)
                out.append({'id': 'dev:' + path, 'label': d.get('label') or (human(size) + ' ' + sub.lower()),
                            'path': '', 'device': path, 'kind': kind, 'sub': sub + ' · not mounted',
                            'section': 'drives', 'mounted': False, 'removable': True, 'total': size or None})
            walk(d.get('children') or [], rm)
    walk(tree, False)
    return out


def mount(device):
    if not device.startswith('/dev/') or not shutil.which('udisksctl'):
        raise Fail("Couldn't mount the drive" + ('' if shutil.which('udisksctl') else ' (udisksctl is missing)'))
    r = subprocess.run(['udisksctl', 'mount', '-b', device, '--no-user-interaction'], capture_output=True, text=True,
                       timeout=60)
    m = re.search(r' at (.+?)\.?\s*$', r.stdout.strip())
    if r.returncode != 0:
        msg = (r.stderr or r.stdout).strip()
        if 'AlreadyMounted' in msg:
            m2 = re.search(r"mounted at [`'](.+?)[`']", msg)
            if m2:
                return {'ok': True, 'path': m2.group(1)}
        raise Fail("Couldn't mount the drive" + (': ' + msg.splitlines()[-1] if msg else ''))
    path = m.group(1) if m else ''
    return {'ok': True, 'path': path}


def unmount(path):
    """Unmounts a drive (it stays powered: plug-and-mount again from the sidebar). eject also powers it off."""
    p = norm(path)
    if not any(under(p, os.path.realpath(b)) and p != os.path.realpath(b) for b in media_bases()):
        raise Fail('Only USB drives and SD cards can be unmounted here')
    dev = mounts().get(p)
    subprocess.run(['sync'], timeout=120)
    errors = []
    if dev and shutil.which('udisksctl'):
        r = subprocess.run(['udisksctl', 'unmount', '-b', dev], capture_output=True, text=True, timeout=60)
        if r.returncode == 0:
            return {'ok': True}
        errors.append((r.stderr or r.stdout).strip())
    if shutil.which('gio'):
        r = subprocess.run(['gio', 'mount', '-u', p], capture_output=True, text=True, timeout=60)
        if r.returncode == 0:
            return {'ok': True}
        errors.append((r.stderr or r.stdout).strip())
    msg = next((e for e in errors if e), '')
    if 'busy' in msg.lower():
        raise Fail('Something is still using this drive. Close it and try again')
    raise Fail("Couldn't unmount the drive" + (': ' + msg.splitlines()[-1] if msg else ''))


def bookmarks_file():
    cfg = os.environ.get('XDG_CONFIG_HOME') or os.path.join(home(), '.config')
    return os.path.join(cfg, 'gtk-3.0', 'bookmarks')


def read_bookmarks():
    """[(path, label)] from the GTK bookmarks file (the one Nautilus, Thunar and file dialogs share)."""
    out = []
    try:
        with open(bookmarks_file(), encoding='utf-8', errors='surrogateescape') as f:
            for line in f:
                line = line.rstrip('\n')
                if not line.startswith('file://'):
                    continue
                uri, _, label = line.partition(' ')
                p = urllib.parse.unquote(urllib.parse.urlparse(uri).path, errors='surrogateescape')
                out.append((p, label.strip()))
    except OSError:
        pass
    return out


def write_bookmarks(items):
    f = bookmarks_file()
    os.makedirs(os.path.dirname(f), exist_ok=True)
    tmp = f + '.hearth-tmp'
    with open(tmp, 'w', encoding='utf-8', errors='surrogateescape') as fh:
        for p, label in items:
            fh.write(file_uri(p) + (' ' + label if label else '') + '\n')
    os.replace(tmp, f)


def bookmark_add(path, label=''):
    p = os.path.abspath(os.path.expanduser(path))
    if not os.path.isdir(p):
        raise Fail('Only folders can be bookmarked')
    items = [b for b in read_bookmarks() if b[0] != p]
    items.append((p, label.strip()))
    write_bookmarks(items)
    return {'ok': True}


def bookmark_remove(path):
    p = os.path.abspath(os.path.expanduser(path))
    write_bookmarks([b for b in read_bookmarks() if b[0] != p])
    return {'ok': True}


def bookmark_places():
    out = []
    for p, label in read_bookmarks():
        if not os.path.isdir(p):
            continue
        out.append({'id': 'bookmark:' + p, 'label': label or os.path.basename(p.rstrip('/')) or p, 'path': p,
                    'kind': 'folder', 'section': 'bookmarks', 'bookmark': True})
    return out


def prefs_file():
    cfg = os.environ.get('XDG_CONFIG_HOME') or os.path.join(home(), '.config')
    return os.path.join(cfg, 'nimbus', 'files.json')


def prefs_get():
    try:
        with open(prefs_file(), encoding='utf-8') as f:
            v = json.load(f)
            return v if isinstance(v, dict) else {}
    except (OSError, ValueError):
        return {}


def prefs_set(text):
    """Merges the JSON object text into Hearth Files' settings (view, sort, per-folder views…)."""
    try:
        new = json.loads(text)
    except ValueError:
        raise Fail('Settings have to be JSON')
    if not isinstance(new, dict):
        raise Fail('Settings have to be a JSON object')
    cur = prefs_get()
    cur.update(new)
    folders = cur.get('folders')
    if isinstance(folders, dict) and len(folders) > 400:     # keep the newest 400 folders' views
        cur['folders'] = dict(list(folders.items())[-400:])
    f = prefs_file()
    os.makedirs(os.path.dirname(f), exist_ok=True)
    with open(f + '.tmp', 'w', encoding='utf-8') as fh:
        json.dump(cur, fh)
    os.replace(f + '.tmp', f)
    return {'ok': True}


# ---------------------------------------------------------------------- clipboard, preview, thumbnails, terminal
def clip_set(mode, paths):
    """Puts files on the system clipboard (text/uri-list, which Dolphin, Nautilus and browsers read)."""
    if not shutil.which('wl-copy'):
        return {'ok': False}
    data = ''.join(file_uri(os.path.abspath(p)) + '\r\n' for p in paths)
    try:
        p = subprocess.Popen(['wl-copy', '--type', 'text/uri-list'], stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)
        p.stdin.write(data.encode('utf-8', 'surrogateescape'))
        p.stdin.close()
    except OSError:
        return {'ok': False}
    return {'ok': True, 'mode': mode}


def clip_get():
    """Files on the system clipboard (copied in Hearth Files or another file manager)."""
    if not shutil.which('wl-paste'):
        return {'paths': [], 'cut': False, 'available': False}
    try:
        types = subprocess.run(['wl-paste', '--list-types'], capture_output=True, text=True, timeout=2).stdout.split()
    except (OSError, subprocess.TimeoutExpired):
        return {'paths': [], 'cut': False, 'available': False}
    cut = False
    for t in ('x-special/gnome-copied-files', 'text/uri-list'):
        if t not in types:
            continue
        try:
            text = subprocess.run(['wl-paste', '--no-newline', '--type', t], capture_output=True, text=True,
                                  timeout=2).stdout
        except (OSError, subprocess.TimeoutExpired):
            continue
        lines = [x.strip() for x in text.splitlines() if x.strip()]
        if t.startswith('x-special') and lines and lines[0] in ('copy', 'cut'):
            cut = lines.pop(0) == 'cut'
        paths = [urllib.parse.unquote(urllib.parse.urlparse(x).path, errors='surrogateescape')
                 for x in lines if x.startswith('file://')]
        if paths:
            if 'application/x-kde-cutselection' in types:
                try:
                    cut = subprocess.run(['wl-paste', '--no-newline', '--type', 'application/x-kde-cutselection'],
                                         capture_output=True, text=True, timeout=2).stdout.strip() == '1'
                except (OSError, subprocess.TimeoutExpired):
                    pass
            return {'paths': paths, 'cut': cut, 'available': True}
    return {'paths': [], 'cut': False, 'available': True}


def peek(path, limit=65536):
    """The start of a text file, for the quick preview (Space)."""
    p = os.path.abspath(os.path.expanduser(path))
    try:
        with open(p, 'rb') as f:
            data = f.read(limit + 1)
    except OSError as e:
        raise Fail(friendly(e, p))
    if b'\0' in data[:8192]:
        raise Fail("This isn't a text file")
    return {'text': data[:limit].decode('utf-8', 'replace'), 'more': len(data) > limit}


def thumb_path(p):
    import hashlib
    cache = os.environ.get('XDG_CACHE_HOME') or os.path.join(home(), '.cache')
    return os.path.join(cache, 'thumbnails', 'large', hashlib.md5(file_uri(p).encode()).hexdigest() + '.png')


def thumbs(paths):
    """Makes the missing video thumbnails (with ffmpegthumbnailer or ffmpeg, if installed), at most 30 a call,
    in the shared freedesktop cache, so other apps can use them too."""
    tool = shutil.which('ffmpegthumbnailer') or shutil.which('ffmpeg')
    made = []
    if not tool:
        return {'ok': False, 'made': made}
    for path in paths[:30]:
        p = os.path.abspath(path)
        out = thumb_path(p)
        try:
            if os.path.exists(out) and os.path.getmtime(out) >= os.path.getmtime(p):
                continue
        except OSError:
            continue
        os.makedirs(os.path.dirname(out), mode=0o700, exist_ok=True)
        tmp = out + '.%d.tmp.png' % os.getpid()
        if tool.endswith('ffmpegthumbnailer'):
            argv = [tool, '-i', p, '-o', tmp, '-s', '256', '-c', 'png']
        else:
            argv = [tool, '-v', 'error', '-y', '-ss', '3', '-i', p, '-frames:v', '1', '-vf', 'scale=256:-1', tmp]
        try:
            r = subprocess.run(argv, capture_output=True, timeout=15)
            if r.returncode == 0 and os.path.exists(tmp):
                os.replace(tmp, out)
                made.append(p)
        except (OSError, subprocess.TimeoutExpired):
            pass
        if os.path.exists(tmp):
            os.unlink(tmp)
    return {'ok': True, 'made': made}


def terminal(path):
    """Opens Hearth Terminal (or the terminal you have) in this folder."""
    p = os.path.abspath(os.path.expanduser(path))
    if not os.path.isdir(p):
        p = os.path.dirname(p)
    for argv in ([os.environ.get('TERMINAL', '')], ['hearth-terminal', '--cwd', p], ['foot', '-D', p],
                 ['alacritty', '--working-directory', p], ['kitty', '-d', p], ['wezterm', 'start', '--cwd', p],
                 ['konsole', '--workdir', p], ['gnome-terminal', '--working-directory=' + p], ['xfce4-terminal', '--working-directory=' + p],
                 ['xterm']):
        if argv[0] and shutil.which(argv[0]):
            spawn(argv, cwd=p)
            return {'ok': True, 'app': argv[0]}
    raise Fail('No terminal app is installed')


