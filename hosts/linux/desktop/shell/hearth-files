    return {'dir': t, 'templates': out}


def from_template(template, folder, name=None):
    src = os.path.abspath(os.path.expanduser(template))
    if not os.path.isfile(src):
        raise Fail("That template isn't there any more")
    d = check_writable(folder, allow_root=True)
    name = valid_name((name or os.path.basename(src)).strip())
    target = unique(os.path.join(d, name))
    check_writable(target)
    try:
        shutil.copyfile(src, target)
    except OSError as e:
