    try:
        r = subprocess.run(['systemd-analyze', 'time'], capture_output=True, text=True, timeout=5)
        return parse_boot_time(r.stdout) if r.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired):
        return None


# ---------------------------------------------------------------------- main
def parse_pid(s):
    if not s.isdigit() or int(s) <= 1:
        raise Fail('not a process number: ' + s)
    return int(s)


# ====================================================================== App history (1.11, mockup tm-8)
# Like Windows' App history: how much processor time and disk each app has used since a date you can reset. A small
# user timer (hearth-app-history.timer) looks every 5 minutes at your programs, grouped into apps the way the
# Processes page groups them, and adds up what each used since the last look. It writes only
# ~/.local/state/hearth/app-history.json (a record, never a setting). A program that starts and closes between two
# looks isn't counted.


def history_file():
    base = os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'), '.local', 'state')
    return os.path.join(base, 'hearth', 'app-history.json')


def io_split(text):
    rd = wr = 0
    for line in (text or '').splitlines():
        k, _, v = line.partition(':')
        try:
            if k == 'read_bytes':
                rd = int(v)
            elif k == 'write_bytes':
                wr = int(v)
        except ValueError:
            pass
    return rd, wr


def proc_usage(root=PROC):
    """{process key: [app name, processor seconds, bytes read, bytes written]} for your programs now."""
    procs = scan(root)
    uid = os.getuid()
    libs = steam_libraries()
    out = {}
    for g in build_groups(procs, uid, os.getpid(), cached_desktop_index(), lambda a: steam_name(a, libs)):
        if g.get('kind') == 'background' and g.get('protected'):
            continue
        for pid in g['pids']:
            pr = procs.get(pid)
            if not pr or pr.uid != uid:
                continue
            rd, wr = io_split(read(os.path.join(root, str(pid), 'io'), ''))
            out[str(pr.key)] = [g['name'], round(pr.jiffies / CLK_TCK, 2), rd, wr]
    return out


def vm_swap_pages(text):
    """/proc/vmstat pswpin + pswpout (pages moved between memory and swap so far)."""
    v = {}
    for line in (text or '').splitlines():
        f = line.split()
        if len(f) == 2 and f[0] in ('pswpin', 'pswpout') and f[1].isdigit():
            v[f[0]] = int(f[1])
    return v.get('pswpin', 0), v.get('pswpout', 0)


def disk_busy(root=PROC):
    """Task Manager › Disk › Busiest programs (1.12, mockup tm-4): what each of your apps read and wrote this second,
    and swapping between memory and the drive (bytes/s)."""
    a1, s1 = proc_usage(root), vm_swap_pages(read(os.path.join(root, 'vmstat'), ''))
    t1 = time.time()
    time.sleep(1)
    a2, s2 = proc_usage(root), vm_swap_pages(read(os.path.join(root, 'vmstat'), ''))
    dt = max(0.2, time.time() - t1)
    by = {}
    for k, (name, _cpu, rd, wr) in a2.items():
        if k not in a1:
            continue
        r = by.setdefault(name, {'name': name, 'pid': int(k.split(':')[0]), 'read': 0, 'write': 0})
        r['read'] += int(max(0, rd - a1[k][2]) / dt)
        r['write'] += int(max(0, wr - a1[k][3]) / dt)
    rows = sorted((r for r in by.values() if r['read'] or r['write']), key=lambda r: -(r['read'] + r['write']))[:6]
    page = os.sysconf('SC_PAGE_SIZE') if hasattr(os, 'sysconf') else 4096
    rows.append({'name': 'zram ↔ drive swap', 'pid': 0, 'read': int((s2[0] - s1[0]) * page / dt), 'write': int((s2[1] - s1[1]) * page / dt), 'swap': True})
    return {'rows': rows}


def history_add(state, now_procs, now):
    """Adds what each app used since the last look: a process seen before counts its growth, a new one all it has
    used (it started since)."""
    last = state.get('procs') or {}
    apps = state.setdefault('apps', {})
    for key, (name, cpu, rd, wr) in now_procs.items():
        prev = last.get(key)
        if prev:
            d = [max(0, cpu - prev[1]), max(0, rd - prev[2]), max(0, wr - prev[3])]
        else:
            d = [cpu, rd, wr]
        if not any(d):
            continue
        a = apps.setdefault(name, {'cpu': 0.0, 'read': 0, 'write': 0, 'last': 0})
        a['cpu'] = round(a['cpu'] + d[0], 2)
        a['read'] += d[1]
        a['write'] += d[2]
        a['last'] = int(now)
    state['procs'] = now_procs
    state.setdefault('since', int(now))
    return state


def history_write(state):
    path = history_file()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix='.app-history.', dir=os.path.dirname(path))
    with os.fdopen(fd, 'w') as f:
        json.dump(state, f, separators=(',', ':'))
    os.replace(tmp, path)


def history_read():
    try:
        with open(history_file()) as f:
            d = json.load(f)
        return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def on_battery(sys_root='/sys'):
    """True while a battery (not a mouse's or a pad's) is discharging."""
    for b in glob.glob(os.path.join(sys_root, 'class/power_supply/*')):
        if read(os.path.join(b, 'type'), '').strip() == 'Battery' and read(os.path.join(b, 'scope'), '').strip() != 'Device':
            if read(os.path.join(b, 'status'), '').strip() == 'Discharging':
                return True
    return False


def brightness_pct(sys_root='/sys'):
    for d in glob.glob(os.path.join(sys_root, 'class/backlight/*')):
        b, m = read(os.path.join(d, 'brightness'), '').strip(), read(os.path.join(d, 'max_brightness'), '').strip()
        if b.isdigit() and m.isdigit() and int(m):
            return round(100 * int(b) / int(m))
    return None


def battery_add(state, before, now_procs, now, day, batt, bright):
    """What used the battery today (1.12, mockup tm-7): each app's processor time while on battery, and the screen's
    time on battery with its brightness; a new day starts again."""
    b = state.get('battery') or {}
    if b.get('day') != day:
        b = {'day': day, 'apps': {}, 'screen': 0.0, 'brightSum': 0.0}
    if batt:
        dt = max(0.0, min(900.0, now - (b.get('t') or now)))
        for key, (name, cpu, _rd, _wr) in now_procs.items():
            prev = before.get(key)
            d = max(0.0, cpu - prev[1]) if prev else 0.0
            if d > 0:
                b['apps'][name] = round(b['apps'].get(name, 0.0) + d, 2)
        b['screen'] = round(b.get('screen', 0.0) + dt, 1)
        if bright is not None:
            b['brightSum'] = round(b.get('brightSum', 0.0) + dt * bright, 1)
    b['t'] = now
    state['battery'] = b
    return state


def history_collect():
    st = history_read()
    before = dict(st.get('procs') or {})
    usage = proc_usage()
    now = time.time()
    st = history_add(st, usage, now)
    st = battery_add(st, before, usage, now, time.strftime('%Y-%m-%d'), on_battery(), brightness_pct())
    history_write(st)
    return {'ok': True, 'apps': len(st.get('apps') or {})}


def battery_use(cpu_now=None):
    """Rows for "What used the battery today": share of the day's use on battery, power now (an estimate from the
    battery's own draw and each app's share of the processor right now), and a tip."""
    b = (history_read().get('battery') or {})
    watts = None
    for d in glob.glob('/sys/class/power_supply/*'):
        if read(os.path.join(d, 'type'), '').strip() == 'Battery':
            p = read(os.path.join(d, 'power_now'), '').strip()
            if p.isdigit():
                watts = int(p) / 1e6
            else:
                c, v = read(os.path.join(d, 'current_now'), '').strip(), read(os.path.join(d, 'voltage_now'), '').strip()
                if c.isdigit() and v.isdigit():
                    watts = int(c) * int(v) / 1e12
            break
    bright = (b.get('brightSum', 0) / b['screen']) if b.get('screen') else brightness_pct()
    screen_w = 0.6 + 2.4 * (bright or 50) / 100.0                     # a laptop screen: about 0.6 W dark to 3 W full
    cpu_total = sum((b.get('apps') or {}).values())
    # the screen's share: its estimated energy against the apps' (a processor second ≈ 1.5 W on a laptop)
    screen_j = screen_w * b.get('screen', 0)
    app_j = cpu_total * 1.5
    total_j = screen_j + app_j
    rows = []
    cpu_now = cpu_now or {}
    cpu_sum = sum(cpu_now.values()) or 1.0
    for name, sec in sorted((b.get('apps') or {}).items(), key=lambda x: -x[1])[:8]:
        share = 100.0 * sec * 1.5 / total_j if total_j else 0.0
        now_w = round((watts - screen_w) * cpu_now.get(name, 0) / cpu_sum, 1) if watts and cpu_now.get(name) else None
        rows.append({'name': name, 'share': round(share), 'watts': now_w, 'tip': battery_tip(name, share)})
    if b.get('screen'):
        rows.append({'name': 'Screen', 'share': round(100.0 * screen_j / total_j) if total_j else 0, 'watts': round(screen_w, 1),
                     'tip': 'brightness %d%%' % round(bright or 0), 'screen': True})
    rows.sort(key=lambda r: -r['share'])
    return {'day': b.get('day'), 'onBattery': on_battery(), 'watts': round(watts, 1) if watts else None, 'rows': rows}


def battery_tip(name, share):
    n = name.lower()
    if share < 8:
        return ''
    if any(x in n for x in ('firefox', 'chrom', 'brave', 'vivaldi', 'web content', 'hearth browser')):
        return 'a video tab in the background?'
    if 'steam' in n or 'game' in n:
        return 'games use the most; plug in to play'
    return 'Efficiency mode on battery?'


def history_list():
    st = history_read()
    apps = [dict(v, name=k) for k, v in (st.get('apps') or {}).items()]
    apps.sort(key=lambda a: -a['cpu'])
    return {'since': st.get('since'), 'apps': apps[:300]}


def history_clear():
    """Delete usage history: starts counting again from now (what's running now counts only from here)."""
    history_write({'since': int(time.time()), 'apps': {}, 'procs': proc_usage()})
    return {'ok': True}


def cmd(argv):
    c = argv[1] if len(argv) > 1 else ''
    if c == 'list' and len(argv) == 2:
        out = list_apps()
    elif c == 'perf' and len(argv) == 2:
        out = perf()
    elif c == 'end' and len(argv) == 3:
        out = signal_app(parse_pid(argv[2]), signal.SIGTERM)
    elif c == 'kill' and len(argv) == 3:
        out = signal_app(parse_pid(argv[2]), signal.SIGKILL)
    elif c == 'disk-busy' and len(argv) == 2:
        out = disk_busy()
    elif c == 'battery-use' and len(argv) == 2:
        a1 = proc_usage()
        time.sleep(1)
        a2 = proc_usage()
        now = {}
        for k, (name, cpu, _r, _w) in a2.items():
            if k in a1:
                now[name] = now.get(name, 0.0) + max(0.0, cpu - a1[k][1])
        out = battery_use(now)
    elif c == 'startup' and len(argv) == 2:
        out = startup()
    elif c == 'startup-set' and len(argv) == 4 and argv[3] in ('on', 'off'):
        out = startup_set(argv[2], argv[3] == 'on')
    elif c == 'serve' and len(argv) == 2:
        serve()
        return
    elif c == 'end-pid' and len(argv) == 3:
        out = signal_one(parse_pid(argv[2]), signal.SIGTERM)
    elif c == 'kill-pid' and len(argv) == 3:
        out = signal_one(parse_pid(argv[2]), signal.SIGKILL)
    elif c == 'eco' and len(argv) == 4 and argv[3] in ('on', 'off'):
        out = set_efficiency(parse_pid(argv[2]), argv[3] == 'on')
    elif c == 'end-tree' and len(argv) == 3:
        out = end_tree(parse_pid(argv[2]))
    elif c in ('suspend', 'resume') and len(argv) == 3:
        out = suspend(parse_pid(argv[2]), c == 'suspend')
    elif c == 'priority' and len(argv) == 4:
        out = set_priority(parse_pid(argv[2]), argv[3])
    elif c == 'affinity' and len(argv) == 4:
        out = set_affinity(parse_pid(argv[2]), argv[3])
    elif c == 'limit' and len(argv) == 5:
        out = set_limit(parse_pid(argv[2]), argv[3], argv[4])
    elif c == 'timers' and len(argv) == 2:
        out = timer_list()
    elif c == 'timer' and len(argv) == 4 and argv[3] in ('on', 'off'):
        out = set_timer(argv[2], argv[3] == 'on')
    elif c == 'users' and len(argv) == 2:
        out = user_list()
    elif c == 'history' and len(argv) == 2:
        out = history_list()
    elif c == 'history-collect' and len(argv) == 2:
        out = history_collect()
    elif c == 'history-clear' and len(argv) == 2:
        out = history_clear()
    elif c == 'autostart-measure' and len(argv) == 3 and argv[2].isdigit():
        out = autostart_measure(int(argv[2]))
    elif c == 'task-new' and len(argv) == 5:
        out = task_new(argv[2], argv[3], argv[4])
    elif c == 'task-delete' and len(argv) == 3:
        out = task_delete(argv[2])
    elif c == 'task-trigger' and len(argv) == 3 and argv[2] in ('idle', 'battery'):
        out = task_trigger(argv[2])
    elif c == 'services' and len(argv) == 2:
        out = service_list()
    elif c == 'service' and len(argv) == 4:
        out = service_act(argv[2], argv[3])
    elif c == 'sample' and len(argv) >= 2:
        s = Sampler()
        s.sample(argv[2:])
        time.sleep(0.5)
        out = s.sample(argv[2:])
    elif c == 'autostart-run' and len(argv) == 2:
