#!/usr/bin/python3
"""hearth-tasks: what Mantel's Task Manager shows and does (running apps, performance, startup).

  hearth-tasks list                  JSON: running apps grouped by app, with CPU % and memory
  hearth-tasks perf                  JSON: one performance sample (CPU, memory, GPU, temperatures, fans, battery)
  hearth-tasks end PID               ask an app (PID and the processes it started) to close (SIGTERM)
  hearth-tasks kill PID              force it closed (SIGKILL)
  hearth-tasks startup               JSON: things that start on their own (services, autostart apps, Steam)
  hearth-tasks startup-set ID on|off turn one of them on or off
  hearth-tasks serve                 the shared sampler Task Manager reads while it's open (see "the shared sampler")
  hearth-tasks sample [WANT…]        JSON: one sample as serve gives it (WANT: procs details gpu temps), for checks
  hearth-tasks end-pid|kill-pid PID  end one process (Details), yours only, never a part of Hearth
  hearth-tasks eco PID on|off        Efficiency mode for one of your apps (lowest priority; CPU weight 1 on its own scope)
  hearth-tasks end-tree PID          End process tree: the process and everything it started (1.11)
  hearth-tasks priority PID normal|below|low   Set priority for one of your apps
  hearth-tasks affinity PID 0-3,6    Run on these cores (until it closes)
  hearth-tasks limit PID CPU% MEMMB  Limit CPU / memory on the app's own scope (0 = no limit; until it closes)
  hearth-tasks timers                JSON: Scheduled tasks (systemd timers: yours on / off, the system's read only)
  hearth-tasks timer UNIT on|off     one of your scheduled tasks on or off
  hearth-tasks users                 JSON: Users: who is signed in and what their programs use
  hearth-tasks services              JSON: your services (start / stop) and the system's (read only)
  hearth-tasks service UNIT start|stop|restart   one of your own services (never one that keeps Hearth running)
  hearth-tasks autostart-run         start the autostart apps that are on (~/.config/autostart, /etc/xdg/autostart),
                                     as a desktop does when you sign in (labwc's autostart runs it in Desktop Mode)
  hearth-tasks autostart-plan        JSON: what autostart-run would start, and why the others are skipped

Everything is read from /proc and /sys directly. CPU use needs two samples: the previous one is kept in
$XDG_RUNTIME_DIR (or the helper waits 250 ms when there's none). Only your own processes are listed or
signalled, and the parts that keep Hearth's session running (gamescope, labwc, Quickshell, systemd, the
session scripts, Hearth itself) are marked protected and can't be ended.
Output is one JSON line; failures print "error: ..." and exit 1.
"""
import os
import sys
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
# The first parts live in modules next to this file (1.12 tidy-up): shared parts, processes and apps, performance.
from hearth_tasks_perf import *  # noqa: F401,F403

# ---------------------------------------------------------------------- startup
def fnmatch_any(name, patterns):
    stem = name[:-8] if name.endswith('.service') else name
    return any(fnmatch.fnmatchcase(stem, p) for p in patterns)


def is_essential_unit(unit):
    return unit.endswith('@.service') or fnmatch_any(unit, ESSENTIAL_UNITS)


def parse_unit_files(text):
    """`systemctl --user list-unit-files --plain --no-legend`: {unit: state}."""
    out = {}
    for line in (text or '').splitlines():
        f = line.split()
        if len(f) >= 2 and f[0].endswith('.service'):
            out[f[0]] = f[1]
    return out


def parse_show(text):
    """`systemctl show -p Id -p Description -p ActiveState a b …`: {id: {Description, ActiveState}}."""
    out, cur = {}, {}
    for line in (text or '').splitlines() + ['']:
        if not line.strip():
            if cur.get('Id'):
                out[cur['Id']] = cur
            cur = {}
            continue
        k, _, v = line.partition('=')
        cur[k] = v
    return out


def systemctl(*args, timeout=15):
    if not shutil.which('systemctl'):
        raise Fail('systemctl is missing')
    r = subprocess.run(['systemctl', '--user', '--no-pager', *args], capture_output=True, text=True, timeout=timeout)
    return r


def turned_off_file():
    base = os.environ.get('XDG_STATE_HOME') or os.path.join(os.path.expanduser('~'), '.local', 'state')
    return os.path.join(base, 'nimbus', 'startup-off.json')


def turned_off():
    try:
        with open(turned_off_file()) as f:
            v = json.load(f)
            return v if isinstance(v, list) else []
    except (OSError, ValueError):
        return []


def remember_off(unit, off):
    units = [u for u in turned_off() if u != unit] + ([unit] if off else [])
    try:
        write_atomic(turned_off_file(), json.dumps(units))
    except OSError:
        pass


HEARTH_UNIT = re.compile(r'^(nimbus|hearth)')


def services():
    """User services that are on (plus the ones turned off here, so they can be turned back on), and Hearth's own
    services that are on, shown as "Part of Hearth" (never changed here)."""
    try:
        r = systemctl('list-unit-files', '--type=service', '--plain', '--no-legend')
    except (Fail, OSError, subprocess.TimeoutExpired):
        return []
    states = parse_unit_files(r.stdout)
    mine = set(turned_off())
    units = sorted(u for u, s in states.items() if not is_essential_unit(u) and (s == 'enabled' or u in mine))
    hearth = sorted(u for u, s in states.items() if s == 'enabled' and HEARTH_UNIT.match(u) and not u.endswith('@.service'))
    if not units and not hearth:
        return []
    info = {}
    try:
        info = parse_show(systemctl('show', '-p', 'Id', '-p', 'Description', '-p', 'ActiveState', '-p', 'CPUUsageNSec',
                                    '-p', 'InactiveExitTimestampMonotonic', '-p', 'ActiveEnterTimestampMonotonic',
                                    *(units + hearth)).stdout)
    except (Fail, OSError, subprocess.TimeoutExpired):
        pass

    def cpu_ns(i):
        try:
            v = int(i.get('CPUUsageNSec', ''))
            return v if v < 2 ** 63 else None
        except ValueError:
            return None
    def took(i):
        try:
            a, b = int(i.get('InactiveExitTimestampMonotonic') or 0), int(i.get('ActiveEnterTimestampMonotonic') or 0)
            return round((b - a) / 1e6, 1) if a and b >= a else None
        except ValueError:
            return None
    out = []
    for u in units:
        i = info.get(u, {})
        desc = i.get('Description') or u[:-8]
        on = states[u] == 'enabled'
        out.append({'id': 'service:' + u, 'kind': 'service', 'name': desc, 'sub': u[:-8] + (' · running' if i.get('ActiveState') == 'active' else ''),
                    'on': on, 'canChange': True, 'publisher': 'Service', 'impact': startup_impact(cpu_ns(i), on),
                    'added': took(i) if on else None, 'starts': 'at sign-in' if on else ''})
    for u in hearth:
        i = info.get(u, {})
        out.append({'id': 'hearth-part:' + u, 'kind': 'hearth-part', 'name': i.get('Description') or u[:-8], 'sub': u[:-8],
                    'on': True, 'canChange': False, 'publisher': 'Hearth', 'impact': startup_impact(cpu_ns(i), True),
                    'added': took(i), 'starts': 'at sign-in'})
    return out


def set_service(unit, on):
    if not unit.endswith('.service') or '/' in unit or is_essential_unit(unit):
        raise Fail("that service keeps the system working, so it can't be turned off here")
    if on:
        state = systemctl('is-enabled', unit).stdout.strip()
        if state == 'masked':
            systemctl('unmask', unit)
        r = systemctl('enable', '--now', unit)
        if r.returncode != 0:
            raise Fail((r.stderr.strip().splitlines() or ['could not turn it on'])[-1])
        remember_off(unit, False)
        return
    r = systemctl('disable', '--now', unit)
    if r.returncode != 0:
        raise Fail((r.stderr.strip().splitlines() or ['could not turn it off'])[-1])
    # Turned on for everyone (in /etc): disabling only for you needs a mask.
    if systemctl('is-enabled', unit).stdout.strip() == 'enabled':
        r = systemctl('mask', '--now', unit)
        if r.returncode != 0:
            raise Fail((r.stderr.strip().splitlines() or ['could not turn it off'])[-1])
    remember_off(unit, True)


def autostart_dirs():
    home = os.path.expanduser('~')
    user = os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.join(home, '.config'), 'autostart')
    system = [os.path.join(d, 'autostart') for d in (os.environ.get('XDG_CONFIG_DIRS') or '/etc/xdg').split(':') if d]
    return user, system


def autostart_on(de):
    return de.get('Hidden', 'false').lower() != 'true' and de.get('X-GNOME-Autostart-enabled', 'true').lower() != 'false'


def autostart_entries(user=None, system=None):
    if user is None:
        user, system = autostart_dirs()
    files = {}
    for d in reversed(system or []):          # the first system folder wins, then yours
        for p in glob.glob(os.path.join(d, '*.desktop')):
            files[os.path.basename(p)] = p
    for p in glob.glob(os.path.join(user, '*.desktop')):
        files[os.path.basename(p)] = p
    out = []
    for fn in sorted(files):
        de = parse_desktop(read(files[fn], '') or '')
        if de.get('Type', 'Application') != 'Application':
            continue
        sysfile = next((os.path.join(d, fn) for d in (system or []) if os.path.exists(os.path.join(d, fn))), None)
        name = de.get('Name')
        if not name and sysfile:
            name = parse_desktop(read(sysfile, '') or '').get('Name')
        argv = autostart_argv(de.get('Exec', ''), de)
        prog = os.path.basename(argv[0]) if argv else ''
        own = bool(re.search(r'^(nimbus|hearth)[\w-]*$', prog)) or 'nimbus-' in ' '.join(argv)
        on = autostart_on(de)
        added = autostart_times().get(fn)
        out.append({'id': ('hearth-part:' if own else 'autostart:') + fn, 'kind': 'hearth-part' if own else 'autostart',
                    'added': added if on else None,
                    'starts': ('at sign-in, minimized' if MINIMIZED.search(' '.join(argv)) else 'at sign-in') if on else '',
                    'name': name or fn[:-8],
                    'sub': de.get('Comment', '') or ('For everyone' if files[fn] != os.path.join(user, fn) else 'Yours'),
                    'on': on, 'canChange': not own, 'publisher': 'Hearth' if own else autostart_publisher(de, prog),
                    'impact': 'None' if not on else 'Not measured'})
    return out


def autostart_publisher(de, prog):
    """Who makes a start-up app, as well as a .desktop file can say (Flatpak's app id, else the program)."""
    fp = de.get('X-Flatpak', '')
    if fp.count('.') >= 2:
        return fp.split('.')[1].capitalize()
    return prog or ''


def set_key(text, key, value):
    """Sets key=value in the [Desktop Entry] group of a .desktop file's text."""
    lines, group, done, out = text.splitlines(), None, False, []
    for line in lines:
        s = line.strip()
        if s.startswith('['):
            if group == '[Desktop Entry]' and not done:
                out.append('%s=%s' % (key, value))
                done = True
            group = s
        elif group == '[Desktop Entry]' and s.split('=', 1)[0].strip() == key:
            if not done:
                out.append('%s=%s' % (key, value))
                done = True
            continue
        out.append(line)
    if not done:
        if group is None:
            out.insert(0, '[Desktop Entry]')
        if group in (None, '[Desktop Entry]'):
            out.append('%s=%s' % (key, value))
        else:
            i = next((i for i, l in enumerate(out) if l.strip() == '[Desktop Entry]'), None)
            if i is None:
                out = ['[Desktop Entry]', '%s=%s' % (key, value), ''] + out
            else:
                out.insert(i + 1, '%s=%s' % (key, value))
    return '\n'.join(out) + '\n'


def set_autostart(fn, on, user=None, system=None):
    if user is None:
        user, system = autostart_dirs()
    if '/' in fn or not fn.endswith('.desktop'):
        raise Fail('unknown startup app')
    mine = os.path.join(user, fn)
    sysfile = next((os.path.join(d, fn) for d in (system or []) if os.path.exists(os.path.join(d, fn))), None)
    if os.path.exists(mine):
        text = read(mine, '') or ''
        if on and OVERRIDE_MARK in text and sysfile and autostart_on(parse_desktop(read(sysfile, '') or '')):
            os.remove(mine)           # our own "off" copy: removing it brings back the system's
            return
    elif sysfile:
        text = read(sysfile, '') or ''
        if on and autostart_on(parse_desktop(text)):
            return
        text = set_key(text, 'X-Hearth-Override', 'true')
    else:
        raise Fail("that startup app isn't there any more")
    text = set_key(text, 'Hidden', 'false' if on else 'true')
    if on and parse_desktop(text).get('X-GNOME-Autostart-enabled', '').lower() == 'false':
        text = set_key(text, 'X-GNOME-Autostart-enabled', 'true')
    write_atomic(mine, text)


def library_file():
    base = os.environ.get('XDG_DATA_HOME') or os.path.join(os.path.expanduser('~'), '.local', 'share')
    return os.path.join(base, 'nimbus', 'library.json')


def hearth_running(procs=None):
    """Hearth itself (not Hearth Browser) is open: it keeps library.json in memory and would undo a change."""
    procs = procs if procs is not None else scan()
    uid = os.getuid()
    for p in procs.values():
        if p.uid == uid and not p.kthread and (p.exe in ('nimbus', 'hearth') or (p.cmd and basename(p.cmd[0]) in ('nimbus', 'hearth'))) and '--browser' not in p.cmd:
            return True
    return False


def steam_background(path=None):
    path = path or library_file()
    if hsio:
        data = hsio.load_json(path, {})
        return data.get('steamBackground', True) is not False
    try:
        with open(path) as f:
            data = json.load(f)
        v = data.get('steamBackground', True) if isinstance(data, dict) else True
    except (OSError, ValueError):
        v = True                 # Hearth's default
    return v is not False


def set_steam_background(on, path=None):
    path = path or library_file()
    if hsio and os.path.exists(path):
        # Merged under the lock Hearth's own library writer uses (hearth-core settings_file): only this key changes,
        # and a damaged file comes back from library.json.bak instead of being replaced.
        with open(path, 'rb') as f:
            raw = f.read()
        if hsio._valid_json_object(raw) or os.path.exists(path + '.bak'):
            hsio.merge_json(path, {'steamBackground': bool(on)})
            return
    data = {}
    if os.path.exists(path):
        try:
            with open(path) as f:
                data = json.load(f)
        except ValueError:
            raise Fail("Hearth's library file is damaged; change this in Hearth instead")
        if not isinstance(data, dict):
            raise Fail("Hearth's library file is damaged; change this in Hearth instead")
    data['steamBackground'] = bool(on)
    write_atomic(path, json.dumps(data, indent=2))


def startup():
    busy = hearth_running()
    sb = steam_background()
    items = [{'id': HEARTH_ID, 'kind': 'hearth', 'name': 'Keep Steam running in the background',
              'sub': 'Steam games start faster. Steam uses some memory while it waits.' if not busy
              else "Hearth is open, so change this in Hearth's own settings.",
              'on': sb, 'canChange': not busy, 'publisher': 'Valve (started by Hearth)', 'impact': 'Medium' if sb else 'None'}]
    items += autostart_entries()
    items += services()
    return {'items': items, 'bootSeconds': boot_seconds()}


def startup_set(item, on):
    kind, _, name = item.partition(':')
    if item == HEARTH_ID:
        if hearth_running():
            raise Fail("Hearth is open, so change this in Hearth's own settings")
        set_steam_background(on)
    elif kind == 'autostart':
        set_autostart(name, on)
    elif kind == 'service':
        set_service(name, on)
    elif kind == 'hearth-part':
        raise Fail("that's part of Hearth, so it can't be turned off here")
    else:
        raise Fail('unknown startup item ' + item)
    return {'id': item, 'on': on}


# ---------------------------------------------------------------------- starting the autostart apps
# Desktop Mode starts the XDG autostart apps that are on, like GNOME and KDE do (Discord, a sync client, a
# password manager...), with these left out:
#  - Steam: Hearth starts it when a game needs it, or keeps it in the background (the first Startup item);
#    Steam's own "Run Steam when my computer starts" would start it a second time,
#  - Hearth's own (they're started by the session already),
#  - parts of other desktops Desktop Mode has its own of (password prompts, notifications, panels, screen
#    lockers), and anything marked for other desktops only (OnlyShowIn / NotShowIn against XDG_CURRENT_DESKTOP).
AUTOSTART_SKIP = re.compile(r'polkit|policykit|notification-daemon|notify-osd|dunst|mako|xfce4-notifyd|xscreensaver|'
                            r'light-locker|xfce4-power-manager|picom|compton|tint2|plank|xfce4-panel|lxpanel|'
                            r'lxqt-panel|cairo-dock|conky-manager|gnome-shell|plasmashell|kded|org\.kde\.')
STEAM_EXEC = re.compile(r'(^|/)steam(\.sh)?$|^steam-runtime|com\.valvesoftware\.Steam')
FIELD_CODES = re.compile(r'%[fFuUdDnNickvm%]')


def autostart_argv(execline, fields=None):
    """argv for an autostart entry's Exec= (no files to open: field codes dropped, %% kept as %)."""
    try:
        words = shlex.split(execline)
    except ValueError:
        return []
    out = []
    for w in words:
        if w == '%i':
            if fields and fields.get('Icon'):
                out += ['--icon', fields['Icon']]
            continue
        w = FIELD_CODES.sub(lambda m: '%' if m.group(0) == '%%' else '', w)
        if w:
            out.append(w)
    return out


def desktops_now():
    return [d.strip().lower() for d in (os.environ.get('XDG_CURRENT_DESKTOP') or 'Nimbus:wlroots').split(':') if d.strip()]


def autostart_plan(user=None, system=None):
    """[{file, name, argv, delay, start, why}] for every autostart file (yours over the system's)."""
    if user is None:
        user, system = autostart_dirs()
    files = {}
    for d in reversed(system or []):
        for p in glob.glob(os.path.join(d, '*.desktop')):
            files[os.path.basename(p)] = p
    for p in glob.glob(os.path.join(user, '*.desktop')):
        files[os.path.basename(p)] = p
    here = desktops_now()
    plan = []
    for fn in sorted(files):
        de = parse_desktop(read(files[fn], '') or '')
        item = {'file': files[fn], 'name': de.get('Name') or fn[:-8], 'argv': [], 'delay': 0, 'start': False, 'why': ''}
        plan.append(item)
        only = [x.strip().lower() for x in de.get('OnlyShowIn', '').split(';') if x.strip()]
        never = [x.strip().lower() for x in de.get('NotShowIn', '').split(';') if x.strip()]
        argv = autostart_argv(de.get('Exec', ''), de)
        prog = os.path.basename(argv[0]) if argv else ''
        joined = ' '.join(argv)
        if de.get('Type', 'Application') != 'Application':
            item['why'] = 'not an app'
        elif not autostart_on(de):
            item['why'] = 'turned off'
        elif only and not set(only) & set(here):
            item['why'] = 'only for ' + de.get('OnlyShowIn', '').strip(';')
        elif never and set(never) & set(here):
            item['why'] = 'not for this desktop'
        elif not argv:
            item['why'] = 'no command'
        elif de.get('TryExec') and not shutil.which(os.path.expanduser(de['TryExec'])):
            item['why'] = de['TryExec'] + " isn't installed"
        elif not shutil.which(argv[0]) and not (os.path.isabs(argv[0]) and os.access(argv[0], os.X_OK)):
            item['why'] = argv[0] + " isn't installed"
        elif de.get('Terminal', 'false').lower() == 'true':
            item['why'] = 'needs a terminal'
        elif STEAM_EXEC.search(prog) or any(STEAM_EXEC.search(a) for a in argv[1:3]):
            item['why'] = 'Hearth starts Steam itself'
        elif re.search(r'(^|/)(nimbus|hearth)[\w-]*$', prog) or 'nimbus-' in joined:
            item['why'] = "Hearth's own"
        elif AUTOSTART_SKIP.search(fn.lower()) or AUTOSTART_SKIP.search(prog.lower()):
            item['why'] = 'Desktop Mode has its own'
        else:
            item['argv'] = argv
            item['start'] = True
            try:
                item['delay'] = max(0, min(120, int(de.get('X-GNOME-Autostart-Delay', '0') or 0)))
            except ValueError:
                item['delay'] = 0
            item['cwd'] = os.path.expanduser(de['Path']) if de.get('Path') else ''
    return plan


def autostart_run(plan=None, spawn=None):
    plan = autostart_plan() if plan is None else plan
    started = []
    home = os.path.expanduser('~')
    for it in plan:
        if not it['start']:
            continue
        argv = it['argv'] if not it['delay'] else ['sh', '-c', 'sleep "$0"; exec "$@"', str(it['delay'])] + it['argv']
        cwd = it.get('cwd') if it.get('cwd') and os.path.isdir(it['cwd']) else home
        try:
            if spawn:
                spawn(argv, cwd)
            else:
                subprocess.Popen(argv, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
            started.append(it['name'])
        except OSError:
            pass
    if not spawn and started:
        # "Time added to start" (1.12, mockup tm-8): measured 20 s later, from what each app used while starting
        try:
            subprocess.Popen([sys.executable, os.path.realpath(__file__), 'autostart-measure', str(int(time.time()))],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        except OSError:
            pass
    return {'started': started}


def autostart_times_file():
    return os.path.join(os.environ.get('XDG_STATE_HOME') or os.path.expanduser('~/.local/state'), 'hearth', 'autostart-times.json')


def autostart_measure(since, plan=None, root=PROC, wait=20):
    """Each autostart app's processor time in its first `wait` seconds after the session started it: the time it
    added to starting (what Windows' Task Manager calls its start-up cost)."""
    time.sleep(max(0, since + wait - time.time()))
    plan = autostart_plan() if plan is None else plan
    procs = scan(root)
    out = {}
    for it in plan:
        if not it['start'] or not it['argv']:
            continue
        prog = os.path.basename(it['argv'][0])
        secs = sum(p.jiffies / CLK_TCK for p in procs.values() if p.exe == prog or p.comm == prog[:15])
        out[os.path.basename(it['file'])] = round(secs, 1)
    path = autostart_times_file()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + '.tmp', 'w') as f:
        json.dump({'t': since, 'apps': out}, f)
    os.replace(path + '.tmp', path)
    return out


def autostart_times():
    try:
        with open(autostart_times_file()) as f:
            return (json.load(f) or {}).get('apps') or {}
    except (OSError, ValueError):
        return {}


MINIMIZED = re.compile(r'(^|\s)(--?(start-)?minimi[sz]ed|--hidden|--silent|-silent|--tray|--background|-m)(\s|$)')


# ---------------------------------------------------------------------- the shared sampler (Task Manager, Windows 11 style)
# `hearth-tasks serve` runs while Task Manager is open: one process, one sample per tick for every page, so Python
# starts once and the previous sample stays in memory. Task Manager tells it (one JSON line on stdin) how often to
# sample and what the page on show needs:
#   {"interval": 1, "want": ["procs", "gpu", "temps"]}      interval 0 = paused; {"now": true} = one sample now
# and gets one JSON line per sample on stdout. The base sample (CPU, memory, disks, network, graphics from sysfs) is a
# handful of small files; the process list ("procs"), the Details table ("details"), nvidia-smi ("gpu") and the
# sensors ("temps") are only read when the page on show uses them. It ends when stdin closes (the window closed).

# Heat-map shading (the cells get stronger as use rises), like Windows: level 0-5 from these thresholds.
#   cpu, gpu: % of the whole machine · mem: % of the memory · disk: MB/s · net: Mbps
HEAT = {
    'cpu': (0.5, 5, 15, 30, 60),
    'gpu': (0.5, 5, 15, 30, 60),
    'mem': (0.5, 2, 5, 10, 25),
    'disk': (0.1, 1, 10, 50, 150),
    'net': (0.1, 1, 10, 50, 200),
}


def heat_level(kind, value):
    """0 (barely used) to 5 (very busy) for a cell of the given kind."""
    if value is None:
        return 0
    return sum(1 for t in HEAT.get(kind, ()) if value >= t)


def parse_diskstats(text):
    """/proc/diskstats: {name: {rd, rsec, rms, wr, wsec, wms, ioms}} (I/Os, sectors and ms, read and write; ms busy)."""
    out = {}
    for line in (text or '').splitlines():
        f = line.split()
        if len(f) < 14:
            continue
        try:
            n = [int(x) for x in f[3:14]]
        except ValueError:
            continue
        out[f[2]] = {'rd': n[0], 'rsec': n[2], 'rms': n[3], 'wr': n[4], 'wsec': n[6], 'wms': n[7], 'ioms': n[9]}
    return out


def parse_net_dev(text):
    """/proc/net/dev: {iface: (received bytes, sent bytes)}."""
    out = {}
    for line in (text or '').splitlines():
        if ':' not in line:
            continue
        name, _, rest = line.partition(':')
        f = rest.split()
        if len(f) >= 9 and f[0].isdigit():
            out[name.strip()] = (int(f[0]), int(f[8]))
    return out


def parse_loadavg_threads(text):
    """/proc/loadavg's "running/total" field: how many threads there are."""
    f = (text or '').split()
    if len(f) >= 4 and '/' in f[3]:
        try:
            return int(f[3].split('/')[1])
        except ValueError:
            return None
    return None


def parse_proc_io(text):
    """/proc/PID/io: bytes read + written from storage."""
    total = 0
    for line in (text or '').splitlines():
        k, _, v = line.partition(':')
        if k in ('read_bytes', 'write_bytes'):
            try:
                total += int(v)
            except ValueError:
                pass
    return total


def engine_kind(name):
    """A DRM engine's name → '3d', 'dec' (video decode), 'enc' (video encode) or '' (copy, compute…).
    i915: render, video, video-enhance; amdgpu: gfx, dec, enc, enc_1, jpeg; xe: rcs, vcs, vecs; panfrost: fragment."""
    n = name.lower()
    if n in ('render', 'gfx', 'rcs', 'fragment', 'vertex-tiler', '3d'):
        return '3d'
    if n in ('video', 'dec', 'vcs', 'jpeg', 'vcn', 'uvd') or n.startswith(('dec', 'vcn_dec', 'jpeg')):
        return 'dec'
    if n in ('enc', 'video-enhance', 'vecs', 'vce') or n.startswith(('enc', 'vcn_enc')):
        return 'enc'
    return ''


def parse_fdinfo(text):
    """A DRM file's fdinfo: (client id, {engine: busy ns}) or (None, {}) for anything else."""
    client, engines = None, {}
    for line in (text or '').splitlines():
        k, _, v = line.partition(':')
        k, v = k.strip(), v.strip()
        if k == 'drm-client-id':
            client = v
        elif k.startswith('drm-engine-') and not k.startswith('drm-engine-capacity'):
            try:
                engines[k[11:]] = int(v.split()[0])
            except (ValueError, IndexError):
                pass
    return (client, engines) if client is not None else (None, {})


def parse_boot_time(text):
    """`systemd-analyze time` → seconds to start ("... = 1min 3.512s"), or None."""
    m = re.search(r'=\s*([^\n]+)', text or '')
    if not m:
        return None
    total, found = 0.0, False
    for num, unit in re.findall(r'([\d.]+)\s*(min|ms|s|h)\b', m.group(1)):
        found = True
        total += float(num) * {'h': 3600, 'min': 60, 's': 1, 'ms': 0.001}[unit]
    return round(total, 1) if found else None


def startup_impact(cpu_ns, on=True):
    """Windows' start-up impact from the CPU time a service used: None / Low / Medium / High / Not measured."""
    if not on:
        return 'None'
    if cpu_ns is None:
        return 'Not measured'
    s = cpu_ns / 1e9
    return 'Low' if s < 0.3 else 'Medium' if s < 1.5 else 'High'


SKIP_DISKS = ('loop', 'ram', 'zram', 'dm-', 'md', 'sr', 'fd', 'nbd')


def disk_layout(sys_root=SYS, mounts_text=None, letters=None):
    """[{name, label, letters, model, type, size, system}] for the physical disks, in Windows' order.
    letters: This PC's drive letters ({key: {letter, path}}), or None when there's no letters file (then only C:)."""
    names = []
    try:
        names = sorted(n for n in os.listdir(os.path.join(sys_root, 'block')) if not n.startswith(SKIP_DISKS))
    except OSError:
        pass
    # partition / device-mapper name → disk
    owner = {}
    for d in names:
        owner[d] = d
        try:
            for e in os.listdir(os.path.join(sys_root, 'block', d)):
                if e.startswith(d):
                    owner[e] = d
        except OSError:
            pass
    try:
        for dm in os.listdir(os.path.join(sys_root, 'block')):
            if dm.startswith('dm-'):
                for s in os.listdir(os.path.join(sys_root, 'block', dm, 'slaves')):
                    if s in owner:
                        owner[dm] = owner[s]
    except OSError:
        pass
    mounts = {}
    for line in (mounts_text if mounts_text is not None else read('/proc/mounts', '') or '').splitlines():
        f = line.split()
        if len(f) >= 2 and f[0].startswith('/dev/'):
            dev = os.path.basename(os.path.realpath(f[0])) if not f[0].startswith('/dev/mapper/') else os.path.basename(os.path.realpath(f[0]))
            disk = owner.get(dev) or owner.get(os.path.basename(f[0]))
            if disk:
                mounts.setdefault(disk, []).append(f[1].replace('\\040', ' '))
    out = []
    for d in names:
        size = (read_int(os.path.join(sys_root, 'block', d, 'size')) or 0) * 512
        if size <= 0:
            continue
        rot = read_int(os.path.join(sys_root, 'block', d, 'queue', 'rotational'))
        kind = 'SSD (NVMe)' if d.startswith('nvme') else 'HDD' if rot == 1 else 'SSD' if not d.startswith('mmcblk') else 'Removable'
        model = (read(os.path.join(sys_root, 'block', d, 'device', 'model')) or '').strip()
        mp = mounts.get(d, [])
        system = any(m in ('/', '/sysroot', '/var', '/usr') for m in mp)
        # This PC's letters (hearth_drive_letters.py): C: is always the drive Hearth runs from (never stored); the
        # others come from ~/.config/hearth/drive-letters.json, only read here (Task Manager never assigns or writes one).
        lets = ['C'] if system else []
        if letters is not None:
            for v in letters.values():
                if isinstance(v, dict) and v.get('path') and v.get('path') in mp and v.get('letter'):
                    lets.append(v['letter'])
        out.append({'name': d, 'model': model, 'type': kind, 'size': size, 'system': system,
                    'letters': sorted(set(lets)), 'mounts': mp})
    out.sort(key=lambda x: (not x['system'], x['name']))
    for i, x in enumerate(out):
        x['index'] = i
        x['label'] = 'Disk %d (%s)' % (i, ' '.join(l + ':' for l in x['letters'])) if x['letters'] else 'Disk %d' % i
    return out


def drive_letters_file():
    cfg = os.environ.get('XDG_CONFIG_HOME') or os.path.join(os.path.expanduser('~'), '.config')
    return os.path.join(cfg, 'hearth', 'drive-letters.json')


def read_drive_letters(path=None):
    """This PC's letters ({key: {letter, path}}), read only; None when there's no letters file."""
    path = path or drive_letters_file()
    if not os.path.exists(path):
        return None
    try:
        with open(path) as f:
            d = json.load(f)
        drives = d.get('drives') if isinstance(d, dict) else None
        return drives if isinstance(drives, dict) else {}
    except (OSError, ValueError):
        return {}


def net_adapters(sys_root=SYS):
    """The real network adapters (with a device behind them): [{name, kind, speed, up}]."""
    out = []
    try:
        names = sorted(os.listdir(os.path.join(sys_root, 'class/net')))
    except OSError:
        return out
    for n in names:
        base = os.path.join(sys_root, 'class/net', n)
        if n.startswith('tailscale'):              # Tailscale too, as its own adapter (1.12, mockup tm-5)
            out.append({'name': n, 'kind': 'Tailscale', 'speed': None,
                        'up': (read(os.path.join(base, 'operstate')) or '').strip() in ('up', 'unknown')})
            continue
        if n == 'lo' or not os.path.exists(os.path.join(base, 'device')):
            continue
        wifi = os.path.exists(os.path.join(base, 'wireless')) or n.startswith('wl')
        speed = read_int(os.path.join(base, 'speed'))
        out.append({'name': n, 'kind': 'Wi-Fi' if wifi else 'Ethernet',
                    'speed': speed if speed and speed > 0 else None,
                    'up': (read(os.path.join(base, 'operstate')) or '').strip() == 'up'})
    out.sort(key=lambda a: (not a['up'], a['kind'] != 'Wi-Fi', a['name']))
    return out


def cpu_static(root=PROC, sys_root=SYS):
    """What doesn't change: name, cores, logical processors, base speed, caches, virtualization."""
    name, cores, logical, virt = '', set(), 0, False
    phys = core = None
    for line in (read(os.path.join(root, 'cpuinfo'), '') or '').splitlines():
        k, _, v = line.partition(':')
        k, v = k.strip(), v.strip()
        if k == 'processor':
            logical += 1
        elif k == 'model name' and not name:
            name = v
        elif k == 'physical id':
            phys = v
        elif k == 'core id':
            core = v
            cores.add((phys, core))
        elif k == 'flags' and (' vmx' in ' ' + v or ' svm' in ' ' + v):
            virt = True
    cpu0 = os.path.join(sys_root, 'devices/system/cpu/cpu0')
    base = read_int(os.path.join(cpu0, 'cpufreq/base_frequency')) or read_int(os.path.join(cpu0, 'cpufreq/cpuinfo_max_freq'))
    caches, seen = {}, set()
    for idx in glob.glob(os.path.join(sys_root, 'devices/system/cpu/cpu[0-9]*/cache/index[0-9]*')):
        lvl = (read(os.path.join(idx, 'level')) or '').strip()
        share = (read(os.path.join(idx, 'shared_cpu_list')) or '').strip()
        typ = (read(os.path.join(idx, 'type')) or '').strip()
        size = (read(os.path.join(idx, 'size')) or '').strip()
        if lvl not in ('2', '3') or typ == 'Instruction' or (lvl, share) in seen:
            continue
        seen.add((lvl, share))
        m = re.match(r'(\d+)([KM]?)', size)
        if m:
            caches['L' + lvl] = caches.get('L' + lvl, 0) + int(m.group(1)) * (1024 if m.group(2) == 'K' else 1048576 if m.group(2) == 'M' else 1)
    return {'name': name, 'coreCount': len(cores) or logical, 'logical': logical, 'virt': virt,
            'base': round(base / 1000) if base else None, 'l2': caches.get('L2'), 'l3': caches.get('L3')}


def intel_idle_file(card):
    for rel in ('gt/gt0/rc6_residency_ms', 'power/rc6_residency_ms', 'device/tile0/gt0/gtidle/idle_residency_ms'):
        p = os.path.join(card, rel)
        if os.path.exists(p):
            return p
    return None


class Sampler:
    """Keeps the previous sample, so each tick is a difference (CPU, disks, network, graphics)."""

    def __init__(self, root=PROC, sys_root=SYS):
        self.root, self.sys = root, sys_root
        self.uid = os.getuid()
        self.t = None
        self.cpu = None
        self.jiffies = {}
        self.io = {}
        self.static = {}
        self.disk_prev = {}
        self.net_prev = {}
        self.gpu_prev = {}
        self.drm_fds = {}
        self.drm_scan = 0
        self.client_prev = {}
        self.drm_engines = {}
        self.layout = None
        self.layout_t = 0
        self.adapters = None
        self.cpuinfo = None
        self.freq_files = None
        self.index = None
        self.index_t = 0
        self.app_cache = {}
        self.names = {}
        self.users = {}
        self.smi = []
        self.smi_t = 0
        self.temps = ([], [])
        self.temps_t = 0
        self.batt = None
        self.batt_t = -100
        self.eco = {}
        self.eco_t = 0

    # ---- pieces
    def user(self, uid):
        if uid not in self.users:
            try:
                import pwd
                self.users[uid] = pwd.getpwuid(uid).pw_name
            except (KeyError, ImportError):
                self.users[uid] = str(uid)
        return self.users[uid]

    def game_name(self, appid):
        if appid not in self.names:
            self.names[appid] = steam_name(appid)
        return self.names[appid]

    def scan(self, want_io):
        procs, threads = {}, 0
        try:
            names = os.listdir(self.root)
        except OSError:
            raise Fail("can't read the process list")
        alive = set()
        for n in names:
            if not n.isdigit():
                continue
            d = os.path.join(self.root, n)
            st, status = read(os.path.join(d, 'stat')), read(os.path.join(d, 'status'))
            if st is None or status is None:
                continue
            try:
                s, u = parse_stat(st), parse_status(status)
            except (ValueError, IndexError):
                continue
            key = '%d:%d' % (s['pid'], s['start'])
            alive.add(key)
            info = self.static.get(key)
            if info is None:
                try:
                    path = os.readlink(os.path.join(d, 'exe')).replace(' (deleted)', '')
                except OSError:
                    path = ''
                info = {'cmd': parse_cmdline(read(os.path.join(d, 'cmdline'), '') or ''), 'path': path}
                self.static[key] = info
            kthread = u['kthread'] or s['pid'] == 2 or s['ppid'] == 2
            p = Proc(pid=s['pid'], ppid=s['ppid'], comm=s['comm'], uid=u['uid'], mem=u['mem'], jiffies=s['jiffies'],
                     start=s['start'], kthread=kthread, root=self.root, cmd=info['cmd'], swap=u.get('swap', 0), shared=u.get('shared', 0), cpus=u.get('cpus', ''),
                     exe=os.path.basename(info['path']), path=info['path'], state=s['state'], nice=s['nice'],
                     threads=s['threads'], rt=s.get('rt', False))
            procs[p.pid] = p
            threads += s['threads']
        for k in [k for k in self.static if k not in alive]:
            del self.static[k]
            self.app_cache.pop(k, None)
        return procs

    def drm_busy(self, procs, dt):
        """{pid: GPU %} from DRM fdinfo (amdgpu, i915, xe…), for your own processes."""
        now = time.monotonic()
        if now - self.drm_scan > 10:
            self.drm_scan = now
            self.drm_fds = {}
            for pid, p in procs.items():
                if p.uid != self.uid or p.kthread:
                    continue
                fdd = os.path.join(self.root, str(pid), 'fd')
                try:
                    fds = os.listdir(fdd)
                except OSError:
                    continue
                mine = []
                for fd in fds:
                    try:
                        if os.readlink(os.path.join(fdd, fd)).startswith('/dev/dri/'):
                            mine.append(fd)
                    except OSError:
                        pass
                if mine:
                    self.drm_fds[pid] = mine
        out, seen, cur = {}, set(), {}
        kinds = {}
        for pid, fds in self.drm_fds.items():
            if pid not in procs:
                continue
            best = 0.0
            per = {'3d': 0.0, 'dec': 0.0, 'enc': 0.0}
            vram = 0
            for fd in fds:
                text = read(os.path.join(self.root, str(pid), 'fdinfo', fd))
                client, engines = parse_fdinfo(text)
                if client is None or client in seen:
                    continue
                seen.add(client)
                vram += fdinfo_vram(text)
                for e, ns in engines.items():
                    cur[(client, e)] = ns
                    prev = self.client_prev.get((client, e))
                    if prev is not None and dt > 0:
                        busy = 100.0 * max(0, ns - prev) / (dt * 1e9)
                        best = max(best, busy)
                        k = engine_kind(e)
                        if k:
                            per[k] = min(100.0, max(per[k], busy))
            out[pid] = min(100.0, best)
            kinds[pid] = dict(per, vram=vram)
        self.client_prev = cur
        self.drm_engines = kinds
        return out

    def gpus(self, dt, want_smi):
        out = []
        for card in sorted(glob.glob(os.path.join(self.sys, 'class/drm/card[0-9]*'))):
            if '-' in os.path.basename(card):
                continue
            dev = os.path.join(card, 'device')
            vendor = gpu_vendor(read(os.path.join(dev, 'vendor')))
            if not vendor:
                continue
            g = {'card': os.path.basename(card), 'vendor': vendor,
                 'name': (read(os.path.join(dev, 'product_name')) or '').strip() or vendor + ' graphics',
                 'busy': read_int(os.path.join(dev, 'gpu_busy_percent')),
                 'vramUsed': read_int(os.path.join(dev, 'mem_info_vram_used')),
                 'vramTotal': read_int(os.path.join(dev, 'mem_info_vram_total')),
                 'gttUsed': read_int(os.path.join(dev, 'mem_info_gtt_used')),
                 'gttTotal': read_int(os.path.join(dev, 'mem_info_gtt_total')),
                 'mhz': amd_clock(read(os.path.join(dev, 'pp_dpm_sclk'))) or read_int(os.path.join(card, 'gt_act_freq_mhz')),
                 'temp': None}
            if g['busy'] is None and vendor == 'Intel':
                f = intel_idle_file(card)
                idle = read_int(f) if f else None
                prev = self.gpu_prev.get(g['card'])
                if idle is not None:
                    if prev is not None and dt > 0:
                        g['busy'] = round(max(0.0, min(100.0, 100.0 - (idle - prev) / (dt * 10.0))), 1)
                    self.gpu_prev[g['card']] = idle
            out.append(g)
        if want_smi and shutil.which('nvidia-smi') and (not out or any(g['vendor'] == 'NVIDIA' for g in out)):
            now = time.monotonic()
            if now - self.smi_t >= 1.9:
                self.smi_t = now
                try:
                    r = subprocess.run(['nvidia-smi', '--query-gpu=name,utilization.gpu,memory.used,memory.total,temperature.gpu',
                                        '--format=csv,noheader,nounits'], capture_output=True, text=True, timeout=3)
                    self.smi = parse_nvidia_smi(r.stdout) if r.returncode == 0 else []
                except (OSError, subprocess.TimeoutExpired):
                    self.smi = []
            if self.smi:
                out = [g for g in out if g['vendor'] != 'NVIDIA'] + self.smi
        for i, g in enumerate(out):
            g['index'] = i
        return out

    def eco_marks(self):
        now = time.monotonic()
        if now - self.eco_t > 2:
            self.eco_t = now
            self.eco = load_state('eco') or {}
        return self.eco

    # ---- one sample
    def sample(self, want=()):
        want = set(want or ())
        now = time.monotonic()
        dt = (now - self.t) if self.t else 0.0
        out = {'t': round(time.time(), 2)}

        # CPU
        cur = cpu_total(self.root)
        prev = self.cpu or cur
        pct = [round(busy_percent(p[1:], c[1:]), 1) for p, c in zip(prev, cur)] if len(prev) == len(cur) else [0.0] * len(cur)
        dj = cur[0][1] - prev[0][1] if len(prev) == len(cur) else 0
        if self.cpuinfo is None:
            self.cpuinfo = cpu_static(self.root, self.sys)
            self.freq_files = glob.glob(os.path.join(self.sys, 'devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq'))
        freqs = [f for f in (read_int(p) for p in self.freq_files) if f]
        mhz = round(sum(freqs) / len(freqs) / 1000) if freqs else None
        try:
            nprocs = sum(1 for n in os.listdir(self.root) if n.isdigit())
        except OSError:
            nprocs = None
        out['cpu'] = dict(self.cpuinfo, total=pct[0] if pct else 0, cores=pct[1:], mhz=mhz, processes=nprocs,
                          threads=parse_loadavg_threads(read(os.path.join(self.root, 'loadavg'))))
        uptime = (read(os.path.join(self.root, 'uptime'), '0') or '0').split()
        out['uptime'] = int(float(uptime[0])) if uptime else 0

        # Memory
        mi = parse_meminfo(read(os.path.join(self.root, 'meminfo'), '') or '')
        total = mi.get('MemTotal', 0)
        out['mem'] = {'total': total, 'available': mi.get('MemAvailable', 0),
                      'used': mem_used(mi), 'free': mi.get('MemFree', 0),
                      'cached': mi.get('Cached', 0) + mi.get('SReclaimable', 0) + mi.get('Buffers', 0),
                      'committed': mi.get('Committed_AS', 0), 'commitLimit': mi.get('CommitLimit', 0),
                      'swapTotal': mi.get('SwapTotal', 0), 'swapUsed': max(0, mi.get('SwapTotal', 0) - mi.get('SwapFree', 0))}
        out['mem'].update(mem_extras(self.root, self.sys))

        # Disks (the layout every 30 s, the counters every tick)
        if self.layout is None or now - self.layout_t > 30:
            self.layout_t = now
            self.layout = disk_layout(self.sys, letters=read_drive_letters())
            self.adapters = net_adapters(self.sys)
        ds = parse_diskstats(read(os.path.join(self.root, 'diskstats'), '') or '')
        disks = []
        for d in self.layout:
            c = ds.get(d['name'])
            row = dict(d, active=0.0, read=0, write=0, response=None)
            p = self.disk_prev.get(d['name'])
            if c and p and dt > 0:
                row['active'] = round(max(0.0, min(100.0, (c['ioms'] - p['ioms']) / (dt * 10.0))), 1)
                row['read'] = int(max(0, c['rsec'] - p['rsec']) * 512 / dt)
                row['write'] = int(max(0, c['wsec'] - p['wsec']) * 512 / dt)
                ios = (c['rd'] - p['rd']) + (c['wr'] - p['wr'])
                row['response'] = round(((c['rms'] - p['rms']) + (c['wms'] - p['wms'])) / ios, 1) if ios > 0 else 0.0
            if c:
                self.disk_prev[d['name']] = c
            disks.append(row)
        out['disks'] = disks

        # Network
        nd = parse_net_dev(read(os.path.join(self.root, 'net/dev'), '') or '')
        nets = []
        for a in self.adapters or []:
            c = nd.get(a['name'])
            row = dict(a, recv=0, send=0, pct=None)
            p = self.net_prev.get(a['name'])
            if c and p and dt > 0:
                row['recv'] = int(max(0, c[0] - p[0]) / dt)
                row['send'] = int(max(0, c[1] - p[1]) / dt)
                if a['speed']:
                    row['pct'] = round(min(100.0, 100.0 * (row['recv'] + row['send']) * 8 / (a['speed'] * 1e6)), 1)
            if c:
                self.net_prev[a['name']] = c
            nets.append(row)
        out['nets'] = nets

        # Graphics
        gl = self.gpus(dt, 'gpu' in want or 'procs' in want)
        if 'temps' in want:
            if now - self.temps_t >= 2:
                self.temps_t = now
                self.temps = sensors(self.sys)
            temps, fans = self.temps
            for g in gl:
                if g.get('temp') is None and g['vendor'] in ('AMD', 'Intel'):
                    g['temp'] = summary_temp(temps, 'gpu', ('edge', 'junction'))
            out['cpu']['temp'] = summary_temp(temps, 'cpu', ('tctl', 'tdie', 'package id 0', 'cpu'))
            out['sensors'] = {'temps': temps, 'fans': fans}
            if now - self.batt_t >= 5:
                self.batt_t = now
                self.batt = battery(self.sys)
            out['battery'] = self.batt
        out['gpus'] = gl

        # Totals for the column headers (Windows: % of the machine)
        busiest_disk = max((d['active'] for d in disks), default=0.0)
        net_bytes = sum(n['recv'] + n['send'] for n in nets)
        net_pcts = [n['pct'] for n in nets if n['pct'] is not None and n['up']]
        out['totals'] = {'cpu': pct[0] if pct else 0, 'mem': round(100.0 * out['mem']['used'] / total, 1) if total else 0,
                         'disk': busiest_disk, 'net': max(net_pcts) if net_pcts else None, 'netMbps': round(net_bytes * 8 / 1e6, 1),
                         'gpu': max((g['busy'] for g in gl if g.get('busy') is not None), default=None)}

        # Processes (only for the pages that show them)
        if 'procs' in want or 'details' in want:
            procs = self.scan('procs' in want)
            jprev, self.jiffies = self.jiffies, {p.key: p.jiffies for p in procs.values()}
            cpu_of = {}
            for p in procs.values():
                j = jprev.get(p.key)
                cpu_of[p.pid] = round(100.0 * max(0, p.jiffies - j) / dj, 1) if (j is not None and dj > 0) else 0.0
            if 'procs' in want:
                out['procs'] = self.groups(procs, cpu_of, dt, total)
            if 'details' in want:
                rows = []
                for p in procs.values():
                    if p.kthread:
                        continue
                    rows.append({'pid': p.pid, 'name': p.exe or p.comm, 'status': state_label(p.state), 'user': self.user(p.uid),
                                 'cpu': cpu_of.get(p.pid, 0.0), 'mem': p.mem, 'cmd': ' '.join(p.cmd)[:400] or '[' + p.comm + ']',
                                 'mine': p.uid == self.uid, 'path': p.path, 'threads': p.threads, 'swap': p.swap or 0,
                                 'nice': p.nice, 'ppid': p.ppid, 'cputime': int(p.jiffies / CLK_TCK),
                                 'cores': cores_label(p.cpus or ''), 'rt': bool(p.rt)})
                rows.sort(key=lambda r: r['pid'])
                out['details'] = rows
        else:
            self.jiffies = {}
        self.cpu, self.t = cur, now
        return out

    def groups(self, procs, cpu_of, dt, mem_total):
        now = time.monotonic()
        if self.index is None or now - self.index_t > 15:
            self.index_t = now
            self.index = cached_desktop_index()
        groups = [g for g in build_groups(procs, self.uid, os.getpid(), self.index, self.game_name, self.app_cache)
                  if g['pid'] != os.getpid()]
        io_now = {}
        for pid in (x for g in groups for x in g['pids']):
            p = procs[pid]
            io_now[p.key] = parse_proc_io(read(os.path.join(self.root, str(pid), 'io')))
        io_prev, self.io = self.io, io_now
        gpu_of = self.drm_busy(procs, dt)
        eco = self.eco_marks()
        for g in groups:
            kids = []
            for pid in g['pids']:
                p = procs[pid]
                d = io_now.get(p.key, 0) - io_prev.get(p.key, io_now.get(p.key, 0))
                disk = int(max(0, d) / dt) if dt > 0 else 0
                kids.append({'pid': pid, 'name': script_name(p) or p.exe or p.comm, 'ai': ai_job(p.cmd),
                             'bridge': any('bridge' in os.path.basename(x).lower() for x in (p.cmd or [])[:2]), 'cpu': cpu_of.get(pid, 0.0), 'mem': p.mem,
                             'swap': p.swap or 0, 'shared': p.shared or 0, 'disk': disk, 'gpu': round(gpu_of.get(pid, 0.0), 1), 'state': p.state, 'nice': p.nice})
            g['cpu'] = round(sum(k['cpu'] for k in kids), 1)
            g['swap'] = sum(k['swap'] for k in kids)
            g['shared'] = sum(k.get('shared', 0) for k in kids)
            g['nice'] = min((k['nice'] for k in kids), default=0)
            g['disk'] = sum(k['disk'] for k in kids)
            g['gpu'] = round(min(100.0, sum(k['gpu'] for k in kids)), 1)
            eng = [self.drm_engines.get(k['pid']) for k in kids if self.drm_engines.get(k['pid'])]
            g['vram'] = sum(e.get('vram', 0) for e in eng)
            g['uses'] = [lbl for key, lbl in (('3d', '3D'), ('dec', 'Video decode'), ('enc', 'Video encode'))
                         if any(e.get(key, 0) >= 0.5 for e in eng)]
            g['exe'] = procs[g['pid']].path
            g['suspended'] = all(k['state'] in ('T', 't') for k in kids)
            g['eco'] = g['id'] in eco or all(k['nice'] >= 19 for k in kids)
            g['heat'] = {'cpu': heat_level('cpu', g['cpu']), 'mem': heat_level('mem', 100.0 * g['mem'] / mem_total if mem_total else 0),
                         'disk': heat_level('disk', g['disk'] / 1048576), 'gpu': heat_level('gpu', g['gpu'])}
            for k in kids:
                k['heat'] = {'cpu': heat_level('cpu', k['cpu']), 'mem': heat_level('mem', 100.0 * k['mem'] / mem_total if mem_total else 0),
                             'disk': heat_level('disk', k['disk'] / 1048576), 'gpu': heat_level('gpu', k['gpu'])}
            g['children'] = kids if len(kids) > 1 else []
        groups.sort(key=lambda g: (-g['mem'], g['name'].lower()))
        return groups


def state_label(s):
    return 'Suspended' if s in ('T', 't') else 'Not responding' if s == 'Z' else 'Running'


def serve(fd_in=0, out=None, root=PROC, sys_root=SYS, max_samples=None):
    """The loop behind `hearth-tasks serve` (see above)."""
    import select
    out = out or sys.stdout
    s = Sampler(root, sys_root)
    interval, want = 1.0, []
    buf, due, sent = b'', 0.0, 0          # due: when the next sample is (None: paused, nothing asked for)
    while True:
        timeout = None if due is None else max(0.0, due - time.monotonic())
        r, _, _ = select.select([fd_in], [], [], timeout)
        if r:
            chunk = os.read(fd_in, 65536)
            if not chunk:
                return sent
            buf += chunk
            while b'\n' in buf:
                line, buf = buf.split(b'\n', 1)
                try:
                    msg = json.loads(line.decode('utf-8') or '{}')
                except ValueError:
                    continue
                if not isinstance(msg, dict):
                    continue
                if 'interval' in msg:
                    try:
                        interval = max(0.0, min(10.0, float(msg['interval'])))
                    except (TypeError, ValueError):
                        pass
                if isinstance(msg.get('want'), list):
                    want = [str(w) for w in msg['want']]
                if msg.get('now') or 'interval' in msg or 'want' in msg:
                    due = 0.0
            continue
        try:
            sample = s.sample(want)
        except Fail as e:
            sample = {'error': str(e)}
        out.write(json.dumps(sample, separators=(',', ':')) + '\n')
        out.flush()
        sent += 1
        if max_samples and sent >= max_samples:
            return sent
        due = time.monotonic() + interval if interval > 0 else None


# ---------------------------------------------------------------------- Efficiency mode, single processes, services
def own_unit(procs, g, root=PROC):
    """The app's own systemd scope/service, when every process in it is this app's (else None)."""
    units = set()
    for pid in g['pids']:
        line = (read(os.path.join(root, str(pid), 'cgroup')) or '').strip().splitlines()
        path = line[-1].split('::', 1)[-1] if line else ''
        units.add(path)
    if len(units) != 1:
        return None
    path = units.pop()
    unit = path.rsplit('/', 1)[-1]
    if not re.match(r'^app-[A-Za-z0-9_.@\\:-]+\.(scope|service)$', unit):
        return None
    for pid, p in procs.items():
        if pid in g['pids'] or p.uid != os.getuid():
            continue
        line = (read(os.path.join(root, str(pid), 'cgroup')) or '').strip().splitlines()
        if line and line[-1].split('::', 1)[-1] == path:
            return None
    return unit


def renice_all(pid, value, root=PROC):
    """Sets the nice value of every thread of a process. False when the kernel says no (raising priority back)."""
    ok = True
    try:
        tids = [int(t) for t in os.listdir(os.path.join(root, str(pid), 'task'))]
    except OSError:
        tids = [pid]
    for t in tids:
        try:
            os.setpriority(os.PRIO_PROCESS, t, value)
        except ProcessLookupError:
            pass
        except PermissionError:
            ok = False
    return ok


def set_efficiency(pid, on, root=PROC):
    """Efficiency mode for one of your apps: lowest CPU priority (nice 19) for all its processes, and CPU weight 1 on its
    own systemd scope when it has one. User-level only. Off puts the weight back; Linux only lets an administrator raise
    a priority again, so the nice value may stay low until the app is restarted (the answer says so)."""
    procs = scan(root)
    p = procs.get(pid)
    if not p:
        raise Fail('that app has already closed')
    if p.uid != os.getuid():
        raise Fail("that belongs to another user, so it can't be changed here")
    groups = build_groups(procs, os.getuid(), os.getpid())
    g = next((g for g in groups if pid in g['pids']), None)
    if not g or g['protected']:
        raise Fail("%s keeps Hearth running, so it can't be slowed down here" % ((g or {}).get('why') or 'this'))
    unit = own_unit(procs, g, root)
    marks = load_state('eco') or {}
    stuck = False
    if on:
        for x in g['pids']:
            renice_all(x, 19, root)
        if unit:
            try:
                systemctl('set-property', '--runtime', unit, 'CPUWeight=1', 'IOWeight=1', timeout=5)
            except (Fail, OSError, subprocess.TimeoutExpired):
                unit = None
        marks[g['id']] = {'unit': unit or '', 'pids': g['pids']}
    else:
        if unit:
            try:
                systemctl('set-property', '--runtime', unit, 'CPUWeight=100', 'IOWeight=100', timeout=5)
            except (Fail, OSError, subprocess.TimeoutExpired):
                pass
        for x in g['pids']:
            if not renice_all(x, 0, root):
                stuck = True
        marks.pop(g['id'], None)
    save_state('eco', marks)
    return {'pid': pid, 'on': on, 'unit': unit or '', 'stuck': stuck}


PRIORITY = {'normal': 0, 'below': 10, 'low': 19}
PRIORITY_LABEL = {0: 'Normal', 10: 'Below normal', 19: 'Low'}


def own_group(pid, root=PROC):
    """(procs, group) for one of your apps that may be changed; Fail in plain words otherwise."""
    procs = scan(root)
    p = procs.get(pid)
    if not p:
        raise Fail('that app has already closed')
    if p.uid != os.getuid():
        raise Fail("that belongs to another user, so it can't be changed here")
    g = next((g for g in build_groups(procs, os.getuid(), os.getpid()) if pid in g['pids']), None)
    if not g or g['protected']:
        raise Fail("%s keeps Hearth running, so it can't be changed here" % ((g or {}).get('why') or 'this'))
    return procs, g


def descendants(procs, pid):
    out, todo = [], [pid]
    while todo:
        cur = todo.pop()
        out.append(cur)
        todo.extend(q.pid for q in procs.values() if q.ppid == cur and q.pid not in out)
    return out


def end_tree(pid, root=PROC):
    """End process tree: the process and everything it started (yours only, never a part of Hearth)."""
    procs = scan(root)
    if pid not in procs:
        raise Fail('that process has already ended')
    guarded = set(ancestors(procs, os.getpid()))
    tree = [x for x in descendants(procs, pid) if procs[x].uid == os.getuid()]
    for x in tree:
        why = protected_reason(procs[x], guarded)
        if why:
            raise Fail("%s keeps Hearth running, so it can't be ended here" % why)
    ended = []
    for x in reversed(tree):
        try:
            os.kill(x, signal.SIGTERM)
            ended.append(x)
        except OSError:
            pass
    return {'pid': pid, 'ended': ended}


def set_priority(pid, level, root=PROC):
    """Set priority (Normal, Below normal, Low) for every process of the app. Linux only lets an administrator raise a
    priority again, so going back up can stay low until the app restarts (the answer says so)."""
    if level not in PRIORITY:
        raise Fail('priority: normal, below or low')
    procs, g = own_group(pid, root)
    stuck = False
    for x in g['pids']:
        if not renice_all(x, PRIORITY[level], root):
            stuck = True
    return {'pid': pid, 'priority': level, 'label': PRIORITY_LABEL[PRIORITY[level]], 'stuck': stuck}


def suspend(pid, stop, root=PROC):
    """Details › Suspend / Resume (1.12, mockup tm-2): stops or continues one of your own processes."""
    procs = scan(root)
    p = procs.get(pid)
    if not p:
        raise Fail('that process has already closed')
    if p.uid != os.getuid():
        raise Fail("that belongs to another user, so it can't be changed here")
    g = next((g for g in build_groups(procs, os.getuid(), os.getpid()) if pid in g['pids']), None)
    if g and g['protected']:
        raise Fail("%s keeps Hearth running, so it can't be suspended" % (g.get('why') or 'this'))
    os.kill(pid, signal.SIGSTOP if stop else signal.SIGCONT)
    return {'pid': pid, 'suspended': stop}


def parse_cpus(text, n=None):
    """'0-3,6' → [0, 1, 2, 3, 6] (checked against this PC's cores)."""
    n = n or os.cpu_count() or 1
    out = set()
    for part in text.split(','):
        part = part.strip()
        if not part:
            continue
        a, _, b = part.partition('-')
        if not a.isdigit() or (b and not b.isdigit()):
            raise Fail('cores: like 0-3,6')
        lo, hi = int(a), int(b or a)
        if lo > hi or hi >= n:
            raise Fail('this PC has cores 0 to %d' % (n - 1))
        out.update(range(lo, hi + 1))
    if not out:
        raise Fail('pick at least one core')
    return sorted(out)


def set_affinity(pid, cpus, root=PROC):
    """Run on these cores: every process (and thread) of the app kept to the cores you picked, until it closes."""
    procs, g = own_group(pid, root)
    cores = parse_cpus(cpus)
    done = 0
    for x in g['pids']:
        for t in (os.listdir(os.path.join(root, str(x), 'task')) if os.path.isdir(os.path.join(root, str(x), 'task')) else [str(x)]):
            try:
                os.sched_setaffinity(int(t), cores)
                done += 1
            except OSError:
                pass
    if not done:
        raise Fail("couldn't change where it runs")
    return {'pid': pid, 'cores': cores}


def set_limit(pid, cpu_pct, mem_mb, root=PROC):
    """Limit CPU / memory: a cap on the app's own systemd scope (CPUQuota, MemoryHigh: slowed down, never closed), until
    it closes. 0 removes a cap. Only apps that run in their own scope (started from the menu, the taskbar or Files)."""
    procs, g = own_group(pid, root)
    unit = own_unit(procs, g, root)
    if not unit:
        raise Fail("this app wasn't started in a box of its own, so it can't be limited (open it from the app menu first)")
    props = []
    cpu_pct, mem_mb = int(cpu_pct), int(mem_mb)
    if not 0 <= cpu_pct <= 100 * (os.cpu_count() or 1):
        raise Fail('CPU limit: 0 (none) to %d%%' % (100 * (os.cpu_count() or 1)))
    if mem_mb < 0:
        raise Fail('memory limit: 0 (none) or more')
    props.append('CPUQuota=%s' % ('%d%%' % cpu_pct if cpu_pct else ''))
    props.append('MemoryHigh=%s' % ('%dM' % mem_mb if mem_mb else 'infinity'))
    systemctl('set-property', '--runtime', unit, *props, timeout=5)
    return {'pid': pid, 'unit': unit, 'cpu': cpu_pct, 'memMb': mem_mb}


# ---------------------------------------------------------------------- + New task (1.12, mockup tm-8)
# A program or script at a time, at sign-in, every hour or 6 hours (a systemd user timer), when idle or when the PC
# goes on battery (Mantel's IdlePower.qml and BatteryWatch.qml run `task-trigger idle|battery`). Yours only, in
# ~/.config/systemd/user (hearth-task-NAME.service/.timer) and ~/.config/hearth/tasks.json for the two triggers.
TASK_WHEN = re.compile(r'^(daily@([01]\d|2[0-3]):[0-5]\d|signin|hourly|every6h|idle|battery)$')


def task_unit_dir():
    return os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config'), 'systemd', 'user')


def tasks_file():
    return os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config'), 'hearth', 'tasks.json')


def _tasks():
    try:
        with open(tasks_file()) as f:
            d = json.load(f)
            return d if isinstance(d, dict) else {}
    except (OSError, ValueError):
        return {}


def _save_tasks(d):
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    import hearth_settings_io
    os.makedirs(os.path.dirname(tasks_file()), exist_ok=True)
    hearth_settings_io.write_json(tasks_file(), d)


def task_slug(name):
    return re.sub(r'[^a-z0-9-]+', '-', name.lower()).strip('-')[:40] or 'task'


def task_new(name, when, command):
    if not name.strip() or not command.strip():
        raise Fail('a name and what to run, please')
    if not TASK_WHEN.match(when):
        raise Fail('when: daily@HH:MM, signin, hourly, every6h, idle or battery')
    slug = task_slug(name)
    d = task_unit_dir()
    os.makedirs(d, exist_ok=True)
    svc = '[Unit]\nDescription=%s\n# made in Task Manager › Scheduled tasks (+ New task)\n\n[Service]\nType=oneshot\nExecStart=/bin/sh -c %s\n' % (
        name.replace('\n', ' '), shlex.quote(command))
    with open(os.path.join(d, 'hearth-task-%s.service' % slug), 'w') as f:
        f.write(svc)
    timer = os.path.join(d, 'hearth-task-%s.timer' % slug)
    t = _tasks()
    t.pop(slug, None)
    if when in ('idle', 'battery'):
        if os.path.exists(timer):
            run_systemctl(True, 'disable', '--now', os.path.basename(timer))
            os.remove(timer)
        t[slug] = {'name': name, 'when': when}
    else:
        cal = {'hourly': 'OnCalendar=hourly', 'every6h': 'OnCalendar=00/6:00', 'signin': 'OnStartupSec=30s'}.get(when) or 'OnCalendar=*-*-* %s:00' % when.split('@')[1]
        with open(timer, 'w') as f:
            f.write('[Unit]\nDescription=%s\n\n[Timer]\n%s\nPersistent=%s\n\n[Install]\nWantedBy=timers.target\n' % (name, cal, 'false' if when == 'signin' else 'true'))
    _save_tasks(t)
    run_systemctl(True, 'daemon-reload')
    if os.path.exists(timer):
        r = run_systemctl(True, 'enable', '--now', os.path.basename(timer), timeout=30)
        if r.returncode != 0:
            raise Fail((r.stderr.strip().splitlines() or ['could not turn it on'])[-1])
    return {'ok': True, 'task': slug, 'when': when}


def task_delete(slug):
    if not re.match(r'^[a-z0-9-]{1,40}$', slug):
        raise Fail('not one of yours')
    d = task_unit_dir()
    run_systemctl(True, 'disable', '--now', 'hearth-task-%s.timer' % slug)
    for ext in ('.timer', '.service'):
        p = os.path.join(d, 'hearth-task-%s%s' % (slug, ext))
        if os.path.exists(p):
            os.remove(p)
    t = _tasks()
    if t.pop(slug, None) is not None:
        _save_tasks(t)
    run_systemctl(True, 'daemon-reload')
    return {'ok': True}


def task_trigger(what):
    started = []
    for slug, v in _tasks().items():
        if v.get('when') == what:
            run_systemctl(True, 'start', '--no-block', 'hearth-task-%s.service' % slug)
            started.append(slug)
    return {'started': started}


def _usec_when(us):
    """systemd's microseconds since the epoch → seconds (0 = never)."""
    try:
        us = int(us or 0)
    except (TypeError, ValueError):
        return 0
    return us // 1000000 if us > 0 else 0


def timer_list():
    """Scheduled tasks (1.11): systemd timers, yours (on / off) and the system's (read only), with the next and last run."""
    out = []
    for scope in ('user', 'system'):
        args = ['--user'] if scope == 'user' else []
        try:
            r = subprocess.run(['systemctl'] + args + ['list-timers', '--all', '--output=json', '--no-pager'],
                               capture_output=True, text=True, timeout=10)
            rows = json.loads(r.stdout or '[]') if r.returncode == 0 else []
        except (OSError, ValueError, subprocess.TimeoutExpired):
            rows = []
        for t in rows:
            unit = t.get('unit') or ''
            if not unit:
                continue
            essential = scope == 'system' or is_essential_unit(unit)
            out.append({'id': scope + ':' + unit, 'unit': unit, 'scope': scope, 'runs': t.get('activates') or '',
                        'next': _usec_when(t.get('next')), 'last': _usec_when(t.get('last')),
                        'hearth': unit.startswith(('hearth', 'nimbus')), 'canChange': not essential})
    # Last result (1.12, mockup tm-8): how the job it runs ended last time
    for scope in ('user', 'system'):
        units = [x['runs'] for x in out if x['scope'] == scope and x['runs'].endswith('.service')]
        if not units:
            continue
        try:
            info = parse_show(subprocess.run(['systemctl'] + (['--user'] if scope == 'user' else []) + ['show', '-p', 'Id', '-p', 'Result', '-p', 'Description'] + units,
                                             capture_output=True, text=True, timeout=10).stdout)
        except (OSError, subprocess.TimeoutExpired):
            info = {}
        for x in out:
            i = info.get(x['runs']) if x['scope'] == scope else None
            if i:
                x['result'] = 'OK' if i.get('Result') == 'success' else (i.get('Result') or '').replace('exit-code', 'Failed')
                x['desc'] = i.get('Description') or ''
    out.sort(key=lambda x: (x['scope'] != 'user', x['unit']))
    return {'timers': out}


def set_timer(unit, on):
    """A scheduled task of yours on or off (never the system's, never one that keeps Hearth running)."""
    if not re.match(r'^[\w@.-]+\.timer$', unit) or is_essential_unit(unit):
        raise Fail("that one keeps Hearth running, so it can't be changed here")
    systemctl('--user', 'enable' if on else 'disable', '--now', unit, timeout=15)
    return {'unit': unit, 'on': on}


def user_list(root=PROC):
    """Users (1.11): everyone signed in, and how much CPU and memory their programs use."""
    import pwd
    procs = scan(root)
    st = load_state('users') or {}
    cur_total = cpu_total(root)[0][1]
    per = {}
    for p in procs.values():
        if p.kthread or p.uid is None or p.uid < 1000:
            continue
        u = per.setdefault(p.uid, {'mem': 0, 'jiffies': 0, 'procs': 0})
        u['mem'] += p.mem
        u['jiffies'] += p.jiffies
        u['procs'] += 1
    prev = st.get('per', {})
    dt = cur_total - st.get('total', cur_total)
    sessions = {}
    try:
        r = subprocess.run(['loginctl', 'list-sessions', '--no-legend'], capture_output=True, text=True, timeout=5)
        for line in r.stdout.splitlines():
            f = line.split()
            if len(f) >= 3 and f[1].isdigit():
                sessions.setdefault(int(f[1]), []).append(f[0])
    except (OSError, subprocess.TimeoutExpired):
        pass
    out = []
    for uid, u in sorted(per.items()):
        try:
            pw = pwd.getpwuid(uid)
            name, full = pw.pw_name, (pw.pw_gecos or '').split(',')[0]
        except KeyError:
            name, full = str(uid), ''
        pj = prev.get(str(uid))
        cpu = round(100.0 * max(0, u['jiffies'] - pj) / dt, 1) if pj is not None and dt > 0 else 0.0
        out.append({'uid': uid, 'name': name, 'full': full, 'you': uid == os.getuid(), 'signedIn': uid in sessions,
                    'sessions': len(sessions.get(uid, [])), 'cpu': cpu, 'mem': u['mem'], 'procs': u['procs']})
    save_state('users', {'total': cur_total, 'per': {str(k): v['jiffies'] for k, v in per.items()}})
    return {'users': out}


def signal_one(pid, sig, root=PROC):
    """Ends one process (Details' End task), yours only, never a part of Hearth."""
    procs = scan(root)
    p = procs.get(pid)
    if not p:
        raise Fail('that process has already ended')
    if p.uid != os.getuid():
        raise Fail("that belongs to another user, so it can't be ended here")
    guarded = set(ancestors(procs, os.getpid()))
    why = protected_reason(p, guarded)
    if why:
        raise Fail("%s keeps Hearth running, so it can't be ended here" % why)
    try:
        os.kill(pid, sig)
    except ProcessLookupError:
        raise Fail('that process has already ended')
    except PermissionError:
        raise Fail('not allowed to end process %d' % pid)
    return {'pid': pid, 'signal': 'kill' if sig == signal.SIGKILL else 'term'}


def parse_list_units(text):
    """`systemctl list-units --plain --no-legend`: [{unit, load, active, sub, desc}]."""
    out = []
    for line in (text or '').splitlines():
        f = line.split(None, 4)
        if len(f) >= 4 and f[0].endswith('.service'):
            out.append({'unit': f[0], 'load': f[1], 'active': f[2], 'sub': f[3], 'desc': f[4].strip() if len(f) > 4 else ''})
    return out


def run_systemctl(scope_user, *args, timeout=15):
    if not shutil.which('systemctl'):
        raise Fail('systemctl is missing')
    cmdl = ['systemctl'] + (['--user'] if scope_user else []) + ['--no-pager', *args]
    return subprocess.run(cmdl, capture_output=True, text=True, timeout=timeout)


def service_list():
    """Your services (start / stop unless they keep Hearth running) and the system's (read only)."""
    out = []
    for user in (True, False):
        try:
            units = parse_list_units(run_systemctl(user, 'list-units', '--type=service', '--all', '--plain', '--no-legend').stdout)
            files = parse_unit_files(run_systemctl(user, 'list-unit-files', '--type=service', '--plain', '--no-legend').stdout)
        except (Fail, OSError, subprocess.TimeoutExpired):
            continue
        active = [u['unit'] for u in units if u['active'] == 'active']
        pids = {}
        if active:
            try:
                info = parse_show(run_systemctl(user, 'show', '-p', 'Id', '-p', 'MainPID', *active).stdout)
                pids = {k: int(v.get('MainPID') or 0) for k, v in info.items()}
            except (Fail, OSError, subprocess.TimeoutExpired, ValueError):
                pass
        seen = set()
        for u in units:
            if u['load'] == 'not-found':
                continue
            seen.add(u['unit'])
            essential = is_essential_unit(u['unit'])
            out.append({'id': ('user:' if user else 'system:') + u['unit'], 'unit': u['unit'], 'name': u['unit'][:-8],
                        'desc': plain_service(u['unit'], u['desc']), 'starts': starts_label(files.get(u['unit'], '')), 'status': 'Running' if u['active'] == 'active' else 'Failed' if u['active'] == 'failed' else 'Stopped',
                        'pid': pids.get(u['unit']) or None, 'startup': files.get(u['unit'], ''), 'group': 'Yours' if user else 'System',
                        'canChange': user and not essential, 'hearth': essential and bool(re.match(r'(nimbus|hearth)', u['unit']))})
        for unit, state in files.items():
            if unit in seen or unit.endswith('@.service') or state in ('masked', 'alias'):
                continue
            out.append({'id': ('user:' if user else 'system:') + unit, 'unit': unit, 'name': unit[:-8], 'desc': plain_service(unit, ''),
                        'starts': starts_label(state),
                        'status': 'Stopped', 'pid': None, 'startup': state, 'group': 'Yours' if user else 'System',
                        'canChange': user and not is_essential_unit(unit), 'hearth': bool(re.match(r'(nimbus|hearth)', unit))})
    out.sort(key=lambda s: (s['group'] != 'Yours', s['name'].lower()))
    return {'services': out}


