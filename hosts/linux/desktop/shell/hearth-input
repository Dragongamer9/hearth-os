HERE = os.path.dirname(os.path.realpath(__file__))
TABLES_FILE = os.path.join(HERE, 'input-layouts.json')
KEYMAP_FILE = os.path.join(HERE, 'osk-keymap.json')

HEARTBEAT = 5.0         # s without a state from Hearth before everything is let go
GUIDE_SUSPEND = 1.5     # s the controller stays released after Guide (Quick Access is opening)
GUIDE_CHORD = 0.35      # s Guide is held over a layout before it counts as Guide alone (X before then: the keyboard)
TYPE_HOLD = 0.03        # s each typed key stays down (games that look once a frame miss shorter presses)
TYPE_GAP = 0.015        # s between typed keys
TYPE_MAX = 2000         # characters in one type command
PULSE = 0.06            # s a tap holds its key (games that look once a frame miss a press-and-release)
SCROLL_REPEAT = (0.35, 0.09)   # a held scroll button: first repeat after, then every
MOUSE_SPEED = 1800.0    # px/s with the stick fully over, sensitivity 1
SCROLL_SPEED = 10.0     # wheel notches/s with the stick fully over, sensitivity 1
GYRO_SCALE = 12.0       # px per degree turned, sensitivity 1
TRIGGER_HYST = 0.05
STICK_HYST = 0.8        # a stick direction lets go below threshold x this
DIAG = math.sin(math.radians(22.5))   # 8 equal sectors
MAX_LINE = 256 * 1024
MAX_CLIENTS = 6
TEST_MAX = 60


# ---------------------------------------------------------------------- tables

def load_tables(path=TABLES_FILE):
    with open(path, encoding='utf-8') as f:
        t = json.load(f)
    keys = {}
    for g in t['keys']:
        for name, label in g['keys']:
            keys[name] = label
    t['key_labels'] = keys
    t['button_ids'] = [b[0] for b in t['buttons']]
    t['button_labels'] = dict(t['buttons'])
    t['stick_ids'] = [s[0] for s in t['sticks']]
    t['mouse_labels'] = dict(t['mouse'])
    t['scroll_labels'] = dict(t['scroll'])
    t['template_map'] = {x['id']: x for x in t['templates']}
    return t


TABLES = load_tables()
LIM = TABLES['limits']
BUTTONS = TABLES['button_ids']
STICKS = TABLES['stick_ids']
TRIGGERS = ('lt', 'rt')
DPAD = ('up', 'down', 'left', 'right')
MOUSE_CODES = {'left': 'BTN_LEFT', 'right': 'BTN_RIGHT', 'middle': 'BTN_MIDDLE', 'back': 'BTN_SIDE', 'forward': 'BTN_EXTRA'}
SCROLL_DIRS = {'up': (120, 0), 'down': (-120, 0), 'left': (0, -120), 'right': (0, 120)}   # (v, h) in 1/120 notches
ALL_KEY_CODES = ['KEY_' + k for k in TABLES['key_labels']]


# ---------------------------------------------------------------------- typing (the on-screen keyboard over a game)

def load_keymap(path=KEYMAP_FILE):
    try:
        with open(path, encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return {'letters': 'abcdefghijklmnopqrstuvwxyz', 'layouts': {'us': {}}}


KEYMAP = load_keymap()
TYPE_SPECIAL = {'space': 'KEY_SPACE', 'bksp': 'KEY_BACKSPACE', 'tab': 'KEY_TAB', 'enter': 'KEY_ENTER', 'esc': 'KEY_ESC',
                'up': 'KEY_UP', 'down': 'KEY_DOWN', 'left': 'KEY_LEFT', 'right': 'KEY_RIGHT', 'home': 'KEY_HOME',
                'end': 'KEY_END', 'delete': 'KEY_DELETE'}
TYPE_MODS = {'ctrl': 'KEY_LEFTCTRL', 'alt': 'KEY_LEFTALT', 'shift': 'KEY_LEFTSHIFT', 'altgr': 'KEY_RIGHTALT'}
LAYOUT_RE = re.compile(r'^[a-z]{2,3}$')
DISPLAY_RE = re.compile(r'^:[0-9]{1,3}(\.[0-9])?$')


def keymap_layout(name):
    """The table for an XKB layout name ("de", "fr,us", "de(nodeadkeys)" → its first layout), US if unknown."""
    name = (name or 'us').split(',')[0].split('(')[0].strip().lower()
    layouts = KEYMAP.get('layouts', {})
    t = layouts.get(name) if LAYOUT_RE.match(name) else None
    if t is None:
        return 'us', layouts.get('us', {})
    if '_same' in t:
        return name, layouts.get(t['_same'], {})
    return name, t


def char_keys(ch, layout='us'):
    """The keys that type one character on this layout (modifiers first), or None if it can't be typed."""
    _, table = keymap_layout(layout)
    special = {' ': 'KEY_SPACE', '\n': 'KEY_ENTER', '\t': 'KEY_TAB'}
    if ch in special:
        return [special[ch]]
    spec, shift = table.get(ch), False
    if spec is None:
        low = ch.lower()
        if len(low) == 1 and low in KEYMAP.get('letters', ''):   # a-z, where this layout has them (A on AZERTY)
            spec, shift = table.get(low, low.upper()), low != ch
        else:
            return None
        if shift and '+' in spec:                         # the capital of a shifted or AltGr character
            return None
    parts = spec.split('+')
    return (['KEY_LEFTSHIFT'] if shift else []) + [TYPE_MODS[m] for m in parts[:-1]] + ['KEY_' + parts[-1]]


def keymap_codes():
    """Every key the keymap can press (the virtual keyboard must have them all)."""
    out = set(TYPE_SPECIAL.values()) | set(TYPE_MODS.values()) | {'KEY_' + c.upper() for c in KEYMAP.get('letters', '')}
    for t in KEYMAP.get('layouts', {}).values():
        for k, spec in t.items():
            if not k.startswith('_') and isinstance(spec, str):
                out.add('KEY_' + spec.split('+')[-1])
    return out


# ---------------------------------------------------------------------- layouts
#
# A layout (version 2; version 1 files are migrated, see migrate_v1):
#   {"version": 2, "name", "base",
#    "buttons": {control: binding}, "sticks": {"ls"|"rs": stick}, "gyro": {...}      the default action set
#    "sets":   [{"id", "name", "buttons", "sticks", "gyro"?}]                          more action sets (set:<id>)
#    "layers": [{"id", "name", "buttons", "sticks"}]                                   on top of the set while
#                                                                                       held (layer:<id>, a mode
#                                                                                       shift) or toggled on
#    "radial": [action], "hold_ms", "double_ms", "turbo_hz"}
# A binding is an action ("key:SPACE") or {"press", "hold" (long press), "double", "release", "chords": [{"with",
# "do", "turbo"?}], "turbo", "hold_turbo", "double_turbo", "toggle", "threshold" (triggers)}.
# Sticks: none, keys (8 ways), dpad (4 ways), mouse, scroll, wheel (turn it round to scroll), flick (flick stick).
# Gyro: when "button" (gyro:toggle / gyro:hold / gyro:ratchet buttons, or on from the start), "always" or "stick"
# (while the right stick is touched / moved), turning from "yaw" or "roll".

class LayoutError(ValueError):
    pass


class Action:
    """One thing a control does. kind: none | keys | mouse | scroll | gyro | radial | layer | layer_toggle | set."""
    __slots__ = ('kind', 'codes', 'arg', 'raw')

    def __init__(self, kind, codes=(), arg=None, raw='none'):
        self.kind, self.codes, self.arg, self.raw = kind, tuple(codes), arg, raw

    def __eq__(self, o):
        return isinstance(o, Action) and o.raw == self.raw

    def __hash__(self):
        return hash(self.raw)

    def __repr__(self):
        return 'Action(%r)' % self.raw

    @property
    def label(self):
        return action_label(self.raw)


NONE = Action('none')
SIMPLE = {'none', 'keys', 'mouse', 'scroll'}
# Where an action may be used: a set's buttons take everything; a layer's buttons not another held layer or the
# radial menu; long / double / release presses, chords, stick directions and radial items only press keys, click or
# scroll.
ALLOW = {
    'button': SIMPLE | {'gyro', 'radial', 'layer', 'layer_toggle', 'set'},
    'layer_button': SIMPLE | {'gyro', 'layer_toggle', 'set'},
    'simple': SIMPLE,
    'radial': {'keys', 'mouse', 'scroll'},
}
ID_RE = re.compile(r'^[a-z0-9_]{1,20}$')
STICK_FIELDS = {
    'none': set(),
    'keys': {'up', 'down', 'left', 'right', 'threshold'},
    'dpad': {'up', 'down', 'left', 'right', 'threshold'},
    'mouse': {'sensitivity', 'deadzone', 'outer', 'curve', 'invert_x', 'invert_y'},
    'scroll': {'sensitivity', 'deadzone'},
    'wheel': {'sensitivity', 'threshold'},
    'flick': {'turn', 'threshold'},
}
GYRO_FIELDS = {'sensitivity', 'deadzone', 'invert_x', 'invert_y', 'start_on', 'when', 'axis'}
GYRO_WHEN = ('button', 'always', 'stick')
GYRO_AXIS = ('yaw', 'roll')
BUTTON_FIELDS = {'press', 'hold', 'double', 'release', 'chords', 'turbo', 'hold_turbo', 'double_turbo', 'toggle'}
TOP_FIELDS = {'version', 'name', 'base', 'buttons', 'sticks', 'gyro', 'sets', 'layers', 'radial', 'hold_ms',
              'double_ms', 'turbo_hz'}
V1_FIELDS = {'version', 'name', 'base', 'buttons', 'sticks', 'gyro', 'shift', 'radial', 'hold_ms', 'double_ms', 'turbo_hz'}


def parse_action(s, where, path, ids=None):
    """An action string → Action, if it's allowed here. ids: {'layers': set, 'sets': set} it may name."""
    if not isinstance(s, str) or not s or len(s) > 80:
        raise LayoutError('%s: should be an action like "key:SPACE"' % path)
    ids = ids or {'layers': set(), 'sets': set()}
    if s == 'none':
        a = NONE
    elif s == 'radial':
        a = Action('radial', raw=s)
    elif s in ('gyro:toggle', 'gyro:hold', 'gyro:ratchet'):
        a = Action('gyro', arg=s.split(':')[1], raw=s)
    elif s.startswith('key:'):
        names = s[4:].split('+')
        if not 1 <= len(names) <= LIM['combo_keys']:
            raise LayoutError('%s: a key combination has 1 to %d keys' % (path, LIM['combo_keys']))
        if len(set(names)) != len(names):
            raise LayoutError('%s: the same key twice' % path)
        for n in names:
            if n not in TABLES['key_labels']:
                raise LayoutError('%s: unknown key %r' % (path, n[:20]))
        a = Action('keys', ['KEY_' + n for n in names], raw=s)
    elif s.startswith('mouse:') and s[6:] in MOUSE_CODES:
        a = Action('mouse', [MOUSE_CODES[s[6:]]], raw=s)
    elif s.startswith('scroll:') and s[7:] in SCROLL_DIRS:
        a = Action('scroll', arg=SCROLL_DIRS[s[7:]], raw=s)
    elif s.startswith('layer:') or s.startswith('layer_toggle:'):
        kind, _, lid = s.partition(':')
        if lid not in ids['layers']:
            raise LayoutError('%s: there\'s no layer %r' % (path, lid[:20]))
        a = Action(kind, arg=lid, raw=s)
    elif s.startswith('set:'):
        sid = s[4:]
        if sid != 'default' and sid not in ids['sets']:
            raise LayoutError('%s: there\'s no action set %r' % (path, sid[:20]))
        a = Action('set', arg=sid, raw=s)
    else:
        raise LayoutError('%s: unknown action %r' % (path, s[:30]))
    if a.kind not in ALLOW[where]:
        raise LayoutError('%s: %r can\'t be used here' % (path, s))
    return a


def action_label(raw):
    if raw == 'none':
        return 'Nothing'
    if raw == 'radial':
        return 'Radial menu'
    if raw == 'gyro:toggle':
        return 'Gyro aiming on/off'
    if raw == 'gyro:hold':
        return 'Gyro aiming (hold)'
    if raw == 'gyro:ratchet':
        return 'Gyro off while held (ratchet)'
    if raw.startswith('key:'):
        return ' + '.join(TABLES['key_labels'].get(k, k) for k in raw[4:].split('+'))
    if raw.startswith('mouse:'):
        return TABLES['mouse_labels'].get(raw[6:], raw)
    if raw.startswith('scroll:'):
        return TABLES['scroll_labels'].get(raw[7:], raw)
    if raw.startswith('layer:'):
        return 'Layer %s (hold)' % raw[6:]
    if raw.startswith('layer_toggle:'):
        return 'Layer %s on/off' % raw[13:]
    if raw.startswith('set:'):
        return 'Action set %s' % raw[4:]
    return raw


def _num(v, lim, path, integer=False):
    lo, hi = LIM[lim]
    if isinstance(v, bool) or not isinstance(v, (int, float)) or not math.isfinite(v):
        raise LayoutError('%s: should be a number' % path)
    if integer and int(v) != v:
        raise LayoutError('%s: should be a whole number' % path)
    if not lo <= v <= hi:
        raise LayoutError('%s: should be between %s and %s' % (path, lo, hi))
    return int(v) if integer else float(v)


def _bool(v, path):
    if not isinstance(v, bool):
        raise LayoutError('%s: should be true or false' % path)
    return v


def _obj(v, path, allowed):
    if not isinstance(v, dict):
        raise LayoutError('%s: should be an object' % path)
    for k in v:
        if k not in allowed:
            raise LayoutError('%s: unknown setting %r' % (path, str(k)[:30]))
    return v


def _name(v, path, default):
    v = default if v is None else v
    if not isinstance(v, str) or not v.strip() or len(v) > LIM['name_len'] or any(ord(c) < 32 for c in v):
        raise LayoutError('%s: up to %d characters' % (path, LIM['name_len']))
    return v


def empty_button():
    return {'press': NONE, 'hold': None, 'double': None, 'release': None, 'chords': [], 'turbo': False,
            'hold_turbo': False, 'double_turbo': False, 'toggle': False, 'threshold': 0.5}


def _button(ctl, v, where, path, ids):
    if isinstance(v, str):
        v = {'press': v}
    _obj(v, path, BUTTON_FIELDS | ({'threshold'} if ctl in TRIGGERS else set()))
    b = empty_button()
    b['press'] = parse_action(v.get('press', 'none'), where, path + '.press', ids)
    for k in ('hold', 'double', 'release'):
        if v.get(k) is not None:
            b[k] = parse_action(v[k], 'simple', '%s.%s' % (path, k), ids)
    chords = v.get('chords', [])
    if not isinstance(chords, list) or len(chords) > LIM['chords']:
        raise LayoutError('%s.chords: up to %d' % (path, LIM['chords']))
    seen = set()
    for i, c in enumerate(chords):
        cp = '%s.chords.%d' % (path, i)
        _obj(c, cp, {'with', 'do', 'turbo'})
        w = c.get('with')
        if w not in BUTTONS or w == ctl or w in seen:
            raise LayoutError('%s.with: another button (once each)' % cp)
        seen.add(w)
        act = parse_action(c.get('do', 'none'), 'simple', cp + '.do', ids)
        turbo = _bool(c.get('turbo', False), cp + '.turbo')
        if turbo and act.kind not in ('keys', 'mouse'):
            raise LayoutError('%s: turbo repeats a key or a click' % cp)
        b['chords'].append((w, act, turbo))
    for k in ('turbo', 'hold_turbo', 'double_turbo', 'toggle'):
        if k in v:
            b[k] = _bool(v[k], '%s.%s' % (path, k))
    extra = b['hold'] or b['double'] or b['release'] or b['chords'] or b['turbo'] or b['toggle']
    if extra and b['press'].kind not in SIMPLE:
        raise LayoutError('%s: tap and hold, double presses, chords, turbo and toggle work with keys, clicks and scrolling' % path)
    if b['turbo'] and (b['hold'] or b['toggle'] or b['press'].kind not in ('keys', 'mouse')):
        raise LayoutError('%s: turbo repeats a key or a click (and can\'t be used with hold or toggle)' % path)
    if b['toggle'] and (b['hold'] or b['double'] or b['press'].kind not in ('keys', 'mouse')):
        raise LayoutError('%s: toggle holds a key or a click (and can\'t be used with hold or a double press)' % path)
    for k, t in (('hold', 'hold_turbo'), ('double', 'double_turbo')):
        if b[t] and (b[k] is None or b[k].kind not in ('keys', 'mouse')):
            raise LayoutError('%s.%s: turbo repeats a key or a click' % (path, t))
    if 'threshold' in v:
        b['threshold'] = _num(v['threshold'], 'threshold', path + '.threshold')
    return b


def _stick(v, path, ids):
    if not isinstance(v, dict) or v.get('mode') not in STICK_FIELDS:
        raise LayoutError('%s: needs a mode: %s' % (path, ', '.join(STICK_FIELDS)))
    mode = v['mode']
    _obj(v, path, STICK_FIELDS[mode] | {'mode'})
    s = {'mode': mode}
    if mode in ('keys', 'dpad'):
        for d in DPAD:
            s[d] = parse_action(v[d], 'simple', '%s.%s' % (path, d), ids) if d in v else NONE
        s['threshold'] = _num(v.get('threshold', 0.5), 'stick_threshold', path + '.threshold')
    elif mode in ('mouse', 'scroll'):
        s['sensitivity'] = _num(v.get('sensitivity', 1.0), 'sensitivity', path + '.sensitivity')
        s['deadzone'] = _num(v.get('deadzone', 0.12), 'deadzone', path + '.deadzone')
        if mode == 'mouse':
            s['outer'] = _num(v.get('outer', 0.95), 'outer', path + '.outer')
            s['curve'] = _num(v.get('curve', 1.8), 'curve', path + '.curve')
            s['invert_x'] = _bool(v.get('invert_x', False), path + '.invert_x')
            s['invert_y'] = _bool(v.get('invert_y', False), path + '.invert_y')
            if s['outer'] < s['deadzone'] + 0.1:
                raise LayoutError('%s: the outer dead zone must be well past the dead zone' % path)
    elif mode == 'wheel':
        s['sensitivity'] = _num(v.get('sensitivity', 1.0), 'sensitivity', path + '.sensitivity')
        s['threshold'] = _num(v.get('threshold', 0.5), 'stick_threshold', path + '.threshold')
    elif mode == 'flick':
        s['turn'] = _num(v.get('turn', 3600), 'turn_px', path + '.turn', integer=True)
        s['threshold'] = _num(v.get('threshold', 0.7), 'stick_threshold', path + '.threshold')
    return s


def _gyro(g, path):
    g = _obj(g, path, GYRO_FIELDS)
    when, axis = g.get('when', 'button'), g.get('axis', 'yaw')
    if when not in GYRO_WHEN:
        raise LayoutError('%s.when: one of %s' % (path, ', '.join(GYRO_WHEN)))
    if axis not in GYRO_AXIS:
        raise LayoutError('%s.axis: one of %s' % (path, ', '.join(GYRO_AXIS)))
    return {'sensitivity': _num(g.get('sensitivity', 1.0), 'gyro_sensitivity', path + '.sensitivity'),
            'deadzone': _num(g.get('deadzone', 1.0), 'gyro_deadzone', path + '.deadzone'),
            'invert_x': _bool(g.get('invert_x', False), path + '.invert_x'),
            'invert_y': _bool(g.get('invert_y', False), path + '.invert_y'),
            'start_on': _bool(g.get('start_on', False), path + '.start_on'),
            'when': when, 'axis': axis}


def _controls(o, path, where, ids, full):
    """A set's or layer's buttons and sticks. full: every control (unmapped ones do nothing); else only those given."""
    pre = path + '.' if path else ''
    out = {'buttons': {}, 'sticks': {}}
    buttons = _obj(o.get('buttons', {}), pre + 'buttons', set(BUTTONS))
    for ctl in BUTTONS:
        if ctl in buttons:
            out['buttons'][ctl] = _button(ctl, buttons[ctl], where, '%sbuttons.%s' % (pre, ctl), ids)
        elif full:
            out['buttons'][ctl] = empty_button()
    sticks = _obj(o.get('sticks', {}), pre + 'sticks', set(STICKS))
    for s in STICKS:
        if s in sticks:
            out['sticks'][s] = _stick(sticks[s], '%ssticks.%s' % (pre, s), ids)
        elif full:
            out['sticks'][s] = {'mode': 'none'}
    return out


def uses_v1_shift(obj):
    buttons = obj.get('buttons')
    return 'shift' in obj or (isinstance(buttons, dict) and any(
        v == 'shift' or (isinstance(v, dict) and v.get('press') == 'shift') for v in buttons.values()))


def migrate_v1(obj):
    """A version 1 layout → version 2. The second set ("shift", used by buttons set to "shift") becomes the layer
    "shift" (held by those buttons: "layer:shift"). Everything else is the same."""
    _obj(obj, 'layout', V1_FIELDS)
    n = {k: obj[k] for k in ('name', 'base', 'buttons', 'sticks', 'gyro', 'radial', 'hold_ms', 'double_ms', 'turbo_hz') if k in obj}
    n['version'] = 2

    def conv(buttons):
        if not isinstance(buttons, dict):
            return buttons
        out = {}
        for k, v in buttons.items():
            if v == 'shift':
                v = 'layer:shift'
            elif isinstance(v, dict) and v.get('press') == 'shift':
                v = dict(v, press='layer:shift')
            out[k] = v
        return out
    if 'buttons' in n:
        n['buttons'] = conv(n['buttons'])
    shift = obj.get('shift')
    uses = isinstance(obj.get('buttons'), dict) and any(v == 'shift' or (isinstance(v, dict) and v.get('press') == 'shift')
                                                      for v in obj['buttons'].values())
    if shift is not None or uses:
        shift = _obj(shift if shift is not None else {}, 'shift', {'buttons', 'sticks'})
        layer = {'id': 'shift', 'name': 'Second set'}
        if 'buttons' in shift:
            layer['buttons'] = conv(shift['buttons'])
        if 'sticks' in shift:
            layer['sticks'] = shift['sticks']
        n['layers'] = [layer]
    return n


def _list(v, path, limit):
    if not isinstance(v, list) or len(v) > LIM[limit]:
        raise LayoutError('%s: up to %d' % (path, LIM[limit]))
    return v


def validate_layout(obj):
    """A layout as Hearth stores it (version 1 or 2) → the normalized form the engine runs. Raises LayoutError."""
    if not isinstance(obj, dict):
        raise LayoutError('layout: should be an object')
    version = obj.get('version')
    if version is None:     # files without one: version 1 if they use its second set, else version 2
        version = 1 if uses_v1_shift(obj) else 2
    if version not in (1, 2) or isinstance(version, bool):
        raise LayoutError('layout.version: only versions 1 and 2 are known')
    if version == 1:
        obj = migrate_v1(obj)
    _obj(obj, 'layout', TOP_FIELDS)
    name = _name(obj.get('name'), 'layout.name', 'Custom')
    base = obj.get('base', '')
    if not isinstance(base, str) or (base and base not in TABLES['template_map']):
        raise LayoutError('layout.base: unknown template')
    # Ids first, so actions can name layers and sets anywhere.
    layers_in = _list(obj.get('layers', []), 'layers', 'layers')
    sets_in = _list(obj.get('sets', []), 'sets', 'sets')
    ids = {'layers': set(), 'sets': set()}
    for kind, items in (('layers', layers_in), ('sets', sets_in)):
        for i, it in enumerate(items):
            if not isinstance(it, dict) or not isinstance(it.get('id'), str) or not ID_RE.match(it['id']) or it['id'] == 'default':
                raise LayoutError('%s.%d.id: lower-case letters, digits and _ (not "default")' % (kind, i))
            if it['id'] in ids[kind]:
                raise LayoutError('%s.%d.id: %r twice' % (kind, i, it['id']))
            ids[kind].add(it['id'])
    out = {'version': 2, 'name': name, 'base': base}
    out.update(_controls(obj, '', 'button', ids, True))
    out['gyro'] = _gyro(obj.get('gyro', {}), 'gyro')
    out['sets'], out['set_order'] = {}, []
    for i, it in enumerate(sets_in):
        p = 'sets.%d' % i
        _obj(it, p, {'id', 'name', 'buttons', 'sticks', 'gyro'})
        st = _controls(it, p, 'button', ids, True)
        st['name'] = _name(it.get('name'), p + '.name', it['id'])
        st['gyro'] = _gyro(it['gyro'], p + '.gyro') if 'gyro' in it else None
        out['sets'][it['id']] = st
        out['set_order'].append(it['id'])
    out['layers'], out['layer_order'] = {}, []
    for i, it in enumerate(layers_in):
        p = 'layers.%d' % i
        _obj(it, p, {'id', 'name', 'buttons', 'sticks'})
        ly = _controls(it, p, 'layer_button', ids, False)
        ly['name'] = _name(it.get('name'), p + '.name', it['id'])
        out['layers'][it['id']] = ly
        out['layer_order'].append(it['id'])
    radial = obj.get('radial', [])
    if not isinstance(radial, list) or len(radial) > LIM['radial_items']:
        raise LayoutError('radial: up to %d actions' % LIM['radial_items'])
    out['radial'] = [parse_action(a, 'radial', 'radial.%d' % i, ids) for i, a in enumerate(radial)]
    out['hold_ms'] = _num(obj.get('hold_ms', 300), 'hold_ms', 'hold_ms', integer=True)
    out['double_ms'] = _num(obj.get('double_ms', 250), 'double_ms', 'double_ms', integer=True)
    out['turbo_hz'] = _num(obj.get('turbo_hz', 10), 'turbo_hz', 'turbo_hz')
    return out


def validate_prefs(p):
    """Per-game choices from Quick Access: {sensitivity, gyro}."""
    if p is None:
        return {'sensitivity': 1.0, 'gyro': False}
    _obj(p, 'prefs', {'sensitivity', 'gyro'})
    return {'sensitivity': _num(p.get('sensitivity', 1.0), 'pref_sensitivity', 'prefs.sensitivity'),
            'gyro': _bool(p.get('gyro', False), 'prefs.gyro')}


def all_groups(layout):
    """Every set and layer (their buttons and sticks), the default set first."""
    return [layout] + [layout['sets'][s] for s in layout['set_order']] + [layout['layers'][l] for l in layout['layer_order']]


def uses_gyro(layout):
    for g in all_groups(layout):
        if any(b['press'].kind == 'gyro' for b in g['buttons'].values()):
            return True
    gyros = [layout['gyro']] + [layout['sets'][s]['gyro'] for s in layout['set_order'] if layout['sets'][s]['gyro']]
    return any(g['when'] in ('always', 'stick') for g in gyros)


def dump_layout(lay):
    """The normalized layout back as version 2 JSON (actions as their strings)."""
    def b(ctl, x):
        o = {}
        if x['press'] is not NONE or not any(x[k] for k in ('hold', 'double', 'release', 'chords')):
            o['press'] = x['press'].raw
        for k in ('hold', 'double', 'release'):
            if x[k] is not None:
                o[k] = x[k].raw
        if x['chords']:
            o['chords'] = [dict({'with': w, 'do': a.raw}, **({'turbo': True} if t else {})) for w, a, t in x['chords']]
        for k in ('turbo', 'hold_turbo', 'double_turbo', 'toggle'):
            if x[k]:
                o[k] = True
        if ctl in TRIGGERS:
            o['threshold'] = x['threshold']
        return o['press'] if list(o) == ['press'] else o

    def s(x):
        return {k: (v.raw if isinstance(v, Action) else v) for k, v in x.items()}

    def controls(g):
        return {'buttons': {k: b(k, v) for k, v in g['buttons'].items()}, 'sticks': {k: s(v) for k, v in g['sticks'].items()}}
    out = {'version': 2, 'name': lay['name'], 'base': lay['base']}
    out.update(controls(lay))
    out['gyro'] = dict(lay['gyro'])
    if lay['set_order']:
        out['sets'] = []
        for sid in lay['set_order']:
            st = lay['sets'][sid]
            d = dict({'id': sid, 'name': st['name']}, **controls(st))
            if st['gyro']:
                d['gyro'] = dict(st['gyro'])
            out['sets'].append(d)
    if lay['layer_order']:
        out['layers'] = [dict({'id': lid, 'name': lay['layers'][lid]['name']}, **controls(lay['layers'][lid])) for lid in lay['layer_order']]
    out.update({'radial': [x.raw for x in lay['radial']], 'hold_ms': lay['hold_ms'], 'double_ms': lay['double_ms'],
                'turbo_hz': lay['turbo_hz']})
    return out


# ---------------------------------------------------------------------- the mapping engine (no devices)

def stick_curve(mag, deadzone, outer, exponent):
    """Stick distance from the centre (0..1) → 0..1: nothing in the dead zone, everything past the outer dead
    zone, a curve between (exponent 1 = straight; higher = finer near the centre)."""
    if mag <= deadzone:
        return 0.0
    t = min(1.0, (mag - deadzone) / max(1e-6, outer - deadzone))
    return t ** exponent


def stick_directions(x, y, threshold, held=(), four=False):
    """A stick as up to two of up/down/left/right (8 equal sectors; four: only the strongest, like a d-pad), once
    it's pushed past the threshold. A direction already held lets go only below threshold x STICK_HYST."""
    mag = math.hypot(x, y)
    limit = threshold * STICK_HYST if held else threshold
    if mag < limit or mag == 0:
        return set()
    nx, ny = x / mag, y / mag
    if four:
        if abs(nx) >= abs(ny):
            return {'right' if nx > 0 else 'left'}
        return {'down' if ny > 0 else 'up'}
    out = set()
    if nx > DIAG:
        out.add('right')
    elif nx < -DIAG:
        out.add('left')
    if ny > DIAG:
        out.add('down')
    elif ny < -DIAG:
        out.add('up')
    return out


def radial_index(x, y, n):
    """A direction (y down) → one of n slots, slot 0 straight up, clockwise."""
    ang = math.atan2(x, -y) % (2 * math.pi)
    return int(round(ang / (2 * math.pi / n))) % n


def wrap_angle(a):
    """An angle difference into -pi..pi."""
    return (a + math.pi) % (2 * math.pi) - math.pi


DPAD_VECTORS = {'up': (0, -1), 'right': (1, 0), 'down': (0, 1), 'left': (-1, 0)}
FLICK_TIME = 0.1        # s a flick takes to turn
WHEEL_NOTCHES = 12      # wheel notches for one turn of the stick, sensitivity 1
GYRO_STICK = 0.12       # the right stick past this counts as touched (gyro "stick")


class Engine:
    """Runs one layout. `out` has .key(code, down) (KEY_*/BTN_* names), .move(dx, dy), .wheel(v, h) in 1/120
    notches, and .osd(text). Time is passed in (`now`), so it can be tested without waiting."""

    def __init__(self, out, layout, prefs=None):
        self.out = out
        self.L = layout
        self.prefs = dict(validate_prefs(None), **(prefs or {}))
        self.refs = {}          # output code → sources holding it
        self.src_codes = {}     # source → codes it holds, in press order
        self.held = {}          # button → what its press started
        self.down = set()       # buttons physically down now (chords look here)
        self.ignored = set()    # buttons already down when the layout started: ignored until let go
        self.pulses = []        # (release time, source)
        self.scroll_next = {}   # source → (next repeat time, action)
        self.pending = {}       # button → (time, binding): a short press waiting to see if a second one comes
        self.latched = set()    # buttons whose toggle holds their keys
        self.set_id = 'default'
        self.layers_held = {}   # button → layer id it holds (mode shift)
        self.layers_on = []     # layers toggled on, in order
        self.gyro_on = self.L['gyro']['start_on'] or self.prefs['gyro']
        self.gyro_hold = set()
        self.gyro_block = set()   # gyro:ratchet buttons held
        self.radial = None      # {'by': button, 'sel': -1}
        # The right stick after the radial menu closes: it does nothing until it's back in the middle, so letting go
        # of the button with the stick still pushed (how a radial menu is used) doesn't then move the pointer.
        self.rs_wait_center = False
        self.axes = {'lx': 0.0, 'ly': 0.0, 'rx': 0.0, 'ry': 0.0, 'lt': 0.0, 'rt': 0.0}
        self.trig = {'lt': False, 'rt': False}
        self.stick_held = {}    # (stick, dir) → action
        self.flick = {}         # stick → {'on', 'last', 'left', 'time'}
        self.wheel_last = {}    # stick → last angle
        self.rate = (0.0, 0.0, 0.0)
        self.acc = [0.0, 0.0, 0.0, 0.0]

    # ------------------------------------------------------------------ outputs
    def _down(self, src, codes):
        for c in codes:
            s = self.refs.setdefault(c, set())
            if not s:
                self.out.key(c, True)
            s.add(src)
        self.src_codes.setdefault(src, []).extend(codes)

    def _up(self, src):
        for c in reversed(self.src_codes.pop(src, [])):
            s = self.refs.get(c)
            if s and src in s:
                s.discard(src)
                if not s:
                    self.out.key(c, False)
        self.scroll_next.pop(src, None)

    def _wheel(self, v, h):
        self.out.wheel(v, h)

    def press(self, src, act, now):
        if act.kind in ('keys', 'mouse'):
            self._down(src, act.codes)
        elif act.kind == 'scroll':
            self._wheel(*act.arg)
            self.scroll_next[src] = (now + SCROLL_REPEAT[0], act)

    def tap(self, src, act, now):
        """Press now, let go a moment later (tick does)."""
        self.press(src, act, now)
        self.scroll_next.pop(src, None)
        self.pulses.append((now + PULSE, src))

    def hold(self, src, act, turbo, now):
        """Press and keep it down (repeating with turbo) until _up(src) / the button lets go."""
        self.press(src, act, now)
        if turbo:
            return {'turbo': act, 'on': True, 'next': now + self._turbo_half()}
        return {}

    # ------------------------------------------------------------------ sets and layers
    @property
    def group(self):
        return self.L if self.set_id == 'default' else self.L['sets'][self.set_id]

    def active_layers(self):
        """Layers in force, the one that came last on top."""
        out = list(self.layers_on)
        for lid in self.layers_held.values():
            if lid in out:
                out.remove(lid)
            out.append(lid)
        return out

    @property
    def shifted(self):
        return bool(self.layers_held) or bool(self.layers_on)

    def binding(self, ctl):
        for lid in reversed(self.active_layers()):
            b = self.L['layers'][lid]['buttons'].get(ctl)
            if b is not None:
                return b
        return self.group['buttons'][ctl]

    def stick_binding(self, s):
        for lid in reversed(self.active_layers()):
            st = self.L['layers'][lid]['sticks'].get(s)
            if st is not None:
                return st
        return self.group['sticks'][s]

    def gyro_cfg(self):
        g = self.group.get('gyro') if self.set_id != 'default' else None
        return g or self.L['gyro']

    @property
    def gyro_active(self):
        if self.gyro_block:
            return False
        when = self.gyro_cfg()['when']
        if when == 'always':
            return True
        if when == 'stick':
            return math.hypot(self.axes['rx'], self.axes['ry']) > GYRO_STICK
        return self.gyro_on or bool(self.gyro_hold)

    def _switch_set(self, sid):
        if sid == self.set_id:
            return
        self.set_id = sid
        self.layers_on = []
        name = 'Default' if sid == 'default' else self.L['sets'][sid]['name']
        self.out.osd('Action set: ' + name)

    # ------------------------------------------------------------------ input
    def button(self, name, down, now):
        if down:
            self.down.add(name)
        else:
            self.down.discard(name)
        if down:
            if name in self.ignored or name in self.held:
                return
            if self.radial and name in DPAD:
                self._radial_pick(*DPAD_VECTORS[name])
                self.held[name] = {'kind': 'radialnav'}
                return
            b = self.binding(name)
            act = b['press']
            if act.kind == 'layer':
                self.layers_held[name] = act.arg
                self.held[name] = {'kind': 'layer'}
            elif act.kind == 'layer_toggle':
                if act.arg in self.layers_on:
                    self.layers_on.remove(act.arg)
                else:
                    self.layers_on.append(act.arg)
                self.out.osd('%s %s' % (self.L['layers'][act.arg]['name'], 'on' if act.arg in self.layers_on else 'off'))
                self.held[name] = {'kind': 'none'}
            elif act.kind == 'set':
                self._switch_set(act.arg)
                self.held[name] = {'kind': 'none'}
            elif act.kind == 'gyro':
                if act.arg == 'toggle':
                    self.gyro_on = not self.gyro_on
                    self.out.osd('Gyro aiming ' + ('on' if self.gyro_active else 'off'))
                elif act.arg == 'hold':
                    self.gyro_hold.add(name)
                else:
                    self.gyro_block.add(name)
                self.held[name] = {'kind': 'gyro'}
            elif act.kind == 'radial':
                self.held[name] = {'kind': 'radial'}
                if self.L['radial'] and not self.radial:
                    self.radial = {'by': name, 'sel': -1}
                    self._release_stick('rs')
                    self.out.osd('Radial menu: ' + ' · '.join(a.label for a in self.L['radial']))
            else:
                self._press_binding(name, b, now)
            return
        if name in self.ignored:
            self.ignored.discard(name)
            return
        h = self.held.pop(name, None)
        if not h:
            return
        k = h['kind']
        if k == 'layer':
            self.layers_held.pop(name, None)
        elif k == 'gyro':
            self.gyro_hold.discard(name)
            self.gyro_block.discard(name)
        elif k == 'radial':
            r = self.radial
            if r and r['by'] == name:
                self.radial = None
                self.rs_wait_center = True
                if r['sel'] >= 0:
                    act = self.L['radial'][r['sel']]
                    self.tap('radial', act, now)
                    self.out.osd(act.label)
        elif k == 'act':
            self._release_binding(name, h, now)

    def _press_binding(self, name, b, now):
        """A press of a button that sends keys, clicks or scrolling: its chord, double, long or plain press."""
        for w, act, turbo in b['chords']:
            if w in self.down:
                self.held[name] = dict(self.hold(name + '#chord', act, turbo, now), kind='act', phase='chord', b=b, src=name + '#chord')
                return
        pend = self.pending.pop(name, None)
        if b['double'] is not None and pend and now - pend[0] <= self.L['double_ms'] / 1000.0:
            self.held[name] = dict(self.hold(name + '#double', b['double'], b['double_turbo'], now), kind='act', phase='double', b=b, src=name + '#double')
            return
        if pend:      # a waiting single press from before: it was a single press after all
            self.tap(name + '#tap', pend[1]['press'], now)
        if b['toggle']:
            if name in self.latched:
                self.latched.discard(name)
                self._up(name + '#latch')
            else:
                self.latched.add(name)
                self.press(name + '#latch', b['press'], now)
            self.held[name] = {'kind': 'act', 'phase': 'none', 'b': b}
            return
        if b['hold'] is not None or b['double'] is not None:
            self.held[name] = {'kind': 'act', 'phase': 'wait', 't': now, 'b': b}
            return
        self.held[name] = dict(self.hold(name, b['press'], b['turbo'], now), kind='act', phase='press', b=b, src=name)

    def _release_binding(self, name, h, now):
        b, phase = h['b'], h['phase']
        if phase == 'wait':
            if b['double'] is not None:
                self.pending[name] = (now, b)      # tick taps it if no second press comes in time
            else:
                self.tap(name + '#tap', b['press'], now)
        elif phase in ('press', 'long', 'double', 'chord'):
            self._up(h['src'])
        if b['release'] is not None and phase in ('press', 'wait'):
            self.tap(name + '#release', b['release'], now)

    def _turbo_half(self):
        return 0.5 / self.L['turbo_hz']

    def _radial_pick(self, x, y):
        r = self.radial
        sel = radial_index(x, y, len(self.L['radial']))
        if sel != r['sel']:
            r['sel'] = sel
            self.out.osd('Radial menu: ' + self.L['radial'][sel].label)

    def set_axes(self, now, lx=0.0, ly=0.0, rx=0.0, ry=0.0, lt=0.0, rt=0.0):
        self.axes.update(lx=lx, ly=ly, rx=rx, ry=ry, lt=lt, rt=rt)
        for t in TRIGGERS:
            thr = self.binding(t)['threshold']
            v = self.axes[t]
            pressed = v > thr - TRIGGER_HYST if self.trig[t] else v >= thr
            if pressed != self.trig[t]:
                self.trig[t] = pressed
                self.button(t, pressed, now)

    def gyro(self, gx, gy, gz):
        """Turning speed in degrees per second around the controller's x, y and z axes."""
        self.rate = (gx, gy, gz)

    def _release_stick(self, s):
        for key in [k for k in self.stick_held if k[0] == s]:
            self._up('%s:%s' % key)
            del self.stick_held[key]

    def tick(self, now, dt):
        for t, src in [p for p in self.pulses if p[0] <= now]:
            self.pulses.remove((t, src))
            self._up(src)
        for name, (t, b) in list(self.pending.items()):
            if now - t > self.L['double_ms'] / 1000.0:
                del self.pending[name]
                self.tap(name + '#tap', b['press'], now)
        for name, h in list(self.held.items()):
            if h.get('phase') == 'wait':
                b, waited = h['b'], now - h['t']
                if b['hold'] is not None and waited >= self.L['hold_ms'] / 1000.0:
                    h.update(self.hold(name + '#hold', b['hold'], b['hold_turbo'], now), phase='long', src=name + '#hold')
                elif b['hold'] is None and waited > self.L['double_ms'] / 1000.0:
                    h.update(self.hold(name, b['press'], b['turbo'], now), phase='press', src=name)
            elif 'turbo' in h and now >= h['next']:
                h['on'] = not h['on']
                h['next'] = now + self._turbo_half()
                if h['on']:
                    self.press(h['src'], h['turbo'], now)
                else:
                    self._up(h['src'])
        for src, (t, act) in list(self.scroll_next.items()):
            if now >= t:
                self._wheel(*act.arg)
                self.scroll_next[src] = (now + SCROLL_REPEAT[1], act)

        sens = self.prefs['sensitivity']
        for s, (x, y) in (('ls', (self.axes['lx'], self.axes['ly'])), ('rs', (self.axes['rx'], self.axes['ry']))):
            if self.radial and s == 'rs':
                if math.hypot(x, y) > 0.5:
                    self._radial_pick(x, y)
                continue
            if s == 'rs' and self.rs_wait_center:
                if math.hypot(x, y) > 0.25:
                    continue
                self.rs_wait_center = False
            b = self.stick_binding(s)
            mode = b['mode']
            if mode not in ('keys', 'dpad'):
                self._release_stick(s)
            if mode != 'flick':
                self.flick.pop(s, None)
            if mode != 'wheel':
                self.wheel_last.pop(s, None)
            mag = math.hypot(x, y)
            if mode in ('keys', 'dpad'):
                held_dirs = {d for (st, d) in self.stick_held if st == s}
                want = stick_directions(x, y, b['threshold'], held_dirs, four=mode == 'dpad')
                for d in DPAD:
                    act = b[d] if d in want else None
                    cur = self.stick_held.get((s, d))
                    if cur is not None and cur != act:
                        self._up('%s:%s' % (s, d))
                        del self.stick_held[(s, d)]
                        cur = None
                    if act is not None and cur is None:
                        self.stick_held[(s, d)] = act
                        self.press('%s:%s' % (s, d), act, now)
            elif mode == 'mouse':
                f = stick_curve(mag, b['deadzone'], b['outer'], b['curve'])
                if f > 0:
                    speed = MOUSE_SPEED * b['sensitivity'] * sens * f * dt
                    self.acc[0] += x / mag * speed * (-1 if b['invert_x'] else 1)
                    self.acc[1] += (y / mag) * speed * (-1 if b['invert_y'] else 1)
            elif mode == 'scroll':
                f = stick_curve(mag, b['deadzone'], 1.0, 1.5)
                if f > 0:
                    rate = SCROLL_SPEED * 120 * b['sensitivity'] * f * dt
                    self.acc[2] += -y / mag * rate
                    self.acc[3] += x / mag * rate
            elif mode == 'wheel':
                # Turned round like a wheel: clockwise scrolls down, a full turn WHEEL_NOTCHES notches.
                if mag >= b['threshold']:
                    ang = math.atan2(x, -y)
                    last = self.wheel_last.get(s)
                    if last is not None:
                        self.acc[2] += -wrap_angle(ang - last) / (2 * math.pi) * WHEEL_NOTCHES * 120 * b['sensitivity']
                    self.wheel_last[s] = ang
                elif mag < b['threshold'] * STICK_HYST:
                    self.wheel_last.pop(s, None)
            elif mode == 'flick':
                self._flick(s, x, y, mag, b, dt)

        cfg = self.gyro_cfg()
        if self.gyro_active:
            dz = cfg['deadzone']
            soft = lambda r: math.copysign(max(0.0, abs(r) - dz), r)
            gx, gy, gz = self.rate
            k = GYRO_SCALE * cfg['sensitivity'] * sens * dt
            turn = gz if cfg['axis'] == 'roll' else gy
            self.acc[0] += -soft(turn) * k * (-1 if cfg['invert_x'] else 1)
            self.acc[1] += -soft(gx) * k * (-1 if cfg['invert_y'] else 1)

        dx, dy = int(self.acc[0]), int(self.acc[1])
        self.acc[0] -= dx
        self.acc[1] -= dy
        if dx or dy:
            self.out.move(dx, dy)
        v, h = int(self.acc[2]), int(self.acc[3])
        self.acc[2] -= v
        self.acc[3] -= h
        if v or h:
            self._wheel(v, h)

    def _flick(self, s, x, y, mag, b, dt):
        """Flick stick: pushing the stick out turns the camera at once to where it points (a full turn is `turn`
        pixels of mouse movement, the game's own 360°); turning it round while out keeps turning with it."""
        f = self.flick.setdefault(s, {'on': False, 'last': 0.0, 'left': 0.0, 'time': 0.0})
        turn = b['turn']
        if mag >= b['threshold']:
            ang = math.atan2(x, -y)
            if not f['on']:
                f.update(on=True, last=ang, left=f['left'] + ang / (2 * math.pi) * turn, time=FLICK_TIME)
            else:
                self.acc[0] += wrap_angle(ang - f['last']) / (2 * math.pi) * turn
                f['last'] = ang
        elif mag < b['threshold'] * STICK_HYST:
            f['on'] = False
        if f['left']:
            part = f['left'] if f['time'] <= dt else f['left'] * dt / f['time']
            f['time'] = max(0.0, f['time'] - dt)
            f['left'] -= part
            if abs(f['left']) < 1e-6:
                f['left'] = 0.0
            self.acc[0] += part

    # ------------------------------------------------------------------ starting and stopping
    def release_all(self):
        """Every key and button up, nothing half-done (no tap fires)."""
        for src in list(self.src_codes):
            self._up(src)
        self.held.clear()
        self.pulses.clear()
        self.scroll_next.clear()
        self.stick_held.clear()
        self.pending.clear()
        self.latched.clear()
        self.layers_held.clear()
        self.gyro_hold.clear()
        self.gyro_block.clear()
        self.flick.clear()
        self.wheel_last.clear()
        self.radial = None
        self.trig = {'lt': False, 'rt': False}
        self.acc = [0.0, 0.0, 0.0, 0.0]

    def start(self, held_buttons=(), triggers=None):
        """The layout takes over: buttons already down (the A that started the game) do nothing until let go."""
        self.release_all()
        self.ignored = set(held_buttons)
        self.down = set(held_buttons)
        for t in TRIGGERS:
            if triggers and triggers.get(t, 0.0) >= 0.5:
                self.ignored.add(t)
                self.trig[t] = True

    def set_prefs(self, prefs):
        was = self.prefs
        self.prefs = prefs
        if prefs['gyro'] != was['gyro']:
            self.gyro_on = prefs['gyro']

    def describe(self):
        """What's in force, for the preview: the set, the layers, gyro."""
        return {'set': self.set_id, 'layers': self.active_layers(), 'gyro': self.gyro_active}


# ---------------------------------------------------------------------- when the controller is taken

class Policy:
    """What should be running right now: a layout (the controller is grabbed) or None (let go)."""

    def __init__(self):
        self.game = None
        self.front = False
        self.overlay = False
        self.layout = None
        self.raw = None
        self.prefs = validate_prefs(None)
        self.error = None
        self.last_state = -1e9
        self.suspend_until = 0.0
        self.test = None        # (layout, until)

    def state(self, m, now):
        self.last_state = now
        g = m.get('game')
        self.game = g if isinstance(g, str) and 0 < len(g) <= 300 else None
        self.front = m.get('front') is True
        self.overlay = m.get('overlay') is True
        # Checked again only when it changes (the same layout stays the same object: no restart). Prefs on their own
        # (Quick Access: sensitivity, gyro) update the running layout without restarting it.
        raw = json.dumps(m.get('layout'), sort_keys=True)
        if raw != self.raw:
            self.raw = raw
            self.error = None
            try:
                self.layout = validate_layout(m['layout']) if m.get('layout') is not None else None
            except LayoutError as e:
                self.layout, self.error = None, str(e)
        try:
            self.prefs = validate_prefs(m.get('prefs'))
        except LayoutError as e:
            self.prefs, self.error = validate_prefs(None), str(e)

    def start_test(self, layout, seconds, now):
        self.test = (validate_layout(layout), now + max(1, min(TEST_MAX, int(seconds))))

    def want(self, now):
        if self.overlay or now < self.suspend_until:
            return None
        if self.test:
            if now < self.test[1]:
                return self.test[0]
            self.test = None
        if now - self.last_state > HEARTBEAT:
            return None
        if self.layout is not None and self.front and self.game:
            return self.layout
        return None

    def guide(self, now):
        self.suspend_until = now + GUIDE_SUSPEND
        self.test = None


