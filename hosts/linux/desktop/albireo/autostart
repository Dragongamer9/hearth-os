#!/bin/sh
# Mantel on Hearth's own compositor (2.0 preview, docs/ALBIREO.md): the compositor starts this once it's up
# (nimbus-session's run_albireo passes it after --), and it runs Desktop Mode's one autostart, the same one labwc
# and KWin run (desktop/labwc/autostart: it looks at HEARTH_WM). Same process (exec), so $PPID there is still the
# compositor.
SHARE="${NIMBUS_SHARE:-/usr/local/share/nimbus}"
HEARTH_WM=albireo; export HEARTH_WM
exec sh "$SHARE/desktop/labwc/autostart"
