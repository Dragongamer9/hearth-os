#!/bin/sh
# Started by the login screen when you pick the "Nimbus" session.
#
# One session, two modes, switched without logging out (like SteamOS's Game Mode and Desktop Mode):
#   Game Mode     Nimbus fullscreen in gamescope (Valve's compositor, the same one SteamOS uses)
#   Desktop Mode  the labwc window manager with the Nimbus taskbar, launcher and notifications (Quickshell)
#
# To switch, a mode writes the next one to $XDG_RUNTIME_DIR/nimbus-next and ends itself
# (nimbus-mode does both). A mode that ends without asking for another one ends the session.
#
# Settings in ~/.config/nimbus/session.conf (shell syntax):
#   NIMBUS_START_MODE=desktop             start in Desktop Mode instead of Game Mode
#   NIMBUS_GAMESCOPE_ARGS="-W 1280 -H 800 --adaptive-sync"
# Which Nimbus to run: ~/.config/nimbus/app-path (written by Nimbus › Settings › Shell), or NIMBUS_APP.

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/nimbus"
# Installed as part of Nimbus OS, everything lives under /usr; installed from the app, under /usr/local.
if [ -d /usr/share/nimbus/desktop ]; then DEFAULT_SHARE=/usr/share/nimbus; else DEFAULT_SHARE=/usr/local/share/nimbus; fi
if [ -x /usr/libexec/nimbus/nimbus-watchdog ]; then WATCHDOG=/usr/libexec/nimbus/nimbus-watchdog; else WATCHDOG=/usr/local/lib/nimbus/nimbus-watchdog; fi
SHARE="${NIMBUS_SHARE:-$DEFAULT_SHARE}"
RUN="${XDG_RUNTIME_DIR:-/tmp}"
NEXT="$RUN/nimbus-next"
LOG="${XDG_DATA_HOME:-$HOME/.local/share}/nimbus/session.log"
mkdir -p "$(dirname "$LOG")"
# One sign-in's worth of history is plenty: over 2 MB, the log becomes session.log.old (the one before is dropped).
[ -f "$LOG" ] && [ "$(wc -c <"$LOG")" -gt 2000000 ] && mv -f "$LOG" "$LOG.old"
log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

# gamescope options given to this session by whoever started it (an extra multi-seat player's window size, frame
# rate and graphics card come from hearth-seats this way): kept, after session.conf's, every Game Mode start.
ENV_GAMESCOPE_ARGS="$NIMBUS_GAMESCOPE_ARGS"
[ -f "$CONF/session.conf" ] && . "$CONF/session.conf"
[ -z "$NIMBUS_APP" ] && [ -f "$CONF/app-path" ] && NIMBUS_APP="$(cat "$CONF/app-path")"
[ -z "$NIMBUS_APP" ] && [ -x /usr/bin/nimbus ] && NIMBUS_APP=/usr/bin/nimbus
export NIMBUS_SESSION=1 NIMBUS_APP NIMBUS_SHARE="$SHARE"
# Programs you install for yourself (Claude Code, Claude Desktop's launcher, pip --user...) live in ~/.local/bin:
# on PATH for everything this session starts (the terminal, the app menu, Game Mode), on every edition, even
# when the folder is only made later. Login shells get the same from /etc/profile.d/hearth-local-bin.sh.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH
# Where apps and their icons are found, for everything this session starts (labwc and its Alt+Tab, Mantel's
# launcher, taskbar and notifications, Hearth, the apps): Flatpak's exported apps (yours and the system's), Snap's,
# and the system's. The login screen doesn't always run /etc/profile.d/flatpak.sh first (that depends on the login
# screen and your shell), and without these folders Flatpak apps were missing from the launcher or had no icons.
# ~/.local/share (AppImages, Distrobox exports, your own .desktop files and ~/.local/share/icons) is
# $XDG_DATA_HOME, which is always searched first. (desktop-test.yml runs these lines, between the >>> and <<< marks.)
# >>> data dirs
data_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for d in /var/lib/snapd/desktop /var/lib/flatpak/exports/share "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share"; do
  case ":$data_dirs:" in *":$d:"*|*":$d/:"*) ;; *) data_dirs="$d:$data_dirs" ;; esac
done
case ":$data_dirs:" in *":/usr/share:"*|*":/usr/share/:"*) ;; *) data_dirs="$data_dirs:/usr/local/share:/usr/share" ;; esac
export XDG_DATA_DIRS="$data_dirs"
unset data_dirs d
# <<< data dirs
export XDG_CURRENT_DESKTOP=Nimbus XDG_SESSION_DESKTOP=nimbus
# gamescope reuses a mode saved in GAMESCOPE_MODE_SAVE_FILE (set by some Steam sessions) whenever -W/-H/-r are
# absent or don't match, so a switch back to "the screen's own mode" could land on an old saved 144 Hz instead.
# Hearth keeps its mode in session.conf, so gamescope's own save is turned off.
unset GAMESCOPE_MODE_SAVE_FILE
# Nvidia: WebKitGTK's DMA-BUF drawing crashes or blanks windows on Nvidia's driver (615 included), so every WebKit app
# started from this session (Hearth's own apps, Beacon, anything else on WebKitGTK/Tauri) uses the older path.
# A value someone set themselves is kept.
if [ -d /sys/module/nvidia ] && [ -z "${WEBKIT_DISABLE_DMABUF_RENDERER+x}" ]; then
  export WEBKIT_DISABLE_DMABUF_RENDERER=1
fi
# Apps that open web pages through $BROWSER (sign-in pages of launchers, Python's webbrowser, Rust's open crate...)
# use your default browser: Hearth Browser unless you picked another in Settings › Default apps, not the first
# browser they find (Chrome). A value you set yourself is kept.
[ -z "${BROWSER+x}" ] && command -v xdg-open >/dev/null 2>&1 && export BROWSER=xdg-open

have() { command -v "$1" >/dev/null 2>&1; }

# ---- Every app's Open / Save dialog is Hearth Files: xdg-desktop-portal's FileChooser goes to Hearth's backend
# (desktop/shell/hearth-portal, named in /usr/share/xdg-desktop-portal/nimbus-portals.conf), and apps that only use
# the portal when asked are asked here, in both modes. A value you set yourself is kept.
#   Flatpak apps, Chromium and newer Electron apps, Hearth's own apps: the portal already
#   GTK 3 apps, older Electron apps, WebKitGTK's file buttons, Firefox: GTK_USE_PORTAL=1
#   GTK 4 apps: GDK_DEBUG=portals (added to what's there)
#   Qt apps: the xdgdesktopportal platform theme in Game Mode, when it's installed (Desktop Mode's qt6ct look asks
#   for portal dialogs itself: standard_dialogs=xdgdesktopportal, desktop/theme/apply.sh)
# (desktop-test.yml runs these lines, between the >>> and <<< marks.)
# >>> portal dialogs
[ -z "${GTK_USE_PORTAL+x}" ] && export GTK_USE_PORTAL=1
case ",${GDK_DEBUG:-}," in *,portals,*) ;; *) export GDK_DEBUG="${GDK_DEBUG:+$GDK_DEBUG,}portals" ;; esac
if [ -z "${QT_QPA_PLATFORMTHEME+x}" ]; then
  for d in /usr/lib64/qt6/plugins /usr/lib/qt6/plugins /usr/lib/*-linux-gnu*/qt6/plugins; do
    if [ -e "$d/platformthemes/libqxdgdesktopportal.so" ]; then export QT_QPA_PLATFORMTHEME=xdgdesktopportal; break; fi
  done
fi
# <<< portal dialogs

# Steam's own Game Mode was an option in 0.2.8 and 0.2.9 and has been taken out: Game Mode is always Hearth's.
# The old choice (~/.config/nimbus/game-mode) is removed so nothing reads it again.
rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/game-mode" "${XDG_STATE_HOME:-$HOME/.local/state}/nimbus/steam-game-mode-running" 2>/dev/null

can_game() { have gamescope && [ -n "$NIMBUS_APP" ] && [ -x "$NIMBUS_APP" ]; }
can_desktop() { have labwc; }

# Apps that keep sign-ins in the system's password store (Xodus Nexus, browsers) need one running, and on a
# console nobody can type a password to unlock it: give GNOME Keyring an unlocked default keyring the first
# time (only when there's no keyring yet), and start it.
password_store() {
  have gnome-keyring-daemon || return 0
  kr="${XDG_DATA_HOME:-$HOME/.local/share}/keyrings"
  if [ ! -e "$kr/default" ] && ! ls "$kr"/*.keyring >/dev/null 2>&1; then
    mkdir -p "$kr" && chmod 700 "$kr"
    printf '[keyring]\ndisplay-name=Hearth\nctime=0\nmtime=0\nlock-on-idle=false\nlock-after=false\n' >"$kr/hearth.keyring"
    chmod 600 "$kr/hearth.keyring"; printf 'hearth' >"$kr/default"
  fi
  eval "$(gnome-keyring-daemon --start --components=secrets 2>/dev/null)" && export GNOME_KEYRING_CONTROL 2>/dev/null
}
password_store

# Default apps: your own choices (Settings › Default apps, ~/.config/mimeapps.list) stay, but a Hearth app an older
# Hearth put there that isn't installed any more comes out, so its files open in Hearth's default again.
if [ -f "$SHARE/desktop/shell/hearth-system" ] && have python3; then
  python3 "$SHARE/desktop/shell/hearth-system" defaults-tidy >/dev/null 2>&1 || log "defaults-tidy failed"
fi

SESSION_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/session.conf"
# gamescope's screen mode options with their values (-W 1920, --nested-refresh=60, -r 59.94...), for sed -E.
MODE_ARGS_RE='(^|[[:space:]"])(-[WHr][[:space:]]+|--(output-width|output-height|nested-refresh)[=[:space:]]+)[^[:space:]"]+'
has_mode_args() { printf ' %s\n' "$1" | grep -Eq "$MODE_ARGS_RE"; }
run_game() {
  log "game mode"
  # Settings › Display writes gamescope's options (resolution, refresh rate) here: read again every time, so a new
  # mode applies when Game Mode restarts (it used to apply only after signing out).
  NIMBUS_GAMESCOPE_ARGS="$ENV_GAMESCOPE_ARGS"
  # An extra multi-seat player's own options (Settings › Display writes -W/-H/-r there too) are added to the ones
  # hearth-seats gave, which come last so their window size and graphics card win: session.conf replacing them
  # put player 2 on the wrong card or at the whole screen's size over the others' parts.
  [ -n "$HEARTH_SEAT" ] && NIMBUS_GAMESCOPE_ARGS=""
  # shellcheck source=/dev/null
  [ -f "$SESSION_CONF" ] && . "$SESSION_CONF"
  [ -n "$HEARTH_SEAT" ] && [ -n "$ENV_GAMESCOPE_ARGS" ] && NIMBUS_GAMESCOPE_ARGS="$NIMBUS_GAMESCOPE_ARGS $ENV_GAMESCOPE_ARGS"
  # shellcheck disable=SC2086
  # Performance overlay (Quick Access › Performance): mangoapp draws it and reloads this file when Hearth writes it.
  extra=""
  if have mangoapp; then
    export MANGOHUD_CONFIGFILE="${XDG_RUNTIME_DIR:-/tmp}/hearth-mangohud.conf"
    echo no_display >"$MANGOHUD_CONFIGFILE"
    extra="--mangoapp"
  fi
  # Multi-seat: no performance overlay. mangoapp reads every process using the graphics card, the other players'
  # too (their own accounts: "Permission denied" on /proc/<pid>/fdinfo), and crashed over and over.
  [ -n "$HEARTH_SEAT" ] && extra=""
  # ...and player 1's too while multi-seat is on (a card per player, or normal Game Mode after the host couldn't
  # start): the other players' games run then as well.
  grep -Eq '"enabled": *true' /etc/hearth/seats.json 2>/dev/null && extra=""
  # Games get gamescope's Vulkan layer: the frame-rate limit (Quick Access › Performance) works through it.
  export ENABLE_GAMESCOPE_WSI="${ENABLE_GAMESCOPE_WSI:-1}"
  # Fullscreen games mustn't minimize themselves when Quick Access or Hearth comes in front (that left a black
  # screen with the game still playing). Steam's own Game Mode sets the same.
  export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
  # SteamOS Manager sets the power limit and power modes on Bazzite (what Steam's Game Mode uses); it normally
  # starts with Steam's session, so start it for Hearth's too.
  [ -z "$HEARTH_SEAT" ] && { systemctl --user start steamos-manager.service >/dev/null 2>&1 || true; }
  # Multi-seat (Settings › Multi-seat): with one graphics card and several screens, or one screen split into
  # parts, player 1's Game Mode shares them out (falls back to normal Game Mode by itself, exit code 3; on a split
  # screen hearth-seats makes player 1's gamescope a window the size of its part); with a card per player,
  # player 1 stays on its own card.
  SEATS=/usr/libexec/nimbus/hearth-seats
  seatargs=""
  # Fullscreen, except an extra player on part of a split screen (their window is the size of their part).
  full="-f"
  [ -n "$HEARTH_SEAT" ] && [ -n "$HEARTH_SEAT_WINDOWED" ] && full=""
  # A host that fails within seconds three times in a row (a crash on start) isn't tried again this session:
  # normal Game Mode instead of restarting it every two seconds forever.
  if [ -z "$HEARTH_SEAT" ] && [ -f "$SEATS" ] && [ "${HOST_FAILS:-0}" -lt 3 ]; then
    if python3 "$SEATS" host-check 2>/dev/null; then
      log "multi-seat: hosting the other players' screens"
      host_started=$(date +%s)
      # shellcheck disable=SC2086
      python3 "$SEATS" host -- gamescope -f $NIMBUS_GAMESCOPE_ARGS -- "$WATCHDOG" "$NIMBUS_APP"
      rc=$?
      if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ] && [ $(( $(date +%s) - host_started )) -lt 15 ]; then
        HOST_FAILS=$(( ${HOST_FAILS:-0} + 1 ))
        [ "$HOST_FAILS" -ge 3 ] && log "multi-seat host failed $HOST_FAILS times right away (code $rc); normal Game Mode until you sign in again"
      else
        HOST_FAILS=0
      fi
      [ "$rc" -ne 3 ] && return "$rc"
      log "multi-seat host couldn't start; normal Game Mode"
    fi
    seatargs="$(python3 "$SEATS" gamescope-args 2>/dev/null)"
  fi
  # A screen mode gamescope can't start with (-W/-H/-r from Settings › Display) mustn't leave the PC stuck: it's
  # tried once more, and after two failures within seconds those options go and Game Mode starts at the screen's
  # own mode. (Ending the session after the first failure sent the PC back to the sign-in screen, or round and
  # round with automatic sign-in, without ever getting here twice.) Not for an extra multi-seat player: their
  # window size comes from hearth-seats.
  gs_fails=0
  while :; do
    gs_started=$(date +%s)
    # shellcheck disable=SC2086
    gamescope $full $extra $NIMBUS_GAMESCOPE_ARGS $seatargs -- "$WATCHDOG" "$NIMBUS_APP"
    gs_rc=$?
    [ "$gs_rc" -ne 0 ] && [ $(( $(date +%s) - gs_started )) -lt 20 ] && [ -z "$HEARTH_SEAT" ] && [ ! -s "$NEXT" ] && has_mode_args "$NIMBUS_GAMESCOPE_ARGS" || break
    gs_fails=$((gs_fails + 1))
    if [ "$gs_fails" -ge 2 ]; then
      log "gamescope couldn't start with the chosen screen mode ($NIMBUS_GAMESCOPE_ARGS); back to the screen's own mode"
      [ -f "$SESSION_CONF" ] && sed -i -E "/^[[:space:]]*(export[[:space:]]+)?NIMBUS_GAMESCOPE_ARGS=/ s/$MODE_ARGS_RE/\\1/g" "$SESSION_CONF"
      rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/display-pending.json"
      NIMBUS_GAMESCOPE_ARGS="$(printf ' %s' "$NIMBUS_GAMESCOPE_ARGS" | sed -E "s/$MODE_ARGS_RE/\\1/g")"
      # Options that still name a mode (not ones Hearth wrote) aren't tried over and over.
      has_mode_args "$NIMBUS_GAMESCOPE_ARGS" && break
    else
      log "gamescope ended right away (code $gs_rc) with the chosen screen mode; trying once more"
    fi
  done
  return "$gs_rc"
}

run_desktop() {
  log "desktop mode"
  # Nvidia: wlroots' hardware cursor doesn't show (or doesn't move) on Nvidia's driver, so the pointer draws in
  # software there. Same as every wlroots desktop needs on Nvidia.
  if [ -d /sys/module/nvidia_drm ]; then
    export WLR_NO_HARDWARE_CURSORS=1
    log "nvidia: software cursor"
  fi
  # labwc reads rc.xml, autostart, environment and menu.xml from this folder; your own
  # ~/.config/labwc/rc.xml and autostart are added on top by Nimbus's autostart if they exist.
  # Your keyboard layouts and key repeat (Settings › Keyboard): Hearth's labwc files with yours on top, in $XDG_RUNTIME_DIR.
  CONF="$SHARE/desktop/labwc"
  if [ -f "$SHARE/desktop/shell/hearth-system" ] && have python3; then
    CONF="$(python3 "$SHARE/desktop/shell/hearth-system" labwc-config 2>/dev/null)" || CONF="$SHARE/desktop/labwc"
    [ -f "$CONF/rc.xml" ] || CONF="$SHARE/desktop/labwc"
  fi
  # labwc's own messages (wlroots, the graphics driver) in ~/.local/share/nimbus/labwc.log, which the log report
  # includes; before, they went nowhere anyone could see. The previous one is kept as labwc.log.old.
  LABWC_LOG="$(dirname "$LOG")/labwc.log"
  [ -f "$LABWC_LOG" ] && [ "$(wc -c <"$LABWC_LOG")" -gt 1000000 ] && mv -f "$LABWC_LOG" "$LABWC_LOG.old"
  echo "--- $(date '+%F %T') Desktop Mode" >>"$LABWC_LOG"
  labwc -C "$CONF" >>"$LABWC_LOG" 2>&1
}

# Button remaps for the built-in controller (Settings › Controller), kept applied for the whole session in
# both modes: InputPlumber goes back to its default profile when the controller reconnects (after sleep).
BG_PIDS=""
if [ -z "$HEARTH_SEAT" ] && [ -x "$SHARE/desktop/shell/hearth-controller" ] && have busctl; then
  python3 "$SHARE/desktop/shell/hearth-controller" watch >/dev/null 2>&1 &
  BG_PIDS="$BG_PIDS $!"
fi

# The power button is Hearth's while this session runs (Settings › Power button: sleep, the power menu...).
# Without this the system's own default (logind: shut down) acts on the same press, before Hearth can.
# Bazzite set that in its image; Hearth's own editions don't, so the session asks for it: only while Hearth
# runs, so at the sign-in screen, or if Hearth is gone, the button works the usual way. Holding the button
# for several seconds still turns the device off (that's the firmware's).
if [ -z "$HEARTH_SEAT" ] && have systemd-inhibit; then
  systemd-inhibit --what=handle-power-key:handle-suspend-key --who="Hearth" \
    --why="Hearth handles the power button (Settings › Power button)" --mode=block sleep infinity >/dev/null 2>&1 &
  BG_PIDS="$BG_PIDS $!"
fi
# "Show in folder" / "Open containing folder" in any app opens Hearth Files: org.freedesktop.FileManager1 is
# hearth-portal's for the whole session (both modes), so Dolphin, Nautilus or Thunar, which D-Bus would start for
# that name otherwise, never take over.
if [ -f "$SHARE/desktop/shell/hearth-portal" ] && have python3; then
  python3 "$SHARE/desktop/shell/hearth-portal" filemanager1 --replace >>"$(dirname "$LOG")/portal.log" 2>&1 &
  BG_PIDS="$BG_PIDS $!"
fi
if [ -n "$BG_PIDS" ]; then
  trap 'kill $BG_PIDS 2>/dev/null' EXIT
  trap 'exit 143' INT TERM HUP   # a signal at logout ends the script through EXIT (so the helpers stop too)
fi

# Hearth's look for Qt and GTK apps (Bazaar, Dolphin...), in both modes.
[ -f "$SHARE/desktop/theme/apply.sh" ] && sh "$SHARE/desktop/theme/apply.sh" >/dev/null 2>&1 &

# The power limit you chose last time (a restart resets it on most handhelds).
[ -z "$HEARTH_SEAT" ] && [ -x "$SHARE/desktop/shell/hearth-power" ] && (sleep 12; python3 "$SHARE/desktop/shell/hearth-power" restore) >/dev/null 2>&1 &

# Aloha Browser, an optional extra (Hearth's own browser is Hearth Browser, Firefox, in the image): when you've
# installed it from Settings › Web browser, it's checked for updates weekly. (Not on the live USB.)
[ -x "$SHARE/desktop/shell/hearth-browser" ] && [ ! -e /etc/hearth-live ] && (sleep 45; python3 "$SHARE/desktop/shell/hearth-browser" ensure) >>"$(dirname "$LOG")/browser.log" 2>&1 &

# Between modes: apps started in one mode belong to its display, which is gone once the mode ends. Steam
# in particular then hangs, and Game Mode's Hearth (which starts Steam in the background) hangs with it.
# Give Steam a moment to close by itself (a couple of seconds, not its whole shutdown), then make sure it
# and the old compositor are gone.
settle() {
  if pgrep -u "$(id -u)" -x steam >/dev/null 2>&1; then
    log "closing Steam left from $1 mode"
    timeout 4 steam -shutdown >/dev/null 2>&1 &
    i=0; while [ $i -lt 10 ] && pgrep -u "$(id -u)" -x steam >/dev/null 2>&1; do sleep 0.25; i=$((i+1)); done
    pkill -TERM -u "$(id -u)" -x steam 2>/dev/null; pkill -TERM -u "$(id -u)" -f steamwebhelper 2>/dev/null
    i=0; while [ $i -lt 6 ] && pgrep -u "$(id -u)" -x steam >/dev/null 2>&1; do sleep 0.25; i=$((i+1)); done
    pkill -KILL -u "$(id -u)" -x steam 2>/dev/null; pkill -KILL -u "$(id -u)" -f steamwebhelper 2>/dev/null
  fi
  pkill -KILL -u "$(id -u)" -x gamescope 2>/dev/null; pkill -KILL -u "$(id -u)" -x gamescope-wl 2>/dev/null
  pkill -KILL -u "$(id -u)" -x labwc 2>/dev/null
  # Desktop Mode's controller and button helpers, if any outlived their mode (Quickshell ended by a signal
  # leaves its children running: hearth-buttons then polled the keys in the next mode, one more each switch).
  pkill -TERM -u "$(id -u)" -f 'desktop/shell/hearth-pad' 2>/dev/null; pkill -TERM -u "$(id -u)" -x quickshell 2>/dev/null
  pkill -TERM -u "$(id -u)" -f 'desktop/shell/hearth-buttons' 2>/dev/null
  # The controller service back to normal: Hearth (Game Mode) asks it to catch the Xbox button, and a mode that
  # ended without tidying up (closed by force) could leave it catching every button, so nothing but the Xbox
  # button worked in the next mode.
  reset_controllers
  return 0
}
reset_controllers() {
  [ -n "$HEARTH_SEAT" ] && return 0     # multi-seat: InputPlumber is shared, only player 1 resets it
  have busctl || return 0
  # Only where InputPlumber runs (Bazzite). Hearth OS on Anatase uses Handheld Daemon, which Hearth never puts
  # in a catching mode, so there's nothing to reset (and no InputPlumber to wake up over D-Bus).
  busctl --system status org.shadowblip.InputPlumber >/dev/null 2>&1 || return 0
  for d in $(busctl --system --list tree org.shadowblip.InputPlumber 2>/dev/null | grep -o '/org/shadowblip/InputPlumber/CompositeDevice[0-9]*' | sort -u); do
    busctl --system set-property org.shadowblip.InputPlumber "$d" org.shadowblip.Input.CompositeDevice InterceptMode u 0 >/dev/null 2>&1
  done
}

# Hearth Input (Game Mode): a game's controller layout makes the controller a keyboard and mouse while that game
# is in front (desktop/shell/hearth-input). Hearth tells it what to do over a socket only this user can open; it
# lets go of the controller by itself if Hearth stops talking, and ends when this script does. Not for extra
# multi-seat players (its virtual keyboard and mouse would land on player 1's seat).
INPUT_PID=""
input_start() {
  [ -z "$HEARTH_SEAT" ] && [ -f "$SHARE/desktop/shell/hearth-input" ] && have python3 || return 0
  python3 "$SHARE/desktop/shell/hearth-input" serve >>"$(dirname "$LOG")/input.log" 2>&1 &
  INPUT_PID=$!
}
input_stop() {
  [ -n "$INPUT_PID" ] && kill "$INPUT_PID" 2>/dev/null
  INPUT_PID=""
  return 0
}

reset_controllers
mode="${NIMBUS_START_MODE:-game}"
# Extra multi-seat players have Game Mode only, even when their session.conf says to start in Desktop Mode.
[ -n "$HEARTH_SEAT" ] && mode=game
rm -f "$NEXT"
while :; do
  # Fall back to whichever mode can run.
  # Desktop Mode's autostart reads the note: if its taskbar can't start either, it stays put instead of asking for
  # Game Mode again (that restarted Desktop Mode about once a minute, forever).
  if [ "$mode" = game ] && ! can_game; then log "game mode unavailable (gamescope or Nimbus missing)"; : >"$RUN/nimbus-game-unavailable"; mode=desktop; fi
  if [ "$mode" = desktop ] && ! can_desktop; then log "desktop mode unavailable (labwc missing)"; can_game && mode=game || exit 1; fi

  if [ "$mode" = game ]; then input_start; run_game; code=$?; input_stop; else run_desktop; code=$?; fi

  next="$(cat "$NEXT" 2>/dev/null)"; rm -f "$NEXT"
  [ -n "$HEARTH_SEAT" ] && [ "$next" = desktop ] && next=game   # extra multi-seat players have Game Mode only
  case "$next" in
    game|desktop) log "switching to $next"; settle "$mode"; log "starting $next mode"; mode="$next" ;;
    *) log "$mode mode ended (code $code), leaving the session"; exit 0 ;;
  esac
done
