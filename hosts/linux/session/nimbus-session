#!/bin/sh
# Started by the login screen when you pick the "Nimbus" session.
# Runs Nimbus fullscreen inside gamescope (Valve's compositor, the same one SteamOS Gaming Mode uses).
#
# Which Nimbus to run: ~/.config/nimbus/app-path (written by Nimbus › Settings › Shell),
# or NIMBUS_APP. Extra gamescope options: NIMBUS_GAMESCOPE_ARGS in ~/.config/nimbus/session.conf,
# e.g. NIMBUS_GAMESCOPE_ARGS="-W 1280 -H 800 --adaptive-sync"

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/nimbus"
[ -f "$CONF/session.conf" ] && . "$CONF/session.conf"
[ -z "$NIMBUS_APP" ] && [ -f "$CONF/app-path" ] && NIMBUS_APP="$(cat "$CONF/app-path")"
if [ -z "$NIMBUS_APP" ] || [ ! -x "$NIMBUS_APP" ]; then
  echo "nimbus-session: Nimbus not found (set it up from Nimbus › Settings › Shell)" >&2
  exit 1
fi
if ! command -v gamescope >/dev/null 2>&1; then
  echo "nimbus-session: gamescope is not installed" >&2
  exit 1
fi

export NIMBUS_SESSION=1
# shellcheck disable=SC2086
exec gamescope -f $NIMBUS_GAMESCOPE_ARGS -- /usr/local/lib/nimbus/nimbus-watchdog "$NIMBUS_APP"
