#!/bin/sh
# Started by the login screen when you pick the "Nimbus" session.
#
# One session, two modes, switched without logging out (like SteamOS's Game Mode and Desktop Mode):
#   Game Mode     Nimbus fullscreen in gamescope (Valve's compositor, the same one SteamOS uses)
#   Desktop Mode  the labwc window manager with the Nimbus taskbar, launcher and notifications (Quickshell)
#
# To switch, a mode writes the next one to $XDG_RUNTIME_DIR/nimbus-next and ends itself
# (nimbus-mode does both). A mode that ends without asking for another one ends the session.
#
# Settings in ~/.config/nimbus/session.conf (shell syntax):
#   NIMBUS_START_MODE=desktop             start in Desktop Mode instead of Game Mode
#   NIMBUS_GAMESCOPE_ARGS="-W 1280 -H 800 --adaptive-sync"
# Which Nimbus to run: ~/.config/nimbus/app-path (written by Nimbus › Settings › Shell), or NIMBUS_APP.

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/nimbus"
# Installed as part of Nimbus OS, everything lives under /usr; installed from the app, under /usr/local.
if [ -d /usr/share/nimbus/desktop ]; then DEFAULT_SHARE=/usr/share/nimbus; else DEFAULT_SHARE=/usr/local/share/nimbus; fi
if [ -x /usr/libexec/nimbus/nimbus-watchdog ]; then WATCHDOG=/usr/libexec/nimbus/nimbus-watchdog; else WATCHDOG=/usr/local/lib/nimbus/nimbus-watchdog; fi
SHARE="${NIMBUS_SHARE:-$DEFAULT_SHARE}"
RUN="${XDG_RUNTIME_DIR:-/tmp}"
NEXT="$RUN/nimbus-next"
LOG="${XDG_DATA_HOME:-$HOME/.local/share}/nimbus/session.log"
mkdir -p "$(dirname "$LOG")"
log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

[ -f "$CONF/session.conf" ] && . "$CONF/session.conf"
[ -z "$NIMBUS_APP" ] && [ -f "$CONF/app-path" ] && NIMBUS_APP="$(cat "$CONF/app-path")"
[ -z "$NIMBUS_APP" ] && [ -x /usr/bin/nimbus ] && NIMBUS_APP=/usr/bin/nimbus
export NIMBUS_SESSION=1 NIMBUS_APP NIMBUS_SHARE="$SHARE"
export XDG_CURRENT_DESKTOP=Nimbus XDG_SESSION_DESKTOP=nimbus

have() { command -v "$1" >/dev/null 2>&1; }

can_game() { have gamescope && [ -n "$NIMBUS_APP" ] && [ -x "$NIMBUS_APP" ]; }
can_desktop() { have labwc; }

run_game() {
  log "game mode"
  # shellcheck disable=SC2086
  gamescope -f $NIMBUS_GAMESCOPE_ARGS -- "$WATCHDOG" "$NIMBUS_APP"
}

run_desktop() {
  log "desktop mode"
  # labwc reads rc.xml, autostart, environment and menu.xml from this folder; your own
  # ~/.config/labwc/rc.xml and autostart are added on top by Nimbus's autostart if they exist.
  labwc -C "$SHARE/desktop/labwc"
}

# Button remaps for the built-in controller (Settings › Controller), kept applied for the whole session in
# both modes: InputPlumber goes back to its default profile when the controller reconnects (after sleep).
if [ -x "$SHARE/desktop/shell/hearth-controller" ] && have busctl; then
  python3 "$SHARE/desktop/shell/hearth-controller" watch >/dev/null 2>&1 &
  REMAP_PID=$!
  trap 'kill $REMAP_PID 2>/dev/null' EXIT
fi

# Hearth's look for Qt and GTK apps (Bazaar, Dolphin...), in both modes.
[ -f "$SHARE/desktop/theme/apply.sh" ] && sh "$SHARE/desktop/theme/apply.sh" >/dev/null 2>&1 &

# The power limit you chose last time (a restart resets it on most handhelds).
[ -x "$SHARE/desktop/shell/hearth-power" ] && (sleep 12; python3 "$SHARE/desktop/shell/hearth-power" restore) >/dev/null 2>&1 &

# Aloha Browser, Hearth's web browser: downloaded from alohabrowser.com once (it can't ship in the image),
# then checked for updates weekly. Settings › System › Web browser can remove it or reinstall it.
# (Not on the live USB: it would download into memory.)
[ -x "$SHARE/desktop/shell/hearth-browser" ] && [ ! -e /etc/hearth-live ] && (sleep 45; python3 "$SHARE/desktop/shell/hearth-browser" ensure) >>"$(dirname "$LOG")/browser.log" 2>&1 &

# Between modes: apps started in one mode belong to its display, which is gone once the mode ends. Steam
# in particular then hangs, and Game Mode's Hearth (which starts Steam in the background) hangs with it.
# Give Steam a few seconds to close by itself, then make sure it and the old compositor are gone.
settle() {
  if pgrep -u "$(id -u)" -x steam >/dev/null 2>&1; then
    log "closing Steam left from $1 mode"
    timeout 6 steam -shutdown >/dev/null 2>&1 &
    i=0; while [ $i -lt 20 ] && pgrep -u "$(id -u)" -x steam >/dev/null 2>&1; do sleep 0.5; i=$((i+1)); done
    pkill -TERM -u "$(id -u)" -x steam 2>/dev/null; pkill -TERM -u "$(id -u)" -f steamwebhelper 2>/dev/null
  fi
  pkill -KILL -u "$(id -u)" -x gamescope 2>/dev/null; pkill -KILL -u "$(id -u)" -x gamescope-wl 2>/dev/null
  pkill -KILL -u "$(id -u)" -x labwc 2>/dev/null
  return 0
}

mode="${NIMBUS_START_MODE:-game}"
rm -f "$NEXT"
while :; do
  # Fall back to whichever mode can run.
  if [ "$mode" = game ] && ! can_game; then log "game mode unavailable (gamescope or Nimbus missing)"; mode=desktop; fi
  if [ "$mode" = desktop ] && ! can_desktop; then log "desktop mode unavailable (labwc missing)"; can_game && mode=game || exit 1; fi

  if [ "$mode" = game ]; then run_game; else run_desktop; fi
  code=$?

  next="$(cat "$NEXT" 2>/dev/null)"; rm -f "$NEXT"
  case "$next" in
    game|desktop) log "switching to $next"; settle "$mode"; log "starting $next mode"; mode="$next" ;;
    *) log "$mode mode ended (code $code), leaving the session"; exit 0 ;;
  esac
done
