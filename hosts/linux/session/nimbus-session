#!/bin/sh
# Started by the login screen when you pick the "Nimbus" session.
#
# Hearth OS is Debian + Mantel (Desktop Mode) + Steam Game Mode (docs/STEAM-GAME-MODE.md). One session, switched
# without logging out (like SteamOS):
#   Steam Game Mode  Valve's Steam gamepad UI in gamescope, with Decky Loader and the Hearth plugin (the default)
#   Desktop Mode     Mantel: the labwc window manager with the Hearth taskbar, launcher and notifications
#                    (Quickshell). Mantel is the only desktop (Hearth Plasma, GNOME and COSMIC are gone).
#   Hearth Game Mode Hearth's own screens (ui/, hosts/hearth-rs) in gamescope, when you pick it (docs/HEARTH-GAME-MODE.md)
# Every request for "game" (nimbus-mode game, Mantel's Game Mode buttons, Steam's own Game Mode switch,
# NIMBUS_START_MODE, hearth.mode=game, Server mode's Guide countdown) opens the Game Mode you picked in Settings:
# HEARTH_GAME_MODE_CHOICE in session.conf (game_mode_choice; Steam Game Mode unless it says hearth). When Steam Game
# Mode can't start (no Steam, safe graphics, Steam ends right away, or it fails twice), the session opens Desktop Mode
# instead and leaves the reason in $XDG_RUNTIME_DIR/hearth-steam-mode-failed, which Mantel shows with a "Try Steam
# Game Mode again" button. When Hearth Game Mode can't start (missing pieces, crashing, failing twice), the session
# opens Steam Game Mode for that start (then Mantel), leaves the reason in $XDG_RUNTIME_DIR/hearth-game-mode-failed and
# keeps your choice. The live USB's installer is Hearth's app (Hearth Game Mode, as before).
#
# To switch, a mode writes the next one to $XDG_RUNTIME_DIR/nimbus-next and ends itself
# (nimbus-mode does both). A mode that ends without asking for another one ends the session.
#
# Settings in ~/.config/nimbus/session.conf (shell syntax):
#   NIMBUS_START_MODE=desktop             start in Desktop Mode instead of Game Mode
#   HEARTH_GAME_MODE_CHOICE=hearth        Game Mode is Hearth Game Mode (Settings › Gaming › Game Mode; steam or no line:
#                                         Steam Game Mode). Written only by hearth-game-mode when you pick one.
#   NIMBUS_GAMESCOPE_ARGS="-W 1280 -H 800 --adaptive-sync"
#   HEARTH_LEGACY_GAME_MODE=1             the old developer switch: read as HEARTH_GAME_MODE_CHOICE=hearth when that
#                                         line isn't there
#   HEARTH_LEGACY_MULTIPLAYER=1           developer switch: multi-seat and Couch Co-op back (dropped for now)
#   HEARTH_DESKTOP=...                    ignored: Mantel is the only desktop now. An earlier Hearth wrote plasma,
#                                         gnome or cosmic here (Settings › Desktop Mode); Desktop Mode is Mantel
#                                         whatever it says, and the line is left alone.
# `nimbus-session --desktop=...` (the login screen's old "Hearth Plasma" / "Hearth GNOME" / "Hearth COSMIC" entries)
# is ignored the same way.
# Which Nimbus to run: ~/.config/nimbus/app-path (written by Nimbus › Settings › Shell), or NIMBUS_APP.

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/nimbus"
# Installed as part of Nimbus OS, everything lives under /usr; installed from the app, under /usr/local.
if [ -d /usr/share/nimbus/desktop ]; then DEFAULT_SHARE=/usr/share/nimbus; else DEFAULT_SHARE=/usr/local/share/nimbus; fi
if [ -x /usr/libexec/nimbus/nimbus-watchdog ]; then WATCHDOG=/usr/libexec/nimbus/nimbus-watchdog; else WATCHDOG=/usr/local/lib/nimbus/nimbus-watchdog; fi
SHARE="${NIMBUS_SHARE:-$DEFAULT_SHARE}"
RUN="${XDG_RUNTIME_DIR:-/tmp}"
NEXT="$RUN/nimbus-next"
LOG="${XDG_DATA_HOME:-$HOME/.local/share}/nimbus/session.log"
mkdir -p "$(dirname "$LOG")"
# One sign-in's worth of history is plenty: over 2 MB, the log becomes session.log.old (the one before is dropped).
[ -f "$LOG" ] && [ "$(wc -c <"$LOG")" -gt 2000000 ] && mv -f "$LOG" "$LOG.old"
log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

# ---- Desktop Mode is always Mantel (Hearth Classic). An old --desktop=plasma|gnome|cosmic|deepin from the login
# screen of an earlier Hearth is only noted in the log, never acted on or saved.
for a in "$@"; do
  case "$a" in
    --desktop=*) [ "${a#--desktop=}" = classic ] || log "desktop: ${a#--desktop=} asked for on the login screen; Mantel is the only desktop now" ;;
  esac
done
unset a d f

# gamescope options given to this session by whoever started it (an extra multi-seat player's window size, frame
# rate and graphics card come from hearth-seats this way): kept, after session.conf's, every Game Mode start.
ENV_GAMESCOPE_ARGS="$NIMBUS_GAMESCOPE_ARGS"
[ -f "$CONF/session.conf" ] && . "$CONF/session.conf"
# HEARTH_DESKTOP=plasma|gnome|cosmic|deepin left by an earlier Hearth: Mantel anyway (nothing here or in what this
# session starts may act on it).
case "${HEARTH_DESKTOP:-classic}" in classic) ;; *) log "desktop: HEARTH_DESKTOP=$HEARTH_DESKTOP from an earlier Hearth; Mantel is the only desktop now" ;; esac
unset HEARTH_DESKTOP
# The live USB / installer: its installer is Hearth's app, so its Game Mode is always Hearth Game Mode (as before).
live_session() { [ -e "${HEARTH_LIVE_FLAG:-/etc/hearth-live}" ] || [ "${USER:-}" = liveuser ]; }
# Multi-seat and Couch Co-op are dropped for now (their code stays): off unless the developer switch is on.
multiplayer_on() { [ "${HEARTH_LEGACY_MULTIPLAYER:-0}" = 1 ]; }
# For Hearth's app (hearth-core feature "steamOnly"): this session's Game Mode is Steam Game Mode. Worked out again before
# every mode (steam_only_env, below the Game Mode choice), since the choice can change while you're signed in.
if multiplayer_on; then export HEARTH_LEGACY_MULTIPLAYER=1; else unset HEARTH_LEGACY_MULTIPLAYER; fi
[ -z "$NIMBUS_APP" ] && [ -f "$CONF/app-path" ] && NIMBUS_APP="$(cat "$CONF/app-path")"
[ -z "$NIMBUS_APP" ] && [ -x /usr/bin/nimbus ] && NIMBUS_APP=/usr/bin/nimbus
export NIMBUS_SESSION=1 NIMBUS_APP NIMBUS_SHARE="$SHARE"
# Programs you install for yourself (Claude Code, Claude Desktop's launcher, pip --user...) live in ~/.local/bin:
# on PATH for everything this session starts (the terminal, the app menu, Game Mode), on every edition, even
# when the folder is only made later. Login shells get the same from /etc/profile.d/hearth-local-bin.sh.
case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac
export PATH
# Where apps and their icons are found, for everything this session starts (labwc and its Alt+Tab, Mantel's
# launcher, taskbar and notifications, Hearth, the apps): Flatpak's exported apps (yours and the system's), Snap's,
# and the system's. The login screen doesn't always run /etc/profile.d/flatpak.sh first (that depends on the login
# screen and your shell), and without these folders Flatpak apps were missing from the launcher or had no icons.
# ~/.local/share (AppImages, Distrobox exports, your own .desktop files and ~/.local/share/icons) is
# $XDG_DATA_HOME, which is always searched first. (desktop-test.yml runs these lines, between the >>> and <<< marks.)
# >>> data dirs
data_dirs="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for d in /var/lib/snapd/desktop /var/lib/flatpak/exports/share "${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share"; do
  case ":$data_dirs:" in *":$d:"*|*":$d/:"*) ;; *) data_dirs="$d:$data_dirs" ;; esac
done
case ":$data_dirs:" in *":/usr/share:"*|*":/usr/share/:"*) ;; *) data_dirs="$data_dirs:/usr/local/share:/usr/share" ;; esac
# One app of each kind per desktop (docs/APP-KINDS.md): hearth-app-kinds' copies of the menu entries, with the
# OnlyShowIn/NotShowIn that say which desktop shows them, come before the packages' own (same ids).
if [ -d /usr/share/hearth/app-kinds/applications ]; then
  case ":$data_dirs:" in *":/usr/share/hearth/app-kinds:"*) ;; *) data_dirs="/usr/share/hearth/app-kinds:$data_dirs" ;; esac
fi
# Apps for hardware this PC doesn't have (NVIDIA Settings without an Nvidia card) are hidden from every menu: NoDisplay
# copies in this sign-in's runtime folder, worked out again at every sign-in (a new card shows them at once). Never
# holds the session up: 5 seconds at most, and nothing changes when it fails.
hw_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hearth-hw-apps"
if [ -x /usr/libexec/hearth-app-kinds ] && XDG_DATA_DIRS="$data_dirs" timeout 5 python3 /usr/libexec/hearth-app-kinds hardware --out "$hw_dir" >/dev/null 2>&1 && [ -d "$hw_dir/applications" ]; then
  case ":$data_dirs:" in *":$hw_dir:"*) ;; *) data_dirs="$hw_dir:$data_dirs" ;; esac
fi
export XDG_DATA_DIRS="$data_dirs"
unset data_dirs d hw_dir
# <<< data dirs
export XDG_CURRENT_DESKTOP=Nimbus XDG_SESSION_DESKTOP=nimbus
# gamescope reuses a mode saved in GAMESCOPE_MODE_SAVE_FILE (set by some Steam sessions) whenever -W/-H/-r are
# absent or don't match, so a switch back to "the screen's own mode" could land on an old saved 144 Hz instead.
# Hearth keeps its mode in session.conf, so gamescope's own save is turned off.
unset GAMESCOPE_MODE_SAVE_FILE
# Nvidia: WebKitGTK's DMA-BUF drawing crashes or blanks windows on Nvidia's driver (615 included), so every WebKit app
# started from this session (Hearth's own apps, Beacon, anything else on WebKitGTK/Tauri) uses the older path.
# A value someone set themselves is kept.
if [ -d /sys/module/nvidia ] && [ -z "${WEBKIT_DISABLE_DMABUF_RENDERER+x}" ]; then
  export WEBKIT_DISABLE_DMABUF_RENDERER=1
fi
# Apps that open web pages through $BROWSER (sign-in pages of launchers, Python's webbrowser, Rust's open crate...)
# use your default browser: Hearth Browser unless you picked another in Settings › Default apps, not the first
# browser they find (Chrome). A value you set yourself is kept.
[ -z "${BROWSER+x}" ] && command -v xdg-open >/dev/null 2>&1 && export BROWSER=xdg-open

have() { command -v "$1" >/dev/null 2>&1; }

# ---- Every app's Open / Save dialog is Hearth Files: xdg-desktop-portal's FileChooser goes to Hearth's backend
# (desktop/shell/hearth-portal, named in /usr/share/xdg-desktop-portal/nimbus-portals.conf), and apps that only use
# the portal when asked are asked here, in both modes. A value you set yourself is kept.
#   Flatpak apps, Chromium and newer Electron apps, Hearth's own apps: the portal already
#   GTK 3 apps, older Electron apps, WebKitGTK's file buttons, Firefox: GTK_USE_PORTAL=1
#   GTK 4 apps: GDK_DEBUG=portals (added to what's there)
#   Qt apps: the xdgdesktopportal platform theme in Game Mode, when it's installed (Desktop Mode's qt6ct look asks
#   for portal dialogs itself: standard_dialogs=xdgdesktopportal, desktop/theme/apply.sh)
# (desktop-test.yml runs these lines, between the >>> and <<< marks.)
# >>> portal dialogs
[ -z "${GTK_USE_PORTAL+x}" ] && export GTK_USE_PORTAL=1
case ",${GDK_DEBUG:-}," in *,portals,*) ;; *) export GDK_DEBUG="${GDK_DEBUG:+$GDK_DEBUG,}portals" ;; esac
if [ -z "${QT_QPA_PLATFORMTHEME+x}" ]; then
  for d in /usr/lib64/qt6/plugins /usr/lib/qt6/plugins /usr/lib/*-linux-gnu*/qt6/plugins; do
    if [ -e "$d/platformthemes/libqxdgdesktopportal.so" ]; then export QT_QPA_PLATFORMTHEME=xdgdesktopportal; break; fi
  done
fi
# <<< portal dialogs

# Steam's own Game Mode was an option in 0.2.8 and 0.2.9 (a different way than today's Steam Game Mode below).
# The old choice (~/.config/nimbus/game-mode) is removed so nothing reads it again.
rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/game-mode" "${XDG_STATE_HOME:-$HOME/.local/state}/nimbus/steam-game-mode-running" 2>/dev/null

can_game() { have gamescope && [ -n "$NIMBUS_APP" ] && [ -x "$NIMBUS_APP" ]; }
can_desktop() { have labwc; }

# Apps that keep sign-ins in the system's password store (Xodus Nexus, browsers) need one running, and on a
# console nobody can type a password to unlock it: give GNOME Keyring an unlocked default keyring the first
# time (only when there's no keyring yet), and start it.
password_store() {
  have gnome-keyring-daemon || return 0
  kr="${XDG_DATA_HOME:-$HOME/.local/share}/keyrings"
  if [ ! -e "$kr/default" ] && ! ls "$kr"/*.keyring >/dev/null 2>&1; then
    mkdir -p "$kr" && chmod 700 "$kr"
    printf '[keyring]\ndisplay-name=Hearth\nctime=0\nmtime=0\nlock-on-idle=false\nlock-after=false\n' >"$kr/hearth.keyring"
    chmod 600 "$kr/hearth.keyring"; printf 'hearth' >"$kr/default"
  fi
  eval "$(gnome-keyring-daemon --start --components=secrets 2>/dev/null)" && export GNOME_KEYRING_CONTROL 2>/dev/null
}
password_store

# Default apps: your own choices (Settings › Default apps, ~/.config/mimeapps.list) stay, but a Hearth app an older
# Hearth put there that isn't installed any more comes out, so its files open in Hearth's default again.
if [ -f "$SHARE/desktop/shell/hearth-system" ] && have python3; then
  python3 "$SHARE/desktop/shell/hearth-system" defaults-tidy >/dev/null 2>&1 || log "defaults-tidy failed"
fi

SESSION_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/session.conf"
# gamescope's screen mode options with their values (-W 1920, --nested-refresh=60, -r 59.94...), for sed -E.
MODE_ARGS_RE='(^|[[:space:]"])(-[WHr][[:space:]]+|--(output-width|output-height|nested-refresh)[=[:space:]]+)[^[:space:]"]+'
has_mode_args() { printf ' %s\n' "$1" | grep -Eq "$MODE_ARGS_RE"; }
# The chosen screen mode taken out of session.conf when gamescope can't start with it (docs/SETTINGS-PERSISTENCE.md:
# settings are never lost or changed without telling you). Only that line's mode options change, every other line
# stays; written atomically (a temporary file, flushed, renamed) under the lock Hearth's own writers use, with the old
# file kept as session.conf.bak. Your choice is kept in display-reverted.json and Game Mode offers it again.
strip_mode_args() {
  [ -f "$SESSION_CONF" ] || return 0
  sdir="$(dirname "$SESSION_CONF")"
  (
    command -v flock >/dev/null 2>&1 && flock -w 5 9
    t="$(mktemp "$sdir/.session.conf.XXXXXX")" || exit 0
    if sed -E "/^[[:space:]]*(export[[:space:]]+)?NIMBUS_GAMESCOPE_ARGS=/ s/$MODE_ARGS_RE/\\1/g" "$SESSION_CONF" >"$t" && [ -s "$t" ]; then
      chmod --reference="$SESSION_CONF" "$t" 2>/dev/null
      sync "$t" 2>/dev/null
      cmp -s "$SESSION_CONF" "$t" || { cp -p "$SESSION_CONF" "$SESSION_CONF.bak" 2>/dev/null; mv -f "$t" "$SESSION_CONF"; }
    fi
    rm -f "$t"
  ) 9>"$sdir/.session.conf.lock"
  note_reverted "$1"
}
# What you had chosen, for Settings › Display's "Try again" (JSON: the options as one string, quotes escaped).
note_reverted() {
  sdir="$(dirname "$SESSION_CONF")"
  mkdir -p "$sdir" 2>/dev/null
  esc="$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
  rt="$sdir/.display-reverted.$$"
  printf '{"args": "%s", "at": %s}\n' "$esc" "$(date +%s)" >"$rt" 2>/dev/null && { sync "$rt" 2>/dev/null; true; } && mv -f "$rt" "$sdir/display-reverted.json"
  rm -f "$rt"
}
# ---- The screen's real modes (os/system_files/usr/libexec/nimbus/hearth-screen, docs/STEAM-GAME-MODE.md "Screen modes").
# A mode the connected screen doesn't list (-W/-H/-r from Settings › Display, a TV that only has 2560 × 1440 at
# 60 Hz, another screen plugged in) made gamescope abort (code 134) instead of starting. Before gamescope starts, the
# chosen mode is checked against the kernel's list of the screen's modes, the one gamescope picks from: not there,
# and this start uses the screen's own mode. session.conf isn't changed (the same screen plugged back in gets your
# mode again); Game Mode says so with "Try again" (display-reverted.json). A mode on trial (display-pending.json: just
# picked, or Try again) is always really tried, and anything the check can't tell (several screens, no access, the
# built-in screen's refresh rates) is left to gamescope as before.
# (test_hearth_display_modes.py runs these lines, between the >>> and <<< marks.)
# >>> mode precheck
SCREEN_HELPER="${HEARTH_SCREEN_HELPER:-/usr/libexec/nimbus/hearth-screen}"
mode_not_listed() {
  [ -z "$HEARTH_SEAT" ] && has_mode_args "$1" && [ -f "$SCREEN_HELPER" ] && have python3 || return 1
  [ -e "$(dirname "$SESSION_CONF")/display-pending.json" ] && return 1
  # shellcheck disable=SC2086
  why="$(timeout 5 python3 "$SCREEN_HELPER" check -- $1 2>/dev/null)"
  [ $? -eq 1 ] || return 1
  log "screen mode: $why; the screen's own mode this time (session.conf kept as it is)"
  note_reverted "$1"
  return 0
}
# <<< mode precheck
# The ROG Ally's built-in screen for gamescope: its real refresh range (48 Hz up to the panel's own), when gamescope's
# own scripts don't know the panel. Only a gamescope display script in ~/.config/gamescope/scripts; never a setting.
panel_script() {
  [ -z "$HEARTH_SEAT" ] && [ -f "$SCREEN_HELPER" ] && have python3 || return 0
  r="$(timeout 5 python3 "$SCREEN_HELPER" panel-script 2>/dev/null)"
  case "$r" in written|removed) log "built-in screen for gamescope: $r" ;; esac
  return 0
}
run_game() {
  log "game mode"
  # Settings › Display writes gamescope's options (resolution, refresh rate) here: read again every time, so a new
  # mode applies when Game Mode restarts (it used to apply only after signing out).
  NIMBUS_GAMESCOPE_ARGS="$ENV_GAMESCOPE_ARGS"
  # An extra multi-seat player's own options (Settings › Display writes -W/-H/-r there too) are added to the ones
  # hearth-seats gave, which come last so their window size and graphics card win: session.conf replacing them
  # put player 2 on the wrong card or at the whole screen's size over the others' parts.
  [ -n "$HEARTH_SEAT" ] && NIMBUS_GAMESCOPE_ARGS=""
  # shellcheck source=/dev/null
  [ -f "$SESSION_CONF" ] && . "$SESSION_CONF"
  # Hearth Recovery on the device › Safe graphics this time: the screen's own mode and the compatible drawing.
  if [ -f /run/hearth/safe-graphics ]; then
    NIMBUS_GAMESCOPE_ARGS=$(printf ' %s\n' "$NIMBUS_GAMESCOPE_ARGS" | sed -E "s/$MODE_ARGS_RE/\\1/g")
    export WEBKIT_DISABLE_DMABUF_RENDERER=1
  fi
  if mode_not_listed "$NIMBUS_GAMESCOPE_ARGS"; then
    NIMBUS_GAMESCOPE_ARGS=$(printf ' %s\n' "$NIMBUS_GAMESCOPE_ARGS" | sed -E "s/$MODE_ARGS_RE/\\1/g")
  fi
  panel_script
  [ -n "$HEARTH_SEAT" ] && [ -n "$ENV_GAMESCOPE_ARGS" ] && NIMBUS_GAMESCOPE_ARGS="$NIMBUS_GAMESCOPE_ARGS $ENV_GAMESCOPE_ARGS"
  # shellcheck disable=SC2086
  # Performance overlay (Quick Access › Performance): mangoapp draws it and reloads this file when Hearth writes it.
  extra=""
  if have mangoapp; then
    export MANGOHUD_CONFIGFILE="${XDG_RUNTIME_DIR:-/tmp}/hearth-mangohud.conf"
    echo no_display >"$MANGOHUD_CONFIGFILE"
    extra="--mangoapp"
  fi
  # Multi-seat: no performance overlay. mangoapp reads every process using the graphics card, the other players'
  # too (their own accounts: "Permission denied" on /proc/<pid>/fdinfo), and crashed over and over.
  [ -n "$HEARTH_SEAT" ] && extra=""
  # ...and player 1's too while multi-seat is on (a card per player, or normal Game Mode after the host couldn't
  # start): the other players' games run then as well.
  grep -Eq '"enabled": *true' /etc/hearth/seats.json 2>/dev/null && extra=""
  # Games get gamescope's Vulkan layer: the frame-rate limit (Quick Access › Performance) works through it.
  export ENABLE_GAMESCOPE_WSI="${ENABLE_GAMESCOPE_WSI:-1}"
  # Fullscreen games mustn't minimize themselves when Quick Access or Hearth comes in front (that left a black
  # screen with the game still playing). Steam's own Game Mode sets the same.
  export SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0
  # SteamOS Manager sets the power limit and power modes on Bazzite (what Steam's Game Mode uses); it normally
  # starts with Steam's session, so start it for Hearth's too.
  [ -z "$HEARTH_SEAT" ] && { systemctl --user start steamos-manager.service >/dev/null 2>&1 || true; }
  # Multi-seat (Settings › Multi-seat): with one graphics card and several screens, or one screen split into
  # parts, player 1's Game Mode shares them out (falls back to normal Game Mode by itself, exit code 3; on a split
  # screen hearth-seats makes player 1's gamescope a window the size of its part); with a card per player,
  # player 1 stays on its own card.
  SEATS=/usr/libexec/nimbus/hearth-seats
  seatargs=""
  # Fullscreen, except an extra player on part of a split screen (their window is the size of their part).
  full="-f"
  [ -n "$HEARTH_SEAT" ] && [ -n "$HEARTH_SEAT_WINDOWED" ] && full=""
  # A host that fails within seconds three times in a row (a crash on start) isn't tried again this session:
  # normal Game Mode instead of restarting it every two seconds forever.
  if [ -z "$HEARTH_SEAT" ] && multiplayer_on && [ -f "$SEATS" ] && [ "${HOST_FAILS:-0}" -lt 3 ]; then
    if python3 "$SEATS" host-check 2>/dev/null; then
      log "multi-seat: hosting the other players' screens"
      host_started=$(date +%s)
      # shellcheck disable=SC2086
      python3 "$SEATS" host -- gamescope -f $NIMBUS_GAMESCOPE_ARGS -- "$WATCHDOG" "$NIMBUS_APP"
      rc=$?
      if [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ] && [ $(( $(date +%s) - host_started )) -lt 15 ]; then
        HOST_FAILS=$(( ${HOST_FAILS:-0} + 1 ))
        [ "$HOST_FAILS" -ge 3 ] && log "multi-seat host failed $HOST_FAILS times right away (code $rc); normal Game Mode until you sign in again"
      else
        HOST_FAILS=0
      fi
      [ "$rc" -ne 3 ] && return "$rc"
      log "multi-seat host couldn't start; normal Game Mode"
    fi
    seatargs="$(python3 "$SEATS" gamescope-args 2>/dev/null)"
  fi
  # A screen mode gamescope can't start with (-W/-H/-r from Settings › Display) mustn't leave the PC stuck: it's
  # tried once more, and after two failures within seconds those options go and Game Mode starts at the screen's
  # own mode. (Ending the session after the first failure sent the PC back to the sign-in screen, or round and
  # round with automatic sign-in, without ever getting here twice.) Not for an extra multi-seat player: their
  # window size comes from hearth-seats.
  gs_fails=0
  while :; do
    gs_started=$(date +%s)
    # shellcheck disable=SC2086
    gamescope $full $extra $NIMBUS_GAMESCOPE_ARGS $seatargs -- "$WATCHDOG" "$NIMBUS_APP"
    gs_rc=$?
    [ "$gs_rc" -ne 0 ] && [ $(( $(date +%s) - gs_started )) -lt 20 ] && [ -z "$HEARTH_SEAT" ] && [ ! -s "$NEXT" ] && has_mode_args "$NIMBUS_GAMESCOPE_ARGS" || break
    gs_fails=$((gs_fails + 1))
    if [ "$gs_fails" -ge 2 ]; then
      log "gamescope couldn't start with the chosen screen mode ($NIMBUS_GAMESCOPE_ARGS); back to the screen's own mode"
      strip_mode_args "$NIMBUS_GAMESCOPE_ARGS"
      rm -f "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/display-pending.json"
      NIMBUS_GAMESCOPE_ARGS="$(printf ' %s' "$NIMBUS_GAMESCOPE_ARGS" | sed -E "s/$MODE_ARGS_RE/\\1/g")"
      # Options that still name a mode (not ones Hearth wrote) aren't tried over and over.
      has_mode_args "$NIMBUS_GAMESCOPE_ARGS" && break
    else
      log "gamescope ended right away (code $gs_rc) with the chosen screen mode; trying once more"
    fi
  done
  return "$gs_rc"
}

# Games Hearth stopped (Quick Resume's put aside, Pause: SIGSTOP) and still stopped when Desktop Mode starts froze the
# desktop. Hearth ends them when you switch (bridge.rs "power" → library.rs end_stopped); this is the safety net after
# it: this user's stopped processes carrying a game's mark (HEARTH_GAME_ID, or Steam's SteamGameId / SteamAppId) are
# woken, asked to close, and killed after 3 s. Never fails and never waits longer than that.
end_stopped_games() {
  pids=""; me=$(id -u)
  for d in /proc/[0-9]*; do
    [ "$(stat -c %u "$d" 2>/dev/null)" = "$me" ] || continue
    st=$(sed -n 's/^State:[[:space:]]*\([A-Za-z]\).*/\1/p' "$d/status" 2>/dev/null)
    [ "$st" = "T" ] || continue
    tr '\0' '\n' <"$d/environ" 2>/dev/null | grep -qE '^(HEARTH_GAME_ID|SteamGameId|SteamAppId)=[1-9]' || continue
    pids="$pids ${d#/proc/}"
  done
  [ -n "$pids" ] || return 0
  log "desktop mode: ending games still stopped (put aside or paused):$pids"
  kill -CONT $pids 2>/dev/null; kill -TERM $pids 2>/dev/null
  for _ in 1 2 3 4 5 6; do
    left=""; for p in $pids; do [ -d "/proc/$p" ] && left="$left $p"; done
    [ -n "$left" ] || return 0
    sleep 0.5
  done
  log "desktop mode: killing what didn't close:$left"
  kill -KILL $left 2>/dev/null
  return 0
}

# Desktop Mode is Mantel, always (whatever an old session.conf says; see the top).
desktop_choice() { echo classic; }

# Steam Game Mode didn't start and Desktop Mode opened instead: Mantel shows why with a "Try Steam Game Mode again"
# button itself (desktop/shell/SteamFallback.qml). (Hearth Plasma, GNOME and COSMIC got a notify-send instead; they're
# gone, so there's nothing else to do here. Kept as a no-op for the call below.)
steam_notice_other() { return 0; }

run_desktop() {
  log "desktop mode"
  end_stopped_games || true
  run_classic
}

# Hearth Plasma / GNOME / COSMIC's controller helper (desktop/shell/hearth-companion) never starts now; this only
# makes sure one left from before is gone between modes.
companion_stop() {
  pkill -TERM -u "$(id -u)" -f 'desktop/shell/hearth-companion' 2>/dev/null
  return 0
}

run_classic() {
  log "desktop mode: Hearth Classic"
  # Nvidia: wlroots' hardware cursor doesn't show (or doesn't move) on Nvidia's driver, so the pointer draws in
  # software there. Same as every wlroots desktop needs on Nvidia.
  if [ -d /sys/module/nvidia_drm ]; then
    export WLR_NO_HARDWARE_CURSORS=1
    log "nvidia: software cursor"
  fi
  # labwc reads rc.xml, autostart, environment and menu.xml from this folder; your own
  # ~/.config/labwc/rc.xml and autostart are added on top by Nimbus's autostart if they exist.
  # Your keyboard layouts and key repeat (Settings › Keyboard): Hearth's labwc files with yours on top, in $XDG_RUNTIME_DIR.
  CONF="$SHARE/desktop/labwc"
  if [ -f "$SHARE/desktop/shell/hearth-system" ] && have python3; then
    CONF="$(python3 "$SHARE/desktop/shell/hearth-system" labwc-config 2>/dev/null)" || CONF="$SHARE/desktop/labwc"
    [ -f "$CONF/rc.xml" ] || CONF="$SHARE/desktop/labwc"
  fi
  # labwc's own messages (wlroots, the graphics driver) in ~/.local/share/nimbus/labwc.log, which the log report
  # includes; before, they went nowhere anyone could see. The previous one is kept as labwc.log.old.
  LABWC_LOG="$(dirname "$LOG")/labwc.log"
  [ -f "$LABWC_LOG" ] && [ "$(wc -c <"$LABWC_LOG")" -gt 1000000 ] && mv -f "$LABWC_LOG" "$LABWC_LOG.old"
  echo "--- $(date '+%F %T') Desktop Mode" >>"$LABWC_LOG"
  labwc -C "$CONF" >>"$LABWC_LOG" 2>&1
}

# Button remaps for the built-in controller (Settings › Controller), kept applied for the whole session in
# both modes: InputPlumber goes back to its default profile when the controller reconnects (after sleep).
BG_PIDS=""
if [ -z "$HEARTH_SEAT" ] && [ -x "$SHARE/desktop/shell/hearth-controller" ] && have busctl; then
  python3 "$SHARE/desktop/shell/hearth-controller" watch >/dev/null 2>&1 &
  BG_PIDS="$BG_PIDS $!"
fi

# The power button is Hearth's while this session runs (Settings › Power button: sleep, the power menu...).
# Without this the system's own default (logind: shut down) acts on the same press, before Hearth can.
# Bazzite set that in its image; Hearth's own editions don't, so the session asks for it: only while Hearth
# runs, so at the sign-in screen, or if Hearth is gone, the button works the usual way. Holding the button
# for several seconds still turns the device off (that's the firmware's).
if [ -z "$HEARTH_SEAT" ] && have systemd-inhibit; then
  systemd-inhibit --what=handle-power-key:handle-suspend-key --who="Hearth" \
    --why="Hearth handles the power button (Settings › Power button)" --mode=block sleep infinity >/dev/null 2>&1 &
  BG_PIDS="$BG_PIDS $!"
fi
# "Show in folder" / "Open containing folder" in any app opens Hearth Files: org.freedesktop.FileManager1 is
# hearth-portal's for the whole session (both modes), so Dolphin, Nautilus or Thunar, which D-Bus would start for
# that name otherwise, never take over.
if [ -f "$SHARE/desktop/shell/hearth-portal" ] && have python3; then
  python3 "$SHARE/desktop/shell/hearth-portal" filemanager1 --replace >>"$(dirname "$LOG")/portal.log" 2>&1 &
  BG_PIDS="$BG_PIDS $!"
fi
if [ -n "$BG_PIDS" ]; then
  trap 'kill $BG_PIDS 2>/dev/null' EXIT
  trap 'exit 143' INT TERM HUP   # a signal at logout ends the script through EXIT (so the helpers stop too)
fi

# Hearth's look for Qt and GTK apps (Bazaar, Dolphin...), in both modes.
[ -f "$SHARE/desktop/theme/apply.sh" ] && sh "$SHARE/desktop/theme/apply.sh" >/dev/null 2>&1 &

# The power limit you chose last time (a restart resets it on most handhelds).
[ -z "$HEARTH_SEAT" ] && [ -x "$SHARE/desktop/shell/hearth-power" ] && (sleep 12; python3 "$SHARE/desktop/shell/hearth-power" restore) >/dev/null 2>&1 &
# One C: (1.11): every Steam game's Windows setup gets the same drive letters and your own Documents, Desktop, Saved
# Games… (only empty folders and Hearth's own links change: saves already in a game's folder stay where they are).
# In the background, at low priority, after the desktop is up; it never holds anything up.
[ -f "$SHARE/desktop/shell/hearth_drive_letters.py" ] && (sleep 45; nice -n 19 timeout 120 python3 "$SHARE/desktop/shell/hearth_drive_letters.py" map-steam) >/dev/null 2>&1 &

# Aloha Browser, an optional extra (Hearth's own browser is Hearth Browser, Firefox, in the image): when you've
# installed it from Settings › Web browser, it's checked for updates weekly. (Not on the live USB.)
[ -x "$SHARE/desktop/shell/hearth-browser" ] && [ ! -e /etc/hearth-live ] && (sleep 45; python3 "$SHARE/desktop/shell/hearth-browser" ensure) >>"$(dirname "$LOG")/browser.log" 2>&1 &

# Between modes: apps started in one mode belong to its display, which is gone once the mode ends. Steam
# in particular then hangs, and Game Mode's Hearth (which starts Steam in the background) hangs with it.
# Give Steam a moment to close by itself (a couple of seconds, not its whole shutdown), then make sure it
# and the old compositor are gone.
settle() {
  if pgrep -u "$(id -u)" -x steam >/dev/null 2>&1; then
    log "closing Steam left from $1 mode"
    timeout 4 steam -shutdown >/dev/null 2>&1 &
    i=0; while [ $i -lt 10 ] && pgrep -u "$(id -u)" -x steam >/dev/null 2>&1; do sleep 0.25; i=$((i+1)); done
    pkill -TERM -u "$(id -u)" -x steam 2>/dev/null; pkill -TERM -u "$(id -u)" -f steamwebhelper 2>/dev/null
    i=0; while [ $i -lt 6 ] && pgrep -u "$(id -u)" -x steam >/dev/null 2>&1; do sleep 0.25; i=$((i+1)); done
    pkill -KILL -u "$(id -u)" -x steam 2>/dev/null; pkill -KILL -u "$(id -u)" -f steamwebhelper 2>/dev/null
  fi
  pkill -KILL -u "$(id -u)" -x gamescope 2>/dev/null; pkill -KILL -u "$(id -u)" -x gamescope-wl 2>/dev/null
  pkill -KILL -u "$(id -u)" -x labwc 2>/dev/null
  # Desktop Mode's controller and button helpers, if any outlived their mode (Quickshell ended by a signal
  # leaves its children running: hearth-buttons then polled the keys in the next mode, one more each switch).
  companion_stop
  pkill -TERM -u "$(id -u)" -f 'desktop/shell/hearth-pad' 2>/dev/null; pkill -TERM -u "$(id -u)" -x quickshell 2>/dev/null
  pkill -TERM -u "$(id -u)" -f 'desktop/shell/hearth-buttons' 2>/dev/null
  # The controller service back to normal: Hearth (Game Mode) asks it to catch the Xbox button, and a mode that
  # ended without tidying up (closed by force) could leave it catching every button, so nothing but the Xbox
  # button worked in the next mode.
  reset_controllers
  return 0
}
reset_controllers() {
  [ -n "$HEARTH_SEAT" ] && return 0     # multi-seat: InputPlumber is shared, only player 1 resets it
  have busctl || return 0
  # Only where InputPlumber runs (Bazzite). Hearth OS on Anatase uses Handheld Daemon, which Hearth never puts
  # in a catching mode, so there's nothing to reset (and no InputPlumber to wake up over D-Bus).
  busctl --system status org.shadowblip.InputPlumber >/dev/null 2>&1 || return 0
  for d in $(busctl --system --list tree org.shadowblip.InputPlumber 2>/dev/null | grep -o '/org/shadowblip/InputPlumber/CompositeDevice[0-9]*' | sort -u); do
    busctl --system set-property org.shadowblip.InputPlumber "$d" org.shadowblip.Input.CompositeDevice InterceptMode u 0 >/dev/null 2>&1
  done
}

# Hearth Input (Game Mode): a game's controller layout makes the controller a keyboard and mouse while that game
# is in front (desktop/shell/hearth-input). Hearth tells it what to do over a socket only this user can open; it
# lets go of the controller by itself if Hearth stops talking, and ends when this script does. Not for extra
# multi-seat players (its virtual keyboard and mouse would land on player 1's seat).
INPUT_PID=""
input_start() {
  [ -z "$HEARTH_SEAT" ] && [ -f "$SHARE/desktop/shell/hearth-input" ] && have python3 || return 0
  python3 "$SHARE/desktop/shell/hearth-input" serve >>"$(dirname "$LOG")/input.log" 2>&1 &
  INPUT_PID=$!
}
input_stop() {
  [ -n "$INPUT_PID" ] && kill "$INPUT_PID" 2>/dev/null
  INPUT_PID=""
  return 0
}

# >>> steam game mode
# ---- Steam Game Mode (docs/STEAM-GAME-MODE.md): Valve's Steam gamepad UI in gamescope, the way SteamOS runs it, with
# Decky Loader (built in) and Hearth Sync. Hearth OS's Game Mode: where the session starts, and what
# every "game" request opens. Where it goes afterwards (STEAM_BACK: Desktop Mode, or Hearth's own Game Mode with the
# developer switch / on the live USB):
#   Steam or gamescope missing, safe graphics on, or Steam ending with an error within STEAM_MODE_MIN_SECS: STEAM_BACK,
#   with the reason in $RUN/hearth-steam-mode-failed (Mantel shows it with "Try Steam Game Mode again"; Settings too).
#   A Switch asked for (Steam's Switch to Desktop, nimbus-mode desktop/steam/game): that.
#   Steam ending by itself otherwise: Steam Game Mode again (as SteamOS does), unless steam_auto_after says it failed
#   twice (then STEAM_BACK, and it stays there until you try again).
# (test_hearth_steam_mode.py runs these lines, between the >>> and <<< marks.)
STEAM_FLATPAK=com.valvesoftware.Steam
STEAM_MODE_MIN_SECS="${STEAM_MODE_MIN_SECS:-20}"
steam_flatpak() { have flatpak && { [ -d "/var/lib/flatpak/app/$STEAM_FLATPAK" ] || [ -d "$HOME/.local/share/flatpak/app/$STEAM_FLATPAK" ]; }; }
# Flathub's Steam is the one in use: installed, signed in in its own folder, and newer there than the system Steam's
# folder (or that one has no sign-in).
steam_flatpak_in_use() {
  steam_flatpak || return 1
  fl="$HOME/.var/app/$STEAM_FLATPAK/.local/share/Steam/config/loginusers.vdf"
  [ -s "$fl" ] || fl="$HOME/.var/app/$STEAM_FLATPAK/data/Steam/config/loginusers.vdf"
  [ -s "$fl" ] || return 1
  nl="$HOME/.local/share/Steam/config/loginusers.vdf"
  [ -s "$nl" ] || return 0
  [ "$fl" -nt "$nl" ]
}
can_steam_mode() { [ -z "$HEARTH_SEAT" ] && have gamescope && { have steam || steam_flatpak; }; }
# Where the session goes when Steam Game Mode can't run or failed: Desktop Mode (also when you picked Hearth Game Mode:
# Steam Game Mode then ran because you asked for it, or because Hearth Game Mode had failed; never back and forth).
# Hearth Game Mode only on the live USB, where Hearth's app is the installer.
# Came from Server mode (server_return, below): back to Server mode instead.
steam_back() {
  if [ -n "${STEAM_GAME_APPID:-}" ]; then echo hearth   # a Steam game opened from Hearth Game Mode: back there
  elif command -v server_return >/dev/null 2>&1 && server_return; then echo server
  elif command -v live_session >/dev/null 2>&1 && live_session; then echo game; else echo desktop; fi
}
steam_back_name() { case "$(steam_back)" in game|hearth) echo "Hearth's Game Mode" ;; server) echo "Server mode" ;; *) echo "Desktop Mode" ;; esac; }
steam_mode_failed() {
  log "steam game mode: $1; $(steam_back_name) instead"
  echo "$1" >"$RUN/hearth-steam-mode-failed" 2>/dev/null
  [ -n "${STEAM_GAME_APPID:-}" ] && echo "Steam Game Mode didn't start: $1" >"$RUN/hearth-steam-game-failed" 2>/dev/null
  steam_back >"$NEXT"
}
# Why Steam Game Mode can't start at all right now ("" when it can).
# Steam never set up for this account: the system's Steam launcher (Debian's /usr/games/steam) first asks its own
# "Steam installer" question in a window of its own, and Steam Game Mode's gamescope only shows Steam's windows, so the
# question is never seen and the screen stays black, waiting (Hearth 1.0 on a laptop that hadn't used Steam yet).
# Desktop Mode shows that window like any other: open Steam there once, then Game Mode. Only for the system's
# launcher (Flathub's Steam sets itself up without asking); any Steam that has run before has its files here.
STEAM_FIRSTRUN_LAUNCHERS="${HEARTH_STEAM_FIRSTRUN_LAUNCHERS:-/usr/games/steam /usr/bin/steam}"
steam_not_set_up() {
  sb="$(command -v steam 2>/dev/null)" || return 1
  sr="$(readlink -f "$sb" 2>/dev/null || echo "$sb")"
  hit=""
  for l in $STEAM_FIRSTRUN_LAUNCHERS; do [ "$sb" = "$l" ] || [ "$sr" = "$l" ] && hit=1; done
  [ -n "$hit" ] || return 1
  { [ -e /usr/share/nimbus/steam-flatpak ] && steam_flatpak; } && return 1
  steam_flatpak_in_use && return 1
  for d in "$HOME/.local/share/Steam" "$HOME/.steam/debian-installation" "$HOME/.steam/steam" "$HOME/.steam/root"; do
    [ -e "$d/steam.sh" ] || [ -e "$d/ubuntu12_32/steamui.so" ] || [ -s "$d/config/loginusers.vdf" ] && return 1
  done
  return 0
}
steam_cant_reason() {
  if ! can_steam_mode; then echo "Steam or gamescope isn't installed"
  elif [ -f "${HEARTH_SAFE_FLAG:-/run/hearth/safe-graphics}" ]; then echo "safe graphics are on this time"
  elif steam_not_set_up; then echo "Steam isn't set up on this device yet. Open Steam here in Desktop Mode once, answer its questions and sign in, then switch to Game Mode"
  fi
}
# Decky Loader, built into Hearth OS (hearth-decky@.service, docs/STEAM-GAME-MODE.md): its root service runs only while
# Steam Game Mode does, never at boot or in Desktop Mode. systemctl starts your own instance without a password
# (49-hearth-decky.rules); the service brings Hearth Sync up to date and removes an install from before. Steam's CEF
# remote debugging flag and ~/homebrew are made here first, before Steam starts (Steam reads the flag when it starts).
# A Decky from its own installer (plugin_loader.service) runs by itself and is left alone. Older images: Hearth's
# downloaded install (hearth-admin decky-install), through pkexec as before. Never waited on for long, never fatal.
DECKY_UNIT="${HEARTH_DECKY_UNIT:-/etc/systemd/system/hearth-decky.service}"
DECKY_BUILTIN="${HEARTH_DECKY_BUILTIN:-/usr/lib/systemd/system/hearth-decky@.service}"
DECKY_UPSTREAM="${HEARTH_DECKY_UPSTREAM:-/etc/systemd/system/plugin_loader.service}"
decky_user_side() {
  mkdir -p "$HOME/homebrew/settings" "$HOME/homebrew/data" "$HOME/homebrew/logs" 2>/dev/null || return 0
  made=""
  for f in "$HOME/.steam/steam/.cef-enable-remote-debugging" "$HOME/.var/app/com.valvesoftware.Steam/data/Steam/.cef-enable-remote-debugging"; do
    d="${f%/*}"
    case "$f" in *com.valvesoftware.Steam*) [ -d "$d" ] || continue ;; esac
    [ -e "$f" ] && continue
    mkdir -p "$d" 2>/dev/null && : >"$f" 2>/dev/null && made="$made$f
"
  done
  [ -n "$made" ] && printf '%s' "$made" >>"$HOME/homebrew/.hearth-made-this" 2>/dev/null
  return 0
}
decky_ctl() {
  [ -f "$DECKY_UPSTREAM" ] && return 0
  if [ -f "$DECKY_BUILTIN" ] && have systemctl; then
    du="${USER:-$(id -un 2>/dev/null)}"
    [ -n "$du" ] || return 0
    [ "$1" = start ] && decky_user_side
    timeout 20 systemctl --no-ask-password "$1" "hearth-decky@$du.service" >/dev/null 2>&1 \
      || log "steam game mode: decky $1 didn't work (Steam Game Mode goes on without Decky)"
    return 0
  fi
  [ -f "$DECKY_UNIT" ] && [ -x /usr/libexec/nimbus/hearth-admin ] && have pkexec || return 0
  timeout 15 pkexec /usr/libexec/nimbus/hearth-admin "decky-$1" >/dev/null 2>&1 || log "steam game mode: decky-$1 didn't work (Steam Game Mode goes on without Decky)"
  return 0
}
# Right after the PC starts, Steam often came up before Wi-Fi had connected (bug hunt, the owner's laptop: "Download
# failed: http error 0", "LogonFailure No Connection" at every start, then back to Desktop Mode). In the first minutes
# after start only, and only when NetworkManager runs, Steam waits until NetworkManager has finished bringing up the
# connections it knows (nm-online -s), at most HEARTH_STEAM_NET_WAIT seconds (20; 0 turns it off). A PC that's offline
# just waits that long once; Steam Game Mode always starts.
steam_wait_network() {
  w="${HEARTH_STEAM_NET_WAIT:-20}"
  case "$w" in ''|*[!0-9]*) w=20 ;; esac
  [ "$w" -gt 0 ] && [ "$w" -le 60 ] || return 0
  have nm-online || return 0
  up=$(cut -d. -f1 "${HEARTH_UPTIME_FILE:-/proc/uptime}" 2>/dev/null)
  case "$up" in ''|*[!0-9]*) return 0 ;; esac
  [ "$up" -lt "${HEARTH_STEAM_NET_WINDOW:-180}" ] || return 0
  if timeout $((w + 2)) nm-online -s -q -t "$w" >/dev/null 2>&1; then log "steam game mode: network ready"
  else log "steam game mode: no network after ${w}s; starting Steam offline"; fi
  return 0
}
# Hearth's core without a window (nimbus --core-service, hearth-core core_service.rs): live answers for the Hearth
# plugin (Hearth in Steam's main menu, Quick Access and in-game overlay) over a socket only this user can open. It
# ends by itself when the running mark goes away, and is stopped with Steam. It never controls gamescope's focus,
# padmouse, Steam or InputPlumber, and has no controllers. Never waited on, never fatal: if it doesn't start, Steam
# Game Mode goes on and the plugin asks Hearth's command line as before. HEARTH_STEAM_CORE=0 (session.conf) leaves it out.
STEAM_CORE_PID=""
steam_core_start() {
  [ -z "$HEARTH_SEAT" ] && [ "${HEARTH_STEAM_CORE:-1}" != 0 ] && have nimbus || return 0
  # Only a Hearth that knows --core-service (an older one would open its whole window instead).
  core_app="$(command -v nimbus)"
  grep -qaF -- '--core-service' "$core_app" 2>/dev/null || { log "steam game mode: this Hearth has no core service"; return 0; }
  "$core_app" --core-service --while "$RUN/hearth-steam-mode.pid" >>"${LOG%/*}/core-service.log" 2>&1 </dev/null &
  STEAM_CORE_PID=$!
  log "steam game mode: Hearth's core started without a window (pid $STEAM_CORE_PID)"
  return 0
}
steam_core_stop() {
  [ -n "$STEAM_CORE_PID" ] && kill "$STEAM_CORE_PID" 2>/dev/null
  STEAM_CORE_PID=""
  return 0
}
# Hearth Input (the same mapper as Hearth's Game Mode, input_start): it holds a controller only while Hearth's core
# says a game with a Hearth Input layout is in front, and lets go by itself when nobody tells it anything.
steam_input_start() { [ "${HEARTH_STEAM_CORE:-1}" != 0 ] && command -v input_start >/dev/null 2>&1 && input_start; return 0; }
steam_input_stop() { command -v input_stop >/dev/null 2>&1 && input_stop; return 0; }
# Multi-seat beside Steam Game Mode (docs/STEAM-GAME-MODE.md "Multi-seat"): player 1 plays in Steam's Game Mode while the
# extra players keep their own Hearth Game Mode (their own accounts and sessions, hearth-seat@.service; nothing here starts,
# stops or waits for them). Only when multi-seat is set up and on, so without it Steam Game Mode starts exactly as before:
#  * a graphics card per player: player 1's gamescope stays on player 1's card (hearth-seats gamescope-args);
#  * other screens of player 1's card or a split screen: Steam's gamescope runs inside the same host as Hearth's Game Mode
#    (hearth-seats host, labwc over every screen), so the others keep their screens; if the host can't start (exit 3, or
#    it pauses itself after failing twice) Steam Game Mode starts as usual without it. HEARTH_STEAM_SEATS_HOST=0
#    (session.conf) leaves the host out;
#  * no performance overlay while multi-seat is on (mangoapp reads the other players' processes and fell over).
# Every call is time-limited and its failure ignored: none of it can stop Steam Game Mode from starting.
STEAM_SEATS="${HEARTH_SEATS_HELPER:-/usr/libexec/nimbus/hearth-seats}"
STEAM_SEATS_CONFIG="${HEARTH_SEATS_CONFIG:-/etc/hearth/seats.json}"
# Multi-seat is dropped for now (HEARTH_LEGACY_MULTIPLAYER=1 brings it back): off, so none of this runs.
steam_seats_on() { [ "${HEARTH_LEGACY_MULTIPLAYER:-0}" = 1 ] && [ -z "$HEARTH_SEAT" ] && [ -f "$STEAM_SEATS" ] && have python3 && grep -Eq '"enabled": *true' "$STEAM_SEATS_CONFIG" 2>/dev/null; }
run_steam_mode() {
  log "steam game mode"
  rm -f "$RUN/hearth-steam-mode-failed"
  started=$(date +%s); next_now=""
  why="$(steam_cant_reason)"
  if [ -n "$why" ]; then steam_mode_failed "$why"; return 0; fi
  NIMBUS_GAMESCOPE_ARGS="$ENV_GAMESCOPE_ARGS"
  # shellcheck source=/dev/null
  [ -f "$SESSION_CONF" ] && . "$SESSION_CONF"
  # Hearth Recovery › Safe graphics this time: the screen's own mode here too.
  if [ -f /run/hearth/safe-graphics ] && [ -n "$MODE_ARGS_RE" ]; then
    NIMBUS_GAMESCOPE_ARGS=$(printf ' %s\n' "$NIMBUS_GAMESCOPE_ARGS" | sed -E "s/$MODE_ARGS_RE/\\1/g")
  fi
  # (The screen-mode helpers are defined above this block: present in the session, absent in the block's own tests.)
  if command -v mode_not_listed >/dev/null 2>&1 && mode_not_listed "$NIMBUS_GAMESCOPE_ARGS"; then
    NIMBUS_GAMESCOPE_ARGS=$(printf ' %s\n' "$NIMBUS_GAMESCOPE_ARGS" | sed -E "s/$MODE_ARGS_RE/\\1/g")
  fi
  command -v panel_script >/dev/null 2>&1 && panel_script
  # Steam's "Switch to Desktop" (and Game Mode) runs steamos-session-select: Hearth's own comes first on Steam's PATH and
  # asks this session (nothing about the login screen or the next start changes).
  sbin="$RUN/hearth-steam-bin"; mkdir -p "$sbin"
  # Every call is written to the session log with what asked (bug hunt: Steam Game Mode went back to Desktop Mode
  # ~30 s after starting on all three of the owner's devices, logged only as "desktop asked for"). Only the desktop
  # sessions SteamOS's own script knows switch to Desktop Mode; anything else is logged and changes nothing (before,
  # every unknown or empty argument meant Desktop Mode).
  cat >"$sbin/steamos-session-select" <<SHIM
#!/bin/sh
# Hearth (nimbus-session): Steam Game Mode's Switch to Desktop / Game Mode
parent=\$(ps -o comm= -p "\$PPID" 2>/dev/null)
echo "\$(date '+%F %T') steam game mode: steamos-session-select \$* (from \${parent:-?})" >>"$LOG" 2>/dev/null
case "\$1" in
  gamescope*|game*) exec nimbus-mode game ;;
  plasma*|desktop*|*wayland*|*x11*|kde*|gnome*|mantel*|labwc*) exec nimbus-mode desktop ;;
  *) echo "\$(date '+%F %T') steam game mode: steamos-session-select: \"\$1\" isn't a session Hearth knows; nothing changed" >>"$LOG" 2>/dev/null; exit 0 ;;
esac
SHIM
  chmod 755 "$sbin/steamos-session-select"
  # Steam's Settings › System › Check for updates runs steamos-update: Hearth's (hearth-steamos-update) updates Hearth OS
  # the way Settings › Updates does, never restarts by itself. Only on Steam's PATH for this run, nothing system-wide.
  supd="${HEARTH_STEAMOS_UPDATE:-/usr/libexec/nimbus/hearth-steamos-update}"
  if [ -x "$supd" ]; then
    printf '#!/bin/sh\n# Hearth (nimbus-session): Steam Game Mode'"'"'s OS update check\nexec %s "$@"\n' "$supd" >"$sbin/steamos-update"
    chmod 755 "$sbin/steamos-update"
  fi
  # The system's Steam (both editions), unless it's Hearth's stand-in that starts Flathub's (Anatase without RPM Fusion),
  # or Flathub's Steam is the one in use here (its games and sign-in are in its own folder: the system's would show none).
  if have steam && { [ ! -e /usr/share/nimbus/steam-flatpak ] || ! steam_flatpak; } && ! steam_flatpak_in_use; then
    set -- env PATH="$sbin:$PATH" steam
  else
    # Flathub's Steam: the same through flatpak-spawn --host, given for this run only (no lasting flatpak override).
    printf '#!/bin/sh\nexec flatpak-spawn --host nimbus-mode "$@"\n' >"$sbin/nimbus-mode"; chmod 755 "$sbin/nimbus-mode"
    [ -f "$sbin/steamos-update" ] && { printf '#!/bin/sh\nexec flatpak-spawn --host %s "$@"\n' "$supd" >"$sbin/steamos-update"; chmod 755 "$sbin/steamos-update"; }
    set -- flatpak run --talk-name=org.freedesktop.Flatpak --filesystem="$sbin:ro" --env=PATH="$sbin:/app/bin:/app/utils/bin:/usr/bin" "$STEAM_FLATPAK"
  fi
  sextra=""
  have mangoapp && sextra="--mangoapp"
  sseat=""; shost=""
  if steam_seats_on; then
    sextra=""
    sseat="$(timeout 10 python3 "$STEAM_SEATS" gamescope-args 2>/dev/null)" || sseat=""
    if [ "${HEARTH_STEAM_SEATS_HOST:-1}" != 0 ] && timeout 10 python3 "$STEAM_SEATS" host-check 2>/dev/null; then
      shost=1; log "steam game mode: multi-seat: hosting the other players' screens"
    fi
  fi
  # Hearth's startup animation (Settings › Boot & startup, hearth-boot-look): the chosen one into Steam's override folder.
  # Time-limited, never fatal: Steam starts the same way whatever happens here.
  bl=/usr/libexec/nimbus/hearth-boot-look
  if [ -f "$bl" ] && have python3; then timeout 10 python3 "$bl" movie-apply >/dev/null 2>&1 || log "steam game mode: startup animation not applied"; fi
  steam_wait_network
  decky_ctl start
  echo $$ >"$RUN/hearth-steam-mode.pid"
  # A Steam game opened from Hearth Game Mode (the steam game block): Steam starts it straight away, and the watcher
  # brings Hearth Game Mode back when it has ended.
  sgarg=""
  if [ -n "${STEAM_GAME_APPID:-}" ]; then
    sgarg="steam://rungameid/$STEAM_GAME_APPID"
    echo "$STEAM_GAME_APPID" >"$RUN/hearth-steam-game-active" 2>/dev/null
    log "steam game mode: for one game ($STEAM_GAME_APPID), then back to Hearth Game Mode"
    command -v steam_game_watch >/dev/null 2>&1 && steam_game_watch "$STEAM_GAME_APPID"
  fi
  steam_core_start
  steam_input_start
  # A chosen screen mode gamescope can't start with (it ends within seconds): that mode goes, as in Hearth's Game Mode
  # (strip_mode_args: kept in display-reverted.json, Game Mode says so with "Try again"), and Steam Game Mode starts
  # once more at the screen's own mode, instead of counting as Steam failing.
  s_retry=1
  while :; do
  started=$(date +%s)
  # What gamescope-session-steam (SteamOS, Bazzite, ChimeraOS) tells Steam, in a subshell so nothing stays for later modes.
  # shellcheck disable=SC2086
  (
    # STEAM_MULTIPLE_XWAYLANDS=1 makes Steam start games on gamescope's second X display, so gamescope must make one
    # (--xwayland-count 2, as gamescope-session-steam does); without it Steam's games never start.
    export STEAM_MULTIPLE_XWAYLANDS=1 STEAM_GAMESCOPE_VRR_SUPPORTED=1 STEAM_ENABLE_VOLUME_HANDLER=1 SRT_URLOPEN_PREFER_STEAM=1 \
      STEAM_DISABLE_MANGOAPP_ATOM_WORKAROUND=1 ENABLE_GAMESCOPE_WSI=1 SDL_VIDEO_MINIMIZE_ON_FOCUS_LOSS=0 HEARTH_STEAM_MODE=1
    if [ -n "$sextra" ]; then export STEAM_USE_MANGOAPP=1 STEAM_MANGOAPP_PRESETS_SUPPORTED=1 MANGOHUD_CONFIGFILE="$RUN/hearth-steam-mangohud.conf"; : >"$MANGOHUD_CONFIGFILE"; fi
    if [ -n "$shost" ]; then
      python3 "$STEAM_SEATS" host -- gamescope -e -f --xwayland-count 2 $NIMBUS_GAMESCOPE_ARGS -- "$@" -gamepadui -steamos3 -steampal $sgarg
      hrc=$?
      [ "$hrc" -ne 3 ] && exit "$hrc"
      log "steam game mode: multi-seat host couldn't start; Steam Game Mode without it"
    fi
    exec gamescope -e -f --xwayland-count 2 $sextra $NIMBUS_GAMESCOPE_ARGS $sseat -- "$@" -gamepadui -steamos3 -steampal $sgarg
  )
  rc=$?
  [ "$rc" -ne 0 ] && [ "$s_retry" = 1 ] && [ $(( $(date +%s) - started )) -lt "$STEAM_MODE_MIN_SECS" ] && [ ! -s "$NEXT" ] \
    && command -v has_mode_args >/dev/null 2>&1 && has_mode_args "$NIMBUS_GAMESCOPE_ARGS" || break
  s_retry=0
  log "steam game mode: gamescope couldn't start with the chosen screen mode (code $rc, $NIMBUS_GAMESCOPE_ARGS); once more at the screen's own mode"
  strip_mode_args "$NIMBUS_GAMESCOPE_ARGS"
  rm -f "$(dirname "$SESSION_CONF")/display-pending.json"
  NIMBUS_GAMESCOPE_ARGS="$(printf ' %s' "$NIMBUS_GAMESCOPE_ARGS" | sed -E "s/$MODE_ARGS_RE/\\1/g")"
  has_mode_args "$NIMBUS_GAMESCOPE_ARGS" && break
  done
  rm -f "$RUN/hearth-steam-mode.pid" "$RUN/hearth-steam-game-active"
  command -v steam_game_unwatch >/dev/null 2>&1 && steam_game_unwatch
  steam_core_stop
  steam_input_stop
  decky_ctl stop &
  next_now="$(cat "$NEXT" 2>/dev/null)"
  case "$next_now" in
    game|desktop|steam|server|logout|hearth|steamgame) log "steam game mode ended (code $rc); $next_now asked for" ;;
    *)
      if [ "$rc" -ne 0 ] && [ $(( $(date +%s) - started )) -lt "$STEAM_MODE_MIN_SECS" ]; then steam_mode_failed "Steam ended right away (code $rc)"
      elif [ -n "${STEAM_GAME_APPID:-}" ]; then log "steam game mode ended by itself (code $rc) while it was for one game; back to Hearth Game Mode"; echo hearth >"$NEXT"
      elif [ "$(steam_back)" = game ]; then log "steam game mode ended (code $rc); Hearth's Game Mode next"; echo game >"$NEXT"
      else log "steam game mode ended by itself (code $rc); Steam Game Mode again"; echo steam >"$NEXT"; fi ;;
  esac
  return 0
}
# ---- Steam Game Mode failing twice (docs/STEAM-GAME-MODE.md "When Steam Game Mode can't start"): every Steam Game Mode
# run is counted as a failure first ($SD_FAILS, a time per line) and cleared by a good one (still running after
# STEAM_DEFAULT_GOOD_SECS, or a Switch you asked for), so a start that hangs or takes the device down counts too. Two
# failures within STEAM_DEFAULT_WINDOW: Steam Game Mode is paused ($SD_STATE/steam-default-off, the reason inside) and
# the session opens Desktop Mode, at once and at every start after, until you try again (Mantel's "Try Steam Game
# Mode again", Game Mode buttons, `nimbus-mode steam`): a request you make always runs, and a good run ends the pause.
# The session never goes back and forth between Steam Game Mode and Desktop Mode by itself.
STEAM_DEFAULT_GOOD_SECS="${STEAM_DEFAULT_GOOD_SECS:-120}"
STEAM_DEFAULT_WINDOW="${STEAM_DEFAULT_WINDOW:-600}"
SD_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/nimbus"
SD_FAILS="$SD_STATE/steam-default-fails"
SD_OFF="$SD_STATE/steam-default-off"
steam_paused() { [ -s "$SD_OFF" ]; }
steam_pause() {
  log "steam game mode: paused: $1; Desktop Mode until you try Steam Game Mode again"
  mkdir -p "$SD_STATE" 2>/dev/null; echo "$1" >"$SD_OFF" 2>/dev/null
  echo "$1" >"$RUN/hearth-steam-mode-failed" 2>/dev/null
  rm -f "$SD_FAILS"
}
steam_unpause() { rm -f "$SD_OFF" "$SD_FAILS"; }
# The failed runs in the last STEAM_DEFAULT_WINDOW (printed, one time per line).
steam_recent_fails() {
  now=$(date +%s)
  [ -f "$SD_FAILS" ] || return 0
  while read -r t; do
    case "$t" in ''|*[!0-9]*) continue ;; esac
    [ $(( now - t )) -lt "$STEAM_DEFAULT_WINDOW" ] && echo "$t"
  done <"$SD_FAILS"
  return 0
}
# B or Guide held on a controller during the first seconds (hearth-pad-held reads the buttons' state, like Hearth
# Recovery does; nothing else is read or changed).
steam_skip_held() {
  ph="${HEARTH_PAD_HELD:-/usr/libexec/nimbus/hearth-pad-held}"
  [ -f "$ph" ] && have python3 && timeout 6 python3 "$ph" --window 2.5 >/dev/null 2>&1
}
# Where the session starts when it would start in Steam Game Mode: prints steam or desktop (and why, in the log and
# the failure note). Desktop Mode with hearth.mode=desktop on the kernel command line, B or Guide held as the session
# starts, Steam Game Mode paused, two failed starts in the window, or Steam unable to run at all.
steam_start_mode() {
  if grep -qwF hearth.mode=desktop "${HEARTH_CMDLINE:-/proc/cmdline}" 2>/dev/null; then
    log "start: hearth.mode=desktop on the kernel command line; Desktop Mode this time"; echo desktop; return 0
  fi
  if steam_skip_held; then log "start: B or Guide held; Desktop Mode this time"; echo desktop; return 0; fi
  if steam_paused; then
    log "start: Steam Game Mode is paused ($(cat "$SD_OFF")); Desktop Mode"
    echo "$(cat "$SD_OFF")" >"$RUN/hearth-steam-mode-failed" 2>/dev/null; echo desktop; return 0
  fi
  if [ "$(steam_recent_fails | grep -c .)" -ge 2 ]; then
    steam_pause "Steam Game Mode didn't start properly twice within $(( STEAM_DEFAULT_WINDOW / 60 )) minutes"; echo desktop; return 0
  fi
  why="$(steam_cant_reason)"
  if [ -n "$why" ]; then log "start: steam game mode: $why; Desktop Mode instead"; echo "$why" >"$RUN/hearth-steam-mode-failed" 2>/dev/null; echo desktop; return 0; fi
  echo steam
}
# Before each Steam Game Mode run: this run counted as a failure until it proves good.
SD_TIMER=""
steam_auto_before() {
  mkdir -p "$SD_STATE" 2>/dev/null
  kept="$(steam_recent_fails)"
  printf '%s%s\n' "${kept:+$kept
}" "$(date +%s)" >"$SD_FAILS" 2>/dev/null
  # A run still going after STEAM_DEFAULT_GOOD_SECS is a good one, even if the device is turned off from Steam later.
  ( sleep "$STEAM_DEFAULT_GOOD_SECS"; [ -f "$RUN/hearth-steam-mode.pid" ] && rm -f "$SD_FAILS" "$SD_OFF" ) >/dev/null 2>&1 &
  SD_TIMER=$!
  return 0
}
# After it: uses run_steam_mode's own started / next_now and its failure note. Two failures: paused, Desktop Mode.
steam_auto_after() {
  [ -n "$SD_TIMER" ] && kill "$SD_TIMER" 2>/dev/null; SD_TIMER=""
  n=$(steam_recent_fails | grep -c .)
  if [ -s "$RUN/hearth-steam-mode-failed" ]; then
    [ "$n" -ge 2 ] && steam_pause "$(cat "$RUN/hearth-steam-mode-failed") (twice within $(( STEAM_DEFAULT_WINDOW / 60 )) minutes)"
    return 0
  fi
  ran=$(( $(date +%s) - ${started:-0} ))
  if [ "$ran" -ge "$STEAM_DEFAULT_GOOD_SECS" ]; then steam_unpause; return 0; fi
  case "$next_now" in
    game|desktop|steam|server|logout|hearth|steamgame)   # a Switch you asked for: not a failure
      [ -f "$SD_FAILS" ] && { sed '$d' "$SD_FAILS" >"$SD_FAILS.new" && mv -f "$SD_FAILS.new" "$SD_FAILS"; }
      rm -f "$SD_OFF"; return 0 ;;
  esac
  if [ "$n" -ge 2 ]; then
    steam_pause "Steam Game Mode closed by itself twice within $(( STEAM_DEFAULT_WINDOW / 60 )) minutes"
    steam_back >"$NEXT"
  else log "steam game mode: closed by itself after ${ran}s ($n of 2 before Desktop Mode takes over)"; fi
  return 0
}
# <<< steam game mode

# >>> server mode
# ---- Server mode (docs/SERVER-MODE.md, Hearth 1.6): a third mode next to Steam Game Mode and Desktop Mode, off until you
# turn it on (Settings › Home server › Server mode). A small labwc (its own config, desktop/server/labwc: no taskbar, no
# menu, no keys) with one full-screen dashboard (Quickshell, desktop/shell/server-mode.qml). The home server's services
# run as their own units underneath; the dashboard only shows and controls them. Every way out of it ends in Game Mode:
#   Server mode off, labwc / Quickshell / its files missing, an extra multi-seat player: Game Mode, with the reason in
#   $RUN/hearth-server-mode-failed.
#   The dashboard never appearing (SERVER_UP_SECS), closing right away or crashing three times (the autostart gives up
#   and leaves $RUN/hearth-server-dash-failed), or labwc ending without a switch asked for: Game Mode.
#   Two failed runs within SERVER_WINDOW: Server mode is paused (Game Mode at every start) until you open it yourself
#   (nimbus-mode server, Settings' Open now) or a run goes well (still up after SERVER_GOOD_SECS).
# The PC stays awake in Server mode (systemd-inhibit idle:sleep, unless you chose Sleep after idle in Settings). Leaving
# Server mode for Game Mode leaves a mark ($RUN/hearth-server-return): Steam Game Mode's "Switch to Desktop" (and Steam
# Game Mode not starting) then comes back to Server mode, as the owner asked; the dashboard's menu has Desktop Mode.
# (test_hearth_server_mode.py runs these lines, between the >>> and <<< marks.)
SERVER_HELPER="${HEARTH_SERVER_HELPER:-$SHARE/desktop/shell/hearth-server-mode}"
SERVER_QML="${HEARTH_SERVER_QML:-$SHARE/desktop/shell/server-mode.qml}"
SERVER_LABWC="${HEARTH_SERVER_LABWC:-$SHARE/desktop/server/labwc}"
SERVER_UP_SECS="${SERVER_UP_SECS:-60}"
SERVER_GOOD_SECS="${SERVER_GOOD_SECS:-120}"
SERVER_WINDOW="${SERVER_WINDOW:-600}"
SV_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/nimbus"
SV_FAILS="$SV_STATE/server-mode-fails"
SV_OFF="$SV_STATE/server-mode-off"
server_helper() { [ -f "$SERVER_HELPER" ] && have python3 && timeout 15 python3 "$SERVER_HELPER" "$@" 2>/dev/null; }
server_enabled() { [ -z "$HEARTH_SEAT" ] && [ "$(server_helper session-check)" = on ]; }
server_cant_reason() {
  if [ -n "$HEARTH_SEAT" ]; then echo "Server mode is only for the first player"
  elif ! have labwc || ! have quickshell; then echo "labwc or Quickshell isn't installed"
  elif [ ! -f "$SERVER_QML" ] || [ ! -f "$SERVER_LABWC/rc.xml" ] || [ ! -f "$SERVER_LABWC/autostart" ]; then echo "Server mode's files are missing"
  elif ! server_enabled; then echo "Server mode is off (Settings › Home server › Server mode)"
  fi
}
# Server mode can't run or failed: Game Mode, always (never no screen, never back to Server mode by itself).
server_failed() {
  log "server mode: $1; Game Mode instead"
  echo "$1" >"$RUN/hearth-server-mode-failed" 2>/dev/null
  echo game >"$NEXT"
}
server_recent_fails() {
  now=$(date +%s)
  [ -f "$SV_FAILS" ] || return 0
  while read -r t; do
    case "$t" in ''|*[!0-9]*) continue ;; esac
    [ $(( now - t )) -lt "$SERVER_WINDOW" ] && echo "$t"
  done <"$SV_FAILS"
  return 0
}
# Where the session starts when it would start in Server mode: prints server, or desktop / game (and why, in the log).
server_start_mode() {
  if grep -qwF hearth.mode=desktop "${HEARTH_CMDLINE:-/proc/cmdline}" 2>/dev/null; then
    log "start: hearth.mode=desktop on the kernel command line; Desktop Mode this time"; echo desktop; return 0
  fi
  if command -v steam_skip_held >/dev/null 2>&1 && steam_skip_held; then log "start: B or Guide held; Desktop Mode this time"; echo desktop; return 0; fi
  if [ -s "$SV_OFF" ]; then log "start: Server mode is paused ($(cat "$SV_OFF")); Game Mode"; echo game; return 0; fi
  if [ "$(server_recent_fails | grep -c .)" -ge 2 ]; then
    mkdir -p "$SV_STATE" 2>/dev/null
    echo "Server mode didn't start properly twice within $(( SERVER_WINDOW / 60 )) minutes" >"$SV_OFF"
    log "start: Server mode failed twice; paused, Game Mode"; echo game; return 0
  fi
  why="$(server_cant_reason)"
  if [ -n "$why" ]; then log "start: server mode: $why; Game Mode instead"; echo "$why" >"$RUN/hearth-server-mode-failed" 2>/dev/null; echo game; return 0; fi
  echo server
}
run_server() {
  log "server mode"
  rm -f "$RUN/hearth-server-mode-failed" "$RUN/hearth-server-dash-failed" "$RUN/hearth-server-dash-up"
  why="$(server_cant_reason)"
  if [ -n "$why" ]; then server_failed "$why"; return 0; fi
  rm -f "$NEXT"     # only a switch asked for during this run counts
  # This run counts as a failure until it proves good (still up after SERVER_GOOD_SECS, or a switch you asked for).
  mkdir -p "$SV_STATE" 2>/dev/null
  kept="$(server_recent_fails)"
  printf '%s%s\n' "${kept:+$kept
}" "$(date +%s)" >"$SV_FAILS" 2>/dev/null
  # Back from Game Mode: the mark becomes the dashboard's "Back in Server mode" (how long you played).
  [ -e "$RUN/hearth-server-return" ] && mv -f "$RUN/hearth-server-return" "$RUN/hearth-server-back" 2>/dev/null
  echo $$ >"$RUN/hearth-server-mode.pid"
  started=$(date +%s)
  # Stays awake in Server mode (idle and sleep held off while it runs), unless you chose Sleep after idle.
  ipid=""
  if have systemd-inhibit && [ "$(server_helper sleep-idle)" != on ]; then
    # (It holds the lock while the pid file is there: nothing is left behind when Server mode ends.)
    systemd-inhibit --what=idle:sleep --who="Hearth" --why="Server mode: your services stay reachable" --mode=block \
      sh -c 'while [ -e "$0" ]; do sleep 5; done' "$RUN/hearth-server-mode.pid" >/dev/null 2>&1 &
    ipid=$!
  fi
  # The web page's requests and the schedule (one agent per sign-in; it ends by itself when nothing needs it).
  if [ -f "$SERVER_HELPER" ] && have python3; then python3 "$SERVER_HELPER" agent >/dev/null 2>&1 & fi
  SERVER_LOG="$(dirname "$LOG")/server-mode.log"
  [ -f "$SERVER_LOG" ] && [ "$(wc -c <"$SERVER_LOG")" -gt 1000000 ] && mv -f "$SERVER_LOG" "$SERVER_LOG.old"
  echo "--- $(date '+%F %T') Server mode" >>"$SERVER_LOG"
  [ -d /sys/module/nvidia_drm ] && export WLR_NO_HARDWARE_CURSORS=1
  HEARTH_SERVER_MODE=1 HEARTH_SERVER_QML="$SERVER_QML" HEARTH_SERVER_LOG="$SERVER_LOG" labwc -C "$SERVER_LABWC" >>"$SERVER_LOG" 2>&1 &
  lpid=$!
  # The dashboard must say it's up (server-mode.qml writes $RUN/hearth-server-dash-up) within SERVER_UP_SECS, or labwc is
  # closed and Game Mode starts: a black screen never stays.
  (
    i=0
    while [ "$i" -lt "$SERVER_UP_SECS" ]; do
      [ -e "$RUN/hearth-server-dash-up" ] && exit 0
      kill -0 "$lpid" 2>/dev/null || exit 0
      sleep 1; i=$((i + 1))
    done
    echo "Server mode's dashboard didn't appear within $SERVER_UP_SECS seconds" >"$RUN/hearth-server-dash-failed"
    kill -TERM "$lpid" 2>/dev/null; sleep 4; kill -KILL "$lpid" 2>/dev/null
  ) &
  wpid=$!
  wait "$lpid"; rc=$?
  kill "$wpid" 2>/dev/null
  [ -n "$ipid" ] && kill "$ipid" 2>/dev/null
  rm -f "$RUN/hearth-server-mode.pid" "$RUN/hearth-server-dash-up"
  # Power limits back to how they were, the screen on (never waited on for long, never fatal).
  server_helper leaving >/dev/null
  ran=$(( $(date +%s) - started ))
  next_now="$(cat "$NEXT" 2>/dev/null)"
  case "$next_now" in
    game|steam|desktop|server|logout|hearth|steamgame)
      log "server mode ended (code $rc); $next_now asked for"
      # A switch you asked for (or a good run): not a failure.
      [ -f "$SV_FAILS" ] && { sed '$d' "$SV_FAILS" >"$SV_FAILS.new" && mv -f "$SV_FAILS.new" "$SV_FAILS"; }
      rm -f "$SV_OFF"
      case "$next_now" in game|steam|hearth) : >"$RUN/hearth-server-return" ;; esac ;;
    *)
      if [ -s "$RUN/hearth-server-dash-failed" ]; then server_failed "$(head -c 300 "$RUN/hearth-server-dash-failed")"
      elif [ "$ran" -lt 20 ]; then server_failed "Server mode closed right away (code $rc)"
      else server_failed "Server mode closed by itself after ${ran}s (code $rc)"; fi ;;
  esac
  [ "$ran" -ge "$SERVER_GOOD_SECS" ] && rm -f "$SV_FAILS" "$SV_OFF"
  return 0
}
# A request for Server mode you make yourself (nimbus-mode server) always runs: the pause after two failures ends.
server_unpause() { rm -f "$SV_OFF" "$SV_FAILS"; }
# Leaving Game Mode after coming from Server mode goes back to Server mode (Steam's "Switch to Desktop" asks for
# desktop): only while the mark is there and Server mode itself didn't fail this time.
server_return() {
  [ -e "$RUN/hearth-server-return" ] && [ ! -s "$RUN/hearth-server-mode-failed" ] && [ -z "$HEARTH_SEAT" ]
}
# <<< server mode

# >>> game mode choice
# ---- Which Game Mode (docs/HEARTH-GAME-MODE.md, Hearth 1.10): Steam Game Mode (the default, today's) or Hearth Game Mode
# (Hearth's own screens in gamescope: run_game with the watchdog), picked in Settings › Gaming › Game Mode (also Hearth
# Game Mode's Settings › System and Hearth Sync in Steam Game Mode's Quick Access). One source of truth: the
# HEARTH_GAME_MODE_CHOICE line of session.conf, written only by desktop/shell/hearth-game-mode when you pick one, read
# here every time Game Mode starts (game_mode_choice), so a new choice applies the next time Game Mode starts.
# Nothing here ever writes it. When Hearth Game Mode can't start, the session falls back for that start and says so:
#   gamescope or Hearth's app missing, Hearth's app crashing (the watchdog gives up: $RUN/hearth-game-mode-crashed),
#   Hearth Game Mode closing within HGM_MIN_SECS without a switch asked for, or two failed runs within HGM_WINDOW
#   (then it's paused: $HGM_OFF, the reason inside; every Game Mode start falls back until you try it again yourself,
#   `nimbus-mode hearth`, or a run goes well):
#   Steam Game Mode, when it can run and hasn't just failed or been paused; else Desktop Mode (Mantel). From there,
#   Steam Game Mode failing goes to Desktop Mode as always (steam_back). Never back to Hearth Game Mode by itself.
#   The reason goes to $HGM_NOTE (Hearth Sync's toast in Steam Game Mode, Mantel's notice, Settings) and the session log
#   (Send logs). Your choice stays Hearth Game Mode.
# Every Hearth Game Mode run counts as a failure until it has run HGM_GOOD_SECS or you switched on purpose (so a start
# that hangs or takes the device down counts too, across restarts). Hold B or Guide as the session starts, or
# hearth.mode=desktop, for Desktop Mode this time, as with Steam Game Mode.
# The live USB (its installer is Hearth's app) and extra multi-seat players keep the old path (run_game) unchanged.
# (test_hearth_game_mode_choice.py runs these lines, between the >>> and <<< marks.)
GM_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/nimbus"
HGM_FAILS="$GM_STATE/hearth-gm-fails"
HGM_OFF="$GM_STATE/hearth-gm-off"
HGM_NOTE="$RUN/hearth-game-mode-failed"
HGM_MIN_SECS="${HGM_MIN_SECS:-20}"
HGM_GOOD_SECS="${HGM_GOOD_SECS:-120}"
HGM_WINDOW="${HGM_WINDOW:-600}"
gm_conf() { echo "${SESSION_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/session.conf}"; }
# steam or hearth. The last HEARTH_GAME_MODE_CHOICE= line wins (as in the shell); only exactly "hearth" is Hearth Game
# Mode, anything else is Steam Game Mode. No line: the old developer switch HEARTH_LEGACY_GAME_MODE=1 means Hearth
# Game Mode, else Steam Game Mode. (hearth-game-mode's choice_from has the same rules; a test compares them.)
game_mode_choice() {
  gf="$(gm_conf)"; gv=""
  [ -f "$gf" ] && gv="$(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}HEARTH_GAME_MODE_CHOICE=["'\'']*\([A-Za-z0-9]*\).*/=\2/p' "$gf" 2>/dev/null | tail -n 1)"
  case "$gv" in
    =hearth) echo hearth ;;
    =*) echo steam ;;
    *)
      gl=""
      [ -f "$gf" ] && gl="$(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}HEARTH_LEGACY_GAME_MODE=["'\'']*\([A-Za-z0-9]*\).*/\2/p' "$gf" 2>/dev/null | tail -n 1)"
      if [ "${HEARTH_LEGACY_GAME_MODE:-0}" = 1 ] || [ "$gl" = 1 ]; then echo hearth; else echo steam; fi ;;
  esac
}
# HEARTH_STEAM_ONLY for Hearth's app (feature steamOnly: first-time setup hands over to Steam Game Mode): only while
# the Game Mode is Steam's.
steam_only_env() {
  if { command -v live_session >/dev/null 2>&1 && live_session; } || [ "$(game_mode_choice)" = hearth ]; then unset HEARTH_STEAM_ONLY
  else export HEARTH_STEAM_ONLY=1; fi
}
hgm_recent_fails() {
  now=$(date +%s)
  [ -f "$HGM_FAILS" ] || return 0
  while read -r t; do
    case "$t" in ''|*[!0-9]*) continue ;; esac
    [ $(( now - t )) -lt "$HGM_WINDOW" ] && echo "$t"
  done <"$HGM_FAILS"
  return 0
}
hgm_paused() { [ -s "$HGM_OFF" ]; }
hgm_pause() {
  log "hearth game mode: paused: $1; Game Mode falls back until you try Hearth Game Mode again"
  mkdir -p "$GM_STATE" 2>/dev/null; echo "$1" >"$HGM_OFF" 2>/dev/null
  rm -f "$HGM_FAILS"
}
# Only a request you make (nimbus-mode hearth: Settings' "Try Hearth Game Mode again", Switch now) or a good run.
hgm_unpause() { rm -f "$HGM_OFF" "$HGM_FAILS"; }
# Why Hearth Game Mode can't start at all right now ("" when it can).
hgm_cant_reason() {
  if ! have gamescope; then echo "gamescope isn't installed"
  elif [ -z "$NIMBUS_APP" ] || [ ! -x "$NIMBUS_APP" ]; then echo "Hearth's app isn't installed"
  fi
}
# Where a start of Hearth Game Mode that can't happen goes instead: Steam Game Mode when it can run, isn't paused and
# hasn't failed in the last 10 minutes; else Desktop Mode.
hgm_next() {
  if [ -z "$HEARTH_SEAT" ] && command -v steam_cant_reason >/dev/null 2>&1 && [ -z "$(steam_cant_reason)" ] \
     && ! steam_paused && [ -z "$(find "$RUN/hearth-steam-mode-failed" -mmin -10 2>/dev/null)" ]; then echo steam
  else echo desktop; fi
}
# Hearth Game Mode can't start or failed: say why (the note and the log), and print where this start goes. The choice
# in session.conf isn't touched.
hgm_failed() {
  to="$(hgm_next)"
  case "$to" in steam) toname="Steam Game Mode" ;; *) toname="Desktop Mode" ;; esac
  log "hearth game mode: $1; $toname this time (your choice stays Hearth Game Mode)"
  printf '%s\n' "$1" >"$HGM_NOTE" 2>/dev/null
  # Desktop Mode's watchdog (labwc autostart) then doesn't ask for Game Mode again if its taskbar can't start.
  : >"$RUN/nimbus-game-unavailable" 2>/dev/null
  echo "$to"
}
# What a "game" request opens when you picked Hearth Game Mode: game, or where hgm_failed sends this start.
hgm_route() {
  why="$(hgm_cant_reason)"
  if [ -z "$why" ] && hgm_paused; then why="Hearth Game Mode is paused: $(head -c 240 "$HGM_OFF"). Try it again from Settings › Gaming › Game Mode"; fi
  if [ -z "$why" ] && [ "$(hgm_recent_fails | grep -c .)" -ge 2 ]; then
    hgm_pause "it didn't start properly twice within $(( HGM_WINDOW / 60 )) minutes"
    why="Hearth Game Mode is paused: $(head -c 240 "$HGM_OFF"). Try it again from Settings › Gaming › Game Mode"
  fi
  if [ -n "$why" ]; then hgm_failed "$why"; else echo game; fi
}
# Where the session starts when it would start in Hearth Game Mode: game, or desktop with hearth.mode=desktop on the
# kernel command line or B or Guide held as the session starts (as steam_start_mode does).
hearth_start_mode() {
  if grep -qwF hearth.mode=desktop "${HEARTH_CMDLINE:-/proc/cmdline}" 2>/dev/null; then
    log "start: hearth.mode=desktop on the kernel command line; Desktop Mode this time"; echo desktop; return 0
  fi
  if command -v steam_skip_held >/dev/null 2>&1 && steam_skip_held; then log "start: B or Guide held; Desktop Mode this time"; echo desktop; return 0; fi
  echo game
}
# One run of Hearth Game Mode (Hearth's app in gamescope, run_game, with Hearth Input), and where it goes afterwards.
HGM_TIMER=""
run_hearth_mode() {
  log "hearth game mode"
  why="$(hgm_cant_reason)"
  if [ -n "$why" ]; then hgm_failed "$why" >"$NEXT"; return 0; fi
  rm -f "$HGM_NOTE" "$RUN/hearth-game-mode-crashed" "$NEXT"
  # Counted as a failure until it proves good (still running after HGM_GOOD_SECS, or a switch you asked for).
  mkdir -p "$GM_STATE" 2>/dev/null
  kept="$(hgm_recent_fails)"
  printf '%s%s\n' "${kept:+$kept
}" "$(date +%s)" >"$HGM_FAILS" 2>/dev/null
  echo $$ >"$RUN/hearth-game-mode.pid"
  ( sleep "$HGM_GOOD_SECS"; [ -f "$RUN/hearth-game-mode.pid" ] && rm -f "$HGM_FAILS" "$HGM_OFF" ) >/dev/null 2>&1 &
  HGM_TIMER=$!
  started=$(date +%s)
  command -v input_start >/dev/null 2>&1 && input_start
  run_game; rc=$?
  command -v input_stop >/dev/null 2>&1 && input_stop
  rm -f "$RUN/hearth-game-mode.pid"
  [ -n "$HGM_TIMER" ] && kill "$HGM_TIMER" 2>/dev/null; HGM_TIMER=""
  ran=$(( $(date +%s) - started ))
  [ "$ran" -ge "$HGM_GOOD_SECS" ] && rm -f "$HGM_FAILS" "$HGM_OFF"
  next_now="$(cat "$NEXT" 2>/dev/null)"
  # Hearth's app kept crashing (the watchdog gave up): that, whatever else was asked for.
  if [ -s "$RUN/hearth-game-mode-crashed" ]; then
    why="$(head -c 240 "$RUN/hearth-game-mode-crashed")"; rm -f "$RUN/hearth-game-mode-crashed"
    hgm_failed "$why" >"$NEXT"; return 0
  fi
  case "$next_now" in
    game|desktop|steam|server|logout|hearth|steamgame)
      log "hearth game mode ended (code $rc); $next_now asked for"
      # A switch you asked for: not a failure.
      [ "$ran" -lt "$HGM_GOOD_SECS" ] && [ -f "$HGM_FAILS" ] && { sed '$d' "$HGM_FAILS" >"$HGM_FAILS.new" && mv -f "$HGM_FAILS.new" "$HGM_FAILS"; }
      rm -f "$HGM_OFF" ;;
    *)
      if [ "$ran" -lt "$HGM_MIN_SECS" ]; then hgm_failed "Hearth Game Mode closed right away (code $rc)" >"$NEXT"
      elif [ "$rc" -ne 0 ]; then
        # Closed by itself after a while (gamescope ended): Hearth Game Mode again, through the route, which pauses it
        # after two failures in the window.
        log "hearth game mode closed by itself after ${ran}s (code $rc); Game Mode again"; echo game >"$NEXT"
      else
        # Hearth quit on purpose without asking for a mode (its Sign out): the session ends, as before.
        log "hearth game mode ended (code 0) without asking for a mode"
      fi ;;
  esac
  return 0
}
# <<< game mode choice

# >>> steam game
# ---- Steam games open in Steam Game Mode (docs/HEARTH-GAME-MODE.md, "Steam games", Hearth 1.10). In Hearth Game Mode,
# Play on a Steam game (with "Play Steam games in Steam Game Mode" on, the default) makes Hearth write the game's app id
# to a one-shot request ($SG_REQ), ask for "steamgame" and close. The session reads and deletes the request, opens Steam
# Game Mode for that one game (steam://rungameid/<id> on Steam's command line) and, when the game's process tree under
# Steam's reaper (SteamLaunch AppId=<id>) has ended, comes back to Hearth Game Mode by itself (steam_game_watch). Your
# Game Mode choice (session.conf) is never touched. Ways it stays or comes back:
#   another game running when that one ends (you started something else from Steam's library): Steam Game Mode stays
#   until you press Hearth Sync's "Back to Hearth Game Mode" (nimbus-mode hearth) or switch;
#   the game never starting (within SG_WAIT): Steam Game Mode stays, with the same Back button;
#   Steam Game Mode can't run, is paused, fails right away or closes by itself: back to Hearth Game Mode for this run
#   (steam_back), with the reason in $SG_NOTE (Hearth shows it once). Hearth Game Mode failing then goes on by
#   hgm_failed's order (Steam Game Mode has just failed, so Mantel): never back and forth.
# (test_hearth_game_mode_choice.py runs these lines, between the >>> and <<< marks.)
SG_REQ="$RUN/hearth-steam-game"
SG_NOTE="$RUN/hearth-steam-game-failed"
SG_WAIT="${SG_WAIT:-600}"
SG_GRACE="${SG_GRACE:-6}"
SG_POLL="${SG_POLL:-2}"
SG_PROC="${HEARTH_PROC:-/proc}"
STEAM_GAME_APPID=""
# "Play Steam games in Steam Game Mode": on unless session.conf's HEARTH_STEAM_GAMES_IN_STEAM says exactly off
# (hearth-game-mode's steam_games_from has the same rule).
steam_games_on() {
  sf="${SESSION_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/session.conf}"
  sv=""
  [ -f "$sf" ] && sv="$(sed -n 's/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}HEARTH_STEAM_GAMES_IN_STEAM=["'\'']*\([A-Za-z0-9]*\).*/\2/p' "$sf" 2>/dev/null | tail -n 1)"
  [ "$sv" != off ]
}
# The request's app id (only digits, at most 10), read once: the file is deleted whatever it says.
steam_game_take() {
  sg=""
  [ -f "$SG_REQ" ] && sg="$(head -c 64 "$SG_REQ" 2>/dev/null | tr -d '[:space:]')"
  rm -f "$SG_REQ"
  case "$sg" in ''|*[!0-9]*) return 0 ;; esac
  [ "${#sg}" -le 10 ] && echo "$sg"
  return 0
}
# Why that game can't open in Steam Game Mode now ("" when it can).
steam_game_cant() {
  if [ -z "$1" ]; then echo "the request didn't name a Steam game"
  elif [ -n "$HEARTH_SEAT" ] || { command -v live_session >/dev/null 2>&1 && live_session; }; then echo "not on this session"
  elif ! steam_games_on; then echo "Play Steam games in Steam Game Mode is off"
  elif command -v steam_paused >/dev/null 2>&1 && steam_paused; then echo "Steam Game Mode is paused after it failed twice"
  elif command -v steam_cant_reason >/dev/null 2>&1 && [ -n "$(steam_cant_reason)" ]; then steam_cant_reason
  fi
}
steam_game_failed() {
  log "steam game: $1; Hearth Game Mode this time"
  printf '%s\n' "$1" >"$SG_NOTE" 2>/dev/null
}
# A process of yours that is this game (or any game, with no app id): Steam's reaper with SteamLaunch AppId=<id>, or a
# process carrying SteamAppId / SteamGameId=<id>.
steam_game_running() {
  me=$(id -u)
  for d in "$SG_PROC"/[0-9]*; do
    [ -d "$d" ] && [ "$(stat -c %u "$d" 2>/dev/null)" = "$me" ] || continue
    c="$(tr '\0' ' ' <"$d/cmdline" 2>/dev/null)"
    case " $c " in
      *" SteamLaunch "*)
        if [ -z "$1" ]; then return 0; fi
        case " $c " in *" AppId=$1 "*) return 0 ;; esac ;;
    esac
    if [ -n "$1" ] && tr '\0' '\n' <"$d/environ" 2>/dev/null | grep -qxE "(SteamAppId|SteamGameId)=$1"; then return 0; fi
  done
  return 1
}
# Watches the one game while Steam Game Mode runs (its running mark), and asks for Hearth Game Mode once it has ended
# (gone for SG_GRACE seconds, so a launcher handing over to the game doesn't count). Never waits on anything else.
SG_WATCH_PID=""
steam_game_watch() {
  (
    seen=""; gone=0; waited=0
    while [ -f "$RUN/hearth-steam-mode.pid" ]; do
      if steam_game_running "$1"; then seen=1; gone=0
      elif [ -n "$seen" ]; then
        gone=$((gone + SG_POLL))
        if [ "$gone" -ge "$SG_GRACE" ]; then
          if steam_game_running ""; then log "steam game: $1 ended, another game is running; staying in Steam Game Mode"; exit 0; fi
          log "steam game: $1 ended; back to Hearth Game Mode"
          "${HEARTH_NIMBUS_MODE:-nimbus-mode}" hearth >/dev/null 2>&1
          exit 0
        fi
      else
        waited=$((waited + SG_POLL))
        if [ "$waited" -ge "$SG_WAIT" ]; then log "steam game: $1 didn't start within ${SG_WAIT}s; staying in Steam Game Mode (Hearth Sync has Back to Hearth Game Mode)"; exit 0; fi
      fi
      sleep "$SG_POLL"
    done
  ) &
  SG_WATCH_PID=$!
}
steam_game_unwatch() { [ -n "$SG_WATCH_PID" ] && kill "$SG_WATCH_PID" 2>/dev/null; SG_WATCH_PID=""; return 0; }
# <<< steam game

# ---- First-time setup (Wi-Fi, store accounts, the controller, your games: ui/index.html viewSetup) was Hearth's app,
# shown once on a fresh install. From Hearth OS 1.1 the USB installer asks everything first-time setup asked (language,
# Wi-Fi, your account, the time zone), so a new install starts straight in Steam Game Mode (Steam asks for its own
# sign-in) and the old Game Mode screens aren't needed: setup is only pending with HEARTH_LEGACY_SETUP=1 in
# session.conf (a developer switch). Until it's done (or skipped: Hearth writes setupDone in library.json), "game" then
# means Hearth's app for it (mode "setup"); a setup run that ends without asking for anything goes to Steam Game Mode.
setup_pending() {
  [ "${HEARTH_LEGACY_SETUP:-0}" = 1 ] || return 1
  [ -z "$HEARTH_SEAT" ] && can_game || return 1
  ! grep -Eq '"setupDone"[[:space:]]*:[[:space:]]*[1-9t]' "${XDG_DATA_HOME:-$HOME/.local/share}/nimbus/library.json" 2>/dev/null
}
# What a request for a mode means: "game" is the Game Mode you picked (game_mode_choice: Steam Game Mode unless you
# picked Hearth Game Mode; first-time setup while it's pending; Hearth Game Mode on the live USB, its installer).
# "hearth" is Hearth Game Mode asked for by you (Switch now, Try again): its pause ends first.
resolve_mode() {
  case "$1" in
    game) if live_session; then echo game; elif setup_pending; then echo setup; elif [ "$(game_mode_choice)" = hearth ]; then hgm_route; else echo steam; fi ;;
    hearth) if live_session; then echo game; else hgm_unpause; hgm_route; fi ;;
    *) echo "$1" ;;
  esac
}

reset_controllers
mode="${NIMBUS_START_MODE:-game}"
case "$mode" in desktop|server) ;; *) mode=game ;; esac
# Server mode (docs/SERVER-MODE.md): only when it's on; its schedule (Settings › System › Startup), when you turned one on,
# picks the mode to start in. Anything the helper can't answer leaves the mode as it was (Server mode then can't start
# and Game Mode opens: run_server / server_start_mode).
if [ -z "$HEARTH_SEAT" ] && [ -f "$SERVER_HELPER" ] && { [ "$mode" = server ] || [ -s "${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/server-mode.json" ]; }; then
  sm="$(server_helper start-mode "$mode")"
  case "$sm" in game|desktop|server) [ "$sm" != "$mode" ] && log "start: $sm (Server mode's choices)"; mode="$sm" ;; esac
fi
[ "$mode" = server ] && mode="$(server_start_mode)"
# Hearth Recovery on the device › Desktop Mode this time (until the next restart).
[ -f /run/hearth/start-desktop ] && [ -z "$HEARTH_SEAT" ] && mode=desktop
# Extra multi-seat players have Hearth's Game Mode only (multi-seat is dropped for now; kept for HEARTH_LEGACY_MULTIPLAYER).
if [ -n "$HEARTH_SEAT" ]; then mode=game; else mode="$(resolve_mode "$mode")"; fi
# Starting in Hearth Game Mode (you picked it): hearth.mode=desktop or B or Guide held opens Desktop Mode this time (its
# pause and missing pieces were handled by resolve_mode, which may have picked Steam Game Mode for this start).
[ "$mode" = game ] && [ -z "$HEARTH_SEAT" ] && ! live_session && mode="$(hearth_start_mode)"
# Starting in Steam Game Mode: steam_start_mode has every way out (hearth.mode=desktop, B or Guide held, paused...).
[ "$mode" = steam ] && mode="$(steam_start_mode)"
rm -f "$NEXT"
while :; do
  # Fall back to whichever mode can run: the device always ends up somewhere usable.
  # Desktop Mode's autostart reads the note: if its taskbar can't start either, it stays put instead of asking for
  # Game Mode again (that restarted Desktop Mode about once a minute, forever).
  if [ "$mode" = setup ] && ! can_game; then log "first-time setup: Hearth's app or gamescope missing; Steam Game Mode"; mode=steam; fi
  # (Hearth Game Mode you picked checks this itself in run_hearth_mode, with its notice; this is the live USB's and an
  # extra multi-seat player's.)
  if [ "$mode" = game ] && ! can_game && { [ -n "$HEARTH_SEAT" ] || live_session; }; then
    log "hearth's game mode unavailable (gamescope or Nimbus missing)"; : >"$RUN/nimbus-game-unavailable"
    mode=desktop
  fi
  if [ "$mode" = desktop ] && ! can_desktop; then
    log "desktop mode unavailable (labwc missing)"
    if [ -z "$HEARTH_SEAT" ] && [ ! -s "$RUN/hearth-steam-mode-failed" ] && can_steam_mode; then mode=steam
    elif can_game && [ ! -s "$HGM_NOTE" ]; then log "last resort: Hearth's Game Mode"; mode=game
    else exit 1; fi
  fi

  # The mode this session is in, for programs started outside it: Handheld Daemon's overlay app
  # (desktop/shell/hearth-overlay) started for Desktop Mode ends itself once it says game again, so HHD starts Quick
  # Access the Game Mode way (in gamescope) instead of sending every press to a Desktop Mode that's gone.
  if [ "$mode" = setup ]; then echo game >"$RUN/nimbus-mode-now" 2>/dev/null; else echo "$mode" >"$RUN/nimbus-mode-now" 2>/dev/null; fi
  steam_only_env
  sd=""; [ "$mode" = steam ] && ! live_session && { steam_auto_before; sd=1; }
  # Hearth Game Mode you picked (game_mode_choice): run_hearth_mode, with its fallback (Steam Game Mode, then Mantel).
  if [ "$mode" = game ] && [ -z "$HEARTH_SEAT" ] && ! live_session; then run_hearth_mode; code=$?
  elif [ "$mode" = game ] || [ "$mode" = setup ]; then
    [ "$mode" = setup ] && log "first-time setup in Hearth's app (once; Steam Game Mode after)"
    input_start; run_game; code=$?; input_stop
  elif [ "$mode" = steam ]; then run_steam_mode; code=$?
  elif [ "$mode" = server ]; then run_server; code=$?
  else steam_notice_other; run_desktop; code=$?; fi
  [ -n "$sd" ] && steam_auto_after
  STEAM_GAME_APPID=""   # a one-game Steam Game Mode is over, whatever comes next

  next="$(cat "$NEXT" 2>/dev/null)"; rm -f "$NEXT"
  # First-time setup that ended without asking for anything (Hearth closed or gave up): Steam Game Mode, never no screen.
  [ "$mode" = setup ] && [ -z "$next" ] && { log "first-time setup ended (code $code); Steam Game Mode next"; next=steam; }
  [ -n "$HEARTH_SEAT" ] && [ "$next" = desktop ] && next=game   # extra multi-seat players have Game Mode only
  [ -n "$HEARTH_SEAT" ] && [ "$next" = steam ] && next=game     # ...and never Steam Game Mode
  [ -n "$HEARTH_SEAT" ] && [ "$next" = server ] && next=game    # ...and never Server mode
  [ -n "$HEARTH_SEAT" ] && [ "$next" = hearth ] && next=game    # (their Game Mode is Hearth's)
  # A Steam game from Hearth Game Mode (the steam game block): Steam Game Mode for that one game, or Hearth Game Mode
  # again with the reason. The request file is read once and deleted; session.conf isn't touched.
  if [ "$next" = steamgame ]; then
    sgid="$(steam_game_take)"
    sgwhy="$(steam_game_cant "$sgid")"
    if [ -z "$sgwhy" ]; then STEAM_GAME_APPID="$sgid"; log "steam game: $sgid opens in Steam Game Mode"; next=steam
    else steam_game_failed "$sgwhy"; next=hearth; [ -n "$HEARTH_SEAT" ] && next=game; fi
  fi
  # Leaving Game Mode after Server mode (Steam's "Switch to Desktop"): back to Server mode.
  if [ "$next" = desktop ] && { [ "$mode" = steam ] || [ "$mode" = game ]; } && server_return; then
    log "leaving Game Mode: back to Server mode"; next=server
  fi
  # Server mode asked for by you (not by Game Mode's way back): the pause after two failures ends.
  [ "$next" = server ] && [ "$mode" != steam ] && [ "$mode" != game ] && server_unpause
  # Any other way into Desktop Mode, or Server mode itself: the way back from Game Mode is no longer Server mode.
  [ "$next" = desktop ] && rm -f "$RUN/hearth-server-return"
  case "$next" in
    game|desktop|steam|server|hearth)
      to="$next"; [ -z "$HEARTH_SEAT" ] && to="$(resolve_mode "$next")"
      log "switching to $to"; settle "$mode"; log "starting $to mode"; mode="$to" ;;
    *) log "$mode mode ended (code $code), leaving the session"; rm -f "$RUN/nimbus-mode-now"; exit 0 ;;
  esac
done
