[Desktop Entry]
Name=GNOME (Hearth)
Comment=Hearth OS with GNOME as the desktop (Hearth inside; Mantel if it can't start). Listed once GNOME is downloaded (Settings › Your desktop).
Exec=/usr/local/bin/nimbus-session --desktop=gnome
TryExec=/usr/bin/gnome-session
Type=Application
DesktopNames=GNOME
