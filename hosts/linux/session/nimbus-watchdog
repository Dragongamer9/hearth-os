#!/bin/sh
# Keeps Nimbus running inside the session, like the Windows host's watchdog.
#   exit 0   Nimbus quit on purpose (sign out, switch to desktop): end the session.
#   exit 75  Nimbus installed an update: start it again right away.
#   other    a crash: restart it. Three crashes within two minutes roll back a just-installed
#            update (<app>.old); if there's nothing to roll back, end the session so the
#            login screen comes back instead of a black screen.

APP="$1"
LOG="${XDG_DATA_HOME:-$HOME/.local/share}/nimbus/session.log"
mkdir -p "$(dirname "$LOG")"
crashes=""
# Hearth's screen is drawn by WebKit, normally through GBM buffers from the graphics driver (fast). Where the driver
# can't make them ("Failed to create GBM buffer ... Invalid argument": basic graphics, some live USB boots), WebKit
# draws nothing and only the background and the pointer show. Seen within Hearth's first 40 seconds, Hearth is
# started again the compatible way (WEBKIT_DISABLE_DMABUF_RENDERER), and this PC remembers it (FLAG; Settings ›
# Display can take it back).
FLAG="${XDG_CONFIG_HOME:-$HOME/.config}/nimbus/drawing-fallback"
if [ -f "$FLAG" ] || grep -qw nomodeset /proc/cmdline 2>/dev/null; then export WEBKIT_DISABLE_DMABUF_RENDERER=1; fi

# Game Mode's display for programs D-Bus and systemd start on demand (the desktop portal, notifications): without it
# xdg-desktop-portal-gtk failed with "cannot open display", apps waiting on the portal hung for up to two minutes
# (Peppermint), and systemd stopped trying ("start-limit-hit"), so file pickers stayed broken in Desktop Mode too.
# This runs inside gamescope, so DISPLAY is gamescope's. WAYLAND_DISPLAY is emptied: Desktop Mode's is gone now, and
# an empty one makes GTK use DISPLAY. The portals' earlier failures are forgotten so they start again.
if [ -n "$DISPLAY" ] && command -v dbus-update-activation-environment >/dev/null 2>&1; then
  vars="DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE"
  [ -n "$XAUTHORITY" ] && vars="$vars XAUTHORITY"
  # shellcheck disable=SC2086
  WAYLAND_DISPLAY="" dbus-update-activation-environment --systemd $vars >/dev/null 2>&1
  systemctl --user reset-failed xdg-desktop-portal.service xdg-desktop-portal-gtk.service >/dev/null 2>&1
fi

while :; do
  start=0; [ -f "$LOG" ] && start=$(wc -c <"$LOG")
  "$APP" --session --ozone-platform=x11 >>"$LOG" 2>&1 &
  pid=$!
  chk=""
  if [ -z "$WEBKIT_DISABLE_DMABUF_RENDERER" ]; then
    (
      i=0
      while [ $i -lt 40 ] && kill -0 "$pid" 2>/dev/null; do
        if tail -c +"$((start + 1))" "$LOG" 2>/dev/null | grep -q "Failed to create GBM buffer"; then
          mkdir -p "$(dirname "$FLAG")" && echo "$(date) GBM buffers failed" >"$FLAG"
          echo "$(date) Hearth can't draw the fast way here (GBM); starting it again the compatible way" >>"$LOG"
          kill -TERM "$pid"; sleep 4; kill -KILL "$pid" 2>/dev/null
          exit 0
        fi
        sleep 1; i=$((i + 1))
      done
    ) &
    chk=$!
  fi
  wait "$pid"
  code=$?
  [ -n "$chk" ] && kill "$chk" 2>/dev/null
  if [ -z "$WEBKIT_DISABLE_DMABUF_RENDERER" ] && [ -f "$FLAG" ]; then export WEBKIT_DISABLE_DMABUF_RENDERER=1; continue; fi
  now=$(date +%s)
  case $code in
    0)
      # Leaving Game Mode: gamescope (our parent) should close now that Nimbus has. If something still
      # holds it open (a game or app left on its display), close it so the switch doesn't hang on a black
      # screen: politely after 6 s, forcefully after 10 s.
      gs=$PPID
      if [ "$(cat /proc/$gs/comm 2>/dev/null | cut -c1-9)" = gamescope ]; then
        setsid sh -c "sleep 3; [ \"\$(cut -c1-9 /proc/$gs/comm 2>/dev/null)\" = gamescope ] || exit 0; echo \"\$(date) gamescope still open, closing it\" >>'$LOG'; kill -TERM $gs; sleep 2; kill -KILL $gs 2>/dev/null" >/dev/null 2>&1 </dev/null &
      fi
      exit 0 ;;
    75) echo "$(date) update installed, restarting" >>"$LOG"; continue ;;
  esac
  echo "$(date) Nimbus exited with code $code" >>"$LOG"
  recent=""
  for t in $crashes; do [ $((now - t)) -lt 120 ] && recent="$recent $t"; done
  crashes="$recent $now"
  if [ "$(echo $crashes | wc -w)" -ge 3 ]; then
    if [ -f "$APP.old" ]; then
      echo "$(date) new version keeps crashing, rolling back" >>"$LOG"
      mv -f "$APP.old" "$APP" && crashes="" && continue
    fi
    echo "$(date) too many crashes, ending the session" >>"$LOG"
    exit 1
  fi
  sleep 1
done
