#!/bin/sh
# Steam's "Switch to Desktop" (Big Picture with -steamos3, a native Steam) runs this, as on SteamOS. In Hearth's
# session it switches modes the Hearth way (nimbus-session reads $XDG_RUNTIME_DIR/nimbus-next) and closes Steam.
#   steamos-session-select plasma|desktop|plasma-wayland|plasma-x11   Desktop Mode
#   steamos-session-select gamescope                                   Game Mode
case "${1:-plasma}" in
  gamescope) next=game ;;
  *) next=desktop ;;
esac
echo "$next" >"${XDG_RUNTIME_DIR:-/tmp}/nimbus-next"
steam -shutdown >/dev/null 2>&1 &
exit 0
