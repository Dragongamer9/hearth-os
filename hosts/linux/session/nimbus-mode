#!/bin/sh
# Switches the Nimbus session between modes, or leaves it.
#   nimbus-mode game      go to Game Mode: Steam Game Mode (docs/STEAM-GAME-MODE.md; first-time setup while it's
#                         pending, Hearth's own Game Mode only with HEARTH_LEGACY_GAME_MODE=1 or on the live USB)
#   nimbus-mode desktop   go to Desktop Mode (Mantel)
#   nimbus-mode steam     go to Steam Game Mode (also "try again" after it didn't start)
#   nimbus-mode server    go to Server mode (docs/SERVER-MODE.md; Game Mode instead when it's off or can't start)
#   nimbus-mode logout    end the session (back to the login screen)
#   nimbus-mode current   print the mode you're in

RUN="${XDG_RUNTIME_DIR:-/tmp}"
# Steam Game Mode (nimbus-session's run_steam_mode) leaves the session's process id here while it runs.
steam_pid=$(cat "$RUN/hearth-steam-mode.pid" 2>/dev/null)
steam_up() { [ -n "$steam_pid" ] && kill -0 "$steam_pid" 2>/dev/null; }
case "$1" in
  current)
    server_pid=$(cat "$RUN/hearth-server-mode.pid" 2>/dev/null)
    if [ "$HEARTH_SERVER_MODE" = 1 ] || { [ -n "$server_pid" ] && kill -0 "$server_pid" 2>/dev/null && [ "$(cat "$RUN/nimbus-mode-now" 2>/dev/null)" = server ]; }; then echo server
    elif [ -n "$LABWC_PID" ]; then echo desktop; elif steam_up; then echo steam; elif [ -n "$GAMESCOPE_WAYLAND_DISPLAY" ]; then echo game; else echo none; fi ;;
  game|desktop|logout|steam|server)
    # (logout is written too: the session ends on anything that isn't a mode, and Steam Game Mode then knows it was
    # asked for and isn't started again.)
    echo "$1" >"$RUN/nimbus-next"
    if [ -n "$LABWC_PID" ]; then
      labwc --exit 2>/dev/null || kill -TERM "$LABWC_PID"
      # If an app keeps the desktop from closing, close it anyway so the switch can't hang.
      pid="$LABWC_PID"; setsid sh -c "sleep 4; kill -0 $pid 2>/dev/null && kill -KILL $pid" >/dev/null 2>&1 </dev/null &
    elif steam_up; then
      # Steam Game Mode: Steam closes properly first (its settings and cloud saves), then its gamescope ends, by
      # force after 8 seconds so the switch can't hang.
      me=$(id -u)
      setsid sh -c "timeout 6 steam -shutdown >/dev/null 2>&1; sleep 2; pkill -TERM -u $me -x gamescope; pkill -TERM -u $me -f gamescope-wl; sleep 3; pkill -KILL -u $me -x gamescope" >/dev/null 2>&1 </dev/null &
    else
      # In Game Mode, Nimbus quits itself after writing the file; this is the fallback for scripts. Run from
      # somewhere that didn't inherit LABWC_PID (an SSH login, a systemd user service, an app started over
      # D-Bus) while Desktop Mode is up, it's this user's labwc that has to end, or the switch never happens.
      pkill -TERM -x gamescope 2>/dev/null || pkill -TERM -f gamescope-wl 2>/dev/null \
        || pkill -TERM -u "$(id -u)" -x labwc 2>/dev/null
    fi ;;
  *) echo "usage: nimbus-mode game|desktop|steam|server|logout|current" >&2; exit 2 ;;
esac
