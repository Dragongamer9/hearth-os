#!/bin/sh
# Switches the Nimbus session between modes, or leaves it.
#   nimbus-mode game      go to Game Mode
#   nimbus-mode desktop   go to Desktop Mode
#   nimbus-mode logout    end the session (back to the login screen)
#   nimbus-mode current   print the mode you're in

RUN="${XDG_RUNTIME_DIR:-/tmp}"
# Hearth Plasma (Desktop Mode on KDE Plasma, nimbus-session's run_plasma) leaves its process id here while it runs.
plasma_pid=$(cat "$RUN/hearth-plasma.pid" 2>/dev/null)
plasma_up() { [ -n "$plasma_pid" ] && kill -0 "$plasma_pid" 2>/dev/null; }
case "$1" in
  current)
    if [ -n "$LABWC_PID" ] || plasma_up; then echo desktop; elif [ -n "$GAMESCOPE_WAYLAND_DISPLAY" ]; then echo game; else echo none; fi ;;
  game|desktop|logout)
    [ "$1" = logout ] && rm -f "$RUN/nimbus-next" || echo "$1" >"$RUN/nimbus-next"
    if [ -n "$LABWC_PID" ]; then
      labwc --exit 2>/dev/null || kill -TERM "$LABWC_PID"
      # If an app keeps the desktop from closing, close it anyway so the switch can't hang.
      pid="$LABWC_PID"; setsid sh -c "sleep 4; kill -0 $pid 2>/dev/null && kill -KILL $pid" >/dev/null 2>&1 </dev/null &
    elif plasma_up; then
      # Plasma's own sign-out without asking (apps close properly and Plasma saves its settings); if it hasn't ended
      # within 8 seconds, KWin and Plasma are ended by force so the switch can't hang.
      { qdbus6 org.kde.Shutdown /Shutdown org.kde.Shutdown.logout || qdbus org.kde.Shutdown /Shutdown org.kde.Shutdown.logout \
        || dbus-send --session --type=method_call --dest=org.kde.Shutdown /Shutdown org.kde.Shutdown.logout; } >/dev/null 2>&1 \
        || kill -TERM "$plasma_pid"
      me=$(id -u)
      setsid sh -c "sleep 8; kill -0 $plasma_pid 2>/dev/null || exit 0; pkill -TERM -u $me -x plasmashell; pkill -TERM -u $me -x kwin_wayland; sleep 3; kill -KILL $plasma_pid 2>/dev/null; pkill -KILL -u $me -x kwin_wayland" >/dev/null 2>&1 </dev/null &
    else
      # In Game Mode, Nimbus quits itself after writing the file; this is the fallback for scripts. Run from
      # somewhere that didn't inherit LABWC_PID (an SSH login, a systemd user service, an app started over
      # D-Bus) while Desktop Mode is up, it's this user's labwc that has to end, or the switch never happens.
      pkill -TERM -x gamescope 2>/dev/null || pkill -TERM -f gamescope-wl 2>/dev/null \
        || pkill -TERM -u "$(id -u)" -x labwc 2>/dev/null
    fi ;;
  *) echo "usage: nimbus-mode game|desktop|logout|current" >&2; exit 2 ;;
esac
