// A section heading, as the web page's h2: small, uppercase, dim.
import QtQuick

Text {
    color: Theme.dim
    font.family: Theme.font
    font.pixelSize: Theme.u(14)
    font.weight: Font.DemiBold
    font.capitalization: Font.AllUppercase
    font.letterSpacing: Theme.u(1)
    topPadding: Theme.u(18)
    bottomPadding: Theme.u(10)
}
