<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Game art, the player counter and "Send logs to the developer". -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Wi-Fi on/off and signal for the top bar (no location: the network's name shows only when Android allows it). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Bluetooth on/off, on Android 11 and older (newer Android needs no permission for that). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!-- Hearth Linux (Beta Experimental): keeps Linux programs running while Hearth is in the background (a foreground
         service with a notification, only while something runs). See docs/ANDROID-LINUX.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Which apps Hearth can see (Android 11+): everything with a launcher icon (phones and TVs), and the RetroArch
         builds it starts ROMs with. No QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
        <package android:name="com.retroarch" />
        <package android:name="com.retroarch.aarch64" />
        <package android:name="com.retroarch.ra32" />
        <!-- Termux:X11, which shows Hearth Linux's programs (Settings › System › Linux). -->
        <package android:name="com.termux.x11" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Hearth">

        <!-- One activity: Hearth's page in a full-screen WebView. It's also a home app (optional: Android asks which
             home app to use, or Settings › System › Use Hearth as your home app). Controllers connecting or
             disconnecting change keyboard/navigation: listed here so the page isn't reloaded. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="false"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection|touchscreen|colorMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Hearth Linux: runs while Linux programs (PRoot) or the Termux:X11 display server run, so Android doesn't
             freeze or close them when Hearth isn't in front. LinuxEnv starts and stops it. -->
        <service
            android:name=".LinuxService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Runs a Linux environment (PRoot) the user started, and its programs, while the app is in the background" />
        </service>
    </application>
</manifest>
