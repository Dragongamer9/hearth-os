#!/usr/bin/python3
"""Hearth Console Remote Play's sign-in window (docs/CONSOLE-REMOTE-PLAY.md, "Sign-in"; mockups 1b and g1).

Microsoft's own sign-in page in a window inside the app, the way Greenlight does it: Hearth draws only the frame
(the lock, "Sign in with Microsoft", "Microsoft's own page", the read-only address, the three steps, the note, Reload
page and Cancel); the middle is Microsoft's real page (WebKitGTK). The password is typed into Microsoft's page and
never reaches Hearth. The page ends by going to ms-xal-000000004c20a908://auth?code=…: the window catches that
address (never loads it), hands it to the app on stdout (a pipe, never a file or a log) and closes by itself.

The browser here is ephemeral: no cookies, no cache, nothing of the sign-in is kept on disk.
In Game Mode (--game-mode) it fills the screen with Game Mode's top bar and hints, and Hearth's on-screen keyboard
comes up for each box on Microsoft's page (and on X); B cancels.

  hearth-console-remote-play-signin --url URL [--game-mode] [--user NAME]
  stdout: "REDIRECT <address>" (signed in), or "CANCEL"; exit 0 / 1
"""
import argparse
import glob
import os
import struct
import sys

import gi

gi.require_version('Gtk', '3.0')
gi.require_version('WebKit2', '4.1')
from gi.repository import GLib, Gtk, Gdk, WebKit2  # noqa: E402

REDIRECT = 'ms-xal-000000004c20a908'
OSK_DIRS = [os.environ.get('HEARTH_OSK_DIR', ''), os.path.join(os.path.dirname(os.path.abspath(__file__)), 'osk'),
            '/usr/share/nimbus/ui/osk', '/usr/share/hearth/osk', '/usr/share/nimbus/desktop/shell/osk']

