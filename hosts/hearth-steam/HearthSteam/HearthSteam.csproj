<Project Sdk="Microsoft.NET.Sdk">
  <!-- hearth-steam: Steam's engine for Hearth, with no window. Published self-contained for linux-x64 (the images
       carry no .NET runtime: Debian has none in its archive), with partial trimming (only the framework's own
       trimmable assemblies are trimmed; OpenSteamworks and protobuf keep all their code). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>hearth-steam</AssemblyName>
    <RootNamespace>HearthSteam</RootNamespace>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- MIT (OpenSteamClient/OpenSteamworks): the same packages OpenSteamClient's c#-remake builds with. -->
    <PackageReference Include="OpenSteamworks" Version="1.2.0" />
    <PackageReference Include="OpenSteamworks.Messaging" Version="1.2.0" />
    <PackageReference Include="OpenSteamworks.Messaging.SharedConnection" Version="1.2.0" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../HearthSteam.Core/HearthSteam.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../LICENSE.OpenSteamClient" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../hearth-steam-engine.service" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
